#version 450

#VERSION_DEFINES

layout(push_constant, std430) uniform Constants {
	mat4 projection;
	mat2x4 modelview;
	vec2 direction;
	float z_far;
	float pad;
}
constants;

#ifdef MODE_SHADOW
