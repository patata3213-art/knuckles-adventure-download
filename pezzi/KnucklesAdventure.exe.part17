FfxFloat16 ffxCubeRootHalf(FfxFloat16 c)
{
    return pow(c, FFX_BROADCAST_FLOAT16(1.0 / 3.0));
}









FfxFloat16x2 ffxCubeRootHalf(FfxFloat16x2 c)
