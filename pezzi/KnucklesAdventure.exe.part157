[sub_resource type="GDScript" id="GDScript_fnso4"]
script/source = "extends Node3D
## Generato da tools/build_eggmanland_2.gd (pianta2): gli oggetti di gioco piccoli non oltre FAR metri
## (design.md C.8; il tetto al chiuso di level_egl2 abbassa ancora). Gli anelli (MultiMesh) restano.
const FAR := 120.0
const MAX_SIZE := 50.0


func _ready() -> void:
	for g in find_children(\"*\", \"GeometryInstance3D\", true, false):
		_cap(g)
	get_tree().node_added.connect(_on_node_added)


func _on_node_added(n: Node) -> void:
	if n is GeometryInstance3D and is_ancestor_of(n):
		_cap.call_deferred(n)


func _cap(g: GeometryInstance3D) -> void:
	if not is_instance_valid(g) or g is MultiMeshInstance3D:
		return
	var sz: Vector3 = (g.global_transform * g.get_aabb()).size if g.is_inside_tree() else g.get_aabb().size
	if maxf(sz.x, maxf(sz.y, sz.z)) > MAX_SIZE:
		return
	if g.visibility_range_end <= 0.0 or g.visibility_range_end > FAR:
		g.visibility_range_end = FAR
"

