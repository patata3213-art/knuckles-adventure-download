[sub_resource type="Shader" id="Shader_kdcog"]
code = "
shader_type spatial;
render_mode cull_back;
uniform vec4 bg_top : source_color = vec4(0.06, 0.32, 0.7, 1.0);
uniform vec4 bg_bot : source_color = vec4(0.01, 0.05, 0.2, 1.0);
uniform float aspect = 1.27;
void fragment() {
	vec2 uv = UV * 2.0 - 1.0;
	uv.x *= aspect;
	uv.y = -uv.y;
	// icona: anello d'oro fermo e perfettamente rotondo, come nei monitor di Sonic 3
	vec2 p = uv * 1.12;
	float r = length(p);
	float aa = fwidth(r) * 1.2;
	float ring = smoothstep(0.66 + aa, 0.66 - aa, r) * smoothstep(0.47 - aa, 0.47 + aa, r);
	// volume: luce dall'alto a sinistra sul tubo dell'anello
	float across = (r - 0.565) / 0.095;
	vec2 dir = p / max(r, 1e-4);
	float lit = dot(dir, normalize(vec2(-0.6, 0.8)));
	vec3 gold_dk = vec3(0.78, 0.36, 0.0);
	vec3 gold = vec3(1.0, 0.74, 0.08);
	vec3 gold_lt = vec3(1.0, 0.95, 0.55);
	vec3 g = mix(gold_dk, gold, smoothstep(-0.9, 0.1, lit - across * 0.6));
	g = mix(g, gold_lt, smoothstep(0.35, 0.9, lit) * smoothstep(0.9, -0.2, abs(across + 0.15)));
	// arco speculare netto in alto a sinistra
	float arc = smoothstep(0.03, 0.0, abs(r - 0.6) - 0.012) * smoothstep(0.55, 0.85, lit);
	g = mix(g, vec3(1.0), arc * 0.9);
	// bordo scuro sottile intorno all'anello: si legge anche da lontano
	float outline = smoothstep(0.7 + aa, 0.7 - aa, r) * smoothstep(0.43 - aa, 0.43 + aa, r) * (1.0 - ring);
	vec3 bg = mix(bg_bot.rgb, bg_top.rgb, UV.y < 0.5 ? 1.0 - UV.y : 1.0 - UV.y);
	bg += vec3(0.05, 0.12, 0.25) * smoothstep(0.9, 0.0, length(uv * vec2(0.8, 1.0)));
	vec3 col = mix(bg, vec3(0.02, 0.03, 0.08), outline * 0.8);
	col = mix(col, g, ring);
	// scintilla a 4 punte che brilla ogni due secondi in alto a sinistra
	float tw = pow(max(sin(TIME * 3.1416 * 0.5), 0.0), 24.0);
	vec2 sp = p - vec2(-0.36, 0.42);
	float star = max(smoothstep(0.035, 0.0, abs(sp.x)) * smoothstep(0.26, 0.0, abs(sp.y)),
		smoothstep(0.035, 0.0, abs(sp.y)) * smoothstep(0.26, 0.0, abs(sp.x)));
	star = max(star, smoothstep(0.07, 0.0, length(sp)));
	col += vec3(1.0, 1.0, 0.9) * star * tw * 1.5;
	// riga di scansione che scorre piano e vignetta
	float roll = fract(UV.y * 1.0 - TIME * 0.25);
	col *= 0.9 + 0.1 * smoothstep(0.0, 0.08, roll) * smoothstep(0.2, 0.08, roll) + 0.04;
	col *= 0.93 + 0.07 * sin(UV.y * 160.0);
	col *= smoothstep(1.5, 0.5, length(uv * vec2(0.75, 1.0)));
	ALBEDO = vec3(0.0);
	EMISSION = col * 1.15;
	ROUGHNESS = 0.06;
	SPECULAR = 0.65;
}
"

