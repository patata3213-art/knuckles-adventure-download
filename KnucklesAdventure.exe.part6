␀␀␀␀␀; Animazioni originali di Knuckles (Sonic Adventure 2: knuckmtn.prs e plcommtn, convertite in glTF).
; File: knuckles_sa2.glb, ridotto con tools/dev/clip_glb_prep.py dal GLB completo (133 clip)
; alle sole clip usate qui (vedi assets/characters/LEGGIMI-ANIMAZIONI.txt).
; Lo scheletro di SA2 Ã¨ un altro (62 nodi senza nome, "NNN_object_XXXXXXXX", avanti = -X, un
; personaggio alto circa 8.8 unitÃ ): [bone_map] collega i nodi che contano alle ossa del modello
; di Dream Team, il retarget relativo al riposo ("rest") porta le rotazioni e le pose di riposo
; diverse (braccia ad A in SA2, a T nel modello) si allineano per direzione delle ossa.

[general]
face = "procedural"
; aculei (dreadlocks), borsa, corda: procedurali (la clip non li ha); la coda la muove la clip
secondary = "auto"
spring_speed = 8.0
spring_end_speed = 2.0
land_big_speed = 15.0
turn_gain = 1.4
; in SA2 lo spostamento del corpo (nodo 002: abbassarsi atterrando, il rimbalzo della corsa,
; accucciarsi per scavare) Ã¨ parte dell'animazione, non il movimento nel livello: si tiene
root_motion = "keep"

[bone_map]
; bacino (rotazione del bacino: gambe e coda; la posizione viene dal nodo 002 sopra di lui)
004_object_0000C800 = "Root_M"
; schiena, petto, testa
032_object_000095BC = "Spine1_M"
033_object_00008F04 = "Chest_M"
044_object_00006E74 = "Head_M"
; braccio sinistro: spalla, gomito, guanto (il nodo 039 Ã¨ il polso, 041 il pugno)
037_object_0000849C = "Shoulder_L"
038_object_00008384 = "Elbow_L"
041_object_0000811C = "Wrist_L"
; braccio destro
056_object_000016C4 = "Shoulder_R"
057_object_000015AC = "Elbow_R"
060_object_00001344 = "Wrist_R"
; gamba sinistra: coscia (017 Ã¨ l'attacco all'anca, 018 la coscia), ginocchio, caviglia, punta
018_object_0000AF88 = "Hip_L"
019_object_0000AE40 = "Knee_L"
023_object_0000A628 = "Ankle_L"
024_object_0000A108 = "Toes_L"
; gamba destra
008_object_0000C244 = "Hip_R"
009_object_0000C114 = "Knee_R"
013_object_0000B900 = "Ankle_R"
014_object_0000B3E0 = "Toes_R"
; coda
027_object_00009CE4 = "TailQiull1_M"
028_object_00009B9C = "TailQiull2_M"
029_object_00009A54 = "TailQiull3_M"

[slots]
idle = "128_kn_wait_a"
idle_var = ["087_kn_wait_c", "088_kn_wait_d"]
walk = "125_kn_walk0"
jog = "007_cmn_run0"
run = "008_cmn_run1"
dash = "126_kn_maxrun"
skid = "018_cmn_stop0"
skid_end = "027_cmn_stop1"
jump_start = "065_cmn_jump0"
; palla: il salto di SA2 Ã¨ una capriola raggomitolata (066), la rotolata e la spin dash la palla
spin = "066_cmn_jump1"
spindash = "011_cmn_spindash"
spring = "013_cmn_baneup0"
spring_end = "014_cmn_baneup1"
fall = "015_cmn_baneup2"
land = "131_kn_baneup3"
land_big = "132_kn_baneup4"
hurt = "021_cmn_damage0"
death = "059_cmn_die0"
