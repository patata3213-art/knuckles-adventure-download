; Locomozione: le clip di SA2 sono cicli di 1 s (31 chiavi a 30 al secondo) con i piedi che
; tengono a 1.9 (camminata), 2.45 (corsa), 2.43 (corsa veloce) e 2.51 m/s (corsa massima);
; "at" Ã¨ la velocitÃ  del gioco a cui ogni clip Ã¨ piena (Knuckles corre fino a 13 m/s) e la
; velocitÃ  di riproduzione segue la velocitÃ  fino a rate_max: il piede d'appoggio resta fermo
; fino a 4.6 m/s (camminata), 7.3 (corsa), 9.7 (corsa veloce) e 16 (corsa massima)
; Attesa: in SA2 kn_wait_a Ã¨ un respiro di 7 chiavi (0.23 s) che il gioco rallenta; a velocitÃ 
; piena girava piÃ¹ di 4 volte al secondo e Knuckles da fermo sembrava tremare. CosÃ¬ il respiro dura
; circa 1.6 s.
[slot.idle]
rate = 0.15

[slot.walk]
at = 1.4
rate_max = 2.4

[slot.jog]
at = 4.0
rate_max = 3.0

[slot.run]
at = 7.5
rate_max = 4.0
lean = 0.6

[slot.dash]
at = 12.0
rate_max = 6.5
lean = 0.6

[slot.spin]
rate = 1.0
rate_speed = 0.03
rate_max = 1.6

; Arrampicata: SA2 gira il personaggio con la pancia verso il muro (il muro Ã¨ il suo "suolo"):
; le clip sono sdraiate, si raddrizzano qui (pancia verso il muro, testa in su: -90Â°, piÃ¹ 10Â°
; all'indietro perchÃ© i guantoni del nostro modello sono piÃ¹ grandi di quelli di SA2) e si
; appoggiano al muro, che Ã¨ a 0.35 m davanti (raggio della capsula): pugni e punte delle scarpe
; sul muro, bacino all'altezza di quando sta in piedi. Controllo: KA_SHEET_WALL=0.35 con
; tools/dev/clip_sheet.gd disegna il muro.
[slot.climb]
orient = Vector3(-100, 0, 0)
offset = Vector3(0, 0.8, 0.31)

[slot.climb_idle]
orient = Vector3(-100, 0, 0)
offset = Vector3(0, 0.8, 0.31)

[slot.climb_l]
orient = Vector3(-100, 0, 0)
offset = Vector3(0, 0.8, 0.31)

[slot.climb_r]
orient = Vector3(-100, 0, 0)
offset = Vector3(0, 0.8, 0.31)

[slot.climb_start]
orient = Vector3(-100, 0, 0)
offset = Vector3(0, 0.8, 0.31)

[slot.ledge]
orient = Vector3(-100, 0, 0)
offset = Vector3(0, 0.8, 0.31)

; Scavo: l'inizio col suo tempo, poi il ciclo
[slot.dig]
sync = "time"

[slot.idle_var]
blend_in = 0.4
blend_out = 0.4
␀␀␀; Animazioni originali di Sonic (Unleashed/Generations, scheletro chr_Sonic_HD di Generations).
; File: sonic_generations.glb, ridotto con tools/dev/clip_glb_prep.py dal GLB completo (230 clip)
; alle sole clip usate qui, senza le ossa del volto (il volto resta procedurale) e con le chiavi
; rotte della conversione corrette (--fix-spikes; vedi assets/characters/LEGGIMI-ANIMAZIONI.txt).
; Lo scheletro Ã¨ quasi il nostro (stessi nomi, scala 0.914, mani e piedi con assi diversi): il
; retarget relativo al riposo ("rest") lo porta sul modello senza girare mani e piedi.

[general]
face = "procedural"
secondary = "auto"
; molla: sopra questa velocitÃ  verticale (m/s) la posa della molla, sotto spring_end_speed la capriola finale
spring_speed = 8.0
spring_end_speed = 2.0
; atterraggio grande (sn_landing_big) se si cade piÃ¹ veloci di cosÃ¬ (m/s)
land_big_speed = 15.0
; quanto la curva (turn_lean) sposta verso le varianti _l/_r della corsa
turn_gain = 1.4

[slots]
idle = "sn_idle_loop"
idle_var = ["sn_idle00", "sn_idle01", "sn_idle02", "sn_idle03", "sn_idle05"]
walk = "sn_walk_loop"
jog = "sn_jog_loop"
jog_l = "sn_jog_l_loop"
jog_r = "sn_jog_r_loop"
run = "sn_run_loop"
run_l = "sn_run_l_loop"
run_r = "sn_run_r_loop"
dash = "sn_dash_loop"
dash_l = "sn_dash_l_loop"
dash_r = "sn_dash_r_loop"
boost = "sn_boost_loop"
boost_l = "sn_boost_l_loop"
boost_r = "sn_boost_r_loop"
skid_start = "sn_brake01_l"
skid = "sn_brake01_l_loop"
skid_end = "sn_brake01_l_e"
; rotaia da grind (Generations)
grind = "sn_grind_f_l_loop"
jump_start = "sn_jump_s"
jump = "sn_jump_loop"
fall = "sn_jump_d_loop"
land = "sn_jump_e"
land_big = "sn_landing_big"
spring = "sn_springjump_loop"
spring_end = "sn_springjump_e"
; palla: salto, rotolata, spin dash, homing e bounce (Generations non ha la spin dash a terra)
spin = "sn_ball_loop"
trick = ["sn_homing_act00", "sn_homing_act01", "sn_homing_act02", "sn_homing_act03", "sn_homing_act04", "sn_homing_act05"]
stomp = "sn_stomp_loop"
stomp_land = "sn_stomp_squat"
light_dash = "sn_ringdash_loop"
hurt = "sn_damage_near"
death = "sn_dead_fall_loop"
; livello completato: la posa del rango S di Sonic Unleashed (sonic_result_reaction_S, dai file del
; gioco: VictoryPose la chiede con CharacterAnimator.clip_pose)
win = "sn_result_reaction_S"

; Locomozione: "at" Ã¨ la velocitÃ  del gioco (m/s) a cui la clip Ã¨ piena (in mezzo si fondono);
; la velocitÃ  di riproduzione Ã¨ velocitÃ  / velocitÃ  dei piedi (stimata dalla clip: le clip di
; Generations sono cicli di 1.33 s registrati "lenti", i piedi tengono a 0.85, 1.23, 1.44, 2.35 e
; 2.09 m/s), fino a rate_max: fin lÃ¬ il piede d'appoggio resta fermo sul suolo (camminata fino a
; 2.2 m/s, jog 4.9, corsa 8.9, dash e boost circa 18); oltre, i piedi scivolano come nel gioco
; originale invece di diventare una girandola.
[slot.walk]
at = 1.2
rate_max = 2.6

[slot.jog]
at = 4.5
rate_max = 4.0
lean = 0.6

[slot.run]
at = 8.5
rate_max = 6.2
lean = 0.6

[slot.dash]
at = 15.0
rate_max = 8.0
lean = 0.6

[slot.boost]
at = 26.0
rate_max = 8.5
lean = 0.6

[slot.spin]
rate = 0.7
rate_speed = 0.02
rate_max = 1.3

[slot.idle_var]
blend_in = 0.4
blend_out = 0.4

; acrobazia dopo l'attacco a ricerca: un po' piÃ¹ svelta (0.6 s invece di 0.75): per tanto Sonic non
; puÃ² rifare l'attacco e la mira Ã¨ nascosta (player.gd _start_trick), finita si ricomincia prima di
; essere ricaduti a terra
[slot.trick]
blend_in = 0.05
rate = 1.25

[slot.hurt]
blend_in = 0.06

; solo il finale della clip (prima c'Ã¨ la capriola in aria): dal ritorno a terra alla posa, poi
; ferma lÃ¬; bacino fermo in orizzontale (nella clip Ã¨ spostato di mezzo metro)
[slot.win]
start = 4.3
root_motion = "strip"
