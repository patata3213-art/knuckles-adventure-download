¡e1iğ» ‡F™üç¾ko¥Ìc·—0œ_wÔÇŞ°¨÷„‡ºH<Š>‰öÉÃXc%Ú@cL´$½ùİ²/Ïø•½wi3œëwğğµ’‹wŒ:Áoìgş˜4¿+ÊnÏúX@I|gÆğä„ñÜèpRøSÀ±Ñ]ÅÃ±ĞÉ¤‡ùvqCM5„Îé¿ÌVòğ¼›É³-_¯íqnÔùû…c[Úâì­óMÎyzóİ¡cm@İ†‡Éşöa½léDøøNC^õßñÁµ`9OÇ/ı½®i}JvwÃb6ÉÚF†/?K±ßòú␀tƒÿwKG-MŸu-l™¸¯ã}§¼çî¬¹0¤ÿ”»şvp0àG×-]ë^ í‰GúSç‚¿ãv+f¸8ÿ¬É'L@í”ÒÖÎ­ÊÖÏí¨¶MW„Qµ%5&—‹ıŸÕÖ<‹³xé.‡l»F;_x}-z␀Ü­ú[’\äx<Hf?ø'\¦¹¬Ğc5ñc^áªåØ‹BOõmTkÉ7öÓL°iµz¬#—Şßá8tnÍë4c`÷pºK`£ÜZcoáÏÉRq:_ægìü&Ê+>êôOú®Ağ‹ î~¡­g™ˆ‡^§Âz£>Ôä¾{ƒWa½—…`ht1²tˆ¶o–Œ/ˆ½ıcrã3¹„»âŸ«‹p÷1_2?9™tNgv'$æ°%ü~ö|Óóa€oÔ;ö¯q #Ğ?‡şßËèY_='ìõêÿÚçjm␀Ì.ßXjÜóí®µl†ıÆ23 ±¼ÁšØk#Û‡¿®r.•Í\ñ?®¨ÿŞ»ÖMÈ™±2‘B`àÕq/ù ®(g;§º	§ÂjqîWâùH>÷{Rgu‘'\ÁşÅËÈî‘ê¹M—û¤¬lg·ÿ¿ä‘ùs¥Ğshader_type spatial;
// Carnival Night Zone: il fondo lontano sotto il parco sospeso (gen_cnz/deco.gd _abyss: il piano a
// -70 m, niente collisioni). Non un pavimento: la foschia viola e magenta che sale dal basso, piÃ¹
// chiara sotto la linea del parco (z vicino a 0, dove passano le piste), le grandi pozze di luce, e giÃ¹
// in fondo il tappeto lontano delle luci della cittÃ  (celle di 6 m, una su venti accesa, calde, ciano o
// magenta, che tremolano piano) con qualche fila di lampadine che si rincorrono (le giostre laggiÃ¹).
// La nebbia d'altezza qui sotto coprirebbe tutto: niente nebbia del motore, la foschia la fa lo shader
// (verso fog_col), e le luci la bucano appena. Le luci sono dischi grandi almeno un pixel che tengono la
// stessa energia (fwidth): niente sfarfallio.
render_mode blend_mix, depth_draw_opaque, cull_disabled, unshaded, fog_disabled, shadows_disabled;

uniform vec3 fog_col : source_color = vec3(0.052, 0.02, 0.09);
uniform vec3 deep : source_color = vec3(0.02, 0.008, 0.04);
uniform vec3 haze : source_color = vec3(0.2, 0.05, 0.18);
uniform vec3 pool_col : source_color = vec3(0.36, 0.08, 0.27);
uniform float park_z = 0.0;
uniform float lights = 1.0;

varying vec3 wp;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

float h12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float vn(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(h12(i), h12(i + vec2(1, 0)), u.x), mix(h12(i + vec2(0, 1)), h12(i + vec2(1, 1)), u.x), u.y);
}

float fbm3(vec2 p) {
	float s = vn(p) * 0.55;
	s += vn(p * 2.07 + 13.1) * 0.3;
	s += vn(p * 4.3 + 7.7) * 0.15;
	return s;
}

// una luce di raggio r (m) a distanza dist (m), pixel grande px (m): stessa energia se Ã¨ piccola
float lamp(float dist, float r, float px) {
	float rr = max(r, px * 0.8);
	float c = 1.0 - smoothstep(rr - px * 0.5, rr + px * 0.5, dist);
	return c * (r * r) / (rr * rr);
}

void fragment() {
	vec2 p = wp.xz;
	float px = max(length(fwidth(p)), 0.01);
	// la foschia: piÃ¹ chiara sotto il parco, a strati che si muovono appena
	float under = exp(-abs(p.y - park_z) / 70.0);
	float n = fbm3(p * 0.012 + vec2(TIME * 0.004, 0.0));
	float pools = smoothstep(0.45, 0.8, vn(p * 0.006 + 3.3));
	vec3 col = mix(deep, haze, clamp(under * 0.8 + n * 0.35, 0.0, 1.0));
	col += pool_col * pools * (0.25 + 0.5 * under) * 0.5;
	// il tappeto delle luci della cittÃ , lontano
	vec2 g = p / 6.0;
	vec2 cell = floor(g);
	float hsh = h12(cell);
	vec2 c = (cell + 0.5 + (vec2(h12(cell + 3.1), h12(cell + 7.9)) - 0.5) * 0.6) * 6.0;
	float tw = 0.7 + 0.3 * sin(TIME * (0.6 + hsh * 1.5) + hsh * 40.0);
	float on = step(0.95, hsh) * tw;
	vec3 lc = hsh > 0.985 ? vec3(0.35, 0.85, 1.0) : (hsh > 0.972 ? vec3(1.0, 0.3, 0.7) : vec3(1.0, 0.7, 0.35));
	vec3 em = lc * lamp(length(p - c), 0.45, px) * on * 2.2;
	// le file delle giostre laggiÃ¹: lampadine che si rincorrono lungo X ogni tanto
	float row_id = floor(p.y / 38.0);
	float row = step(0.72, h12(vec2(row_id, 1.7)));
	float ry = (row_id + 0.5) * 38.0;
	float bx = (floor(p.x / 2.2) + 0.5) * 2.2;
	float chase = step(0.6, fract((bx / 2.2 - TIME * 3.0) / 5.0));
	float seg = step(0.5, vn(vec2(p.x * 0.01, row_id)));
	em += vec3(1.0, 0.78, 0.4) * lamp(length(vec2(p.x - bx, p.y - ry)), 0.3, px) * row * seg * (0.3 + 0.7 * chase) * 1.6;
	// la foschia sopra: le luci la bucano appena, il fondo sfuma nel colore della nebbia
	float dist = length(VERTEX);
	float veil = 0.55 + 0.35 * smoothstep(80.0, 600.0, dist);
	col = mix(col, fog_col, veil);
	em *= mix(0.55, 0.15, smoothstep(150.0, 700.0, dist)) * lights;
	ALBEDO = col + em;
}
shader_type spatial;
// Carnival Night Zone: i fasci dei fari che spazzano il cielo (scripts/env/gen_cnz/deco.gd, _beams).
// Ogni fascio Ã¨ un cono aperto dal faro (CUSTOM0.xyz = la punta, CUSTOM0.w = la fase); il vertice gira
// attorno alla punta (su e giÃ¹ e di lato) cosÃ¬ i fasci si muovono da soli senza nodi nÃ© script. UV.y: 0
// alla punta, 1 in fondo; UV.x il giro attorno al cono. Come i fari di Eggmanland
// (gen_egl1/landmarks.gd): l'anima morbida (piÃ¹ forte vista di fronte, sparisce di taglio), sfuma
// lungo il fascio e con la distanza, si spegne vicino alla telecamera (niente lenzuolo bianco davanti
// agli occhi); dentro il pulviscolo che sale piano; dove il fascio entra nelle cose si ammorbidisce
// (con la profonditÃ  della schermata: con l'MSAA non c'Ã¨ e si salta). La nebbia non lo tocca (ha la sua
// dissolvenza). In piÃ¹, alla punta di ogni faro, il bagliore della lampada girato verso la telecamera e
// il disco della lente (UV.y < 0: quadrati che il vertice gira verso chi guarda; UV2 = l'angolo del
// quadrato): tutti i fari restano una chiamata sola.
render_mode blend_add, depth_draw_never, cull_disabled, unshaded, shadows_disabled, fog_disabled;

uniform sampler2D depth_tex : hint_depth_texture, filter_nearest, repeat_disable;
uniform vec3 tint : source_color = vec3(0.75, 0.85, 1.0);
uniform float energy = 0.22;
uniform float sweep = 0.55;
uniform float speed = 0.35;
uniform float flare_size = 2.6;
uniform float flare_k = 0.55;

varying float along;
varying float flare;
varying vec2 corner;
varying float aim;
varying float around;
varying float ph_v;

mat3 rot_axis(vec3 a, float ang) {
	float s = sin(ang);
	float c = cos(ang);
	float oc = 1.0 - c;
	return mat3(vec3(oc * a.x * a.x + c, oc * a.x * a.y + a.z * s, oc * a.z * a.x - a.y * s),
		vec3(oc * a.x * a.y - a.z * s, oc * a.y * a.y + c, oc * a.y * a.z + a.x * s),
		vec3(oc * a.z * a.x + a.y * s, oc * a.y * a.z - a.x * s, oc * a.z * a.z + c));
}

float h12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float vn(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(h12(i), h12(i + vec2(1, 0)), u.x), mix(h12(i + vec2(0, 1)), h12(i + vec2(1, 1)), u.x), u.y);
}

void vertex() {
	vec3 apex = CUSTOM0.xyz;
	float ph = CUSTOM0.w;
	float t = TIME * speed + ph * 6.2831;
	mat3 r = rot_axis(vec3(0.0, 1.0, 0.0), sin(t) * 1.4 + ph * 3.0) * rot_axis(vec3(1.0, 0.0, 0.0), sweep * sin(t * 1.37 + ph * 2.0));
	ph_v = ph;
	around = UV.x;
	if (UV.y < 0.0) {
		// il bagliore della lampada: un quadrato attorno alla punta, girato verso la telecamera
		flare = 1.0;
		corner = UV2;
		vec3 wa = (MODEL_MATRIX * vec4(apex, 1.0)).xyz;
		vec3 cam = INV_VIEW_MATRIX[3].xyz;
		vec3 right = INV_VIEW_MATRIX[0].xyz;
		vec3 up = INV_VIEW_MATRIX[1].xyz;
		vec3 w = wa + (right * UV2.x + up * UV2.y) * flare_size + normalize(cam - wa) * 0.4;
		VERTEX = w - MODEL_MATRIX[3].xyz;
		NORMAL = normalize(cam - wa);
		// quanto il fascio guarda verso la telecamera (il bagliore Ã¨ piÃ¹ forte se ci punta addosso)
		vec3 axis = r * vec3(0.0, 1.0, 0.0);
		aim = max(dot(axis, normalize(cam - wa)), 0.0);
		along = 0.0;
	} else {
		flare = 0.0;
		corner = vec2(0.0);
		aim = 0.0;
		vec3 rel = VERTEX - apex;
		VERTEX = apex + r * rel;
		NORMAL = r * NORMAL;
		along = UV.y;
	}
}

void fragment() {
	float d = length(VERTEX);
	if (flare > 0.5) {
		float rr = length(corner);
		float glow = exp(-rr * rr * 9.0) * (0.35 + 0.65 * pow(aim, 3.0));
		float lens = 1.0 - smoothstep(0.08, 0.14, rr);
		float k = (glow * 0.9 + lens * 1.2) * flare_k;
		k *= smoothstep(10.0, 45.0, d) * exp(-d * 0.0016);
		ALBEDO = mix(tint, vec3(1.0), lens * 0.6) * k;
	} else {
		float facing = abs(dot(normalize(NORMAL), normalize(VIEW)));
		// sfuma decisa verso il fondo e con la distanza: le punte lontane di tanti fasci si sommano dove
		// convergono (sopra la pista) e, poco sfumate, facevano un disco bianco nel cielo
		float a = pow(facing, 1.4) * smoothstep(0.0, 0.03, along) * (1.0 - smoothstep(0.15, 0.95, along));
		a *= exp(-d * 0.0025) * smoothstep(6.0, 60.0, d);
		// il pulviscolo che sale lungo il fascio
		a *= 0.62 + 0.38 * vn(vec2(around * 9.0 + ph_v * 10.0, along * 26.0 - TIME * 0.35));
		// dove il fascio entra nelle cose (solo se c'Ã¨ la profonditÃ : con l'MSAA no)
		float dz = textureLod(depth_tex, SCREEN_UV, 0.0).r;
		if (dz > 0.0) {
			vec4 v = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, dz, 1.0);
			float scene_z = -v.z / v.w;
			a *= smoothstep(0.0, 3.0, scene_z + VERTEX.z);
		}
		ALBEDO = tint * a * energy;
	}
}
␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Carnival Night Zone: le file di lampadine delle insegne e dei bordi (layout.gd: strisce sottili con
// UV.x = metri lungo la fila, UV.y 0..1 di traverso). Una lampadina ogni "spacing" metri su un fondo
// scuro, accese a rincorsa (come i luna park): tre colori che girano, ognuna si accende e si spegne
// col suo turno; UV2.x sfasa le file. Le lampadine fanno luce propria (il bagliore le gonfia):
//   - il centro della lampadina (il 40%) Ã¨ piÃ¹ caldo e piÃ¹ forte del vetro attorno;
//   - da lontano (quando la lampadina Ã¨ grande meno di un terzo di pixel) disco e alone si fondono
//     nella loro media: la fila diventa una striscia ferma, niente sfarfallio nÃ© moirÃ©;
//   - near_k: da vicino si abbassa fino a near_k (come i neon), da lontano Ã¨ piena;
//   - il vetro a cupola col riflesso fermo, l'anello scuro del portalampada sul fondo, le spente col
//     filamento appena acceso.
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform vec3 back : source_color = vec3(0.05, 0.03, 0.08);
uniform vec3 bulb_a : source_color = vec3(1.0, 0.85, 0.35);
uniform vec3 bulb_b : source_color = vec3(1.0, 0.3, 0.55);
uniform vec3 bulb_c : source_color = vec3(0.3, 0.85, 1.0);
uniform float spacing = 0.6;
uniform float speed = 3.0;
uniform float energy = 3.2;
uniform float colors = 1.0;     // 0: tutte bulb_a; 1: i tre colori a giro
uniform float near_k = 1.0;
uniform float near_d = 3.0;
uniform float far_d = 30.0;
uniform float hot = 4.0;        // il centro acceso (moltiplica l'energia)

void fragment() {
	float k = UV.x / spacing;
	float id = floor(k);
	vec2 p = vec2(fract(k) - 0.5, UV.y - 0.5);
	float r = length(p * vec2(1.0, 1.2));
	// quanto Ã¨ grande la lampadina sullo schermo (in lampadine per pixel)
	float fp = max(fwidth(k), fwidth(UV.y));
	float far = smoothstep(0.35, 0.9, fp);
	float dot_m = 1.0 - smoothstep(0.24, 0.32, r);
	float core = 1.0 - smoothstep(0.08, 0.13, r);
	float halo = (1.0 - smoothstep(0.2, 0.5, r)) * 0.35;
	// da lontano: la media sul passo (disco circa 0.27, alone circa 0.12, centro circa 0.04)
	dot_m = mix(dot_m, 0.27, far);
	core = mix(core, 0.04, far);
	halo = mix(halo, 0.12, far);
	float phase = fract((id - TIME * speed + UV2.x * 7.0) / 3.0);
	float lit = step(0.34, phase);
	float on = 0.25 + 0.75 * lit;
	float which = mod(id + floor(UV2.x * 3.0), 3.0);
	vec3 bc = bulb_a;
	if (colors > 0.5) {
		bc = which < 0.5 ? bulb_a : (which < 1.5 ? bulb_b : bulb_c);
	}
	float near = mix(near_k, 1.0, smoothstep(near_d, far_d, length(VERTEX)));
	// il portalampada: un anello piÃ¹ scuro attorno al vetro
	float socket = smoothstep(0.3, 0.36, r) * (1.0 - smoothstep(0.36, 0.46, r)) * (1.0 - far);
	vec3 bk = back * (1.0 - 0.6 * socket);
	// il vetro: il riflesso fermo in alto a sinistra della cupola
	float spec = (1.0 - smoothstep(0.0, 0.07, length(p - vec2(-0.08, 0.1)))) * dot_m * (1.0 - far);
	// le spente: il filamento appena acceso al centro (con near_k < 1, cioÃ¨ nell'ambiente)
	float fil = mix(1.0, 0.12 / 0.25, step(near_k, 0.999) * (1.0 - lit));
	vec3 em = bc * (dot_m * on * energy + halo * on * 0.6) * near;
	em += mix(bc, vec3(1.0, 0.95, 0.85), 0.5) * core * lit * energy * (hot - 1.0) * 0.35 * near * step(near_k, 0.999);
	em *= mix(1.0, fil, 1.0 - lit);
	ALBEDO = mix(bk, bc * 0.6, dot_m);
	EMISSION = em + vec3(0.9) * spec * 0.25;
	ROUGHNESS = mix(0.3, 0.08, dot_m);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀// Carnival Night Zone: i pezzi in comune degli shader dei materiali (pavimenti, strisce, metalli).
//   - rumore (hash, value noise, fbm) e rilievo dalle derivate: gli stessi di Hydrocity
//     (shaders/env/hcz/hcz_common.gdshaderinc), copiati qui senza la parte dell'acqua;
//   - il riflesso finto della notte del parco: nel progetto non ci sono SSR nÃ© sonde, e il cielo vero
//     (la radianza) dÃ  solo il gradiente. Qui si aggiungono le luci che un pavimento laccato o un
//     metallo dovrebbero riflettere: le file di lampade del parco tutt'attorno all'orizzonte (rosa,
//     ciano e calde, dal giro attorno: atan(R.z, R.x)), i fari piÃ¹ in alto e il riflesso della luna.
//     PiÃ¹ Ã¨ ruvido piÃ¹ Ã¨ largo e smorto (stessa energia in media). Va in EMISSION: non si spegne
//     all'ombra, come un riflesso.

const vec3 CNZ_MOON = vec3(-0.3492, 0.4191, -0.8381);

float cnz_h12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float cnz_vn(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = cnz_h12(i);
	float b = cnz_h12(i + vec2(1.0, 0.0));
	float c = cnz_h12(i + vec2(0.0, 1.0));
	float d = cnz_h12(i + vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

// tre ottave (0..~0.9)
float cnz_fbm(vec2 p) {
	float s = cnz_vn(p) * 0.5;
	p = p * 2.03 + vec2(17.1, 9.3);
	s += cnz_vn(p) * 0.25;
	p = p * 2.03 + vec2(17.1, 9.3);
	s += cnz_vn(p) * 0.125;
	return s / 0.875 * 0.94;
}

// normale (del mondo) inclinata dall'altezza h (metri), che varia lungo la superficie in p (mondo)
vec3 cnz_bump(vec3 n, vec3 p, float h, float k) {
	vec3 dpdx = dFdx(p);
	vec3 dpdy = dFdy(p);
	float hx = dFdx(h) * k;
	float hy = dFdy(h) * k;
	vec3 r1 = cross(dpdy, n);
	vec3 r2 = cross(n, dpdx);
	float det = dot(dpdx, r1);
	vec3 g = sign(det) * (hx * r1 + hy * r2);
	return normalize(abs(det) * n - g);
}

// le caustiche (la rete di luce delle onde), come in Hydrocity: due rumori che scorrono in versi
// diversi, la riga chiara dove si incrociano
float cnz_caustic(vec2 p, float t) {
	vec2 q = p * 5.0;
	float a = cnz_vn(q + vec2(t * 0.6, t * 0.4));
	float b = cnz_vn(q * 1.3 - vec2(t * 0.5, -t * 0.62) + 7.0);
	float r = clamp(1.0 - abs(a - b) * 3.2, 0.0, 1.0);
	return r * r * r * r * r * 1.6;
}

// una fila di lampade lungo il giro dell'orizzonte: f lampade per giro, nitida quanto p
float cnz_row(float az, float f, float ph, float p) {
	return pow(0.5 + 0.5 * sin(az * f + ph), p);
}

// le luci della notte del parco viste nella direzione R (mondo, unitaria), ruvidezza rough
vec3 cnz_night(vec3 R, float rough) {
	float y = R.y;
	float az = atan(R.z, R.x);
	float p = mix(48.0, 2.5, rough);
	float amp = mix(1.7, 0.55, rough);
	// le file di lampade dei padiglioni: appena sopra l'orizzonte
	float band = exp(-abs(y - 0.05) * mix(32.0, 5.0, rough));
	vec3 c = vec3(1.0, 0.3, 0.65) * cnz_row(az, 7.0, 0.7, p);
	c += vec3(0.25, 0.85, 1.0) * cnz_row(az, 13.0, 2.1, p) * 0.8;
	c += vec3(1.0, 0.72, 0.3) * cnz_row(az, 29.0, 4.4, p) * 0.7;
	c *= band * amp;
	// le insegne e le ruote, piÃ¹ in alto e piÃ¹ rade
	float band2 = exp(-abs(y - 0.2) * mix(22.0, 4.0, rough));
	c += vec3(1.0, 0.45, 0.85) * cnz_row(az, 3.0, 5.2, p * 1.5) * band2 * amp * 0.6;
	// sotto l'orizzonte: il chiarore viola del fondo
	c += vec3(0.1, 0.03, 0.12) * smoothstep(0.02, -0.25, y);
	// la luna
	float m = max(dot(R, CNZ_MOON), 0.0);
	c += vec3(0.75, 0.82, 1.0) * pow(m, mix(700.0, 10.0, rough)) * mix(2.0, 0.15, rough);
	return c;
}

// il riflesso finto da sommare in EMISSION: normale e vista nel mondo (unitarie, la vista verso la
// telecamera), ruvidezza, f0 (0.04 vernici, il colore per i metalli), quanto (k)
vec3 cnz_refl(vec3 nw, vec3 vw, float rough, vec3 f0, float k) {
	vec3 R = reflect(-vw, nw);
	float nv = clamp(dot(nw, vw), 0.0, 1.0);
	vec3 F = f0 + (1.0 - f0) * pow(1.0 - nv, 5.0);
	return cnz_night(R, rough) * F * k * (1.0 - rough * 0.6);
}
␀␀␀␀␀␀␀␀␀shader_type spatial;
// Carnival Night Zone: i festoni di lampadine appesi fra le torri e dalle punte dei tendoni giÃ¹ fino al
// bordo (scripts/env/gen_cnz/deco.gd, _garlands). Ogni festone Ã¨ un nastro lungo la catenaria: i vertici
// stanno sulla curva (NORMAL = la tangente, UV.x = i metri lungo il filo, UV.y = 0 / 1 i due lati) e il
// vertex li apre di traverso verso la telecamera, cosÃ¬ il nastro non si vede mai di taglio. Il fragment
// disegna le lampadine ogni "spacing" metri (dischi grandi almeno un pixel che tengono la stessa
// energia, col loro alone), a colori che si alternano e che si rincorrono piano; il filo non si vede di
// notte. Additivo, non fa ombra nÃ© nebbia: sfuma da sÃ© lontano (e il nodo si spegne a 120 m).
render_mode blend_add, depth_draw_never, cull_disabled, unshaded, shadows_disabled, fog_disabled;

uniform float energy = 1.5;
uniform float spacing = 0.8;
uniform float bulb_r = 0.07;
uniform float width = 0.5;
uniform float speed = 1.5;
uniform float far_d = 115.0;

varying float along;
varying float across;

void vertex() {
	vec3 wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	vec3 t = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	vec3 to_cam = normalize(INV_VIEW_MATRIX[3].xyz - wpos);
	vec3 sd = cross(t, to_cam);
	float l = length(sd);
	sd = l > 1e-4 ? sd / l : vec3(0.0, 1.0, 0.0);
	VERTEX += inverse(mat3(MODEL_MATRIX)) * sd * (UV.y - 0.5) * width;
	along = UV.x;
	across = UV.y;
}

void fragment() {
	float d = length(VERTEX);
	float px = max(fwidth(along), 1e-4);
	float k = along / spacing;
	float id = floor(k + 0.5);
	float dx = (k - id) * spacing;
	float dy = (across - 0.5) * width;
	float r = length(vec2(dx, dy));
	float rr = max(bulb_r, px * 0.8);
	float core = (1.0 - smoothstep(rr - px * 0.5, rr + px * 0.5, r)) * (bulb_r * bulb_r) / (rr * rr);
	float halo = exp(-r * r / (bulb_r * bulb_r * 10.0)) * 0.22;
	float ci = mod(id, 4.0);
	vec3 col = ci < 1.0 ? vec3(1.0, 0.35, 0.7) : (ci < 2.0 ? vec3(1.0, 0.8, 0.3) : (ci < 3.0 ? vec3(0.35, 0.85, 1.0) : vec3(1.0, 0.9, 0.75)));
	float chase = 0.6 + 0.4 * step(0.5, fract((id - TIME * speed) / 7.0));
	float fade = smoothstep(3.0, 10.0, d) * (1.0 - smoothstep(far_d - 25.0, far_d, d));
	ALBEDO = col * (core + halo) * chase * energy * fade;
}
␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Carnival Night Zone: il pavimento delle piste e delle piazze (layout.gd). Sopra (facce in alto) le
// piastrelle a scacchi blu notte e viola scuro, laccate, con le fughe sottili che brillano di ciano (e,
// ogni 14 m in Z, una riga di frecce gialle accese che scorrono avanti, verso +X); di lato e sotto
// la fascia scura col bordo giallo. Tutto dalla posizione nel mondo (con UV = 0 va bene lo stesso).
// Il pavimento di oggi, come quelli di Hydrocity e di Marble Garden:
//   - le fughe incassate e lo smusso della piastrella in rilievo (dalle derivate: cnz_bump), l'ombra
//     nelle fughe (AO), tutto filtrato sul pixel: la fuga Ã¨ una riga "box-filtrata" che da lontano
//     diventa la sua media (niente reticolo che sfarfalla, niente velo rosa all'orizzonte);
//   - ogni piastrella un filo diversa (tinta, lucido), macchie larghe di bagnato (piÃ¹ lucide e scure),
//     i graffi fini nella ruvidezza da vicino;
//   - la lacca che riflette: il cielo vero (la radianza) piÃ¹ il riflesso finto delle luci del parco
//     (cnz_common.gdshaderinc), con Fresnel: guardando lungo la pista il pavimento si accende.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/cnz/cnz_common.gdshaderinc"

uniform vec3 tile_a : source_color = vec3(0.13, 0.13, 0.32);
uniform vec3 tile_b : source_color = vec3(0.24, 0.12, 0.34);
uniform vec3 grout : source_color = vec3(0.1, 0.85, 1.0);
uniform float tile = 2.0;
uniform float grout_glow = 1.1;
uniform float grout_w = 0.035;      // m, mezza larghezza della fuga
uniform float bevel = 0.07;         // m, lo smusso della piastrella
uniform vec3 side_col : source_color = vec3(0.1, 0.12, 0.42);
uniform vec3 side_band : source_color = vec3(1.0, 0.78, 0.15);
uniform float arrows = 1.0;
uniform float vary = 0.14;          // quanto cambia una piastrella dall'altra
uniform float wet = 0.6;            // le macchie di bagnato
uniform float gloss = 0.14;         // la ruvidezza della lacca
uniform float refl = 1.0;           // il riflesso finto delle luci
uniform float light_rough = 0.0;    // la ruvidezza minima per le luci vere (come stripes.gdshader)
uniform float lift = 0.0;           // la luce rimbalzata dalle pareti accese (pavimenti chiusi: il tamburo)
uniform vec3 lift_col : source_color = vec3(1.0, 0.7, 1.0);
// 1: la luce rimbalzata a pozze larghe (macchie di una decina di metri), non uguale dappertutto: la
// griglia di neon resta sul nero e le ombre si vedono
uniform float lift_pools = 0.0;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

// la fuga su un asse: copertura (0..1) della riga larga 2Â·w attorno alle linee ogni "t" metri, vista
// da un pixel largo px (integrale del box): da vicino nitida, da lontano la media 2w/t
float grout_cov(float x, float t, float w, float px) {
	float d = (fract(x / t + 0.5) - 0.5) * t;
	float hp = max(px, 1e-4) * 0.5;
	float c = (clamp(d + hp, -w, w) - clamp(d - hp, -w, w)) / (2.0 * hp);
	return mix(c, 2.0 * w / t, smoothstep(0.25 * t, 0.7 * t, px));
}

void fragment() {
	vec3 n = normalize(wn);
	float up = smoothstep(0.55, 0.75, n.y);
	vec2 p = wp.xz;
	vec2 pxv = max(fwidth(p), vec2(1e-4));
	float px = length(pxv);
	vec2 q = p / tile;
	vec2 id = floor(q);
	vec2 f = fract(q);
	float chk = mod(id.x + id.y, 2.0);
	float hv = cnz_h12(id + 17.0);
	float hv2 = cnz_h12(id + 61.3);
	// distanza (m) dal bordo della piastrella e la fuga filtrata
	vec2 e2 = min(f, 1.0 - f) * tile;
	float e = min(e2.x, e2.y);
	float gx = grout_cov(p.x, tile, grout_w, pxv.x);
	float gz = grout_cov(p.y, tile, grout_w, pxv.y);
	float gl = 1.0 - (1.0 - gx) * (1.0 - gz);
	float near = 1.0 - smoothstep(bevel * 0.6, bevel * 3.0, px);
	// la piastrella: tinta a scacchi, ognuna un filo diversa, macchie larghe e un riflesso morbido
	vec3 c = mix(tile_a, tile_b, chk);
	c *= 1.0 + (hv - 0.5) * 2.0 * vary;
	float blot = cnz_fbm(p * 0.11 + 5.0);
	float wetm = smoothstep(0.5, 0.72, blot) * wet;
	c *= 1.0 - 0.25 * wetm;
	c *= 0.9 + 0.2 * smoothstep(0.0, tile * 0.5, e) * near + 0.1 * (1.0 - near);
	// lucido: per piastrella, il bagnato piÃ¹ lucido, i graffi fini da vicino
	float r = gloss * (0.8 + 0.5 * hv2);
	r = mix(r, 0.05, wetm);
	float scr = cnz_vn(vec2(p.x * 1.3 + p.y * 7.0, p.y * 1.3 - p.x * 7.0) + id * 3.7);
	r += smoothstep(0.62, 0.9, scr) * 0.16 * near;
	r = mix(r, 0.7, gl);
	// lo smusso e la fuga incassata, in rilievo
	float h = smoothstep(grout_w, grout_w + bevel, e) * 0.012;
	vec3 nb = n;
	if (near > 0.001) {
		nb = normalize(mix(n, cnz_bump(n, wp, h, 1.0), near * up));
	}
	float ao = mix(1.0, 0.45 + 0.55 * smoothstep(grout_w * 0.5, grout_w + bevel * 1.5, e), near);
	ao = mix(ao, 1.0 - 0.35 * gl, 1.0 - near);
	// le fughe accese
	vec3 em = grout * gl * grout_glow;
	// le frecce: una riga lungo il centro della pista (z vicino a un multiplo di 14 m: le strade)
	float az = abs(fract(wp.z / 14.0 + 0.5) - 0.5) * 14.0;
	float ax = fract(wp.x / 3.0 - TIME * 0.6);
	float aw = 0.08 + clamp(pxv.x / 3.0, 0.0, 0.3);
	float chev = 1.0 - smoothstep(0.0, aw, abs(ax - 0.5 - az * 0.25) - 0.08);
	chev *= 1.0 - smoothstep(0.8, 0.95, az);
	chev *= 1.0 - smoothstep(0.6, 2.0, px);
	em += vec3(1.0, 0.75, 0.15) * chev * arrows * 0.8;
	c = mix(c, vec3(0.35, 0.25, 0.05), chev * arrows * 0.5);
	// la lacca riflette (non nelle fughe)
	vec3 vw = normalize(CAMERA_POSITION_WORLD - wp);
	em += cnz_refl(nb, vw, r, vec3(0.04), refl) * (1.0 - gl);
	// nei posti chiusi la luce che rimbalza dalle pareti accese (0 = niente)
	float pool = mix(1.0, smoothstep(0.36, 0.74, cnz_fbm(p * 0.045 + 3.0)), lift_pools);
	em += c * lift_col * lift * pool * (1.0 - gl);
	// i fianchi
	vec3 side = side_col;
	float bandy = fract(wp.y / 1.0);
	side = mix(side, side_band, step(0.82, bandy) * 0.9);
	vec3 sem = side_band * step(0.82, bandy) * 0.6;
	ALBEDO = mix(side, c, up);
	EMISSION = mix(sem, em, up);
	ROUGHNESS = mix(0.4, max(r, light_rough), up);
	METALLIC = mix(0.2, 0.1, up);
	SPECULAR = mix(0.7, 0.5, up);
	AO = mix(1.0, ao, up);
	AO_LIGHT_AFFECT = 0.3 * up;
	NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Carnival Night Zone: i fuochi d'artificio lontani sopra il parco (deco.gd, _fireworks). Un mesh solo:
// ogni scoppio Ã¨ un mazzo di quadratini (CUSTOM0.xyz = il centro dello scoppio, CUSTOM0.w = la sua fase;
// NORMAL = la direzione della scintilla; UV2 = l'angolo del quadratino). Il vertex fa partire le
// scintille dal centro, le rallenta e le fa cadere, e gira il quadratino verso la telecamera; ogni
// scoppio si ripete ogni "period" secondi con la sua fase e cambia colore a ogni giro. Additivo, niente
// nebbia: si spegne da sÃ© (la coda della scintilla). Lontano (200-600 m): non fa luce nÃ© ombra.
render_mode blend_add, depth_draw_never, cull_disabled, unshaded, shadows_disabled, fog_disabled;

uniform float period = 7.0;
uniform float speed = 26.0;
uniform float size = 1.6;
uniform float energy = 2.2;

varying float life;
varying vec2 corner;
varying vec3 col;

float h11(float p) {
	return fract(sin(p * 91.3458) * 47453.5453);
}

void vertex() {
	vec3 c = CUSTOM0.xyz;
	float ph = CUSTOM0.w;
	float tt = TIME / period + ph;
	float cyc = floor(tt);
	float t = fract(tt) * period;
	// lo scoppio dura 2.6 s, poi buio fino al prossimo giro
	float u = clamp(t / 2.6, 0.0, 1.0);
	float r = speed * (1.0 - exp(-t * 2.2)) / 2.2;
	vec3 w = c + NORMAL * r + vec3(0.0, -2.4 * t * t, 0.0);
	vec3 right = INV_VIEW_MATRIX[0].xyz;
	vec3 up = INV_VIEW_MATRIX[1].xyz;
	float s = size * (1.0 - u * 0.6) * step(t, 2.6);
	w += (right * UV2.x + up * UV2.y) * s;
	VERTEX = (inverse(MODEL_MATRIX) * vec4(w, 1.0)).xyz;
	life = 1.0 - u;
	corner = UV2;
	float hsel = h11(cyc * 3.7 + ph * 17.0);
	col = hsel < 0.25 ? vec3(1.0, 0.35, 0.75) : (hsel < 0.5 ? vec3(0.35, 0.85, 1.0) : (hsel < 0.75 ? vec3(1.0, 0.78, 0.3) : vec3(0.7, 0.45, 1.0)));
}

void fragment() {
	float rr = length(corner);
	float spark = exp(-rr * rr * 6.0);
	float twinkle = 0.7 + 0.3 * sin(TIME * 30.0 + corner.x * 3.0);
	float k = spark * life * life * twinkle * energy;
	ALBEDO = mix(col, vec3(1.0), 0.3 * life) * k;
}
␀␀␀␀␀␀␀shader_type spatial;
// Carnival Night Zone: le insegne sui palazzi dello sfondo (deco.gd, _boards): un pannello scuro
// laccato (2:1) col disegno al neon e il giro di lampadine sul bordo che si rincorrono. Il disegno lo
// sceglie UV2.x (0 l'anello, 1 la stella, 2 le frecce, 3 il fulmine, 4 la luna con la stella), il
// colore UV2.y (la tinta, 0..1). Tutto dalle distanze (SDF) in UV, filtrato sul pixel; da vicino il
// neon scende sotto la soglia del bagliore come i tubi (near_k). Ogni tanto il disegno si spegne un
// attimo e si riaccende (come le insegne vere).
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform float energy = 2.6;
uniform float near_k = 0.45;
uniform float near_d = 4.0;
uniform float far_d = 40.0;

vec3 hue(float h) {
	vec3 k = clamp(abs(fract(h + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
	return mix(vec3(1.0), k, 0.85);
}

float h11(float p) {
	return fract(sin(p * 91.3458) * 47453.5453);
}

float sd_seg(vec2 p, vec2 a, vec2 b) {
	vec2 pa = p - a;
	vec2 ba = b - a;
	float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
	return length(pa - ba * h);
}

// stella a cinque punte (di Inigo Quilez), raggio r, rf la rientranza
float sd_star5(vec2 p, float r, float rf) {
	const vec2 k1 = vec2(0.809016994375, -0.587785252292);
	const vec2 k2 = vec2(-k1.x, k1.y);
	p.x = abs(p.x);
	p -= 2.0 * max(dot(k1, p), 0.0) * k1;
	p -= 2.0 * max(dot(k2, p), 0.0) * k2;
	p.x = abs(p.x);
	p.y -= r;
	vec2 ba = rf * vec2(-k1.y, k1.x) - vec2(0.0, 1.0);
	float h = clamp(dot(p, ba) / dot(ba, ba), 0.0, r);
	return length(p - ba * h) * sign(p.y * ba.x - p.x * ba.y);
}

float glyph(vec2 q, float kind) {
	if (kind < 0.5) {
		// l'anello, con la scintilla
		float d = abs(length(q - vec2(0.0, 0.0)) - 0.3);
		float s = min(sd_seg(q, vec2(0.38, 0.22), vec2(0.5, 0.34)), sd_seg(q, vec2(0.5, 0.22), vec2(0.38, 0.34)));
		return min(d, s);
	} else if (kind < 1.5) {
		return abs(sd_star5(q + vec2(0.0, 0.02), 0.36, 0.45));
	} else if (kind < 2.5) {
		// tre frecce
		float d = 10.0;
		for (int i = 0; i < 3; i++) {
			float x = -0.55 + float(i) * 0.4;
			d = min(d, min(sd_seg(q, vec2(x, 0.28), vec2(x + 0.25, 0.0)), sd_seg(q, vec2(x + 0.25, 0.0), vec2(x, -0.28))));
		}
		return d;
	} else if (kind < 3.5) {
		// il fulmine
		float d = sd_seg(q, vec2(0.12, 0.38), vec2(-0.12, 0.02));
		d = min(d, sd_seg(q, vec2(-0.12, 0.02), vec2(0.1, 0.02)));
		d = min(d, sd_seg(q, vec2(0.1, 0.02), vec2(-0.12, -0.38)));
		return d;
	}
	// la luna con la stella
	float moon = max(length(q - vec2(-0.12, 0.0)) - 0.32, -(length(q - vec2(0.0, 0.07)) - 0.28));
	float st = sd_star5(q - vec2(0.42, 0.12), 0.1, 0.45);
	return min(abs(moon), abs(st));
}

void fragment() {
	vec2 q = (vec2(UV.x, 1.0 - UV.y) - 0.5) * vec2(2.0, 1.0) * 1.08;
	float px = max(length(fwidth(q)), 1e-4);
	float kind = UV2.x;
	vec3 col = hue(UV2.y);
	float d = glyph(q, kind);
	float tube = 1.0 - smoothstep(0.025 - px * 0.5, 0.025 + px * 0.5, d);
	float halo = exp(-d * 9.0) * 0.35;
	float id = floor(UV2.x * 7.0 + UV2.y * 13.0);
	float t = TIME * 0.5 + h11(id) * 10.0;
	float on = 1.0 - step(0.93, fract(t)) * step(0.5, fract(t * 7.0));
	// il giro di lampadine sul bordo (passo 0.1 lungo il perimetro, si rincorrono)
	vec2 b = abs(UV - 0.5) * vec2(2.0, 1.0);
	float ex = 1.0 - 0.06;
	float ey = 0.5 - 0.06;
	float per;
	float off;
	if (ex - b.x < ey - b.y) {
		per = (UV.y) * 1.0;
		off = abs(b.x - ex);
	} else {
		per = (UV.x) * 2.0;
		off = abs(b.y - ey);
	}
	float k = per / 0.1;
	float bd = length(vec2((fract(k) - 0.5) * 0.1, off));
	float bulb = 1.0 - smoothstep(0.022 - px * 0.5, 0.022 + px * 0.5, bd);
	float chase = 0.4 + 0.6 * step(0.5, fract((floor(k) - TIME * 4.0) / 4.0));
	float dist = length(VERTEX);
	float near = mix(near_k, 1.0, smoothstep(near_d, far_d, dist));
	vec3 em = col * (tube + halo) * on * energy;
	em += vec3(1.0, 0.85, 0.5) * bulb * chase * energy * 0.9;
	ALBEDO = mix(vec3(0.02, 0.015, 0.04), col * 0.5, tube);
	ROUGHNESS = 0.2;
	METALLIC = 0.1;
	SPECULAR = 0.5;
	EMISSION = em * near;
}
␀␀shader_type spatial;
// Carnival Night Zone: i metalli dell'ambiente (layout.gd: l'oro di cornici, bracci e cappelli dei
// lampioni, le sponde scure; deco.gd: le cabine accese delle ruote panoramiche). Al posto dei
// StandardMaterial3D di prima, con gli stessi valori di base (colore, metallo, ruvidezza, luce propria)
// e in piÃ¹: le macchie larghe (un velo di ossido e di ditate che cambia appena colore e ruvidezza,
// in coordinate del mondo sull'asse dominante della normale), la spazzolatura fine (brushed: righe
// lungo l'asse piÃ¹ lungo del pezzo, solo da vicino) e il riflesso finto delle luci del parco
// (cnz_common.gdshaderinc): l'oro di notte brilla delle lampade rosa e ciano anche lontano dalle luci.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/cnz/cnz_common.gdshaderinc"

uniform vec3 base : source_color = vec3(1.0, 0.74, 0.3);
uniform float metal = 0.85;
uniform float rough = 0.25;
uniform vec3 glow : source_color = vec3(0.0);
uniform float glow_k = 1.0;
uniform float refl = 1.0;
uniform float wear = 0.35;
uniform float brushed = 0.0;
uniform float rim = 0.0;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wn);
	vec3 an = abs(n);
	vec2 q = an.y > max(an.x, an.z) ? wp.xz : (an.x > an.z ? wp.zy : wp.xy);
	float px = max(length(fwidth(wp)), 1e-4);
	float m = cnz_fbm(q * 0.7 + 3.1);
	float r = rough + (m - 0.45) * 0.3 * wear;
	// la spazzolatura: righe fini lungo la prima coordinata, sparisce da lontano
	float br = cnz_vn(vec2(q.x * 0.6, q.y * 60.0)) - 0.5;
	r += br * 0.12 * brushed * (1.0 - smoothstep(0.004, 0.02, px));
	r = clamp(r, 0.06, 1.0);
	vec3 alb = base * (1.0 - 0.22 * wear * smoothstep(0.35, 0.8, m));
	ALBEDO = alb;
	METALLIC = metal;
	ROUGHNESS = r;
	SPECULAR = 0.5;
	vec3 vw = normalize(CAMERA_POSITION_WORLD - wp);
	vec3 f0 = mix(vec3(0.04), alb, metal);
	float nv = clamp(dot(n, vw), 0.0, 1.0);
	EMISSION = glow * glow_k + cnz_refl(n, vw, r, f0, refl) + alb * pow(1.0 - nv, 3.0) * rim;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Carnival Night Zone: i tubi al neon (bordi delle piste, insegne, raggi della ruota panoramica, i
// congegni di scripts/level/cnz_parts.gd). Colore pieno che fa luce propria; "flicker" > 0: ogni tanto
// tremola (un neon vecchio), sfasato con la posizione cosÃ¬ due tubi non tremano insieme. "pulse":
// respira piano. "energy" la cambia il respingente quando lo si colpisce (cnz_bumper.gd).
// Il neon dell'ambiente (gen_cnz/layout.gd _mats) accende anche:
//   - near_k: da vicino scende fino a near_k dell'energia (sotto la soglia del bagliore: i tubi a un
//     passo dalla telecamera non si bruciano in bianco), da lontano resta pieno e fa l'alone (come il
//     neon di Eggmanland, gen_egl1/track.gd);
//   - tube: il profilo del tubo, l'anima appena piÃ¹ chiara dove lo si guarda di fronte (poca: con
//     ACES il bianco in piÃ¹ sbiancava il rosa e il ciano da lontano) e il bordo piÃ¹ scuro.
// Coi valori di partenza (near_k 1, tube 0) Ã¨ com'era: i congegni non cambiano.
render_mode blend_mix, depth_draw_opaque, cull_back, unshaded, shadows_disabled;

uniform vec3 color : source_color = vec3(0.2, 0.9, 1.0);
uniform float energy = 2.6;
uniform float flicker = 0.0;
uniform float pulse = 0.0;
uniform float near_k = 1.0;
uniform float near_d = 3.0;
uniform float far_d = 40.0;
uniform float tube = 0.0;

varying vec3 wp;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

float h11(float x) {
	return fract(sin(x * 127.1) * 43758.5453);
}

void fragment() {
	float seed = floor(wp.x * 0.05) + floor(wp.z * 0.05) * 7.0;
	float t = TIME * 9.0 + seed * 13.0;
	float fl = 1.0 - flicker * step(0.93, h11(floor(t))) * 0.8;
	float pu = 1.0 + pulse * 0.25 * sin(TIME * 2.2 + seed);
	float near = mix(near_k, 1.0, smoothstep(near_d, far_d, length(VERTEX)));
	float facing = abs(dot(normalize(NORMAL), VIEW));
	vec3 c = mix(color, vec3(1.0), pow(facing, 3.0) * 0.18 * tube);
	c *= mix(1.0, mix(0.6, 1.0, facing), tube);
	ALBEDO = c * energy * fl * pu * near;
}
␀␀␀␀␀␀␀␀␀␀shader_type sky;
// Carnival Night Zone: la notte del luna park di Eggman (scripts/env/gen_cnz/sky.gd). Zenit blu notte
// quasi nero, verso l'orizzonte viola e poi magenta (lo illuminano le luci del parco), le stelle, la
// luna piena con l'alone stretto, nuvole sottili accese da sotto; all'orizzonte, tutto attorno, tre file
// di sagome ferme, ognuna piÃ¹ velata dalla foschia quanto piÃ¹ Ã¨ lontana:
//   - le colline lontane, viola chiaro nella foschia;
//   - il luna park lontano: montagne russe con la salita e le lampadine sul binario, ruote panoramiche
//     coi raggi, cupole, torri della caduta, tendoni a punta, palazzi con le finestre;
//   - la fascia scura vicina coi lumini sparsi.
// Fermo: niente TIME (con il tempo Godot rifarebbe e rifiltrerebbe la radianza a ogni fotogramma). Nel
// passaggio della cubemap (radianza: i riflessi del cielo e la nebbia aerea) niente luna, stelle e
// sagome: solo un "ambiente di luce" semplice, il blu dello zenit, la fascia magenta dell'orizzonte e
// sotto il bagliore del parco, cosÃ¬ i riflessi e la foschia hanno il colore della notte del luna park.
// Le luci lontane sono dischi grandi un pixel o piÃ¹ (fwidth) che tengono la stessa energia: niente
// puntini che sfarfallano. Le celle stanno su un numero intero di giri: nessuna cucitura a Â±Ï€.

uniform vec3 zenith : source_color = vec3(0.008, 0.01, 0.045);
uniform vec3 mid : source_color = vec3(0.04, 0.03, 0.14);
uniform vec3 horizon : source_color = vec3(0.3, 0.07, 0.32);
uniform vec3 glow : source_color = vec3(0.85, 0.2, 0.5);
uniform vec3 moon_col : source_color = vec3(1.0, 0.96, 0.85);
uniform vec3 moon_dir = vec3(-0.35, 0.42, -0.84);
uniform sampler2D cloud_noise : filter_linear_mipmap, repeat_enable;
uniform float cloud_cover = 0.62;
uniform float cloud_scale = 0.18;
// le tre file di sagome (dalla piÃ¹ lontana) e il viola sotto l'orizzonte (come la nebbia)
uniform vec3 hills : source_color = vec3(0.2, 0.09, 0.3);
uniform vec3 skyline : source_color = vec3(0.075, 0.03, 0.12);
uniform vec3 near_band : source_color = vec3(0.025, 0.012, 0.05);
uniform vec3 below : source_color = vec3(0.04, 0.014, 0.075);
// l'ambiente di luce della cubemap (lineari)
uniform vec3 env_zenith = vec3(0.004, 0.006, 0.03);
uniform vec3 env_horizon = vec3(0.17, 0.045, 0.15);
uniform vec3 env_below_hi = vec3(0.08, 0.026, 0.1);
uniform vec3 env_below_lo = vec3(0.035, 0.012, 0.05);


float h21(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

// rumore liscio sul giro dell'orizzonte (a in giri 0..1, n celle per giro: si richiude su se stesso)
float ring_noise(float a, float n, float seed) {
	float x = a * n;
	float i = floor(x);
	float f = fract(x);
	float u = f * f * (3.0 - 2.0 * f);
	return mix(h21(vec2(mod(i, n), seed)), h21(vec2(mod(i + 1.0, n), seed)), u);
}

// una luce lontana: disco di raggio r (radianti) a distanza dist, pixel grande px; se il disco Ã¨ piÃ¹
// piccolo del pixel si allarga e si abbassa (stessa energia)
float lamp(float dist, float r, float px) {
	float rr = max(r, px * 0.8);
	float c = 1.0 - smoothstep(rr - px * 0.5, rr + px * 0.5, dist);
	return c * (r * r) / (rr * rr);
}

// una fila di lampadine lungo x (radianti), passo sp, alla quota yl: copertura
float bulb_row(float x, float y, float yl, float sp, float r, float px) {
	float cx = (floor(x / sp) + 0.5) * sp;
	return lamp(length(vec2(x - cx, y - yl)), r, px);
}

// le file di sagome: torna (colore, copertura) di un punto (az in giri, y = seno dell'elevazione)
vec4 park_skyline(float a, float y, float px) {
	// la fila di mezzo: 40 celle (9 gradi), una giostra per cella
	float n = 40.0;
	float k = a * n;
	float id = mod(floor(k), n);
	float f = fract(k);
	float cw = TAU / n;
	float lx = (f - 0.5) * cw;                // radianti dal centro della cella
	float r = h21(vec2(id, 5.1));
	float r2 = h21(vec2(id, 9.3));
	float base = 0.004 + 0.008 * h21(vec2(id, 7.7));
	float cover = 0.0;
	float lights = 0.0;
	vec3 lc = vec3(1.0, 0.75, 0.35);
	float edge = 0.0;
	if (r < 0.24) {
		// montagne russe: la salita lunga, la discesa ripida, il traliccio sotto e il binario acceso
		float x = f;
		float H = 0.04 + 0.03 * r2;
		float t = x < 0.6 ? clamp((x - 0.06) / 0.54, 0.0, 1.0) : 1.0 - pow(clamp((x - 0.6) / 0.34, 0.0, 1.0), 0.65);
		float top = base + H * t;
		float inside = step(y, top) * step(0.06, x) * step(x, 0.94);
		float lat = abs(fract((lx * 1.0 + y) / 0.006) - 0.5) < 0.12 || abs(fract((lx - y) / 0.006) - 0.5) < 0.12 ? 1.0 : 0.0;
		float rail = 1.0 - smoothstep(0.0, max(px, 0.0012), abs(y - top));
		cover = max(inside * mix(0.35, 1.0, lat), rail * step(0.06, x) * step(x, 0.94));
		lights = bulb_row(lx, y, top + 0.0015, 0.005, 0.0008, px) * step(0.07, x) * step(x, 0.93);
		lc = vec3(1.0, 0.8, 0.4);
		edge = rail;
	} else if (r < 0.38) {
		// ruota panoramica: il cerchio, i raggi, le lampadine sul cerchio, le gambe ad A
		float R = 0.03 + 0.016 * r2;
		vec2 q = vec2(lx, y - (base + R + 0.006));
		float d = length(q);
		float ring = 1.0 - smoothstep(0.0, max(px, 0.001), abs(d - R));
		float ang = atan(q.y, q.x);
		float sp = abs(sin(ang * 6.0)) * d;
		float spokes = (1.0 - smoothstep(0.0, max(px, 0.0006), sp)) * step(d, R);
		float hub = base + R + 0.006;
		float legs = (1.0 - smoothstep(0.0, max(px, 0.0008), abs(abs(lx) - (hub - y) * 0.45))) * step(base, y) * step(y, hub);
		cover = max(max(ring, spokes * 0.7), legs);
		float ba = (floor(ang / TAU * 24.0) + 0.5) / 24.0 * TAU;
		lights = lamp(length(q - vec2(cos(ba), sin(ba)) * R), 0.0011, px);
		lc = mix(vec3(1.0, 0.35, 0.75), vec3(0.4, 0.85, 1.0), step(0.5, r2));
		edge = ring;
	} else if (r < 0.52) {
		// cupola con la punta e la fila di lampadine alla base
		float R = 0.022 + 0.02 * r2;
		float x = lx / R;
		float top = base + R * 0.8 * sqrt(max(1.0 - x * x, 0.0));
		cover = step(y, top) * step(abs(x), 1.0);
		cover = max(cover, (1.0 - smoothstep(0.0, max(px, 0.0006), abs(lx))) * step(top, y) * step(y, base + R * 0.8 + 0.012));
		lights = bulb_row(lx, y, base + 0.004, 0.004, 0.0007, px) * step(abs(x), 0.95);
		lights += lamp(length(vec2(lx, y - (base + R * 0.8 + 0.012))), 0.0012, px);
		lc = vec3(1.0, 0.85, 0.45);
		edge = cover * (1.0 - smoothstep(0.0, 0.003, top - y));
	} else if (r < 0.62) {
		// la torre della caduta: lo stelo alto, l'anello di luci che sale e il faro in cima
		float H = 0.07 + 0.035 * r2;
		float stem = (1.0 - smoothstep(0.0015, 0.0015 + max(px, 0.0008), abs(lx))) * step(y, base + H);
		float ringy = base + H * (0.35 + 0.4 * r2);
		float collar = (1.0 - smoothstep(0.004, 0.004 + px, abs(lx))) * (1.0 - smoothstep(0.0, 0.002, abs(y - ringy)));
		cover = max(stem, collar);
		lights = bulb_row(lx, y, ringy, 0.0025, 0.0006, px) * step(abs(lx), 0.0045);
		lights += lamp(length(vec2(lx, y - base - H)), 0.0016, px) * 1.5;
		lc = vec3(1.0, 0.3, 0.3);
	} else if (r < 0.8) {
		// tendone a punta a strisce con la bandierina
		float H = 0.03 + 0.03 * r2;
		float w = 0.38 + 0.1 * r2;
		float top = base + H * (1.0 - abs(f - 0.5) / w);
		cover = step(y, top) * step(abs(f - 0.5), w);
		float stripe = step(0.5, fract(lx / 0.004));
		cover *= mix(0.8, 1.0, stripe);
		lights = bulb_row(lx, y, base + H * 0.25, 0.0035, 0.0007, px) * step(abs(f - 0.5), w * 0.75);
		lc = vec3(1.0, 0.6, 0.85);
		edge = cover * (1.0 - smoothstep(0.0, 0.0025, top - y));
	} else {
		// palazzi bassi con le finestre accese
		float top = base + 0.012 + 0.02 * r2 * step(0.3, f) * step(f, 0.8);
		cover = step(y, top);
		vec2 g = vec2(lx, y) / 0.0035;
		vec2 gc = (floor(g) + 0.5) * 0.0035;
		float w = h21(floor(g) + id * 3.1);
		lights = lamp(length(vec2(lx, y) - gc), 0.0007, px) * step(0.78, w) * step(y, top - 0.002);
		lc = mix(vec3(1.0, 0.7, 0.3), vec3(0.4, 0.85, 1.0), step(0.93, w));
	}
	vec3 col = skyline + glow * 0.05 * edge;
	col += lc * lights * 2.2;
	return vec4(col, clamp(max(cover, lights), 0.0, 1.0));
}

void sky() {
	vec3 d = normalize(EYEDIR);
	float y = d.y;
	float a = atan(d.x, d.z) / TAU + 0.5;
	if (AT_CUBEMAP_PASS) {
		// l'ambiente di luce: sopra il blu notte con la fascia magenta all'orizzonte, sotto il parco acceso
		vec3 e = mix(env_horizon, env_zenith, smoothstep(0.0, 0.55, y));
		e += env_horizon * 0.35 * exp(-abs(y) * 9.0);
		vec3 lo = mix(env_below_hi, env_below_lo, smoothstep(0.0, 0.6, -y));
		e = mix(e, lo, smoothstep(0.02, -0.08, y));
		COLOR = e;
	} else {
		float px = max(length(fwidth(d)), 1e-5);
		vec3 col = mix(horizon, mid, smoothstep(0.0, 0.25, y));
		col = mix(col, zenith, smoothstep(0.2, 0.75, y));
		// il bagliore del parco basso sull'orizzonte (piÃ¹ forte davanti, verso +X); sotto l'orizzonte si
		// spegne in fretta nel viola scuro della foschia
		float front = 0.6 + 0.4 * max(d.x, 0.0);
		col += glow * exp(-abs(y) * (y > 0.0 ? 14.0 : 40.0)) * 0.35 * front;
		col = mix(col, below, smoothstep(0.0, -0.06, y));
		vec3 md = normalize(moon_dir);
		float mc = dot(d, md);
		if (y > 0.0) {
			// nuvole sottili, ferme, accese da sotto dal parco (magenta vicino all'orizzonte) e dalla luna
			vec2 uv = d.xz / (y + 0.12) * cloud_scale;
			float n = texture(cloud_noise, uv * 0.6).r * 0.7 + texture(cloud_noise, uv * 2.1 + 0.37).r * 0.3;
			float dens = smoothstep(cloud_cover, cloud_cover + 0.25, n) * smoothstep(0.02, 0.12, y);
			// stelle (dietro le nuvole)
			vec2 sp = d.xz / (y + 0.25) * 160.0;
			vec2 cell = floor(sp);
			float st = h21(cell);
			vec2 off = vec2(h21(cell + 1.7), h21(cell + 4.3)) - 0.5;
			float dd = length(fract(sp) - 0.5 - off * 0.6);
			float bright = 0.6 + 0.8 * h21(cell + 9.1);
			col += vec3(0.85, 0.9, 1.0) * step(0.965, st) * (1.0 - smoothstep(0.0, 0.09, dd)) * bright * smoothstep(0.05, 0.3, y) * (1.0 - dens) * 1.3;
			// la luna: il disco, l'alone stretto e la corona morbida
			float disc = smoothstep(0.99935, 0.9995, mc);
			float spots = 0.85 + 0.15 * h21(floor((d.xy - md.xy) * 900.0));
			col = mix(col, moon_col * 1.4 * spots, disc);
			col += moon_col * pow(max(mc, 0.0), 220.0) * 0.2 + vec3(0.25, 0.3, 0.6) * pow(max(mc, 0.0), 12.0) * 0.12
				+ vec3(0.3, 0.32, 0.55) * pow(max(mc, 0.0), 60.0) * 0.1;
			vec3 cl = mix(vec3(0.06, 0.035, 0.14), vec3(0.42, 0.1, 0.36), exp(-y * 7.0));
			cl += moon_col * pow(max(mc, 0.0), 30.0) * 0.35;
			col = mix(col, cl, dens * 0.72 * (1.0 - disc));
		}
		// le colline lontane (nella foschia, quasi il colore dell'orizzonte)
		float hh = 0.008 + 0.028 * ring_noise(a, 24.0, 1.0) + 0.01 * ring_noise(a, 90.0, 2.0);
		float hill = 1.0 - smoothstep(hh - px, hh + px, y);
		col = mix(col, mix(hills, horizon, 0.35) + glow * 0.04, hill * step(-0.06, y));
		// il luna park lontano
		vec4 pk = park_skyline(a, y, px);
		col = mix(col, mix(pk.rgb, horizon * 0.6, 0.18), pk.a * step(-0.06, y));
		// la fascia vicina, scura, coi lumini
		float nn = 72.0;
		float kk = a * nn;
		float nid = mod(floor(kk), nn);
		float nh = 0.003 + 0.011 * h21(vec2(nid, 2.2)) * step(0.25, fract(kk)) + 0.004 * h21(vec2(floor(kk * 3.0), 4.4));
		float nb = 1.0 - smoothstep(nh - px, nh + px, y);
		vec2 wq = vec2(a * TAU, y) / 0.003;
		float wv = h21(floor(wq) + 17.0);
		vec2 wc = (floor(wq) + 0.5) * 0.003;
		float wl = lamp(length(vec2(a * TAU, y) - wc), 0.0006, px) * step(0.86, wv) * step(y, nh - 0.0015) * step(-0.02, y);
		vec3 nbc = near_band + mix(vec3(1.0, 0.65, 0.3), vec3(1.0, 0.3, 0.7), step(0.94, wv)) * wl * 2.0;
		col = mix(col, nbc, max(nb * step(-0.08, y), wl));
		// sotto l'orizzonte: il viola della nebbia (non nero)
		col = mix(col, below, smoothstep(-0.03, -0.25, y));
		COLOR = col;
	}
}
␀␀␀␀␀␀␀␀shader_type spatial;
// Carnival Night Zone: la cittÃ  lontana tutt'attorno al parco (deco.gd, _skyline_ring): un anello di
// pannelli verticali fra il parco e l'orizzonte del cielo, che dÃ  profonditÃ  (si sposta appena quando
// si corre, il cielo no). Lo shader disegna i profili dei palazzi (due file, quella dietro piÃ¹ alta e piÃ¹
// sfumata; ogni tanto una guglia, una cupola o un tendone), le finestre accese (dischi grandi almeno un
// pixel che tengono la stessa energia: niente sfarfallio), le luci rosse in cima ai piÃ¹ alti che
// lampeggiano piano e qualche fascia di neon sui tetti. Sotto, i palazzi affondano nella foschia del
// fondo (come abyss.gdshader). UV.x = i metri lungo l'anello, UV.y = i metri sopra base_y. Sopra il
// profilo Ã¨ trasparente (bordo filtrato sul pixel). La nebbia la fa lo shader (veil): quella del motore
// a questa distanza coprirebbe tutto.
render_mode blend_mix, depth_draw_never, cull_disabled, unshaded, fog_disabled, shadows_disabled;

uniform vec3 body : source_color = vec3(0.045, 0.022, 0.085);
uniform vec3 body_far : source_color = vec3(0.09, 0.045, 0.15);
uniform vec3 haze : source_color = vec3(0.065, 0.024, 0.105);
uniform float veil = 0.3;
uniform float lights = 1.0;

float h12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float lamp(float dist, float r, float px) {
	float rr = max(r, px * 0.8);
	float c = 1.0 - smoothstep(rr - px * 0.5, rr + px * 0.5, dist);
	return c * (r * r) / (rr * rr);
}

// il profilo di una fila: torna (altezza del tetto in quel punto, id della cella, altezza piena)
vec3 row(float x, float cw, float h0, float h1, float seed) {
	float ci = floor(x / cw);
	float hb = h12(vec2(ci, seed));
	float ht = mix(h0, h1, hb * hb);
	float fx = fract(x / cw);
	// i lati del palazzo: un filo di vuoto fra uno e l'altro
	float gap = step(0.08, fx) * step(fx, 0.92);
	float top = ht * gap;
	float kind = h12(vec2(ci, seed + 4.0));
	float cx = abs(fx - 0.5) * 2.0;
	if (kind > 0.86) {
		// guglia
		top = max(top, ht + 18.0 * max(1.0 - cx * 7.0, 0.0));
	} else if (kind > 0.74) {
		// cupola
		top = max(top, ht + 9.0 * sqrt(max(1.0 - cx * cx * 1.3, 0.0)) * gap);
	} else if (kind > 0.66) {
		// tendone a punta
		top = max(top, ht + 12.0 * max(1.0 - cx * 1.15, 0.0) * gap);
	}
	return vec3(top, ci, ht);
}

void fragment() {
	float x = UV.x;
	float y = UV.y;
	float px = max(max(fwidth(x), fwidth(y)), 1e-3);
	vec3 back = row(x + 37.0, 34.0, 70.0, 150.0, 2.0);
	vec3 front = row(x, 22.0, 45.0, 110.0, 9.0);
	float a_back = 1.0 - smoothstep(back.x - px * 0.5, back.x + px * 0.5, y);
	float a_front = 1.0 - smoothstep(front.x - px * 0.5, front.x + px * 0.5, y);
	float a = max(a_back, a_front);
	if (a < 0.003) {
		discard;
	}
	bool is_front = a_front > 0.5;
	vec3 cell = is_front ? front : back;
	vec3 col = is_front ? body : body_far;
	// le finestre: celle di 4 x 3.5 m, una su otto accesa (calde, qualcuna rosa o ciano)
	vec2 g = vec2(x / 4.0, y / 3.5);
	vec2 wid = floor(g);
	float wh = h12(wid + cell.y * 3.1 + (is_front ? 0.0 : 50.0));
	vec2 wc = (wid + 0.5) * vec2(4.0, 3.5);
	float on = step(0.88, wh) * step(y, cell.z - 3.0);
	vec3 wl = wh > 0.985 ? vec3(0.35, 0.85, 1.0) : (wh > 0.97 ? vec3(1.0, 0.35, 0.75) : vec3(1.0, 0.68, 0.38));
	vec3 em = wl * lamp(length(vec2(x, y) - wc), 0.7, px) * on * 1.6;
	// le luci rosse in cima ai palazzi piÃ¹ alti (lampeggiano piano)
	float tall = step(0.82, h12(vec2(cell.y, is_front ? 9.0 : 2.0)));
	float cw = is_front ? 22.0 : 34.0;
	vec2 tip = vec2((cell.y + 0.5) * cw - (is_front ? 0.0 : 37.0), cell.z + 1.0);
	float blink = 0.35 + 0.65 * step(0.5, fract(TIME * 0.4 + h12(vec2(cell.y, 7.7))));
	em += vec3(1.0, 0.12, 0.08) * lamp(length(vec2(x, y) - tip), 0.9, px) * tall * blink * 2.0;
	// la fascia di neon sul tetto, ogni tanto
	float nb = step(0.7, h12(vec2(cell.y, is_front ? 3.3 : 5.5)));
	float band = (1.0 - smoothstep(0.0, max(px, 0.6), abs(y - (cell.z - 2.5)))) * nb;
	vec3 nc = h12(vec2(cell.y, 8.8)) > 0.5 ? vec3(1.0, 0.3, 0.7) : vec3(0.3, 0.85, 1.0);
	em += nc * band * 0.9;
	em *= lights * (is_front ? 1.0 : 0.65);
	// in basso la foschia del fondo, in tutto un velo verso l'orizzonte
	float low = 1.0 - smoothstep(10.0, 75.0, y);
	col = mix(col, haze, clamp(low * 0.9 + veil, 0.0, 1.0));
	em *= 1.0 - low * 0.8;
	ALBEDO = col + em;
	ALPHA = a;
}
shader_type spatial;
// Carnival Night Zone: la luce che un'insegna accesa spande attorno (deco.gd, _boards): un quadrato
// davanti al pannello, appena staccato, piÃ¹ largo dell'insegna. Additivo: un alone morbido del colore
// della scritta (tint), piÃ¹ forte al centro e sul bordo di sotto (la luce che cade), che sparisce di
// taglio e vicino alla telecamera; dove tocca le cose si ammorbidisce (con la profonditÃ  della
// schermata: con l'MSAA non c'Ã¨ e si salta). UV: 0..1 sul quadrato; UV2.y > 0: la tinta viene da
// UV2.x (come il disegno dell'insegna, insegna.gdshader), se no da tint. Niente nebbia (sfuma da sÃ©).
render_mode blend_add, depth_draw_never, cull_disabled, unshaded, shadows_disabled, fog_disabled;

uniform sampler2D depth_tex : hint_depth_texture, filter_nearest, repeat_disable;
uniform vec3 tint : source_color = vec3(1.0, 0.4, 0.8);
uniform float energy = 0.35;

vec3 hue(float h) {
	vec3 k = clamp(abs(fract(h + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
	return mix(vec3(1.0), k, 0.85);
}

void fragment() {
	vec2 q = UV * 2.0 - 1.0;
	float e = exp(-dot(q * vec2(1.0, 1.25), q * vec2(1.0, 1.25)) * 2.2);
	float edge = (1.0 - smoothstep(0.55, 1.0, abs(q.x))) * (1.0 - smoothstep(0.55, 1.0, abs(q.y)));
	float a = e * edge;
	float facing = abs(dot(normalize(NORMAL), normalize(VIEW)));
	a *= smoothstep(0.05, 0.4, facing);
	float d = length(VERTEX);
	a *= smoothstep(3.0, 12.0, d) * exp(-d * 0.004);
	float dz = textureLod(depth_tex, SCREEN_UV, 0.0).r;
	if (dz > 0.0) {
		vec4 v = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, dz, 1.0);
		float scene_z = -v.z / v.w;
		a *= smoothstep(0.0, 1.5, scene_z + VERTEX.z);
	}
	vec3 c = UV2.y > 0.0 ? hue(UV2.x) : tint;
	ALBEDO = c * a * energy;
}
␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Carnival Night Zone: le pareti a strisce del circo (scripts/env/gen_cnz/layout.gd). Strisce verticali
// col_a / col_b larghe "period" metri, prese dalla posizione nel mondo (i pezzi del kit non hanno UV):
// sulle facce girate verso Â±Z corrono lungo X, su quelle verso Â±X lungo Z. Con use_uv = 1 le strisce
// seguono UV.x (i solidi di rotazione: tendoni, colonne, barili: UV.x = il giro), "spiral" le storce.
// Laccato lucido (riflette i neon), un filo di riga scura fra una striscia e l'altra, sopra (facce in
// alto) un bordo dorato; in fondo un velo piÃ¹ scuro (le basi delle torri sprofondano nel buio).
// Il dettaglio di oggi, tutto spento di base (gli aggeggi di cnz_parts.gd usano questo shader e
// restano com'erano; lo accende l'ambiente, layout.gd):
//   - panels: lamiere verniciate. Giunti orizzontali ogni panel_h metri e verticali ogni striscia
//     doppia, incassati, con lo smusso in rilievo (dalle derivate) e l'ombra nel giunto; i rivetti
//     lungo i giunti; ogni lamiera un filo diversa di tinta e di lucido; la vernice scrostata sugli
//     spigoli dei giunti; lo sporco che cola sotto ogni giunto (grime);
//   - fabric: la tela dei tendoni (con use_uv): ogni striscia un telo che si gonfia fra due cuciture
//     (la normale piegata e l'ombra vicino alle cuciture), la trama fine, opaca col filo di lucido;
//   - refl: il riflesso finto delle luci del parco sulla lacca (cnz_common.gdshaderinc);
//   - windows: le finestre accese dei palazzi dello sfondo, solo sulle facce con UV2.x > 0.5 (le torri
//     di deco.gd; UV2.x - 1 = il neon della torre, che tinge qualche finestra): una per striscia chiara
//     e per piano (panel_h), col telaio, un terzo accese di luce calda, rosa o ciano, le altre vetro
//     scuro che riflette. Da lontano la loro media (niente sfarfallio). UV2.x da 10 in su: la torre Ã¨
//     di un'altra tinta (10 + : alt1, il viola; 20 + : alt2, il verde menta) invece di col_a, nello
//     stesso materiale (niente chiamate di disegno in piÃ¹); il resto (UV2.x - 10 o - 20) come sopra;
//   - water_y: il pelo dell'acqua (le pareti della vasca dell'Atto 2: lo aggiorna cnz_water.gd). Il
//     bagnato piÃ¹ scuro e lucido fino a poco sopra il pelo, la riga di schiuma sul pelo, sopra i
//     riflessi tremolanti delle onde (fino a 3 m), sotto la luce blu dell'acqua. -1000: niente acqua.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/cnz/cnz_common.gdshaderinc"

uniform vec3 col_a : source_color = vec3(0.86, 0.06, 0.1);
uniform vec3 col_b : source_color = vec3(0.97, 0.95, 0.9);
uniform float period = 1.4;
uniform float use_uv = 0.0;
uniform float uv_count = 16.0;      // strisce attorno (use_uv)
uniform float spiral = 0.0;         // strisce storte con la quota (use_uv)
uniform vec3 top_col : source_color = vec3(0.95, 0.72, 0.2);
uniform float gloss = 0.22;
uniform float dark_below = -20.0;   // sotto questa quota si scurisce
uniform float emission_k = 0.0;     // un filo di luce propria (le insegne)
uniform float panels = 0.0;         // lamiere coi giunti e i rivetti (0: spento)
uniform float panel_h = 3.0;        // m, l'altezza di una lamiera
uniform float grime = 0.0;          // lo sporco che cola sotto i giunti
uniform float fabric = 0.0;         // la tela dei tendoni (0: spento)
uniform float fabric_depth = 0.12;  // m, quanto si gonfia un telo
uniform float refl = 0.0;           // il riflesso finto delle luci (0: spento)
uniform float water_y = -1000.0;    // il pelo dell'acqua (-1000: niente)
uniform float windows = 0.0;        // le finestre accese (0: spento; solo dove UV2.x > 0.5)
// le tinte delle torri viola (UV2.x da 10, con windows) e verde menta (da 20): le mette layout.gd
uniform vec3 alt1 : source_color = vec3(0.1, 0.005, 0.21);
uniform vec3 alt2 : source_color = vec3(0.007, 0.18, 0.15);
// la ruvidezza minima per le luci vere (0: com'Ã¨): la luna Ã¨ una luce direzionale e in Godot 4.3 il suo
// riflesso non si abbassa dalla luce; sulla lacca liscia, presa di taglio verso la luna, bruciava di
// bianco mezza facciata. Il riflesso finto (cnz_refl) resta quello liscio, con le file di luci nitide.
uniform float light_rough = 0.0;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

// il velo scuro in basso (come "low" piÃ¹ sotto)
float low_w(float y, float db) {
	return smoothstep(db, db - 30.0, y);
}

// integrale di step(0.5, fract(x))
float sq_int(float x) {
	return floor(x) * 0.5 + max(fract(x) - 0.5, 0.0);
}

void fragment() {
	vec3 n = normalize(wn);
	float s;
	float along = abs(n.z) > abs(n.x) ? wp.x : wp.z;
	if (use_uv > 0.5) {
		s = UV.x * uv_count + UV.y * spiral;
	} else {
		s = along / period;
	}
	float f = fract(s);
	// la striscia filtrata sul pixel (integrale dell'onda quadra): da lontano niente sfarfallio
	float w = max(fwidth(s), 1e-4);
	float band = (sq_int(s + w * 0.5) - sq_int(s - w * 0.5)) / w;
	float edge = min(abs(f - 0.5), min(f, 1.0 - f));
	float line = (1.0 - smoothstep(0.0, 0.025, edge)) * (1.0 - clamp(w * 10.0, 0.0, 1.0));
	// la tinta della torre (solo i palazzi dello sfondo: windows acceso, UV2.x da 10 in su)
	float pal = windows > 0.0 ? floor(UV2.x / 10.0 + 0.001) : 0.0;
	float u2 = UV2.x - pal * 10.0;
	vec3 ca = pal > 1.5 ? alt2 : (pal > 0.5 ? alt1 : col_a);
	vec3 c = mix(ca, col_b, band);
	c *= 1.0 - 0.35 * line;
	float top = smoothstep(0.75, 0.85, n.y) * (1.0 - use_uv);
	float rough = gloss;
	vec3 nb = n;
	float ao = 1.0;
	float detail = panels + fabric;
	if (detail > 0.0) {
		float px = max(length(fwidth(wp)), 1e-4);
		if (panels > 0.0) {
			// le lamiere: giunti orizzontali ogni panel_h, verticali ogni striscia doppia
			float side = 1.0 - smoothstep(0.55, 0.75, abs(n.y));
			float vy = wp.y / panel_h;
			float fy = fract(vy);
			float ey = min(fy, 1.0 - fy) * panel_h;
			float sx = use_uv > 0.5 ? s : along / period;
			float fx = fract(sx);
			float ex = min(fx, 1.0 - fx) * (use_uv > 0.5 ? 1.0 : period);
			float ej = min(ex, ey);
			float near = (1.0 - smoothstep(0.03, 0.12, px)) * side * panels;
			vec2 pid = vec2(floor(sx), floor(vy));
			float hv = cnz_h12(pid + 41.0);
			c *= 1.0 + (hv - 0.5) * 0.12 * panels * side;
			rough += (cnz_h12(pid + 9.0) - 0.5) * 0.12 * panels * side;
			// il giunto incassato e lo smusso, i rivetti sotto e sopra ogni giunto orizzontale
			float h = smoothstep(0.012, 0.05, ej) * 0.008;
			float rv_x = (fract(along / 0.45) - 0.5) * 0.45;
			float rv_y = abs(ey - 0.09);
			float rv = 1.0 - smoothstep(0.012, 0.026, length(vec2(rv_x, rv_y)));
			h += rv * 0.008;
			if (near > 0.001) {
				nb = normalize(mix(n, cnz_bump(n, wp, h, 1.0), near));
			}
			float jl = 1.0 - smoothstep(0.004, 0.016 + px * 0.5, ej);
			c *= 1.0 - 0.45 * jl * side * panels;
			ao = mix(ao, 0.5 + 0.5 * smoothstep(0.0, 0.08, ej), near);
			// la vernice scrostata vicino ai giunti: sotto c'Ã¨ il fondo scuro
			float chip = smoothstep(0.78, 0.86, cnz_vn(wp.xy * 9.0 + wp.zx * 7.0)) * (1.0 - smoothstep(0.02, 0.09, ej));
			c = mix(c, vec3(0.06, 0.045, 0.07), chip * near * 0.85);
			rough = mix(rough, 0.6, chip * near);
			// lo sporco che cola sotto i giunti orizzontali (a righe verticali), piÃ¹ fitto in basso
			float below_seam = (1.0 - fy) * panel_h;
			float streak = cnz_vn(vec2(along * 2.3, wp.y * 0.25));
			float dirt = exp(-below_seam * 0.9) * smoothstep(0.35, 0.75, streak);
			dirt += smoothstep(dark_below + 26.0, dark_below + 6.0, wp.y) * 0.5 * cnz_vn(vec2(along * 0.9, wp.y * 0.4));
			c *= 1.0 - 0.4 * clamp(dirt, 0.0, 1.0) * grime * side;
			rough += clamp(dirt, 0.0, 1.0) * 0.2 * grime * side;
		}
		if (fabric > 0.0) {
			// il telo fra due cuciture (le righe del giro): si gonfia nel mezzo
			float u = fract(s * 2.0);
			float hf = sin(u * 3.14159) * fabric_depth;
			float nearf = (1.0 - smoothstep(0.08, 0.4, px)) * fabric;
			if (nearf > 0.001) {
				nb = normalize(mix(nb, cnz_bump(n, wp, hf, 1.0), nearf));
			}
			ao = mix(ao, 0.62 + 0.38 * sin(u * 3.14159), fabric);
			// la trama fine e qualche macchia d'umido
			float weave = cnz_vn(UV * vec2(900.0, 300.0)) - 0.5;
			c *= 1.0 + weave * 0.08 * (1.0 - smoothstep(0.01, 0.04, px)) * fabric;
			c *= 1.0 - 0.12 * smoothstep(0.5, 0.8, cnz_fbm(UV * vec2(12.0, 4.0) + 2.0)) * fabric;
			rough = mix(rough, 0.62, fabric);
		}
	}
	vec3 wem = vec3(0.0);
	if (windows > 0.0 && u2 > 0.5 && use_uv < 0.5) {
		float side = 1.0 - smoothstep(0.3, 0.5, abs(n.y));
		float pxw = max(length(fwidth(wp)), 1e-4);
		// una finestra al centro di ogni striscia chiara (fract(s) fra 0.5 e 1), una per piano
		float sx = s - 0.75;
		float cx = (fract(sx + 0.5) - 0.5) * period;
		float vy = wp.y / panel_h;
		float cy = (fract(vy) - 0.5) * panel_h;
		float fpl = (abs(n.z) > abs(n.x) ? wp.z : wp.x) * 0.7 + 0.37;
		vec2 wid = vec2(floor(sx + 0.5), floor(vy)) + vec2(floor(fpl) * 7.3, floor(fpl) * 1.9);
		vec2 hs = vec2(period * 0.17, panel_h * 0.2);
		float dd = max(abs(cx) - hs.x, abs(cy) - hs.y);
		float inside = 1.0 - smoothstep(-pxw * 0.5, pxw * 0.5, dd);
		float frame = (1.0 - smoothstep(-pxw * 0.5, pxw * 0.5, dd - 0.08)) - inside;
		float h1 = cnz_h12(wid + 5.1);
		float h2 = cnz_h12(wid + 13.7);
		float lit = step(0.64, h1);
		vec3 tint = u2 < 1.5 ? vec3(0.4, 0.85, 1.0) : (u2 < 2.5 ? vec3(1.0, 0.42, 0.72) : vec3(1.0, 0.8, 0.35));
		vec3 lc = h2 < 0.62 ? vec3(1.0, 0.7, 0.42) : (h2 < 0.82 ? tint : vec3(1.0, 0.5, 0.75));
		lc *= 0.9 + 0.9 * cnz_h12(wid + 2.3);
		// da lontano (il pixel piÃ¹ grande della finestra): la media della facciata
		float far = smoothstep(0.35, 1.0, pxw / hs.x) * windows;
		float area = 4.0 * hs.x * hs.y / (period * panel_h);
		float k = side * windows * (1.0 - low_w(wp.y, dark_below));
		vec3 glass = vec3(0.015, 0.014, 0.03);
		vec3 cn = mix(c, glass, inside);
		cn = mix(cn, vec3(0.22, 0.15, 0.07), frame);
		vec3 cf = mix(c, glass, area * 1.4);
		c = mix(c, mix(cn, cf, far), side * windows);
		rough = mix(rough, 0.06, inside * (1.0 - far) * side * windows);
		wem += mix(lc * inside * lit, vec3(1.0, 0.68, 0.48) * 1.25 * area * 0.36, far) * k;
	}
	float wetb = 0.0;
	if (water_y > -900.0) {
		float d = water_y - wp.y;
		wetb = 1.0 - smoothstep(0.3, 0.9, -d);
		c *= 1.0 - 0.35 * wetb;
		rough = mix(rough, 0.06, wetb);
		float foam = (1.0 - smoothstep(0.0, 0.07, abs(d + 0.02))) * (0.6 + 0.4 * cnz_vn(vec2(along * 3.0 + TIME * 0.4, 0.0)));
		c = mix(c, vec3(0.7, 0.72, 0.85), foam * 0.6);
		vec2 cp = vec2(along, wp.y * 0.35);
		if (d < 0.0) {
			float rise = -d;
			// i riflessi delle onde sopra il pelo: larghi e tenui (luce morbida, niente righe sottili che
			// sfarfallano a 640x360)
			float cs = cnz_caustic(cp * 0.15 + vec2(TIME * 0.05, 0.0), TIME * 0.8) * 0.55;
			cs *= (1.0 - smoothstep(0.0, 3.0, rise)) * smoothstep(-0.05, 0.25, rise);
			wem += vec3(0.35, 0.55, 1.0) * cs * 0.25;
		} else {
			float cs = cnz_caustic(cp * 0.22 + vec2(0.0, d * 0.03), TIME * 0.55) * exp(-d * 0.15);
			wem += vec3(0.1, 0.2, 0.55) * (0.08 + cs * 0.35) * smoothstep(0.0, 0.6, d);
		}
	}
	c = mix(c, top_col, top);
	float low = smoothstep(dark_below, dark_below - 30.0, wp.y);
	c *= 1.0 - 0.8 * low;
	ALBEDO = c;
	ROUGHNESS = max(mix(rough, 0.35, top), light_rough);
	METALLIC = top * 0.6;
	SPECULAR = 0.6;
	EMISSION = c * emission_k + wem;
	if (detail > 0.0) {
		NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
		AO = ao;
		AO_LIGHT_AFFECT = 0.3;
	}
	if (refl > 0.0) {
		vec3 vw = normalize(CAMERA_POSITION_WORLD - wp);
		vec3 f0 = mix(vec3(0.04), top_col, top * 0.6);
		// sul bagnato (la lacca a 0.06) il riflesso finto liscio, a file rosa nitide, copriva il colore
		// della parete: lÃ¬ piÃ¹ ruvido e piÃ¹ debole, il bagnato scurisce senza tingersi
		float rr = max(mix(rough, 0.35, top), 0.25 * wetb);
		EMISSION += cnz_refl(nb, vw, rr, f0, refl) * (1.0 - low) * (1.0 - 0.7 * wetb);
	}
}
␀␀␀shader_type spatial;
// Roccia di Emerald Coast Atto 2 (faraglioni, archi, la volta della grotta): la texture di roccia del
// modello di Sonic Adventure in proiezione triplanare, con l'erba del modello sulle facce in piano
// (le cime dei faraglioni) e un po' di colore piÃ¹ scuro in basso, dove batte il mare.

render_mode diffuse_burley, specular_schlick_ggx;

uniform sampler2D rock_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D grass_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D noise_tex : filter_linear_mipmap, repeat_enable;
uniform float rock_scale = 0.13;
uniform float grass_scale = 0.4;
uniform float grass_from = 0.78;   // normale.y oltre cui c'Ã¨ l'erba (0 = mai)
uniform float wet_to = 1.4;        // quota fin dove la roccia Ã¨ bagnata

varying vec3 wpos;
varying vec3 wnrm;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

vec3 tri(sampler2D t, vec3 p, vec3 n, float s) {
	vec3 w = pow(abs(n), vec3(4.0));
	w /= (w.x + w.y + w.z);
	return texture(t, p.zy * s).rgb * w.x + texture(t, p.xz * s).rgb * w.y + texture(t, p.xy * s).rgb * w.z;
}

void fragment() {
	vec3 n = normalize(wnrm);
	vec3 rock = tri(rock_tex, wpos, n, rock_scale);
	float nz = texture(noise_tex, wpos.xz * 0.05 + wpos.y * 0.02).r;
	rock *= 0.88 + 0.24 * nz;
	rock = mix(rock * vec3(0.55, 0.52, 0.5), rock, smoothstep(0.0, wet_to, wpos.y));
	vec3 grass = texture(grass_tex, wpos.xz * grass_scale).rgb;
	float gw = grass_from > 0.0 ? smoothstep(grass_from, grass_from + 0.08, n.y + (nz - 0.5) * 0.1) : 0.0;
	ALBEDO = mix(rock, grass, gw);
	ROUGHNESS = 0.92;
	SPECULAR = 0.25;
}
␀␀␀␀shader_type spatial;
// Il mare aperto di Emerald Coast Atto 2 al tramonto. Vicino: la texture dell'acqua alta di Emerald
// Coast di Sonic Adventure (dal modello dell'utente, senza la sua sfumatura dall'alto al basso che
// ripetuta faceva strisce: sky.gd flat_water) che scorre, scurita verso il blu della sera;
// lontano la texture sfuma in un colore pieno (niente righe di moirÃ© all'orizzonte) e l'acqua
// riflette il cielo arancione (riflesso del cielo dell'ambiente, piÃ¹ forte di taglio). La scia
// d'oro verso il sole: il riflesso speculare del sole basso sulle onde (mappa di normali che
// scorre), piÃ¹ qualche scintilla in piÃ¹ a mano dove l'onda riflette il sole. La luce del sole sull'acqua
// Ã¨ calcolata qui (light): senza ombre, che sul mare col sole basso facevano grandi bande scure.
// Anche il riflesso del cielo Ã¨ fatto qui (stesso gradiente di ec_sky.gdshader, colori dal preset
// del tramonto): col riflesso dell'ambiente le onde di taglio rimandavano raggi sotto l'orizzonte,
// dove il cielo passa di colpo al colore scuro del mare lontano, e venivano bande scure dritte.

render_mode diffuse_burley, specular_schlick_ggx;

uniform sampler2D tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D normal_tex : hint_normal, filter_linear_mipmap, repeat_enable;
uniform vec3 deep : source_color = vec3(0.09, 0.17, 0.27);     // il blu della sera
uniform vec3 far_col : source_color = vec3(0.42, 0.28, 0.26);  // l'acqua lontana (prende il cielo)
uniform vec3 glint_col : source_color = vec3(1.0, 0.72, 0.36);
uniform float tile = 12.8;
uniform float detail_end = 160.0;   // fin dove si vede la texture
uniform float far_start = 120.0;
uniform float far_end = 1500.0;
uniform float wave = 0.85;          // forza delle onde (normali)
uniform float sparkle = 1.4;
uniform vec3 sun_dir = vec3(-0.74, 0.15, -0.655);
// il cielo che si riflette (gli stessi colori del preset di ec_sky)
uniform vec3 sky_zenith : source_color = vec3(0.2, 0.15, 0.4);
uniform vec3 sky_mid : source_color = vec3(0.98, 0.46, 0.2);
uniform vec3 sky_horizon : source_color = vec3(1.0, 0.56, 0.16);
uniform vec3 sky_glow : source_color = vec3(1.0, 0.5, 0.14);
uniform float glow_wide = 0.55;
uniform float glow_tight = 0.7;
uniform float reflect_amt = 1.0;

varying vec3 wpos;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	float d = length(wpos - CAMERA_POSITION_WORLD);
	vec2 uv = wpos.xz / tile + vec2(TIME * 0.006, TIME * 0.003);
	vec3 t = texture(tex, uv).rgb;
	float det = 1.0 - smoothstep(detail_end * 0.4, detail_end, d);
	vec3 col = mix(deep, t * vec3(0.55, 0.62, 0.78), det * 0.8);
	col = mix(col, far_col, smoothstep(far_start, far_end, d));
	vec2 nuv = wpos.xz * 0.09;
	vec3 n1 = texture(normal_tex, nuv + vec2(TIME * 0.021, TIME * 0.013)).rgb;
	vec3 n2 = texture(normal_tex, nuv * 1.9 + vec2(-TIME * 0.017, TIME * 0.026)).rgb;
	vec3 n3 = texture(normal_tex, wpos.xz * 0.012 + vec2(TIME * 0.004, -TIME * 0.003)).rgb;
	vec3 nm = normalize(n1 + n2 + n3 * 0.8 - 1.4);
	// di taglio e lontano le onde si appiattiscono un po' (meno sfarfallio), ma la scia resta
	float wk = wave * mix(1.0, 0.55, smoothstep(60.0, 900.0, d));
	NORMAL_MAP = mix(vec3(0.5, 0.5, 1.0), nm * 0.5 + 0.5, wk);
	// scintille: dove la normale dell'onda (spazio del mondo, approssimata) riflette il sole
	vec3 wn = normalize(vec3(nm.x * 0.6, 1.0, nm.y * 0.6));
	vec3 vdir = normalize(wpos - CAMERA_POSITION_WORLD);
	vec3 r = reflect(vdir, wn);
	vec3 sd = normalize(sun_dir);
	float s = pow(max(dot(r, sd), 0.0), 900.0);
	EMISSION = glint_col * s * sparkle * (0.4 + 0.6 * smoothstep(20.0, 300.0, d));
	// riflesso del cielo: le onde inclinano poco il raggio (meno di taglio), e mai sotto l'orizzonte
	float graze = abs(vdir.y);
	vec3 wr = normalize(vec3(nm.x * 0.35 * wk, 1.0, nm.y * 0.35 * wk));
	vec3 rr = reflect(vdir, normalize(mix(vec3(0.0, 1.0, 0.0), wr, smoothstep(0.02, 0.3, graze))));
	float ry = max(rr.y, 0.0);
	float t1 = pow(ry, 0.45);
	vec3 sky = mix(sky_horizon, sky_mid, smoothstep(0.0, 0.35, t1));
	sky = mix(sky, sky_zenith, smoothstep(0.3, 1.0, t1));
	float sdr = max(dot(normalize(vec3(rr.x, ry, rr.z)), sd), 0.0);
	sky += sky_glow * (pow(sdr, 8.0) * glow_wide + pow(sdr, 64.0) * glow_tight);
	float fres = 0.02 + 0.98 * pow(1.0 - clamp(dot(-vdir, wn), 0.0, 1.0), 5.0);
	EMISSION += sky * fres * reflect_amt;
	ALBEDO = col * (1.0 - fres * 0.8);
	ROUGHNESS = 0.07;
	// niente riflesso dell'ambiente (lo fa il codice qui sopra)
	SPECULAR = 0.0;
	METALLIC = 0.0;
}


void light() {
	// niente ATTENUATION (ombre): il mare non riceve le ombre lunghe dei faraglioni
	float ndl = max(dot(NORMAL, LIGHT), 0.0);
	DIFFUSE_LIGHT += ALBEDO * LIGHT_COLOR * ndl / PI;
	vec3 hv = normalize(LIGHT + VIEW);
	float ndh = max(dot(NORMAL, hv), 0.0);
	float fres = 0.04 + 0.96 * pow(1.0 - max(dot(NORMAL, VIEW), 0.0), 5.0);
	SPECULAR_LIGHT += LIGHT_COLOR * (pow(ndh, 600.0) * 3.0 + pow(ndh, 60.0) * 0.25) * (0.3 + fres) / PI;
}
␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Acqua bassa attorno alle rive di Emerald Coast Atto 2: la texture dell'acqua bassa del modello di
// Sonic Adventure (caustiche turchesi) che scorre, la schiuma della riva che va e viene, i riflessi
// del sole. ProfonditÃ  nel colore per vertice (r: 0 riva, 1 dove finisce): sfuma nel mare aperto.

render_mode blend_mix, depth_draw_never, cull_back, diffuse_burley, specular_schlick_ggx;

uniform sampler2D shallow_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D foam_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D normal_tex : hint_normal, filter_linear_mipmap, repeat_enable;
uniform vec3 tint : source_color = vec3(0.74, 0.80, 0.80);   // turchese smorzato: Ã¨ sera
uniform float glint = 0.75;

varying vec3 wpos;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	float depth = COLOR.r;
	vec2 uv = wpos.xz * 0.09 + vec2(TIME * 0.012, TIME * 0.008);
	vec3 sh = texture(shallow_tex, uv).rgb;
	vec3 sh2 = texture(shallow_tex, wpos.xz * 0.05 - vec2(TIME * 0.007, -TIME * 0.011)).rgb;
	vec3 col = mix(sh, sh2, 0.4) * tint;
	// schiuma della riva che va e viene
	float wave = 0.5 + 0.5 * sin(TIME * 1.1 + wpos.x * 0.05 + wpos.z * 0.04);
	vec3 foam = texture(foam_tex, wpos.xz * 0.12 + vec2(0.0, sin(TIME * 0.9) * 0.02)).rgb;
	float fw = (1.0 - smoothstep(0.0, 0.1 + 0.08 * wave, depth)) * 0.9;
	col = mix(col, foam * vec3(1.0, 0.93, 0.86), fw);
	vec2 nuv = wpos.xz * 0.11;
	vec3 n1 = texture(normal_tex, nuv + vec2(TIME * 0.021, TIME * 0.013)).rgb;
	vec3 n2 = texture(normal_tex, nuv * 1.7 + vec2(-TIME * 0.017, TIME * 0.024)).rgb;
	NORMAL_MAP = mix(vec3(0.5, 0.5, 1.0), normalize(n1 + n2 - 1.0) * 0.5 + 0.5, glint);
	ALBEDO = col;
	ROUGHNESS = 0.12;
	SPECULAR = 0.6;
	ALPHA = clamp(1.0 - smoothstep(0.3, 1.0, depth), 0.0, 0.86);
}


void light() {
	// come il mare (sea.gdshader): niente ombre sull'acqua
	float ndl = max(dot(NORMAL, LIGHT), 0.0);
	DIFFUSE_LIGHT += ALBEDO * LIGHT_COLOR * ndl / PI;
	vec3 hv = normalize(LIGHT + VIEW);
	float ndh = max(dot(NORMAL, hv), 0.0);
	SPECULAR_LIGHT += LIGHT_COLOR * pow(ndh, 400.0) * 1.5 / PI;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Terreno di Emerald Coast Atto 2 con le texture di Emerald Coast di Sonic Adventure (dal modello
// dato dall'utente): sabbia sulle rive e sui sentieri, erba sopra, roccia sui pendii ripidi
// (proiezione triplanare: le scogliere non si stirano), sabbia bagnata a pelo d'acqua.
// Colore per vertice (terrain.gd): r = sentiero, g = rumore dell'erba, b = sabbia della riva.

render_mode diffuse_burley, specular_schlick_ggx;

uniform sampler2D sand_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D grass_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D grass2_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D rock_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D noise_tex : filter_linear_mipmap, repeat_enable;
uniform float sand_scale = 0.33;
uniform float grass_scale = 0.4;
uniform float rock_scale = 0.15;
uniform float rock_from = 0.80;   // normale.y sotto cui comincia la roccia
uniform float rock_full = 0.62;
// l'erba della sera: un po' piÃ¹ calda e meno satura (la texture di Sonic Adventure Ã¨ verde pieno
// di mezzogiorno, sotto la luce arancione veniva verde acido)
uniform vec3 grass_tint : source_color = vec3(0.93, 0.9, 0.7);
uniform float grass_desat = 0.18;

varying vec3 wpos;
varying vec3 wnrm;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

vec3 tri(sampler2D t, vec3 p, vec3 n, float s) {
	vec3 w = pow(abs(n), vec3(4.0));
	w /= (w.x + w.y + w.z);
	return texture(t, p.zy * s).rgb * w.x + texture(t, p.xz * s).rgb * w.y + texture(t, p.xy * s).rgb * w.z;
}

void fragment() {
	float nz = texture(noise_tex, wpos.xz * 0.013).r;
	float nz2 = texture(noise_tex, wpos.xz * 0.061 + vec2(0.3, 0.7)).r;
	vec3 sand = texture(sand_tex, wpos.xz * sand_scale).rgb * 0.9;
	float wet = 1.0 - smoothstep(0.05, 0.75, wpos.y);
	sand = mix(sand, sand * vec3(0.66, 0.62, 0.58), wet * 0.85);
	vec3 g1 = texture(grass_tex, wpos.xz * grass_scale).rgb;
	// la stessa erba girata e piÃ¹ scura, a chiazze: rompe la ripetizione
	vec2 ruv = mat2(vec2(0.8, 0.6), vec2(-0.6, 0.8)) * wpos.xz;
	vec3 g2 = texture(grass2_tex, ruv * grass_scale * 0.63 + vec2(0.5)).rgb * vec3(0.78, 0.86, 0.66);
	vec3 grass = mix(g1, g2, smoothstep(0.35, 0.65, nz)) * (0.86 + 0.28 * nz2);
	grass = mix(grass, vec3(dot(grass, vec3(0.3, 0.59, 0.11))), grass_desat) * grass_tint;
	vec3 rock = mix(tri(rock_tex, wpos, normalize(wnrm), rock_scale), tri(rock_tex, wpos + vec3(7.3, 0.0, 3.1), normalize(wnrm), rock_scale * 0.37), 0.4);
	// strati orizzontali delle scogliere (come le pareti di Emerald Coast)
	rock *= 0.84 + 0.16 * sin(wpos.y * 1.25 + nz * 5.0) + 0.1 * (nz2 - 0.5);
	float n_y = normalize(wnrm).y;
	float rockw = 1.0 - smoothstep(rock_full, rock_from, n_y + (nz2 - 0.5) * 0.12);
	float sandw = max(COLOR.b, COLOR.r * smoothstep(0.25, 0.6, COLOR.r + (nz - 0.5) * 0.5));
	sandw = clamp(sandw + (nz2 - 0.5) * 0.25 * (1.0 - COLOR.b), 0.0, 1.0);
	vec3 col = mix(grass, sand, smoothstep(0.35, 0.65, sandw));
	col = mix(col, rock, rockw);
	ALBEDO = col;
	ROUGHNESS = mix(0.95, 0.75, wet);
	SPECULAR = 0.25;
}
␀␀␀␀␀␀␀shader_type spatial;
// Il pianeta visto dallo spazio nel colpo finale "Spalla a spalla" (boss_design.md D.2, inquadrature
// F5-F9): sfera di r 2000 m (scripts/env/gen_eglboss/space_set.gd), lato notte scuro, bande di nubi
// cremisi, la macchia calda e accesa di Eggmanland, il bordo sottile dell'atmosfera (piÃ¹ chiaro dalla
// parte del sole, che sorge dietro il bordo). Non illuminato dalle luci della scena (il sole Ã¨
// sun_dir): colori lineari, valori sopra 1 per il bagliore. L'alone fuori dal bordo Ã¨ un guscio a
// parte (space_set.gd, ATMO_SHADER).
render_mode unshaded, cull_back, fog_disabled, shadows_disabled;

uniform vec3 sun_dir = vec3(0.0, -0.45, -0.89);       // mondo: verso il sole
uniform vec3 patch_dir = vec3(0.0, 0.974, -0.225);    // oggetto: dove sta Eggmanland sulla sfera
uniform sampler2D clouds : filter_linear_mipmap, repeat_enable;
uniform vec3 night : source_color = vec3(0.010, 0.005, 0.011);
uniform vec3 day : source_color = vec3(0.26, 0.05, 0.045);
uniform vec3 band_col : source_color = vec3(0.42, 0.035, 0.05);
uniform vec3 terminator : source_color = vec3(1.0, 0.32, 0.1);
uniform vec3 city : source_color = vec3(1.0, 0.52, 0.16);
uniform vec3 rim_col : source_color = vec3(1.0, 0.3, 0.2);
uniform float band_freq = 9.0;
uniform float cloud_night = 0.06;                       // le nubi sul lato notte (riflesso della cittÃ )
uniform float patch_size = 0.006;                       // raggio della macchia (radianti): un puntino
uniform float city_e = 7.0;
uniform float rim_e = 2.2;
uniform float rim_pow = 24.0;                           // da vicino quasi tutto il disco Ã¨ radente: bordo sottile

varying vec3 n_obj;
varying vec3 n_world;

void vertex() {
	n_obj = normalize(VERTEX);
	n_world = normalize((MODEL_MATRIX * vec4(VERTEX, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(n_obj);
	vec3 nw = normalize(n_world);
	vec3 L = normalize(sun_dir);
	vec3 V = normalize((INV_VIEW_MATRIX * vec4(VIEW, 0.0)).xyz);
	float ndl = dot(nw, L);
	// bande di nubi per latitudine, deformate dal rumore
	vec2 uv = vec2(atan(n.x, n.z) / 6.2831853, n.y * 0.5 + 0.5);
	float warp = texture(clouds, uv * vec2(3.0, 1.5)).r;
	float bands = 0.5 + 0.5 * sin((n.y + warp * 0.14) * band_freq * 3.14159);
	float cl = texture(clouds, uv * vec2(9.0, 4.5) + vec2(warp * 0.25, 0.0)).r;
	float cloud = smoothstep(0.42, 0.82, cl * 0.6 + bands * 0.5);
	float lit = smoothstep(-0.1, 0.4, ndl);
	vec3 surf = mix(night, day, lit);
	surf = mix(surf, band_col * (cloud_night + (1.0 - cloud_night) * lit), cloud * 0.85);
	// il terminatore: una lama arancione dove il sole tocca le nubi
	float term = exp(-pow(ndl * 8.0, 2.0));
	surf += terminator * term * cloud * 0.3;
	// Eggmanland: macchia calda sul lato notte, con una polvere di luci attorno
	float pd = acos(clamp(dot(n, normalize(patch_dir)), -1.0, 1.0));
	float core = exp(-pow(pd / patch_size, 2.0));
	float spread = exp(-pow(pd / (patch_size * 4.0), 2.0));
	// la polvere di luci in coordinate del piano tangente alla macchia (vicino al polo le uv lat-long
	// si stirano in righe)
	vec3 pn = normalize(patch_dir);
	vec3 t1 = normalize(cross(pn, abs(pn.x) < 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 0.0, 1.0)));
	vec3 t2 = cross(pn, t1);
	vec2 loc = vec2(dot(n, t1), dot(n, t2));
	float speck = smoothstep(0.6, 0.8, texture(clouds, loc * 90.0 + vec2(0.37, 0.61)).r);
	vec3 em = city * (core + spread * speck * 0.6) * city_e * (1.0 - lit) * (1.0 - cloud * 0.45);
	// bordo dell'atmosfera, piÃ¹ forte verso il sole (controluce)
	float fres = pow(1.0 - clamp(dot(nw, V), 0.0, 1.0), rim_pow);
	float sunward = smoothstep(-0.35, 0.75, ndl) * (0.5 + 0.5 * max(dot(-V, L), 0.0));
	vec3 rim = rim_col * fres * rim_e * (0.25 + 2.0 * sunward);
	ALBEDO = surf + em + rim;
}
␀␀shader_type spatial;
// Hydrocity Zone: i mattoni (scripts/env/gen_hcz/kit.gd), alla maniera dei Sonic in 3D di oggi (le
// zone classiche rifatte di Generations e Frontiers): stessi colori di Sonic 3 (quasi tutti gialli
// ocra, qualcuno verde acqua e qualcuno grigio lilla, ogni tanto la piastrella con la foglia incisa),
// ma con il rilievo vero. Coordinate del mondo, a tre piani: sui fianchi la fila corre in orizzontale
// (sfalsata di mezzo mattone a ogni riga), sopra e sotto in pianta.
//   - ogni mattone ha lo smusso sui bordi e sta un filo piÃ¹ in fuori o piÃ¹ in dentro degli altri, la
//     malta Ã¨ incassata e scura (ombra nelle fughe); la superficie ha i pori e le scheggiature;
//   - colore e ruvidezza cambiano da mattone a mattone; sporco che cola giÃ¹ dai bordi, muschio nelle
//     fughe in alto e vicino all'acqua;
//   - le piastrelle con la foglia sono smaltate (lucide) e la foglia Ã¨ incisa davvero;
//   - vicino al pelo dell'acqua (hcz_common: water_at) i mattoni sono bagnati, scuri e lucidi, con la
//     riga d'alghe; sotto, le caustiche; sopra, i riflessi tremolanti.
// tone: 1 i mattoni del percorso, meno per quelli lontani o in ombra (fondali, piloni sotto l'acqua).
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/hcz/hcz_common.gdshaderinc"

uniform vec3 col_yellow : source_color = vec3(0.80, 0.60, 0.27);
uniform vec3 col_yellow2 : source_color = vec3(0.70, 0.49, 0.20);
uniform vec3 col_green : source_color = vec3(0.20, 0.55, 0.40);
uniform vec3 col_grey : source_color = vec3(0.56, 0.56, 0.72);
uniform vec3 col_mortar : source_color = vec3(0.10, 0.07, 0.05);
uniform vec3 col_moss : source_color = vec3(0.16, 0.30, 0.08);
uniform vec3 col_grime : source_color = vec3(0.22, 0.14, 0.10);
uniform vec3 tile_green : source_color = vec3(0.30, 0.68, 0.46);
uniform vec3 tile_blue : source_color = vec3(0.44, 0.52, 0.74);
uniform float brick_w = 1.0;
uniform float brick_h = 0.5;
uniform float tone = 1.0;
uniform float glyphs = 0.07;       // quota delle celle da 1 m con la piastrella incisa
uniform float green_amt = 0.16;
uniform float grey_amt = 0.1;
uniform float relief = 1.0;        // forza del rilievo (0 piatto)
uniform float moss = 1.0;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

// distanza (in 0..1 della piastrella) dalla foglia incisa: stelo, due coppie di nervature a V, base
float glyph_d(vec2 q) {
	vec2 c = q - 0.5;
	float d = max(abs(c.x) - 0.035, max(-0.32 - c.y, c.y - 0.30));
	for (int i = 0; i < 2; i++) {
		float y0 = -0.18 + float(i) * 0.24;
		float dv = abs(abs(c.x) * 0.9 - (c.y - y0)) * 0.74 - 0.035;
		dv = max(dv, max(abs(c.x) - 0.30, 0.05 - abs(c.x)));
		d = min(d, dv);
	}
	d = min(d, max(abs(c.y + 0.34) - 0.035, abs(c.x) - 0.16));
	return d;
}

void fragment() {
	vec3 n = normalize(wn);
	vec3 an = abs(n);
	vec2 uv;
	float face;
	bool side = true;
	if (an.y > an.x && an.y > an.z) {
		uv = wp.xz;
		face = 0.0;
		side = false;
	} else if (an.x > an.z) {
		uv = vec2(wp.z * sign(n.x), wp.y);
		face = 1.0;
	} else {
		uv = vec2(-wp.x * sign(n.z), wp.y);
		face = 2.0;
	}
	float row = floor(uv.y / brick_h);
	float off = mod(row, 2.0) * 0.5 + (hash12(vec2(row, face)) - 0.5) * 0.12;
	float colm = floor(uv.x / brick_w + off);
	vec2 f = vec2(fract(uv.x / brick_w + off), fract(uv.y / brick_h));
	vec2 id = vec2(colm, row) + face * 31.7;
	float h = hash12(id);
	float h2 = hash12(id * 1.7 + 3.1);
	vec3 col = mix(col_yellow, col_yellow2, h2);
	float kind = 0.0;
	if (h < green_amt) {
		col = col_green * (0.85 + 0.3 * h2);
		kind = 1.0;
	} else if (h < green_amt + grey_amt) {
		col = col_grey * (0.85 + 0.3 * h2);
		kind = 2.0;
	}
	// variazione di tinta e di luce di ogni mattone
	col *= 0.88 + 0.18 * hash12(id + 7.7);
	col = mix(col, col * vec3(1.05, 0.96, 0.88), hash12(id + 11.3) * 0.5);
	// macchie larghe: zone piÃ¹ scure e piÃ¹ chiare (la pietra non Ã¨ tutta uguale)
	col *= 0.78 + 0.34 * vnoise(uv * 0.18 + face * 7.0);
	// bordi in metri: smusso, malta incassata
	vec2 e2 = min(f, 1.0 - f) * vec2(brick_w, brick_h);
	float e = min(e2.x, e2.y);
	float mortar_w = 0.04;
	float bev = smoothstep(mortar_w, mortar_w + 0.06, e);
	float pore = vnoise(uv * 9.0 + id * 3.1);
	float chip = smoothstep(0.66, 0.85, vnoise(uv * 3.2 + id * 1.3)) * (1.0 - smoothstep(0.0, 0.16, e));
	float lift = (hash12(id + 2.9) - 0.5) * 0.025;
	float H = bev * (0.06 + lift) - pore * 0.01 * bev - chip * 0.035;
	float rough = mix(0.55, 0.78, hash12(id + 5.5)) + pore * 0.1;
	float ao = mix(0.3, 1.0, bev) * (1.0 - chip * 0.35);
	// spigoli consumati: un filo piÃ¹ chiari
	col *= 1.0 + 0.12 * (1.0 - smoothstep(mortar_w + 0.02, mortar_w + 0.09, e)) * bev;
	// piastrelle incise (solo sui fianchi): celle da 1 m, cornice incassata, foglia incisa, smalto
	float glaze = 0.0;
	if (side) {
		vec2 tc = floor(uv);
		float th = hash12(tc + face * 5.1 + 0.37);
		if (th < glyphs) {
			vec2 q = fract(uv);
			bool blue = hash12(tc * 2.3 + 1.9) < 0.45;
			vec3 tcol = blue ? tile_blue : tile_green;
			float fe = min(min(q.x, 1.0 - q.x), min(q.y, 1.0 - q.y));
			float frame = smoothstep(0.035, 0.07, fe);
			float gd = glyph_d(q);
			float gw = fwidth(gd) + 0.004;
			float g = 1.0 - smoothstep(-gw, gw, gd);
			col = mix(tcol * 0.95, blue ? tcol * 1.25 : tcol * 0.45, g);
			col = mix(col_mortar * 1.2, col, frame);
			H = frame * 0.05 - g * 0.025 - (1.0 - smoothstep(0.07, 0.12, fe)) * 0.01;
			ao = mix(0.45, 1.0, frame) * (1.0 - g * 0.3);
			rough = mix(0.18, 0.5, g);
			glaze = frame * (1.0 - g);
			kind = 3.0;
		}
	}
	col = mix(col_mortar, col, bev);
	// sporco che cola dai bordi in giÃ¹ (sui fianchi) e macchie larghe
	float stain = fbm(vec2(uv.x * 1.3, uv.y * 0.18) + face * 3.0);
	float streak = smoothstep(0.5, 0.9, vnoise(vec2(uv.x * 4.0, uv.y * 0.35)));
	float dirt = side ? clamp(stain * 0.55 + streak * 0.35 - 0.25, 0.0, 1.0) : clamp(stain - 0.45, 0.0, 1.0);
	col = mix(col, col_grime, dirt * 0.45 * (1.0 - glaze * 0.6));
	// muschio: nelle fughe e sui mattoni sopra le facce in su, e vicino all'acqua
	vec4 wl = water_light(wp, n, TIME);
	float mz = fbm(uv * 1.4 + 40.0);
	float mosszone = (n.y > 0.5 ? 0.55 : 0.0) + wl.y * 0.6;
	float mossy = smoothstep(0.58, 0.72, mz + (1.0 - bev) * 0.25 + mosszone * 0.25) * moss * (1.0 - glaze);
	col = mix(col, col_moss * (0.7 + 0.6 * pore), mossy * 0.85);
	rough = mix(rough, 0.9, mossy);
	H += mossy * 0.01;
	// riga d'alghe sul pelo, bagnato: piÃ¹ scuro e lucido
	col = mix(col, col_moss * 0.45, wl.z * 0.8);
	float sub = wl.w;
	col *= mix(1.0, 0.62, wl.y * (1.0 - sub * 0.8));
	rough = mix(rough, 0.16, wl.y * (1.0 - mossy * 0.5));
	// sotto un filo piÃ¹ scuro (la luce viene dall'alto)
	col *= side ? 1.0 : (n.y > 0.0 ? 0.95 : 0.7);
	vec3 nb = bump_normal(n, wp, H, relief);
	NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
	ALBEDO = col * tone;
	ROUGHNESS = clamp(rough, 0.05, 1.0);
	SPECULAR = mix(0.4, 0.6, max(glaze, wl.y));
	AO = ao;
	AO_LIGHT_AFFECT = 0.35;
	EMISSION = col * tone * (wl.x * vec3(0.55, 0.95, 0.9) * 0.9 + UNDER_LIGHT * sub * 0.55);
}
␀␀␀␀␀␀shader_type spatial;
// Hydrocity Zone: le colonne viola delle sale (scripts/env/gen_hcz/kit.gd, solidi di rotazione:
// UV.x = giro 0..1, UV.y = metri in altezza; UV2.x = 1 su base e capitello). Pietra viola lucidata:
// scanalature vere (rilievo), anelli d'oro ogni tanto sul fusto, base e capitello piÃ¹ chiari con le
// venature, sporco che cola, e l'acqua (bagnato, alghe, caustiche: hcz_common).
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/hcz/hcz_common.gdshaderinc"

uniform vec3 dark : source_color = vec3(0.17, 0.07, 0.33);
uniform vec3 light : source_color = vec3(0.46, 0.24, 0.76);
uniform vec3 gold : source_color = vec3(0.95, 0.68, 0.22);
uniform vec3 col_moss : source_color = vec3(0.10, 0.22, 0.10);
uniform float flutes = 14.0;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wn);
	float a = UV.x * flutes;
	float fl = 0.5 + 0.5 * cos(a * 6.2832);
	float shaft = 1.0 - UV2.x;
	// scanalature: canale tondo, spigolo vivo fra l'una e l'altra
	float groove = pow(1.0 - fl, 1.5);
	vec3 col = mix(light, dark, groove * 0.6 * shaft);
	float H = -groove * 0.05 * shaft;
	float ring = 1.0 - smoothstep(0.03, 0.06, abs(fract(UV.y / 3.0) - 0.96));
	ring *= shaft;
	// venature della pietra
	float vein = smoothstep(0.62, 0.7, vnoise(vec2(UV.x * 18.0, UV.y * 0.6)));
	col = mix(col, light * 1.25, vein * 0.25);
	col = mix(col, light * 1.1, UV2.x * 0.5);
	float rough = mix(0.32, 0.5, groove);
	float metal = 0.0;
	col = mix(col, gold, ring);
	rough = mix(rough, 0.28, ring);
	metal = ring * 0.85;
	H += ring * 0.02;
	float streak = smoothstep(0.5, 0.95, vnoise(vec2(UV.x * 30.0, UV.y * 0.3)));
	col = mix(col, dark * 0.4, streak * 0.3 * (1.0 - ring));
	vec4 wl = water_light(wp, n, TIME);
	col = mix(col, col_moss, wl.z * 0.7 * (1.0 - ring));
	float sub = wl.w;
	col *= mix(1.0, 0.7, wl.y * (1.0 - sub * 0.8));
	rough = mix(rough, 0.14, wl.y);
	vec3 nb = bump_normal(n, wp, H, 1.0);
	NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
	ALBEDO = col;
	METALLIC = metal;
	ROUGHNESS = rough;
	SPECULAR = 0.5;
	AO = 1.0 - groove * 0.35 * shaft;
	AO_LIGHT_AFFECT = 0.3;
	EMISSION = col * (wl.x * vec3(0.6, 0.95, 0.95) + UNDER_LIGHT * sub * 0.6);
}
␀␀␀␀␀␀␀shader_type spatial;
// Hydrocity Zone: la schiuma sul pelo dell'acqua al piede delle cascate (scripts/env/gen_hcz/kit.gd,
// _splash_nodes): chiazze bianche che ribollono e si allargano via dalla cascata (UV.y = 0 contro la
// cascata, 1 lontano), sfumate ai bordi.
render_mode blend_mix, depth_draw_never, cull_disabled, shadows_disabled, diffuse_burley;

uniform vec3 tint : source_color = vec3(0.9, 0.98, 1.0);

float h12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float vn(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(h12(i), h12(i + vec2(1, 0)), u.x), mix(h12(i + vec2(0, 1)), h12(i + vec2(1, 1)), u.x), u.y);
}

void fragment() {
	vec2 q = UV;
	float edge = smoothstep(0.0, 0.25, q.x) * smoothstep(0.0, 0.25, 1.0 - q.x);
	float away = 1.0 - smoothstep(0.1, 1.0, q.y);
	float n = vn(vec2(q.x * 9.0, q.y * 5.0 - TIME * 1.6)) * 0.6 + vn(vec2(q.x * 21.0, q.y * 12.0 - TIME * 2.4)) * 0.4;
	float a = smoothstep(0.35 + q.y * 0.35, 0.7 + q.y * 0.2, n) * edge * away;
	ALBEDO = tint;
	EMISSION = tint * 0.2;
	ROUGHNESS = 0.4;
	ALPHA = a * 0.9;
}
␀␀␀␀shader_type spatial;
// Hydrocity Zone Â· Boss: l'onda che insegue i giocatori lungo la strada che crolla
// (scripts/level/hczb_race.gd). Una striscia sola lungo tutta la strada (UV.x = di traverso -1..1,
// UV.y = s, metri di strada; UV2.x = 1 dove l'onda corre in superficie, 0 nella torre: lÃ¬ sale il pelo
// del pozzo); TANGENT = il verso della strada. Il vertice si alza in un muro d'acqua appena dietro al
// fronte (front_s), con la cresta che si piega in avanti e la schiuma bianca; dietro l'acqua corre
// alta sul viadotto e piÃ¹ indietro sprofonda nel lago (il viadotto non c'Ã¨ piÃ¹); davanti al fronte
// non si disegna niente. Colori del rif. dell'utente: verde acqua profondo, azzurro, schiuma bianca.

render_mode cull_disabled, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/hcz/hcz_common.gdshaderinc"

uniform float front_s = -1000.0;
uniform float crest = 5.5;
uniform float lake_y = -12.0;
uniform vec3 col_deep : source_color = vec3(0.03, 0.30, 0.40);
uniform vec3 col_mid : source_color = vec3(0.16, 0.64, 0.76);
uniform vec3 foam : source_color = vec3(0.90, 0.98, 1.0);

varying float v_d;
varying float v_on;

void vertex() {
	float s = UV.y;
	float x = UV.x;
	float d = front_s - s;
	v_d = d;
	v_on = UV2.x;
	float t = TIME;
	float rise = smoothstep(-1.0, 3.2, d);
	float settle = 1.0 - 0.5 * smoothstep(4.0, 22.0, d);
	float n = vnoise(vec2(s * 0.35 - t * 1.9, x * 3.0 + t * 0.7));
	float n2 = vnoise(vec2(s * 1.3 - t * 4.0, x * 7.0));
	float h = crest * rise * settle * (0.82 + 0.3 * n) + 0.25 * n2;
	// ai lati l'acqua trabocca giÃ¹ dal viadotto
	h -= 3.0 * smoothstep(0.72, 1.0, abs(x));
	// piÃ¹ indietro sprofonda nel lago
	float sink = max(d - 38.0, 0.0) * 0.5;
	VERTEX.y += h - sink - 1.4 * (1.0 - rise);
	VERTEX.y = max(VERTEX.y, lake_y + 0.15);
	// la cresta si piega in avanti
	VERTEX += TANGENT * (1.8 * smoothstep(0.2, 2.2, d) * (1.0 - smoothstep(2.2, 7.5, d)));
}

void fragment() {
	if (v_on < 0.5 || v_d < -0.4 || v_d > 100.0) {
		discard;
	}
	float t = TIME;
	float f = fbm(vec2(UV.x * 3.0, UV.y * 0.45 - t * 2.6));
	float g = vnoise(vec2(UV.x * 9.0 + 3.0, UV.y * 1.6 - t * 6.0));
	// schiuma: la cresta (una striscia sottile in cima al muro d'acqua, a strappi) e qualche chiazza;
	// la faccia del muro resta acqua (verde-azzurra a strisce che colano)
	float crest_k = smoothstep(-0.4, 0.5, v_d) * (1.0 - smoothstep(1.0, 2.8, v_d));
	float streak = vnoise(vec2(UV.x * 14.0, UV.y * 0.25 + t * 1.5));
	vec3 col = mix(col_deep, col_mid, smoothstep(0.3, 0.72, f) * 0.8 + 0.25 * streak * (1.0 - smoothstep(2.0, 6.0, v_d)));
	float fo = clamp(crest_k * smoothstep(0.25, 0.7, g + 0.25 * streak) + smoothstep(0.68, 0.86, f) * 0.4 + smoothstep(0.82, 1.0, abs(UV.x)) * 0.35, 0.0, 1.0);
	col = mix(col, foam, fo);
	ALBEDO = col;
	ROUGHNESS = mix(0.06, 0.55, fo);
	SPECULAR = 0.7;
	EMISSION = col_mid * 0.06 + foam * fo * 0.12;
}
␀␀␀␀␀␀␀␀␀␀␀␀// Hydrocity Zone: i pezzi in comune degli shader della cittÃ  sommersa (mattoni, pareti, colonne).
//   - rumore (hash, value noise, fbm);
//   - rilievo dalle derivate: da un'altezza H (metri) calcolata nel fragment, la normale inclinata
//     (metodo del "surface gradient": niente tangenti, va bene in coordinate del mondo);
//   - il pelo dell'acqua sotto il punto: dalla mappa delle quote (Atto 1: sale con l'acqua a quote
//     diverse, fatta da kit.gd) o da water_y (Atto 2: un livello solo che sale e scende);
//   - le caustiche (la luce rifratta dalle onde) sott'acqua, i riflessi tremolanti sopra il pelo, la
//     fascia bagnata e la riga d'alghe sul pelo.

uniform sampler2D water_map : filter_nearest, repeat_disable;
// x0, z0, larghezza, lunghezza della mappa (m); larghezza 0: niente mappa, vale water_y
uniform vec4 water_rect = vec4(0.0);
uniform float water_y = -1000.0;
uniform float caustics = 1.0;

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = hash12(i);
	float b = hash12(i + vec2(1.0, 0.0));
	float c = hash12(i + vec2(0.0, 1.0));
	float d = hash12(i + vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

// tre ottave (0..~0.9)
float fbm(vec2 p) {
	float s = vnoise(p) * 0.5;
	p = p * 2.03 + vec2(17.1, 9.3);
	s += vnoise(p) * 0.25;
	p = p * 2.03 + vec2(17.1, 9.3);
	s += vnoise(p) * 0.125;
	return s / 0.875 * 0.94;
}

// normale (del mondo) inclinata dall'altezza h, che varia lungo la superficie in p (mondo)
vec3 bump_normal(vec3 n, vec3 p, float h, float k) {
	vec3 dpdx = dFdx(p);
	vec3 dpdy = dFdy(p);
	float hx = dFdx(h) * k;
	float hy = dFdy(h) * k;
	vec3 r1 = cross(dpdy, n);
	vec3 r2 = cross(n, dpdx);
	float det = dot(dpdx, r1);
	vec3 g = sign(det) * (hx * r1 + hy * r2);
	return normalize(abs(det) * n - g);
}

float water_at(vec3 p) {
	if (water_rect.z > 0.0) {
		vec2 uv = (p.xz - water_rect.xy) / water_rect.zw;
		if (uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0) {
			return -1000.0;
		}
		return texture(water_map, uv).r;
	}
	return water_y;
}

// la luce verde acqua che c'Ã¨ sott'acqua (la luce dall'alto diffusa dall'acqua: la luce del sole e
// del riempimento lÃ¬ sotto arriva poco): si aggiunge come luce propria, per l'albedo
const vec3 UNDER_LIGHT = vec3(0.16, 0.52, 0.56);

// caustiche: la rete di luce che le onde mettono sul fondo. Due rumori che scorrono in versi diversi:
// dove si incrociano (differenza piccola) c'Ã¨ la riga chiara. p in "piastrelle" (circa 4.5 m l'una)
float caustic(vec2 p, float t) {
	vec2 q = p * 5.0;
	float a = vnoise(q + vec2(t * 0.6, t * 0.4));
	float b = vnoise(q * 1.3 - vec2(t * 0.5, -t * 0.62) + 7.0);
	float r = clamp(1.0 - abs(a - b) * 3.2, 0.0, 1.0);
	return r * r * r * r * r * 1.6;
}

// luce dell'acqua su una superficie in p (mondo) con la normale n: torna (caustiche, bagnato, alghe,
// sott'acqua: 0 all'asciutto o sul pelo, 1 da 1.5 m sotto in giÃ¹)
//   caustiche: sott'acqua dall'alto (piÃ¹ forti sulle facce in su, sbiadite col fondo), sopra il pelo i
//   riflessi tremolanti sulle facce di lato e di sotto (fino a 3 m);
//   bagnato: 1 fino a 0.4 m sopra il pelo, poi sfuma; alghe: la riga scura proprio sul pelo.
vec4 water_light(vec3 p, vec3 n, float t) {
	float wy = water_at(p);
	if (wy < -900.0) {
		return vec4(0.0);
	}
	float d = wy - p.y;
	float c = 0.0;
	if (d > 30.0 || d < -3.0) {
		// lontano dal pelo: sott'acqua fonda solo la luce verde (submerged), sopra niente
		return vec4(0.0, d > 0.0 ? 1.0 : 0.0, 0.0, d > 0.0 ? 1.0 : 0.0);
	}
	if (d > 0.0) {
		vec2 cp = abs(n.y) > 0.5 ? p.xz : (abs(n.x) > abs(n.z) ? p.zy : p.xy);
		c = caustic(cp * 0.22 + vec2(0.0, d * 0.03), t * 0.55);
		c *= exp(-d * 0.06) * (0.6 + 0.6 * max(n.y, 0.0)) * 1.6;
	} else if (n.y < 0.6) {
		float up = -d;
		vec2 cp = abs(n.y) > 0.5 ? p.xz : (abs(n.x) > abs(n.z) ? vec2(p.z, p.y * 0.35) : vec2(p.x, p.y * 0.35));
		c = caustic(cp * 0.3 + vec2(t * 0.05, 0.0), t * 0.8) * 0.55;
		c *= (1.0 - smoothstep(0.0, 3.0, up)) * smoothstep(-0.05, 0.25, up);
		c *= 0.6 + 0.4 * max(-n.y, 0.0);
	}
	float wet = 1.0 - smoothstep(0.35, 0.9, -d);
	float algae = (1.0 - smoothstep(0.0, 0.35, abs(d + 0.05))) * smoothstep(-0.9, -0.2, d);
	return vec4(c * caustics, wet, algae, smoothstep(0.0, 1.5, d));
}
␀␀␀␀␀␀shader_type spatial;
// Hydrocity Zone: la nebbiolina al piede delle cascate (particelle: scripts/env/gen_hcz/kit.gd,
// _splash_nodes). Quadrato sempre girato verso la telecamera, macchia morbida a nuvola, alfa dal
// colore della particella, sfuma dove tocca le cose (profonditÃ  della schermata).
render_mode blend_mix, depth_draw_never, cull_disabled, shadows_disabled, diffuse_burley;

uniform sampler2D depth_tex : hint_depth_texture, filter_nearest, repeat_disable;
uniform vec3 tint : source_color = vec3(0.82, 0.94, 1.0);

float h12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float vn(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(h12(i), h12(i + vec2(1, 0)), u.x), mix(h12(i + vec2(0, 1)), h12(i + vec2(1, 1)), u.x), u.y);
}

void vertex() {
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], MODEL_MATRIX[3]);
	MODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0, 0, 0), vec4(0, length(MODEL_MATRIX[1].xyz), 0, 0), vec4(0, 0, length(MODEL_MATRIX[2].xyz), 0), vec4(0, 0, 0, 1));
}

void fragment() {
	vec2 c = UV - 0.5;
	float r = length(c) * 2.0;
	float n = vn(UV * 4.0 + COLOR.rg * 7.0 + TIME * 0.2);
	float blob = (1.0 - smoothstep(0.2, 1.0, r + (n - 0.5) * 0.4));
	float d = textureLod(depth_tex, SCREEN_UV, 0.0).r;
	vec4 v = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, d, 1.0);
	float soft = smoothstep(0.0, 1.2, -v.z / v.w + VERTEX.z);
	ALBEDO = tint;
	EMISSION = tint * 0.25;
	ALPHA = blob * COLOR.a * soft;
}
␀␀␀␀shader_type spatial;
// Hydrocity Zone: gli aggeggi della cittÃ  sommersa (cilindri che girano, mani lanciatrici, punte,
// colonne d'acqua, cancello, leve, zattere, paratoia; i pezzi li fa scripts/level/hcz_prop_kit.gd).
// Vernice lucida e metalli puliti alla maniera dei Sonic in 3D di oggi:
//   - il riflesso finto della sala (env): sotto il blu viola scuro, all'orizzonte il verde acqua delle
//     cascate, in alto la luce calda delle finestre; l'oro e il cromo restano oro e cromo anche dove la
//     sala non ha un riflesso vero;
//   - i disegni (pattern): 1 righe a spirale lungo UV (i rulli: si vede che girano), 2 mattoni in
//     coordinate dell'oggetto (le zattere, che si muovono: i mattoni non scorrono), 3 strisce gialle e
//     nere d'attenzione, 4 metallo spazzolato (righe sottili lungo UV.y);
//   - sporco e usura leggeri (rumore in coordinate dell'oggetto), COLOR come tinta (use_color: le punte
//     col collare d'oro in una mesh sola);
//   - l'acqua come sui mattoni (hcz_common: bagnato, alghe, caustiche, la luce verde sott'acqua).
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/hcz/hcz_common.gdshaderinc"

uniform vec3 base : source_color = vec3(0.5);
uniform vec3 base2 : source_color = vec3(0.8);
uniform vec3 base3 : source_color = vec3(0.3);
uniform float metal = 0.0;
uniform float rough = 0.4;
uniform float env = 0.3;
uniform float grime = 0.12;
uniform int pattern = 0;
// righe: (quante attorno, giri lungo UV.y per metro, larghezza 0..1, -); mattoni: (largo, alto, -, -);
// strisce: (passo in m, -, -, -)
uniform vec4 pat = vec4(4.0, 0.1, 0.22, 0.0);
uniform bool use_color = false;
uniform vec3 glow : source_color = vec3(0.0);
uniform float glow_k = 0.0;
uniform vec3 col_moss : source_color = vec3(0.12, 0.26, 0.10);

varying vec3 wp;
varying vec3 wn;
varying vec3 lp;
varying vec3 ln;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize(MODEL_NORMAL_MATRIX * NORMAL);
	lp = VERTEX;
	ln = NORMAL;
}

// mattoni sfalsati in coordinate dell'oggetto, sul piano della faccia: (fuga 0..1, tinta 0..1, id)
vec3 bricks(vec3 p, vec3 nn, vec2 sz) {
	vec3 a = abs(nn);
	vec2 q = a.y > max(a.x, a.z) ? p.xz : (a.x > a.z ? vec2(p.z, p.y) : vec2(p.x, p.y));
	q /= sz;
	float row = floor(q.y);
	q.x += mod(row, 2.0) * 0.5;
	vec2 c = floor(q);
	vec2 f = fract(q);
	vec2 e = min(f, 1.0 - f) * sz;
	float m = 1.0 - smoothstep(0.015, 0.05, min(e.x, e.y));
	return vec3(m, hash12(c + 7.3), hash12(c * 1.7 + 2.1));
}

void fragment() {
	vec3 n = normalize(wn);
	vec3 col = base;
	float m = metal;
	float r = rough;
	float H = 0.0;
	float ao = 1.0;
	if (use_color) {
		col *= COLOR.rgb;
	}
	if (pattern == 1) {
		float s = fract(UV.x * pat.x + UV.y * pat.y);
		float d = abs(s - 0.5) / pat.x;
		float band = 1.0 - smoothstep(pat.z * 0.5 / pat.x - 0.004, pat.z * 0.5 / pat.x + 0.004, d);
		col = mix(col, base2, band);
		H += band * 0.01;
	} else if (pattern == 2) {
		vec3 bk = bricks(lp, ln, pat.xy);
		vec3 tint = bk.y < 0.62 ? base : (bk.y < 0.86 ? base2 : base3);
		tint *= 0.86 + 0.28 * bk.z;
		col = mix(tint, vec3(0.1, 0.07, 0.05), bk.x);
		H -= bk.x * 0.02;
		r = mix(r, 0.9, bk.x);
		ao = 1.0 - bk.x * 0.5;
	} else if (pattern == 3) {
		float s = fract((lp.x + lp.y + lp.z) / pat.x);
		float k = smoothstep(0.48, 0.52, s);
		col = mix(base, base2, k);
	} else if (pattern == 4) {
		float b = vnoise(vec2(UV.x * 140.0, UV.y * 3.0));
		col *= 0.9 + 0.2 * b;
		r = mix(r * 0.8, r * 1.3, b);
	}
	// sporco e usura: macchie chiare/scure leggere
	float g = fbm(lp.xz * 1.7 + vec2(lp.y * 1.3, -lp.y * 0.9));
	col *= 1.0 - grime * smoothstep(0.45, 0.85, g);
	r = clamp(r + grime * (g - 0.4) * 0.5, 0.05, 1.0);
	// l'acqua
	vec4 wl = water_light(wp, n, TIME);
	float sub = wl.w;
	col = mix(col, col_moss, wl.z * 0.45 * (1.0 - m));
	col *= mix(1.0, 0.8, wl.y * (1.0 - sub * 0.8));
	r = mix(r, 0.12, wl.y * 0.6);
	vec3 nb = (pattern == 1 || pattern == 2) ? bump_normal(n, wp, H, 1.0) : n;
	// riflesso finto della sala
	vec3 V = normalize((INV_VIEW_MATRIX * vec4(VIEW, 0.0)).xyz);
	vec3 R = reflect(-V, nb);
	vec3 sky = mix(vec3(0.07, 0.04, 0.2), vec3(0.28, 0.75, 0.86), smoothstep(-0.35, 0.2, R.y));
	sky = mix(sky, vec3(1.0, 0.95, 0.82), smoothstep(0.4, 0.92, R.y));
	// le finestre della sala: righe chiare verticali nel riflesso
	float win = smoothstep(0.6, 0.9, sin(atan(R.z, R.x) * 9.0)) * smoothstep(0.05, 0.3, R.y) * (1.0 - smoothstep(0.55, 0.8, R.y));
	sky += vec3(0.9, 0.85, 1.0) * win * 0.6;
	float fres = pow(1.0 - clamp(dot(nb, V), 0.0, 1.0), 4.0);
	vec3 tint = mix(vec3(0.04), col, m);
	vec3 refl = sky * mix(tint, vec3(1.0), fres * 0.7) * env * mix(1.0, 0.45, sub) * (1.0 - r * 0.6);
	NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
	ALBEDO = col;
	METALLIC = m;
	ROUGHNESS = r;
	SPECULAR = 0.5;
	AO = ao;
	AO_LIGHT_AFFECT = 0.3;
	EMISSION = col * (wl.x * vec3(0.6, 0.95, 0.95) + UNDER_LIGHT * sub * 0.6) * (1.0 - m * 0.5) + refl + glow * glow_k;
}
␀␀␀␀␀␀␀␀␀shader_type spatial;
// Hydrocity Zone: i raggi di luce che scendono dal soffitto (scripts/env/gen_hcz/kit.gd, _shafts):
// facce incrociate, luce calda additiva. UV.x di traverso 0..1, UV.y metri dall'alto; UV2 = (fase,
// lunghezza). Sfumano ai bordi, scendendo e di taglio (la faccia vista di lato sparisce), si spengono
// dolci dove toccano le cose (profonditÃ  della schermata) e vicino alla telecamera; dentro, il
// pulviscolo che scende piano.
render_mode blend_add, depth_draw_never, cull_disabled, unshaded, shadows_disabled;

uniform sampler2D depth_tex : hint_depth_texture, filter_nearest, repeat_disable;
uniform vec3 tint : source_color = vec3(1.0, 0.82, 0.58);
uniform float energy = 0.16;

float h12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float vn(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(h12(i), h12(i + vec2(1, 0)), u.x), mix(h12(i + vec2(0, 1)), h12(i + vec2(1, 1)), u.x), u.y);
}

void fragment() {
	float ln = max(UV2.y, 1.0);
	float t = UV.y / ln;
	float across = 1.0 - pow(abs(UV.x * 2.0 - 1.0), 1.6);
	float along = smoothstep(0.0, 0.08, t) * (1.0 - smoothstep(0.45, 1.0, t));
	float facing = pow(abs(dot(NORMAL, VIEW)), 1.5);
	float d = textureLod(depth_tex, SCREEN_UV, 0.0).r;
	vec4 v = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, d, 1.0);
	float scene_z = -v.z / v.w;
	float soft = smoothstep(0.0, 2.5, scene_z + VERTEX.z);
	float near = smoothstep(1.0, 6.0, -VERTEX.z);
	float dust = 0.65 + 0.35 * vn(vec2(UV.x * 6.0 + UV2.x * 10.0, UV.y * 0.7 - TIME * 0.4));
	float a = across * along * facing * soft * near * dust * (0.7 + 0.3 * UV2.x);
	ALBEDO = tint * a * energy;
}
␀␀␀␀␀␀␀␀␀shader_type spatial;
// Hydrocity Zone: la corrente delle colonne d'acqua di risalita (scripts/level/hcz_spout.gd).
//   mode 0: il tubo della corrente (UV.x = giro, UV.y = metri in su): filamenti chiari che salgono
//           veloci, piÃ¹ densa sui bordi (fresnel), sfumata in fondo e in cima (len = altezza del tubo,
//           per istanza);
//   mode 1: la schiuma al pelo (anello, UV.y = metri dal bordo interno): ribolle e si allarga, sfuma
//           verso fuori.
render_mode blend_mix, depth_draw_never, cull_disabled, shadows_disabled, unshaded;

uniform int mode = 0;
uniform vec3 col_a : source_color = vec3(0.3, 0.82, 0.9);
uniform vec3 col_b : source_color = vec3(0.92, 1.0, 1.0);
uniform float speed = 2.4;
uniform float alpha = 0.32;
uniform float width = 1.4;
instance uniform float len = 4.0;

float h12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

// rumore liscio che si ripete ogni per lungo x (attorno al tubo: niente cucitura)
float vnp(vec2 p, float per) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float x0 = mod(i.x, per);
	float x1 = mod(i.x + 1.0, per);
	return mix(mix(h12(vec2(x0, i.y)), h12(vec2(x1, i.y)), u.x), mix(h12(vec2(x0, i.y + 1.0)), h12(vec2(x1, i.y + 1.0)), u.x), u.y);
}

void fragment() {
	float fres = 1.0 - abs(dot(normalize(NORMAL), normalize(VIEW)));
	if (mode == 0) {
		vec2 q = vec2(UV.x * 8.0, UV.y * 0.55 - TIME * speed);
		float s = vnp(q, 8.0) * 0.6 + vnp(vec2(q.x * 2.0, q.y * 1.7 - TIME * 0.7 + 3.1), 16.0) * 0.4;
		float streak = smoothstep(0.52, 0.82, s);
		float ends = smoothstep(0.0, 0.8, UV.y) * (1.0 - smoothstep(len - 1.0, len, UV.y));
		ALBEDO = mix(col_a, col_b, clamp(streak * 0.85 + fres * 0.35, 0.0, 1.0));
		ALPHA = clamp(alpha * (0.3 + fres * 1.1 + streak * 1.3), 0.0, 0.9) * ends;
	} else {
		float d = UV.y / width;
		float n = vnp(vec2(UV.x * 18.0, UV.y * 4.0 - TIME * 1.4), 18.0) * 0.6 + vnp(vec2(UV.x * 36.0, UV.y * 9.0 - TIME * 2.2 + 2.0), 36.0) * 0.4;
		float a = smoothstep(0.3 + d * 0.4, 0.62 + d * 0.25, n) * (1.0 - smoothstep(0.55, 1.0, d)) * smoothstep(0.0, 0.08, d);
		ALBEDO = col_b;
		ALPHA = clamp(a * 0.85 + (1.0 - d) * 0.18, 0.0, 0.9) * (1.0 - smoothstep(0.75, 1.0, d));
	}
}
␀␀␀␀␀␀␀␀shader_type spatial;
// Hydrocity Zone: i rampicanti appesi ai bordi dei blocchi e alle travi (scripts/env/gen_hcz/kit.gd,
// _vine). Nastro: UV.x di traverso 0..1, UV.y metri dall'alto; UV2 = (fase, lunghezza). Lo shader
// disegna lo stelo che serpeggia e le foglie a goccia alternate ai due lati (ritaglio alfa), verde scuro
// in alto e piÃ¹ chiaro e giallino sulle punte; controluce (la luce passa nelle foglie); in fondo il
// filo si assottiglia. Il nastro ondeggia un poco.
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform vec3 leaf_dark : source_color = vec3(0.08, 0.24, 0.07);
uniform vec3 leaf_light : source_color = vec3(0.36, 0.58, 0.14);
uniform vec3 leaf_tip : source_color = vec3(0.62, 0.66, 0.22);
uniform vec3 stem : source_color = vec3(0.18, 0.14, 0.06);

float h1(float x) { return fract(sin(x * 91.17) * 43758.5453); }

void vertex() {
	float t = UV.y / max(UV2.y, 0.1);
	float sway = sin(TIME * 1.1 + UV2.x * 30.0 + UV.y * 0.8) * 0.06 * t * t;
	VERTEX.x += sway;
	VERTEX.z += sway * 0.6;
}

void fragment() {
	float ln = max(UV2.y, 0.1);
	float y = UV.y;
	float t = y / ln;
	float sx = 0.5 + sin(y * 3.0 + UV2.x * 17.0) * 0.08;
	float x = UV.x - sx;
	float a = step(abs(x), 0.05 * (1.0 - t * 0.5));
	vec3 col = stem;
	float fill = 0.0;
	// foglie: una ogni 0.11 m, a destra e a sinistra, inclinate in giÃ¹
	float pitch = 0.11;
	for (int k = -3; k <= 2; k++) {
		float idx = floor(y / pitch) + float(k);
		float side = mod(idx, 2.0) < 1.0 ? -1.0 : 1.0;
		float rnd = h1(idx + UV2.x * 13.0);
		if (rnd < t * 0.45) {
			continue;   // in fondo meno foglie
		}
		float yc = (idx + 0.5) * pitch;
		float size = mix(0.3, 0.46, rnd) * (1.0 - t * 0.35);
		vec2 q = vec2(x * side, y - yc);
		// asse della foglia: in fuori e un po' in giÃ¹
		vec2 ax = normalize(vec2(1.0, 0.45 + rnd * 0.35));
		vec2 lq = vec2(dot(q, ax), dot(q, vec2(-ax.y, ax.x)));
		float u = lq.x / size;
		if (u > 0.0 && u < 1.0) {
			float wdt = sin(pow(u, 0.8) * 3.14159) * 0.42 * size * (1.0 - u * 0.25);
			float inside = step(abs(lq.y), wdt);
			if (inside > 0.5) {
				a = 1.0;
				float vein = 1.0 - smoothstep(0.0, 0.08, abs(lq.y) / max(wdt, 0.001));
				col = mix(mix(leaf_dark, leaf_light, rnd * 0.7 + u * 0.3), leaf_tip, smoothstep(0.55, 1.0, t) * 0.6 * rnd);
				col *= 0.8 + 0.2 * (1.0 - vein);
				fill = 1.0;
			}
		}
	}
	if (a < 0.5) {
		discard;
	}
	ALBEDO = col;
	ROUGHNESS = 0.55;
	SPECULAR = 0.35;
	BACKLIGHT = col * 0.6 * fill;
}
␀␀␀␀␀␀shader_type spatial;
// Hydrocity Zone: le pareti viola di fondo delle sale (scripts/env/gen_hcz/kit.gd), come lo sfondo di
// Sonic 3 (rif. dell'utente: colonne viola, finestre ad arco, fregi rosa con le piastrelline verde
// acqua), rifatte col rilievo vero alla maniera dei Sonic in 3D di oggi. Coordinate del mondo: u in
// orizzontale lungo la parete, v = quota. Si ripete ogni 12 m in altezza e ogni 4 m in larghezza:
//   0-1.6 squame a file sfalsate, 1.6-2 cornice, 2-8.2 la campata (lesena scanalata col capitello a
//   ventaglio, due finestre alte con la cima tonda: dietro, la luce lilla e in controluce le colonne
//   di una sala lontana, in parallasse), 8.2-9 cornice, 9-10.4 fregio a blocchi rosa e piastrelline
//   verdi, 10.4-12 squame piÃ¹ chiare.
// Rilievo da un'altezza (hcz_common: bump_normal), sporco che cola, l'acqua (bagnato, caustiche).
// dim: 1 le pareti vicine, meno quelle lontane (il fondo si perde nel buio).
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/hcz/hcz_common.gdshaderinc"

uniform vec3 deep : source_color = vec3(0.10, 0.04, 0.20);
uniform vec3 mid : source_color = vec3(0.27, 0.11, 0.46);
uniform vec3 bright : source_color = vec3(0.50, 0.28, 0.80);
uniform vec3 magenta : source_color = vec3(0.68, 0.22, 0.50);
uniform vec3 pink : source_color = vec3(0.96, 0.56, 0.62);
uniform vec3 teal : source_color = vec3(0.22, 0.62, 0.62);
uniform vec3 slit : source_color = vec3(0.92, 0.84, 1.0);
uniform vec3 col_grime : source_color = vec3(0.06, 0.03, 0.08);
uniform vec3 col_moss : source_color = vec3(0.10, 0.22, 0.10);
uniform float y0 = 0.0;
uniform float dim = 1.0;
uniform float glow = 1.6;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

// squame: archetti sfalsati larghi w e alti hh; torna (bordo 0..1, dentro, altezza)
vec3 scales(vec2 p, float w, float hh) {
	float r = floor(p.y / hh);
	float o = mod(r, 2.0) * 0.5;
	vec2 f = vec2(fract(p.x / w + o) - 0.5, fract(p.y / hh));
	float d = length(vec2(f.x, (f.y - 0.05) * (hh / w)));
	float rim = smoothstep(0.36, 0.43, d) * (1.0 - smoothstep(0.47, 0.53, d));
	float inside = 1.0 - smoothstep(0.40, 0.46, d);
	// ogni squama Ã¨ bombata: alta in basso, si infila sotto la riga di sopra
	float hgt = inside * (0.5 + 0.5 * (1.0 - f.y)) * (1.0 - d * 1.2) + rim * 0.6;
	return vec3(rim, inside * (1.0 - f.y), hgt);
}

// la sala lontana dietro le finestre: luce lilla in fondo, colonne in controluce (parallasse);
// vdir_t: verso la telecamera, nelle coordinate della parete (lungo, su, fuori)
vec3 far_hall(vec2 p, vec3 vdir_t, float depth) {
	vec2 q = p - vdir_t.xy / max(vdir_t.z, 0.15) * depth;
	float colx = abs(fract(q.x / 1.1) - 0.5) * 1.1;
	float column = 1.0 - smoothstep(0.14, 0.2, colx);
	float haze = 0.55 + 0.45 * smoothstep(0.0, 6.0, q.y - 2.0);
	vec3 c = slit * haze;
	return mix(c, deep * 1.4, column * 0.85);
}

void fragment() {
	vec3 n = normalize(wn);
	bool xface = abs(n.x) > abs(n.z);
	float u = xface ? wp.z * sign(n.x) : -wp.x * sign(n.z);
	vec3 tu = xface ? vec3(0.0, 0.0, sign(n.x)) : vec3(-sign(n.z), 0.0, 0.0);
	float vv = wp.y - y0;
	vec2 p = vec2(u, vv);
	float v = mod(p.y, 12.0);
	float bu = mod(p.x, 4.0);
	vec3 col = deep;
	vec3 emi = vec3(0.0);
	float H = 0.0;
	float rough = 0.7;
	float spec = 0.3;
	float ao = 1.0;
	if (v < 1.6) {
		vec3 s = scales(p, 0.6, 0.4);
		col = mix(mid * 0.8, bright * 0.9, s.x);
		col = mix(col, deep * 1.3, s.y * 0.4);
		H = s.z * 0.05;
		ao = 0.6 + 0.4 * s.z;
		rough = 0.45;
	} else if (v < 2.0 || (v >= 8.2 && v < 9.0)) {
		float c0 = v < 2.0 ? 1.6 : 8.2;
		float ch = v < 2.0 ? 0.4 : 0.8;
		float l = (v - c0) / ch;
		// cornice: modanature (toro, listello, gola)
		float prof = 0.5 + 0.5 * cos(l * 6.2832 * (v < 2.0 ? 2.0 : 3.0));
		col = mix(mid, bright * 0.9, prof);
		H = 0.08 + prof * 0.04;
		ao = 0.7 + 0.3 * prof;
		rough = 0.4;
		spec = 0.45;
	} else if (v < 8.2) {
		// fondo della campata: squame scure, incassate
		vec3 s = scales(p, 0.5, 0.36);
		col = mix(deep * 0.9, mid * 0.55, s.x * 0.8);
		H = s.z * 0.03 - 0.04;
		ao = 0.55 + 0.35 * s.z;
		// due finestre con la cima tonda: strombatura, dentro la sala lontana
		vec3 vt = vec3(dot(VIEW, (VIEW_MATRIX * vec4(tu, 0.0)).xyz), dot(VIEW, (VIEW_MATRIX * vec4(0.0, 1.0, 0.0, 0.0)).xyz), dot(VIEW, NORMAL));
		for (int i = 0; i < 2; i++) {
			float cx = 1.95 + float(i) * 0.8;
			float dx = abs(bu - cx);
			float top = 6.6;
			float dwin = v < top ? max(dx - 0.13, 3.3 - v) : length(vec2(dx, (v - top) * 0.9)) - 0.13;
			float aa = fwidth(dwin) + 0.003;
			float m = 1.0 - smoothstep(-aa, aa, dwin);
			float fr = 1.0 - smoothstep(0.0, 0.09, dwin);
			col = mix(col, bright * 0.65, fr * (1.0 - m));
			H = mix(H, 0.03 - fr * 0.05, fr * (1.0 - m));
			vec3 far = far_hall(vec2(bu - cx, v), vt, 2.5);
			col = mix(col, far * 0.25, m);
			emi += far * m * glow;
			H = mix(H, -0.1, m);
		}
		// lesena scanalata, in fuori
		if (bu < 0.7) {
			float fl = 0.5 + 0.5 * cos(bu / 0.7 * 6.2832 * 3.0);
			float edge = smoothstep(0.0, 0.06, bu) * (1.0 - smoothstep(0.64, 0.7, bu));
			col = mix(mid, bright, 0.35 + fl * 0.45);
			H = 0.12 * edge - (1.0 - fl) * 0.025;
			ao = 0.7 + 0.3 * fl;
			rough = 0.38;
			spec = 0.5;
		}
		// capitello a ventaglio sopra la lesena
		if (v > 7.4) {
			float cu = bu < 2.0 ? bu : bu - 4.0;
			float k = (v - 7.4) / 0.8;
			float wdt = 0.35 + k * 0.45;
			if (abs(cu - 0.35) < wdt) {
				float rays = 0.5 + 0.5 * cos((cu - 0.35) / (0.12 + k * 0.1) * 6.2832);
				col = mix(mid, bright, 0.45 + 0.4 * rays);
				H = 0.1 + rays * 0.03 * k;
				ao = 0.75 + 0.25 * rays;
				rough = 0.38;
				spec = 0.5;
			}
		}
	} else if (v < 10.4) {
		// fregio: blocchi rosa e magenta, piastrelline verde acqua smaltate
		float bx = mod(p.x, 2.0);
		float by = v - 9.0;
		float band = step(0.35, by) * step(by, 1.05);
		col = mix(magenta, pink, band * 0.6);
		H = 0.06 + band * 0.02;
		rough = 0.5;
		if (bx > 0.7 && bx < 1.3 && by > 0.3 && by < 1.1) {
			col = teal;
			float g = (1.0 - smoothstep(0.03, 0.05, abs(bx - 1.0))) + (1.0 - smoothstep(0.03, 0.05, abs(by - 0.7))) * step(abs(bx - 1.0), 0.18);
			col = mix(col, deep, clamp(g, 0.0, 1.0));
			H = 0.07 - clamp(g, 0.0, 1.0) * 0.02;
			rough = 0.18;
			spec = 0.6;
		}
		float ed = min(min(by, 1.4 - by), min(bx, 2.0 - bx));
		float edge = 1.0 - smoothstep(0.04, 0.09, ed);
		col = mix(col, deep * 1.2, edge);
		H -= edge * 0.04;
		ao = 1.0 - edge * 0.4;
	} else {
		vec3 s = scales(p, 0.7, 0.45);
		col = mix(mid, bright, s.x);
		col = mix(col, magenta * 0.6, s.y * 0.35);
		H = s.z * 0.05;
		ao = 0.6 + 0.4 * s.z;
		rough = 0.45;
	}
	// pietra: grana e sporco che cola dalle cornici
	float grain = vnoise(p * 6.0);
	float streak = smoothstep(0.45, 0.95, vnoise(vec2(p.x * 3.0, p.y * 0.25)));
	float stain = vnoise(vec2(p.x * 0.4, p.y * 0.15) + 5.0);
	col *= 0.9 + 0.2 * grain;
	col = mix(col, col_grime, clamp(streak * 0.35 + (stain - 0.4) * 0.6, 0.0, 0.6));
	H += grain * 0.004;
	rough = mix(rough, 0.85, streak * 0.4);
	vec4 wl = water_light(wp, n, TIME);
	col = mix(col, col_moss, wl.z * 0.7);
	float sub = wl.w;
	col *= mix(1.0, 0.65, wl.y * (1.0 - sub * 0.8));
	rough = mix(rough, 0.15, wl.y);
	vec3 nb = bump_normal(n, wp, H, 1.0);
	NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
	ALBEDO = col * dim * 0.82;
	EMISSION = (emi + col * (wl.x * vec3(0.6, 0.95, 0.95) * 1.2 + UNDER_LIGHT * sub * 0.6)) * dim;
	ROUGHNESS = rough;
	SPECULAR = spec;
	AO = ao;
	AO_LIGHT_AFFECT = 0.3;
}
␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Hydrocity Zone: il pelo dell'acqua delle sale (verde acqua come in Sonic 3), alla maniera dei Sonic
// in 3D di oggi:
//   - onde vere nella normale (quattro treni d'onde e il rumore fine), nessun "pixel";
//   - rifrazione: sotto si vede il fondo (la schermata giÃ  disegnata), spostato dalle onde e sempre piÃ¹
//     verde acqua con la profonditÃ  (assorbimento);
//   - riflesso: le pareti viola, le colonne e le cascate specchiate (riflessi in screen space: si
//     cammina lungo il raggio riflesso sulla profonditÃ  della schermata), piÃ¹ forte di sbieco
//     (Fresnel); dove il raggio esce dallo schermo, il viola scuro del soffitto;
//   - schiuma dove l'acqua tocca i piloni e le sponde (poca profonditÃ ), le linee chiare che scorrono
//     (quelle del gioco originale, morbide), il luccichio del sole dalla luce vera;
//   - visto da sotto (telecamera sott'acqua) la faccia posteriore: la finestra sul mondo di sopra e,
//     di sbieco, lo specchio verde acqua del pelo.
// flow: verso dove scorre (m/s), per le correnti e gli scivoli; opacity: 0 acqua limpida, 1 piena (gli
// scivoli: il fondo del canale non si vede). swirl: il vortice del mini-boss (hcz_miniboss.gd).
render_mode blend_mix, depth_draw_always, cull_disabled, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/hcz/hcz_common.gdshaderinc"

uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap, repeat_disable;
uniform sampler2D depth_tex : hint_depth_texture, filter_nearest, repeat_disable;

uniform vec3 col_a : source_color = vec3(0.02, 0.22, 0.27);      // fondo (acqua profonda)
uniform vec3 col_b : source_color = vec3(0.30, 0.86, 0.78);      // linee chiare e acqua bassa
uniform vec3 under : source_color = vec3(0.24, 0.70, 0.74);      // lo specchio visto da sotto
uniform vec3 sky_refl : source_color = vec3(0.10, 0.05, 0.20);   // quel che si specchia fuori schermo
uniform vec3 foam_col : source_color = vec3(0.86, 0.98, 1.0);
uniform float alpha = 0.8;              // (vecchio: non piÃ¹ usato, si tiene per le scene salvate)
uniform float opacity = 0.0;
uniform float absorb = 0.22;            // per metro di profonditÃ 
uniform float refraction = 0.12;
uniform float wave = 1.0;
uniform vec2 flow = vec2(0.0, 0.0);
uniform float swirl = 0.0;          // vortice del mini-boss: 0 spento, 1 pieno
uniform vec3 swirl_c = vec3(0.0);   // centro del vortice (mondo)

varying vec3 wp;

void vertex() {
	vec3 w = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float h = sin(w.x * 0.6 + TIME * 1.3) * 0.04 + sin(w.z * 0.8 - TIME * 1.1) * 0.04;
	VERTEX.y += h * wave;
	wp = w;
}

float lin_depth(vec2 uv, mat4 inv_proj) {
	float d = textureLod(depth_tex, uv, 0.0).r;
	vec4 v = inv_proj * vec4(uv * 2.0 - 1.0, d, 1.0);
	return -v.z / v.w;
}

// pendenza del pelo (d altezza / d x, d altezza / d z) in p, al tempo t
vec2 slope(vec2 p, float t) {
	vec2 g = vec2(0.0);
	vec4 dirs[4] = vec4[](vec4(0.8, 0.6, 0.55, 1.1), vec4(-0.5, 0.86, 0.9, -1.3), vec4(0.2, -0.98, 1.7, 1.7), vec4(-0.9, -0.3, 2.6, -2.2));
	float amps[4] = float[](0.06, 0.04, 0.022, 0.012);
	for (int i = 0; i < 4; i++) {
		vec2 d = normalize(dirs[i].xy);
		float k = dirs[i].z;
		float ph = dot(d, p) * k + t * dirs[i].w;
		g += d * k * amps[i] * cos(ph);
	}
	// rumore fine che scorre
	vec2 q = p * 3.0 + vec2(t * 0.35, -t * 0.25);
	float e = 0.05;
	float n0 = vnoise(q);
	g += vec2(vnoise(q + vec2(e, 0.0)) - n0, vnoise(q + vec2(0.0, e)) - n0) / e * 0.012;
	return g;
}

void fragment() {
	vec2 p = wp.xz - flow * TIME;
	if (swirl > 0.0) {
		vec2 d = wp.xz - swirl_c.xz;
		float r = length(d);
		float ang = atan(d.y, d.x) + swirl * (TIME * 3.0 + 6.0 / (r + 1.0));
		float k = swirl * (1.0 - smoothstep(4.0, 14.0, r));
		p = mix(p, vec2(cos(ang), sin(ang)) * r * 1.3, k);
	}
	vec2 g = slope(p, TIME) * wave;
	vec3 nw = normalize(vec3(-g.x, 1.0, -g.y));
	// linee chiare che scorrono (quelle del gioco originale)
	float w1 = sin(p.x * 1.7 + sin(p.y * 0.9 + TIME * 0.7) * 1.6 + TIME * 0.9);
	float w2 = sin(p.y * 2.3 + sin(p.x * 1.3 - TIME * 0.6) * 1.4 - TIME * 0.8);
	float lines = smoothstep(0.86, 0.97, w1) + smoothstep(0.9, 0.985, w2) * 0.7;
	float zf = -VERTEX.z;
	vec3 nv = normalize((VIEW_MATRIX * vec4(FRONT_FACING ? nw : -nw, 0.0)).xyz);
	// rifrazione: la schermata dietro, spostata dalle onde (non se dietro c'Ã¨ qualcosa davanti all'acqua)
	// con l'MSAA la profonditÃ  della schermata non c'Ã¨ (Godot 4.3): acqua profonda 6 m lungo la vista,
	// niente schiuma, riflesso a distanza fissa
	bool has_depth = textureLod(depth_tex, SCREEN_UV, 0.0).r > 0.0;
	float zs = has_depth ? lin_depth(SCREEN_UV, INV_PROJECTION_MATRIX) : zf + 6.0;
	float thick = max(zs - zf, 0.0);
	vec2 ruv = SCREEN_UV + vec2(g.x, -g.y) * refraction * smoothstep(0.0, 1.5, thick) / max(zf * 0.08, 1.0);
	float zr = has_depth ? lin_depth(ruv, INV_PROJECTION_MATRIX) : zs;
	if (zr < zf) {
		ruv = SCREEN_UV;
		zr = zs;
	}
	float thick_r = max(zr - zf, 0.0);
	vec3 behind = textureLod(screen_tex, ruv, 0.0).rgb;
	vec3 col;
	float fres = 0.02 + 0.98 * pow(1.0 - clamp(dot(nv, VIEW), 0.0, 1.0), 5.0);
	if (FRONT_FACING) {
		// quanto si va giÃ¹ in verticale lungo la vista (per l'assorbimento)
		float vdown = thick_r * clamp(abs(dot(VIEW, (VIEW_MATRIX * vec4(0.0, 1.0, 0.0, 0.0)).xyz)), 0.2, 1.0);
		float tr = exp(-vdown * absorb) * (1.0 - opacity);
		vec3 body = mix(col_a, col_b, 0.18 + 0.25 * exp(-vdown * 0.08));
		col = mix(body, behind * mix(vec3(1.0), col_b * 1.3, 0.55), tr);
		// riflesso in screen space: si cammina lungo il raggio riflesso
		vec3 rd = reflect(-VIEW, nv);
		vec3 refl = sky_refl;
		float hit = 0.0;
		if (!has_depth) {
			vec3 rp = VERTEX + rd * (8.0 + zf * 0.35);
			vec4 c = PROJECTION_MATRIX * vec4(rp, 1.0);
			vec2 suv = c.xy / c.w * 0.5 + 0.5;
			vec2 edge = min(suv, 1.0 - suv);
			hit = c.w > 0.0 ? smoothstep(0.0, 0.1, min(edge.x, edge.y)) * 0.85 : 0.0;
			refl = mix(sky_refl, textureLod(screen_tex, clamp(suv, 0.0, 1.0), 0.0).rgb, hit);
		} else if (rd.z < 0.95) {
			vec3 rp = VERTEX;
			float stp = 0.35;
			for (int i = 0; i < 18; i++) {
				rp += rd * stp;
				stp *= 1.28;
				vec4 c = PROJECTION_MATRIX * vec4(rp, 1.0);
				vec2 suv = c.xy / c.w * 0.5 + 0.5;
				if (suv.x < 0.0 || suv.y < 0.0 || suv.x > 1.0 || suv.y > 1.0 || c.w < 0.0) {
					break;
				}
				float sz = lin_depth(suv, INV_PROJECTION_MATRIX);
				float rz = -rp.z;
				if (rz > sz && rz - sz < stp * 2.5 + 0.5) {
					// stretta finale a metÃ  del passo
					vec3 a = rp - rd * stp / 1.28;
					vec3 b = rp;
					for (int j = 0; j < 4; j++) {
						vec3 m = (a + b) * 0.5;
						vec4 cm = PROJECTION_MATRIX * vec4(m, 1.0);
						vec2 muv = cm.xy / cm.w * 0.5 + 0.5;
						if (-m.z > lin_depth(muv, INV_PROJECTION_MATRIX)) {
							b = m;
						} else {
							a = m;
						}
					}
					vec4 cb = PROJECTION_MATRIX * vec4(b, 1.0);
					suv = cb.xy / cb.w * 0.5 + 0.5;
					vec2 edge = min(suv, 1.0 - suv);
					hit = smoothstep(0.0, 0.08, min(edge.x, edge.y)) * (1.0 - float(i) / 18.0 * 0.5);
					refl = mix(sky_refl, textureLod(screen_tex, suv, 0.0).rgb, hit);
					break;
				}
			}
		}
		float fr = clamp(fres * 0.85 + 0.12, 0.0, 1.0);
		col = mix(col, refl, fr);
		// schiuma dove Ã¨ bassa (contro i piloni e le sponde)
		float foam_n = fbm(p * 2.2 + vec2(TIME * 0.2, 0.0));
		float foam = (1.0 - smoothstep(0.0, 0.55 + foam_n * 0.4, thick)) * smoothstep(0.3, 0.6, foam_n + 0.25);
		foam += (1.0 - smoothstep(0.0, 0.12, thick)) * 0.8;
		foam *= has_depth ? 1.0 : 0.0;
		col = mix(col, foam_col, clamp(foam, 0.0, 1.0) * 0.85);
		col += col_b * lines * 0.22 * (1.0 - fr * 0.5);
	} else {
		// da sotto: la finestra sul mondo di sopra, di sbieco lo specchio verde acqua
		float c = clamp(dot(nv, VIEW), 0.0, 1.0);
		float win = smoothstep(0.62, 0.85, c);
		// fuori dalla finestra: riflessione totale, lo specchio del fondo (a distanza fissa)
		vec3 rd = reflect(-VIEW, nv);
		vec4 cr = PROJECTION_MATRIX * vec4(VERTEX + rd * (6.0 + zf * 0.3), 1.0);
		vec2 suv = clamp(cr.xy / cr.w * 0.5 + 0.5, 0.0, 1.0);
		vec3 mirror = textureLod(screen_tex, suv, 0.0).rgb * vec3(0.55, 0.9, 0.9) + under * 0.12;
		col = mix(mirror, behind * vec3(0.8, 1.0, 1.0) + under * 0.1, win);
		col += under * lines * 0.18;
	}
	NORMAL = nv;
	ALBEDO = vec3(0.0);
	EMISSION = col;
	ROUGHNESS = 0.06;
	SPECULAR = 0.5;
	ALPHA = 1.0;
}
␀␀␀␀␀␀␀␀shader_type spatial;
// Hydrocity Zone: le cascate (scripts/env/gen_hcz/kit.gd), alla maniera dei Sonic in 3D di oggi:
// acqua che cade a fili (rumore stirato in verticale che scende a velocitÃ  diverse, due strati), piÃ¹
// veloce e piÃ¹ bianca man mano che scende, il bordo che si sfrangia ai lati, la schiuma bianca sul
// labbro in cima e in fondo (dove sotto ci sono la nebbiolina e gli spruzzi: kit.gd). Colori del rif.
// dell'utente: azzurro e bianco. UV.x = metri di traverso, UV.y = metri di caduta dall'alto;
// UV2.x = altezza totale, UV2.y = larghezza (0: bordi non sfrangiati).
render_mode blend_mix, depth_draw_never, cull_disabled, diffuse_burley, specular_schlick_ggx, shadows_disabled;

#include "res://shaders/env/hcz/hcz_common.gdshaderinc"

uniform vec3 col_a : source_color = vec3(0.30, 0.62, 0.95);
uniform vec3 col_b : source_color = vec3(0.88, 0.96, 1.0);
uniform vec3 col_c : source_color = vec3(0.08, 0.32, 0.64);
uniform float speed = 9.0;
uniform float alpha = 0.82;

void fragment() {
	float x = UV.x;
	float y = UV.y;
	float hgt = max(UV2.x, 0.1);
	float k = clamp(y / hgt, 0.0, 1.0);
	float sp = speed;
	// due strati di fili: larghi e lenti, fini e veloci
	float s1 = fbm(vec2(x * 1.6, (y - TIME * sp) * 0.12));
	float s2 = fbm(vec2(x * 4.5 + 13.0, (y - TIME * sp * 1.35) * 0.22));
	float streak = s1 * 0.6 + s2 * 0.4;
	vec3 col = mix(col_c, col_a, smoothstep(0.3, 0.55, streak));
	col = mix(col, col_b, smoothstep(0.55, 0.75, streak) * (0.5 + 0.5 * k));
	float a = alpha * mix(0.55, 1.0, smoothstep(0.25, 0.6, streak));
	// labbro in cima e schiuma in fondo
	float lip = 1.0 - smoothstep(0.0, 0.9, y);
	float base = smoothstep(hgt - 3.0, hgt, y);
	float churn = fbm(vec2(x * 2.0, y * 0.8 - TIME * 3.0));
	col = mix(col, col_b, clamp(lip * 0.8 + base * (0.5 + 0.5 * churn), 0.0, 1.0));
	a = clamp(a + lip * 0.2 + base * 0.25, 0.0, 1.0);
	// bordi sfrangiati
	float wdt = UV2.y;
	a *= smoothstep(0.0, 0.5 + 0.4 * s2, x) * (wdt > 0.0 ? smoothstep(0.0, 0.5 + 0.4 * s1, wdt - x) : 1.0);
	ALBEDO = col;
	EMISSION = col * (0.35 + 0.25 * k);
	ROUGHNESS = 0.15;
	SPECULAR = 0.6;
	ALPHA = a;
}
␀␀␀␀␀␀␀␀␀shader_type spatial;
// Ice Cap Zone: l'acqua gelida del lago (il canale fra le rive, sotto le lastre di ghiaccio). Opaca come
// gli altri materiali della zona (niente lettura dello schermo nÃ© della profonditÃ ): verde-blu scuro
// che schiarisce verso la riva, le increspature col rumore che scorre (normale finta), il riflesso
// finto del cielo dell'alba (icz_sky_refl) col Fresnel, qualche scaglia di ghiaccio che galleggia.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/icz/icz_common.gdshaderinc"

uniform vec3 deep_col : source_color = vec3(0.02, 0.10, 0.16);
uniform vec3 shallow_col : source_color = vec3(0.10, 0.34, 0.42);
uniform float ripple = 0.35;
uniform float flow = 0.25;

varying vec3 wp;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 p = wp.xz;
	float t = TIME * flow;
	// increspature: due strati di rumore che scorrono in versi diversi
	float h1 = icz_fbm(p * 0.35 + vec2(t, t * 0.6));
	float h2 = icz_fbm(p * 0.9 - vec2(t * 0.8, -t * 0.4));
	vec2 e = vec2(0.15, 0.0);
	float hx = icz_fbm((p + e.xy) * 0.35 + vec2(t, t * 0.6)) - h1;
	float hz = icz_fbm((p + e.yx) * 0.35 + vec2(t, t * 0.6)) - h1;
	vec3 nw = normalize(vec3(-hx * ripple * 6.0, 1.0, -hz * ripple * 6.0) + vec3(h2 - 0.5, 0.0, 0.5 - h2) * ripple * 0.25);
	NORMAL = normalize((VIEW_MATRIX * vec4(nw, 0.0)).xyz);
	// le scaglie di ghiaccio che galleggiano (celle di Voronoi, poche)
	vec3 vo = icz_voronoi(p * 0.22 + vec2(t * 0.3, 0.0));
	float flake = smoothstep(0.09, 0.05, vo.x) * step(0.82, icz_hash(vo.yz * 13.1));
	vec3 V = normalize((INV_VIEW_MATRIX * vec4(VIEW, 0.0)).xyz);
	float fr = pow(1.0 - clamp(dot(nw, V), 0.0, 1.0), 4.0);
	vec3 R = reflect(-V, nw);
	vec3 col = mix(deep_col, shallow_col, h1 * 0.6);
	ALBEDO = mix(col, vec3(0.85, 0.93, 1.0), flake);
	ROUGHNESS = mix(0.32, 0.6, flake);
	SPECULAR = 0.35;
	EMISSION = icz_sky_refl(R) * fr * 0.55 * (1.0 - flake);
}
␀␀␀␀shader_type sky;
// Ice Cap Zone: il cielo dell'alba sulla montagna. In alto il blu intenso di Sonic 3, verso l'orizzonte
// l'azzurro che scalda in rosa e oro dalla parte del sole (basso, davanti: si scende verso +X); qualche
// velo di nuvole accese di rosa da sotto; tutto attorno due file di picchi innevati (la lontana chiara
// nella foschia azzurra, la vicina con le creste accese di rosa dalla parte del sole e i versanti in
// ombra blu), sotto un mare di nebbia bianca nelle valli. La fascia rosa pesca dell'alba gira tutto
// attorno all'orizzonte (piÃ¹ forte e piÃ¹ dorata dalla parte del sole).
// Tutto fermo (niente TIME): la radianza si calcola una volta sola (ricetta Â§2). Il disco del sole solo
// fuori dalla passata cubemap, con un valore basso (sotto il tetto del bagliore: niente alone enorme).

uniform vec3 zenith : source_color = vec3(0.03, 0.14, 0.52);
uniform vec3 mid : source_color = vec3(0.14, 0.40, 0.86);
uniform vec3 horizon : source_color = vec3(0.66, 0.80, 0.96);
uniform vec3 dawn : source_color = vec3(1.0, 0.62, 0.38);
uniform vec3 dawn_pink : source_color = vec3(1.0, 0.62, 0.60);
uniform sampler2D cloud_noise : filter_linear_mipmap, repeat_enable;
uniform float cloud_cover = 0.62;
uniform vec3 far_range : source_color = vec3(0.54, 0.66, 0.90);
uniform vec3 near_snow : source_color = vec3(0.92, 0.94, 0.98);
uniform vec3 near_shade : source_color = vec3(0.30, 0.44, 0.78);
uniform vec3 ridge_lit : source_color = vec3(1.0, 0.80, 0.74);
uniform vec3 mist : source_color = vec3(0.84, 0.90, 0.99);

float ridge(float az, float seed) {
	float h = 0.0;
	float amp = 1.0;
	float f = 3.0;
	for (int i = 0; i < 5; i++) {
		float s = sin(az * f + seed * (1.7 + float(i)));
		h += (1.0 - abs(s)) * amp;
		amp *= 0.5;
		f *= 2.13;
	}
	return h / 1.94;
}

void sky() {
	vec3 d = normalize(EYEDIR);
	float y = d.y;
	vec3 L = LIGHT0_DIRECTION;
	float sd = dot(d, L);
	float toward = max(dot(normalize(d.xz + vec2(0.0001)), normalize(L.xz + vec2(0.0001))), 0.0);
	float t1 = pow(clamp(y, 0.0, 1.0), 0.5);
	vec3 col = mix(horizon, mid, smoothstep(0.0, 0.4, t1));
	col = mix(col, zenith, smoothstep(0.35, 1.0, t1));
	// l'alba: fascia calda bassa dalla parte del sole, rosa piÃ¹ in alto e piÃ¹ di lato
	float band = 1.0 - smoothstep(0.0, 0.32, y);
	col = mix(col, dawn_pink, band * (0.22 + 0.5 * pow(toward, 2.0)));
	col = mix(col, dawn, band * pow(toward, 4.0) * (1.0 - smoothstep(0.0, 0.16, y)) * 0.8);
	col += dawn * (pow(max(sd, 0.0), 10.0) * 0.25 + pow(max(sd, 0.0), 120.0) * 0.6);
	if (!AT_CUBEMAP_PASS && sd > 0.9994) {
		col += vec3(2.6, 2.2, 1.7) * smoothstep(0.9994, 0.9996, sd);
	}
	// veli di nuvole alte, accesi di rosa dalla parte del sole
	if (y > 0.02) {
		vec2 uv = d.xz / (y + 0.15) * 0.18;
		float c = texture(cloud_noise, uv * 0.7).r * 0.65 + texture(cloud_noise, uv * 2.1 + 0.37).r * 0.35;
		float dens = smoothstep(cloud_cover, cloud_cover + 0.22, c) * smoothstep(0.03, 0.2, y);
		vec3 cl = mix(vec3(0.86, 0.90, 0.98), mix(vec3(1.0, 0.86, 0.84), dawn, 0.4), pow(toward, 3.0) * 0.8);
		col = mix(col, cl, dens * 0.8);
	}
	// le montagne
	float az = atan(d.z, d.x);
	float hf = 0.03 + 0.10 * ridge(az, 2.3);
	float hn = 0.012 + 0.075 * ridge(az + 0.9, 5.1) * (0.55 + 0.45 * sin(az * 2.0 + 0.4));
	if (y < hf) {
		vec3 fr = mix(far_range, horizon, 0.3 + 0.4 * (1.0 - smoothstep(0.0, hf, y)));
		fr = mix(fr, ridge_lit, smoothstep(hf * 0.75, hf, y) * pow(toward, 2.0) * 0.35);
		col = mix(fr, col, smoothstep(hf - 0.002, hf, y));
	}
	if (y < hn) {
		float k = clamp(y / max(hn, 0.001), 0.0, 1.0);
		// versanti: una faccia al sole (neve rosa), l'altra in ombra blu; il confine segue le creste
		float face = sin(az * 37.0 + ridge(az * 3.0, 1.1) * 6.0);
		vec3 nr = mix(near_shade, near_snow, smoothstep(-0.2, 0.4, face) * (0.4 + 0.6 * toward));
		nr = mix(nr, ridge_lit, smoothstep(0.75, 1.0, k) * (0.25 + 0.5 * toward));
		nr = mix(nr, horizon, 0.2 * (1.0 - k));
		col = mix(nr, col, smoothstep(hn - 0.0015, hn, y));
	}
	// nebbia nelle valli: sotto l'orizzonte bianca azzurra
	col = mix(col, mist, 1.0 - smoothstep(-0.12, 0.012, y));
	COLOR = col;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Ice Cap Zone: i cristalli (nelle pareti delle grotte, il geode, il Dente di Ghiaccio, gli ostacoli
// della discesa, lo scudo del mini-boss). Facce piatte (la mesh ha le normali per faccia), il colore
// ciano o blu (lilla solo su pochi cristalli piccoli) che si accende verso il centro e sul bordo (Fresnel), una venatura interna che si
// sposta con la vista. La luce propria scende da vicino (near_k, come i neon di Eggmanland: un cristallo
// che passa davanti alla camera non fa bande bianche col bagliore) e resta sotto la soglia del bagliore
// da lontano (energy).
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/icz/icz_common.gdshaderinc"

uniform vec3 color : source_color = vec3(0.62, 0.94, 1.0);
uniform vec3 deep : source_color = vec3(0.10, 0.30, 0.62);
uniform float energy = 0.9;
uniform float near_k = 0.4;
uniform float near_d = 3.0;
uniform float far_d = 30.0;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wn);
	vec3 V = normalize((INV_VIEW_MATRIX * vec4(VIEW, 0.0)).xyz);
	float nv = clamp(dot(n, V), 0.0, 1.0);
	float fres = pow(1.0 - nv, 2.5);
	vec3 inner_p = wp - V * 0.6;
	float vein = icz_noise(inner_p.xy * 2.2 + inner_p.z * 1.3);
	vein = smoothstep(0.55, 0.9, vein);
	vec3 col = mix(deep, color, 0.35 + 0.4 * nv * nv + vein * 0.25);
	float d = length(VERTEX);
	float k = mix(near_k, 1.0, smoothstep(near_d, far_d, d));
	ALBEDO = col * 0.55;
	ROUGHNESS = 0.14;
	METALLIC = 0.0;
	SPECULAR = 0.6;
	EMISSION = (color * (0.35 + fres * 0.9 + vein * 0.3)) * energy * k;
}
␀␀␀␀␀shader_type spatial;
// Ice Cap Zone: il ghiaccio (pareti delle grotte, l'arco della bocca, le lastre del lago, le colonne,
// i blocchi da rompere). Niente texture e niente lettura della profonditÃ  (con l'MSAA del preset alto
// non c'Ã¨: niente guai), tutto finto ma con la luce vera:
//   - celle di Voronoi a tre piani in coordinate del mondo: le crepe chiare fra le celle, ogni cella un
//     filo diversa di colore;
//   - la profonditÃ  finta: due strati di bolle e crepe interne campionati piÃ¹ "dentro" lungo la vista
//     (spostati di V), piÃ¹ scuri e piÃ¹ blu, cosÃ¬ il ghiaccio sembra spesso;
//   - il bordo ciano (Fresnel) e il riflesso finto del cielo dell'alba (icz_sky_refl) nell'emissione;
//   - rugositÃ  bassa ma mai zero (niente puntini bianchi col TAA).
// dim: le grotte (blu profondo) lo abbassano; glow: la luce propria dei pezzi che devono leggersi al buio.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/icz/icz_common.gdshaderinc"

uniform vec3 ice_light : source_color = vec3(0.56, 0.90, 1.0);
uniform vec3 ice_mid : source_color = vec3(0.16, 0.50, 0.80);
uniform vec3 ice_deep : source_color = vec3(0.05, 0.17, 0.40);
uniform float cell = 1.6;
uniform float refl = 0.7;
uniform float depth = 1.0;
uniform float dim = 1.0;
uniform float glow = 0.0;
uniform float snow_top = 0.6;       // neve sulle facce in su (0: niente)

varying vec3 wp;
varying vec3 wn;

vec2 tri_uv(vec3 p, vec3 n) {
	vec3 a = abs(n);
	if (a.y > a.x && a.y > a.z) return p.xz;
	if (a.x > a.z) return vec2(p.z, p.y);
	return vec2(p.x, p.y);
}

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wn);
	vec3 V = normalize((INV_VIEW_MATRIX * vec4(VIEW, 0.0)).xyz);
	vec2 uv = tri_uv(wp, n) / cell;
	vec3 vo = icz_voronoi(uv);
	float crack = 1.0 - smoothstep(0.0, 0.05 + length(fwidth(uv)) * 0.8, vo.y);
	float H = -crack * 0.02 + vo.x * 0.04;
	vec3 col = mix(ice_mid, ice_light, 0.25 + vo.z * 0.35);
	// strati interni: piÃ¹ dentro (lungo la vista), piÃ¹ scuri
	vec3 inner = vec3(0.0);
	for (int i = 1; i <= 2; i++) {
		float k = float(i) * 0.35 * depth;
		vec2 iuv = tri_uv(wp - V * k, n) / (cell * (0.7 + 0.25 * float(i)));
		vec3 vi = icz_voronoi(iuv + float(i) * 7.3);
		float ic = 1.0 - smoothstep(0.0, 0.06, vi.y);
		float bub = smoothstep(0.82, 0.95, icz_noise(iuv * 5.0 + float(i) * 3.0));
		inner += mix(ice_deep, ice_light, 0.5) * (ic * 0.35 + bub * 0.25) / float(i);
	}
	col = mix(col, ice_deep, 0.35 + 0.25 * icz_noise(uv * 0.4)) + inner * 0.6;
	col += vec3(0.75, 0.95, 1.0) * crack * 0.35;
	// un velo di neve sulle facce in su
	float snowy = smoothstep(0.55, 0.85, n.y + (icz_noise(wp.xz * 0.7) - 0.5) * 0.4) * snow_top;
	col = mix(col, vec3(0.82, 0.86, 0.96), snowy);
	vec3 nb = icz_bump(n, wp, H, 1.0);
	vec3 R = reflect(-V, nb);
	float fres = pow(1.0 - clamp(dot(nb, V), 0.0, 1.0), 3.0);
	vec3 rf = icz_sky_refl(R) * (0.12 + 0.88 * fres) * refl * (1.0 - snowy);
	NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
	ALBEDO = col * dim;
	ROUGHNESS = mix(0.12, 0.6, snowy) + crack * 0.2;
	SPECULAR = 0.55;
	AO = 1.0 - crack * 0.3;
	AO_LIGHT_AFFECT = 0.25;
	EMISSION = (rf * dim + ice_light * fres * 0.18 * dim + ice_light * glow * (0.4 + inner.b)) * (1.0 - snowy * 0.8);
}
␀// Ice Cap Zone: i pezzi in comune degli shader della montagna (neve, ghiaccio, cristallo, roccia).
//   - rumore (hash, value noise, fbm a tre ottave, Voronoi per le crepe e le celle del ghiaccio);
//   - rilievo dalle derivate (come shaders/env/hcz/hcz_common.gdshaderinc: "surface gradient" da
//     un'altezza H in metri, senza tangenti, in coordinate del mondo);
//   - il riflesso finto del cielo dell'alba (come shaders/env/hcz/prop.gdshader: niente SSR nÃ© sonde):
//     il gradiente del cielo dal vettore riflesso, il sole basso davanti (+X), la neve sotto;
//   - le grotte non hanno un fattore a parte: i loro materiali hanno i colori blu profondo (parametri).

float icz_hash(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

vec2 icz_hash2(vec2 p) {
	return vec2(icz_hash(p), icz_hash(p + vec2(17.3, 41.9)));
}

float icz_noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = icz_hash(i);
	float b = icz_hash(i + vec2(1.0, 0.0));
	float c = icz_hash(i + vec2(0.0, 1.0));
	float d = icz_hash(i + vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float icz_fbm(vec2 p) {
	float s = icz_noise(p) * 0.5;
	p = p * 2.03 + vec2(17.1, 9.3);
	s += icz_noise(p) * 0.25;
	p = p * 2.03 + vec2(17.1, 9.3);
	s += icz_noise(p) * 0.125;
	return s / 0.875;
}

// Voronoi: x = distanza dal centro piÃ¹ vicino, y = distanza dal bordo della cella (crepe), z = id
vec3 icz_voronoi(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	float d1 = 8.0;
	float d2 = 8.0;
	vec2 best = vec2(0.0);
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 g = vec2(float(x), float(y));
			vec2 o = icz_hash2(i + g) * 0.85 + 0.075;
			vec2 r = g + o - f;
			float d = dot(r, r);
			if (d < d1) {
				d2 = d1;
				d1 = d;
				best = i + g;
			} else if (d < d2) {
				d2 = d;
			}
		}
	}
	return vec3(sqrt(d1), sqrt(d2) - sqrt(d1), icz_hash(best));
}

vec3 icz_bump(vec3 n, vec3 p, float h, float k) {
	vec3 dpdx = dFdx(p);
	vec3 dpdy = dFdy(p);
	float hx = dFdx(h) * k;
	float hy = dFdy(h) * k;
	vec3 r1 = cross(dpdy, n);
	vec3 r2 = cross(n, dpdx);
	float det = dot(dpdx, r1);
	vec3 g = sign(det) * (hx * r1 + hy * r2);
	return normalize(abs(det) * n - g);
}

// il cielo dell'alba visto in un riflesso (R nel mondo): zenit blu, orizzonte rosa e oro verso il sole
// (davanti, +X, basso), sotto il bianco azzurro della neve
vec3 icz_sky_refl(vec3 R) {
	vec3 zen = vec3(0.08, 0.26, 0.72);
	vec3 hor = vec3(0.80, 0.82, 0.92);
	vec3 col = mix(hor, zen, smoothstep(0.0, 0.7, R.y));
	float sun = max(dot(normalize(R), normalize(vec3(0.85, 0.22, 0.25))), 0.0);
	col += vec3(1.0, 0.62, 0.42) * pow(sun, 6.0) * 0.6 * (1.0 - smoothstep(0.1, 0.6, R.y));
	col = mix(col, vec3(0.62, 0.72, 0.90), smoothstep(0.02, -0.25, R.y));
	return col;
}
␀␀␀␀␀␀␀␀␀shader_type spatial;
// Ice Cap Zone: il legno dei tronchi di pino caduti sulla pista (props.gd log). Marrone caldo e chiaro
// (si legge sulla neve anche in ombra: prima era la roccia tinta di marrone, quasi nera, con le crepe
// di neve a righe blu). UV dal generatore: x lungo il tronco (m), y attorno (m); sulle facce dei tagli
// x < -0.5 e y = distanza dal centro (gli anelli del legno chiaro).
//   - la corteccia: solchi lunghi lungo il tronco (rumore stirato), placche fra i solchi, nodi;
//   - i tagli: legno chiaro con gli anelli e la corteccia scura sul bordo;
//   - un velo di brina chiara sulle facce che guardano in su (la neve vera sopra la fa props.gd).
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/icz/icz_common.gdshaderinc"

uniform vec3 bark_a : source_color = vec3(0.70, 0.46, 0.27);
uniform vec3 bark_b : source_color = vec3(0.46, 0.28, 0.15);
uniform vec3 wood : source_color = vec3(0.90, 0.74, 0.52);
uniform vec3 frost : source_color = vec3(0.86, 0.93, 1.0);
uniform float rad = 0.55;
// un filo di luce propria calda: in ombra (il sole viene da davanti, si vede la faccia scura) la luce
// azzurra del cielo lo faceva grigio-blu
uniform float warm = 0.16;

varying vec3 wn;

void vertex() {
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wn);
	vec2 uv = UV;
	vec3 col;
	float H;
	float ao = 1.0;
	if (uv.x < -0.5) {
		// il taglio: anelli attorno al centro, corteccia sul bordo
		float r = uv.y;
		float rings = sin((r + icz_noise(vec2(r * 3.0, uv.x * 7.0)) * 0.04) * 70.0) * 0.5 + 0.5;
		col = mix(wood, wood * 0.78, rings * 0.6);
		float edge = smoothstep(rad * 0.82, rad * 0.9, r);
		col = mix(col, bark_b, edge);
		H = rings * 0.004 - edge * 0.01;
	} else {
		// la corteccia: solchi lunghi (lungo x) e placche
		float groove = icz_noise(vec2(uv.x * 0.9, uv.y * 9.0));
		float plate = icz_fbm(vec2(uv.x * 1.6, uv.y * 4.0) + 5.3);
		float cut = smoothstep(0.32, 0.12, groove);
		col = mix(bark_a, bark_b, cut * 0.85) * (0.88 + 0.24 * plate);
		// nodi dei rami
		vec2 kc = vec2(uv.x * 0.7, uv.y * 1.2);
		vec3 kv = icz_voronoi(kc);
		float knot = (1.0 - smoothstep(0.06, 0.16, kv.x)) * step(0.72, kv.z);
		col = mix(col, bark_b * 0.8, knot);
		H = plate * 0.02 - cut * 0.03 - knot * 0.02;
		ao = 1.0 - cut * 0.35;
	}
	vec3 nb = icz_bump(n, (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz, H, 1.0);
	// la brina sulle facce in su (dove la neve vera non arriva)
	col = mix(col, frost, smoothstep(0.35, 0.75, nb.y) * 0.35);
	NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
	ALBEDO = col;
	EMISSION = col * warm;
	ROUGHNESS = 0.85;
	SPECULAR = 0.25;
	AO = ao;
	AO_LIGHT_AFFECT = 0.25;
}
␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Ice Cap Zone: la neve (pendii, cumuli, sponde della pista, la vetta, il lago), come le zone rifatte
// dei Sonic in 3D di oggi: i colori di Sonic 3 (bianco appena azzurro al sole, ombre azzurro cielo: le
// dÃ  la luce fredda di riempimento dal basso, sky.gd; mai lavanda) ma col rilievo vero. Coordinate del
// mondo, niente UV.
//   - cumuli larghi e increspature del vento (rumore stirato di traverso) nel rilievo (icz_bump);
//   - l'albedo mai sopra ~0.85 (con ACES e il bagliore stretto la neve non sbianca lo schermo);
//   - AO nei solchi e alla base dei cumuli; piÃ¹ azzurra e piÃ¹ liscia dove Ã¨ battuta (track = 1: la
//     pista, coi solchi delle tavole lungo la discesa);
//   - i luccichii: pochi punti piccoli che si accendono solo quando il riflesso del sole li prende
//     (girando la testa), sfumati con fwidth e spenti oltre ~20 m (a 360p sembravano pixel morti);
//   - sui fianchi ripidi (sotto i cigli) la neve si dirada e spunta la roccia blu; il ciglio stesso resta
//     di neve (la roccia comincia un po' sotto) e la roccia non scende sotto un minimo di chiaro.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/icz/icz_common.gdshaderinc"

uniform vec3 snow : source_color = vec3(0.86, 0.91, 0.96);
uniform vec3 snow_blue : source_color = vec3(0.58, 0.76, 0.93);
uniform vec3 rock : source_color = vec3(0.22, 0.30, 0.44);
uniform float track = 0.0;          // 1 = neve battuta della pista
uniform float sparkle = 1.0;
uniform float relief = 1.0;
uniform float rock_slope = 0.55;    // sotto questa normale.y spunta la roccia (0: mai)
uniform float tone = 1.0;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wn);
	// sui fianchi ripidi il rumore si prende di lato (proiettato in xz si stirava in righe)
	vec2 q = n.y > 0.7 ? wp.xz : (abs(n.x) > abs(n.z) ? vec2(wp.z, wp.y) : vec2(wp.x, wp.y));
	// cumuli larghi e increspature del vento (soffia di traverso alla discesa: lungo z)
	float dunes = icz_fbm(q * 0.045 + vec2(3.1, 7.7));
	float ripple = sin(wp.x * 2.4 + icz_noise(q * 0.35) * 5.0) * 0.5 + 0.5;
	ripple *= smoothstep(0.35, 0.8, icz_noise(q * 0.08 + 11.0)) * smoothstep(0.6, 0.85, n.y);
	float grain = icz_noise(q * 6.0);
	float H = dunes * 0.6 + ripple * 0.035 * (1.0 - track) + grain * 0.008;
	// la pista: solchi lunghi delle tavole (lungo x), neve piÃ¹ compatta e azzurra
	float grooves = 0.0;
	if (track > 0.5) {
		float g = sin(wp.z * 3.1 + icz_noise(vec2(wp.x * 0.05, wp.z * 0.4)) * 6.0);
		grooves = smoothstep(0.55, 1.0, g) * smoothstep(0.3, 0.7, icz_noise(vec2(wp.x * 0.02, wp.z * 0.25)));
		H -= grooves * 0.03;
	}
	vec3 col = mix(snow, snow_blue, clamp(0.15 + (1.0 - dunes) * 0.55 + track * 0.25 + grooves * 0.2, 0.0, 1.0));
	col *= 0.94 + 0.08 * icz_noise(q * 0.6);
	// fianchi ripidi: la neve si dirada, spunta la roccia (a strati)
	float steep = 1.0 - smoothstep(rock_slope - 0.12, rock_slope + 0.08, n.y + (icz_fbm(q * 0.3 + wp.y * 0.2) - 0.5) * 0.25);
	vec3 rc = rock * (0.85 + 0.4 * icz_fbm(vec2(wp.y * 1.3, (wp.x + wp.z) * 0.15)));
	col = mix(col, rc, steep * step(0.01, rock_slope));
	float ao = mix(0.72, 1.0, smoothstep(0.15, 0.6, dunes)) * (1.0 - grooves * 0.25);
	vec3 nb = icz_bump(n, wp, H, relief);
	// luccichii: punti in una griglia fine, accesi quando il riflesso del sole li prende; sfumati
	// con la grandezza del pixel e con la distanza
	vec3 V = normalize((INV_VIEW_MATRIX * vec4(VIEW, 0.0)).xyz);
	float dist = length(wp - (INV_VIEW_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz);
	vec2 cell = floor(q * 9.0);
	float pick = step(0.965, icz_hash(cell + floor(wp.y * 3.0)));
	vec2 fq = fract(q * 9.0) - 0.5 + (icz_hash2(cell) - 0.5) * 0.5;
	float fw = length(fwidth(q * 9.0));
	float dotm = 1.0 - smoothstep(0.05, 0.05 + fw * 1.2, length(fq));
	vec3 L = normalize(vec3(0.85, 0.32, 0.25));
	// ogni punto ha il suo angolo (la faccia del cristallo di neve): si accende solo lÃ¬
	vec3 nf = normalize(nb + (vec3(icz_hash(cell * 1.7), 0.0, icz_hash(cell * 2.3)) - 0.5) * 0.6);
	float glint = pow(max(dot(reflect(-L, nf), V), 0.0), 60.0);
	float fade = (1.0 - smoothstep(4.0, 20.0, dist)) * (1.0 - smoothstep(0.25, 0.6, fw));
	float spark = pick * dotm * glint * fade * sparkle * (1.0 - steep);
	NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
	ALBEDO = col * tone;
	ROUGHNESS = mix(mix(0.62, 0.42, track), 0.85, steep);
	SPECULAR = 0.35;
	AO = ao;
	AO_LIGHT_AFFECT = 0.3;
	BACKLIGHT = vec3(0.10, 0.16, 0.24) * (1.0 - steep * 0.5);
	EMISSION = vec3(0.9, 0.96, 1.0) * spark * 1.4;
}
␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Ice Cap Zone: la roccia blu scura della montagna (massi, cigli, i fianchi della gola, le pareti
// fuori dalle grotte, i picchi vicini) con la neve appoggiata sopra. Coordinate del mondo a tre piani:
// strati inclinati a bande, crepe a due misure (Voronoi: le grandi ogni ~70 cm, le fini dentro; prima
// una cella sola di 2 m faceva le pareti a piastrelle), la neve che si posa dove la faccia guarda in su
// e si accumula nelle crepe; AO nelle crepe. tone: i pezzi lontani piÃ¹ chiari (foschia) li abbassa
// il generatore.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/icz/icz_common.gdshaderinc"

uniform vec3 rock_a : source_color = vec3(0.26, 0.34, 0.50);
uniform vec3 rock_b : source_color = vec3(0.13, 0.19, 0.31);
uniform vec3 snow : source_color = vec3(0.86, 0.91, 0.96);
uniform float snow_amt = 1.0;
uniform float scale = 1.0;
uniform float tone = 1.0;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wn);
	vec3 a = abs(n);
	vec2 uv = (a.y > a.x && a.y > a.z) ? wp.xz : (a.x > a.z ? vec2(wp.z, wp.y) : vec2(wp.x, wp.y));
	uv *= scale;
	float strata = icz_fbm(vec2(uv.x * 0.12, uv.y * 0.9 + uv.x * 0.18));
	float bands = smoothstep(0.35, 0.65, fract(uv.y * 0.7 + uv.x * 0.12 + strata * 1.5));
	vec3 vo = icz_voronoi(uv * 1.45);
	vec3 vf = icz_voronoi(uv * 4.1 + 7.3);
	float fw = length(fwidth(uv));
	float crack = 1.0 - smoothstep(0.0, 0.06 + fw * 1.1, vo.y);
	float fine = (1.0 - smoothstep(0.0, 0.05 + fw * 3.0, vf.y)) * (1.0 - smoothstep(0.15, 0.4, fw));
	float H = strata * 0.25 + bands * 0.05 + vo.x * 0.06 + vf.x * 0.02 - crack * 0.05 - fine * 0.015 + icz_noise(uv * 4.0) * 0.02;
	vec3 col = mix(rock_b, rock_a, strata * 0.7 + bands * 0.3) * (0.88 + 0.24 * vo.z) * (1.0 - fine * 0.12);
	vec3 nb = icz_bump(n, wp, H, 1.0);
	float up = nb.y + (icz_noise(uv * 0.8) - 0.5) * 0.35 + crack * 0.25;
	float snowy = smoothstep(0.45, 0.7, up) * snow_amt;
	col = mix(col, snow, snowy);
	NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
	ALBEDO = col * tone;
	ROUGHNESS = mix(0.82, 0.6, snowy);
	SPECULAR = 0.3;
	AO = 1.0 - crack * 0.45;
	AO_LIGHT_AFFECT = 0.3;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Ice Cap Zone Atto 2: l'acqua del Fiume Gelato (terrain2.gd build_materials "acqua_fiume", objects2.gd). L'acqua
// della zona (shaders/env/icz/acqua.gdshader) rifatta per il mattino pieno: il blu profondo di Sonic 3
// (le lastre bianche sul blu, piano Â§3.10). Opaca come gli altri materiali della zona: blu profondo che
// schiarisce dove l'increspatura Ã¨ alta, increspature che scorrono a valle (+X, la corrente), le scaglie di
// ghiaccio che galleggiano, il riflesso finto del cielo del mattino col Fresnel ma tenuto basso (refl): con
// quello dell'alba a radenza il fiume diventava bianco come la neve. Mai viola: tinte fra 205Â° e 220Â°.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/icz/icz_common.gdshaderinc"

uniform vec3 deep_col : source_color = vec3(0.01, 0.10, 0.34);
uniform vec3 shallow_col : source_color = vec3(0.06, 0.32, 0.62);
uniform float ripple = 0.35;
uniform float flow = 0.35;
uniform float refl = 0.28;

varying vec3 wp;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

vec3 sky_morning(vec3 R) {
	vec3 zen = vec3(0.10, 0.30, 0.78);
	vec3 hor = vec3(0.62, 0.74, 0.92);
	return mix(hor, zen, smoothstep(0.0, 0.6, R.y));
}

void fragment() {
	vec2 p = wp.xz;
	float t = TIME * flow;
	float h1 = icz_fbm(p * vec2(0.22, 0.4) + vec2(-t, 0.0));
	float h2 = icz_fbm(p * 0.9 - vec2(t * 1.3, -t * 0.2));
	vec2 e = vec2(0.15, 0.0);
	float hx = icz_fbm((p + e.xy) * vec2(0.22, 0.4) + vec2(-t, 0.0)) - h1;
	float hz = icz_fbm((p + e.yx) * vec2(0.22, 0.4) + vec2(-t, 0.0)) - h1;
	vec3 nw = normalize(vec3(-hx * ripple * 6.0, 1.0, -hz * ripple * 6.0) + vec3(h2 - 0.5, 0.0, 0.5 - h2) * ripple * 0.25);
	NORMAL = normalize((VIEW_MATRIX * vec4(nw, 0.0)).xyz);
	vec3 vo = icz_voronoi(p * 0.22 + vec2(-t * 0.6, 0.0));
	float flake = smoothstep(0.09, 0.05, vo.x) * step(0.84, icz_hash(vo.yz * 13.1));
	vec3 V = normalize((INV_VIEW_MATRIX * vec4(VIEW, 0.0)).xyz);
	float fr = pow(1.0 - clamp(dot(nw, V), 0.0, 1.0), 5.0);
	vec3 R = reflect(-V, nw);
	vec3 col = mix(deep_col, shallow_col, smoothstep(0.3, 0.8, h1));
	ALBEDO = mix(col, vec3(0.85, 0.93, 1.0), flake);
	ROUGHNESS = mix(0.28, 0.6, flake);
	// specular basso: il riflesso del cielo di Godot a radenza (Fresnel pieno sopra 0.02 di F0) faceva il
	// fiume bianco da lontano; quello che resta Ã¨ il nostro (EMISSION, refl)
	SPECULAR = 0.15;
	EMISSION = sky_morning(R) * fr * refl * (1.0 - flake);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Ice Cap Zone Atto 2: la colonna di luce blu sopra lo smeraldo blu della vetta (scripts/level/icz2_smeraldo.gd).
// Il punto di riferimento che si vede da tutta la valle: un cilindro aperto, senza luce nÃ© ombre, mezzo
// trasparente (sommato al cielo azzurro un blu non si vedeva: si mescola, col suo colore). Dal blu dello
// smeraldo (#0030c8) in basso al chiaro (#a0aaf4) in alto, i bordi del cilindro piÃ¹ pieni del centro (si
// legge come un raggio, non come un tubo), filamenti chiari che salgono piano, si sfuma verso la cima e
// appena sopra il piedistallo. Mai viola: le due tinte stanno fra 228Â° e 234Â°.
render_mode blend_mix, unshaded, cull_disabled, depth_draw_never, shadows_disabled, fog_disabled;

uniform vec3 base_col : source_color = vec3(0.0, 0.188, 0.784);
uniform vec3 top_col : source_color = vec3(0.627, 0.667, 0.957);
uniform float energy = 1.15;
uniform float height = 300.0;

varying float hy;

void vertex() {
	hy = VERTEX.y / height + 0.5;
}

float h1(float x) {
	return fract(sin(x * 127.1) * 43758.5453);
}

void fragment() {
	float edge = 1.0 - abs(dot(normalize(NORMAL), normalize(VIEW)));
	float rim = mix(0.35, 1.0, pow(edge, 1.5));
	// i filamenti: righe verticali che salgono
	float a = UV.x * 24.0;
	float id = floor(a);
	float strand = smoothstep(0.35, 0.0, abs(fract(a) - 0.5)) * (0.5 + 0.5 * h1(id));
	float flow = 0.6 + 0.4 * sin(hy * 40.0 - TIME * (1.5 + h1(id + 3.0)) + id * 1.7);
	float fade = smoothstep(0.0, 0.03, hy) * (1.0 - smoothstep(0.35, 1.0, hy));
	vec3 col = mix(base_col, top_col, smoothstep(0.0, 0.6, hy));
	col = mix(col, vec3(0.85, 0.9, 1.0), strand * flow * 0.35);
	ALBEDO = col * energy;
	ALPHA = clamp(fade * (0.3 + 0.45 * rim) * (0.75 + 0.25 * strand * flow), 0.0, 0.85);
}
␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Ice Cap Zone Atto 2: la roccia delle pareti della Cima (terrain2.gd build_materials "roccia_cima", cima.gd).
// La roccia della zona (shaders/env/icz/roccia.gdshader: strati, crepe a due misure, neve sulle facce in su)
// rifatta per la montagna al mattino pieno: con la roccia scura dell'Atto 1 la Cima, all'ombra, era una
// torre nera in mezzo alla valle bianca. Qui:
//   - la roccia Ã¨ un azzurro-ardesia chiaro (rock_a / rock_b), mai sotto un minimo di chiaro;
//   - la brina: righe verticali di neve gelata appiccicata alla parete (rumore stirato in verticale), piÃ¹
//     fitte in alto; si legge "montagna innevata" anche sulle facce a piombo;
//   - le cenge degli strati: una banda chiara ogni tanto (neve posata sugli strati);
//   - la neve sulle facce in su come la roccia dell'Atto 1.
// Coordinate del mondo a tre piani, niente UV. Mai lavanda: le tinte stanno fra 210Â° e 222Â°.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/icz/icz_common.gdshaderinc"

uniform vec3 rock_a : source_color = vec3(0.50, 0.61, 0.78);
uniform vec3 rock_b : source_color = vec3(0.31, 0.41, 0.60);
uniform vec3 snow : source_color = vec3(0.86, 0.91, 0.96);
uniform vec3 frost : source_color = vec3(0.78, 0.87, 0.96);
uniform float snow_amt = 1.0;
uniform float frost_amt = 1.0;
uniform float top_y = 140.0;
uniform float tone = 1.0;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wn);
	vec3 a = abs(n);
	bool flat_up = a.y > a.x && a.y > a.z;
	vec2 uv = flat_up ? wp.xz : (a.x > a.z ? vec2(wp.z, wp.y) : vec2(wp.x, wp.y));
	float strata = icz_fbm(vec2(uv.x * 0.12, uv.y * 0.9 + uv.x * 0.18));
	float bands = smoothstep(0.35, 0.65, fract(uv.y * 0.7 + uv.x * 0.12 + strata * 1.5));
	vec3 vo = icz_voronoi(uv * 1.45);
	vec3 vf = icz_voronoi(uv * 4.1 + 7.3);
	float fw = length(fwidth(uv));
	float crack = 1.0 - smoothstep(0.0, 0.06 + fw * 1.1, vo.y);
	float fine = (1.0 - smoothstep(0.0, 0.05 + fw * 3.0, vf.y)) * (1.0 - smoothstep(0.15, 0.4, fw));
	float H = strata * 0.25 + bands * 0.05 + vo.x * 0.06 + vf.x * 0.02 - crack * 0.05 - fine * 0.015 + icz_noise(uv * 4.0) * 0.02;
	vec3 col = mix(rock_b, rock_a, strata * 0.7 + bands * 0.3) * (0.9 + 0.2 * vo.z) * (1.0 - fine * 0.1);
	// la brina: righe verticali (stirate in quota), piÃ¹ fitte verso la vetta
	float hk = clamp(wp.y / top_y, 0.0, 1.0);
	float streak = icz_fbm(vec2(uv.x * 0.55, uv.y * 0.045 + 3.7));
	float fr = smoothstep(0.55 - 0.18 * hk, 0.72 - 0.18 * hk, streak + (icz_noise(uv * 0.9) - 0.5) * 0.18) * frost_amt * (flat_up ? 0.0 : 1.0);
	// le cenge degli strati: una banda chiara ogni ~9 m, rotta dal rumore
	float ledge = smoothstep(0.82, 0.95, fract(wp.y / 9.0 + strata * 0.4)) * smoothstep(0.35, 0.6, icz_noise(uv * 0.15 + 2.0));
	col = mix(col, frost, clamp(fr + ledge * 0.7, 0.0, 1.0) * (1.0 - crack * 0.4));
	vec3 nb = icz_bump(n, wp, H * (1.0 - fr * 0.6), 1.0);
	float up = nb.y + (icz_noise(uv * 0.8) - 0.5) * 0.35 + crack * 0.25;
	float snowy = smoothstep(0.45, 0.7, up) * snow_amt;
	col = mix(col, snow, snowy);
	NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
	ALBEDO = col * tone;
	ROUGHNESS = mix(0.8, 0.55, max(snowy, fr));
	SPECULAR = 0.3;
	AO = 1.0 - crack * 0.35;
	AO_LIGHT_AFFECT = 0.3;
	BACKLIGHT = vec3(0.06, 0.09, 0.14) * (1.0 - snowy);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Ice Cap Zone Atto 2: la tenda di luce della Corona di Cristallo (fra un cristallo e l'altro, attorno
// alla Cima). Bianco ghiaccio e celeste, righe di luce che salgono, piÃ¹ chiara di taglio (Fresnel),
// sfuma in alto e al piede; niente lilla. crack (0..1): la tenda si crepa (righe scure che si allargano)
// e svanisce quando si apre la Corona (icz2_corona.gd). UV.x: giri attorno (un'unitÃ  per campata), UV.y:
// 0 al piede, 1 in cima.
render_mode unshaded, cull_disabled, depth_draw_never, shadows_disabled, blend_mix;

uniform vec3 color_a : source_color = vec3(0.86, 0.97, 1.0);
uniform vec3 color_b : source_color = vec3(0.42, 0.84, 1.0);
uniform float alpha = 0.55;
uniform float crack = 0.0;
uniform float fade = 1.0;

float h(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void fragment() {
	vec2 uv = UV;
	float t = TIME * 0.35;
	// righe verticali che salgono, a passo diverso
	float s1 = 0.5 + 0.5 * sin((uv.x * 9.0 + sin(uv.y * 3.0 + t) * 0.4) * 6.2831);
	float s2 = 0.5 + 0.5 * sin((uv.x * 23.0 - uv.y * 2.0) * 6.2831 + t * 3.0);
	float rise = fract(uv.y * 3.0 - t);
	float band = smoothstep(0.0, 0.15, rise) * (1.0 - smoothstep(0.15, 0.6, rise));
	float k = clamp(0.35 + 0.4 * s1 * s2 + 0.35 * band, 0.0, 1.0);
	vec3 col = mix(color_b, color_a, k);
	// di taglio piÃ¹ chiara
	float fr = pow(1.0 - abs(dot(NORMAL, VIEW)), 2.0);
	col = mix(col, color_a, fr * 0.6);
	// le crepe: celle che si scuriscono e si staccano
	vec2 cell = floor(vec2(uv.x * 6.0, uv.y * 10.0));
	float rnd = h(cell);
	float gone = step(rnd, crack * 1.2 - 0.1);
	vec2 f = fract(vec2(uv.x * 6.0, uv.y * 10.0));
	float edge = min(min(f.x, 1.0 - f.x), min(f.y, 1.0 - f.y));
	float line = (1.0 - smoothstep(0.0, 0.04 + 0.08 * crack, edge)) * step(0.01, crack);
	col = mix(col, vec3(1.0), line * 0.8);
	float a = alpha * (0.55 + 0.45 * k) * smoothstep(0.0, 0.06, uv.y) * (1.0 - smoothstep(0.75, 1.0, uv.y));
	a = mix(a, 1.0, line * 0.5) * (1.0 - gone) * fade;
	ALBEDO = col * 1.25;
	ALPHA = clamp(a, 0.0, 1.0);
}
shader_type sky;
render_mode use_debanding;
// La scena del cannone (scripts/cinematic/icz_cannone_set.gd): la notte sopra Carnival Night verso le
// montagne di Ice Cap. Blu notte in alto; all'orizzonte dalla parte del luna park (-X) un filo caldo
// (rosa e oro) delle sue luci, dalla parte delle montagne (+X) un azzurro freddo di luna (niente viola sopra
// Ice Cap); le stelle che brillano, la luna grande col suo alone e l'aurora (tende verde, ciano e blu)
// sopra i picchi a +X; alla fine (alba) la prima luce rosa dietro i picchi. Stelle, luna e aurora solo
// fuori dalla passata cubemap: la radianza (il solo gradiente) resta ferma e non si rifÃ  a ogni
// fotogramma.

uniform vec3 zenith : source_color = vec3(0.012, 0.022, 0.085);
uniform vec3 mid : source_color = vec3(0.035, 0.06, 0.2);
uniform vec3 horizon : source_color = vec3(0.4, 0.17, 0.13);
uniform vec3 horizon_ice : source_color = vec3(0.11, 0.24, 0.42);
uniform vec3 below : source_color = vec3(0.03, 0.04, 0.1);
uniform vec3 moon_dir = vec3(0.62, 0.36, 0.7);
uniform float moon_size = 0.9985;
uniform vec3 moon_col : source_color = vec3(0.92, 0.95, 1.0);
uniform float aurora = 1.0;
uniform float dawn = 0.0;
uniform float stars = 1.0;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float a = hash(i);
	float b = hash(i + vec2(1.0, 0.0));
	float c = hash(i + vec2(0.0, 1.0));
	float e = hash(i + vec2(1.0, 1.0));
	return mix(mix(a, b, f.x), mix(c, e, f.x), f.y);
}

float fbm(vec2 p) {
	float s = 0.0;
	float a = 0.5;
	for (int i = 0; i < 4; i++) {
		s += a * vnoise(p);
		p = p * 2.03 + vec2(1.7, 9.2);
		a *= 0.5;
	}
	return s;
}

void sky() {
	vec3 d = normalize(EYEDIR);
	float y = d.y;
	float t1 = pow(clamp(y, 0.0, 1.0), 0.5);
	vec3 col = mix(horizon_ice, mid, smoothstep(0.0, 0.3, t1));
	col = mix(col, zenith, smoothstep(0.25, 1.0, t1));
	col = mix(col, below, smoothstep(0.0, -0.25, y));
	// verso il luna park (-X) solo un filo caldo basso sull'orizzonte (le sue luci), non tutto il cielo:
	// sopra resta il blu notte (caldo e non viola: sommato al blu il magenta dava il lilla)
	float park = smoothstep(0.25, -0.65, d.x);
	col += horizon * park * exp(-abs(y) * 22.0) * 0.6;
	// l'alba dietro i picchi (verso +X)
	float east = max(d.x, 0.0);
	col += vec3(1.0, 0.5, 0.42) * dawn * pow(east, 3.0) * exp(-max(y, 0.0) * 7.0) * 0.9;
	vec3 md = normalize(moon_dir);
	float sd = dot(d, md);
	if (!AT_CUBEMAP_PASS) {
		// alone della luna (solo fuori dalla radianza: la scena sposta la luna da un'inquadratura
		// all'altra senza rifare i riflessi)
		col += vec3(0.28, 0.4, 0.62) * (pow(max(sd, 0.0), 24.0) * 0.5 + pow(max(sd, 0.0), 300.0) * 0.6);
		// stelle (celle sulla sfera), piÃ¹ fitte in alto, che tremolano
		if (y > -0.02) {
			vec2 sp = vec2(atan(d.z, d.x) * 120.0, asin(clamp(y, -1.0, 1.0)) * 120.0);
			vec2 cell = floor(sp);
			float h = hash(cell);
			vec2 off = vec2(hash(cell + 3.1), hash(cell + 7.7)) - 0.5;
			float r = length(fract(sp) - 0.5 - off * 0.6);
			float tw = 0.65 + 0.35 * sin(TIME * (2.0 + 5.0 * h) + h * 40.0);
			float st = step(0.965, h) * smoothstep(0.16, 0.0, r) * tw;
			st *= smoothstep(0.0, 0.25, y) * (1.0 - smoothstep(0.9993, 0.99995, sd));
			col += vec3(0.85, 0.9, 1.0) * st * stars * (0.6 + 1.6 * fract(h * 13.0));
		}
		// la luna: disco con i mari (rumore), bordo morbido
		if (sd > moon_size - 0.0004) {
			vec3 ax = normalize(cross(md, vec3(0.0, 1.0, 0.0)));
			vec3 ay = cross(ax, md);
			vec2 mp = vec2(dot(d, ax), dot(d, ay)) / sqrt(1.0 - moon_size * moon_size);
			float mare = fbm(mp * 3.0 + 4.0);
			float disc = smoothstep(moon_size - 0.0004, moon_size + 0.0002, sd);
			vec3 mc = moon_col * (1.35 - 0.55 * smoothstep(0.45, 0.7, mare));
			col = mix(col, mc * 1.05, disc);
		}
		// l'aurora: tende che ondeggiano sopra i picchi (+X), verde in basso, ciano, blu in cima
		if (aurora > 0.0 && y > 0.0) {
			float az = atan(d.z, d.x);
			float face = smoothstep(-0.2, 0.55, d.x);
			for (int k = 0; k < 3; k++) {
				float fk = float(k);
				float base = 0.16 + 0.07 * fk + 0.05 * sin(az * 2.3 + fk * 1.7 + TIME * 0.05);
				float wave = az * (5.0 + fk * 1.3) + TIME * (0.11 + 0.04 * fk);
				float curt = fbm(vec2(wave * 1.6, fk * 3.1 + TIME * 0.04));
				curt = pow(clamp(curt * 1.6 - 0.35, 0.0, 1.0), 1.6);
				float up = y - base;
				float band = smoothstep(-0.015, 0.02, up) * exp(-max(up, 0.0) * (7.0 - fk));
				float rays = 0.55 + 0.45 * vnoise(vec2(az * 140.0, TIME * 0.6 + fk * 9.0));
				vec3 ac = mix(vec3(0.12, 1.0, 0.55), vec3(0.2, 0.85, 1.0), smoothstep(0.0, 0.06, up));
				ac = mix(ac, vec3(0.22, 0.5, 1.0), smoothstep(0.05, 0.16, up));
				col += ac * curt * band * rays * face * aurora * (0.55 - 0.12 * fk);
			}
		}
	}
	COLOR = col;
}
␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// niente lucido diretto (la luna bassa davanti alla camera faceva una chiazza bianca): il lucido Ã¨ quello
// del cielo riflesso e dei neon finti
render_mode specular_disabled;
// La pista del circo della scena del cannone (scripts/cinematic/icz_cannone_set.gd): lo stesso pavimento
// della festa di Patrizio a Carnival Night Atto 2, blu notte lucido con la griglia di neon magenta, la
// stella a cinque punte al centro (un neon d'oro sul contorno e un filo dentro, il fondo blu: niente
// macchia color sabbia) e il cerchio ciano; le fughe un po' incassate e il riflesso finto delle
// lampadine del bordo (una fascia calda che si accende vicino al bordo). Coordinate del mondo: XZ.

uniform vec3 base_col : source_color = vec3(0.04, 0.045, 0.16);
uniform vec3 grid_col : source_color = vec3(1.0, 0.18, 0.72);
uniform vec3 ring_col : source_color = vec3(0.2, 0.85, 1.0);
uniform vec3 gold : source_color = vec3(1.0, 0.72, 0.28);
uniform float cell = 2.6;
uniform float radius = 22.0;
uniform float grid_energy = 1.7;

varying vec3 wp;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

// distanza con segno da una stella a cinque punte di raggio r (rf: quanto rientrano le punte), punta
// verso +y (Inigo Quilez, sdStar5)
float sd_star5(vec2 p, float r, float rf) {
	const vec2 k1 = vec2(0.809016994375, -0.587785252292);
	const vec2 k2 = vec2(-0.809016994375, -0.587785252292);
	p.x = abs(p.x);
	p -= 2.0 * max(dot(k1, p), 0.0) * k1;
	p -= 2.0 * max(dot(k2, p), 0.0) * k2;
	p.x = abs(p.x);
	p.y -= r;
	vec2 ba = rf * vec2(-k1.y, k1.x) - vec2(0.0, 1.0);
	float h = clamp(dot(p, ba) / dot(ba, ba), 0.0, r);
	return length(p - ba * h) * sign(p.y * ba.x - p.x * ba.y);
}

// una riga della griglia: 1 sulla fuga (alle coordinate intere), larga w (in celle), antialiasata
float grid_line(float x, float w) {
	float d = abs(fract(x + 0.5) - 0.5);
	float aa = fwidth(x) * 1.2;
	return 1.0 - smoothstep(w - aa, w + aa, d);
}

void fragment() {
	vec2 p = wp.xz;
	float r = length(p);
	float gx = grid_line(p.x / cell, 0.022);
	float gz = grid_line(p.y / cell, 0.022);
	float g = max(gx, gz);
	// cerchio ciano a 3/4 del raggio e la stella al centro (una punta verso il cannone, +X)
	float ring = 1.0 - smoothstep(0.05, 0.05 + fwidth(r) * 1.5, abs(r - radius * 0.72));
	float a = atan(p.y, p.x);
	float sd = sd_star5(vec2(p.y, p.x), 3.6, 0.42);
	float aa = fwidth(sd) * 1.2;
	float inside = 1.0 - smoothstep(-aa, aa, sd);
	float edge_l = 1.0 - smoothstep(0.06 - aa, 0.06 + aa, abs(sd));
	float edge_i = 1.0 - smoothstep(0.025 - aa, 0.025 + aa, abs(sd + 0.32));
	vec3 alb = mix(base_col, vec3(0.05, 0.07, 0.26), inside);
	// dentro la stella niente griglia
	g *= 1.0 - inside;
	vec3 em = grid_col * g * grid_energy * (0.65 + 0.35 * smoothstep(radius, 0.0, r));
	em += ring_col * ring * 2.0;
	em += gold * (edge_l * 1.8 + edge_i * 0.9);
	em += vec3(0.1, 0.2, 0.6) * inside * 0.12;
	// la fascia calda vicino al bordo (le lampadine riflesse), piccole variazioni di lucido
	float edge = smoothstep(radius * 0.7, radius, r) * (0.5 + 0.5 * sin(a * 48.0));
	em += vec3(1.0, 0.75, 0.4) * edge * 0.05;
	ALBEDO = alb;
	EMISSION = em;
	METALLIC = 0.2;
	ROUGHNESS = mix(0.42, 0.6, g);
	SPECULAR = 0.35;
}
␀␀␀␀␀␀shader_type spatial;
// Carnival Night vista dall'alto della scena del cannone (scripts/cinematic/icz_cannone_set.gd): le torri
// del luna park piÃ¹ in basso, oltre il bordo dell'altopiano, con le finestre accese (calde, qualcuna
// ciano o rosa) sulle facce verticali; con "plan" = 1 lo stesso disegno in pianta sul fondo (gli
// isolati accesi visti dall'alto). Da lontano, quando una finestra diventa piÃ¹ piccola di un pixel, le
// finestre sfumano nella loro media (niente sfarfallio). Coordinate del mondo.
render_mode specular_disabled;

uniform vec3 wall : source_color = vec3(0.03, 0.04, 0.1);
uniform vec2 cell = vec2(2.4, 3.2);
uniform float lit = 0.45;
uniform float energy = 1.7;
uniform float plan = 0.0;

varying vec3 wp;
varying vec3 wn;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec2 f = plan > 0.5 ? wp.xz : (abs(wn.x) > abs(wn.z) ? vec2(wp.z, wp.y) : vec2(wp.x, wp.y));
	vec2 q = f / cell;
	vec2 c = floor(q);
	vec2 fr = fract(q);
	float h = hash(c + floor(wp.xz * 0.013) * 17.0);
	float win = step(0.2, fr.x) * step(fr.x, 0.8) * step(0.28, fr.y) * step(fr.y, 0.72);
	float on = step(1.0 - lit, h);
	vec3 wc = vec3(1.0, 0.72, 0.4);
	wc = mix(wc, vec3(0.35, 0.85, 1.0), step(0.86, fract(h * 7.31)));
	wc = mix(wc, vec3(1.0, 0.32, 0.7), step(0.93, fract(h * 13.17)));
	float flat_face = plan > 0.5 ? 0.0 : smoothstep(0.6, 0.8, abs(wn.y));
	vec3 em = wc * win * on * energy * (0.75 + 0.5 * fract(h * 3.7));
	// da lontano la media delle finestre
	float px = max(fwidth(q.x), fwidth(q.y));
	vec3 avg = vec3(1.0, 0.68, 0.45) * lit * 0.36 * energy;
	em = mix(em, avg, smoothstep(0.35, 0.8, px));
	ALBEDO = wall;
	ROUGHNESS = 0.7;
	EMISSION = em * (1.0 - flat_face);
}
␀␀␀␀␀shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_back, unshaded, shadows_disabled, fog_disabled;
// Il mare di nuvole sotto il volo della scena del cannone (scripts/cinematic/icz_cannone_set.gd): un
// piano grande con rumore fbm che scorre piano (coordinate del mondo), le cime accese dalla luna
// (bianco azzurro), le valli blu notte, i bordi morbidi; piÃ¹ denso lontano (verso le montagne).
// cull_back: da sotto non si vede (dalla pista del circo resta sotto l'orizzonte).

uniform vec3 lit : source_color = vec3(0.76, 0.86, 0.99);
uniform vec3 shade : source_color = vec3(0.09, 0.15, 0.31);
uniform vec3 glow : source_color = vec3(1.0, 0.68, 0.62);
uniform float scale = 0.004;
uniform float speed = 0.01;
uniform float cover = 0.45;
uniform float dawn = 0.0;
uniform vec2 x_range = vec2(200.0, 5000.0);

varying vec3 wp;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}

float fbm(vec2 p) {
	float s = 0.0;
	float a = 0.5;
	for (int i = 0; i < 5; i++) {
		s += a * vnoise(p);
		p = p * 2.07 + vec2(3.1, 1.7);
		a *= 0.5;
	}
	return s;
}

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 p = wp.xz * scale + vec2(TIME * speed, TIME * speed * 0.3);
	float c = fbm(p);
	float c2 = fbm(p + vec2(0.04, 0.02));
	float dens = smoothstep(cover, cover + 0.25, c);
	float top = clamp((c - c2) * 9.0 + 0.55, 0.0, 1.0);
	vec3 col = mix(shade, lit, top * dens);
	col += glow * dawn * smoothstep(0.0, 1.0, (wp.x - x_range.x) / (x_range.y - x_range.x)) * 0.35;
	float edge = smoothstep(x_range.x, x_range.x + 220.0, wp.x) * (1.0 - smoothstep(x_range.y - 600.0, x_range.y, wp.x));
	edge *= 1.0 - smoothstep(1800.0, 2600.0, abs(wp.z));
	ALBEDO = col;
	ALPHA = clamp(dens * 0.85 + 0.25, 0.0, 1.0) * edge;
}
shader_type spatial;
render_mode fog_disabled;
// Le montagne di Ice Cap viste di notte dalla scena del cannone (scripts/cinematic/icz_cannone_set.gd):
// neve bianca sui versanti in piano (sotto la luna), ombre azzurre e blu ghiaccio (niente lavanda), roccia
// blu scuro sui versanti ripidi, creste chiare, ghiaccio ciano che luccica qua e lÃ  e un filo di riflesso
// ciano sulla neve vista di taglio. Lontane: una foschia propria (il blu freddo dell'orizzonte verso le
// montagne) al posto della nebbia del mondo; "dawn" le scalda di rosa (alba).

uniform vec3 snow : source_color = vec3(0.9, 0.96, 1.0);
uniform vec3 snow_shadow : source_color = vec3(0.42, 0.62, 0.86);
uniform vec3 rock : source_color = vec3(0.055, 0.09, 0.16);
uniform vec3 ice : source_color = vec3(0.5, 0.92, 1.0);
uniform vec3 haze : source_color = vec3(0.08, 0.17, 0.32);
uniform float haze_near = 400.0;
uniform float haze_far = 2600.0;
uniform float haze_max = 0.75;
uniform float dawn = 0.0;
// la luce finta della luna dalla parte di chi guarda (la vera Ã¨ alle spalle dei picchi): le facce verso
// la pista si leggono come neve al chiaro di luna, le altre restano in un'ombra azzurra
uniform vec3 key_dir = vec3(-0.55, 0.55, 0.35);
uniform float key = 0.85;

varying vec3 wp;
varying vec3 wn;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	float up = clamp(wn.y, 0.0, 1.0);
	float n = vnoise(wp.xz * 0.02) * 0.6 + vnoise(wp.xz * 0.09) * 0.4;
	// neve dove il versante Ã¨ abbastanza piano (con il rumore: lingue di neve e roccia)
	float sn = smoothstep(0.42, 0.62, up + (n - 0.5) * 0.35);
	vec3 alb = mix(rock, snow, sn);
	// ghiaccio sui versanti medi
	float ic = smoothstep(0.62, 0.85, vnoise(wp.xz * 0.05 + 9.0)) * (1.0 - sn) * 0.6;
	alb = mix(alb, ice * 0.6, ic);
	float d = length(wp - CAMERA_POSITION_WORLD);
	float h = smoothstep(haze_near, haze_far, d) * haze_max;
	ALBEDO = alb * (1.0 - h);
	ROUGHNESS = mix(0.85, 0.35, ic);
	SPECULAR = 0.3;
	// luce propria debole: le ombre non vanno mai al nero (rimbalzo della neve, cielo)
	vec3 amb = mix(snow_shadow * 0.18, snow_shadow * 0.32, sn);
	float kl = max(dot(wn, normalize(key_dir)), 0.0);
	amb += mix(rock * 1.5, snow * 0.8, sn) * kl * key;
	amb += vec3(1.0, 0.55, 0.5) * dawn * sn * smoothstep(0.0, 1.0, wn.x) * 0.5;
	// il riflesso ciano della neve vista di taglio (il ghiaccio sotto la neve)
	float fr = pow(1.0 - clamp(dot(normalize(NORMAL), VIEW), 0.0, 1.0), 3.0);
	amb += ice * fr * sn * 0.16;
	EMISSION = amb * (1.0 - h) + haze * h * 0.9 + ice * ic * 0.14;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type sky;
// Launch Base Zone, lo SCONTRO del cielo (scripts/bosses/lbz_cielo_scena.gd): il cielo del tardo
// pomeriggio sopra la baia dove la base Ã¨ affondata, a 170 m di quota. Prima era un vuoto azzurro
// pallido (la nebbia lavava tutto): adesso un gradiente vero e un orizzonte che si legge.
//   - in alto blu pieno, a metÃ  azzurro, giÃ¹ verso l'orizzonte dorato dalla parte del sole (tramonto
//     vicino) e azzurro chiaro dalla parte opposta; il sole basso col suo alone caldo;
//   - le nuvole alte a strisce (altocumuli, cloud_noise) sopra la quota dello scontro;
//   - SOTTO l'orizzonte il mare lontano (blu-verde scuro, piÃ¹ chiaro e velato verso l'orizzonte, il
//     riflesso del sole a strisce), cosÃ¬ dove il mare vero del livello finisce (la camera vede fino a
//     2000 m) non si vede il bordo; sull'orizzonte una fascia di cumuli lontani (il "mare di nubi")
//     coi bordi accesi dal sole: la linea dell'orizzonte c'Ã¨ sempre, anche dentro la nebbia;
//   - "fumo" (0..1): un velo bruno caldo basso dalla parte della base (verso -Z), mai grigio-viola.
// NIENTE VIOLA (regola del gioco): blu e arancio mescolati fanno viola quando il rosso supera il verde
// col blu davanti; la guardia in fondo (no_viola) tiene il rosso sotto il verde dove il blu domina, cosÃ¬
// le tinte restano fra il ciano e il blu (180-240 gradi) o fra il rosso e il giallo, mai 255-325.
// Tutto fermo (niente TIME): la radianza si rifÃ  solo quando cambia un parametro.

uniform vec3 zenith : source_color = vec3(0.10, 0.30, 0.72);
uniform vec3 mid : source_color = vec3(0.30, 0.58, 0.93);
uniform vec3 horizon_cool : source_color = vec3(0.66, 0.84, 0.97);
uniform vec3 horizon_warm : source_color = vec3(1.0, 0.80, 0.50);
uniform vec3 sun_glow : source_color = vec3(1.0, 0.70, 0.36);
uniform vec3 sea_deep : source_color = vec3(0.03, 0.17, 0.26);
uniform vec3 sea_far : source_color = vec3(0.30, 0.50, 0.58);
uniform vec3 cloud_lit : source_color = vec3(1.0, 0.92, 0.80);
uniform vec3 cloud_shade : source_color = vec3(0.50, 0.62, 0.78);
uniform sampler2D cloud_noise : filter_linear_mipmap, repeat_enable;
uniform float cloud_cover = 0.58;
uniform float fumo = 1.0;
uniform vec3 smoke_col : source_color = vec3(0.46, 0.38, 0.30);

// la guardia contro il viola: col blu sopra il verde, il rosso non passa il verde
vec3 no_viola(vec3 c) {
	float bd = step(c.g, c.b);
	c.r = mix(c.r, min(c.r, c.g), bd);
	return c;
}

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), u.x), mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), u.x), u.y);
}

float fbm(vec2 p) {
	float s = 0.0;
	float a = 0.5;
	for (int i = 0; i < 5; i++) {
		s += vnoise(p) * a;
		p = p * 2.03 + vec2(1.7, 9.2);
		a *= 0.5;
	}
	return s;
}

void sky() {
	vec3 d = normalize(EYEDIR);
	float y = d.y;
	vec3 L = LIGHT0_DIRECTION;
	float sd = dot(d, L);
	vec2 dn = normalize(d.xz + vec2(0.0001));
	float toward = max(dot(dn, normalize(L.xz + vec2(0.0001))), 0.0);
	float warm = pow(toward, 2.2);
	float az = atan(d.z, d.x);
	vec3 col;
	// la linea dell'orizzonte un filo sotto lo zero (si vola a 170 m: l'orizzonte del mare scende)
	float hy = y + 0.035;
	if (hy >= 0.0) {
		float t1 = pow(clamp(hy, 0.0, 1.0), 0.45);
		vec3 hz = mix(horizon_cool, horizon_warm, warm * 0.85);
		col = mix(hz, mid, smoothstep(0.0, 0.42, t1));
		col = mix(col, zenith, smoothstep(0.42, 1.0, t1));
		// il velo dorato basso tutto attorno (piÃ¹ forte dalla parte del sole)
		float band = 1.0 - smoothstep(0.0, 0.16, hy);
		col = mix(col, horizon_warm, band * (0.18 + 0.5 * warm));
		// le nuvole alte a strisce, accese dal sole basso, la pancia azzurra
		if (hy > 0.02) {
			vec2 uv = d.xz / (hy + 0.1) * 0.09;
			uv = vec2(uv.x * 0.6 + uv.y * 0.3, uv.y * 1.4 - uv.x * 0.2);
			float c = texture(cloud_noise, uv * 0.5).r * 0.62 + texture(cloud_noise, uv * 2.1 + 0.37).r * 0.38;
			float dens = smoothstep(cloud_cover, cloud_cover + 0.2, c) * smoothstep(0.02, 0.14, hy) * (1.0 - smoothstep(0.55, 0.9, hy));
			float edge = smoothstep(cloud_cover + 0.2, cloud_cover + 0.02, c);
			vec3 cl = mix(cloud_lit, cloud_shade, (1.0 - edge) * 0.55 * (1.0 - warm * 0.6));
			cl = mix(cl, sun_glow * 1.1, edge * warm * 0.6);
			col = mix(col, cl, dens * 0.85);
		}
	} else {
		// il mare lontano sotto l'orizzonte: scuro sotto, velato e chiaro verso la linea
		float t2 = pow(clamp(-hy * 3.0, 0.0, 1.0), 0.6);
		vec3 sea = mix(sea_far, sea_deep, t2);
		sea = mix(sea, horizon_warm * 0.8, (1.0 - smoothstep(0.0, 0.05, -hy)) * warm * 0.5);
		// la strada del sole sull'acqua: strisce dorate sotto il sole
		float glit = pow(toward, 60.0) * (0.6 + 0.4 * vnoise(vec2(az * 400.0, -hy * 900.0))) * (1.0 - smoothstep(0.0, 0.25, -hy));
		col = sea + sun_glow * glit * 1.6;
	}
	// il mare di nubi lontano sull'orizzonte: cumuli bassi coi bordi accesi
	float ch = 0.012 + 0.045 * fbm(vec2(az * 6.0, 1.3)) + 0.03 * fbm(vec2(az * 17.0, 4.1));
	float cb = -0.035;
	if (y < cb + ch && y > cb - 0.06) {
		float k = smoothstep(cb + ch, cb + ch - 0.006, y) * smoothstep(cb - 0.06, cb - 0.02, y);
		float top = smoothstep(cb + ch - 0.03, cb + ch, y);
		vec3 cl = mix(cloud_shade * 0.95, cloud_lit, 0.35 + 0.65 * top);
		cl = mix(cl, sun_glow * 1.15, top * warm * 0.7);
		cl = mix(cl, horizon_cool, 0.25 * (1.0 - warm));
		col = mix(col, cl, k * 0.92);
	}
	// il velo del fumo dalla parte della base (-Z), basso
	float base_side = smoothstep(-0.2, 0.8, -dn.y);
	float veil = fumo * base_side * (1.0 - smoothstep(-0.02, 0.22, y)) * smoothstep(-0.12, 0.0, y) * 0.45;
	col = mix(col, smoke_col, veil);
	// il sole basso e il suo alone caldo
	col += sun_glow * (pow(max(sd, 0.0), 8.0) * 0.16 + pow(max(sd, 0.0), 90.0) * 0.4);
	if (!AT_CUBEMAP_PASS && sd > 0.9992) {
		col += vec3(1.8, 1.5, 1.1) * smoothstep(0.9992, 0.9996, sd);
	}
	COLOR = no_viola(col);
}
␀␀␀␀␀␀␀␀␀shader_type spatial;
// Launch Base Zone, lo SCONTRO del cielo (scripts/bosses/lbz_cielo_scena.gd): i CUMULI attorno e sotto la
// quota dello scontro (torri di nubi lontane, banchi bassi, sbuffi sparsi appena fuori dal confine: la
// velocitÃ  si legge quando ci si passa accanto). Una MultiMesh di quadrati; ogni quadrato Ã¨ una SFERA
// finta girata verso la camera (la normale dall'UV, la profonditÃ  scritta sulla superficie della sfera:
// le sfere si compenetrano tonde, niente tagli dritti fra un quadrato e l'altro), il bordo mangiato dal
// rumore e tagliato netto (alpha scissor: niente ordine delle trasparenze da sbagliare).
// La luce finta del sole basso: lato al sole bianco caldo, ombra azzurra, il fondo piatto piÃ¹ scuro
// (sotto la base del cumulo), il bordo controsole acceso d'oro. Mai viola (guardia no_viola).
//   INSTANCE_CUSTOM: r = raggio dello sbuffo (m), g = seme 0..1, b = quota della base del cumulo (m),
//                    a = luce 0..1 (quanto Ã¨ in vista del sole: i banchi bassi un po' piÃ¹ spenti)
//   l'origine della trasformazione dell'istanza = il centro dello sbuffo

render_mode unshaded, cull_disabled, depth_draw_opaque, shadows_disabled;

uniform vec3 lit : source_color = vec3(1.0, 0.95, 0.86);
uniform vec3 shade : source_color = vec3(0.52, 0.64, 0.80);
uniform vec3 base_col : source_color = vec3(0.40, 0.49, 0.60);
uniform vec3 warm : source_color = vec3(1.0, 0.74, 0.42);
uniform vec3 sun_dir = vec3(0.62, 0.30, 0.72);
uniform float drift = 0.03;

varying vec3 v_center;
varying float v_r;
varying float v_seed;
varying float v_base;
varying float v_lit;

vec3 no_viola(vec3 c) {
	float bd = step(c.g, c.b);
	c.r = mix(c.r, min(c.r, c.g), bd);
	return c;
}

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), u.x), mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), u.x), u.y);
}

float fbm3(vec2 p) {
	return vnoise(p) * 0.55 + vnoise(p * 2.1 + 3.7) * 0.3 + vnoise(p * 4.3 + 9.1) * 0.15;
}

void vertex() {
	v_r = max(INSTANCE_CUSTOM.r, 1.0);
	v_seed = INSTANCE_CUSTOM.g;
	v_base = INSTANCE_CUSTOM.b;
	v_lit = INSTANCE_CUSTOM.a;
	vec3 c = MODEL_MATRIX[3].xyz;
	v_center = c;
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], vec4(c, 1.0));
	// il quadrato un po' piÃ¹ largo della sfera: il bordo mangiato dal rumore ha spazio
	VERTEX = vec3(VERTEX.xy * v_r * 2.3, 0.0);
}

void fragment() {
	vec2 q = (UV * 2.0 - 1.0) * 1.15;
	q.y = -q.y;
	float n = fbm3(q * 2.2 + vec2(v_seed * 31.0, v_seed * 17.0 + TIME * drift));
	float r2 = dot(q, q);
	float edge = 1.0 - r2 + (n - 0.5) * 0.7;
	if (edge < 0.0) {
		discard;
	}
	// la normale della sfera finta (spazio della vista) e il punto sulla sua superficie
	vec3 nv = normalize(vec3(q, sqrt(max(1.0 - min(r2, 1.0), 0.02))));
	vec3 cv = (VIEW_MATRIX * vec4(v_center, 1.0)).xyz;
	vec3 pv = cv + nv * v_r;
	vec4 clip = PROJECTION_MATRIX * vec4(pv, 1.0);
	DEPTH = clip.z / clip.w;
	vec3 nw = normalize((INV_VIEW_MATRIX * vec4(nv, 0.0)).xyz);
	vec3 pw = (INV_VIEW_MATRIX * vec4(pv, 1.0)).xyz;
	vec3 sd = normalize(sun_dir);
	float l = clamp(dot(nw, sd) * 0.6 + 0.45, 0.0, 1.0) * mix(0.55, 1.0, v_lit);
	l *= 0.85 + 0.3 * n;
	vec3 col = mix(shade, lit, l);
	// il fondo piatto del cumulo, piÃ¹ scuro
	float low = 1.0 - smoothstep(v_base, v_base + v_r * 1.4, pw.y);
	col = mix(col, base_col, low * 0.75);
	// il bordo controsole acceso
	vec3 cam = (INV_VIEW_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
	float back = pow(max(dot(normalize(pw - cam), sd), 0.0), 6.0);
	float rim = smoothstep(0.35, 0.95, r2);
	col = mix(col, warm, back * rim * 0.7);
	col = mix(col, warm, max(dot(nw, sd), 0.0) * 0.18 * v_lit);
	ALBEDO = no_viola(col);
}
shader_type spatial;
// Launch Base Zone, lo SCONTRO del cielo (scripts/bosses/lbz_cielo_scena.gd): lo STRATO di nubi sotto la
// quota dello scontro (un piano grande, due o tre copie a pochi metri l'una dall'altra fanno spessore).
// A chiazze, coi buchi da cui si vede il mare e la base affondata: la quota e la velocitÃ  si leggono
// (le chiazze scorrono sotto chi vola). Rumore procedurale (fbm con lo spostamento del dominio), il
// vento lo porta piano (TIME). Sopra: bianco caldo dalla parte del sole, ombra azzurra nelle pieghe
// (il rumore campionato verso il sole: dove c'Ã¨ piÃ¹ nube davanti al sole Ã¨ piÃ¹ scuro). Sotto (camera piÃ¹
// bassa del piano): la pancia grigio-azzurra. Lontano sfuma (la fascia di nubi del cielo continua
// l'orizzonte), vicino alla camera in quota sfuma (attraversarlo non Ã¨ un muro piatto).
// Senza luci (economico); la nebbia del motore sÃ¬. Mai viola: la guardia no_viola come nel cielo.

render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled;

uniform vec3 lit : source_color = vec3(0.97, 0.91, 0.80);
uniform vec3 shade : source_color = vec3(0.48, 0.60, 0.77);
uniform vec3 belly : source_color = vec3(0.40, 0.48, 0.58);
uniform vec3 warm : source_color = vec3(1.0, 0.76, 0.46);
uniform vec3 sun_dir = vec3(0.62, 0.30, 0.72);
uniform float scale = 0.0042;       // frequenza del rumore (1/m)
uniform float cover = 0.50;         // piÃ¹ alto = meno nubi
uniform float softness = 0.16;
uniform float opacity = 0.92;
uniform float seed = 0.0;
uniform vec2 wind = vec2(3.0, 1.2);  // m/s
uniform float fade_far0 = 900.0;
uniform float fade_far1 = 1800.0;
uniform float fade_near = 18.0;     // m: vicino alla camera in quota sfuma
uniform vec3 center = vec3(0.0, 0.0, 0.0);

varying vec3 w_pos;

vec3 no_viola(vec3 c) {
	float bd = step(c.g, c.b);
	c.r = mix(c.r, min(c.r, c.g), bd);
	return c;
}

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), u.x), mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), u.x), u.y);
}

float fbm(vec2 p) {
	float s = 0.0;
	float a = 0.5;
	for (int i = 0; i < 5; i++) {
		s += vnoise(p) * a;
		p = mat2(vec2(1.6, 1.2), vec2(-1.2, 1.6)) * p + vec2(3.1, 7.7);
		a *= 0.5;
	}
	return s;
}

float dens(vec2 p) {
	vec2 q = vec2(fbm(p + vec2(seed, 1.3)), fbm(p + vec2(5.2, seed + 2.8)));
	return fbm(p + q * 1.6);
}

void vertex() {
	w_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 p = (w_pos.xz - wind * TIME) * scale;
	float n = dens(p);
	float a = smoothstep(cover, cover + softness, n);
	if (a < 0.003) {
		discard;
	}
	vec3 cam = (INV_VIEW_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
	vec3 sd = normalize(sun_dir);
	// le pieghe: piÃ¹ nube verso il sole = piÃ¹ ombra
	float n2 = dens(p + normalize(sd.xz + vec2(0.0001)) * 0.09);
	float sh = clamp((n2 - n) * 5.0 + 0.5, 0.0, 1.0);
	float core = smoothstep(cover + softness * 0.5, cover + softness * 2.6, n);
	vec3 col = mix(lit, shade, clamp(sh * 0.9 + core * 0.35, 0.0, 1.0));
	// i bordi sottili controsole si accendono d'oro
	vec3 to_px = normalize(w_pos - cam);
	float back = pow(max(dot(to_px, sd), 0.0), 4.0);
	col = mix(col, warm, back * (1.0 - core) * 0.6);
	// visto da sotto: la pancia
	float under = smoothstep(2.0, -6.0, cam.y - w_pos.y);
	col = mix(col, belly * (0.85 + 0.3 * (1.0 - core)), under);
	float dist = length(w_pos.xz - cam.xz);
	a *= 1.0 - smoothstep(fade_far0, fade_far1, length(w_pos.xz - center.xz));
	a *= smoothstep(fade_near * 0.3, fade_near, length(w_pos - cam));
	a *= clamp(abs(cam.y - w_pos.y) / fade_near + dist / (fade_near * 8.0), 0.0, 1.0);
	ALBEDO = no_viola(col);
	ALPHA = clamp(a * opacity, 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Launch Base Zone: le luci d'allarme rosse (#FF3A2A) in cima a torri, cupole e ciminiere: un fascio che
// gira attorno all'asse del pezzo (l'angolo attorno all'origine del pezzo, che sta nel suo piede) e un
// battito, solo emissione (niente luci vere: il tetto delle luci lo tengono le esplosioni).
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec3 color : source_color = vec3(1.0, 0.23, 0.16);
uniform float spin = 5.0;
uniform float energy = 4.0;

varying vec3 lp;
varying vec3 org;

void vertex() {
	lp = VERTEX;
	org = MODEL_MATRIX[3].xyz;
}

void fragment() {
	float a = atan(lp.z, lp.x);
	float ph = fract(dot(org.xz, vec2(0.013, 0.021)));
	float beam = pow(max(sin(a + TIME * spin + ph * 6.28), 0.0), 6.0);
	float beat = 0.55 + 0.45 * step(0.5, fract(TIME * 1.2 + ph));
	ALBEDO = color * 0.6;
	ROUGHNESS = 0.3;
	EMISSION = color * energy * (0.25 + 0.75 * beam) * beat;
}
␀␀shader_type sky;
// Launch Base Zone: il cielo del pomeriggio sulla laguna (sullo stampo di shaders/env/icz/cielo.gdshader).
// Azzurro chiaro di Sonic 3 (#8FD0FF), piÃ¹ intenso in alto, l'orizzonte velato di bianco caldo; poche
// nuvole basse a batuffolo; verso l'interno (ovest, -X) le montagne arancioni dello sfondo di Launch
// Base (#E07A3A al sole, #B8562A in ombra) con la foresta verde scuro ai piedi; a nord-ovest, lontana
// e bianca, la Cima di Ice Cap. "fumo" (0..1, la fase del cielo dopo l'affondo): un velo bruno caldo
// basso sull'orizzonte e attorno al sole, mai grigio-viola.
// Rifatto moderno: l'azzurro piÃ¹ pieno in alto, le nuvole col volume (ombra propria e bordo al sole).
// Tutto fermo (niente TIME): la radianza si rifÃ  solo quando cambia un parametro.

uniform vec3 zenith : source_color = vec3(0.11, 0.33, 0.82);
uniform vec3 mid : source_color = vec3(0.34, 0.64, 0.98);
uniform vec3 horizon : source_color = vec3(0.72, 0.86, 0.98);
uniform vec3 haze_warm : source_color = vec3(1.0, 0.93, 0.80);
uniform sampler2D cloud_noise : filter_linear_mipmap, repeat_enable;
uniform float cloud_cover = 0.6;
uniform vec3 mount_lit : source_color = vec3(0.878, 0.478, 0.227);
uniform vec3 mount_shade : source_color = vec3(0.722, 0.337, 0.165);
uniform vec3 forest : source_color = vec3(0.12, 0.33, 0.16);
uniform vec3 ice_peak : source_color = vec3(0.95, 0.97, 1.0);
uniform vec3 ice_shade : source_color = vec3(0.62, 0.74, 0.90);
uniform vec3 sea_far : source_color = vec3(0.16, 0.50, 0.56);
uniform float fumo = 0.0;
uniform vec3 smoke_col : source_color = vec3(0.42, 0.34, 0.27);

float ridge(float az, float seed) {
	float h = 0.0;
	float amp = 1.0;
	float f = 4.0;
	for (int i = 0; i < 5; i++) {
		float s = sin(az * f + seed * (1.7 + float(i)));
		h += (1.0 - abs(s)) * amp;
		amp *= 0.5;
		f *= 2.07;
	}
	return h / 1.94;
}

void sky() {
	vec3 d = normalize(EYEDIR);
	float y = d.y;
	vec3 L = LIGHT0_DIRECTION;
	float sd = dot(d, L);
	vec2 dn = normalize(d.xz + vec2(0.0001));
	float toward = max(dot(dn, normalize(L.xz + vec2(0.0001))), 0.0);
	float t1 = pow(clamp(y, 0.0, 1.0), 0.5);
	vec3 col = mix(horizon, mid, smoothstep(0.0, 0.45, t1));
	col = mix(col, zenith, smoothstep(0.45, 1.0, t1));
	// il velo caldo basso dalla parte del sole e il bagliore attorno al sole
	float band = 1.0 - smoothstep(0.0, 0.25, y);
	col = mix(col, haze_warm, band * pow(toward, 3.0) * 0.35);
	col += vec3(1.0, 0.9, 0.7) * (pow(max(sd, 0.0), 12.0) * 0.22 + pow(max(sd, 0.0), 160.0) * 0.5);
	if (!AT_CUBEMAP_PASS && sd > 0.9993) {
		col += vec3(2.4, 2.1, 1.7) * smoothstep(0.9993, 0.9996, sd);
	}
	// poche nuvole basse a batuffolo, bianche col lato al sole caldo e la pancia azzurra
	if (y > 0.015) {
		vec2 uv = d.xz / (y + 0.08) * 0.11;
		float c = texture(cloud_noise, uv * 0.55).r * 0.6 + texture(cloud_noise, uv * 1.9 + 0.31).r * 0.4;
		float dens = smoothstep(cloud_cover, cloud_cover + 0.16, c) * smoothstep(0.02, 0.12, y) * (1.0 - smoothstep(0.35, 0.7, y));
		float belly = smoothstep(cloud_cover + 0.16, cloud_cover, c);
		// il volume: un secondo campione spostato verso il sole; dove Ã¨ piÃ¹ denso di qui la nuvola
		// fa ombra a sÃ© stessa (pancia azzurro-grigia), dove Ã¨ meno il bordo prende la luce calda
		vec2 sh = normalize(L.xz + vec2(0.0001)) * 0.035;
		float c2 = texture(cloud_noise, (uv + sh) * 0.55).r * 0.6 + texture(cloud_noise, (uv + sh) * 1.9 + 0.31).r * 0.4;
		float self_sh = clamp((c2 - c) * 6.0, 0.0, 1.0);
		float rim = clamp((c - c2) * 8.0, 0.0, 1.0) * (1.0 - smoothstep(cloud_cover + 0.05, cloud_cover + 0.25, c));
		vec3 cl = mix(vec3(1.0, 0.98, 0.94), vec3(0.62, 0.74, 0.88), clamp(belly * 0.5 + self_sh * 0.55, 0.0, 1.0));
		cl = mix(cl, vec3(1.0, 0.92, 0.80), pow(toward, 3.0) * 0.3);
		cl += vec3(1.0, 0.9, 0.72) * rim * 0.35 * (0.4 + 0.6 * toward);
		col = mix(col, cl, dens * 0.92);
	}
	float az = atan(d.z, d.x);
	// la Cima di Ice Cap: lontana a nord-ovest, un picco solo, bianca con l'ombra azzurra
	vec2 icd = normalize(vec2(-0.55, -0.83));
	float ia = acos(clamp(dot(dn, icd), -1.0, 1.0));
	float ih = 0.075 * (1.0 - smoothstep(0.0, 0.16, ia)) + 0.012 * ridge(az * 3.0, 4.2) * (1.0 - smoothstep(0.0, 0.3, ia));
	if (y < ih && ih > 0.004) {
		float side = sign(dn.x * icd.y - dn.y * icd.x);
		vec3 ic = mix(ice_shade, ice_peak, side > 0.0 ? 0.85 : 0.25);
		ic = mix(ic, horizon, 0.35 + 0.3 * (1.0 - y / ih));
		col = mix(ic, col, smoothstep(ih - 0.0015, ih, y));
	}
	// le montagne arancioni verso l'interno (ovest): due file, la lontana piÃ¹ chiara nella foschia
	float west = smoothstep(-0.15, 0.55, -dn.x);
	float hf = (0.022 + 0.07 * ridge(az, 1.3)) * west;
	float hn = (0.012 + 0.05 * ridge(az + 0.7, 3.9)) * west;
	if (y < hf) {
		vec3 fr = mix(mount_lit, horizon, 0.45);
		col = mix(fr, col, smoothstep(hf - 0.0015, hf, y));
	}
	if (y < hn) {
		float k = clamp(y / max(hn, 0.001), 0.0, 1.0);
		float face = sin(az * 41.0 + ridge(az * 3.0, 2.2) * 6.0);
		vec3 mc = mix(mount_shade, mount_lit, smoothstep(-0.3, 0.5, face) * (0.55 + 0.45 * toward));
		mc = mix(mc, horizon, 0.18 * (1.0 - k));
		// la foresta ai piedi: una fascia verde scuro con l'orlo a rumore
		float fh = 0.25 + 0.12 * ridge(az * 7.0, 8.1);
		mc = mix(forest, mc, smoothstep(fh - 0.04, fh, k));
		col = mix(mc, col, smoothstep(hn - 0.0012, hn, y));
	}
	// il velo di fumo dopo l'affondo: bruno caldo basso, arancio dove passa il sole
	float sm = fumo * (1.0 - smoothstep(-0.05, 0.35, y));
	vec3 smc = mix(smoke_col, vec3(0.86, 0.52, 0.26), pow(toward, 2.0) * 0.6);
	col = mix(col, smc, sm * 0.7);
	col = mix(col, col * vec3(1.0, 0.86, 0.68), fumo * pow(max(sd, 0.0), 4.0) * 0.5);
	// sotto l'orizzonte: il mare lontano
	col = mix(col, sea_far, 1.0 - smoothstep(-0.1, 0.004, y));
	COLOR = col;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Launch Base Zone: gli sbuffi delle colonne di fumo della baia dopo l'affondo (scripts/env/gen_lbz/cielo.gd,
// una MultiMesh di quadrati per colonna, al piÃ¹ 40 sbuffi). Ogni sbuffo sale lungo la colonna e
// ricomincia dal fondo (fase = INSTANCE_CUSTOM.r + TIME), si allarga salendo, il vento lo porta di lato;
// sempre girato verso la camera. Grigio-bruno caldo (#5A4E44), chiaro dalla parte del sole e scuro
// sotto, il piede acceso d'arancio dal fuoco; mai grigio-viola. Senza luci (economico), la nebbia sÃ¬.
//   INSTANCE_CUSTOM: r = fase 0..1, g = semi 0..1, b = scala dello sbuffo, a = altezza della colonna (m)
//   l'origine della trasformazione dell'istanza = il piede della colonna
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled;

#include "res://shaders/env/lbz/lbz_common.gdshaderinc"

uniform float height_default = 260.0;
uniform float rise = 9.0;
uniform float size0 = 14.0;
uniform float size1 = 70.0;
uniform vec2 wind = vec2(0.22, 0.12);
uniform float opacity = 0.75;
uniform vec3 smoke_lit : source_color = vec3(0.56, 0.49, 0.42);
uniform vec3 smoke_dark : source_color = vec3(0.21, 0.18, 0.15);
uniform vec3 fire_col : source_color = vec3(1.0, 0.45, 0.12);

varying float v_ph;
varying float v_seed;
varying float v_a;

void vertex() {
	float seed = INSTANCE_CUSTOM.g;
	float height = INSTANCE_CUSTOM.a > 1.0 ? INSTANCE_CUSTOM.a : height_default;
	float ph = fract(INSTANCE_CUSTOM.r + TIME * rise / height);
	v_ph = ph;
	v_seed = seed;
	float h = ph * height;
	vec3 base = MODEL_MATRIX[3].xyz;
	vec3 c = base + vec3(wind.x * h, h, wind.y * h);
	c.x += sin(seed * 31.0 + h * 0.04) * (3.0 + h * 0.05);
	c.z += cos(seed * 17.0 + h * 0.035) * (3.0 + h * 0.05);
	float sz = mix(size0, size1, pow(ph, 0.8)) * (0.75 + 0.5 * seed) * max(INSTANCE_CUSTOM.b, 0.2);
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], vec4(c, 1.0));
	// un giro lento dello sbuffo su sÃ© stesso
	float a = seed * 6.28 + TIME * (seed - 0.5) * 0.2;
	v_a = a;
	vec2 v = mat2(vec2(cos(a), sin(a)), vec2(-sin(a), cos(a))) * VERTEX.xy;
	VERTEX = vec3(v * sz, 0.0);
}

void fragment() {
	vec2 q = UV * 2.0 - 1.0;
	float n = lbz_fbm(UV * 3.0 + v_seed * 19.0 + vec2(0.0, -TIME * 0.05));
	float r = length(q) + (n - 0.5) * 0.55;
	float a = 1.0 - smoothstep(0.35, 1.0, r);
	a *= smoothstep(0.0, 0.08, v_ph) * (1.0 - smoothstep(0.7, 1.0, v_ph));
	// la luce finta: una sfera girata verso la camera, il sole del pomeriggio
	vec2 lq = mat2(vec2(cos(v_a), sin(v_a)), vec2(-sin(v_a), cos(v_a))) * vec2(q.x, -q.y);
	vec3 nv = normalize(vec3(lq, sqrt(max(1.0 - dot(q, q), 0.05))));
	vec3 nw = normalize((INV_VIEW_MATRIX * vec4(nv, 0.0)).xyz);
	float lit = clamp(dot(nw, normalize(LBZ_SUN)) * 0.5 + 0.5, 0.0, 1.0);
	vec3 col = mix(smoke_dark, smoke_lit, lit * (0.6 + 0.4 * n));
	// il piede acceso dal fuoco
	float glow = 1.0 - smoothstep(0.0, 0.16, v_ph);
	col = mix(col, fire_col * 1.6, glow * 0.65 * (1.0 - r * 0.5));
	ALBEDO = col;
	ALPHA = clamp(a * opacity * (0.7 + 0.3 * n), 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Launch Base Zone: l'acqua (il mare attorno alla base e la laguna interna). Verde-azzurro di Sonic 3
// senza il lilla: chiaro (#1FA7A0) vicino alle mura, alla costa e nella laguna, profondo (#0B4E6E) al
// largo. Opaca come l'acqua di Ice Cap (shaders/env/icz/acqua.gdshader: niente lettura dello schermo
// nÃ© della profonditÃ ): increspature a rumore che scorrono (normale finta, piÃ¹ calme lontano), il
// riflesso finto del cielo del pomeriggio col Fresnel, il luccichio del sole, la schiuma bianca a
// strisce lungo le mura della base (anello di raggio foam_ring), lungo la costa della giungla
// (x = coast_a + coast_b z^2) e sui bordi della laguna (foam_rect); in piÃ¹ (la base rifatta moderna)
// un anello di schiuma al piede di pile, pontili e molo (foam_boxes: rettangoli [x0, z0, x1, z1]), la
// profonditÃ  finta (chiaro turchese vicino ai bordi coi riflessi del fondo che ballano, petrolio scuro
// in mezzo e al largo: mai verso il blu-viola) e il luccichio del sole a scintille.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/lbz/lbz_common.gdshaderinc"

uniform vec3 shallow_col : source_color = vec3(0.122, 0.655, 0.627);
uniform vec3 deep_col : source_color = vec3(0.043, 0.306, 0.431);
uniform float ripple = 0.4;
uniform float flow = 0.22;
uniform float foam_ring = 255.0;
uniform float foam_ring_w = 6.0;
uniform float coast_a = -262.0;
uniform float coast_b = -0.004;
uniform float coast_on = 1.0;
uniform vec4 foam_rect = vec4(0.0);   // x0, z0, x1, z1 (0 = niente)
uniform float shallow_all = 0.0;      // 1: tutta chiara (la laguna)
uniform vec4 foam_boxes[16];
uniform int n_boxes = 0;
uniform vec3 mid_col : source_color = vec3(0.05, 0.47, 0.52);

varying vec3 wp;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 p = wp.xz;
	float t = TIME * flow;
	float dist = length(VERTEX);
	float calm = 1.0 - smoothstep(60.0, 420.0, dist);
	float h1 = lbz_fbm(p * 0.28 + vec2(t, t * 0.6));
	vec2 e = vec2(0.2, 0.0);
	float hx = lbz_fbm((p + e.xy) * 0.28 + vec2(t, t * 0.6)) - h1;
	float hz = lbz_fbm((p + e.yx) * 0.28 + vec2(t, t * 0.6)) - h1;
	float h2 = lbz_noise(p * 1.1 - vec2(t * 1.7, -t * 0.9));
	float k = ripple * (0.25 + 0.75 * calm);
	vec3 nw = normalize(vec3(-hx * k * 5.0 + (h2 - 0.5) * k * 0.3 * calm, 1.0, -hz * k * 5.0 + (0.5 - h2) * k * 0.3 * calm));
	NORMAL = normalize((VIEW_MATRIX * vec4(nw, 0.0)).xyz);
	// quanto Ã¨ basso: vicino alle mura (dentro e fuori), alla costa, ai bordi della laguna
	float r = length(p);
	float d_ring = abs(r - foam_ring);
	float cx = coast_a + coast_b * p.y * p.y;
	float d_coast = coast_on > 0.5 ? abs(p.x - cx) : 1e5;
	float d_rect = 1e5;
	if (foam_rect.z > foam_rect.x) {
		vec2 dr = min(p - foam_rect.xy, foam_rect.zw - p);
		d_rect = min(dr.x, dr.y);
	}
	// il piede delle cose nell'acqua (pile, pontili, molo)
	float d_box = 1e5;
	for (int i = 0; i < n_boxes; i++) {
		vec4 bx = foam_boxes[i];
		vec2 c = (bx.xy + bx.zw) * 0.5;
		vec2 hb = (bx.zw - bx.xy) * 0.5;
		vec2 dd = max(abs(p - c) - hb, vec2(0.0));
		d_box = min(d_box, length(dd));
	}
	float shallow = max(1.0 - smoothstep(10.0, 140.0, d_ring), 1.0 - smoothstep(0.0, 120.0, d_coast));
	// la laguna: chiara sui bordi, piÃ¹ fonda in mezzo (sempre piÃ¹ chiara del mare)
	shallow = max(shallow, shallow_all * (0.35 + 0.65 * (1.0 - smoothstep(2.0, 26.0, d_rect))));
	vec3 col = mix(deep_col, mid_col, smoothstep(0.0, 0.45, shallow));
	col = mix(col, shallow_col, smoothstep(0.4, 1.0, shallow) * (0.8 + 0.2 * h1));
	// i riflessi del fondo nell'acqua bassa (reticolo di Voronoi che balla), da vicino
	vec3 vo = lbz_voronoi(p * 0.45 + vec2(t * 0.8, -t * 0.5) + h1 * 1.5);
	float caus = (1.0 - smoothstep(0.0, 0.12, vo.y)) * smoothstep(0.55, 0.95, shallow) * calm;
	// la schiuma: strisce che vanno e vengono vicino ai bordi
	float d_foam = min(min(d_ring - foam_ring_w * 0.5, d_coast), d_rect);
	float wave = sin(d_foam * 0.9 - TIME * 1.6 + h1 * 4.0) * 0.5 + 0.5;
	float fn = lbz_fbm(p * 0.6 + vec2(t * 2.0, 0.0));
	float foam = (1.0 - smoothstep(0.0, 5.0, d_foam)) * smoothstep(0.35, 0.65, fn + wave * 0.35);
	foam += (1.0 - smoothstep(5.0, 16.0, d_foam)) * smoothstep(0.82, 0.95, wave) * smoothstep(0.45, 0.7, fn) * 0.6;
	// l'anello al piede delle pile: fitto attaccato, poi a brandelli che si allargano e tornano
	float wb = sin(d_box * 2.2 - TIME * 2.4 + h1 * 3.0) * 0.5 + 0.5;
	float fb = lbz_fbm(p * 1.3 + vec2(-t * 2.5, t));
	foam += (1.0 - smoothstep(0.0, 0.9, d_box)) * smoothstep(0.25, 0.55, fb + 0.25);
	foam += (1.0 - smoothstep(0.6, 3.2, d_box)) * smoothstep(0.7, 0.95, wb) * smoothstep(0.4, 0.65, fb) * 0.8;
	foam = clamp(foam, 0.0, 1.0);
	vec3 V = normalize((INV_VIEW_MATRIX * vec4(VIEW, 0.0)).xyz);
	float fr = 0.02 + 0.98 * pow(1.0 - clamp(dot(nw, V), 0.0, 1.0), 5.0);
	vec3 R = reflect(-V, nw);
	// il luccichio: scintille dove l'increspatura riflette il sole
	float sun = max(dot(R, normalize(LBZ_SUN)), 0.0);
	float spark = pow(sun, 600.0) * 6.0 + pow(sun, 60.0) * 0.25;
	ALBEDO = mix(col, vec3(0.93, 0.97, 0.98), foam);
	ROUGHNESS = mix(0.08, 0.7, foam);
	SPECULAR = 0.5;
	EMISSION = (lbz_sky_refl(R) * fr * 0.42 + vec3(1.0, 0.95, 0.85) * spark * calm + vec3(0.55, 0.95, 0.9) * caus * 0.12) * (1.0 - foam);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Launch Base Zone: i pavimenti della base (il tavolato delle zolle, il cemento dei camminamenti, delle
// rampe e dei ponti). Lastre di cemento grandi (slab metri) sulle UV in metri delle facce, coi giunti di
// dilatazione incassati e smussati, ogni lastra un po' diversa di tono, la variazione larga a rumore
// (niente ripetizione vista dall'alto), le macchie d'olio e di bagnato (Voronoi), i graffi; qualche lastra
// Ã¨ un chiusino d'acciaio a bugne (hatch: la probabilitÃ ) e qualche altra ha la riga di vernice gialla
// lungo il bordo (paint_p). Sulle pareti dei pezzi lo stesso cemento coi fori dei casseri. "bruciato"
// (per istanza) come gli altri materiali della base. Sul tavolato la segnaletica (coordinate del mondo:
// le UV delle zolle sono x, z in metri): le righe gialle ai bordi del Viale e la mezzeria bianca a
// tratti (viale: x0, z0, x1, z1), l'anello a strisce di pericolo e il cerchio della piazzola attorno
// alla Torre del Lancio (pad: x, z, raggio). Leggono la direzione della corsa anche da lontano.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/lbz/lbz_common.gdshaderinc"

uniform vec3 base_a : source_color = vec3(0.40, 0.40, 0.41);
uniform vec3 base_b : source_color = vec3(0.31, 0.315, 0.33);
uniform vec3 joint : source_color = vec3(0.16, 0.16, 0.17);
uniform vec3 line_col : source_color = vec3(0.95, 0.70, 0.10);
uniform vec3 steel : source_color = vec3(0.42, 0.45, 0.48);
uniform vec2 slab = vec2(6.0, 6.0);
uniform float joint_w = 0.06;
uniform float hatch = 0.015;
uniform float paint_p = 0.03;
uniform float relief = 1.0;
uniform vec4 viale = vec4(0.0);
uniform vec3 pad = vec3(0.0);
uniform vec3 mark_white : source_color = vec3(0.86, 0.87, 0.84);
instance uniform float bruciato = 0.0;

varying vec3 wn;

void vertex() {
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec2 p = UV;
	vec2 fw2 = fwidth(p);
	float fw = max(max(fw2.x, fw2.y), 1e-4);
	float far = smoothstep(0.04, 0.14, fw);
	float top = smoothstep(0.6, 0.85, abs(wn.y));
	vec2 q = p / slab;
	vec2 cell = floor(q);
	vec2 f = fract(q);
	vec2 dm = min(f, 1.0 - f) * slab;
	float edge = min(dm.x, dm.y);
	float jw = joint_w * 0.5;
	float jnt = (1.0 - smoothstep(jw - fw * 0.5, jw + fw * 0.5, edge));
	jnt = mix(jnt, 0.12, far);
	float prof = smoothstep(jw, jw + 0.05 + fw, edge);
	float hc = lbz_hash(cell + 0.37);
	float hc2 = lbz_hash(cell + 9.1);
	float macro = lbz_fbm(p * 0.035);
	float n = lbz_fbm(p * 0.6);
	float grain = lbz_noise(p * 9.0) * (1.0 - smoothstep(0.01, 0.05, fw));
	vec3 col = mix(base_a, base_b, clamp(hc * 0.35 + macro * 0.7 + n * 0.2 - 0.2, 0.0, 1.0));
	col *= 0.96 + 0.05 * grain;
	// le macchie scure (olio, bagnato) e quelle chiare (polvere): Voronoi largo
	vec3 vo = lbz_voronoi(p * 0.11 + vec2(3.1, 7.7));
	float stain = (1.0 - smoothstep(0.1, 0.45, vo.x)) * step(0.62, vo.z) * top;
	col *= 1.0 - stain * 0.32 * (0.6 + 0.4 * n);
	float dust = smoothstep(0.55, 0.85, lbz_fbm(p * 0.08 + 5.0)) * 0.12;
	col = mix(col, vec3(0.62, 0.58, 0.50), dust);
	float rough = mix(0.88, 0.62, stain);
	float met = 0.0;
	// il chiusino d'acciaio: bugne a rombo, cornice, quattro bulloni
	float is_hatch = step(hc2, hatch) * top;
	if (is_hatch > 0.5) {
		vec2 hp = p * 3.2;
		vec2 hd = abs(fract(vec2(hp.x + hp.y, hp.x - hp.y) * 0.5) - 0.5);
		float bump = (1.0 - smoothstep(0.08, 0.16, min(hd.x, hd.y))) * (1.0 - smoothstep(0.01, 0.04, fw));
		float frame = 1.0 - smoothstep(0.25, 0.3, edge);
		col = mix(steel * (0.85 + 0.2 * n), steel * 0.6, frame) * (1.0 - bump * 0.12);
		rough = 0.45 + n * 0.2;
		met = 0.75;
		prof += bump * 0.4;
	}
	// la riga gialla consumata lungo un bordo della lastra
	float pl = step(hc, paint_p) * top * (1.0 - is_hatch);
	float lw = smoothstep(jw + 0.12, jw + 0.12 + fw, dm.x) * (1.0 - smoothstep(jw + 0.4, jw + 0.4 + fw, dm.x));
	float worn = smoothstep(0.35, 0.6, lbz_fbm(p * 1.4 + 2.0));
	col = mix(col, line_col * (0.85 + 0.15 * n), pl * lw * worn * (1.0 - far * 0.5));
	// la segnaletica (solo in su, solo se data)
	float mk = 0.0;
	vec3 mkc = line_col;
	if (viale.z > viale.x && top > 0.5) {
		float zin = step(viale.y, p.y) * step(p.y, viale.w);
		float xl = min(abs(p.x - viale.x - 0.8), abs(p.x - viale.z + 0.8));
		float edge_l = (1.0 - smoothstep(0.22, 0.22 + fw, xl)) * zin;
		float xc = abs(p.x - (viale.x + viale.z) * 0.5);
		float dash = step(0.45, fract(p.y / 9.0));
		float mid = (1.0 - smoothstep(0.14, 0.14 + fw, xc)) * dash * zin;
		mk = max(edge_l, mid);
		mkc = mix(line_col, mark_white, step(edge_l, 0.01));
	}
	if (pad.z > 0.0 && top > 0.5) {
		float d = length(p - pad.xy);
		float ring = step(pad.z, d) * step(d, pad.z + 1.6);
		vec2 pr = p - pad.xy;
		float ang = atan(pr.y, pr.x) * pad.z;
		float stripe = step(0.5, fract(ang / 2.2 + d * 0.0));
		float circ = 1.0 - smoothstep(0.2, 0.2 + fw, abs(d - pad.z - 3.0));
		if (ring > 0.5) {
			mk = 1.0;
			mkc = mix(line_col, vec3(0.06), stripe);
		} else if (circ > 0.0) {
			mk = max(mk, circ);
			mkc = mark_white;
		}
	}
	col = mix(col, mkc * (0.85 + 0.15 * n), mk * (0.55 + 0.45 * worn) * (1.0 - is_hatch));
	rough = mix(rough, 0.6, mk);
	// le pareti: i fori dei casseri a griglia
	vec2 tp = fract(p / vec2(1.2, 0.9)) - 0.5;
	float tie = (1.0 - smoothstep(0.03, 0.05, length(tp * vec2(1.2, 0.9)))) * (1.0 - top) * (1.0 - smoothstep(0.01, 0.03, fw));
	col *= 1.0 - tie * 0.5;
	col = mix(col, joint, jnt);
	// lo sporco al piede delle pareti
	col *= 1.0 - (1.0 - top) * (1.0 - smoothstep(0.0, 2.5, UV2.y)) * 0.3;
	vec2 so = lbz_soot(bruciato, p + UV2.x * 11.3, TIME, fw);
	col = mix(col, vec3(0.09, 0.08, 0.07), so.x);
	ALBEDO = col;
	ROUGHNESS = mix(rough, 0.95, so.x);
	METALLIC = met * (1.0 - so.x);
	SPECULAR = 0.4;
	NORMAL = lbz_bump(NORMAL, VERTEX, prof * 0.025 - tie * 0.01 + grain * 0.002, relief * (1.0 - far));
	EMISSION = vec3(1.0, 0.36, 0.08) * so.y * 2.2;
}
␀␀␀␀␀␀␀␀␀␀␀// Launch Base Zone: i pezzi in comune degli shader della base (mattoni, metallo, vetro_acqua, laguna,
// terreno, fumo). Sullo stampo di shaders/env/icz/icz_common.gdshaderinc, coi colori del pomeriggio:
//   - rumore (hash, value noise, fbm a tre ottave, Voronoi);
//   - rilievo dalle derivate (un'altezza H, senza tangenti: vale anche sui pezzi che cadono);
//   - il riflesso finto del cielo del pomeriggio (azzurro chiaro, il sole caldo a 35 gradi da sud-ovest:
//     SUN_DIR di scripts/env/gen_lbz/cielo.gd) per l'acqua e il metallo, niente SSR nÃ© sonde;
//   - la fuliggine dei pezzi bruciati (instance uniform "bruciato" 0..1 che scripts/vfx/lbz_crollo.gd
//     accende sui pezzi dei crolli): macchie nere che si allargano, braci arancio nelle crepe.

float lbz_hash(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

vec2 lbz_hash2(vec2 p) {
	return vec2(lbz_hash(p), lbz_hash(p + vec2(17.3, 41.9)));
}

float lbz_noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = lbz_hash(i);
	float b = lbz_hash(i + vec2(1.0, 0.0));
	float c = lbz_hash(i + vec2(0.0, 1.0));
	float d = lbz_hash(i + vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float lbz_fbm(vec2 p) {
	float s = lbz_noise(p) * 0.5;
	p = p * 2.03 + vec2(17.1, 9.3);
	s += lbz_noise(p) * 0.25;
	p = p * 2.03 + vec2(17.1, 9.3);
	s += lbz_noise(p) * 0.125;
	return s / 0.875;
}

// Voronoi: x = distanza dal centro piÃ¹ vicino, y = distanza dal bordo della cella, z = id della cella
vec3 lbz_voronoi(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	float d1 = 8.0;
	float d2 = 8.0;
	vec2 best = vec2(0.0);
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 g = vec2(float(x), float(y));
			vec2 o = lbz_hash2(i + g) * 0.85 + 0.075;
			vec2 r = g + o - f;
			float d = dot(r, r);
			if (d < d1) {
				d2 = d1;
				d1 = d;
				best = i + g;
			} else if (d < d2) {
				d2 = d;
			}
		}
	}
	return vec3(sqrt(d1), sqrt(d2) - sqrt(d1), lbz_hash(best));
}

// rilievo: n normale (spazio di vista), p posizione (stessa base), h altezza in metri, k forza
vec3 lbz_bump(vec3 n, vec3 p, float h, float k) {
	vec3 dpdx = dFdx(p);
	vec3 dpdy = dFdy(p);
	float hx = dFdx(h) * k;
	float hy = dFdy(h) * k;
	vec3 r1 = cross(dpdy, n);
	vec3 r2 = cross(n, dpdx);
	float det = dot(dpdx, r1);
	vec3 g = sign(det) * (hx * r1 + hy * r2);
	return normalize(abs(det) * n - g);
}

// il cielo del pomeriggio visto in un riflesso (R nel mondo): azzurro chiaro all'orizzonte, piÃ¹
// intenso in alto, il bagliore caldo del sole; sotto l'orizzonte il verde-azzurro del mare
const vec3 LBZ_SUN = vec3(-0.62, 0.574, 0.535);

vec3 lbz_sky_refl(vec3 R) {
	vec3 zen = vec3(0.30, 0.58, 0.94);
	vec3 hor = vec3(0.74, 0.88, 1.0);
	vec3 col = mix(hor, zen, smoothstep(0.0, 0.75, R.y));
	float sun = max(dot(normalize(R), normalize(LBZ_SUN)), 0.0);
	col += vec3(1.0, 0.86, 0.62) * (pow(sun, 8.0) * 0.35 + pow(sun, 200.0) * 2.5);
	col = mix(col, vec3(0.10, 0.42, 0.46), smoothstep(0.02, -0.3, R.y));
	return col;
}

// la fuliggine: amt 0..1 (quanto Ã¨ bruciato), p coordinate della faccia in metri, fw metri per pixel
// (lontano niente vene sottili: farebbero puntini); torna vec2(copertura nera 0..1, braci 0..1)
vec2 lbz_soot(float amt, vec2 p, float t, float fw) {
	if (amt <= 0.001) {
		return vec2(0.0);
	}
	float n = lbz_fbm(p * 0.3) * 0.75 + lbz_noise(p * 0.9) * 0.25;
	// anche del tutto bruciato resta qualcosa del colore (al piÃ¹ ~70 % coperto: niente sagome nere)
	float th = 1.05 - amt * 0.6;
	float cover = smoothstep(th, th + 0.25, n) * 0.85;
	// le braci: nelle macchie piÃ¹ scure, a vene, che pulsano piano
	float vein = 1.0 - smoothstep(0.0, 0.07, abs(lbz_noise(p * 0.8 + 7.0) - 0.5));
	float puls = 0.6 + 0.4 * sin(t * 2.3 + lbz_hash(floor(p * 0.5)) * 6.28);
	float ember = vein * smoothstep(th + 0.12, th + 0.3, n) * amt * puls * (1.0 - smoothstep(0.03, 0.12, fw));
	return vec2(cover, ember);
}
␀␀␀␀shader_type spatial;
// Launch Base Zone: le strisce di luce della base (lungo i parapetti, sulle teste dei fari, sulle
// antenne). Solo emissione (niente luci vere: il tetto delle luci lo tengono le esplosioni), azzurra
// (#73EBFF: col cielo e col fuoco arancio non fa mai viola), con un'onda piÃ¹ chiara che corre lungo la
// striscia (UV u in metri) e il bagliore che la ammorbidisce. "bruciato" (per istanza): la luce
// sfarfalla e si spegne.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec3 color : source_color = vec3(0.45, 0.92, 1.0);
uniform float energy = 3.5;
uniform float chase = 1.0;
instance uniform float bruciato = 0.0;

varying vec3 org;

void vertex() {
	org = MODEL_MATRIX[3].xyz;
}

void fragment() {
	float ph = fract(dot(org.xz, vec2(0.013, 0.021)));
	float run = 0.75 + 0.25 * smoothstep(0.6, 1.0, sin(UV.x * 0.35 - TIME * 3.0 + ph * 6.28)) * chase;
	float alive = 1.0 - smoothstep(0.15, 0.4, bruciato) * step(0.3, fract(TIME * 7.0 + ph * 3.1));
	alive *= 1.0 - smoothstep(0.4, 0.6, bruciato);
	ALBEDO = color * 0.25;
	ROUGHNESS = 0.25;
	EMISSION = color * energy * run * alive;
}
␀␀␀␀␀shader_type spatial;
// Launch Base Zone: i mattoni gialli della base (le mura, le torri, i palazzi). File sfalsate sulle UV
// in metri delle facce (mesh_lbz.gd: u lungo il muro, v la quota), cosÃ¬ il disegno resta attaccato al
// pezzo anche quando cade; ogni mattone un po' diverso fra il giallo al sole (#E8B53A) e quello in
// ombra (#B57E1E), la malta bruna (#7A5A2A) incassata (rilievo dalle derivate), un velo di sporco
// che cola dall'alto. "scuro" per la variante dei basamenti; "bruciato" (per istanza, lo accende
// scripts/vfx/lbz_crollo.gd) annerisce i pezzi dei crolli con le braci nelle crepe.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/lbz/lbz_common.gdshaderinc"

uniform vec3 brick_sun : source_color = vec3(0.91, 0.71, 0.23);
uniform vec3 brick_shade : source_color = vec3(0.71, 0.49, 0.12);
uniform vec3 mortar : source_color = vec3(0.48, 0.35, 0.16);
uniform vec2 brick_size = vec2(1.5, 0.6);
uniform float mortar_w = 0.045;
uniform float scuro = 0.0;
uniform float relief = 1.0;
instance uniform float bruciato = 0.0;

varying vec3 wn;

void vertex() {
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec2 p = UV;
	float row = floor(p.y / brick_size.y);
	float off = mod(row, 2.0) * 0.5;
	vec2 q = vec2(p.x / brick_size.x + off, p.y / brick_size.y);
	vec2 cell = floor(q);
	vec2 f = fract(q);
	// la malta: distanza dal bordo del mattone (in metri)
	vec2 dm = min(f, 1.0 - f) * brick_size;
	float edge = min(dm.x, dm.y);
	// quanti metri copre un pixel: la malta e il dettaglio fine si sfumano quando diventano piÃ¹ piccoli
	// di un pixel (niente puntini lontano), il rilievo pure
	vec2 fw2 = fwidth(p);
	float fw = max(max(fw2.x, fw2.y), 1e-4);
	float far = smoothstep(mortar_w * 0.5, mortar_w * 2.5, fw);
	float brick = smoothstep(mortar_w * 0.5 - fw * 0.5, mortar_w * 0.5 + fw * 0.5, edge);
	brick = mix(brick, 0.86, far);
	float cells = 1.0 - smoothstep(0.08, 0.35, fw);
	float h1 = mix(0.5, lbz_hash(cell + vec2(row * 3.1, 0.7)), cells);
	float n = lbz_fbm(p * 1.7);
	vec3 bc = mix(brick_sun, brick_shade, h1 * 0.55 + n * 0.25);
	bc *= 1.0 + (0.16 * lbz_noise(p * 6.0 + cell * 1.3) - 0.08) * (1.0 - smoothstep(0.04, 0.16, fw));
	// sui tetti piani (facce in su) il disegno Ã¨ piÃ¹ fitto e chiaro (lastre di pietra gialla)
	float top = smoothstep(0.75, 0.95, wn.y);
	vec3 col = mix(mortar * (0.85 + 0.3 * n), bc, brick);
	col = mix(col, col * vec3(0.72, 0.68, 0.62), scuro);
	// il velo di sporco che cola (righe verticali di rumore, piÃ¹ in basso)
	float drip = lbz_noise(vec2(p.x * 2.2, p.y * 0.08)) * (1.0 - top);
	col *= 1.0 - 0.18 * smoothstep(0.45, 0.9, drip);
	// la fuliggine dei crolli
	vec2 so = lbz_soot(bruciato, p + UV2.x * 13.7, TIME, fw);
	col = mix(col, vec3(0.11, 0.085, 0.065), so.x);
	ALBEDO = col;
	ROUGHNESS = mix(0.95, 0.82, brick) - top * 0.05;
	SPECULAR = 0.3;
	float hh = brick * 0.02 + n * 0.006;
	NORMAL = lbz_bump(NORMAL, VERTEX, hh, relief * (1.0 - far));
	EMISSION = vec3(1.0, 0.36, 0.08) * so.y * (1.0 - brick * 0.6) * 2.2;
}
␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Launch Base Zone: l'acciaio della base (gru, tralicci, tubi, ballatoi, il serbatoio, i corpi dei
// parapetti). Grigio-azzurro (#5A6E8C, la variante chiara #9AB0C8) a piastre sulle UV in metri delle
// facce: giunti incassati e smussati (la luce prende un bordo, l'ombra l'altro: rilievo dalle derivate),
// i ribattini lungo i giunti, ogni piastra un po' diversa di tono e di ruvidezza (l'acciaio vero non Ã¨
// mai uniforme), gli spigoli lucidati dall'uso, righe di ruggine e sporco che colano, il riflesso del
// cielo del pomeriggio (quello vero della radianza piÃ¹ un velo finto col Fresnel). "ondulato" = 1: la
// lamiera grecata (tetti, container). "strisce" = 1: le strisce di pericolo gialle e grafite in
// diagonale, coi bordi netti e la vernice scheggiata fino al metallo. "bruciato" (per istanza) come i
// pannelli.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/lbz/lbz_common.gdshaderinc"

uniform vec3 steel : source_color = vec3(0.353, 0.431, 0.549);
uniform vec3 rust : source_color = vec3(0.42, 0.27, 0.15);
uniform vec2 panel = vec2(2.4, 1.6);
uniform float strisce = 0.0;
uniform float ondulato = 0.0;
uniform vec3 stripe_yellow : source_color = vec3(0.96, 0.70, 0.06);
uniform vec3 stripe_black : source_color = vec3(0.09, 0.10, 0.11);
uniform float stripe_w = 0.45;
uniform float metal = 0.7;
uniform float relief = 1.0;
instance uniform float bruciato = 0.0;

void fragment() {
	vec2 p = UV;
	vec2 q = p / panel;
	vec2 cell = floor(q);
	vec2 f = fract(q);
	vec2 dm = min(f, 1.0 - f) * panel;
	float edge = min(dm.x, dm.y);
	vec2 fw2 = fwidth(p);
	float fw = max(max(fw2.x, fw2.y), 1e-4);
	float far = smoothstep(0.02, 0.08, fw);
	float seam = (1.0 - smoothstep(0.018 - fw * 0.5, 0.018 + fw * 0.5, edge)) * (1.0 - far * 0.7);
	float prof = smoothstep(0.0, 0.05 + fw, edge);
	// i ribattini: a passo fisso lungo i giunti (solo da vicino)
	vec2 rv = vec2(fract(p.x / 0.3), fract(p.y / 0.3)) - 0.5;
	float near = 1.0 - smoothstep(0.07, 0.12, edge);
	float rivet = near * (1.0 - smoothstep(0.08, 0.15, length(rv))) * (1.0 - seam) * (1.0 - smoothstep(0.01, 0.03, fw));
	float hc = lbz_hash(cell + 3.7);
	float n = lbz_fbm(p * 1.3);
	float fine = lbz_noise(p * vec2(18.0, 2.0)) * (1.0 - smoothstep(0.01, 0.04, fw));   // la spazzolatura
	vec3 col = steel * (0.84 + 0.26 * hc) * (0.9 + 0.14 * n) * (0.97 + 0.06 * fine);
	// la lamiera grecata
	float wave = 0.0;
	if (ondulato > 0.5) {
		wave = 0.5 + 0.5 * sin(p.x * 6.2832 / 0.35);
		col *= 0.9 + 0.14 * wave * (1.0 - far);
	}
	// sporco e ruggine che colano dai giunti di sopra
	float streak = lbz_noise(vec2(p.x * 3.0, p.y * 0.25)) * (1.0 - f.y * 0.6);
	float rs = smoothstep(0.66, 0.95, streak) * 0.5;
	col = mix(col, rust, rs);
	// gli spigoli delle piastre lucidati
	float shine = (1.0 - smoothstep(0.02, 0.07, edge)) * (1.0 - seam) * (1.0 - far);
	col = mix(col, col * 1.25 + 0.04, shine * 0.6);
	col *= 1.0 - seam * 0.6;
	col += vec3(0.06) * rivet;
	float rough = clamp(mix(0.3, 0.7, rs + n * 0.3 + hc * 0.25) - shine * 0.15, 0.12, 0.95);
	float met = metal * (1.0 - rs * 0.8);
	if (strisce > 0.5) {
		float d = fract((p.x + p.y) / (stripe_w * 2.0));
		float bw = fw / (stripe_w * 2.0);
		float band = smoothstep(0.5 - bw, 0.5 + bw, d) * (1.0 - smoothstep(1.0 - bw * 2.0, 1.0, d));
		band = mix(band, 0.5, smoothstep(0.15, 0.4, fw / stripe_w));
		vec3 sc = mix(stripe_yellow * (0.92 + 0.12 * hc), stripe_black, band);
		// le schegge: la vernice va via a chiazze vicino ai giunti e lascia il metallo
		float chip = smoothstep(0.7, 0.8, lbz_fbm(p * vec2(4.0, 1.2) + 11.0) + near * 0.2) * (1.0 - far * 0.5);
		col = mix(sc * (0.88 + 0.12 * n) * (1.0 - seam * 0.5), col, chip);
		rough = mix(0.5 + n * 0.15, rough, chip);
		met = mix(0.08, met, chip);
	}
	vec2 so = lbz_soot(bruciato, p + UV2.x * 7.3, TIME, fw);
	col = mix(col, vec3(0.10, 0.085, 0.075), so.x);
	rough = mix(rough, 0.95, so.x);
	ALBEDO = col;
	METALLIC = met * (1.0 - so.x);
	ROUGHNESS = rough;
	SPECULAR = 0.5;
	NORMAL = lbz_bump(NORMAL, VERTEX, prof * 0.012 + rivet * 0.012 + wave * 0.02 * ondulato, relief * (1.0 - far));
	// il cielo nel metallo (finto, un po'): solo dove non Ã¨ vernice o fuliggine
	vec3 wnrm = normalize((INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
	vec3 V = normalize((INV_VIEW_MATRIX * vec4(VIEW, 0.0)).xyz);
	float fr = pow(1.0 - clamp(dot(wnrm, V), 0.0, 1.0), 4.0);
	EMISSION = lbz_sky_refl(reflect(-V, wnrm)) * fr * 0.2 * met + vec3(1.0, 0.36, 0.08) * so.y * 2.0;
}
shader_type spatial;
// Launch Base Zone: le palme della giungla e del Promontorio (scripts/env/gen_lbz/giungla.gd, MultiMesh a
// celle). Il colore Ã¨ nei vertici (tronco bruno ad anelli, fronde verdi #2F8F3A / #1E5E2A piÃ¹ chiare in
// punta); COLOR.a Ã¨ quanto si muove col vento (0 al piede, 1 in punta alle fronde). Ogni palma ha la
// sua fase (dalla posizione dell'istanza). La luce passa un po' dalle fronde (BACKLIGHT).
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform float sway = 0.32;

varying vec3 vcol;
varying float vw;

void vertex() {
	vec3 org = MODEL_MATRIX[3].xyz;
	float ph = fract(sin(dot(org.xz, vec2(12.9898, 78.233))) * 43758.5453) * 6.2832;
	float w = COLOR.a;
	float t = TIME * 1.25 + ph;
	VERTEX.x += sin(t) * sway * w * w;
	VERTEX.z += cos(t * 0.83) * sway * 0.6 * w * w;
	VERTEX.y += sin(t * 1.9 + VERTEX.x * 0.7) * 0.07 * w;
	vcol = pow(COLOR.rgb, vec3(2.2));   // scritti in sRGB (giungla.gd)
	vw = w;
}

void fragment() {
	ALBEDO = vcol;
	ROUGHNESS = 0.82;
	SPECULAR = 0.3;
	BACKLIGHT = vcol * 0.45 * step(0.05, vw);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Launch Base Zone: il rivestimento della base di Eggman (al posto dei mattoni gialli: le mura, le torri,
// i palazzi, i piloni). Lamiere verniciate di giallo arancio (#E39A24 al sole) a pannelli grandi sulle
// UV in metri delle facce (mesh_lbz.gd: u lungo il muro, v = la quota del mondo), coi giunti smussati
// (rilievo dalle derivate: la luce prende il bordo alto, l'ombra quello basso), i ribattini lungo i
// giunti, le nervature verticali, la vernice consumata sugli spigoli fino all'acciaio. Ogni band_every
// metri di quota una fascia d'acciaio scuro con la striscia di luce (azzurra, a trattini: niente luci
// vere, solo emissione che il bagliore ammorbidisce); con "finestre" = 1 (torri e palazzi) le file di
// vetrate scure fra le fasce, qualcuna accesa. Sopra (facce in su) lastre d'acciaio a quadri. Lo sporco
// sale dal piede del pezzo (UV2.y) e cola sotto le fasce. "scuro" = 1: tutto acciaio grafite (basamenti,
// cornici, i fianchi delle zolle). "bruciato" (per istanza, scripts/vfx/lbz_crollo.gd) come prima:
// la fuliggine, le braci, e le luci si spengono a scatti.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/lbz/lbz_common.gdshaderinc"

uniform vec3 paint : source_color = vec3(0.93, 0.56, 0.12);
uniform vec3 paint_b : source_color = vec3(0.84, 0.44, 0.09);
uniform vec3 trim : source_color = vec3(0.13, 0.15, 0.18);
uniform vec3 steel : source_color = vec3(0.50, 0.54, 0.58);
uniform vec3 light_col : source_color = vec3(0.45, 0.92, 1.0);
uniform float light_energy = 3.2;
uniform vec2 panel = vec2(3.0, 2.0);
uniform float band_every = 8.0;
uniform float band_h = 1.0;
uniform float finestre = 0.0;
uniform float scuro = 0.0;
uniform float ribs = 1.0;
uniform float relief = 1.0;
instance uniform float bruciato = 0.0;

varying vec3 wn;

void vertex() {
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec2 p = UV;
	vec2 fw2 = fwidth(p);
	float fw = max(max(fw2.x, fw2.y), 1e-4);
	float side = 1.0 - smoothstep(0.55, 0.8, abs(wn.y));     // 1 sulle pareti, 0 sopra e sotto
	float top = smoothstep(0.75, 0.95, wn.y);
	float far = smoothstep(0.03, 0.1, fw);                     // il dettaglio fine sparisce lontano
	float n = lbz_fbm(p * 0.9);
	float n2 = lbz_noise(p * 7.0);

	// ---- i pannelli: file sfalsate di mezzo pannello, giunto smussato (bev metri)
	vec2 pn = mix(panel, vec2(2.0, 2.0), top);
	float row = floor(p.y / pn.y);
	vec2 q = vec2(p.x / pn.x + mod(row, 2.0) * 0.5 * (1.0 - top), p.y / pn.y);
	vec2 cell = floor(q);
	vec2 f = fract(q);
	vec2 dm = min(f, 1.0 - f) * pn;
	float edge = min(dm.x, dm.y);
	float bev = 0.06;
	float prof = smoothstep(0.0, bev + fw, edge);              // 0 sul giunto, 1 sulla faccia
	float seam = (1.0 - smoothstep(0.012, 0.012 + fw * 1.5, edge)) * (1.0 - far * 0.6);
	float hc = lbz_hash(cell + vec2(row * 1.7, 3.1));
	// le nervature verticali (lamiera grecata, solo sulle pareti e da vicino)
	float rib = (0.5 + 0.5 * cos(p.x * 6.2832 / 0.5)) * ribs * side * (1.0 - smoothstep(0.015, 0.05, fw));
	// i ribattini lungo i giunti orizzontali
	vec2 rv = vec2(fract(p.x / 0.4) - 0.5, (dm.y - 0.12) / 0.4);
	float rivet = (1.0 - smoothstep(0.05, 0.09, length(rv))) * step(dm.y, 0.25) * (1.0 - smoothstep(0.008, 0.025, fw));

	// ---- la fascia d'acciaio con la luce (solo sulle pareti)
	float by = fract(p.y / band_every) * band_every;          // metri sopra l'ultima fascia
	float band = (1.0 - smoothstep(band_h - fw, band_h + fw, by)) * side;
	float lstrip = (1.0 - smoothstep(0.09 - fw, 0.09 + fw, abs(by - band_h * 0.5))) * band;
	float dash = smoothstep(0.08, 0.12, fract(p.x / 2.4)) * (1.0 - smoothstep(0.88, 0.92, fract(p.x / 2.4)));
	lstrip *= mix(dash, 0.8, far);

	// ---- le vetrate (fra le fasce): una fila alta 2.2 m a metÃ  del piano
	float win = 0.0;
	float lit = 0.0;
	if (finestre > 0.5) {
		float wy = by - (band_h + 1.6);
		float wrow = step(0.0, wy) * step(wy, 2.2) * side;
		float mx = fract(p.x / 1.6);
		float mull = smoothstep(0.04, 0.06 + fw, mx) * (1.0 - smoothstep(0.94 - fw, 0.96, mx));
		float trn = smoothstep(0.05, 0.08 + fw, wy) * (1.0 - smoothstep(2.12 - fw, 2.15, wy));
		win = wrow * mix(mull * trn, 0.85, far);
		float pid = lbz_hash(vec2(floor(p.x / 1.6), floor(p.y / band_every)) + 5.3);
		lit = step(0.72, pid) * win;
	}

	// ---- il colore
	vec3 pc = mix(paint, paint_b, hc * 0.45 + n * 0.3);
	pc = mix(pc, trim * 1.25, scuro);
	pc = mix(pc, steel * 0.55, top * (1.0 - scuro) * 0.85);   // i tetti: acciaio, non vernice
	pc *= 0.94 + 0.12 * hc;
	// la vernice consumata sugli spigoli dei pannelli: affiora l'acciaio
	float wear = (1.0 - smoothstep(bev * 0.4, bev * 1.6, edge)) * smoothstep(0.55, 0.75, n2 * 0.6 + n * 0.6) * (1.0 - far);
	vec3 col = mix(pc, steel, wear * 0.7 * (1.0 - scuro));
	col *= 1.0 - seam * 0.6;
	col *= 1.0 - (1.0 - rib) * 0.06;
	col = mix(col, trim, band);
	// lo sporco: sale dal piede del pezzo, cola sotto le fasce e dai giunti
	float foot = 1.0 - smoothstep(0.0, 3.5, UV2.y);
	float drip = lbz_noise(vec2(p.x * 2.6, p.y * 0.12)) * side;
	float under = (1.0 - smoothstep(band_h, band_h + 2.5, by)) * side * (1.0 - band);
	float grime = clamp(foot * 0.55 + smoothstep(0.5, 0.9, drip) * 0.3 + under * 0.25 * smoothstep(0.4, 0.8, drip + 0.2), 0.0, 1.0);
	col *= 1.0 - grime * 0.42;
	// le vetrate: vetro scuro verde-azzurro col cielo dentro, i telai d'acciaio scuro
	vec3 V = normalize((INV_VIEW_MATRIX * vec4(VIEW, 0.0)).xyz);
	vec3 glass = vec3(0.05, 0.11, 0.14);
	col = mix(col, mix(trim * 0.9, glass, step(0.5, win)), smoothstep(0.0, 0.01, win) * side * finestre);
	// la fuliggine dei crolli
	vec2 so = lbz_soot(bruciato, p + UV2.x * 13.7, TIME, fw);
	col = mix(col, vec3(0.09, 0.075, 0.065), so.x);

	ALBEDO = col;
	float metal_amt = mix(0.25, 0.8, max(max(wear, band), top * 0.6)) * (1.0 - so.x);
	METALLIC = mix(metal_amt, 0.9, win);
	ROUGHNESS = clamp(mix(0.5, 0.82, grime + n * 0.15) - wear * 0.15 - band * 0.1, 0.15, 0.95);
	ROUGHNESS = mix(ROUGHNESS, 0.08, win);
	SPECULAR = 0.5;
	float hh = prof * 0.03 + rivet * 0.012 - rib * 0.006 - band * 0.0 + (1.0 - smoothstep(band_h - 0.04, band_h, by)) * side * 0.04;
	NORMAL = lbz_bump(NORMAL, VERTEX, hh, relief * (1.0 - far));
	vec3 wnrm = normalize((INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
	float fr = pow(1.0 - clamp(dot(wnrm, V), 0.0, 1.0), 4.0);
	// le luci: si spengono a scatti quando il pezzo brucia
	float alive = 1.0 - smoothstep(0.15, 0.4, bruciato) * step(0.3, fract(TIME * 7.0 + UV2.x * 0.37));
	alive *= 1.0 - smoothstep(0.4, 0.6, bruciato);
	vec3 em = light_col * light_energy * lstrip * alive;
	em += vec3(1.0, 0.78, 0.45) * 1.4 * lit * alive;
	em += lbz_sky_refl(reflect(-V, wnrm)) * (0.25 + 0.75 * fr) * 0.3 * win * (1.0 - lit);
	em += lbz_sky_refl(reflect(-V, wnrm)) * fr * 0.12 * metal_amt;
	EMISSION = em + vec3(1.0, 0.36, 0.08) * so.y * 2.2;
}
shader_type spatial;
// Launch Base Zone: la terra della giungla (scripts/env/gen_lbz/giungla.gd: i colori nei vertici dicono
// erba, roccia sul ripido, sabbia vicino al mare). Il colore dei vertici con il dettaglio a rumore in
// coordinate del mondo: ciuffi d'erba chiari e scuri (#2F8F3A / #1E5E2A), la roccia a strati sul ripido,
// la sabbia con le increspature del vento, un velo di sporco sotto i bordi. Rilievo dalle derivate.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/lbz/lbz_common.gdshaderinc"

uniform vec3 grass_a : source_color = vec3(0.184, 0.561, 0.227);
uniform vec3 grass_b : source_color = vec3(0.118, 0.369, 0.165);
uniform vec3 rock : source_color = vec3(0.55, 0.45, 0.34);
uniform vec3 sand : source_color = vec3(0.86, 0.78, 0.55);
uniform float relief = 1.0;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	// i colori dei vertici sono scritti in sRGB (giungla.gd): si confrontano cosÃ¬ come sono coi colori
	// di giungla.gd, poi si portano in lineare
	vec3 raw = COLOR.rgb;
	vec3 vc = pow(raw, vec3(2.2));
	vec2 p = wp.xz;
	float is_sand = smoothstep(0.25, 0.05, min(distance(raw, vec3(0.86, 0.78, 0.55)), distance(raw, vec3(0.6, 0.546, 0.385))));
	float is_rock = smoothstep(0.22, 0.04, distance(raw, vec3(0.55, 0.45, 0.34))) * (1.0 - is_sand);
	float is_grass = clamp(1.0 - is_sand - is_rock, 0.0, 1.0);
	float n1 = lbz_fbm(p * 0.08);
	float n2 = lbz_noise(p * 1.7);
	float n3 = lbz_noise(p * 7.0);
	vec3 g = mix(grass_a, grass_b, smoothstep(0.3, 0.7, n1) * 0.8 + n2 * 0.2);
	g *= 0.88 + 0.24 * n3;
	g = mix(g, vc, 0.35);
	// la roccia a strati (quota), piÃ¹ scura nelle fessure
	float strata = sin(wp.y * 1.6 + n1 * 6.0) * 0.5 + 0.5;
	vec3 r = rock * (0.78 + 0.3 * strata) * (0.9 + 0.2 * n2);
	// la sabbia con le increspature
	float rip = sin(dot(p, vec2(0.9, 0.4)) * 2.2 + n2 * 3.0) * 0.5 + 0.5;
	vec3 s = sand * (0.93 + 0.1 * rip) * (0.95 + 0.08 * n3);
	vec3 col = g * is_grass + r * is_rock + s * is_sand;
	ALBEDO = col;
	ROUGHNESS = mix(0.92, 0.85, is_rock);
	SPECULAR = 0.25;
	float hh = is_rock * strata * 0.06 + is_grass * n3 * 0.03 + is_sand * rip * 0.015;
	NORMAL = lbz_bump(NORMAL, VERTEX, hh, relief);
}
shader_type spatial;
// Launch Base Zone: i tubi d'acqua di vetro della base (quelli di Sonic 3 dove scorre l'acqua). Vetro
// azzurro (#7FE8FF) trasparente, l'acqua che scorre dentro lungo il tubo (UV v = metri lungo l'asse,
// u = metri lungo la circonferenza: mesh_lbz.gd cyl), bolle che corrono, l'orlo piÃ¹ chiaro col
// Fresnel e il riflesso finto del cielo. Una passata sola, senza leggere lo schermo.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/lbz/lbz_common.gdshaderinc"

uniform vec3 glass : source_color = vec3(0.50, 0.91, 1.0);
uniform vec3 water : source_color = vec3(0.12, 0.62, 0.78);
uniform float flow = 3.5;
uniform float alpha_min = 0.42;

void fragment() {
	vec2 p = UV;
	float t = TIME * flow;
	// l'acqua: fasce che corrono lungo il tubo, mosse di lato
	float w1 = lbz_fbm(vec2(p.x * 0.8, p.y * 0.35 - t * 0.35));
	float w2 = lbz_noise(vec2(p.x * 2.5 + w1 * 2.0, p.y * 1.2 - t * 0.9));
	float band = smoothstep(0.45, 0.8, w1 * 0.6 + w2 * 0.4);
	// le bolle
	vec3 vo = lbz_voronoi(vec2(p.x * 2.2, p.y * 1.4 - t * 1.1));
	float bub = (1.0 - smoothstep(0.05, 0.11, vo.x)) * step(0.7, vo.z);
	vec3 V = normalize((INV_VIEW_MATRIX * vec4(VIEW, 0.0)).xyz);
	vec3 wnrm = normalize((INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
	float fr = pow(1.0 - clamp(dot(wnrm, V), 0.0, 1.0), 3.0);
	vec3 col = mix(water, glass, band * 0.6 + fr * 0.4);
	col = mix(col, vec3(0.92, 1.0, 1.0), bub);
	ALBEDO = col;
	ALPHA = clamp(alpha_min + fr * 0.45 + band * 0.12 + bub * 0.4, 0.0, 0.95);
	ROUGHNESS = 0.06;
	SPECULAR = 0.7;
	EMISSION = lbz_sky_refl(reflect(-V, wnrm)) * fr * 0.5 + water * band * 0.12;
}
shader_type spatial;
// Marble Garden Zone Atto 1: le colonne delle rovine (kit.gd di Hydrocity: solidi di rotazione, UV.x =
// giro 0..1, UV.y = metri in altezza, UV2.x = 1 su base e capitello). Come in Sonic 3: fusto crema
// dorato scanalato (le scanalature piÃ¹ scure in fondo), fasce scure bruno-rosse col filo arancio ogni
// tanto, base e capitello piÃ¹ chiari; e consumate: sporco che cola, muschio in basso, scheggiature.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/mgz/mgz_stone.gdshaderinc"

uniform vec3 light : source_color = vec3(0.95, 0.8, 0.44);
uniform vec3 dark : source_color = vec3(0.58, 0.4, 0.14);
uniform vec3 band : source_color = vec3(0.32, 0.13, 0.06);
uniform vec3 band_line : source_color = vec3(0.88, 0.42, 0.12);
uniform float flutes = 14.0;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wn);
	float shaft = 1.0 - UV2.x;
	float a = UV.x * flutes;
	float fl = 0.5 + 0.5 * cos(a * 6.2832);
	float groove = pow(1.0 - fl, 1.6) * shaft;
	vec3 col = mix(light, dark, groove * 0.75);
	float H = -groove * 0.06;
	// le fasce scure (ogni 3.2 m, la prima poco sopra la base) col filo arancio in mezzo
	float yb = fract((UV.y - 1.6) / 3.2);
	float bd = (1.0 - smoothstep(0.035, 0.05, abs(yb - 0.5))) * shaft;
	float bl = (1.0 - smoothstep(0.006, 0.012, abs(yb - 0.5))) * shaft;
	col = mix(col, band, bd);
	col = mix(col, band_line, bl);
	H += bd * 0.03;
	// base e capitello: crema chiaro con la grana
	col = mix(col, light * 1.08, UV2.x * 0.6);
	float grain = mgz_vnoise(vec2(UV.x * 60.0, UV.y * 6.0));
	H += (grain - 0.5) * 0.02;
	// lo sporco che cola dall'alto e il muschio in basso
	float streak = smoothstep(0.45, 0.95, mgz_vnoise(vec2(UV.x * 26.0, UV.y * 0.25 + wp.x)));
	col *= 1.0 - streak * 0.28;
	float dirt = mgz_fbm(vec2(UV.x * 7.0, UV.y * 0.6) + wp.xz * 0.1);
	col *= mix(1.05, 0.78, smoothstep(0.4, 0.85, dirt));
	float low = 1.0 - smoothstep(0.3, 2.2, UV.y);
	float moss = clamp(low * smoothstep(0.3, 0.7, mgz_vnoise(vec2(UV.x * 18.0, UV.y * 3.0))) + groove * 0.3 * smoothstep(0.6, 0.8, dirt), 0.0, 1.0);
	col = mix(col, mgz_srgb(vec3(0.2, 0.34, 0.09)), moss * 0.7);
	// scheggiature chiare
	float chip = smoothstep(0.82, 0.9, mgz_vnoise(vec2(UV.x * 40.0, UV.y * 4.0) + 5.0));
	col = mix(col, light * 1.15, chip * 0.4);
	H -= chip * 0.02;
	vec3 nb = mgz_bump(n, wp, H, 1.0);
	NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
	ALBEDO = col;
	ROUGHNESS = mix(0.55, 0.85, max(moss, dirt * 0.6));
	SPECULAR = 0.45;
	AO = 1.0 - groove * 0.4 - bd * 0.1;
	AO_LIGHT_AFFECT = 0.3;
}
␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Marble Garden Zone Atto 1: la coperta d'erba che scavalca il bordo di un blocco di pietra e pende
// giÃ¹ (sopra l'erba, sotto la pietra): fili d'erba a punta, fitti e di lunghezza diversa, verde acceso
// in cima e verde cupo sulle punte in ombra, come le frange frastagliate di Sonic 3; qua e lÃ  un filo
// lungo. UV.x = metri lungo il bordo, UV.y = 0 in cima, 1 in fondo alla frangia.
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/mgz/mgz_stone.gdshaderinc"

uniform float length_scale = 1.0;

varying vec3 wp;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

// un pettine di fili a punta: k = fili per metro, torna quanto in giÃ¹ arriva il filo in u
float comb(float u, float k, float seed, float lo, float hi) {
	float x = u * k;
	float i = floor(x);
	float t = fract(x) * 2.0 - 1.0;
	float len = mix(lo, hi, mgz_hash(vec2(i, seed)));
	// punta triangolare un filo curva
	return len * (1.0 - pow(abs(t), 0.8));
}

void fragment() {
	float u = UV.x;
	float y = UV.y / length_scale;
	float a = comb(u, 7.0, 3.0, 0.25, 0.75);
	a = max(a, comb(u + 0.031, 11.0, 7.0, 0.2, 0.55));
	a = max(a, comb(u + 0.07, 3.1, 11.0, 0.15, 1.0) * step(0.62, mgz_hash(vec2(floor((u + 0.07) * 3.1), 2.0))));
	// la base piena (la zolla che scavalca lo spigolo)
	a = max(a, 0.16 + 0.06 * mgz_vnoise(vec2(u * 3.0, 1.0)));
	if (y > a) {
		discard;
	}
	float tip = clamp(y / max(a, 0.01), 0.0, 1.0);
	float blade_id = mgz_hash(vec2(floor(u * 7.0), 5.0));
	vec3 top = mgz_srgb(mix(vec3(0.28, 0.66, 0.12), vec3(0.4, 0.76, 0.18), blade_id));
	vec3 low = mgz_srgb(vec3(0.07, 0.27, 0.05));
	vec3 c = mix(top, low, smoothstep(0.05, 0.9, y * 1.3));
	c *= 0.85 + 0.3 * mgz_vnoise(vec2(u * 23.0, y * 4.0));
	// la costa del filo piÃ¹ chiara
	float rib = 1.0 - smoothstep(0.0, 0.25, abs(fract(u * 7.0) - 0.5));
	c = mix(c, c * 1.35, rib * 0.4 * (1.0 - tip));
	ALBEDO = c;
	ROUGHNESS = 0.85;
	SPECULAR = 0.25;
	BACKLIGHT = vec3(0.25, 0.4, 0.1);
	AO = mix(1.0, 0.65, smoothstep(0.0, 0.8, y));
	AO_LIGHT_AFFECT = 0.3;
}
␀␀␀␀␀␀// Marble Garden Zone (Sonic 3), rifatta "moderna": la pietra delle rovine e l'erba che le copre.
// Pietra: blocchi squadrati (qualcuno doppio, a filari sfalsati) a scacchi di crema marmorizzato, tan
// caldo, arancio mattone e grigio-verde oliva (niente viola), con le venature scure del marmo, crepe,
// spigoli consumati e scheggiati, muschio nelle fughe e in basso, lo sporco a chiazze; qualche blocco
// oliva col riquadro incassato (l'intaglio discreto di Sonic 3). In coordinate del mondo (triplanare
// sull'asse dominante della normale): niente UV. Torna colore, altezza (rilievo), rugositÃ  e occlusione.
// Erba: verde Sonic 3 ma a fili (tratti fini stirati lungo il pendio), ciuffi piÃ¹ chiari e piÃ¹ scuri,
// macchie giallo-verdi e verde cupo, che da lontano sfumano in un verde uniforme (niente moirÃ©).

float mgz_hash(vec2 p) {
	p = fract(p * vec2(0.1031, 0.1030));
	p += dot(p, p.yx + 33.33);
	return fract((p.x + p.y) * p.x);
}

vec3 mgz_srgb(vec3 c) { return pow(c, vec3(2.2)); }

float mgz_vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float a = mgz_hash(i);
	float b = mgz_hash(i + vec2(1.0, 0.0));
	float c = mgz_hash(i + vec2(0.0, 1.0));
	float d = mgz_hash(i + vec2(1.0, 1.0));
	return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float mgz_fbm(vec2 p) {
	return mgz_vnoise(p) * 0.55 + mgz_vnoise(p * 2.03 + 7.1) * 0.3 + mgz_vnoise(p * 4.1 + 3.7) * 0.15;
}

// colore del blocco: crema (il piÃ¹ comune), tan, arancio mattone, oliva chiaro e oliva scuro.
// kind: 0 crema/tan (venato), 1 arancio, 2 oliva
vec3 mgz_tile_color(vec2 id, out float kind) {
	float r = mgz_hash(id + 17.0);
	// scacchiera morbida: sulle celle "scure" piÃ¹ arancio e oliva
	bool dark = mod(id.x + id.y, 2.0) > 0.5;
	r = dark ? r * 0.75 + 0.25 : r * 0.8;
	vec3 c;
	kind = 0.0;
	if (r < 0.44) c = vec3(0.86, 0.82, 0.68);                 // crema marmorizzato
	else if (r < 0.62) c = vec3(0.79, 0.70, 0.52);            // tan caldo
	else if (r < 0.75) { c = vec3(0.78, 0.45, 0.22); kind = 1.0; }   // arancio mattone
	else if (r < 0.91) { c = vec3(0.56, 0.57, 0.43); kind = 2.0; }   // oliva / salvia
	else { c = vec3(0.43, 0.44, 0.33); kind = 2.0; }               // oliva scuro
	return mgz_srgb(c);
}

// Pietra delle rovine nel punto wp con normale n; tile = lato del blocco in metri.
// h: altezza 0..1 (rilievo), rough: rugositÃ , ao: occlusione delle fughe e degli incavi.
vec3 mgz_stone(vec3 wp, vec3 n, float tile, out float h, out float rough, out float ao) {
	vec3 an = abs(n);
	vec2 uv;
	bool vert = !(an.y >= an.x && an.y >= an.z);
	if (!vert) uv = wp.xz;
	else if (an.x >= an.z) uv = vec2(wp.z, wp.y);
	else uv = vec2(wp.x, wp.y);
	vec2 q = uv / tile;
	float fw = length(fwidth(q));
	float detail = 1.0 - smoothstep(0.06, 0.28, fw);
	// filari: ognuno sfalsato di mezzo blocco a caso; qua e lÃ  due blocchi diventano uno lungo
	float row = floor(q.y);
	q.x += floor(mgz_hash(vec2(row, 3.7)) * 2.0) * 0.5;
	vec2 cell = floor(q);
	float pair = floor(cell.x * 0.5);
	bool merged = mgz_hash(vec2(pair, row) + 91.0) < 0.28;
	vec2 id = merged ? vec2(pair * 2.0, row) : cell;
	float wdt = merged ? 2.0 : 1.0;
	vec2 f = vec2((q.x - id.x) / wdt, q.y - row);
	float kind;
	vec3 c = mgz_tile_color(id, kind);
	// distanza dal bordo in "blocchi" (in x scalata col blocco lungo: la fuga resta larga uguale)
	float ex = min(f.x, 1.0 - f.x) * wdt;
	float ey = min(f.y, 1.0 - f.y);
	// il bordo frastagliato: gli spigoli consumati non sono dritti
	float chip_n = mgz_vnoise(uv * 9.0 + id * 3.1);
	float e = min(ex, ey) - (chip_n - 0.5) * 0.03 * detail;
	float mortar = 1.0 - smoothstep(0.012, 0.03, e);
	float bevel = smoothstep(0.02, 0.1, e);
	// faccia del blocco: un filo bombata e storta (ogni blocco sporge di un poco diverso)
	float bulge = mgz_hash(id + 2.2) * 0.25;
	h = bevel * (0.55 + bulge);
	ao = mix(0.45, 1.0, bevel);
	// grana della pietra
	float grain = mgz_vnoise(uv * 14.0) * 0.6 + mgz_vnoise(uv * 37.0) * 0.4;
	h += (grain - 0.5) * 0.12 * detail;
	// venature del marmo sui blocchi crema e tan: linee scure sottili che vanno di sbieco
	float veins = 0.0;
	if (kind < 0.5) {
		vec2 vq = uv * 1.6 / tile + id * 1.37;
		float w = mgz_fbm(vq * 1.3);
		float line = abs(fract((vq.x + vq.y * 0.7) * 0.9 + w * 1.8) - 0.5);
		veins = (1.0 - smoothstep(0.0, 0.022, line)) * smoothstep(0.35, 0.6, mgz_vnoise(vq * 0.8 + 4.0));
		veins *= detail;
	}
	// crepe: in un blocco su tre una crepa spezzata che attraversa la faccia
	float crack = 0.0;
	float rc = mgz_hash(id + 44.0);
	if (rc < 0.34) {
		vec2 cp = f - 0.5;
		float ang = rc * 18.0;
		vec2 dir = vec2(cos(ang), sin(ang));
		float along = dot(cp, dir);
		float across = dot(cp, vec2(-dir.y, dir.x)) + (mgz_vnoise(vec2(along * 9.0, rc * 50.0)) - 0.5) * 0.12;
		crack = (1.0 - smoothstep(0.004, 0.018, abs(across))) * smoothstep(0.45, 0.2, abs(along + 0.1));
		crack *= detail;
	}
	h -= crack * 0.35;
	ao *= 1.0 - crack * 0.5;
	// il riquadro incassato sui blocchi oliva (l'intaglio di Sonic 3, appena accennato)
	float inset = 0.0;
	if (kind > 1.5 && mgz_hash(id + 8.8) < 0.6) {
		vec2 cc = abs(vec2((f.x - 0.5) * wdt, f.y - 0.5));
		float d = max(cc.x - (wdt * 0.5 - 0.5), cc.y);
		inset = smoothstep(0.3, 0.27, d) * detail;
		float lip = (1.0 - smoothstep(0.0, 0.025, abs(d - 0.285))) * detail;
		h -= inset * 0.2;
		ao *= 1.0 - lip * 0.35;
	}
	// tono del blocco, sporco a chiazze, schegge chiare sugli spigoli
	float tone = 0.85 + mgz_hash(id + 5.3) * 0.22;
	c *= tone;
	float dirt = mgz_fbm(uv * 0.35 + 11.0);
	c *= mix(1.08, 0.72, smoothstep(0.35, 0.85, dirt));
	float wear = (1.0 - smoothstep(0.02, 0.07, e)) * smoothstep(0.55, 0.8, chip_n) * detail;
	c = mix(c, c * 1.25 + 0.03, wear * 0.6);
	c = mix(c, c * 0.55, veins * 0.5);
	c = mix(c, c * 0.35, crack * 0.85);
	c *= mix(0.72, 1.0, bevel);
	// muschio: nelle fughe, nelle crepe, sulle facce verticali in basso e nei punti umidi
	float moss_n = mgz_fbm(wp.xz * 0.6 + wp.y * 0.45);
	float moss = mortar * 0.8 + crack * 0.5;
	moss += vert ? smoothstep(0.62, 0.85, moss_n) * 0.55 * (1.0 - bevel * 0.5) : 0.0;
	moss = clamp(moss * smoothstep(0.25, 0.6, moss_n + 0.15), 0.0, 1.0);
	vec3 moss_c = mgz_srgb(mix(vec3(0.16, 0.28, 0.07), vec3(0.3, 0.42, 0.12), mgz_vnoise(uv * 5.0)));
	vec3 mortar_c = mgz_srgb(vec3(0.16, 0.14, 0.1));
	c = mix(c, mortar_c, mortar * mix(0.45, 0.9, detail));
	c = mix(c, moss_c, moss * 0.85);
	ao *= mix(0.6, 1.0, 1.0 - mortar);
	rough = mix(0.78, 0.95, max(mortar, moss)) - veins * 0.1 + (grain - 0.5) * 0.1;
	h = mix(0.5, h, detail);
	ao = mix(0.85, ao, detail);
	return c;
}

// Rilievo dall'altezza h (derivate di schermo): normale nel mondo.
vec3 mgz_bump(vec3 n, vec3 wp, float h, float strength) {
	vec3 dpdx = dFdx(wp);
	vec3 dpdy = dFdy(wp);
	float dhx = dFdx(h);
	float dhy = dFdy(h);
	vec3 r1 = cross(dpdy, n);
	vec3 r2 = cross(n, dpdx);
	float det = dot(dpdx, r1);
	vec3 grad = sign(det) * (dhx * r1 + dhy * r2);
	return normalize(abs(det) * n - grad * strength);
}

// L'erba di Marble Garden: verde acceso a fili. steep = 0 in piano, 1 sui pendii (lÃ¬ i fili si
// stirano lungo la discesa, come le strisce d'erba di Sonic 3). blade: altezza del filo (per il
// rilievo e l'occlusione).
vec3 mgz_grass(vec3 wp, float steep, out float blade) {
	vec2 p = wp.xz + vec2(wp.y * 0.6, wp.y * 0.35);
	float fwp = length(fwidth(p));
	// i fili: rumore stirato (lunghi in un verso, sottili nell'altro), girato a chiazze
	float ang = mgz_vnoise(p * 0.15) * 3.0;
	vec2 dir = vec2(cos(ang), sin(ang));
	vec2 bp = vec2(dot(p, dir), dot(p, vec2(-dir.y, dir.x)));
	float b1 = mgz_vnoise(bp * vec2(3.0, 26.0));
	float b2 = mgz_vnoise(bp * vec2(5.0, 47.0) + 13.0);
	float bd = 1.0 - smoothstep(0.012, 0.05, fwp);
	float bmd = 1.0 - smoothstep(0.03, 0.12, fwp);
	blade = mix(0.5, b1 * 0.6 + b2 * 0.4, bd);
	// ciuffi: zolle di 20-40 cm piÃ¹ chiare in cima e scure negli spazi fra l'una e l'altra
	float bmid = 1.0 - smoothstep(0.05, 0.3, fwp);
	float tuft = mgz_vnoise(p * 3.1);
	float tuft2 = mgz_vnoise(p * 7.7 + 3.0);
	float clump = smoothstep(0.2, 0.8, tuft * 0.65 + tuft2 * 0.35);
	// macchie grandi: giallo-verde al sole, verde cupo
	float patch_n = mgz_fbm(p * 0.06);
	float patch2 = mgz_vnoise(p * 0.18 + 9.0);
	vec3 bright = mgz_srgb(vec3(0.38, 0.62, 0.17));
	vec3 mid = mgz_srgb(vec3(0.21, 0.48, 0.1));
	vec3 deep = mgz_srgb(vec3(0.1, 0.29, 0.06));
	vec3 yellow = mgz_srgb(vec3(0.56, 0.66, 0.22));
	vec3 c = mix(mid, bright, smoothstep(0.3, 0.7, patch_n));
	c = mix(c, yellow, smoothstep(0.62, 0.88, patch2) * 0.55);
	c = mix(c, deep, smoothstep(0.55, 0.85, mgz_vnoise(p * 0.11 + 4.0)) * 0.5);
	// le zolle (fino a una ventina di metri) e i fili (da vicino)
	c *= mix(1.0, mix(0.66, 1.16, clump), bmid);
	c = mix(c, c * vec3(1.08, 1.06, 0.8), (1.0 - clump) * 0.25 * bmid);
	c *= mix(1.0, mix(0.7, 1.2, blade), bd);
	float s = (wp.x * 0.62 + wp.z * 0.38 + wp.y * 1.4) / 1.6 + (mgz_vnoise(wp.xz * 0.3) - 0.5) * 0.4;
	float band = smoothstep(0.35, 0.65, abs(fract(s) - 0.5) * 2.0);
	c *= 1.0 - band * 0.12 * steep * (1.0 - smoothstep(0.2, 0.6, fwidth(s)));
	return c;
}

// il bordo di foglie verde scuro dove l'erba scende sulla pietra
vec3 mgz_leaf_dark(vec3 wp) {
	float sp = mgz_vnoise(wp.xz * 4.0 + wp.y * 3.0);
	return mgz_srgb(vec3(0.07, 0.30, 0.06)) * (0.8 + sp * 0.4);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type sky;
// Marble Garden Zone Atto 1: il cielo di Sonic 3, blu intenso in alto e azzurro chiaro all'orizzonte, i
// cumuli bianchi morbidi (come shaders/env/sky.gdshader) e tutto attorno la lunga catena di montagne
// viola (due file: la lontana piÃ¹ chiara nella foschia azzurra, la vicina con le creste illuminate dal
// sole e le valli in ombra), davanti la pianura della giungla: chiome verdi a gobbe, piÃ¹ chiare in cima.

uniform vec3 zenith : source_color = vec3(0.03, 0.14, 0.62);
uniform vec3 mid : source_color = vec3(0.12, 0.34, 0.9);
uniform vec3 horizon : source_color = vec3(0.6, 0.56, 0.92);
uniform vec3 sun_glow : source_color = vec3(1.0, 0.84, 0.58);
uniform float sun_size = 0.9997;
uniform sampler2D cloud_noise : filter_linear_mipmap, repeat_enable;
uniform float cloud_cover = 0.5;
uniform float cloud_scale = 0.22;
uniform float cloud_speed = 0.004;
global uniform float vento;
uniform vec3 far_range : source_color = vec3(0.42, 0.33, 0.66);
uniform vec3 near_range : source_color = vec3(0.24, 0.13, 0.38);
uniform vec3 ridge_lit : source_color = vec3(0.56, 0.4, 0.72);
uniform vec3 jungle : source_color = vec3(0.06, 0.2, 0.07);
uniform vec3 jungle_lit : source_color = vec3(0.2, 0.42, 0.12);

float clouds(vec2 uv, float tm) {
	float a = texture(cloud_noise, uv * 0.6).r;
	float b = texture(cloud_noise, uv * 1.9 + vec2(0.31, 0.77) + vec2(tm * 0.9, tm * 0.35)).r;
	float c = texture(cloud_noise, uv * 4.7 + vec2(0.13, 0.41) + vec2(tm * 2.2, -tm * 0.6)).r;
	return a * 0.64 + b * 0.24 + c * 0.12;
}

// profilo delle creste (quota sull'orizzonte, in seno dell'elevazione) all'azimut az
float ridge(float az, float seed) {
	float h = 0.0;
	float amp = 1.0;
	float f = 3.0;
	for (int i = 0; i < 5; i++) {
		float s = sin(az * f + seed * (1.7 + float(i)));
		h += (1.0 - abs(s)) * amp;
		amp *= 0.5;
		f *= 2.13;
	}
	return h / 1.94;
}

// gobbe tonde delle chiome (0..1)
float mgz_bumps(float x) {
	float i = floor(x);
	float f = fract(x) * 2.0 - 1.0;
	float r = fract(sin(i * 91.7) * 4375.85);
	return sqrt(max(1.0 - f * f, 0.0)) * (0.5 + 0.5 * r);
}

void sky() {
	vec3 d = normalize(EYEDIR);
	float y = d.y;
	float t1 = pow(clamp(y, 0.0, 1.0), 0.45);
	vec3 col = mix(horizon, mid, smoothstep(0.0, 0.35, t1));
	col = mix(col, zenith, smoothstep(0.3, 1.0, t1));
	vec3 L = LIGHT0_DIRECTION;
	float sd = dot(d, L);
	col += sun_glow * (pow(max(sd, 0.0), 8.0) * 0.22 + pow(max(sd, 0.0), 64.0) * 0.45);
	if (!AT_CUBEMAP_PASS && sd > sun_size) {
		col += vec3(6.0, 5.4, 4.4) * smoothstep(sun_size, sun_size + 0.0001, sd);
	}
	// cumuli
	if (y > 0.0) {
		float tm = TIME * cloud_speed * vento;
		vec2 uv = d.xz / (y + 0.12) * cloud_scale + vec2(tm, tm * 0.25);
		float c = clouds(uv, tm);
		float dens = smoothstep(cloud_cover, cloud_cover + 0.16, c);
		vec2 toward = normalize(L.xz + vec2(0.0001)) * 0.03;
		float c2 = clouds(uv + toward, tm);
		float lit = clamp((c - c2) * 6.0 + 0.62, 0.0, 1.0);
		vec3 cl = mix(vec3(0.72, 0.78, 0.92), vec3(1.0, 0.99, 0.96), lit);
		float fade = smoothstep(0.06, 0.22, y);
		col = mix(col, cl, dens * fade * 0.95);
	}
	// le montagne
	float az = atan(d.z, d.x);
	float hf = 0.05 + 0.13 * ridge(az, 1.3);
	float hn = 0.02 + 0.1 * ridge(az + 0.6, 4.1) * (0.6 + 0.4 * sin(az * 2.0 + 1.0));
	if (y < hf) {
		vec3 fr = mix(far_range, horizon, 0.35 + 0.35 * (1.0 - smoothstep(0.0, hf, y)));
		col = mix(fr, col, smoothstep(hf - 0.002, hf, y));
	}
	if (y < hn) {
		float k = clamp(y / max(hn, 0.001), 0.0, 1.0);
		vec3 nr = mix(near_range * 0.8, near_range, k);
		// cresta illuminata dalla parte del sole
		float side = max(dot(normalize(vec2(d.x, d.z)), normalize(L.xz + vec2(0.0001))), 0.0);
		nr = mix(nr, ridge_lit, smoothstep(0.82, 1.0, k) * (0.35 + 0.4 * side));
		nr = mix(nr, horizon, 0.18 * (1.0 - k));
		col = mix(nr, col, smoothstep(hn - 0.002, hn, y));
	}
	// la giungla: chiome a gobbe davanti alle montagne (sotto l'orizzonte continua scura)
	float hj = 0.004 + 0.012 * (mgz_bumps(az * 40.0) * 0.6 + mgz_bumps(az * 97.0 + 3.0) * 0.4) + 0.006 * ridge(az + 2.0, 7.3);
	if (y < hj) {
		float k = clamp((hj - y) / 0.03, 0.0, 1.0);
		vec3 jc = mix(jungle_lit, jungle, smoothstep(0.0, 0.6, k));
		jc = mix(jc, horizon, 0.28 * (1.0 - k * 0.5));
		col = mix(jc, col, smoothstep(hj - 0.0015, hj, y));
	}
	COLOR = col;
}
␀␀␀␀␀␀␀shader_type spatial;
// Marble Garden Zone Atto 1: la pietra delle rovine (mgz_stone.gdshaderinc). Sopra (facce rivolte in
// alto) la coperta d'erba a fili se top_grass = 1 (muri, piloni, torri), la pietra se 0 (i pavimenti:
// ponti, piazze, lastre). tint scurisce o schiarisce (lo zoccolo piÃ¹ scuro, le lastre piÃ¹ chiare).
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/mgz/mgz_stone.gdshaderinc"

uniform float tile = 1.25;
uniform float tint = 1.0;
uniform float top_grass = 1.0;
uniform float relief = 1.0;
uniform float saturation = 1.0;   // i pavimenti piÃ¹ spenti (le lastre)

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wn);
	float h = 0.5;
	float rough = 0.9;
	float ao = 1.0;
	float g = top_grass * smoothstep(0.7, 0.8, n.y);
	vec3 c = vec3(0.0);
	if (g < 0.999) {
		c = mgz_stone(wp, n, tile, h, rough, ao) * tint;
	}
	float blade = 0.5;
	vec3 gc = vec3(0.0);
	if (g > 0.001) {
		gc = mgz_grass(wp, 0.0, blade);
	}
	vec3 nb = mgz_bump(n, wp, mix(h, blade * 0.4, g), mix(0.08, 0.03, g) * relief);
	c = mix(vec3(dot(c, vec3(0.3, 0.55, 0.15))), c, saturation);
	c = mix(c, gc, g);
	rough = mix(rough, 0.92, g);
	ao = mix(ao, mix(0.75, 1.0, blade), g);
	NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
	ALBEDO = c;
	ROUGHNESS = rough;
	SPECULAR = mix(0.35, 0.25, g);
	AO = ao;
	AO_LIGHT_AFFECT = 0.25;
}
␀␀␀␀␀shader_type spatial;
// Marble Garden Zone Atto 1: il terreno (scripts/env/gen_mgz/terrain.gd) come le rovine di Sonic 3:
// dove Ã¨ piano o in pendio (fino a ~50Â°, le lunghe salite diagonali) la coperta d'erba a fili, dove Ã¨ a
// picco la pietra delle rovine a blocchi (mgz_stone.gdshaderinc) a filari orizzontali, con le cornici
// grigio-oliva ogni tre filari; sul ciglio l'erba scavalca il bordo e pende giÃ¹ a punte frastagliate
// (COLOR.r, calcolato dal generatore: 1 sul ciglio, 0 un metro e mezzo sotto). COLOR: b = lastre dei
// cortili, a = tinta dell'erba.

render_mode diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/mgz/mgz_stone.gdshaderinc"

varying vec3 wpos;
varying vec3 wnrm;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wnrm);
	float slope = n.y;
	float drape = COLOR.r;
	float stone_m = COLOR.b;
	float tint = COLOR.a;
	float far_fw = length(fwidth(wpos.xz));

	float jitter = (mgz_vnoise(wpos.xz * 0.6 + wpos.y * 0.4) - 0.5) * 0.08;
	float rock_w = 1.0 - smoothstep(0.5 + jitter, 0.6 + jitter, slope);

	// (solo quello che si vede: l'erba dove non Ã¨ a picco, la pietra dove lo Ã¨; per le schede integrate)
	float blade = 0.5;
	vec3 grass = vec3(0.0);
	if (rock_w < 0.999) {
		grass = mgz_grass(wpos, smoothstep(0.97, 0.7, slope), blade);
		grass = mix(grass, grass * vec3(0.84, 0.92, 0.8), (1.0 - tint) * 0.55);
	}

	// la pietra a picco: blocchi di due metri a filari, una cornice ogni tre filari
	float sh = 0.5;
	float srough = 0.85;
	float sao = 1.0;
	vec3 stone = vec3(0.0);
	if (rock_w > 0.001) {
		stone = mgz_stone(wpos, n, 2.0, sh, srough, sao);
	}
	float cy = fract(wpos.y / 6.0);
	float cornice = (1.0 - smoothstep(0.0, 0.02, abs(cy - 0.02))) + (1.0 - smoothstep(0.0, 0.012, abs(cy - 0.075)));
	cornice = clamp(cornice, 0.0, 1.0) * (1.0 - smoothstep(0.5, 2.0, far_fw)) * rock_w;
	stone = mix(stone, mgz_srgb(vec3(0.5, 0.52, 0.42)) * 0.8, cornice * 0.75);
	sh = mix(sh, 0.9, cornice);
	// sotto la cornice l'ombra
	sao *= 1.0 - (1.0 - smoothstep(0.075, 0.12, cy)) * step(0.075, cy) * 0.4 * rock_w;

	// l'erba che scavalca il ciglio: punte frastagliate di lunghezza diversa
	float along = (wpos.x + wpos.z) * 2.3;
	float ti = floor(along);
	float tt = abs(fract(along) * 2.0 - 1.0);
	float tooth = (1.0 - tt) * mix(0.25, 0.85, mgz_hash(vec2(ti, 1.0)));
	float along2 = (wpos.x - wpos.z) * 4.1 + 0.37;
	float tooth2 = (1.0 - abs(fract(along2) * 2.0 - 1.0)) * mix(0.15, 0.5, mgz_hash(vec2(floor(along2), 4.0)));
	float reach = max(tooth, tooth2) * (1.0 - smoothstep(0.6, 2.5, far_fw));
	float over = step(1.0 - drape, 0.18 + reach * 0.82) * step(0.02, drape);
	over = max(over, smoothstep(0.85, 0.95, drape));
	float hang = over * rock_w;
	vec3 hang_c = mix(mgz_srgb(vec3(0.27, 0.62, 0.11)), mgz_leaf_dark(wpos), smoothstep(0.85, 0.35, drape));
	// sotto le punte, l'ombra dell'erba sulla pietra
	float under = (1.0 - over) * smoothstep(0.0, 0.5, drape) * rock_w;

	vec3 c = mix(grass, stone, rock_w);
	float rough = mix(0.92, srough, rock_w);
	float ao = mix(mix(0.78, 1.0, blade), sao, rock_w);
	// il ciglio dove il prato piega: foglie piÃ¹ scure
	float rim = smoothstep(0.75, 0.6, slope) * (1.0 - rock_w);
	c = mix(c, mgz_leaf_dark(wpos) * 1.3, rim * 0.6);
	c = mix(c, hang_c, hang);
	ao *= 1.0 - under * 0.45;
	rough = mix(rough, 0.85, hang);

	// i cortili: lastre grandi
	float lh = 0.5;
	float lrough = 0.85;
	float lao = 1.0;
	vec3 slab = vec3(0.0);
	float stm = smoothstep(0.4, 0.6, stone_m);
	if (stm > 0.001) {
		slab = mgz_stone(wpos, n, 2.5, lh, lrough, lao) * 1.02;
		slab = mix(vec3(dot(slab, vec3(0.3, 0.55, 0.15))), slab, 0.62);
	}
	c = mix(c, slab, stm * (1.0 - rock_w));
	rough = mix(rough, lrough, stm);
	ao = mix(ao, lao, stm);
	float hh = mix(mix(blade * 0.4, sh, rock_w), lh, stm);
	hh = mix(hh, 0.8, hang);
	vec3 nb = mgz_bump(n, wpos, hh, mix(0.03, 0.09, max(rock_w, stm)));
	NORMAL = normalize((VIEW_MATRIX * vec4(nb, 0.0)).xyz);
	ALBEDO = c;
	ROUGHNESS = rough;
	SPECULAR = 0.3;
	AO = ao;
	AO_LIGHT_AFFECT = 0.3;
}
␀␀␀␀␀␀␀␀␀␀␀// Marble Garden Atto 2, sotto le profonditÃ  (Lava Reef, Hidden Palace): rumore senza texture per gli shader
// dei posti costruiti a runtime (deep_world.gd).
float dn_hash3(vec3 p) {
	p = fract(p * 0.3183099 + vec3(0.71, 0.113, 0.419));
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}
float dn_noise3(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(dn_hash3(i + vec3(0, 0, 0)), dn_hash3(i + vec3(1, 0, 0)), f.x),
			mix(dn_hash3(i + vec3(0, 1, 0)), dn_hash3(i + vec3(1, 1, 0)), f.x), f.y),
		mix(mix(dn_hash3(i + vec3(0, 0, 1)), dn_hash3(i + vec3(1, 0, 1)), f.x),
			mix(dn_hash3(i + vec3(0, 1, 1)), dn_hash3(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}
float dn_fbm3(vec3 p) {
	float a = 0.5;
	float s = 0.0;
	for (int i = 0; i < 4; i++) {
		s += a * dn_noise3(p);
		p = p * 2.03 + vec3(1.7, 9.2, 3.1);
		a *= 0.5;
	}
	return s;
}
vec2 dn_hash2(vec2 p) {
	p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
	return fract(sin(p) * 43758.5453);
}
// celle di Worley: x = distanza dal punto piÃ¹ vicino, y = dal secondo
vec2 dn_worley(vec2 p) {
	vec2 n = floor(p);
	vec2 f = fract(p);
	float f1 = 8.0;
	float f2 = 8.0;
	for (int j = -1; j <= 1; j++) {
		for (int i = -1; i <= 1; i++) {
			vec2 g = vec2(float(i), float(j));
			vec2 o = dn_hash2(n + g);
			vec2 r = g + o - f;
			float d = dot(r, r);
			if (d < f1) {
				f2 = f1;
				f1 = d;
			} else if (d < f2) {
				f2 = d;
			}
		}
	}
	return vec2(sqrt(f1), sqrt(f2));
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Marble Garden Atto 2 (sotto le profonditÃ ): fascio di luce che si somma (la luce verde dello Smeraldo
// Madre, i raggi dell'altare): piÃ¹ acceso al centro (di fronte), sfuma ai bordi e verso UV.y = 1.
render_mode unshaded, cull_disabled, blend_add, depth_draw_never, fog_disabled, shadows_disabled;
uniform vec3 color : source_color = vec3(0.3, 1.0, 0.45);
uniform float energy = 1.0;
uniform float fade_end = 1.0;

void fragment() {
	float face = pow(abs(dot(NORMAL, VIEW)), 2.0);
	float along = 1.0 - smoothstep(0.0, fade_end, UV.y);
	float start = smoothstep(0.0, 0.06, UV.y);
	float flick = 0.9 + 0.1 * sin(TIME * 3.0 + UV.y * 9.0);
	ALBEDO = color * energy * face * along * start * flick;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Marble Garden Atto 2, Hidden Palace (deep_world.gd): i blocchi verde acqua del camminamento di Sonic 3 &
// Knuckles, rifatti in 3D. mode 0: il pavimento, in coordinate del mondo (righe di lastre lunghe separate
// dai blocchetti quadrati con la X, come nel gioco); mode 1: una faccia per blocco (UV 0..1), il
// pannello con la X in mezzo alla cornice.
#include "res://shaders/env/mgz2/deep_noise.gdshaderinc"
uniform int mode = 0;
uniform vec3 teal : source_color = vec3(0.22, 0.66, 0.56);
uniform vec3 teal_hi : source_color = vec3(0.56, 0.95, 0.8);
uniform vec3 teal_dk : source_color = vec3(0.05, 0.25, 0.25);
uniform vec3 x_col : source_color = vec3(0.12, 0.5, 0.48);
uniform float cell = 3.0;
uniform float glow = 0.18;
varying vec3 wp;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

// pannello con la X: q in 0..1; torna (colore, quanto Ã¨ incavato)
vec3 x_panel(vec2 q, out float inset) {
	vec2 d = abs(q - 0.5);
	float frame = smoothstep(0.46, 0.43, max(d.x, d.y));
	float inner = smoothstep(0.36, 0.33, max(d.x, d.y));
	float xl = min(abs(q.x - q.y), abs(q.x + q.y - 1.0));
	float x = (1.0 - smoothstep(0.05, 0.085, xl)) * inner;
	vec3 c = mix(teal_dk, teal_hi, frame);
	c = mix(c, teal * 0.85, frame * (1.0 - smoothstep(0.42, 0.37, max(d.x, d.y))));
	c = mix(c, x_col * 0.7, inner);
	c = mix(c, teal_hi * 0.95, x);
	inset = inner * (1.0 - x);
	return c;
}

void fragment() {
	vec3 col;
	float inset = 0.0;
	if (mode == 0) {
		vec2 p = wp.xz / cell;
		vec2 ij = floor(p);
		vec2 q = fract(p);
		// righe: ogni terza cella un blocchetto con la X, le altre lastre con l'orlo chiaro
		bool xb = mod(ij.x + mod(ij.y, 2.0) * 1.5, 3.0) < 1.0;
		if (xb) {
			col = x_panel(q, inset);
		} else {
			float ey = min(q.y, 1.0 - q.y);
			float ex = mod(ij.x + 2.0, 3.0) < 1.0 ? q.x : 1.0 - q.x;
			col = mix(teal_dk, teal, smoothstep(0.0, 0.06, ey));
			col = mix(col, teal_hi, smoothstep(0.12, 0.06, ey) * smoothstep(0.0, 0.06, ey) * 0.7);
			col *= 0.92 + 0.08 * smoothstep(0.0, 0.04, ex);
			// la riga chiara a metÃ  lastra (lo smusso dei pixel del gioco)
			col = mix(col, teal_hi * 0.9, (1.0 - smoothstep(0.0, 0.03, abs(q.y - 0.3))) * 0.35);
		}
		col *= 0.9 + 0.12 * dn_noise3(vec3(ij * 3.1, 0.5));
	} else {
		col = x_panel(UV, inset);
	}
	float grime = dn_fbm3(wp * 0.6);
	col *= 0.85 + 0.2 * grime;
	ALBEDO = col;
	ROUGHNESS = 0.35 + 0.3 * inset;
	METALLIC = 0.15;
	SPECULAR = 0.6;
	EMISSION = col * glow;
}
␀␀␀shader_type spatial;
// Marble Garden Atto 2, Hidden Palace: le pareti di massi di cristallo blu (Sonic 3 & Knuckles, rifatte in
// 3D: massi sfaccettati uno sull'altro). Facce dal blu notte all'azzurro chiaro secondo verso dove guardano
// e la loro tinta (colore dei vertici r), un velo di bagliore azzurro perchÃ© si leggano nel buio.
uniform vec3 dark : source_color = vec3(0.04, 0.09, 0.32);
uniform vec3 mid : source_color = vec3(0.12, 0.32, 0.78);
uniform vec3 light : source_color = vec3(0.45, 0.78, 1.0);
uniform float glow = 0.35;
uniform vec3 key_dir = vec3(-0.4, 0.75, 0.3);

void fragment() {
	vec3 wn = normalize((INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
	float k = clamp(dot(wn, normalize(key_dir)) * 0.5 + 0.5, 0.0, 1.0);
	float t = clamp(COLOR.r, 0.0, 1.0);
	vec3 c = mix(dark, mid, smoothstep(0.15, 0.6, k + (t - 0.5) * 0.4));
	c = mix(c, light, smoothstep(0.72, 0.95, k + (t - 0.5) * 0.25));
	float fr = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 3.0);
	ALBEDO = c;
	ROUGHNESS = 0.25;
	SPECULAR = 0.7;
	EMISSION = c * glow + light * fr * 0.25;
}
␀␀shader_type spatial;
// Marble Garden Atto 2, Hidden Palace: il piano dell'altare a scacchi verde acqua (come l'altare dei Super
// Emerald di Sonic 3 & Knuckles), in metri del mondo (cell metri per casella), un filo scuro fra le caselle.
uniform vec3 col_a : source_color = vec3(0.16, 0.62, 0.56);
uniform vec3 col_b : source_color = vec3(0.07, 0.36, 0.36);
uniform vec3 line : source_color = vec3(0.03, 0.12, 0.14);
uniform float cell = 0.9;
uniform float glow = 0.14;
varying vec3 wpos;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 p = wpos.xz / cell;
	vec2 f = floor(p);
	float chk = mod(f.x + f.y, 2.0);
	vec2 q = abs(fract(p) - 0.5);
	float edge = smoothstep(0.47, 0.5, max(q.x, q.y));
	vec3 c = mix(col_a, col_b, chk);
	c = mix(c, line, edge * 0.8);
	ALBEDO = c;
	METALLIC = 0.25;
	ROUGHNESS = 0.35;
	EMISSION = c * glow;
}
␀␀shader_type spatial;
// Marble Garden Atto 2, Hidden Palace (e i cristalli di Lava Reef): i cristalli sfaccettati, blu e viola
// come nei grappoli di Sonic 3 & Knuckles. Ogni faccia la sua luce (colore dei vertici b), il bordo che
// si accende di fronte alla luce (fresnel), un bagliore interno che pulsa piano.
uniform vec3 color : source_color = vec3(0.3, 0.6, 1.0);
uniform vec3 deep : source_color = vec3(0.05, 0.1, 0.4);
uniform float glow = 0.9;
uniform float pulse = 0.15;
varying vec3 wp;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	float facet = fract(COLOR.b * 3.7 + COLOR.r * 1.3);
	float fr = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 2.5);
	vec3 c = mix(deep, color, 0.35 + 0.55 * facet);
	float p = 1.0 + pulse * sin(TIME * 1.7 + wp.x * 0.4 + wp.y * 0.3);
	ALBEDO = c * 0.6;
	ROUGHNESS = 0.08;
	METALLIC = 0.0;
	SPECULAR = 0.9;
	EMISSION = (c * glow * (0.55 + 0.45 * facet) + color * fr * 1.4) * p;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Marble Garden Atto 2, Hidden Palace: il mosaico della sala (il riferimento Ã¨ quello di Sonic 3 & Knuckles,
// /mnt/project-files/riferimenti/hidden_palace/hp_murale.png), dipinto qui a "pixel" grossi come nel gioco
// (RES pixel sul pannello): il fondo blu notte a puntini viola con le stelline, il fregio di glifi verdi in
// alto, a sinistra il guardiano antico blu e viola con le placche d'oro, la cresta verde acqua e il becco
// d'oro, che tende la mano d'oro verso lo Smeraldo verde coi raggi; a destra Super Sonic nella grande
// fiammata d'oro a puntini; la cornice lilla. UV del pannello 0..1 (x a destra, y in giÃ¹).
render_mode cull_back;
uniform float energy = 1.0;
uniform float awake = 0.0;     // l'altare acceso (il finale): lo smeraldo e la fiammata brillano di piÃ¹
const vec2 RES = vec2(168.0, 84.0);

float h21(vec2 p) {
	return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}
float box(vec2 p, vec2 c, vec2 h) {
	vec2 d = abs(p - c) - h;
	return max(d.x, d.y);
}
float circ(vec2 p, vec2 c, float r) {
	return length(p - c) - r;
}
// segmento spesso
float seg(vec2 p, vec2 a, vec2 b, float r) {
	vec2 pa = p - a;
	vec2 ba = b - a;
	float hh = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
	return length(pa - ba * hh) - r;
}
float tri(vec2 p, vec2 a, vec2 b, vec2 c) {
	vec2 e0 = b - a;
	vec2 e1 = c - b;
	vec2 e2 = a - c;
	float s = sign(e0.x * e2.y - e0.y * e2.x);
	float d0 = s * (e0.x * (p.y - a.y) - e0.y * (p.x - a.x));
	float d1 = s * (e1.x * (p.y - b.y) - e1.y * (p.x - b.x));
	float d2 = s * (e2.x * (p.y - c.y) - e2.y * (p.x - c.x));
	return -min(min(d0, d1), d2);
}

void fragment() {
	vec2 px = floor(UV * RES) + 0.5;
	vec3 navy = vec3(0.07, 0.05, 0.12);
	vec3 dotc = vec3(0.3, 0.15, 0.45);
	vec3 gold = vec3(0.86, 0.66, 0.14);
	vec3 gold_d = vec3(0.55, 0.38, 0.06);
	vec3 gold_l = vec3(1.0, 0.9, 0.45);
	vec3 blue = vec3(0.12, 0.38, 0.75);
	vec3 blue_d = vec3(0.06, 0.16, 0.42);
	vec3 purple = vec3(0.5, 0.3, 0.75);
	vec3 purple_d = vec3(0.28, 0.14, 0.45);
	vec3 teal = vec3(0.2, 0.78, 0.62);
	vec3 green = vec3(0.25, 0.95, 0.55);
	vec3 lilac = vec3(0.72, 0.58, 0.92);
	vec3 c = navy;
	// i puntini viola e le stelline
	if (mod(px.x, 4.0) < 1.0 && mod(px.y, 4.0) < 1.0) {
		c = dotc;
	}
	vec2 sc = floor(px / 26.0);
	vec2 so = vec2(6.0, 9.0) + floor(vec2(h21(sc), h21(sc + 7.0)) * 14.0);
	vec2 sp = px - sc * 26.0;
	if ((abs(sp.x - so.x) < 0.6 && abs(sp.y - so.y) < 3.0) || (abs(sp.y - so.y) < 0.6 && abs(sp.x - so.x) < 3.0)) {
		c = vec3(0.32, 0.28, 0.65);
	}
	// il fregio di glifi in alto
	if (px.y > 4.0 && px.y < 10.0 && px.x > 50.0) {
		vec2 g = vec2(mod(px.x - 50.0, 10.0), px.y - 4.0);
		float gid = floor((px.x - 50.0) / 10.0);
		float r = h21(vec2(gid, 3.0));
		bool on = g.y > 4.0 || (g.x < 1.5) || (r > 0.5 && g.x > 7.5) || (r > 0.3 && abs(g.y - 2.5) < 0.6 && g.x < 6.0);
		c = on ? vec3(0.22, 0.55, 0.25) : vec3(0.06, 0.16, 0.08);
	}
	// la fiammata d'oro di Super Sonic (destra): lingue verso destra, a puntini
	float fl = min(circ(px, vec2(136.0, 46.0), 22.0), min(circ(px, vec2(150.0, 32.0), 14.0), circ(px, vec2(150.0, 62.0), 13.0)));
	for (int i = 0; i < 5; i++) {
		float fi = float(i);
		float y = 22.0 + fi * 12.0;
		fl = min(fl, seg(px, vec2(140.0, y), vec2(168.0, y - 5.0 + 3.0 * sin(TIME * 2.0 + fi)), 4.0 - 0.4 * fi));
	}
	if (fl < 0.0) {
		bool d = mod(px.x + mod(px.y, 2.0) * 2.0, 4.0) < 1.0 && mod(px.y, 2.0) < 1.0;
		c = mix(gold, gold_l, d ? 1.0 : 0.0);
		if (fl > -2.0) {
			c = gold_d;
		}
	}
	// Super Sonic: la testa con gli aculei all'indietro, il corpo, il braccio teso verso sinistra
	float ss = circ(px, vec2(132.0, 40.0), 7.5);
	ss = min(ss, tri(px, vec2(134.0, 33.0), vec2(150.0, 28.0), vec2(139.0, 41.0)));
	ss = min(ss, tri(px, vec2(136.0, 39.0), vec2(153.0, 38.0), vec2(138.0, 46.0)));
	ss = min(ss, tri(px, vec2(133.0, 44.0), vec2(149.0, 50.0), vec2(134.0, 50.0)));
	ss = min(ss, seg(px, vec2(131.0, 48.0), vec2(136.0, 60.0), 4.0));
	ss = min(ss, seg(px, vec2(129.0, 50.0), vec2(118.0, 46.0), 2.0));
	ss = min(ss, seg(px, vec2(134.0, 60.0), vec2(130.0, 70.0), 2.2));
	ss = min(ss, seg(px, vec2(137.0, 60.0), vec2(144.0, 68.0), 2.2));
	if (ss < 0.0) {
		c = ss > -1.5 ? teal : blue;
		if (circ(px, vec2(129.0, 40.0), 1.6) < 0.0) {
			c = vec3(0.95, 0.95, 1.0);
		}
		if (seg(px, vec2(126.0, 42.0), vec2(129.0, 43.0), 0.9) < 0.0) {
			c = vec3(0.85, 0.6, 0.5);
		}
	}
	// lo Smeraldo (centro) coi raggi verticali
	vec2 gc = vec2(98.0, 30.0);
	for (int i = -2; i <= 2; i++) {
		float x = gc.x + float(i) * 4.0;
		if (abs(px.x - x) < 0.6 && abs(px.y - gc.y) < 16.0 - abs(float(i)) * 2.5 && mod(px.y + floor(TIME * 6.0), 5.0) < 3.0) {
			c = mix(teal, green, awake);
		}
	}
	float gem = max(abs(px.x - gc.x) * 0.6 + abs(px.y - gc.y), abs(px.y - gc.y + 1.0) * 1.6) - 4.2;
	if (gem < 0.0) {
		c = gem > -1.4 ? vec3(0.05, 0.4, 0.25) : mix(green, vec3(0.8, 1.0, 0.85), step(px.y, gc.y - 1.0) * step(px.x, gc.x));
		c *= 1.0 + awake * 1.5;
	}
	// il guardiano antico (sinistra): il corpo a placche, la testa col becco d'oro, la cresta, il braccio
	float body = box(px, vec2(52.0, 56.0), vec2(16.0, 18.0));
	body = min(body, tri(px, vec2(34.0, 74.0), vec2(26.0, 84.0), vec2(56.0, 84.0)));
	float head = box(px, vec2(58.0, 28.0), vec2(11.0, 9.0));
	float beak = tri(px, vec2(68.0, 24.0), vec2(80.0, 30.0), vec2(68.0, 33.0));
	float crest = min(tri(px, vec2(50.0, 20.0), vec2(53.0, 10.0), vec2(56.0, 20.0)), min(tri(px, vec2(56.0, 20.0), vec2(60.0, 8.0), vec2(62.0, 20.0)), tri(px, vec2(62.0, 20.0), vec2(67.0, 11.0), vec2(66.0, 21.0))));
	float arm = min(seg(px, vec2(66.0, 50.0), vec2(80.0, 44.0), 3.0), seg(px, vec2(80.0, 44.0), vec2(90.0, 35.0), 2.4));
	float hand = min(circ(px, vec2(91.0, 35.0), 3.2), seg(px, vec2(89.0, 33.0), vec2(94.0, 27.0), 1.3));
	float gun = box(px, vec2(28.0, 38.0), vec2(12.0, 3.5));
	if (gun < 0.0) {
		c = gun > -1.2 ? gold_d : (mod(px.x, 3.0) < 1.0 ? gold_l : gold);
	}
	if (body < 0.0) {
		c = body > -1.5 ? teal : purple_d;
		float pl = box(vec2(mod(px.x - 36.0, 11.0), mod(px.y - 38.0, 9.0)), vec2(5.5, 4.5), vec2(4.0, 3.0));
		if (pl < 0.0) {
			c = pl > -1.0 ? gold : purple;
		}
		if (seg(px, vec2(38.0, 70.0), vec2(62.0, 44.0), 1.6) < 0.0) {
			c = lilac;
		}
	}
	if (crest < 0.0) {
		c = teal;
	}
	if (head < 0.0) {
		c = head > -1.4 ? teal : blue_d;
		if (circ(px, vec2(62.0, 27.0), 3.0) < 0.0) {
			c = gold;
		}
		if (circ(px, vec2(62.0, 27.0), 1.4) < 0.0) {
			c = navy;
		}
		if (abs(px.y - 32.0) < 0.6 && px.x > 49.0) {
			c = gold_d;
		}
	}
	if (beak < 0.0) {
		c = beak > -1.0 ? gold_d : gold;
	}
	if (arm < 0.0) {
		c = arm > -1.0 ? gold_d : purple;
	}
	if (hand < 0.0) {
		c = gold;
	}
	// le fiammelle a sinistra (il fuoco dei razzi del guardiano)
	for (int i = 0; i < 4; i++) {
		vec2 fc = vec2(10.0 + mod(float(i) * 5.0 + TIME * 14.0, 14.0), 44.0 + float(i) * 9.0);
		if (circ(px, fc, 2.6) < 0.0) {
			c = circ(px, fc, 1.2) < 0.0 ? vec3(1.0, 0.98, 0.85) : gold;
		}
	}
	// la cornice
	if (px.x < 3.0 || px.x > RES.x - 3.0 || px.y < 3.0 || px.y > RES.y - 3.0) {
		c = (px.x < 1.0 || px.y < 1.0 || px.x > RES.x - 1.0 || px.y > RES.y - 1.0) ? purple_d : lilac;
	}
	ALBEDO = c;
	ROUGHNESS = 0.5;
	EMISSION = c * (0.55 + 0.6 * awake) * energy;
}
␀␀␀␀␀␀shader_type spatial;
// Marble Garden Atto 2, Hidden Palace: le colonne viola della macchina antica (Sonic 3 & Knuckles): metallo
// viola a scanalature verticali, fasce chiare lavanda, anelli di finestrelle azzurre accese (UV del tornio:
// x intorno, y lungo il profilo; bands = quante fasce).
uniform vec3 purple : source_color = vec3(0.42, 0.22, 0.62);
uniform vec3 lilac : source_color = vec3(0.85, 0.72, 1.0);
uniform vec3 dark : source_color = vec3(0.12, 0.05, 0.22);
uniform vec3 light_col : source_color = vec3(0.4, 0.75, 1.0);
uniform float flutes = 24.0;
uniform float bands = 8.0;
varying vec3 wp;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	float u = UV.x * flutes;
	float fl = abs(fract(u) - 0.5) * 2.0;
	float v = UV.y * bands;
	float bv = fract(v);
	float band = smoothstep(0.82, 0.86, bv) * (1.0 - smoothstep(0.94, 0.98, bv));
	float slot = (1.0 - smoothstep(0.08, 0.14, abs(bv - 0.5))) * step(0.5, fract(UV.x * flutes * 0.5)) * step(1.0, mod(floor(v), 2.0));
	vec3 c = mix(dark, purple, smoothstep(0.0, 0.6, 1.0 - fl));
	c = mix(c, lilac, smoothstep(0.88, 1.0, 1.0 - fl) * 0.6);
	c = mix(c, lilac, band);
	float pulse = 0.75 + 0.25 * sin(TIME * 2.0 + floor(v) * 1.3);
	ALBEDO = mix(c, light_col, slot * 0.6);
	METALLIC = 0.55;
	ROUGHNESS = 0.32;
	EMISSION = light_col * slot * 2.2 * pulse + c * 0.12;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Marble Garden Atto 2, Hidden Palace: la parete di piastrelle viola dietro il mosaico (Sonic 3 & Knuckles):
// riquadri smussati con la borchia al centro, in metri sulle UV (uv_scale piastrelle per metro).
uniform vec3 tile : source_color = vec3(0.32, 0.18, 0.55);
uniform vec3 tile_hi : source_color = vec3(0.62, 0.45, 0.9);
uniform vec3 grout : source_color = vec3(0.06, 0.03, 0.12);
uniform vec2 uv_scale = vec2(0.5, 0.5);
uniform float glow = 0.12;

void fragment() {
	vec2 p = UV * uv_scale;
	vec2 q = fract(p);
	vec2 d = abs(q - 0.5);
	float m = max(d.x, d.y);
	float body = smoothstep(0.48, 0.45, m);
	float bevel = smoothstep(0.45, 0.36, m);
	float stud = smoothstep(0.12, 0.08, length(q - 0.5));
	vec3 c = mix(grout, tile_hi, body);
	c = mix(c, tile, bevel);
	c = mix(c, tile_hi * 1.1, stud);
	ALBEDO = c;
	METALLIC = 0.3;
	ROUGHNESS = 0.4;
	EMISSION = c * glow;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Marble Garden Atto 2, Lava Reef: le cascate di lava (quadrilateri lungo la parete, UV.y in giÃ¹). Lava che
// scende (grumi e bande che scorrono), bordi piÃ¹ scuri e sfrangiati, accesa da sÃ©.
render_mode unshaded, cull_disabled, fog_disabled;
#include "res://shaders/env/mgz2/deep_noise.gdshaderinc"
uniform float speed = 0.9;
uniform float stretch = 14.0;
uniform float energy = 2.2;

void fragment() {
	vec2 uv = UV;
	float f1 = dn_noise3(vec3(uv.x * 7.0, uv.y * stretch - TIME * speed * 3.0, 0.3));
	float f2 = dn_noise3(vec3(uv.x * 19.0, uv.y * stretch * 2.4 - TIME * speed * 5.5, 4.1));
	float flow = f1 * 0.65 + f2 * 0.35;
	float side = abs(uv.x - 0.5) * 2.0;
	float edge = 1.0 - smoothstep(0.55 + 0.3 * f1, 1.0, side);
	vec3 dark = vec3(0.45, 0.05, 0.01);
	vec3 mid = vec3(1.0, 0.32, 0.03);
	vec3 hot = vec3(1.0, 0.82, 0.38);
	vec3 c = mix(dark, mid, smoothstep(0.25, 0.6, flow));
	c = mix(c, hot, smoothstep(0.68, 0.92, flow) * (1.0 - side));
	ALBEDO = c * energy;
	ALPHA = edge;
	ALPHA_SCISSOR_THRESHOLD = 0.5;
}
␀␀␀␀␀␀␀␀␀shader_type spatial;
// Marble Garden Atto 2, Lava Reef: la colonna di lava che erutta (Mgz2Hazards.Eruption). Cilindro senza
// tappi: lava che sale veloce (bande e grumi), bordo piÃ¹ scuro, cima che sfuma; tutto acceso da sÃ©.
render_mode unshaded, cull_disabled, blend_mix, depth_draw_never, fog_disabled;
uniform float fade = 1.0;

float h(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}
float n2(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(h(i), h(i + vec2(1.0, 0.0)), f.x), mix(h(i + vec2(0.0, 1.0)), h(i + vec2(1.0, 1.0)), f.x), f.y);
}
void fragment() {
	vec2 uv = UV;
	float v = uv.y;
	float flow = n2(vec2(uv.x * 9.0, v * 3.0 + TIME * 7.0)) * 0.6 + n2(vec2(uv.x * 23.0, v * 8.0 + TIME * 13.0)) * 0.4;
	float edge = pow(abs(dot(NORMAL, VIEW)), 0.6);
	vec3 hot = vec3(1.0, 0.78, 0.3);
	vec3 mid = vec3(1.0, 0.36, 0.05);
	vec3 dark = vec3(0.35, 0.04, 0.01);
	vec3 c = mix(dark, mid, smoothstep(0.15, 0.6, flow * edge + 0.2));
	c = mix(c, hot, smoothstep(0.62, 0.9, flow) * edge);
	// in cima (uv.y = 0) sfuma in schizzi
	float top = smoothstep(0.0, 0.35, v + (flow - 0.5) * 0.3);
	ALBEDO = c * 2.2;
	ALPHA = clamp(top * fade * (0.55 + 0.45 * edge), 0.0, 1.0);
}
␀␀shader_type spatial;
// Marble Garden Atto 2, Lava Reef (deep_world.gd): la roccia vulcanica alla maniera di Sonic 3 & Knuckles,
// rifatta in 3D: basalto scuro viola e bruno rossastro a chiazze (rumore in coordinate del mondo, tre
// proiezioni), le venature di lava accese nelle crepe (celle di Worley), piÃ¹ accese vicino alla lava (sotto
// glow_h metri da lava_y) e dove il colore dei vertici ha il verde (calore del pezzo).
#include "res://shaders/env/mgz2/deep_noise.gdshaderinc"
uniform vec3 base_a : source_color = vec3(0.11, 0.045, 0.08);
uniform vec3 base_b : source_color = vec3(0.36, 0.14, 0.19);
uniform vec3 top_col : source_color = vec3(0.4, 0.22, 0.22);
uniform vec3 crack_col : source_color = vec3(1.0, 0.36, 0.05);
uniform vec3 hot_col : source_color = vec3(1.0, 0.75, 0.3);
uniform float heat = 1.0;
uniform float lava_y = -153.6;
uniform float glow_h = 9.0;
uniform float crack_scale = 0.32;
uniform float crack_w = 0.03;
uniform float patch = 0.5;
varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 bw = pow(abs(wn), vec3(4.0));
	bw /= (bw.x + bw.y + bw.z);
	float n = dn_fbm3(wp * 0.18);
	float fine = dn_noise3(wp * 1.3);
	vec3 col = mix(base_a, base_b, smoothstep(0.3, 0.75, n + (COLOR.r - 0.5) * 0.4));
	col *= 0.8 + 0.35 * fine;
	// le facce in su piÃ¹ chiare (cenere, polvere)
	col = mix(col, top_col * (0.8 + 0.3 * fine), smoothstep(0.55, 0.95, wn.y) * 0.45);
	// le crepe accese: Worley sulle tre proiezioni
	vec2 cx = dn_worley(wp.zy * crack_scale);
	vec2 cy = dn_worley(wp.xz * crack_scale);
	vec2 cz = dn_worley(wp.xy * crack_scale);
	float e = (cx.y - cx.x) * bw.x + (cy.y - cy.x) * bw.y + (cz.y - cz.x) * bw.z;
	float vein = 1.0 - smoothstep(crack_w * 0.25, crack_w, e);
	float near = 1.0 - smoothstep(0.0, glow_h, wp.y - lava_y);
	// le venature solo a chiazze (e sempre vicino alla lava)
	float pm = smoothstep(patch, patch + 0.12, dn_fbm3(wp * 0.045 + vec3(3.1, 0.0, 7.7)));
	vein *= max(pm, near);
	float h = clamp(heat * (0.2 + 0.8 * max(near, COLOR.g * 0.7)), 0.0, 1.5);
	float flick = 0.85 + 0.15 * sin(TIME * 2.3 + wp.x * 0.3 + wp.z * 0.2);
	vec3 glow = mix(crack_col, hot_col, vein * vein * 0.6) * vein * h * flick;
	// bagliore della lava da sotto sulle facce in giÃ¹ vicine
	vec3 under = crack_col * 0.35 * near * smoothstep(0.0, -0.8, wn.y) * heat;
	// i bordi delle facce (normali piatte) un filo piÃ¹ chiari: si legge la forma anche al buio
	float rim = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 3.0);
	col += base_b * rim * 0.35;
	ALBEDO = col * (1.0 - vein * 0.7);
	ROUGHNESS = 0.85 - 0.3 * fine;
	SPECULAR = 0.35;
	EMISSION = glow * 2.4 + under + col * 0.06;
}
␀␀␀␀␀shader_type spatial;
// Mushroom Hill Zone: l'acqua della pozza della cascata e del ruscello. Verde-azzurro limpido (mai viola):
// increspature in movimento (due strati di rumore dalle derivate), il riflesso del cielo ai margini
// (Fresnel), il fondo che si intravede piÃ¹ scuro, gli anelli di schiuma dove cade la cascata (la
// distanza dal punto "splash" in pianta).
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/mhz/mhz_common.gdshaderinc"

uniform vec3 deep : source_color = vec3(0.03, 0.22, 0.24);
uniform vec3 shallow : source_color = vec3(0.16, 0.52, 0.48);
uniform vec3 sky : source_color = vec3(0.62, 0.84, 0.98);
uniform vec3 foam : source_color = vec3(0.95, 0.98, 1.0);
uniform vec2 splash = vec2(0.0, 0.0);
uniform float splash_r = 0.0;
uniform float alpha = 0.86;

varying vec3 wp;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 p = wp.xz;
	float t = TIME;
	float h = lbz_fbm(p * 0.35 + vec2(t * 0.12, t * 0.07)) * 0.6 + lbz_noise(p * 1.4 - vec2(t * 0.3, -t * 0.2)) * 0.4;
	vec3 n = lbz_bump(NORMAL, VERTEX, h * 0.08, 1.0);
	float fres = pow(1.0 - clamp(dot(n, VIEW), 0.0, 1.0), 4.0);
	vec3 col = mix(shallow, deep, smoothstep(0.3, 0.8, h));
	col = mix(col, sky, fres * 0.65);
	// la schiuma dove cade la cascata: anelli che si allargano
	if (splash_r > 0.0) {
		float d = distance(p, splash) / splash_r;
		float ring = 0.5 + 0.5 * sin(d * 18.0 - t * 4.0);
		float fk = (1.0 - smoothstep(0.2, 1.0, d)) * smoothstep(0.35, 0.8, ring * h + 0.2);
		col = mix(col, foam, fk);
	}
	ALBEDO = col;
	ALPHA = alpha;
	ROUGHNESS = 0.06;
	SPECULAR = 0.7;
	NORMAL = n;
}
␀␀␀␀␀␀␀shader_type spatial;
// Mushroom Hill Zone: la foresta lontana tutt'intorno (un anello di carte alte oltre i confini, come la
// fila di alberi verde scuro sullo sfondo di Sonic 3 & Knuckles): le sagome delle chiome tonde e dei
// tronchi (alpha scissor), due file sfalsate, verdi scure e piÃ¹ azzurrine con la distanza (la nebbia del
// mondo fa il resto). UV.x = metri lungo l'anello, UV.y = 0 in basso, 1 in alto.
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley, specular_schlick_ggx, shadows_disabled;

#include "res://shaders/env/mhz/mhz_common.gdshaderinc"

uniform vec3 near_col : source_color = vec3(0.07, 0.20, 0.06);
uniform vec3 far_col : source_color = vec3(0.16, 0.30, 0.20);
uniform vec3 trunk_col : source_color = vec3(0.24, 0.12, 0.05);
uniform float layer = 0.0;
uniform float autumn = 0.0;
uniform vec3 fall_col : source_color = vec3(0.55, 0.32, 0.08);

void fragment() {
	float x = UV.x / 22.0;
	float id = floor(x);
	float f = fract(x);
	float h = 0.55 + 0.4 * lbz_hash(vec2(id, layer));
	float crown = 0.0;
	for (int k = -1; k <= 1; k++) {
		float cx = float(k) + 0.5 + (lbz_hash(vec2(id + float(k), 5.0 + layer)) - 0.5) * 0.5;
		float hk = 0.55 + 0.4 * lbz_hash(vec2(id + float(k), layer));
		vec2 q = vec2((f - cx) * 1.6, (UV.y - hk) * 2.2);
		float wob = lbz_noise(vec2(UV.x * 0.5, UV.y * 6.0)) * 0.18;
		crown = max(crown, step(length(q) + wob, 0.42));
	}
	float trunk = step(abs(f - 0.5), 0.035) * step(UV.y, h - 0.2);
	float under = step(UV.y, 0.42 + 0.06 * lbz_noise(vec2(UV.x * 0.3, 0.0)));
	if (crown + trunk + under < 0.5) {
		discard;
	}
	vec3 c = mix(near_col, far_col, layer);
	c = mix(c, fall_col, autumn * step(0.6, lbz_hash(vec2(id, 9.0))) * 0.7);
	c *= 0.8 + 0.4 * lbz_noise(vec2(UV.x * 0.4, UV.y * 4.0));
	c = mix(c, trunk_col, trunk * (1.0 - crown));
	ALBEDO = c;
	ROUGHNESS = 1.0;
	SPECULAR = 0.0;
}
␀␀␀␀␀␀␀shader_type sky;
// Mushroom Hill Zone: il cielo del mattino (Atto 1) e del pomeriggio d'autunno (Atto 2). Azzurro pieno di
// Sonic 3 & Knuckles fatto oggi: zenit blu intenso, orizzonte chiaro appena caldo, nuvole a cumulo morbide
// (fbm che scorre piano, piÃ¹ dense all'orizzonte), il disco del sole col bagliore. Sotto l'orizzonte il
// verde scuro della foresta lontana (niente buco blu sotto). Tinte fra 40 e 215 gradi: niente viola.

#include "res://shaders/env/mhz/mhz_common.gdshaderinc"

uniform vec3 zenith : source_color = vec3(0.05, 0.27, 0.78);
uniform vec3 mid : source_color = vec3(0.20, 0.55, 0.95);
uniform vec3 horizon : source_color = vec3(0.78, 0.90, 0.98);
uniform vec3 warm : source_color = vec3(1.0, 0.86, 0.62);
uniform vec3 ground : source_color = vec3(0.17, 0.14, 0.08);
uniform vec3 cloud_lit : source_color = vec3(1.0, 0.98, 0.94);
uniform vec3 cloud_shade : source_color = vec3(0.62, 0.72, 0.84);
uniform float cloud_cover = 0.5;
uniform float sun_size = 0.9994;

void sky() {
	vec3 d = EYEDIR;
	float y = d.y;
	vec3 col = mix(horizon, mid, smoothstep(0.0, 0.25, y));
	col = mix(col, zenith, smoothstep(0.25, 0.9, y));
	vec3 sd = LIGHT0_DIRECTION;
	float sun = max(dot(d, sd), 0.0);
	col += warm * (pow(sun, 6.0) * 0.25 + pow(sun, 60.0) * 0.4) * (1.0 - smoothstep(0.0, 0.6, y) * 0.5);
	if (y > 0.0) {
		vec2 uv = d.xz / (y + 0.12) * 1.2;
		float c = lbz_fbm(uv * 0.9 + vec2(TIME * 0.004, TIME * 0.002));
		float c2 = lbz_fbm(uv * 2.7 - vec2(TIME * 0.006, 0.0));
		float cov = cloud_cover + 0.25 * (1.0 - smoothstep(0.0, 0.5, y));
		float a = smoothstep(1.0 - cov, 1.0 - cov + 0.28, c * 0.75 + c2 * 0.25);
		vec3 cc = mix(cloud_shade, cloud_lit, smoothstep(0.3, 0.9, c2 + sun * 0.4));
		col = mix(col, cc, a * smoothstep(0.0, 0.08, y) * 0.92);
	}
	if (!AT_CUBEMAP_PASS) {
		col += vec3(1.0, 0.97, 0.9) * smoothstep(sun_size, sun_size + 0.0003, sun) * 6.0;
	}
	col = mix(col, ground, smoothstep(0.0, -0.08, y));
	COLOR = col;
}
␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Mushroom Hill Zone: i ciuffi d'erba alta e le felci sul prato (MultiMesh a celle, carte incrociate):
// fili appuntiti (alpha scissor), verde scuro alla base e chiaro in punta, il vento. UV.y = 0 in alto.
// COLOR.r = 1 per le felci (foglioline a pettine), 0 per l'erba.
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/mhz/mhz_common.gdshaderinc"

uniform vec3 base_col : source_color = vec3(0.07, 0.24, 0.04);
uniform vec3 tip_col : source_color = vec3(0.42, 0.70, 0.14);
uniform vec3 fall_col : source_color = vec3(0.78, 0.52, 0.12);
uniform float autumn = 0.0;

varying float fern;
varying float vh;

void vertex() {
	vec3 org = MODEL_MATRIX[3].xyz;
	float ph = fract(sin(dot(org.xz, vec2(12.9898, 78.233))) * 43758.5453) * 6.2832;
	float k = 1.0 - UV.y;
	VERTEX.x += sin(TIME * 1.9 + ph) * 0.09 * k * k;
	VERTEX.z += cos(TIME * 1.5 + ph) * 0.07 * k * k;
	fern = COLOR.r;
	vh = fract(ph * 7.1);
}

void fragment() {
	float y = 1.0 - UV.y;
	float a;
	if (fern > 0.5) {
		float spine = abs(UV.x - 0.5);
		float lv = fract(UV.y * 9.0);
		float w = 0.5 * (1.0 - y * 0.8) * (0.4 + 0.6 * sin(3.14159 * lv));
		a = step(spine, max(w, 0.03));
	} else {
		float x = UV.x * 7.0;
		float id = floor(x);
		float len = 0.5 + 0.5 * lbz_hash(vec2(id, 2.0));
		float w = 0.45 * (1.0 - y / len);
		a = step(abs(fract(x) - 0.5), w) * step(y, len);
	}
	if (a < 0.5) {
		discard;
	}
	vec3 col = mix(base_col, tip_col, smoothstep(0.0, 0.9, y));
	col = mix(col, fall_col * (0.6 + 0.6 * y), autumn * step(0.55, vh) * 0.8);
	ALBEDO = col;
	ROUGHNESS = 0.8;
	BACKLIGHT = col * 0.5;
}
␀␀shader_type spatial;
// Mushroom Hill Zone: la corteccia dei tronchi altissimi (arancio-bruno di Sonic 3 & Knuckles) e dei
// tronchi caduti. Coordinate del modello (i tronchi sono MultiMesh o pezzi del kit): scanalature verticali
// profonde e irregolari, placche piÃ¹ chiare fra le scanalature, nodi; muschio sul lato in ombra in basso.
// UV: x = giro (0..1), y = quota in metri dal piede (le mesh lo scrivono); COLOR.a = 1 sui tagli (anelli
// del legno chiaro).
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/mhz/mhz_common.gdshaderinc"

uniform vec3 bark_a : source_color = vec3(0.74, 0.34, 0.10);
uniform vec3 bark_b : source_color = vec3(0.38, 0.14, 0.04);
uniform vec3 bark_dark : source_color = vec3(0.12, 0.05, 0.02);
uniform vec3 moss : source_color = vec3(0.20, 0.36, 0.08);
uniform vec3 wood_cut : source_color = vec3(0.86, 0.66, 0.38);
uniform float grooves = 22.0;
uniform float relief = 1.4;
uniform bool use_cut = true;

varying vec3 wp;
varying vec3 wn;
varying float cut;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	cut = use_cut ? COLOR.a : 0.0;
}

void fragment() {
	float u = UV.x * grooves;
	float y = UV.y;
	float wob = lbz_noise(vec2(u * 0.4, y * 0.18)) * 1.6;
	float g = fract(u + wob);
	float groove = smoothstep(0.0, 0.18, g) * smoothstep(1.0, 0.72, g);
	float plates = lbz_fbm(vec2(u * 0.9, y * 0.55));
	vec3 col = mix(bark_b, bark_a, groove * (0.6 + 0.5 * plates));
	col = mix(bark_dark, col, smoothstep(0.0, 0.25, groove));
	col *= 0.85 + 0.3 * lbz_noise(vec2(u * 3.0, y * 2.0));
	// nodi
	float knot = smoothstep(0.86, 0.95, lbz_noise(vec2(u * 0.5, y * 0.12) + 4.0));
	col = mix(col, bark_dark * 1.5, knot * 0.6);
	// muschio in basso
	float mk = smoothstep(4.0, 0.0, y) * smoothstep(0.35, 0.7, lbz_fbm(vec2(u * 0.6, y * 0.8) + 2.0));
	col = mix(col, moss, mk * 0.7);
	// i tagli: anelli del legno
	vec3 rings = wood_cut * (0.85 + 0.15 * sin(length(UV - vec2(0.5)) * 90.0));
	col = mix(col, rings, cut);
	ALBEDO = col;
	ROUGHNESS = 0.88;
	SPECULAR = 0.25;
	NORMAL = lbz_bump(NORMAL, VERTEX, groove * 0.06 * (1.0 - cut), relief);
}
␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Mushroom Hill Zone: le chiome (scripts/env/gen_mhz/forme.gd chioma(): grappoli di carte di foglie su
// un guscio, MultiMesh a celle). Ogni carta disegna un ciuffo di foglie appuntite (ellissi girate attorno
// al picciolo) e scarta il resto (alpha scissor): da vicino si vedono le foglie, da lontano la massa
// frastagliata. Verde profondo dentro, piÃ¹ chiaro e giallo-verde sui bordi al sole; COLOR.r = quanto la
// carta sta fuori dal guscio (le esterne piÃ¹ chiare), COLOR.g = la fase del vento, COLOR.b = autunno
// della carta (0..1: verde -> giallo -> arancio, solo con "autumn" > 0). Il vento le fa ondeggiare; la
// luce passa (BACKLIGHT).
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/mhz/mhz_common.gdshaderinc"

uniform vec3 leaf_dark : source_color = vec3(0.04, 0.18, 0.04);
uniform vec3 leaf_mid : source_color = vec3(0.12, 0.40, 0.08);
uniform vec3 leaf_lit : source_color = vec3(0.42, 0.66, 0.12);
uniform vec3 fall_y : source_color = vec3(0.86, 0.66, 0.10);
uniform vec3 fall_o : source_color = vec3(0.84, 0.34, 0.06);
uniform float autumn = 0.0;
uniform float sway = 0.18;
uniform float cut = 0.5;

varying vec3 vcol;
varying float vh;

void vertex() {
	vec3 org = MODEL_MATRIX[3].xyz;
	float ph = fract(sin(dot(org.xz, vec2(12.9898, 78.233))) * 43758.5453) * 6.2832 + COLOR.g * 6.2832;
	float t = TIME * 1.1 + ph;
	VERTEX += vec3(sin(t), sin(t * 1.7) * 0.4, cos(t * 0.8)) * sway * COLOR.r;
	vcol = COLOR.rgb;
	vh = fract(sin(dot(org.xz + VERTEX.xz, vec2(3.1, 7.7))) * 437.5);
}

// un ciuffo di foglie: 5 ellissi appuntite girate attorno al punto basso della carta
float leaves(vec2 uv, float seed) {
	vec2 o = vec2(0.5, 0.08);
	float a = 0.0;
	for (int i = 0; i < 5; i++) {
		float fi = float(i);
		float ang = -1.0 + fi * 0.5 + (lbz_hash(vec2(seed, fi)) - 0.5) * 0.4;
		vec2 dir = vec2(sin(ang), cos(ang));
		vec2 q = uv - o;
		float along = dot(q, dir);
		float side = dot(q, vec2(dir.y, -dir.x));
		float len = 0.62 + 0.25 * lbz_hash(vec2(fi, seed + 3.0));
		float k = along / len;
		float w = 0.17 * sin(3.14159 * clamp(k, 0.0, 1.0));
		w *= 1.0 - 0.3 * k;
		float leaf = step(0.0, k) * step(k, 1.0) * step(abs(side), w);
		a = max(a, leaf * (0.6 + 0.4 * (1.0 - abs(side) / max(w, 1e-3))));
	}
	return a;
}

void fragment() {
	float seed = floor(vcol.g * 97.0);
	float l = leaves(UV, seed);
	if (l < cut) {
		discard;
	}
	float edge = vcol.r;
	vec3 col = mix(leaf_dark, leaf_mid, smoothstep(0.0, 0.7, edge + (l - 0.6) * 0.6));
	col = mix(col, leaf_lit, smoothstep(0.55, 1.0, edge) * (0.5 + 0.5 * vh));
	// autunno: le carte passano al giallo e all'arancio
	float au = clamp(vcol.b * autumn * 1.4, 0.0, 1.0);
	vec3 fall = mix(fall_y, fall_o, smoothstep(0.3, 0.9, vh));
	col = mix(col, fall * (0.7 + 0.4 * edge), au);
	// la nervatura chiara
	col *= 0.86 + 0.24 * l;
	ALBEDO = col;
	ROUGHNESS = 0.7;
	SPECULAR = 0.35;
	BACKLIGHT = col * 0.6;
}
␀␀␀␀␀␀␀shader_type spatial;
// Mushroom Hill Zone: l'erba che pende oltre il ciglio delle pareti di terra intrecciata (come i bordi a
// scacchi di Sonic 3 & Knuckles che sporgono sopra la roccia): nastri lungo il bordo, fili d'erba che
// scendono di lunghezze diverse (alpha scissor), verde chiaro in cima e scuro in punta, mossi dal vento.
// UV.x = metri lungo il bordo, UV.y = 0 in cima, 1 in fondo al nastro.
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/mhz/mhz_common.gdshaderinc"

uniform vec3 top_col : source_color = vec3(0.32, 0.64, 0.11);
uniform vec3 tip_col : source_color = vec3(0.10, 0.30, 0.05);

void vertex() {
	float k = UV.y;
	VERTEX.x += sin(TIME * 1.6 + UV.x * 0.9) * 0.05 * k;
	VERTEX.z += cos(TIME * 1.3 + UV.x * 0.7) * 0.05 * k;
}

void fragment() {
	float x = UV.x * 9.0;
	float blade = fract(x);
	float id = floor(x);
	float len = 0.35 + 0.65 * lbz_hash(vec2(id, 1.0));
	float clumpy = lbz_noise(vec2(UV.x * 0.8, 0.0));
	len *= 0.6 + 0.6 * clumpy;
	float w = 0.5 * (1.0 - UV.y / max(len, 0.05));
	if (UV.y > len || abs(blade - 0.5) > w) {
		discard;
	}
	vec3 col = mix(top_col, tip_col, smoothstep(0.0, len, UV.y));
	col *= 0.85 + 0.3 * lbz_hash(vec2(id, 7.0));
	ALBEDO = col;
	ROUGHNESS = 0.8;
	BACKLIGHT = col * 0.4;
}
␀␀␀␀␀␀␀shader_type spatial;
// Mushroom Hill Zone: i funghi giganti (scripts/env/gen_mhz/forme.gd). Il cappello (COLOR.a = 0): il colore
// base nei vertici (rosso, arancio, giallo; quelli piccoli azzurro-verdi: mai viola), le macchie bianche
// rotonde in rilievo (Voronoi sul cappello, piÃ¹ grandi in cima), la lucentezza; sotto (la normale verso
// il basso) le lamelle crema a raggiera. Il gambo (COLOR.a = 1): crema-arancio con le fibre in verticale e
// l'anello. UV.x = giro (0..1), UV.y = dal centro del cappello (0) al bordo (1) o quota del gambo (m).
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/mhz/mhz_common.gdshaderinc"

uniform vec3 spot : source_color = vec3(0.98, 0.96, 0.88);
uniform vec3 gills : source_color = vec3(0.92, 0.80, 0.58);
uniform vec3 stem_a : source_color = vec3(0.96, 0.70, 0.36);
uniform vec3 stem_b : source_color = vec3(0.78, 0.44, 0.16);
uniform float glow = 0.0;

varying vec3 vcol;
varying float stem;
varying vec3 ln;

void vertex() {
	vcol = COLOR.rgb;
	stem = COLOR.a;
	ln = NORMAL;
}

void fragment() {
	vec3 base = pow(vcol, vec3(2.2));
	if (stem > 0.5) {
		float f = lbz_noise(vec2(UV.x * 40.0, UV.y * 0.8));
		vec3 col = mix(stem_b, stem_a, 0.55 + 0.45 * f);
		col *= 0.9 + 0.15 * lbz_noise(vec2(UV.x * 120.0, UV.y * 4.0));
		ALBEDO = col;
		ROUGHNESS = 0.7;
		SPECULAR = 0.3;
		NORMAL = lbz_bump(NORMAL, VERTEX, f * 0.02, 1.0);
	} else {
		float under = smoothstep(0.1, -0.35, ln.y);
		// le macchie: Voronoi sulla calotta (giro x 9 celle, dal centro al bordo 3.5)
		vec3 v = lbz_voronoi(vec2(UV.x * 9.0, UV.y * 3.6));
		float r = mix(0.33, 0.2, UV.y) * (0.75 + 0.5 * v.z);
		float sp = (1.0 - smoothstep(r - 0.04, r, v.x)) * step(0.25, v.z);
		vec3 col = base * (0.85 + 0.25 * lbz_fbm(UV * vec2(18.0, 6.0)));
		col = mix(col, base * 0.6, smoothstep(0.75, 1.0, UV.y) * 0.5);
		col = mix(col, spot, sp * (1.0 - under));
		// sotto: le lamelle
		float gl = 0.5 + 0.5 * sin(UV.x * 6.2832 * 70.0);
		vec3 gc = gills * (0.75 + 0.3 * gl);
		col = mix(col, gc, under);
		ALBEDO = col;
		ROUGHNESS = mix(0.35, 0.85, under) + sp * 0.2;
		SPECULAR = 0.5;
		CLEARCOAT = 0.25 * (1.0 - under);
		NORMAL = lbz_bump(NORMAL, VERTEX, sp * 0.03 + under * gl * 0.01, 1.0);
		EMISSION = base * glow * (1.0 - under);
	}
}
␀␀␀shader_type spatial;
// Mushroom Hill Zone: il legno lavorato (le passerelle fra i tronchi, le carrucole, la palizzata, il
// cartello di legno). Coordinate del mondo (i pezzi del kit non hanno UV): assi lunghe con le venature
// lungo X o Z (quella piÃ¹ lunga della faccia), le fessure fra le assi, i chiodi scuri.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/mhz/mhz_common.gdshaderinc"

uniform vec3 wood_a : source_color = vec3(0.66, 0.42, 0.20);
uniform vec3 wood_b : source_color = vec3(0.44, 0.25, 0.10);
uniform float plank = 0.45;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec2 uv = abs(wn.y) > 0.6 ? wp.xz : (abs(wn.x) > abs(wn.z) ? vec2(wp.z, wp.y) : vec2(wp.x, wp.y));
	float row = floor(uv.y / plank);
	float off = lbz_hash(vec2(row, 3.0)) * 7.0;
	float gr = lbz_fbm(vec2((uv.x + off) * 0.6, uv.y * 9.0));
	vec3 col = mix(wood_b, wood_a, gr);
	float seam = smoothstep(0.0, 0.04, fract(uv.y / plank)) * smoothstep(1.0, 0.96, fract(uv.y / plank));
	col *= 0.55 + 0.45 * seam;
	col *= 0.85 + 0.25 * lbz_hash(vec2(row, 9.0));
	ALBEDO = col;
	ROUGHNESS = 0.8;
	SPECULAR = 0.25;
	NORMAL = lbz_bump(NORMAL, VERTEX, seam * 0.01 + gr * 0.006, 1.0);
}
␀␀␀␀␀␀␀␀␀␀␀// Mushroom Hill Zone: i pezzi in comune degli shader della foresta (terreno, corteccia, foglie, funghi,
// legno, acqua, cielo). Il rumore e il rilievo dalle derivate sono quelli di Launch Base
// (shaders/env/lbz/lbz_common.gdshaderinc: hash, value noise, fbm, Voronoi, lbz_bump); qui l'intreccio
// della terra a cesto (la roccia giallo-verde di Sonic 3 & Knuckles) e la luce a chiazze della chioma.
#include "res://shaders/env/lbz/lbz_common.gdshaderinc"

// L'intreccio a cesto: celle quadrate di lato "cell" m; nelle celle pari tre trecce orizzontali, nelle
// dispari tre verticali (come il vimini); ogni treccia Ã¨ un cordone arrotondato che si gonfia al centro
// della cella e si stringe ai bordi. Torna vec2(altezza 0..1, fessura 0..1).
vec2 mhz_weave(vec2 uv, float cell) {
	vec2 q = uv / cell;
	vec2 ci = floor(q);
	vec2 f = fract(q);
	float par = mod(ci.x + ci.y, 2.0);
	vec2 g = par < 0.5 ? f : f.yx;
	float s = fract(g.y * 3.0);
	float strand = pow(max(sin(3.14159 * s), 0.0), 0.55);
	float along = pow(max(sin(3.14159 * g.x), 0.0), 0.35);
	float h = strand * (0.55 + 0.45 * along);
	float gap = 1.0 - smoothstep(0.02, 0.22, strand) * smoothstep(0.0, 0.12, min(g.x, 1.0 - g.x));
	return vec2(h, gap);
}

// La luce che filtra dalla chioma: chiazze calde che scorrono piano col vento (0 = ombra, 1 = sole).
float mhz_dapple(vec2 p, float t) {
	float a = lbz_fbm(p * 0.045 + vec2(t * 0.012, t * 0.007));
	float b = lbz_noise(p * 0.21 + vec2(-t * 0.05, t * 0.03));
	return smoothstep(0.42, 0.68, a * 0.75 + b * 0.25);
}
␀␀␀shader_type spatial;
// Mushroom Hill Zone: i raggi di sole che passano fra le chiome (fasci caldi additivi, tre carte
// incrociate per raggio). Sfumati ai bordi, in cima e in fondo, e quando la camera Ã¨ vicina (niente muro
// di luce davanti agli occhi); un filo di polvere che scorre dentro. UV.x di traverso, UV.y dall'alto.
render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

#include "res://shaders/env/mhz/mhz_common.gdshaderinc"

uniform vec3 col : source_color = vec3(1.0, 0.88, 0.58);
uniform float strength = 0.16;

varying vec3 wp;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	float edge = sin(3.14159 * clamp(UV.x, 0.0, 1.0));
	float ends = smoothstep(0.0, 0.25, UV.y) * smoothstep(1.0, 0.6, UV.y);
	float dust = 0.7 + 0.3 * lbz_noise(vec2(UV.x * 6.0, UV.y * 10.0 - TIME * 0.2));
	float near = smoothstep(3.0, 14.0, length(wp - CAMERA_POSITION_WORLD));
	ALBEDO = col * strength * pow(edge, 2.0) * ends * dust * near;
}
␀␀␀␀shader_type spatial;
// Mushroom Hill Zone: il terreno (scripts/env/gen_mhz/terreno.gd). Sopra, dove Ã¨ piano, l'erba a scacchi
// di Sonic 3 & Knuckles rifatta oggi: il motivo a rombi verde chiaro e verde scuro appena accennato sotto
// i ciuffi a rumore, le punte giallo-verdi, le macchie scure della chioma; sul ripido la terra intrecciata
// a cesto giallo-oliva (mhz_weave, proiettata di lato: triplanare su X e Z) con le fessure scure e il
// rilievo vero. COLOR.r = sentiero (terra battuta, dove passa il percorso), COLOR.g = muschio scuro ai
// piedi delle pareti. Colori: niente viola (tinte fra 40 e 140 gradi).
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/mhz/mhz_common.gdshaderinc"

uniform vec3 grass_a : source_color = vec3(0.30, 0.62, 0.10);
uniform vec3 grass_b : source_color = vec3(0.13, 0.38, 0.06);
uniform vec3 grass_tip : source_color = vec3(0.62, 0.78, 0.16);
uniform vec3 earth_a : source_color = vec3(0.82, 0.60, 0.22);
uniform vec3 earth_b : source_color = vec3(0.54, 0.36, 0.11);
uniform vec3 earth_gap : source_color = vec3(0.12, 0.08, 0.03);
uniform vec3 path_col : source_color = vec3(0.56, 0.38, 0.20);
uniform vec3 leaf_fall : source_color = vec3(0.80, 0.42, 0.10);
uniform float autumn = 0.0;
uniform float relief = 1.0;
uniform float weave_cell = 1.6;
// i pezzi del kit (colonne, il labbro della cascata) non hanno i colori dei vertici: false
uniform bool use_vc = true;

varying vec3 wp;
varying vec3 wn;
varying vec3 vc;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	vc = use_vc ? COLOR.rgb : vec3(0.0);
}

void fragment() {
	vec2 p = wp.xz;
	float n1 = lbz_fbm(p * 0.06);
	float n2 = lbz_noise(p * 1.3);
	float n3 = lbz_noise(p * 5.5);
	// erba o terra: dalla pendenza, con il bordo frastagliato
	float gk = smoothstep(0.58, 0.74, wn.y + (n2 - 0.5) * 0.18 + (n1 - 0.5) * 0.1);
	// ---- l'erba: rombi a scacchi (Sonic 3) sotto i ciuffi
	vec2 d = vec2(p.x + p.y, p.x - p.y) * 0.62;
	float chk = mod(floor(d.x) + floor(d.y), 2.0);
	vec3 g = mix(grass_b, grass_a, 0.22 + 0.56 * chk);
	float clump = lbz_fbm(p * 0.55 + n1);
	g = mix(g, grass_a * 1.12, smoothstep(0.45, 0.8, clump) * 0.6);
	g = mix(g, grass_b * 0.8, smoothstep(0.55, 0.25, clump) * 0.45);
	g = mix(g, grass_tip, smoothstep(0.72, 0.95, n3) * 0.45);
	g *= 0.86 + 0.28 * n1;
	// foglie cadute (autunno, Atto 2): macchie arancio sparse
	float lf = smoothstep(0.78, 0.9, lbz_noise(p * 2.4 + 7.0)) * autumn;
	g = mix(g, leaf_fall * (0.8 + 0.4 * n3), lf * 0.8);
	// sentiero e muschio dai colori dei vertici
	float path = clamp(vc.r, 0.0, 1.0) * smoothstep(0.2, 0.6, wn.y);
	float pm = smoothstep(0.35, 0.65, path + (n2 - 0.5) * 0.35);
	vec3 pc = path_col * (0.82 + 0.3 * n3) * (0.9 + 0.2 * n1);
	g = mix(g, pc, pm);
	g = mix(g, grass_b * 0.55, clamp(vc.g, 0.0, 1.0) * 0.6);
	// ---- la terra intrecciata: triplanare sui due assi di lato
	vec2 ux = vec2(wp.z, wp.y);
	vec2 uz = vec2(wp.x, wp.y);
	vec2 wx = mhz_weave(ux, weave_cell);
	vec2 wz = mhz_weave(uz, weave_cell);
	float bx = smoothstep(0.3, 0.7, abs(wn.x) / max(abs(wn.x) + abs(wn.z), 1e-3));
	vec2 w = mix(wz, wx, bx);
	float en = lbz_fbm(wp.xy * 0.3 + wp.zy * 0.3);
	vec3 e = mix(earth_b, earth_a, w.x * (0.75 + 0.35 * en));
	e = mix(e, earth_gap, w.y * 0.85);
	e *= 0.85 + 0.25 * lbz_noise(vec2(wp.x + wp.z, wp.y) * 3.0);
	// muschio verde nelle fessure in alto e sporco scuro in basso
	e = mix(e, grass_b * 0.7, smoothstep(0.6, 0.9, en) * 0.18 * (1.0 - w.x));
	vec3 col = mix(e, g, gk);
	ALBEDO = col;
	ROUGHNESS = mix(0.86, 0.9, gk);
	SPECULAR = 0.28;
	float hh = mix(w.x * 0.07, n3 * 0.025 + clump * 0.02, gk);
	NORMAL = lbz_bump(NORMAL, VERTEX, hh, relief);
	// un filo di traslucenza sull'erba (il sole basso dietro i fili)
	BACKLIGHT = g * 0.12 * gk;
}
␀␀␀␀␀␀␀␀shader_type spatial;
// Splash Hill Zone: lo sfondo dipinto dato dall'utente (assets/levels/splash_hill/sky_bg.png) steso
// su un cilindro attorno alla camera (scripts/env/gen_shz/scenery.gd). La riga dell'orizzonte
// dell'immagine sta al pelo del mare; in alto sfuma nel cielo del livello. Ripetuto a specchio
// attorno (u ping-pong) cosÃ¬ non ha cuciture. tint e grey: il tempo (weather.gd: pioggia, tramonto).

render_mode unshaded, cull_disabled, fog_disabled, shadows_disabled, depth_draw_never, blend_mix;

uniform sampler2D img : source_color, filter_linear_mipmap, repeat_disable;
uniform vec3 tint : source_color = vec3(1.0);
uniform float grey = 0.0;
uniform float gain = 1.0;
uniform float top_fade = 0.12;

void fragment() {
	float u = abs(fract(UV.x * 0.5) * 2.0 - 1.0);
	vec4 c = texture(img, vec2(u, clamp(UV.y, 0.0, 1.0)));
	vec3 col = c.rgb;
	float l = dot(col, vec3(0.3, 0.55, 0.15));
	col = mix(col, vec3(l), grey) * tint * gain;
	ALBEDO = col;
	ALPHA = smoothstep(0.0, top_fade, UV.y);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Splash Hill Zone: la terra dell'isola attorno alla strada (scripts/env/gen_shz/island.gd): prato
// verde acceso a macchie, sabbia vicino al mare; le pareti ripide a scacchi arancio e marroni come
// le scogliere di Sonic 4 (stessi colori della strada, terrain.gdshader).

render_mode diffuse_burley;

uniform sampler2D noise_a : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform float sea_y = -4.0;
uniform vec3 grass_a : source_color = vec3(0.13, 0.5, 0.07);
uniform vec3 grass_b : source_color = vec3(0.24, 0.66, 0.1);
uniform vec3 grass_dry : source_color = vec3(0.42, 0.62, 0.16);
uniform vec3 sand : source_color = vec3(0.93, 0.84, 0.6);
uniform vec3 sand_wet : source_color = vec3(0.7, 0.6, 0.42);
uniform vec3 rock_a : source_color = vec3(0.78, 0.41, 0.12);
uniform vec3 rock_b : source_color = vec3(0.44, 0.21, 0.06);
uniform float wet = 0.0;

varying vec3 wpos;
varying vec3 wnrm;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wnrm);
	float n1 = texture(noise_a, wpos.xz * 0.013).r;
	float n2 = texture(noise_a, wpos.xz * 0.061).r;
	float n3 = texture(noise_a, wpos.xz * 0.21).r;
	vec3 g = mix(grass_a, grass_b, smoothstep(0.3, 0.7, n1 * 0.7 + n3 * 0.3));
	g = mix(g, grass_dry, smoothstep(0.62, 0.8, n2) * 0.5);
	float h = wpos.y - sea_y;
	float sm = smoothstep(2.6, 1.6, h + (n2 - 0.5) * 1.2);
	vec3 sd = mix(sand, sand_wet, smoothstep(0.7, 0.1, h));
	vec3 col = mix(g, sd, sm);
	// scacchi sulla parete: u lungo la parete (orizzontale), v la quota
	vec2 t = normalize(vec2(-n.z, n.x) + vec2(1e-4, 0.0));
	vec2 cell = vec2(dot(wpos.xz, t), wpos.y) / 1.7;
	vec2 fc = fract(cell);
	float chk = mod(floor(cell.x) + floor(cell.y), 2.0);
	vec3 rk = mix(rock_a, rock_b, chk);
	float bev = smoothstep(0.0, 0.1, fc.y) * smoothstep(1.0, 0.9, fc.y) * smoothstep(0.0, 0.1, fc.x) * smoothstep(1.0, 0.9, fc.x);
	rk *= 0.78 + 0.22 * bev;
	// da lontano i quadretti sfumano nel loro colore medio (niente sfarfallio)
	float aa = clamp(length(fwidth(cell)) * 3.0 - 0.3, 0.0, 1.0);
	rk = mix(rk, (rock_a + rock_b) * 0.45, aa);
	float steep = smoothstep(0.66, 0.5, n.y);
	col = mix(col, rk, steep);
	ALBEDO = col * mix(1.0, 0.6, wet * (1.0 - sm));
	ROUGHNESS = mix(0.92, 0.35, wet);
}
shader_type spatial;
// Splash Hill Zone: il mare (scripts/env/gen_shz/scenery.gd). Trasparente come acqua vera: dove Ã¨
// poco profondo (la terra a scacchi che scende in acqua, il fondale di sabbia) si vede sotto,
// colorato di turchese; piÃ¹ l'acqua Ã¨ spessa piÃ¹ diventa blu. clarity: metri d'acqua prima che il
// fondo sparisca (Stage 1 cristallino, Stage 2 meno). Lontano sfuma nel colore dell'orizzonte.

render_mode blend_mix, depth_draw_always, cull_back, diffuse_burley, specular_schlick_ggx;

uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap;
uniform sampler2D depth_tex : hint_depth_texture, filter_nearest;
uniform sampler2D normal_tex : hint_normal, filter_linear_mipmap, repeat_enable;
uniform vec3 shallow_col : source_color = vec3(0.1, 0.78, 0.82);
uniform vec3 deep_col : source_color = vec3(0.02, 0.2, 0.58);
uniform vec3 horizon_col : source_color = vec3(0.55, 0.78, 0.95);
uniform float clarity = 12.0;
uniform float fade_start = 220.0;
uniform float fade_end = 1250.0;
uniform float glint = 0.55;

varying vec3 wpos;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 nuv = wpos.xz * 0.09;
	vec3 n1 = texture(normal_tex, nuv + vec2(TIME * 0.021, TIME * 0.013)).rgb;
	vec3 n2 = texture(normal_tex, nuv * 1.7 + vec2(-TIME * 0.017, TIME * 0.024)).rgb;
	vec3 nm = normalize(n1 + n2 - 1.0);
	NORMAL_MAP = mix(vec3(0.5, 0.5, 1.0), nm * 0.5 + 0.5, glint);
	// quanto Ã¨ spessa l'acqua davanti a quello che c'Ã¨ sotto (lungo la vista)
	vec2 suv = SCREEN_UV + (nm.xy - 0.5) * 0.012;
	float dz = texture(depth_tex, suv).r;
	vec4 vp = INV_PROJECTION_MATRIX * vec4(suv * 2.0 - 1.0, dz, 1.0);
	vp.xyz /= vp.w;
	float thick = max(length(vp.xyz) - length(VERTEX), 0.0);
	if (dz <= 0.0) {
		thick = 1e4;
	}
	float a = 1.0 - exp(-thick / max(clarity, 0.1));
	// quello che si vede sotto (giÃ  illuminato: va in EMISSION), poi il colore dell'acqua
	vec3 under = texture(screen_tex, suv).rgb * mix(vec3(1.0), shallow_col * 1.3, 0.6);
	float body = smoothstep(0.0, 0.9, a);
	vec3 col = mix(shallow_col * 0.85, deep_col, smoothstep(0.3, 1.0, a));
	float d = length(wpos - CAMERA_POSITION_WORLD);
	float far = smoothstep(fade_start, fade_end, d);
	col = mix(col, horizon_col, far);
	body = max(body, far);
	ALBEDO = col * body;
	EMISSION = under * (1.0 - body);
	ROUGHNESS = 0.08;
	SPECULAR = 0.6;
}
shader_type spatial;
// Splash Hill Zone: i faraglioni in mezzo al mare (scripts/env/gen_shz/scenery.gd), come nello
// sfondo di Sonic 4: roccia grigio-verde, muschio verde chiaro sulle facce che guardano in alto.

render_mode diffuse_burley;

uniform sampler2D noise_a : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform vec3 rock_a : source_color = vec3(0.50, 0.58, 0.52);
uniform vec3 rock_b : source_color = vec3(0.30, 0.38, 0.33);
uniform vec3 moss_a : source_color = vec3(0.30, 0.62, 0.22);
uniform vec3 moss_b : source_color = vec3(0.14, 0.40, 0.12);

varying vec3 wpos;
varying vec3 wnrm;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wnrm);
	vec3 w = abs(n) / (abs(n.x) + abs(n.y) + abs(n.z));
	float t = texture(noise_a, wpos.zy * 0.02).r * w.x + texture(noise_a, wpos.xz * 0.02).r * w.y
		+ texture(noise_a, wpos.xy * 0.02).r * w.z;
	float f = texture(noise_a, wpos.xz * 0.006 + wpos.y * 0.004).r;
	vec3 rock = mix(rock_b, rock_a, smoothstep(0.3, 0.7, t));
	float m = smoothstep(0.15, 0.6, n.y + (f - 0.5) * 0.9);
	vec3 moss = mix(moss_b, moss_a, smoothstep(0.35, 0.75, t));
	ALBEDO = mix(rock, moss, m);
	ROUGHNESS = 0.9;
	SPECULAR = 0.2;
}
␀␀␀␀␀␀␀␀shader_type spatial;
// Splash Hill Zone: la terra (scripts/env/gen_shz/terrain.gd). mode 0: cima d'erba a strisce
// (UV = metri lungo il percorso, di lato); mode 1: fianchi a scacchi gialli (UV = metri lungo, quota)
// con il bordo d'erba a zig-zag in cima (UV2.y = metri sotto la cima della corsa); mode 2: muro di
// fondo delle gallerie, scacchi marroni scuri.
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform int mode = 0;
// colori di Sonic 4 (le foto dell'utente): verde pieno, scacchi arancio e marrone scuro
uniform vec3 grass_a : source_color = vec3(0.09, 0.52, 0.07);
uniform vec3 grass_b : source_color = vec3(0.19, 0.70, 0.11);
uniform vec3 grass_edge : source_color = vec3(0.05, 0.33, 0.05);
uniform vec3 check_a : source_color = vec3(0.80, 0.42, 0.12);
uniform vec3 check_b : source_color = vec3(0.44, 0.21, 0.06);
uniform vec3 cave_a : source_color = vec3(0.40, 0.22, 0.08);
uniform vec3 cave_b : source_color = vec3(0.30, 0.16, 0.06);
uniform float sq_u = 1.0;
uniform float sq_v = 1.1;
uniform float half_w = 9.0;
uniform float wet = 0.0;       // pioggia (level_shz.gd): piÃ¹ scuro e lucido

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

void fragment() {
	vec2 uv = UV;
	vec3 col;
	float rough = 0.85;
	if (mode == 0) {
		// strisce oblique a due verdi, ciuffi piÃ¹ chiari, bordo scuro sui lati della striscia
		float st = step(0.5, fract((uv.x + uv.y * 0.6) / 2.6));
		col = mix(grass_a, grass_b, st * 0.75);
		float n = hash(floor(uv * 3.0));
		col *= 0.92 + 0.12 * n;
		float edge = smoothstep(half_w - 0.9, half_w - 0.1, abs(uv.y));
		col = mix(col, grass_edge, edge * 0.7);
		rough = 0.75;
	} else {
		vec2 cell = vec2(uv.x / sq_u, uv.y / sq_v);
		vec2 fc = fract(cell);
		float chk = mod(floor(cell.x) + floor(cell.y), 2.0);
		vec3 a = mode == 1 ? check_a : cave_a;
		vec3 b = mode == 1 ? check_b : cave_b;
		col = mix(a, b, chk);
		// quadretto incassato come in Sonic 4: cornice chiara in alto e a sinistra, scura in basso e
		// a destra, il centro un filo piÃ¹ scuro
		float l = step(fc.x, 0.09) + step(0.91, fc.y);
		float d = step(0.91, fc.x) + step(fc.y, 0.09);
		col *= 1.0 + 0.16 * clamp(l, 0.0, 1.0) - 0.22 * clamp(d, 0.0, 1.0) * (1.0 - clamp(l, 0.0, 1.0));
		col *= 0.94;
		if (mode == 1) {
			float depth = UV2.y;
			// piÃ¹ in basso piÃ¹ ombra (anche sotto il mare si vede scuro)
			col *= mix(1.0, 0.62, smoothstep(4.0, 30.0, depth));
			// bordo d'erba a zig-zag che scende dalla cima, con la riga scura sotto
			// (Sonic 4: fascia d'erba spessa, denti grandi scuri sotto una banda chiara)
			float zig = 0.5 + 0.7 * abs(fract(uv.x / 1.1) * 2.0 - 1.0);
			float g = step(depth, zig);
			float band = step(depth, 0.32);
			float line = step(depth, zig + 0.12) - g;
			col = mix(col, mix(grass_a, grass_edge, 0.55), g);
			col = mix(col, grass_b, band);
			col = mix(col, vec3(0.22, 0.12, 0.04), line);
			rough = mix(rough, 0.75, g);
		}
	}
	col *= mix(1.0, 0.72, wet);
	ALBEDO = col;
	ROUGHNESS = mix(rough, 0.35, wet);
	SPECULAR = 0.3 + 0.3 * wet;
}
␀␀␀␀␀shader_type spatial;
// Blocchi di metallo verde rivettato di Star Light Zone (Sonic 1, rif_slz_fangame_livello.png):
// pannelli verdi a due toni con le giunture scure, lo spigolo in luce in alto a sinistra e quello in
// ombra in basso a destra, la fascia rivettata alla base di ogni piano, piastre interne rialzate,
// doghe, gruppi di "finestre" a traliccio verde scuro che lasciano vedere il bagliore blu della
// cittÃ  dietro e, su qualche piano, una fila di finestre con le luci accese a gruppi.
// UV in metri sulla faccia (kit.gd: sui muri UV.y = quota del mondo, cosÃ¬ i piani si allineano tra
// gli edifici); UV2.x = numero della faccia (varia i pannelli tra le facce).
// Da lontano i dettagli piccoli (rivetti, sbarre, giunture) sfumano nel loro colore medio
// (fwidth): niente sfarfallio.

render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec3 base : source_color = vec3(0.13, 0.50, 0.08);
uniform vec3 base2 : source_color = vec3(0.19, 0.60, 0.13);
uniform vec3 light_edge : source_color = vec3(0.52, 0.78, 0.12);
uniform vec3 dark_edge : source_color = vec3(0.02, 0.11, 0.02);
uniform vec3 seam : source_color = vec3(0.006, 0.03, 0.006);
uniform vec3 lattice_bg : source_color = vec3(0.004, 0.008, 0.03);
uniform vec3 lattice_bar : source_color = vec3(0.03, 0.15, 0.025);
uniform vec3 city_blue : source_color = vec3(0.05, 0.25, 1.0);
uniform vec3 glass : source_color = vec3(0.01, 0.02, 0.06);
uniform vec3 window_lit : source_color = vec3(1.0, 0.80, 0.40);
uniform vec2 panel = vec2(2.0, 2.0);
// altezza di un piano: in basso la fascia rivettata (0 = niente piani, pannelli su griglia semplice)
uniform float floor_h = 4.0;
// quote dei tipi di pannello (sulle facce in su niente finestre nÃ© traliccio)
uniform float lattice_amount = 0.14;
uniform float window_amount = 0.22;
uniform float plate_amount = 0.40;
uniform float slat_amount = 0.14;
uniform float rough = 0.5;

varying vec3 wnormal;

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float hash13(vec3 p) {
	return hash12(p.xy + vec2(p.z * 17.17, p.z * 3.91));
}

void vertex() {
	wnormal = (MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz;
}

// bordo smussato del rettangolo [0,s]: luce dall'alto a sinistra (u piccolo, v grande = in alto)
vec3 bevel(vec2 p, vec2 s, float w, float k, vec3 col) {
	float l = smoothstep(w, 0.0, p.x) + smoothstep(s.y - w, s.y, p.y);
	float d = smoothstep(s.x - w, s.x, p.x) + smoothstep(w, 0.0, p.y);
	col = mix(col, light_edge, clamp(l, 0.0, 1.0) * 0.75 * k);
	col = mix(col, dark_edge, clamp(d, 0.0, 1.0) * 0.75 * k);
	return col;
}

float rivet(vec2 p, vec2 c, float r) {
	return smoothstep(r, r * 0.5, length(p - c));
}

// linea scura larga w (m) a distanza sd dal bordo, che da lontano resta della stessa "quantitÃ "
float seam_line(float sd, float w, float px) {
	float ww = max(w, px);
	return (1.0 - smoothstep(ww * 0.5, ww * 0.5 + px, sd)) * clamp(w / px, 0.3, 1.0);
}

void fragment() {
	vec2 uv = UV;
	// arrotondato: l'interpolazione non dÃ  un numero esatto e l'hash lo amplifica (finestre a puntini)
	float face = floor(UV2.x + 0.5);
	vec2 fw = fwidth(uv);
	float px = max(max(fw.x, fw.y), 0.0005);          // metri per pixel
	float k_fine = 1.0 - smoothstep(0.012, 0.04, px);  // rivetti
	float k_mid = 1.0 - smoothstep(0.03, 0.10, px);    // smussi, piastre interne, sbarre
	bool up = abs(wnormal.y) > 0.7;

	// piani: in basso la fascia rivettata, sopra una fila di pannelli alta quanto il resto del piano
	float strip_h = 0.5;
	bool floors = floor_h > 0.5 && !up;
	float fl = floors ? floor(uv.y / floor_h) : 0.0;
	float fy = floors ? uv.y - fl * floor_h : 0.0;
	vec2 cell_sz = floors ? vec2(panel.x, floor_h - strip_h) : panel;
	vec2 cell;
	vec2 f;
	if (floors) {
		cell = vec2(floor(uv.x / panel.x), fl);
		f = vec2(uv.x - cell.x * panel.x, fy - strip_h);
	} else {
		cell = floor(uv / panel);
		f = uv - cell * panel;
	}
	float h = hash13(vec3(cell, face));
	float h2 = hash13(vec3(cell * 1.7 + 11.3, face + 5.0));
	// due toni: file di pannelli piÃ¹ chiari (per piano e per faccia) e qualche pannello sparso
	float row_tone = step(0.62, hash13(vec3(fl, face, 3.0)));
	float tone = clamp(row_tone * 0.8 + step(0.8, h2), 0.0, 1.0);
	vec3 col = mix(base, base2, tone) * (0.94 + 0.10 * h2);
	vec3 emit = vec3(0.0);
	float r_rough = rough;
	float metal = 0.2;

	if (floors && fy < strip_h) {
		// fascia rivettata: verde piÃ¹ scuro, fila di rivetti chiari, filo di luce in alto
		vec2 sf = vec2(uv.x, fy);
		col = mix(base, dark_edge, 0.35);
		col = mix(col, light_edge, smoothstep(strip_h - 0.07, strip_h, fy) * 0.55 * k_mid);
		col = mix(col, dark_edge, smoothstep(0.07, 0.0, fy) * 0.6 * k_mid);
		float ru = (fract(sf.x / 0.5) - 0.5) * 0.5;
		float rv = rivet(vec2(ru, fy), vec2(0.0, strip_h * 0.5), 0.065) * k_fine;
		col = mix(col, light_edge * 1.1, rv);
	} else {
		// gruppi di finestre a traliccio: tre pannelli in fila (6 m) sullo stesso piano
		float gx = floor(uv.x / (panel.x * 3.0));
		bool lattice = !up && hash13(vec3(gx, fl, face + 31.0)) < lattice_amount;
		// fila di finestre su questo piano (una per pannello), accese a gruppi di 4 pannelli
		bool wrow = floors && !lattice && hash13(vec3(fl, face, 77.0)) < window_amount;
		if (lattice) {
			vec2 q = f / cell_sz;
			float glow = smoothstep(1.0, 0.0, q.y) * 0.8 + 0.2;
			vec3 bg = mix(lattice_bg, city_blue * 0.2, glow * (0.35 + 0.65 * hash13(vec3(gx, fl, face))));
			// la cittÃ  lontana dietro il traliccio: profili di palazzi blu scuro contro il bagliore,
			// con poche finestrine accese (da lontano resta solo il colore medio)
			float k_win = 1.0 - smoothstep(0.01, 0.03, px);
			float xi = floor(q.x * 7.0 + gx * 7.0);
			float hb = 0.25 + 0.5 * hash12(vec2(xi, fl + face * 3.0));
			float in_b = 1.0 - smoothstep(hb - 0.01, hb + 0.01, q.y);
			vec2 wq = vec2(q.x * 21.0, q.y * 14.0);
			vec2 wf = fract(wq);
			float lit = step(0.78, hash12(floor(wq) + vec2(gx * 31.0, fl * 7.0 + face)));
			lit *= step(0.3, wf.x) * step(wf.x, 0.7) * step(0.3, wf.y) * step(wf.y, 0.7) * step(q.y, hb - 0.04);
			vec3 sil = lattice_bg * 1.5 + city_blue * 0.04;
			bg = mix(bg, sil, in_b * k_win * 0.85);
			bg += city_blue * 0.5 * lit * in_b * k_win;
			// croce di sbarre, telaio e traversa a metÃ 
			float d1 = abs(q.x - q.y);
			float d2 = abs(q.x + q.y - 1.0);
			float bw = 0.05;
			float bar = 1.0 - smoothstep(bw, bw + 0.03, min(d1, d2));
			float frame = 1.0 - step(0.06, q.x) * step(q.x, 0.94) * step(0.05, q.y) * step(q.y, 0.95);
			float mid_bar = 1.0 - smoothstep(0.02, 0.035, abs(q.y - 0.5));
			float b = max(max(bar, frame), mid_bar);
			b = mix(0.5, b, k_mid);
			col = mix(bg * 0.25, lattice_bar, b);
			emit = bg * (1.0 - b) * 1.1;
			r_rough = 0.8;
		} else {
			// piastra: smusso, e il tipo di pannello
			if (h < plate_amount) {
				col = bevel(f, cell_sz, 0.08, k_mid, col);
				vec2 m = vec2(0.3);
				vec2 pf = f - m;
				vec2 ps = cell_sz - 2.0 * m;
				if (pf.x > 0.0 && pf.y > 0.0 && pf.x < ps.x && pf.y < ps.y) {
					col *= 1.0 + 0.07 * k_mid;
					col = bevel(pf, ps, 0.06, k_mid, col);
				}
				float rv = 0.0;
				rv += rivet(f, vec2(0.15, 0.15), 0.06);
				rv += rivet(f, vec2(cell_sz.x - 0.15, 0.15), 0.06);
				rv += rivet(f, vec2(0.15, cell_sz.y - 0.15), 0.06);
				rv += rivet(f, cell_sz - 0.15, 0.06);
				col = mix(col, light_edge * 1.1, clamp(rv, 0.0, 1.0) * k_fine);
			} else if (h < plate_amount + slat_amount && !up) {
				// doghe verticali
				col = bevel(f, cell_sz, 0.08, k_mid, col);
				float sx = fract(f.x / (cell_sz.x / 5.0));
				col = mix(col, dark_edge, smoothstep(0.1, 0.0, sx) * 0.7 * k_mid);
				col = mix(col, light_edge, smoothstep(0.9, 1.0, sx) * 0.45 * k_mid);
				col = mix(col, mix(col, dark_edge, 0.12), 1.0 - k_mid);
			} else {
				// liscio, con le file di rivetti in alto e in basso
				col = bevel(f, cell_sz, 0.08, k_mid, col);
				float n = 5.0;
				float su = cell_sz.x / n;
				float ru = abs(fract(f.x / su) - 0.5) * su;
				float rv = rivet(vec2(ru, f.y), vec2(0.0, 0.17), 0.055) + rivet(vec2(ru, f.y), vec2(0.0, cell_sz.y - 0.17), 0.055);
				col = mix(col, light_edge * 1.05, clamp(rv, 0.0, 1.0) * k_fine);
			}
			if (wrow) {
				// finestra al centro del pannello: vetro scuro col riflesso, accesa a gruppi
				vec2 wc = cell_sz * 0.5;
				vec2 wh = vec2(min(0.55, cell_sz.x * 0.3), min(0.9, cell_sz.y * 0.3));
				vec2 dw = abs(f - wc) - wh;
				float inside = 1.0 - smoothstep(-px, px, max(dw.x, dw.y));
				float frame = (1.0 - smoothstep(-px, px, max(dw.x, dw.y) - 0.08)) * (1.0 - inside);
				float grp = floor(cell.x / 4.0);
				float on = step(hash13(vec3(grp, fl, face + 9.0)), 0.5) * step(0.18, hash13(vec3(cell.x, fl, face + 2.0)));
				float tint = hash13(vec3(grp, fl, face + 4.0));
				vec3 lit_col = mix(window_lit, vec3(0.55, 0.80, 1.0), step(0.75, tint));
				vec2 wl = f - (wc - wh);                       // dall'angolo in basso a sinistra
				float grad = clamp(wl.y / (2.0 * wh.y), 0.0, 1.0);
				// vetro spento: blu scuro col riflesso in diagonale
				float streak = smoothstep(0.25, 0.0, abs(fract((wl.x * 1.3 + wl.y * 0.6) * 0.45) - 0.5) - 0.12);
				vec3 g = glass + city_blue * (0.05 * grad + 0.06 * streak * k_mid);
				// acceso: luce calda dal soffitto, tende a strisce appena accennate
				float blinds = 1.0 - 0.18 * step(0.5, fract(wl.y / 0.14)) * k_fine * step(0.5, hash13(vec3(grp, fl, face + 6.0)));
				float glow_w = (0.55 + 0.4 * grad) * blinds;
				// montante in mezzo e traversa in alto
				float mull = max(1.0 - smoothstep(0.03, 0.03 + px, abs(wl.x - wh.x)), 1.0 - smoothstep(0.025, 0.025 + px, abs(wl.y - 1.45 * wh.y)));
				mull *= k_mid;
				vec3 wcol = mix(g, lit_col * 0.08, on);
				col = mix(col, dark_edge * 0.7, frame);
				col = mix(col, wcol * mix(0.35, 1.0, 1.0 - on), inside);
				col = mix(col, dark_edge * 0.6, mull * inside);
				emit += lit_col * on * inside * glow_w * (1.0 - mull);
				r_rough = mix(r_rough, 0.42, inside);
				metal = mix(metal, 0.0, inside);
			}
		}
		// giuntura tra i pannelli
		float sd = min(min(f.x, cell_sz.x - f.x), min(f.y, cell_sz.y - f.y));
		col = mix(col, seam, seam_line(sd, 0.035, px));
	}
	if (floors) {
		// giunture sopra e sotto la fascia rivettata
		float sd2 = min(abs(fy), abs(fy - strip_h));
		col = mix(col, seam, seam_line(sd2, 0.03, px));
	}
	ALBEDO = col;
	ROUGHNESS = r_rough;
	METALLIC = metal;
	SPECULAR = 0.45;
	EMISSION = emit;
}
␀␀␀␀␀␀␀␀shader_type spatial;
// Il cratere scavato da Metal Knuckles a Star Light Zone (scripts/bosses/slz_crater.gd): terra e
// roccia bruciate sotto la cittÃ , striature radiali dall'impatto, crepe incandescenti (piÃ¹ vive sul
// labbro del bordo e al centro), fuliggine nera al centro. "heat" (0..1) spegne piano il calore
// durante lo scontro; "flash" fa avvampare tutto un istante (impatti, esplosione finale).
// Coordinate: VERTEX locale del cratere (centro = origine, y = quota sul pavimento della zona).

render_mode diffuse_burley, specular_schlick_ggx;

uniform sampler2D noise_soft : filter_linear_mipmap, repeat_enable;
uniform sampler2D noise_grain : filter_linear_mipmap, repeat_enable;
uniform float heat = 1.0;
uniform float flash = 0.0;
uniform float rim_r = 27.5;        // dove il pavimento diventa parete
uniform float lava_energy = 4.0;

varying vec3 lpos;
varying vec3 lnor;

void vertex() {
	lpos = VERTEX;
	lnor = NORMAL;
}

void fragment() {
	vec2 p = lpos.xz;
	float r = length(p);
	float ang = atan(p.y, p.x);
	float n1 = texture(noise_soft, p * 0.035).r;
	float n2 = texture(noise_soft, p * 0.13 + vec2(0.31, 0.77)).r;
	float gr = texture(noise_grain, p * 0.8 + lpos.y * 0.3).r;
	float gr2 = texture(noise_grain, p * 3.1 + vec2(0.5)).r;
	// striature radiali (l'onda d'urto ha spazzato la terra verso fuori)
	float streak = texture(noise_soft, vec2(ang * 3.2, r * 0.018)).r;
	float flat_k = smoothstep(0.75, 0.95, lnor.y);
	float wall = 1.0 - flat_k;

	// terra bruna, roccia piÃ¹ chiara sulle pareti, fuliggine verso il centro
	vec3 earth = mix(vec3(0.075, 0.06, 0.05), vec3(0.2, 0.16, 0.12), smoothstep(0.3, 0.75, n1 * 0.6 + streak * 0.6));
	vec3 rock = mix(vec3(0.16, 0.14, 0.13), vec3(0.34, 0.3, 0.27), smoothstep(0.35, 0.8, n2));
	vec3 col = mix(earth, rock, clamp(wall * 0.85 + smoothstep(0.55, 0.8, n2) * 0.3 * flat_k, 0.0, 1.0));
	col *= 0.7 + 0.45 * gr * (0.6 + 0.4 * gr2);
	float soot = 1.0 - smoothstep(4.0, 17.0, r + (n1 - 0.5) * 8.0);
	col = mix(col, vec3(0.02, 0.018, 0.017), soot * 0.85);
	// sul crinale la terra rivoltata Ã¨ piÃ¹ chiara (polvere)
	float crest = smoothstep(2.6, 4.6, lpos.y) * wall;
	col = mix(col, vec3(0.3, 0.26, 0.22) * (0.8 + 0.3 * gr), crest * 0.35);

	// crepe: linee sottili del rumore (valle del rumore a metÃ ), radiali sul pavimento
	float cn = texture(noise_soft, vec2(p.x * 0.09 + streak * 0.6, p.y * 0.09) + vec2(0.13, 0.4)).r;
	float cn2 = texture(noise_soft, p * 0.21 + vec2(0.9, 0.2)).r;
	float crack = smoothstep(0.035, 0.0, abs(cn - 0.5)) + 0.6 * smoothstep(0.02, 0.0, abs(cn2 - 0.5));
	crack = clamp(crack, 0.0, 1.0);
	// dove scotta: il labbro del bordo (bordi incandescenti), l'anello alla base della parete, il centro
	float lip = smoothstep(2.4, 4.4, lpos.y) * smoothstep(0.2, 0.6, wall + 0.2);
	float base_ring = exp(-pow((r - rim_r) / 1.6, 2.0));
	float core = 1.0 - smoothstep(2.0, 11.0, r);
	float hot_zone = clamp(lip * 0.9 + base_ring * 0.55 + core * 0.9 + 0.12, 0.0, 1.0);
	float molten = crack * hot_zone;
	// il labbro brilla anche fuori dalle crepe (roccia fusa a chiazze)
	molten = max(molten, lip * smoothstep(0.55, 0.8, n2 + gr * 0.25) * 0.85);
	molten = max(molten, core * smoothstep(0.6, 0.85, n1 + gr * 0.2) * 0.7);
	float pulse = 0.8 + 0.2 * sin(TIME * 1.9 + n1 * 11.0 - r * 0.3);
	float k = clamp(molten * (0.25 + 0.75 * heat) + flash * 0.4 * hot_zone, 0.0, 1.0);
	vec3 lava = mix(vec3(0.85, 0.12, 0.02), vec3(1.0, 0.55, 0.12), smoothstep(0.4, 1.0, k));
	float e = k * pulse * lava_energy * (0.35 + 0.65 * heat) + flash * 2.0 * k;

	ALBEDO = mix(col, vec3(0.06, 0.015, 0.0), k * 0.85);
	ROUGHNESS = 0.92 - 0.25 * k;
	SPECULAR = 0.3;
	EMISSION = lava * e;
	vec3 bump = vec3(gr2 - 0.5, 0.0, gr - 0.5) * 0.5 * (1.0 - k);
	NORMAL = normalize(NORMAL + (VIEW_MATRIX * vec4(bump, 0.0)).xyz);
}
␀␀␀␀␀␀␀␀shader_type spatial;
// Piano delle strade sopraelevate e dei ponti: lastre d'acciaio grigio-verde con le giunture, una
// riga tratteggiata bianca al centro (solo dove UV.y passa per lo 0: strade) e un po' di usura.
// UV.x = metri lungo la strada, UV.y = metri dall'asse (strade) o metri sulla faccia (tetti).

render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley;

uniform vec3 plate : source_color = vec3(0.30, 0.33, 0.37);
uniform vec3 plate2 : source_color = vec3(0.25, 0.28, 0.32);
uniform vec3 joint : source_color = vec3(0.12, 0.14, 0.16);
uniform vec3 stripe : source_color = vec3(0.95, 0.95, 0.88);
uniform float plate_len = 3.0;
uniform float plate_wid = 2.5;
uniform float center_line = 1.0;   // 1 = riga tratteggiata sull'asse
uniform sampler2D grain : filter_linear_mipmap, repeat_enable;

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

void fragment() {
	vec2 uv = UV;
	vec2 c = floor(vec2(uv.x / plate_len, uv.y / plate_wid));
	vec2 f = vec2(fract(uv.x / plate_len) * plate_len, fract(uv.y / plate_wid) * plate_wid);
	float h = hash12(c);
	vec3 col = mix(plate, plate2, h);
	float g = texture(grain, uv * 0.07).r;
	col *= 0.86 + 0.24 * g;
	// giunture e un filo di luce sul bordo delle lastre
	float sd = min(min(f.x, plate_len - f.x), min(f.y, plate_wid - f.y));
	col = mix(joint, col, smoothstep(0.02, 0.06, sd));
	col = mix(col, col * 1.18, smoothstep(0.1, 0.06, f.y) * step(0.06, f.y));
	// bulloni agli angoli delle lastre
	vec2 corner = min(f, vec2(plate_len, plate_wid) - f);
	col = mix(col, col * 1.4, smoothstep(0.07, 0.04, length(corner - 0.16)));
	// riga tratteggiata bianca sull'asse
	float dash = step(0.5, fract(uv.x / 4.0));
	col = mix(col, stripe, center_line * dash * smoothstep(0.14, 0.10, abs(uv.y)));
	ALBEDO = col;
	ROUGHNESS = 0.6;
	METALLIC = 0.25;
}
␀␀␀␀␀␀␀␀shader_type spatial;
// Pozza di luce finta sotto i lampioni (al posto di tante OmniLight): un disco additivo sul
// pavimento, piÃ¹ chiaro al centro. Colore e forza per istanza (kit.gd).

render_mode blend_add, depth_draw_never, cull_disabled, unshaded, shadows_disabled, fog_disabled;

uniform vec4 tint : source_color = vec4(1.0, 0.95, 0.75, 1.0);
uniform float strength = 0.35;

void fragment() {
	vec2 c = UV * 2.0 - 1.0;
	float r = length(c);
	float k = pow(clamp(1.0 - r, 0.0, 1.0), 2.2);
	ALBEDO = tint.rgb * k * strength * tint.a;
}
␀␀shader_type spatial;
// Alone delle lampade (billboard additivo): bagliore morbido attorno ai globi dei lampioni.

render_mode blend_add, depth_draw_never, cull_disabled, unshaded, shadows_disabled;

uniform vec4 tint : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform float strength = 0.9;

void vertex() {
	// sempre girato verso la camera
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], MODEL_MATRIX[3]);
	MODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));
}

void fragment() {
	vec2 c = UV * 2.0 - 1.0;
	float r = length(c);
	float k = exp(-r * r * 6.0) * 0.8 + exp(-r * r * 40.0) * 0.6;
	ALBEDO = tint.rgb * k * strength * tint.a;
}
␀␀␀␀␀␀shader_type spatial;
// Traliccio verde scuro di Star Light Zone (i muri a croce che lasciano vedere la cittÃ  dietro):
// telaio a celle quadrate con le diagonali a X, il resto Ã¨ vuoto (alpha scissor).
// UV in metri sulla faccia (kit.gd).

render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley;

uniform vec3 bar : source_color = vec3(0.16, 0.42, 0.13);
uniform vec3 bar_light : source_color = vec3(0.40, 0.70, 0.30);
uniform float cell = 2.0;
uniform float width = 0.16;   // spessore delle sbarre (m)

void fragment() {
	vec2 q = UV / cell;
	vec2 f = fract(q);
	vec2 m = f * cell;
	float frame = 1.0 - step(width * 0.5, m.x) * step(m.x, cell - width * 0.5) * step(width * 0.5, m.y) * step(m.y, cell - width * 0.5);
	float d1 = abs(f.x - f.y) * cell * 0.7071;
	float d2 = abs(f.x + f.y - 1.0) * cell * 0.7071;
	float diag = step(min(d1, d2), width * 0.42);
	float a = max(frame, diag);
	if (a < 0.5) {
		discard;
	}
	// riflesso chiaro sul lato in alto delle sbarre
	float hl = frame * smoothstep(cell - width * 0.5, cell, m.y);
	ALBEDO = mix(bar, bar_light, hl * 0.7 + diag * 0.12);
	ROUGHNESS = 0.6;
	METALLIC = 0.2;
}
␀␀␀␀␀␀␀␀␀shader_type spatial;
// Insegne al neon della cittÃ  di notte (facciate e cartelloni sui tetti, kit.gd neon_sign): tubi
// luminosi su un fondo scuro. UV = 0..1 sul pannello, UV2.x = rapporto larghezza/altezza,
// UV2.y = disegno: 0 anello d'oro, 1 stella azzurra, 2 fasce magenta, 3 "scritta" verticale a
// blocchi, 4 freccia gialla, 5 cornice a lampadine. Accese a impulsi leggeri.

render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley;

uniform vec3 backing : source_color = vec3(0.03, 0.03, 0.05);
uniform vec3 gold : source_color = vec3(1.0, 0.72, 0.12);
uniform vec3 cyan : source_color = vec3(0.25, 0.85, 1.0);
uniform vec3 magenta : source_color = vec3(1.0, 0.22, 0.75);
uniform vec3 lime : source_color = vec3(0.65, 1.0, 0.25);
uniform float energy = 2.6;

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float sd_star5(vec2 p, float r, float rf) {
	const vec2 k1 = vec2(0.809016994375, -0.587785252292);
	const vec2 k2 = vec2(-k1.x, k1.y);
	p.x = abs(p.x);
	p -= 2.0 * max(dot(k1, p), 0.0) * k1;
	p -= 2.0 * max(dot(k2, p), 0.0) * k2;
	p.x = abs(p.x);
	p.y -= r;
	vec2 ba = rf * vec2(-k1.y, k1.x) - vec2(0.0, 1.0);
	float h = clamp(dot(p, ba) / dot(ba, ba), 0.0, r);
	return length(p - ba * h) * sign(p.y * ba.x - p.x * ba.y);
}

// tubo: 1 al centro, sfuma ai lati (spessore w, alone g)
float tube(float d, float w, float px) {
	return 1.0 - smoothstep(w * 0.5, w * 0.5 + px * 1.5, abs(d));
}

void fragment() {
	float aspect = max(UV2.x, 0.1);
	float kind = floor(UV2.y + 0.5);
	float aid = floor(UV2.x * 10.0 + 0.5);          // seme dell'insegna (arrotondato: niente puntini)
	vec2 q = (UV - 0.5) * vec2(aspect, 1.0);     // centro, unitÃ  = altezza
	vec2 fw = fwidth(q);
	float px = max(max(fw.x, fw.y), 0.0005);
	float t = 0.0;
	vec3 c = gold;
	float flick = 0.88 + 0.12 * sin(TIME * 3.1 + aid * 0.7);
	if (kind < 0.5) {
		// anello d'oro (gli anelli di Sonic) con il riflesso
		float r = length(q);
		t = max(tube(r - 0.34, 0.08, px), tube(r - 0.22, 0.04, px) * 0.6);
		c = gold;
	} else if (kind < 1.5) {
		float st = sd_star5(vec2(q.x, q.y), 0.38, 0.42);
		t = max(tube(st, 0.06, px), tube(length(q) - 0.45, 0.03, px) * 0.7);
		c = cyan;
	} else if (kind < 2.5) {
		// fasce orizzontali che si accendono in sequenza
		float row = floor(UV.y * 5.0);
		float on = step(0.3, fract(TIME * 0.35 - row * 0.2));
		float fy = fract(UV.y * 5.0) - 0.5;
		t = tube(fy, 0.22, px * 5.0) * step(abs(q.x), aspect * 0.5 - 0.08) * mix(0.35, 1.0, on);
		c = magenta;
	} else if (kind < 3.5) {
		// colonna di "lettere" a blocchi (scritta verticale)
		float n = 6.0;
		float li = floor(UV.y * n);
		vec2 g = vec2(fract(UV.x * 3.0), fract(UV.y * n));
		vec2 gi = vec2(floor(UV.x * 3.0), li);
		float on = step(0.45, hash12(gi + aid));
		float edge = step(0.12, g.x) * step(g.x, 0.88) * step(0.12, g.y) * step(g.y, 0.88);
		t = on * edge * step(0.2, UV.x) * step(UV.x, 0.8) + 0.0;
		t = max(t, tube(abs(q.x) - (aspect * 0.5 - 0.04), 0.03, px));
		c = hash12(vec2(aid, 1.0)) > 0.5 ? lime : cyan;
	} else if (kind < 4.5) {
		// freccia gialla che indica la strada
		vec2 a = q;
		float body = max(abs(a.y) - 0.08, abs(a.x + 0.1) - aspect * 0.28);
		float head = max(abs(a.y) - (0.32 - (a.x - aspect * 0.18) * 1.0), -(a.x - aspect * 0.18));
		head = max(head, a.x - aspect * 0.18 - 0.32);
		float sd = min(body, head);
		t = tube(sd, 0.05, px) + (1.0 - smoothstep(-px, px, sd)) * 0.35;
		c = gold;
	} else {
		// cornice di lampadine attorno a un pannello con tre anelli d'oro dentro
		vec2 e = abs(q) - vec2(aspect * 0.5 - 0.08, 0.42);
		float on_frame = 1.0 - smoothstep(0.0, px * 2.0, abs(max(e.x, e.y)));
		float per = (q.x + q.y) * 10.0;
		float bulbs = smoothstep(0.35, 0.2, abs(fract(per) - 0.5));
		float chase = step(0.5, fract(per * 0.33 - TIME * 1.5));
		t = on_frame * bulbs * mix(0.3, 1.0, chase);
		float cell = aspect / 3.0;
		vec2 rq = vec2(mod(q.x + aspect * 0.5, cell) - cell * 0.5, q.y);
		float rr = length(rq);
		float ri = floor((q.x + aspect * 0.5) / cell);
		float blink = step(0.4, fract(TIME * 0.5 - ri * 0.33));
		t = max(t, tube(rr - 0.24, 0.07, px) * mix(0.4, 1.0, blink) * step(max(e.x, e.y), -0.05));
		c = gold;
	}
	t = clamp(t, 0.0, 1.0);
	ALBEDO = mix(backing, c * 0.15, t);
	ROUGHNESS = 0.6;
	EMISSION = c * t * energy * flick;
}
␀␀␀␀␀shader_type spatial;
// Pavimento della piazza della partenza di Star Light Zone (e dei suoi bastioni agli angoli):
// lungo il bordo una fascia d'acciaio scuro con le luci rosse incassate e la riga gialla, poi un
// anello di lastre chiare, in mezzo lastre a scacchi in due grigi con le righe verdi ogni 5 m e,
// al centro, il cerchio con la stella di Star Light e le lucine attorno. Tutto piatto (la
// cinematica d'arrivo usa il centro, 30 x 30 m). Coordinate del mondo attorno a "center".

render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec2 center = vec2(0.0, 0.0);
uniform float half_size = 16.0;
uniform vec3 plate_a : source_color = vec3(0.56, 0.60, 0.66);
uniform vec3 plate_b : source_color = vec3(0.46, 0.50, 0.57);
uniform vec3 ring_plate : source_color = vec3(0.64, 0.67, 0.72);
uniform vec3 border : source_color = vec3(0.20, 0.23, 0.27);
uniform vec3 joint : source_color = vec3(0.12, 0.14, 0.17);
uniform vec3 green_line : source_color = vec3(0.30, 0.68, 0.22);
uniform vec3 paint : source_color = vec3(0.98, 0.82, 0.16);
uniform vec3 emblem : source_color = vec3(0.16, 0.20, 0.30);
uniform vec3 red_on : source_color = vec3(1.0, 0.04, 0.03);
uniform vec3 star_on : source_color = vec3(1.0, 0.85, 0.35);
uniform sampler2D grain : filter_linear_mipmap, repeat_enable;

varying vec3 wpos;

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

float line(float d, float w, float px) {
	float ww = max(w, px);
	return (1.0 - smoothstep(ww * 0.5, ww * 0.5 + px, abs(d))) * clamp(w / px, 0.3, 1.0);
}

float sd_star5(vec2 p, float r, float rf) {
	const vec2 k1 = vec2(0.809016994375, -0.587785252292);
	const vec2 k2 = vec2(-k1.x, k1.y);
	p.x = abs(p.x);
	p -= 2.0 * max(dot(k1, p), 0.0) * k1;
	p -= 2.0 * max(dot(k2, p), 0.0) * k2;
	p.x = abs(p.x);
	p.y -= r;
	vec2 ba = rf * vec2(-k1.y, k1.x) - vec2(0.0, 1.0);
	float h = clamp(dot(p, ba) / dot(ba, ba), 0.0, r);
	return length(p - ba * h) * sign(p.y * ba.x - p.x * ba.y);
}

void fragment() {
	vec2 p = wpos.xz - center;
	vec2 fw = fwidth(p);
	float px = max(max(fw.x, fw.y), 0.0005);
	float k_fine = 1.0 - smoothstep(0.012, 0.04, px);
	float k_mid = 1.0 - smoothstep(0.03, 0.10, px);
	float g = texture(grain, wpos.xz * 0.09).r;
	vec2 ap = abs(p);
	float m = max(ap.x, ap.y);                 // distanza "quadrata" dal centro
	vec3 col;
	vec3 emit = vec3(0.0);
	float rough = 0.62;            // (piÃ¹ ruvido e meno metallico: i lampioni non fanno macchie bianche)
	float metal = 0.12;
	float edge = half_size - m;
	if (m > half_size - 0.2) {
		// fuori dal quadrato (bastioni): lastre di 2 m e il bordo scuro
		vec2 c = floor(p / 2.0);
		vec2 f = p - c * 2.0;
		col = mix(plate_a, plate_b, hash12(c) * 0.6);
		col = mix(col, joint, line(min(min(f.x, 2.0 - f.x), min(f.y, 2.0 - f.y)), 0.04, px));
	} else if (edge < 1.3) {
		// fascia scura del bordo con le luci rosse incassate ogni 2 m (lungo il lato)
		float along = ap.x > ap.y ? p.y : p.x;
		col = border;
		float cu = (fract(along / 2.0) - 0.5) * 2.0;
		vec2 e = vec2(cu / 0.32, (edge - 0.65) / 0.16);
		float r = length(e);
		float inside = 1.0 - smoothstep(0.85, 1.0, r);
		float pulse = 0.8 + 0.2 * sin(TIME * 2.0 - along * 0.2);
		col = mix(col, joint, (1.0 - smoothstep(1.0, 1.3, r)) * (1.0 - inside));
		col = mix(col, red_on * 0.5, inside);
		emit += red_on * inside * 2.2 * pulse;
		col = mix(col, paint, line(edge - 1.3, 0.14, px));
		rough = 0.45;
	} else if (m > 12.0) {
		// anello di lastre chiare di 1.5 m
		float along = ap.x > ap.y ? p.y : p.x;
		float c = floor(along / 1.5);
		float fq = along - c * 1.5;
		col = ring_plate * (0.95 + 0.08 * hash12(vec2(c, floor(m))));
		col = mix(col, joint, line(min(fq, 1.5 - fq), 0.035, px));
		col = mix(col, joint, line(m - 12.0, 0.05, px));
		col = mix(col, green_line, line(m - 12.35, 0.18, px));
	} else {
		// lastre a scacchi di 2.5 m, righe verdi ogni 5 m
		vec2 c = floor(p / 2.5);
		vec2 f = p - c * 2.5;
		float chk = mod(c.x + c.y, 2.0);
		col = mix(plate_a, plate_b, chk) * (0.96 + 0.06 * hash12(c));
		col = mix(col, joint, line(min(min(f.x, 2.5 - f.x), min(f.y, 2.5 - f.y)), 0.035, px));
		vec2 cr = min(f, 2.5 - f);
		col = mix(col, col * 1.35, smoothstep(0.06, 0.03, length(cr - 0.2)) * k_fine);
		vec2 gl = abs(fract(p / 5.0 + 0.5) - 0.5) * 5.0;
		float gline = max(line(gl.x, 0.12, px), line(gl.y, 0.12, px)) * step(7.6, length(p));
		col = mix(col, green_line, gline);
		// emblema: cerchio scuro con la stella gialla, anello di lucine
		float rr = length(p);
		float disc = 1.0 - smoothstep(7.0 - px, 7.0 + px, rr);
		col = mix(col, emblem, disc);
		col = mix(col, paint, line(rr - 6.7, 0.18, px));
		col = mix(col, paint, line(rr - 7.3, 0.08, px));
		float st = sd_star5(vec2(p.x, -p.y), 4.6, 0.42);
		float star = 1.0 - smoothstep(-px, px, st);
		col = mix(col, paint, star);
		col = mix(col, paint * 0.7, line(st + 0.35, 0.08, px) * star);
		// lucine attorno al cerchio
		float a = atan(p.y, p.x);
		float na = 24.0;
		float ai = floor(a / TAU * na + 0.5);
		vec2 lp = vec2(cos(ai * TAU / na), sin(ai * TAU / na)) * 7.8;
		float dot_l = 1.0 - smoothstep(0.12, 0.18, length(p - lp));
		float tw = 0.6 + 0.4 * sin(TIME * 3.0 + ai * 1.7);
		col = mix(col, star_on, dot_l);
		emit += star_on * dot_l * (0.7 + 0.6 * tw);
		rough = mix(rough, 0.4, disc);
	}
	col *= 0.9 + 0.2 * g;
	ALBEDO = col;
	ROUGHNESS = rough;
	METALLIC = metal;
	SPECULAR = 0.45;
	EMISSION = emit;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Carreggiate del piano strada (decalcomanie appena sopra i lastroni, kit.gd street_road):
// asfalto blu notte con le strisce. UV.x = metri lungo, UV.y = metri dall'asse, UV2.x = mezza
// larghezza, UV2.y = tipo: 0 strada (righe bianche ai bordi, doppia gialla al centro, corsie
// tratteggiate se Ã¨ larga), 1 viale con lo spartitraffico (piloni) in mezzo, 2 incrocio (solo
// asfalto), 3 strisce pedonali, 4 zona a strisce gialle e nere (ascensori, carico).

render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec3 asphalt : source_color = vec3(0.10, 0.11, 0.15);
uniform vec3 asphalt2 : source_color = vec3(0.13, 0.14, 0.19);
uniform vec3 white_l : source_color = vec3(0.90, 0.92, 0.94);
uniform vec3 yellow_l : source_color = vec3(0.98, 0.78, 0.10);
uniform vec3 curb : source_color = vec3(0.52, 0.55, 0.60);
uniform vec3 hatch_dark : source_color = vec3(0.05, 0.05, 0.06);
uniform sampler2D grain : filter_linear_mipmap, repeat_enable;
uniform sampler2D soft : filter_linear_mipmap, repeat_enable;

varying vec3 wpos;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

float line(float d, float w, float px) {
	float ww = max(w, px);
	return (1.0 - smoothstep(ww * 0.5, ww * 0.5 + px, abs(d))) * clamp(w / px, 0.3, 1.0);
}

void fragment() {
	float u = UV.x;
	float v = UV.y;
	float hw = max(UV2.x, 0.5);
	float kind = floor(UV2.y + 0.5);
	vec2 fw = fwidth(UV);
	float px = max(max(fw.x, fw.y), 0.0005);
	float g = texture(grain, wpos.xz * 0.13).r;
	float s = texture(soft, wpos.xz * 0.021).r;
	vec3 col = mix(asphalt, asphalt2, smoothstep(0.3, 0.7, s)) * (0.8 + 0.35 * g);
	float paint_a = 0.0;
	vec3 paint = white_l;
	float av = abs(v);
	if (kind < 1.5) {
		// cordolo e righe bianche dei bordi
		float curb_m = smoothstep(hw - 0.2, hw - 0.2 + px, av);
		col = mix(col, curb * (0.8 + 0.3 * g), curb_m);
		paint_a = max(paint_a, line(av - (hw - 0.55), 0.15, px));
		if (kind < 0.5) {
			// doppia gialla al centro
			float yl = max(line(v - 0.16, 0.12, px), line(v + 0.16, 0.12, px));
			col = mix(col, yellow_l, yl * (0.8 + 0.2 * g));
		}
		if (hw >= 6.0) {
			// corsie tratteggiate
			float dash = step(0.55, fract(u / 6.0));
			paint_a = max(paint_a, line(av - hw * 0.5, 0.13, px) * dash);
		}
		// tombini al centro della corsia
		vec2 mh = vec2(mod(u + 7.0, 31.0) - 15.5, av - hw * 0.5);
		float rm = length(mh);
		col = mix(col, vec3(0.16, 0.17, 0.19), (1.0 - smoothstep(0.55, 0.55 + px, rm)) * step(5.0, hw));
		col = mix(col, vec3(0.06), line(rm - 0.5, 0.06, px) * step(5.0, hw));
	} else if (kind < 2.5) {
		// incrocio: solo asfalto e un filo di cordolo
	} else if (kind < 3.5) {
		// strisce pedonali (bande di 0.6 m ogni 1.2 m lungo v), un margine di 0.5 m
		float band = step(0.5, fract(v / 1.2 + 0.25));
		float inside = step(av, hw - 0.4);
		paint_a = max(paint_a, band * inside * step(0.4, u) * step(u, 3.6));
	} else {
		// zona a strisce gialle e nere col bordo giallo
		float st = step(0.5, fract((u + v) / 1.0));
		col = mix(col, mix(yellow_l, hatch_dark, st) * (0.85 + 0.2 * g), 0.85);
	}
	col = mix(col, paint * (0.85 + 0.2 * g), paint_a * 0.92);
	ALBEDO = col;
	ROUGHNESS = mix(0.85, 0.45, smoothstep(0.55, 0.8, s)) - paint_a * 0.1;
	METALLIC = 0.0;
	SPECULAR = 0.4;
}
␀␀␀␀␀␀␀␀shader_type spatial;
// Fascia laterale delle strade di Star Light Zone (rif_slz_cartello_titolo.png): striscia verde
// con le luci rosse ovali in fila, bordata sopra e sotto da un filo piÃ¹ scuro.
// UV.x = metri lungo la strada, UV.y = 0 (sotto) .. 1 (sopra) sull'altezza della fascia.

render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley;

uniform vec3 band : source_color = vec3(0.13, 0.42, 0.07);
uniform vec3 band_dark : source_color = vec3(0.02, 0.10, 0.02);
uniform vec3 light_off : source_color = vec3(0.30, 0.0, 0.0);
uniform vec3 light_on : source_color = vec3(1.0, 0.012, 0.008);
uniform float spacing = 2.2;      // metri tra una luce e l'altra
uniform float oval_w = 0.62;      // larghezza dell'ovale (m)
uniform float oval_h = 0.30;      // altezza dell'ovale (frazione della fascia)
uniform float glow = 1.5;

void fragment() {
	float u = UV.x;
	float v = UV.y;
	vec3 col = band;
	// filo scuro sopra e sotto, riflesso chiaro appena sotto il bordo superiore
	col = mix(col, band_dark, smoothstep(0.12, 0.04, v) + smoothstep(0.88, 0.96, v));
	col = mix(col, band * 1.35, smoothstep(0.80, 0.86, v) * smoothstep(0.92, 0.86, v));
	// luce ovale
	float cu = (fract(u / spacing) - 0.5) * spacing;
	vec2 e = vec2(cu / (oval_w * 0.5), (v - 0.5) / (oval_h * 0.5));
	float r = length(e);
	float inside = smoothstep(1.0, 0.85, r);
	float rim = smoothstep(1.25, 1.0, r) * (1.0 - inside);
	float pulse = 0.85 + 0.15 * sin(TIME * 2.2 - u * 0.15);
	vec3 lc = mix(light_off, light_on, pulse);
	// riflesso bianco sull'ovale (in alto a sinistra)
	float spec = smoothstep(0.3, 0.0, length(e - vec2(-0.35, 0.35)));
	col = mix(col, band_dark * 0.6, rim);
	col = mix(col, lc * 0.4, inside);
	ALBEDO = col;
	ROUGHNESS = 0.5;
	METALLIC = 0.15;
	EMISSION = (lc * glow * inside + vec3(1.0, 0.45, 0.4) * spec * spec * inside * 0.5) * pulse;
}
␀␀␀␀␀shader_type spatial;
// Tetti dei blocchi di Star Light Zone: lungo il bordo (dentro la fascia con le luci rosse) un
// camminamento di lastre d'acciaio grigio con la riga gialla, in mezzo pannelli verdi rivettati
// piÃ¹ scuri dei muri e, dipinti, i dettagli dei tetti: lucernari accesi, griglie di ventilazione,
// botole a strisce, il cerchio d'atterraggio con la stella sui tetti grandi. Tutto piatto (ci si
// cammina sopra: gli oggetti veri dei tetti sono in kit.gd).
// UV = metri dal centro del tetto (x, z), UV2 = mezze misure del tetto (kit.gd roof_top).

render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec3 field : source_color = vec3(0.30, 0.56, 0.25);
uniform vec3 field2 : source_color = vec3(0.34, 0.62, 0.28);
uniform vec3 light_edge : source_color = vec3(0.62, 0.82, 0.38);
uniform vec3 dark_edge : source_color = vec3(0.10, 0.27, 0.10);
uniform vec3 seam : source_color = vec3(0.05, 0.13, 0.05);
uniform vec3 walk : source_color = vec3(0.50, 0.53, 0.57);
uniform vec3 walk2 : source_color = vec3(0.44, 0.47, 0.51);
uniform vec3 paint : source_color = vec3(0.98, 0.80, 0.12);
uniform vec3 glass : source_color = vec3(0.06, 0.10, 0.20);
uniform vec3 lit : source_color = vec3(1.0, 0.90, 0.62);
uniform vec3 lit_cool : source_color = vec3(0.62, 0.86, 1.0);
uniform float walk_w = 1.4;

varying vec3 wpos;

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

float line(float d, float w, float px) {
	float ww = max(w, px);
	return (1.0 - smoothstep(ww * 0.5, ww * 0.5 + px, abs(d))) * clamp(w / px, 0.3, 1.0);
}

// stella a cinque punte (distanza con segno, Inigo Quilez)
float sd_star5(vec2 p, float r, float rf) {
	const vec2 k1 = vec2(0.809016994375, -0.587785252292);
	const vec2 k2 = vec2(-k1.x, k1.y);
	p.x = abs(p.x);
	p -= 2.0 * max(dot(k1, p), 0.0) * k1;
	p -= 2.0 * max(dot(k2, p), 0.0) * k2;
	p.x = abs(p.x);
	p.y -= r;
	vec2 ba = rf * vec2(-k1.y, k1.x) - vec2(0.0, 1.0);
	float h = clamp(dot(p, ba) / dot(ba, ba), 0.0, r);
	return length(p - ba * h) * sign(p.y * ba.x - p.x * ba.y);
}

void fragment() {
	vec2 p = UV;
	vec2 hs = max(UV2, vec2(0.5));
	vec2 fw = fwidth(p);
	float px = max(max(fw.x, fw.y), 0.0005);
	float k_fine = 1.0 - smoothstep(0.012, 0.04, px);
	float k_mid = 1.0 - smoothstep(0.03, 0.10, px);
	// il tetto ha un seme suo (centro nel mondo)
	// (arrotondati al quarto di metro: l'interpolazione non dÃ  numeri esatti e l'hash li amplifica)
	vec2 ctr = floor((wpos.xz - p) * 4.0 + 0.5);
	float seed = hash12(ctr * 0.0925 + floor(hs * 4.0 + 0.5) * 0.25);
	float de = min(hs.x - abs(p.x), hs.y - abs(p.y));    // distanza dal bordo
	vec3 col;
	vec3 emit = vec3(0.0);
	float rough = 0.55;
	float metal = 0.2;
	if (de < walk_w) {
		// camminamento: lastre d'acciaio di 1.5 m lungo il bordo
		vec2 q = abs(p.x) / hs.x > abs(p.y) / hs.y ? vec2(p.y, de) : vec2(p.x, de);
		float c = floor(q.x / 1.5);
		float fq = q.x - c * 1.5;
		col = mix(walk, walk2, hash12(vec2(c, seed * 91.0)));
		col = mix(col, seam, line(min(fq, 1.5 - fq), 0.03, px));
		col = mix(col, col * 1.25, smoothstep(0.12, 0.0, abs(de - 0.12)) * k_mid * 0.6);
		float bolt = smoothstep(0.06, 0.03, length(vec2(min(fq, 1.5 - fq) - 0.18, de - walk_w * 0.5))) * k_fine;
		col = mix(col, col * 1.45, bolt);
		col = mix(col, paint, line(de - (walk_w - 0.1), 0.12, px));
		rough = 0.6;
		metal = 0.3;
	} else {
		// pannelli verdi di 3 m allineati al centro del tetto
		vec2 pp = p + hs;                 // da un angolo
		vec2 cs = vec2(3.0);
		vec2 cell = floor((p + 1.5) / cs);
		vec2 f = p + 1.5 - cell * cs;
		float h = hash12(cell + seed * 13.0);
		col = mix(field, field2, step(0.6, h)) * (0.94 + 0.1 * hash12(cell * 1.3 + 7.0));
		float l = smoothstep(0.08, 0.0, f.x) + smoothstep(cs.y - 0.08, cs.y, f.y);
		float d = smoothstep(cs.x - 0.08, cs.x, f.x) + smoothstep(0.08, 0.0, f.y);
		col = mix(col, light_edge, clamp(l, 0.0, 1.0) * 0.5 * k_mid);
		col = mix(col, dark_edge, clamp(d, 0.0, 1.0) * 0.5 * k_mid);
		vec2 cr = min(f, cs - f);
		col = mix(col, light_edge, smoothstep(0.06, 0.03, length(cr - 0.18)) * k_fine);
		col = mix(col, seam, line(min(cr.x, cr.y), 0.035, px));
		// dettagli dipinti, scelti col seme del tetto
		float inner = de - walk_w;
		float big = min(hs.x, hs.y);
		if (big > 8.0 && seed < 0.22) {
			// cerchio d'atterraggio giallo con la stella
			float r = min(big - walk_w - 2.0, 6.5);
			vec2 cc = p;
			float dr = length(cc) - r;
			col = mix(col, paint, line(dr, 0.35, px));
			col = mix(col, paint, line(dr + 0.6, 0.12, px));
			float st = sd_star5(cc * vec2(1.0, -1.0), r * 0.62, 0.45);
			col = mix(col, mix(col, paint, 0.85), 1.0 - smoothstep(-px, px, st));
		} else if (seed < 0.8) {
			// fila di lucernari lungo il lato lungo, accesi a gruppi
			bool along_x = hs.x >= hs.y;
			vec2 q = along_x ? p : p.yx;
			vec2 qh = along_x ? hs : hs.yx;
			float n = floor((qh.x - walk_w - 1.0) / 2.5);
			float u = q.x / 2.5;
			float ci = floor(u + 0.5);
			float fu = (u - ci) * 2.5;
			float off = (seed > 0.62 ? 1.0 : -1.0) * min(qh.y * 0.45, 4.0);
			vec2 dw = abs(vec2(fu, q.y - off)) - vec2(0.8, 0.55);
			float inside = (1.0 - smoothstep(-px, px, max(dw.x, dw.y))) * step(abs(ci), n);
			float frame = (1.0 - smoothstep(-px, px, max(dw.x, dw.y) - 0.1)) * step(abs(ci), n) * (1.0 - inside);
			float on = step(hash12(vec2(floor(ci / 3.0), seed * 50.0)), 0.6);
			vec3 lc = mix(lit, lit_cool, step(0.5, hash12(vec2(seed, 3.0))));
			col = mix(col, vec3(0.12, 0.14, 0.16), frame);
			col = mix(col, mix(glass, lc * 0.1, on), inside);
			emit += lc * on * inside * 1.4;
			rough = mix(rough, 0.4, inside);
		} else {
			// griglie di ventilazione e una botola a strisce
			vec2 g = p - vec2(hs.x * 0.35 * sign(seed - 0.9), 0.0);
			vec2 dg = abs(g) - vec2(1.4, 1.0);
			float in_g = 1.0 - smoothstep(-px, px, max(dg.x, dg.y));
			float slat = step(0.5, fract(g.y / 0.25));
			col = mix(col, mix(vec3(0.10, 0.12, 0.13), vec3(0.30, 0.33, 0.35), slat * k_mid + (1.0 - k_mid) * 0.5), in_g);
			vec2 hh = p + vec2(hs.x * 0.35 * sign(seed - 0.9), 0.0);
			vec2 dh = abs(hh) - vec2(1.1);
			float in_h = 1.0 - smoothstep(-px, px, max(dh.x, dh.y));
			float stripes = step(0.5, fract((hh.x + hh.y) / 0.6));
			col = mix(col, mix(paint, vec3(0.05), stripes * k_mid + (1.0 - k_mid) * 0.5), in_h * (1.0 - step(max(dh.x, dh.y), -0.25)));
			col = mix(col, vec3(0.30, 0.33, 0.36), in_h * step(max(dh.x, dh.y), -0.25));
		}
	}
	ALBEDO = col;
	ROUGHNESS = rough;
	METALLIC = metal;
	SPECULAR = 0.45;
	EMISSION = emit;
}
␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Fascio di un riflettore dalla cittÃ : cono additivo che si spegne verso la punta e ai bordi, e
// ondeggia piano da una parte all'altra (rotazione nel vertex shader attorno alla base).

render_mode blend_add, depth_draw_never, cull_disabled, unshaded, shadows_disabled, fog_disabled;

uniform vec3 beam : source_color = vec3(0.55, 0.70, 1.0);
uniform float strength = 0.10;
uniform float sweep = 0.35;      // ampiezza dell'oscillazione (radianti)
uniform float speed = 0.12;
uniform float phase = 0.0;

varying float vy;

void vertex() {
	// la mesh Ã¨ un cono lungo +Y con la base (punta stretta) in y = 0
	vy = VERTEX.y;
	float a = sin(TIME * speed + phase) * sweep;
	float b = cos(TIME * speed * 0.7 + phase * 1.7) * sweep * 0.5;
	mat3 rz = mat3(vec3(cos(a), sin(a), 0.0), vec3(-sin(a), cos(a), 0.0), vec3(0.0, 0.0, 1.0));
	mat3 rx = mat3(vec3(1.0, 0.0, 0.0), vec3(0.0, cos(b), sin(b)), vec3(0.0, -sin(b), cos(b)));
	VERTEX = rx * rz * VERTEX;
	NORMAL = rx * rz * NORMAL;
}

void fragment() {
	// bordi del cono piÃ¹ tenui (fresnel col verso di vista), punta lontana sfumata
	float edge = pow(abs(dot(normalize(NORMAL), normalize(VIEW))), 1.5);
	float along = clamp(vy / 600.0, 0.0, 1.0);
	float k = edge * (1.0 - along) * (1.0 - along) * smoothstep(0.0, 0.03, along);
	ALBEDO = beam * k * strength;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type sky;
// Cielo notturno di Star Light Zone: blu notte profondo in alto che va al viola e al magenta verso
// l'orizzonte, tantissime stelle di tanti colori che brillano (blu, bianche, rosa, gialle, azzurre),
// le stelle grandi a croce come nel rifacimento di riferimento (rif_slz_fangame_livello.png), una
// fascia di Via Lattea con nebulose rosa e azzurre, qualche stella cadente e la luna.
// Sotto l'orizzonte il bagliore blu della cittÃ  lontana.
// Nella passata della cubemap (luce ambientale e riflessi) niente stelle: solo il gradiente.

// Valori predefiniti dei colori: giÃ  lineari (Godot non converte i predefiniti degli uniform).
uniform vec3 zenith : source_color = vec3(0.0012, 0.0018, 0.009);
uniform vec3 mid : source_color = vec3(0.004, 0.0055, 0.028);
uniform vec3 horizon : source_color = vec3(0.024, 0.011, 0.055);
uniform vec3 horizon_glow : source_color = vec3(0.11, 0.026, 0.12);
uniform vec3 city_glow : source_color = vec3(0.014, 0.034, 0.10);
uniform vec3 below : source_color = vec3(0.003, 0.005, 0.022);
uniform sampler2D nebula_noise : filter_linear_mipmap, repeat_enable;
uniform float star_density = 150.0;
uniform float star_gain = 1.0;
uniform float reflect_gain = 1.0;          // chiarore della cittÃ  nei riflessi (solo cubemap)
// stelle grandi a croce: quota delle cellette che ne hanno una
uniform float sparkle_prob = 0.12;
// asse della Via Lattea (normale del suo grande cerchio)
uniform vec3 galaxy_axis = vec3(0.35, 0.42, 0.84);
uniform float galaxy_gain = 1.0;
// luna (direzione verso la luna)
uniform vec3 moon_dir = vec3(-0.42, 0.58, -0.70);
uniform float moon_size = 0.99965;
// stelle cadenti: quante "corsie" e ogni quanti secondi ne passa una per corsia
uniform float meteor_period = 7.0;

float hash13(vec3 p) {
	p = fract(p * 0.1031);
	p += dot(p, p.zyx + 31.32);
	return fract((p.x + p.y) * p.z);
}

vec3 hash33(vec3 p) {
	p = vec3(dot(p, vec3(127.1, 311.7, 74.7)), dot(p, vec3(269.5, 183.3, 246.1)), dot(p, vec3(113.5, 271.9, 124.6)));
	return fract(sin(p) * 43758.5453123);
}

// colore di una stella dal suo numero casuale: blu, bianche, rosa, gialle, azzurre
vec3 star_color(float h) {
	if (h < 0.26) return vec3(0.55, 0.70, 1.00);   // blu
	if (h < 0.48) return vec3(1.00, 1.00, 1.00);   // bianca
	if (h < 0.62) return vec3(1.00, 0.55, 0.85);   // rosa
	if (h < 0.78) return vec3(1.00, 0.88, 0.45);   // gialla
	return vec3(0.45, 1.00, 1.00);                 // azzurra
}

// uno strato di stelle puntiformi su una griglia 3D di cellette (una stella per celletta)
vec3 star_layer(vec3 d, float dens, float size, float prob, float tm, float seed) {
	vec3 q = d * dens;
	vec3 id = floor(q);
	vec3 f = fract(q);
	vec3 r = hash33(id + seed);
	if (r.z > prob) return vec3(0.0);
	vec3 c = 0.2 + 0.6 * hash33(id + seed + 17.0);
	float dist = length(f - c);
	float h = hash13(id + seed * 3.1);
	float tw = 0.65 + 0.35 * sin(tm * (1.5 + 4.0 * r.x) + r.y * 40.0);
	float k = smoothstep(size, 0.0, dist);
	return star_color(h) * k * k * tw * (0.6 + 0.9 * r.y);
}

// stelle grandi a croce (quattro punte), poche e luminose
vec3 sparkle_layer(vec3 d, float dens, float prob, float tm, float seed) {
	vec3 col = vec3(0.0);
	vec3 q = d * dens;
	vec3 base = floor(q - 0.5);
	for (int i = 0; i < 2; i++) {
		for (int j = 0; j < 2; j++) {
			for (int k = 0; k < 2; k++) {
				vec3 id = base + vec3(float(i), float(j), float(k));
				vec3 r = hash33(id + seed);
				if (r.z > prob) continue;
				vec3 sd = normalize(id + 0.25 + 0.5 * hash33(id + seed + 5.0));
				if (dot(d, sd) < 0.0) continue;
				vec3 t1 = normalize(cross(sd, abs(sd.y) < 0.95 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
				vec3 t2 = cross(sd, t1);
				vec3 o = d - sd * dot(d, sd);
				vec2 uv = vec2(dot(o, t1), dot(o, t2)) * dens * 1.7;
				float tw = 0.7 + 0.3 * sin(tm * (1.0 + 2.5 * r.x) + r.y * 30.0);
				float core = exp(-dot(uv, uv) * 90.0);
				float spikes = exp(-abs(uv.x) * 60.0) * exp(-abs(uv.y) * 7.0) + exp(-abs(uv.y) * 60.0) * exp(-abs(uv.x) * 7.0);
				float halo = exp(-dot(uv, uv) * 12.0) * 0.25;
				float b = (core * 2.4 + spikes * 0.9 + halo) * tw * (0.6 + 0.8 * r.y);
				vec3 sc = r.x < 0.62 ? vec3(0.45, 0.65, 1.0) : star_color(r.x);
				col += sc * b;
			}
		}
	}
	return col;
}

// stella cadente nella corsia "lane": brilla per un attimo lungo un arco di cielo
vec3 meteor(vec3 d, float tm, float lane) {
	float per = meteor_period * (1.0 + lane * 0.37);
	float cyc = floor((tm + lane * 3.7) / per);
	float u = fract((tm + lane * 3.7) / per);
	float life = 0.11;
	if (u > life) return vec3(0.0);
	float t = u / life;
	vec3 r = hash33(vec3(cyc, lane, 7.0));
	float az = r.x * 6.2831;
	float el = 0.35 + 0.5 * r.y;
	vec3 s = normalize(vec3(cos(az) * cos(el), sin(el), sin(az) * cos(el)));
	vec3 dirv = normalize(cross(s, vec3(0.0, 1.0, 0.0)) * (r.z < 0.5 ? 1.0 : -1.0) + vec3(0.0, -0.45, 0.0));
	float len = 0.28;
	vec3 head = normalize(s + dirv * len * t);
	vec3 tail = normalize(s + dirv * len * max(t - 0.35, 0.0));
	// distanza angolare dal segmento coda-testa (piano tangente)
	vec3 ab = head - tail;
	float h = clamp(dot(d - tail, ab) / max(dot(ab, ab), 1e-6), 0.0, 1.0);
	float dist = length(d - (tail + ab * h));
	float fade = sin(t * 3.14159);
	float k = exp(-dist * dist * 2.0e5) * h * h;
	return vec3(0.85, 0.92, 1.0) * k * fade * 4.0;
}

void sky() {
	vec3 d = normalize(EYEDIR);
	float y = d.y;
	vec3 col;
	if (y >= 0.0) {
		float t1 = pow(clamp(y, 0.0, 1.0), 0.42);
		col = mix(horizon, mid, smoothstep(0.0, 0.32, t1));
		col = mix(col, zenith, smoothstep(0.25, 0.95, t1));
		// fascia magenta bassa sull'orizzonte e bagliore azzurrino della cittÃ  sotto
		col += horizon_glow * exp(-y * 14.0) * 0.55;
		col += city_glow * exp(-y * 38.0) * 0.6;
	} else {
		col = mix(horizon * 0.7 + city_glow * 0.6, below, smoothstep(0.0, -0.18, y));
	}
	// luna: disco crema con le macchie, alone freddo
	vec3 md = normalize(moon_dir);
	float mdot = dot(d, md);
	col += vec3(0.30, 0.38, 0.62) * (pow(max(mdot, 0.0), 40.0) * 0.30 + pow(max(mdot, 0.0), 600.0) * 0.6);
	if (AT_CUBEMAP_PASS) {
		// solo nei riflessi (anelli d'oro, tubi, vetri; la luce ambiente Ã¨ un colore a parte): la
		// cittÃ  accesa tutt'attorno, chiarore caldo sull'orizzonte e piÃ¹ freddo in alto. Senza, il
		// metallo rifletterebbe il cielo quasi nero e l'oro sembrerebbe bronzo
		float hz = exp(-abs(y) * 4.0);
		col += mix(vec3(0.10, 0.12, 0.22), vec3(0.45, 0.32, 0.18), hz) * (0.25 + 0.75 * hz) * reflect_gain;
	}
	if (!AT_CUBEMAP_PASS) {
		if (mdot > moon_size) {
			vec3 t1 = normalize(cross(md, vec3(0.0, 1.0, 0.0)));
			vec3 t2 = cross(md, t1);
			vec2 muv = vec2(dot(d, t1), dot(d, t2)) / sqrt(1.0 - moon_size * moon_size);
			float spots = texture(nebula_noise, muv * 0.35 + 0.5).r;
			float limb = sqrt(max(1.0 - dot(muv, muv), 0.0));
			vec3 mc = vec3(1.0, 0.97, 0.86) * (0.75 + 0.25 * limb) * mix(0.72, 1.05, smoothstep(0.35, 0.65, spots));
			col = mix(col, mc * 3.2, smoothstep(moon_size, moon_size + 0.00004, mdot));
		}
		float tm = TIME;
		float above = smoothstep(-0.02, 0.10, y);
		// Via Lattea: banda lungo un grande cerchio, nuvolosa, con nebulose rosa e azzurre
		vec3 ga = normalize(galaxy_axis);
		float gd = dot(d, ga);
		float band = exp(-gd * gd * 26.0);
		// coordinate lungo la banda: l'angolo parte dal punto piÃ¹ alto del grande cerchio, cosÃ¬ la
		// cucitura dell'angolo (Â±pi) cade nel punto piÃ¹ basso, sotto l'orizzonte
		vec3 g_top = normalize(vec3(0.0, 1.0, 0.0) - ga * ga.y);
		vec3 g_side = cross(ga, g_top);
		float along = atan(dot(d, g_side), dot(d, g_top));
		vec2 guv = vec2(along * 0.8, gd * 2.5);
		float n1 = texture(nebula_noise, guv * 0.9 + vec2(0.13, 0.31)).r;
		float n2 = texture(nebula_noise, guv * 2.7 + vec2(0.71, 0.17)).r;
		float n3 = texture(nebula_noise, guv * 6.1 + vec2(0.37, 0.53)).r;
		float cloud = smoothstep(0.30, 0.85, n1 * 0.6 + n2 * 0.3 + n3 * 0.1);
		float dust = smoothstep(0.55, 0.75, n2) * band;
		vec3 neb_pink = vec3(0.85, 0.22, 0.62);
		vec3 neb_blue = vec3(0.18, 0.45, 1.0);
		vec3 neb = mix(neb_blue, neb_pink, smoothstep(0.35, 0.7, n3 + gd * 0.6));
		col += (neb * cloud * band * 0.07 + vec3(0.42, 0.45, 0.65) * band * band * cloud * 0.05) * galaxy_gain * above;
		col *= 1.0 - dust * 0.35;
		// nubi di nebulosa sparse fuori dalla banda (tinte tenui)
		float wisp = smoothstep(0.62, 0.9, texture(nebula_noise, d.xz / (abs(y) + 0.6) * 0.45 + vec2(0.5, 0.2)).r);
		col += mix(neb_pink, neb_blue, n1) * wisp * 0.025 * above;
		// stelle: tre strati di puntini (piÃ¹ fitti lungo la Via Lattea) e le stelle a croce
		vec3 stars = vec3(0.0);
		stars += star_layer(d, star_density, 0.11, 0.55, tm, 1.0) * 0.9;
		stars += star_layer(d, star_density * 0.55, 0.12, 0.45, tm, 11.0) * 1.3;
		stars += star_layer(d, star_density * 2.1, 0.12, 0.35 + 0.5 * band, tm, 23.0) * (0.5 + band * 0.6);
		stars += sparkle_layer(d, 22.0, sparkle_prob, tm, 41.0);
		col += stars * star_gain * above * (1.0 - smoothstep(0.85, 1.0, mdot) * 0.9);
		// stelle cadenti
		vec3 met = vec3(0.0);
		for (int i = 0; i < 3; i++) {
			met += meteor(d, tm, float(i));
		}
		col += met * above;
	}
	COLOR = col;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// CittÃ  lontana attorno a Star Light Zone (rif_slz_sfondo_citta.png): grattacieli blu con le
// finestre accese (blu, azzurre, qualcuna gialla), palazzi di mattoni con le finestre blu.
// UV in metri sulla faccia; UV2.x = numero del palazzo, UV2.y = 0 grattacielo blu / 1 mattoni.
// Senza luci (emissione e un po' di colore proprio): Ã¨ lontana, sempre nel suo bagliore.

render_mode blend_mix, depth_draw_opaque, cull_back, unshaded, fog_disabled;

// Valori predefiniti dei colori: giÃ  lineari (Godot non converte i predefiniti degli uniform).
uniform vec3 tower_col : source_color = vec3(0.006, 0.009, 0.035);
uniform vec3 tower_col2 : source_color = vec3(0.014, 0.022, 0.07);
uniform vec3 brick : source_color = vec3(0.075, 0.026, 0.016);
uniform vec3 brick_dark : source_color = vec3(0.03, 0.01, 0.008);
uniform vec3 win_blue : source_color = vec3(0.22, 0.38, 0.95);
uniform vec3 win_cyan : source_color = vec3(0.45, 0.85, 1.0);
uniform vec3 win_yellow : source_color = vec3(1.0, 0.85, 0.45);
uniform vec3 haze : source_color = vec3(0.008, 0.016, 0.06);
uniform float haze_top = 90.0;     // sopra questa quota (m) la foschia sparisce

varying vec3 wpos;

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	float id = floor(UV2.x + 0.5);
	bool bricks = UV2.y > 0.5;
	vec2 uv = UV;
	vec3 col;
	vec2 wsz = bricks ? vec2(5.0, 6.0) : vec2(3.0, 3.6);
	vec2 wc = floor(uv / wsz);
	vec2 wf = fract(uv / wsz);
	float h = hash12(wc + id * 17.0);
	float win = step(0.3, wf.x) * step(wf.x, 0.7) * step(0.3, wf.y) * step(wf.y, 0.75);
	if (bricks) {
		vec2 bq = uv / vec2(0.9, 0.35);
		bq.x += step(1.0, mod(floor(bq.y), 2.0)) * 0.5;
		vec2 bf = fract(bq);
		float mortar = 1.0 - step(0.06, bf.x) * step(0.1, bf.y);
		col = mix(brick, brick_dark, mortar * 0.8 + hash12(floor(bq)) * 0.25);
		// finestre blu a doghe (come nel riferimento): sempre accese, di un blu vivo
		float stripes = step(0.5, fract((wf.x + wf.y) * 4.0));
		vec3 wcol = mix(win_blue * 0.7, win_blue * 1.3, stripes);
		col = mix(col, wcol * 0.8, win);
	} else {
		col = mix(tower_col, tower_col2, hash12(vec2(id, 3.1)) * 0.6 + uv.y * 0.002);
		float lit = step(0.62, h);
		vec3 wcol = h > 0.93 ? win_yellow : (h > 0.7 ? win_cyan : win_blue);
		float flick = 1.0;
		col = mix(col, wcol * (0.7 + 0.5 * hash12(wc * 3.3)) * flick, win * lit);
		col = mix(col, tower_col * 0.6, win * (1.0 - lit) * 0.6);
	}
	// foschia blu in basso: la cittÃ  sparisce nel suo bagliore
	float hz = clamp(1.0 - (wpos.y + 60.0) / (haze_top + 60.0), 0.0, 1.0);
	col = mix(col, haze, hz * hz * 0.85);
	ALBEDO = col;
}
␀␀␀␀shader_type spatial;
// Piano strada in basso (sotto le strade sopraelevate): lastroni di cemento blu notte con le
// giunture, qualche grata e qualche tombino, un velo lucido appena accennato (asfalto bagnato, solo
// nella ruvidezza: niente macchie colorate). Le carreggiate con le strisce sono a parte (road.gdshader).
// Attorno al cratere (piazzale est) i lastroni girano in anelli concentrici con le righe dipinte.
// Coordinate del mondo (x, z).

render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec3 slab_a : source_color = vec3(0.25, 0.28, 0.35);
uniform vec3 slab_b : source_color = vec3(0.21, 0.24, 0.30);
uniform vec3 joint : source_color = vec3(0.09, 0.10, 0.14);
uniform vec3 metal_col : source_color = vec3(0.16, 0.17, 0.19);
uniform vec3 paint : source_color = vec3(0.98, 0.80, 0.14);
uniform vec3 paint_w : source_color = vec3(0.88, 0.90, 0.92);
uniform vec3 annex_a : source_color = vec3(0.30, 0.33, 0.40);
uniform vec3 annex_b : source_color = vec3(0.24, 0.27, 0.33);
uniform sampler2D grain : filter_linear_mipmap, repeat_enable;
uniform sampler2D soft : filter_linear_mipmap, repeat_enable;
uniform float slab = 3.0;
uniform vec2 crater_c = vec2(160.0, 0.0);
uniform float crater_r = 36.0;
uniform float annex_x0 = 124.0;

varying vec3 wpos;

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

float line(float d, float w, float px) {
	float ww = max(w, px);
	return (1.0 - smoothstep(ww * 0.5, ww * 0.5 + px, abs(d))) * clamp(w / px, 0.3, 1.0);
}

void fragment() {
	vec2 p = wpos.xz;
	vec2 fw = fwidth(p);
	float px = max(max(fw.x, fw.y), 0.0005);
	float k_mid = 1.0 - smoothstep(0.03, 0.10, px);
	float g = texture(grain, p * 0.11).r;
	float s = texture(soft, p * 0.017).r;
	vec3 col;
	float rough = 0.85;
	vec2 dc = p - crater_c;
	float rr = length(dc);
	if (p.x > annex_x0 + 0.5 && rr < 62.0) {
		// piazzale del cratere: anelli di lastroni (3 m) e spicchi, righe dipinte
		float ring = floor(rr / 3.0);
		float fr = rr - ring * 3.0;
		float a = atan(dc.y, dc.x);
		float n = max(8.0, floor(TAU * (ring + 0.5) * 3.0 / 3.0));
		float sec = floor((a / TAU + 0.5) * n);
		float fa = fract((a / TAU + 0.5) * n) * TAU * (ring + 0.5) * 3.0 / n;
		col = mix(annex_a, annex_b, step(0.5, hash12(vec2(ring, sec))) * 0.7 + 0.15 * mod(ring, 2.0));
		float sd = min(min(fr, 3.0 - fr), min(fa, TAU * (ring + 0.5) * 3.0 / n - fa));
		col = mix(col, joint, line(sd, 0.05, px));
		// cerchio giallo e cerchio bianco tratteggiato attorno al disco, raggi bianchi verso il bordo
		col = mix(col, paint, line(rr - crater_r - 1.2, 0.5, px));
		float dash = step(0.5, fract(a / TAU * 72.0));
		col = mix(col, paint_w, line(rr - crater_r - 2.6, 0.2, px) * dash);
		col = mix(col, paint_w, line(rr - crater_r + 1.5, 0.2, px));
		float spoke = abs(fract(a / TAU * 8.0 + 0.5) - 0.5) * TAU / 8.0 * rr;
		col = mix(col, paint_w, line(spoke, 0.25, px) * step(crater_r + 4.0, rr) * step(rr, 58.0));
	} else {
		// lastroni sfalsati a file (giunti orizzontali continui, verticali sfalsati di mezzo lastrone)
		float row = floor(p.y / slab);
		float off = mod(row, 2.0) * slab * 0.5;
		float col_i = floor((p.x + off) / slab);
		vec2 f = vec2(p.x + off - col_i * slab, p.y - row * slab);
		float h = hash12(vec2(col_i, row));
		col = mix(slab_a, slab_b, h) * (0.85 + 0.25 * g);
		float sd = min(min(f.x, slab - f.x), min(f.y, slab - f.y));
		col = mix(col, joint, line(sd, 0.06, px));
		// qualche lastrone Ã¨ una grata di scolo d'acciaio
		if (h > 0.965) {
			vec2 q = f - slab * 0.5;
			vec2 dq = abs(q) - vec2(0.9, 0.5);
			float in_g = 1.0 - smoothstep(-px, px, max(dq.x, dq.y));
			float slat = step(0.45, fract(q.x / 0.18));
			col = mix(col, mix(joint, metal_col, slat * k_mid + (1.0 - k_mid) * 0.5), in_g);
		}
		// tombini
		vec2 mh = mod(p + vec2(10.0, 3.0), vec2(23.0, 29.0)) - vec2(11.5, 14.5);
		float rm = length(mh);
		float disc = 1.0 - smoothstep(0.6, 0.6 + px, rm);
		float ring_m = line(rm - 0.55, 0.06, px);
		col = mix(col, metal_col * (0.9 + 0.2 * step(0.5, fract((mh.x + mh.y) * 3.0))), disc);
		col = mix(col, joint, ring_m);
	}
	// velo lucido dell'asfalto bagnato: solo un po' meno ruvido a chiazze morbide
	rough = mix(0.88, 0.5, smoothstep(0.55, 0.8, s));
	ALBEDO = col;
	ROUGHNESS = rough;
	METALLIC = 0.0;
	SPECULAR = 0.4;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Star Light Zone Atto 2: il fondo dell'abisso dove Ã¨ sprofondato il piano strada. Un piano enorme
// molto in basso: macerie scure e chiazze di fuoco che pulsano (rumore che scorre piano), cosÃ¬
// dall'alto la cittÃ  crollata brilla di rosso nella foschia.

render_mode unshaded, cull_disabled, shadows_disabled;

uniform sampler2D noise_tex : filter_linear_mipmap, repeat_enable;
uniform vec3 ash : source_color = vec3(0.035, 0.012, 0.01);
uniform vec3 ember : source_color = vec3(0.9, 0.18, 0.03);
uniform vec3 hot : source_color = vec3(1.0, 0.55, 0.12);
uniform float energy = 1.6;

varying vec3 wpos;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 p = wpos.xz;
	float n1 = texture(noise_tex, p * 0.004 + vec2(TIME * 0.004, 0.0)).r;
	float n2 = texture(noise_tex, p * 0.017 - vec2(0.0, TIME * 0.01)).r;
	float n3 = texture(noise_tex, p * 0.06 + vec2(TIME * 0.02)).r;
	float fire = smoothstep(0.45, 0.8, n1 * 0.6 + n2 * 0.4);
	float pulse = 0.75 + 0.25 * sin(TIME * 1.3 + n2 * 9.0);
	vec3 col = mix(ash, ember * pulse, fire);
	col = mix(col, hot, smoothstep(0.7, 0.95, fire * n3 + fire * 0.3) * pulse);
	ALBEDO = col * energy;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Star Light Zone Atto 2: crepe nella carreggiata e sui tetti con il fuoco che brilla sotto, e
// bruciature nere. Decalcomania appena sopra il piano (layout.gd _cracks): UV = metri dal centro,
// UV2.x = raggio + 100 x seme, UV2.y = tipo (0 crepa, 1 bruciatura).

render_mode blend_mix, depth_draw_never, cull_back, shadows_disabled;

uniform sampler2D noise_tex : filter_linear_mipmap, repeat_enable;
uniform vec3 dark : source_color = vec3(0.025, 0.02, 0.02);
uniform vec3 soot : source_color = vec3(0.05, 0.04, 0.035);
uniform vec3 glow : source_color = vec3(1.0, 0.36, 0.06);
uniform float glow_energy = 3.2;

vec2 hash22(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.xx + p3.yz) * p3.zy);
}

// distanza dal bordo piÃ¹ vicino tra le celle di Voronoi (le crepe corrono lÃ¬)
float voronoi_edge(vec2 p) {
	vec2 g = floor(p);
	vec2 f = fract(p);
	vec2 mr = vec2(0.0);
	vec2 mg = vec2(0.0);
	float md = 8.0;
	for (int j = -1; j <= 1; j++) {
		for (int i = -1; i <= 1; i++) {
			vec2 o = vec2(float(i), float(j));
			vec2 r = o + hash22(g + o) - f;
			float d = dot(r, r);
			if (d < md) { md = d; mr = r; mg = o; }
		}
	}
	md = 8.0;
	for (int j = -2; j <= 2; j++) {
		for (int i = -2; i <= 2; i++) {
			vec2 o = mg + vec2(float(i), float(j));
			vec2 r = o + hash22(g + o) - f;
			if (dot(mr - r, mr - r) > 0.00001) {
				md = min(md, dot(0.5 * (mr + r), normalize(r - mr)));
			}
		}
	}
	return md;
}

void fragment() {
	float radius = mod(UV2.x, 100.0);
	float seed = floor(UV2.x / 100.0);
	vec2 uv = UV;
	float r = length(uv) / max(radius, 0.01);
	float n = texture(noise_tex, uv * 0.11 + seed * 0.37).r;
	// contorno irregolare
	float mask = 1.0 - smoothstep(0.55, 1.0, r + (n - 0.5) * 0.5);
	if (UV2.y > 0.5) {
		// bruciatura: macchia di fuliggine sfumata, piÃ¹ scura al centro, con qualche brace
		float a = mask * (0.55 + 0.35 * smoothstep(0.7, 0.0, r));
		float ember = smoothstep(0.78, 0.86, texture(noise_tex, uv * 0.9 + seed).r) * smoothstep(0.6, 0.1, r);
		ALBEDO = soot;
		EMISSION = glow * ember * glow_energy * (0.6 + 0.4 * sin(TIME * 3.0 + seed));
		ROUGHNESS = 1.0;
		ALPHA = clamp(a, 0.0, 0.92);
	} else {
		// crepa: bordi delle celle deformati dal rumore, piÃ¹ larga al centro della decalcomania
		vec2 q = uv * 0.85 + vec2(seed * 3.17, seed * 1.31) + (vec2(n, texture(noise_tex, uv * 0.07 + 0.5).r) - 0.5) * 0.9;
		float e = voronoi_edge(q);
		float w = mix(0.025, 0.09, smoothstep(1.0, 0.0, r));
		float crack = (1.0 - smoothstep(w * 0.5, w, e)) * mask;
		float core = (1.0 - smoothstep(0.0, w * 0.45, e)) * mask * smoothstep(0.95, 0.3, r);
		float flick = 0.75 + 0.25 * sin(TIME * 4.0 + seed * 5.0 + uv.x * 2.0);
		// alone scuro attorno alla crepa (lastre annerite)
		float halo = (1.0 - smoothstep(w, w * 4.0, e)) * mask * 0.35;
		ALBEDO = mix(dark, glow * 0.5, core);
		EMISSION = glow * core * glow_energy * flick;
		ROUGHNESS = 1.0;
		ALPHA = clamp(max(crack, halo), 0.0, 1.0);
	}
}
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Fiamme lontane di Star Light Zone Atto 2 (nell'abisso tra i palazzi e in cima ai grattacieli):
// shaders/env/flame.gdshader con la nebbia fatta a mano. Con la nebbia del motore il quadrato
// (alfa premoltiplicata) si riempiva del colore della nebbia e da lontano si vedevano dei
// rettangoli rossi: qui la fiamma sparisce nella nebbia invece.
render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_disabled, shadows_disabled, skip_vertex_transform, fog_disabled;

#include "res://shaders/env/burn.gdshaderinc"

uniform sampler2D noise_tex : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform float energy = 2.4;
uniform float opacity = 0.55;       // quanto copre lo sfondo (0 = solo additiva)
uniform float speed = 1.0;
uniform float spread = 0.6;         // accensione scaglionata: soglie di burn tra 0.05 e 0.05 + spread
uniform float near_fade = 2.0;      // si dissolve cosÃ¬ vicino alla camera (m)
uniform float far_soft = 0.0;       // > 0: fiamme lontane piÃ¹ morbide e meno dettagliate
uniform float fog_density = 0.0026; // come la nebbia dell'ambiente: oltre, la fiamma si spegne

varying float v_seed;
varying float v_k;

void vertex() {
	vec3 org = MODEL_MATRIX[3].xyz;
	float sx = length(MODEL_MATRIX[0].xyz);
	float sy = length(MODEL_MATRIX[1].xyz);
	v_seed = burn_hash(org.xz * 1.37 + vec2(org.y * 0.71, 3.1));
	float th = 0.05 + v_seed * spread;
	v_k = smoothstep(th, th + 0.25, burn);
	vec3 cam = INV_VIEW_MATRIX[3].xyz;
	vec3 to = cam - org;
	to.y = 0.0;
	vec3 fwd = length(to) > 0.001 ? normalize(to) : vec3(0.0, 0.0, 1.0);
	vec3 right = normalize(cross(vec3(0.0, 1.0, 0.0), fwd));
	float pulse = 0.88 + 0.12 * sin(TIME * (2.6 + v_seed) + v_seed * 20.0);
	float h = sy * v_k * pulse;
	vec3 wp = org + right * VERTEX.x * sx * (0.6 + 0.4 * v_k) + vec3(0.0, VERTEX.y * h, 0.0);
	// la cima ondeggia
	wp += right * sin(TIME * 2.1 + v_seed * 12.0) * 0.1 * VERTEX.y * sx;
	VERTEX = (VIEW_MATRIX * vec4(wp, 1.0)).xyz;
	NORMAL = normalize((VIEW_MATRIX * vec4(fwd, 0.0)).xyz);
}

void fragment() {
	if (v_k <= 0.002) {
		discard;
	}
	float y = 1.0 - UV.y;
	float x = UV.x - 0.5;
	float t = TIME * speed * (0.85 + v_seed * 0.3);
	float n1 = texture(noise_tex, vec2(UV.x * 0.5 + v_seed * 3.1, y * 0.42 - t * 0.85)).r;
	float n2 = texture(noise_tex, vec2(UV.x * 1.25 - v_seed * 1.7, y * 1.05 - t * 1.6)).r;
	float n = mix(n1 * 0.6 + n2 * 0.4, n1, far_soft);
	x += (n - 0.5) * 0.36 * (0.25 + y);
	// goccia: larga in basso, stretta in cima
	float w = 0.44 * pow(max(1.0 - y, 0.0), 0.85) * smoothstep(-0.02, 0.12, y);
	float body = 1.0 - smoothstep(w * 0.4, w, abs(x));
	// lingue: il rumore mangia la parte alta
	float f = body * (1.0 - smoothstep(0.1, 0.95, y * (0.55 + n * 1.25)));
	f = clamp(f * 1.7 - n * 0.5 * y, 0.0, 1.0);
	vec3 c_edge = vec3(0.85, 0.1, 0.015);
	vec3 c_mid = vec3(1.0, 0.42, 0.05);
	vec3 c_core = vec3(1.0, 0.76, 0.3);
	vec3 col = mix(c_edge, c_mid, smoothstep(0.08, 0.42, f));
	col = mix(col, c_core, smoothstep(0.62, 0.95, f) * (1.0 - y * 0.6));
	float a = smoothstep(0.02, 0.22, f) * v_k;
	float near = smoothstep(near_fade * 0.3, near_fade, -VERTEX.z);
	a *= near * exp(-fog_density * -VERTEX.z * 0.8);
	ALBEDO = col * energy * a;
	ALPHA = clamp(a * opacity, 0.0, 1.0);
}
␀␀␀␀␀␀␀shader_type spatial;
// Star Light Zone Atto 2: il tubo di vetro (scripts/level/slz_tube.gd). Vetro azzurro quasi
// trasparente, piÃ¹ pieno di taglio (fresnel), con i riflessi del fuoco e righe di luce che scorrono
// verso l'uscita (UV.x = metri lungo il tubo).

render_mode blend_mix, depth_draw_never, cull_disabled, shadows_disabled, specular_schlick_ggx;

uniform vec3 tint : source_color = vec3(0.45, 0.78, 1.0);
uniform vec3 fire : source_color = vec3(1.0, 0.45, 0.15);
uniform float flow = 9.0;

void fragment() {
	float f = pow(1.0 - clamp(abs(dot(NORMAL, VIEW)), 0.0, 1.0), 2.5);
	float streak = smoothstep(0.92, 1.0, sin((UV.x - TIME * flow) * 0.35) * 0.5 + 0.5) * smoothstep(0.2, 0.5, UV.y) * smoothstep(0.8, 0.5, UV.y);
	ALBEDO = tint * 0.35;
	ROUGHNESS = 0.06;
	METALLIC = 0.0;
	SPECULAR = 0.9;
	EMISSION = tint * (0.06 + f * 0.35 + streak * 0.6) + fire * f * 0.25;
	ALPHA = clamp(0.07 + f * 0.55 + streak * 0.25, 0.0, 0.85);
}
␀shader_type spatial;
// Star Light Zone Atto 2: ombra che avvisa dove sta per cadere un detrito (scripts/level/slz_debris.gd).
// Un quadrato steso a terra: disco scuro che si allarga e si fa piÃ¹ nero con "k" (0 appena comparso
// .. 1 impatto) e un anello rosso che lampeggia sempre piÃ¹ svelto.

render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled;

instance uniform float k = 0.0;
uniform vec3 ring_col : source_color = vec3(1.0, 0.12, 0.05);

void fragment() {
	float r = length(UV - 0.5) * 2.0;
	float disc = (1.0 - smoothstep(0.45 + 0.4 * k, 0.6 + 0.4 * k, r)) * (0.25 + 0.6 * k);
	float speed = mix(4.0, 18.0, k);
	float blink = step(0.5, fract(TIME * speed * 0.5));
	float ring = (1.0 - smoothstep(0.03, 0.07, abs(r - 0.92))) * (0.5 + 0.5 * blink);
	ALBEDO = mix(vec3(0.0), ring_col * 2.5, ring);
	ALPHA = clamp(max(disc, ring) * smoothstep(0.0, 0.08, k), 0.0, 1.0);
}
␀␀␀shader_type spatial;
// Corteccia: tronchi di palma ad anelli (stile Sonic 3) e tronchi della giungla.
// UV.x = giro attorno al tronco, UV.y = metri lungo il tronco. COLOR = tinta/occlusione.

render_mode diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/island_common.gdshaderinc"
#include "res://shaders/env/burn.gdshaderinc"
#include "res://shaders/env/breeze.gdshaderinc"

varying vec3 b_org;

uniform vec3 col_a : source_color = vec3(0.62, 0.45, 0.28);
uniform vec3 col_b : source_color = vec3(0.45, 0.31, 0.19);
uniform float ring_len = 0.42;
uniform float rings = 1.0;       // 1 = palma ad anelli, 0 = corteccia fibrosa
uniform float wind_strength = 0.0;
uniform float wind_speed = 1.3;

void vertex() {
	b_org = MODEL_MATRIX[3].xyz;
	if (wind_strength > 0.0) {
		vec3 org = MODEL_MATRIX[3].xyz;
		float ph = org.x * 0.137 + org.z * 0.211;
		float flex = COLOR.a;
		float t = TIME * wind_speed;
		float bz = breeze(org, ph);
		float amp = wind_strength * (1.0 + bz * 0.8);
		VERTEX.x += (sin(t + ph) * 0.7 + sin(t * 2.7 + ph * 1.9) * 0.3) * flex * amp;
		VERTEX.z += sin(t * 1.3 + ph * 0.7) * 0.5 * flex * amp * 0.7;
		VERTEX += breeze_lean(bz, flex, wind_strength, mat3(MODEL_MATRIX));
	}
}

void fragment() {
	float v = UV.y;
	float u = UV.x;
	float g = g2(vec2(u * 2.0, v * 0.35));
	float s = n2(vec2(u * 0.5, v * 0.08));
	vec3 c;
	if (rings > 0.5) {
		float band = fract(v / ring_len);
		// anelli: bordo scuro a ogni giunto, metÃ  inferiore piÃ¹ chiara
		float groove = smoothstep(0.0, 0.12, band) * smoothstep(1.0, 0.86, band);
		float idx = floor(v / ring_len);
		c = mix(col_a, col_b, smoothstep(0.35, 0.9, band) * 0.6 + hash11(idx) * 0.25);
		c *= mix(0.55, 1.0, groove);
		// fibre verticali
		c *= 0.85 + g * 0.25;
	} else {
		float fib = g2(vec2(u * 6.0, v * 0.25));
		c = mix(col_b, col_a, s) * (0.75 + fib * 0.4);
	}
	ALBEDO = c * COLOR.rgb;
	ROUGHNESS = 0.9;
	SPECULAR = 0.25;
	if (burn > 0.0) {
		// Atto 2: tronchi anneriti dal basso, i piÃ¹ bruciati carbonizzati con le crepe accese
		float m = clamp(burn_mask(b_org.xz) + (burn_hash(b_org.xz * 3.7) - 0.5) * 0.35, 0.0, 1.0);
		float soot = smoothstep(0.15, 0.6, m) * (0.55 + 0.45 * (1.0 - smoothstep(1.0, 5.0, v)));
		vec3 charred = vec3(0.04, 0.032, 0.028) * (0.8 + g * 0.6);
		vec3 o = mix(ALBEDO * vec3(0.8, 0.68, 0.58), charred, max(soot, smoothstep(0.62, 0.85, m)));
		ALBEDO = mix(ALBEDO, o, burn);
		float crack = smoothstep(0.72, 0.9, g2(vec2(u * 3.0, v * 0.5))) * smoothstep(0.65, 0.9, m);
		EMISSION = vec3(1.0, 0.3, 0.04) * crack * burn * 3.0 * burn_flicker(b_org.xz);
	}
}
␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Copia di bark.gdshader (stesso aspetto) con vento a raffiche e terremoto: usata solo
// durante la cinematica d'apertura (vedi wind_sway.gdshaderinc).
// Corteccia: tronchi di palma ad anelli (stile Sonic 3) e tronchi della giungla.
// UV.x = giro attorno al tronco, UV.y = metri lungo il tronco. COLOR = tinta/occlusione.

render_mode diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/island_common.gdshaderinc"
#include "res://shaders/env/burn.gdshaderinc"
#include "res://shaders/env/breeze.gdshaderinc"

varying vec3 b_org;

uniform vec3 col_a : source_color = vec3(0.62, 0.45, 0.28);
uniform vec3 col_b : source_color = vec3(0.45, 0.31, 0.19);
uniform float ring_len = 0.42;
uniform float rings = 1.0;       // 1 = palma ad anelli, 0 = corteccia fibrosa
uniform float wind_strength = 0.0;
uniform float wind_speed = 1.3;

#include "res://shaders/env/wind_sway.gdshaderinc"

void vertex() {
	b_org = MODEL_MATRIX[3].xyz;
	vec3 org = MODEL_MATRIX[3].xyz;
	float ph = org.x * 0.137 + org.z * 0.211;
	float flex = COLOR.a;
	float t = TIME * wind_speed;
	float bz = breeze(org, ph);
	float amp = wind_strength * (1.0 + gust * 1.8 + bz * 0.8);
	VERTEX.x += (sin(t + ph) * 0.7 + sin(t * 2.7 + ph * 1.9) * 0.3) * flex * amp;
	VERTEX.z += sin(t * 1.3 + ph * 0.7) * 0.5 * flex * amp * 0.7;
	VERTEX += wind_extra(org, ph, flex, wind_strength, mat3(MODEL_MATRIX));
	VERTEX += breeze_lean(bz, flex, wind_strength, mat3(MODEL_MATRIX));
}

void fragment() {
	float v = UV.y;
	float u = UV.x;
	float g = g2(vec2(u * 2.0, v * 0.35));
	float s = n2(vec2(u * 0.5, v * 0.08));
	vec3 c;
	if (rings > 0.5) {
		float band = fract(v / ring_len);
		// anelli: bordo scuro a ogni giunto, metÃ  inferiore piÃ¹ chiara
		float groove = smoothstep(0.0, 0.12, band) * smoothstep(1.0, 0.86, band);
		float idx = floor(v / ring_len);
		c = mix(col_a, col_b, smoothstep(0.35, 0.9, band) * 0.6 + hash11(idx) * 0.25);
		c *= mix(0.55, 1.0, groove);
		// fibre verticali
		c *= 0.85 + g * 0.25;
	} else {
		float fib = g2(vec2(u * 6.0, v * 0.25));
		c = mix(col_b, col_a, s) * (0.75 + fib * 0.4);
	}
	ALBEDO = c * COLOR.rgb;
	ROUGHNESS = 0.9;
	SPECULAR = 0.25;
	if (burn > 0.0) {
		// Atto 2: tronchi anneriti dal basso, i piÃ¹ bruciati carbonizzati con le crepe accese
		float m = clamp(burn_mask(b_org.xz) + (burn_hash(b_org.xz * 3.7) - 0.5) * 0.35, 0.0, 1.0);
		float soot = smoothstep(0.15, 0.6, m) * (0.55 + 0.45 * (1.0 - smoothstep(1.0, 5.0, v)));
		vec3 charred = vec3(0.04, 0.032, 0.028) * (0.8 + g * 0.6);
		vec3 o = mix(ALBEDO * vec3(0.8, 0.68, 0.58), charred, max(soot, smoothstep(0.62, 0.85, m)));
		ALBEDO = mix(ALBEDO, o, burn);
		float crack = smoothstep(0.72, 0.9, g2(vec2(u * 3.0, v * 0.5))) * smoothstep(0.65, 0.9, m);
		EMISSION = vec3(1.0, 0.3, 0.04) * crack * burn * 3.0 * burn_flicker(b_org.xz);
	}
}
// Raffiche di vento per tutta la vegetazione (foliage, bark e le loro copie col vento della intro):
// onde che attraversano l'isola ogni pochi secondi; quando l'onda passa la pianta oscilla di piÃ¹ e si
// piega un poco sottovento, come i prati e le palme di Unleashed. Tronco e fronde della stessa palma
// hanno la stessa origine, quindi la stessa raffica (e la piega scala con il loro wind_strength,
// come l'oscillazione). "vento" (globale, 0..1) lo spengono le impostazioni grafiche (Cielo animato).
global uniform float vento;

const vec2 BREEZE_DIR = vec2(-0.6, -0.8);   // verso cui soffia (come wind_dir della intro)

// 0..1: forza della raffica che passa ora sulla pianta con origine org
float breeze(vec3 org, float ph) {
	float w = sin(TIME * 0.55 - dot(org.xz, BREEZE_DIR) * 0.06 + ph * 0.2);
	return smoothstep(0.25, 1.0, w) * vento;
}

// piega sottovento nello spazio del modello (mb = base del modello: rotazione e scala uniforme)
vec3 breeze_lean(float g, float flex, float ws, mat3 mb) {
	vec3 w = transpose(mb) * vec3(BREEZE_DIR.x, 0.0, BREEZE_DIR.y) / max(dot(mb[0], mb[0]), 1e-4);
	return w * flex * ws * g * 1.4;
}
␀␀␀␀␀␀␀␀␀␀// Angel Island Atto 2: la giungla che brucia (come in Sonic 3 dopo il bombardamento).
// burn = 0: la giungla verde di sempre (l'Atto 1 non lo tocca mai); 1: foresta in fiamme. Lo porta
// da 0 a 1 il livello (scripts/level/level_act2.gd, ignite_forest) su tutti i materiali che lo hanno.
// La bruciatura non Ã¨ uniforme: macchie nel mondo (burn_mask) lasciano parti ancora verdi, parti
// secche giallo-oliva come i cespugli di Sonic 3 e parti carbonizzate con le braci.

uniform float burn = 0.0;

float burn_hash(vec2 p) {
	p = fract(p * vec2(0.1031, 0.1030));
	p += dot(p, p.yx + 33.33);
	return fract((p.x + p.y) * p.x);
}

// rumore a valori senza texture (per gli shader che non hanno noise_a)
float burn_vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float a = burn_hash(i);
	float b = burn_hash(i + vec2(1.0, 0.0));
	float c = burn_hash(i + vec2(0.0, 1.0));
	float d = burn_hash(i + vec2(1.0, 1.0));
	return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// quanto Ã¨ bruciato questo punto del mondo (0 verde .. 1 carbonizzato), macchie di ~30 m
float burn_mask(vec2 xz) {
	float n = burn_vnoise(xz * 0.035) * 0.65 + burn_vnoise(xz * 0.11 + 17.3) * 0.35;
	return smoothstep(0.28, 0.72, n);
}

// tremolio della luce del fuoco (0.75..1.15), lento e diverso da punto a punto
float burn_flicker(vec2 xz) {
	float ph = burn_hash(floor(xz * 0.2)) * 6.28;
	return 0.95 + 0.12 * sin(TIME * 7.3 + ph) + 0.08 * sin(TIME * 13.1 + ph * 2.3);
}

// vegetazione: verde -> secca (oliva, ocra) -> carbonizzata, con le braci sui bordi
// c = colore originale, m = maschera di bruciatura, k = burn, lum = luminositÃ  della foglia
vec3 burn_leaf(vec3 c, float m, float k, out vec3 ember) {
	float l = dot(c, vec3(0.3, 0.59, 0.11));
	vec3 dry = mix(vec3(0.22, 0.2, 0.02), vec3(0.62, 0.42, 0.06), smoothstep(0.02, 0.2, l)) * (0.75 + l * 2.0);
	vec3 charred = vec3(0.035, 0.028, 0.024) + vec3(0.06, 0.03, 0.01) * l * 4.0;
	// anche le parti ancora verdi diventano piÃ¹ calde e un po' piÃ¹ spente (calore e fumo)
	vec3 green = mix(c, c * vec3(1.08, 0.92, 0.6), 0.6);
	vec3 o = mix(green, dry, smoothstep(0.2, 0.55, m));
	o = mix(o, charred, smoothstep(0.62, 0.9, m));
	ember = vec3(1.0, 0.32, 0.04) * smoothstep(0.7, 0.95, m) * k;
	return mix(c, o, k);
}

// terreno erboso: erba bruciata (ocra e cenere), chiazze ancora verdi, braci nella cenere
vec3 burn_ground(vec3 c, float m, float k, float grain, out vec3 ember) {
	float l = dot(c, vec3(0.3, 0.59, 0.11));
	vec3 scorched = mix(vec3(0.16, 0.11, 0.03), vec3(0.42, 0.3, 0.08), grain) * (0.7 + l * 1.5);
	vec3 ash = mix(vec3(0.03, 0.026, 0.024), vec3(0.1, 0.09, 0.085), grain);
	vec3 green = mix(c, c * vec3(1.1, 0.9, 0.55), 0.55);
	vec3 o = mix(green, scorched, smoothstep(0.25, 0.55, m));
	o = mix(o, ash, smoothstep(0.65, 0.92, m));
	ember = vec3(1.0, 0.28, 0.03) * smoothstep(0.9, 0.99, m) * smoothstep(0.8, 0.95, grain) * k;
	return mix(c, o, k);
}
␀␀␀␀␀␀␀␀␀shader_type spatial;
// Pareti di roccia stratificata generate lungo i bordi dei pianori.
// UV2.x = indice dello strato, UV2.y = altezza dentro lo strato (0 piede, 1 cima),
// COLOR.r = 1 per il ciuffo d'erba che sporge in cima.

render_mode diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/island_common.gdshaderinc"
#include "res://shaders/env/burn.gdshaderinc"

varying vec3 wpos;
varying vec3 wnrm;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wnrm);
	// indice dello strato: costante per quad, ma interpolato vale kÂ±epsilon e floor() saltava
	// da un colore all'altro pixel per pixel (puntinato a triangoli che sfarfallava): arrotonda
	float layer = floor(UV2.x + 0.5);
	vec3 base = strata_color(layer);
	// superficie morbida a bassa frequenza: niente grana fine nÃ© venature stirate (sfarfallano da lontano)
	float gr = tri_soft(wpos, n, 0.09);
	float gs = tri_soft(wpos, n, 0.025);
	vec3 c = base * (0.9 + gr * 0.18);
	c = mix(c, c * vec3(0.84, 0.78, 0.9), gs * 0.5);
	// ogni fascia ha la sua sfumatura (come le scogliere dipinte dei Sonic): cima piÃ¹ chiara e
	// calda dove la luce sfiora lo spigolo, piede un po' piÃ¹ scuro sopra la cengia di sotto
	float band = UV2.y;
	c *= mix(0.86, 1.04, smoothstep(0.0, 0.85, band));
	c = mix(c, c * 1.12 + vec3(0.025, 0.015, 0.0), smoothstep(0.8, 1.0, band) * 0.55);
	// chiazze lunghe lungo la fascia (colature e polvere, bassa frequenza: niente sfarfallio)
	c *= 0.93 + 0.14 * n2(vec2(UV.x * 0.35, layer * 0.173));
	// le cenge orizzontali prendono un po' di polvere chiara, i sottosquadri sono scuri
	float up = clamp(n.y, -1.0, 1.0);
	c = mix(c, c * 1.1 + vec3(0.03, 0.025, 0.0), smoothstep(0.35, 0.8, up));
	c *= mix(1.0, 0.72, smoothstep(-0.1, -0.6, up));
	// muschio e umiditÃ  verso la base
	float moss = smoothstep(0.45, 0.8, gs + up * 0.4) * smoothstep(0.2, 0.7, UV.y);
	c = mix(c, srgb(vec3(0.2, 0.36, 0.12)), moss * 0.35);

	// ciuffo d'erba sporgente
	float g = COLOR.r;
	vec3 grass = grass_albedo(wpos, 0.6);
	if (burn > 0.0) {
		// Atto 2: fuliggine che sale dal basso a chiazze, muschio e ciuffi d'erba bruciati
		float bm = burn_mask(wpos.xz);
		c = mix(c, c * vec3(0.55, 0.48, 0.44), burn * (0.25 + 0.5 * bm) * (0.6 + 0.4 * gs));
		vec3 em;
		grass = burn_ground(grass, bm, burn, gr, em);
	}
	vec3 lip = mix(grass, srgb(vec3(0.07, 0.27, 0.08)), smoothstep(0.5, -0.4, n.y));
	c = mix(c, lip, g);

	ALBEDO = c;
	ROUGHNESS = mix(0.86, 0.95, g);
	SPECULAR = 0.3;
	BACKLIGHT = vec3(0.2, 0.35, 0.1) * g;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Pontile dell'inseguimento dell'orca di Emerald Coast Atto 1 (scripts/env/gen_ec1/pier.gd,
// scripts/level/ec1_orca.gd): le assi del modello di Sonic Adventure come gli altri materiali del
// livello (texture opaca, ruvida), e i pezzi giÃ  distrutti dall'orca spariscono. Ogni pezzo da 5 m ha
// in UV2.x il punto (metri lungo il pontile) dove comincia: sotto broken_to non si disegna.

render_mode cull_disabled;

uniform sampler2D tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
instance uniform float broken_to = -1.0;

varying float piece;

void vertex() {
	piece = UV2.x;
}

void fragment() {
	if (piece < broken_to) {
		discard;
	}
	ALBEDO = texture(tex, UV).rgb;
	ROUGHNESS = 0.92;
	METALLIC = 0.0;
	SPECULAR = 0.2;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type sky;
// Cielo di Emerald Coast (base comune ai due atti, scripts/env/gen_ec/sky.gd): lo stesso cielo di
// Angel Island (shaders/env/sky.gdshader: gradiente, alone del sole, cumuli grandi e morbidi che
// scorrono col vento) con i colori delle nuvole e del disco del sole come parametri, cosÃ¬ lo stesso
// cielo fa il mezzogiorno di Sonic Adventure (Atto 1) e il tramonto arancione (Atto 2).

uniform vec3 zenith : source_color = vec3(0.05, 0.27, 0.86);
uniform vec3 mid : source_color = vec3(0.2, 0.55, 1.0);
uniform vec3 horizon : source_color = vec3(0.6, 0.82, 1.0);
uniform vec3 sea_far : source_color = vec3(0.3, 0.6, 0.86);
uniform vec3 sun_glow : source_color = vec3(1.0, 0.86, 0.6);
uniform float glow_wide = 0.28;                // alone largo del sole (al tramonto piÃ¹ ampio)
uniform float glow_tight = 0.45;
uniform vec3 sun_disc = vec3(6.0, 5.4, 4.4);   // disco del sole (HDR)
uniform float sun_size = 0.99955;
uniform sampler2D cloud_noise : filter_linear_mipmap, repeat_enable;
uniform float cloud_cover = 0.56;
uniform float cloud_scale = 0.2;
uniform float cloud_speed = 0.004;
global uniform float vento;
uniform vec3 cloud_lit : source_color = vec3(1.0, 0.99, 0.96);     // lato al sole
uniform vec3 cloud_shade : source_color = vec3(0.66, 0.74, 0.88);  // lato in ombra
uniform float cloud_sun = 0.4;                 // quanto il sole schiarisce le nuvole vicine
uniform vec3 cloud_low : source_color = vec3(1.0, 1.0, 1.0);       // tinta delle nuvole basse (tramonto: arancio)
uniform float cloud_low_amt = 0.0;

float clouds(vec2 uv, float tm) {
	float a = texture(cloud_noise, uv * 0.6).r;
	float b = texture(cloud_noise, uv * 1.9 + vec2(0.31, 0.77) + vec2(tm * 0.9, tm * 0.35)).r;
	float c = texture(cloud_noise, uv * 4.7 + vec2(0.13, 0.41) + vec2(tm * 2.2, -tm * 0.6)).r;
	return a * 0.64 + b * 0.24 + c * 0.12;
}

void sky() {
	vec3 d = normalize(EYEDIR);
	float y = d.y;
	vec3 col;
	if (y >= 0.0) {
		float t1 = pow(clamp(y, 0.0, 1.0), 0.45);
		col = mix(horizon, mid, smoothstep(0.0, 0.35, t1));
		col = mix(col, zenith, smoothstep(0.3, 1.0, t1));
	} else {
		col = mix(horizon, sea_far, smoothstep(0.0, -0.06, y));
	}
	vec3 L = LIGHT0_DIRECTION;
	float sd = dot(d, L);
	col += sun_glow * (pow(max(sd, 0.0), 8.0) * glow_wide + pow(max(sd, 0.0), 64.0) * glow_tight);
	col = mix(col, col * vec3(1.05, 0.98, 0.9), (1.0 - smoothstep(0.0, 0.25, abs(y))) * 0.3 * max(sd * 0.5 + 0.5, 0.0));
	if (!AT_CUBEMAP_PASS && sd > sun_size) {
		col += sun_disc * smoothstep(sun_size, sun_size + 0.0001, sd);
	}
	if (y > 0.0) {
		float tm = TIME * cloud_speed * vento;
		vec2 uv = d.xz / (y + 0.12) * cloud_scale + vec2(tm, tm * 0.25);
		float c = clouds(uv, tm);
		float dens = smoothstep(cloud_cover, cloud_cover + 0.16, c);
		vec2 toward = normalize(L.xz + vec2(0.0001)) * 0.03;
		float c2 = clouds(uv + toward, tm);
		float lit = clamp((c - c2) * 6.0 + 0.62, 0.0, 1.0);
		float thick = smoothstep(cloud_cover + 0.1, cloud_cover + 0.32, c);
		vec3 cl = mix(cloud_shade, cloud_lit, lit);
		cl = mix(cl, cl * vec3(0.9, 0.93, 0.98), thick * (1.0 - lit) * 0.6);
		cl += sun_glow * pow(max(sd, 0.0), 6.0) * cloud_sun * (1.0 - dens);
		// nuvole basse sull'orizzonte tinte (al tramonto prendono l'arancio del sole)
		cl = mix(cl, cl * cloud_low, cloud_low_amt * (1.0 - smoothstep(0.02, 0.4, y)));
		float fade = smoothstep(0.02, 0.2, y);
		col = mix(col, cl, dens * fade * 0.97);
	}
	COLOR = col;
}
␀␀␀␀shader_type spatial;
// Mare di Emerald Coast (set della cutscene del ring portal, emerald_coast_set.gd): le texture
// dell'acqua del modello di Sonic Adventure cosÃ¬ come sono, che scorrono piano, con i riflessi del
// sole (mappa di normali che scorre) e, sul mare aperto aggiunto attorno al modello (world_uv), la
// texture ripetuta in coordinate del mondo che sfuma verso il colore dell'orizzonte.

render_mode cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform sampler2D tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D normal_tex : hint_normal, filter_linear_mipmap, repeat_enable;
uniform vec2 scroll = vec2(0.02, 0.01);     // UV al secondo
uniform float sway = 0.0;                   // va e viene (riva, schiuma): ampiezza in UV
uniform bool world_uv = false;              // mare aperto: UV = xz del mondo / tile
uniform float tile = 14.0;
uniform vec3 horizon_col : source_color = vec3(0.45, 0.72, 0.92);
uniform float fade_start = 120.0;
uniform float fade_end = 900.0;
uniform float glint = 0.6;
uniform float rough = 0.12;
// mare aperto dei livelli (scripts/env/gen_ec/sea.gd): la texture dell'acqua alta Ã¨ una sfumatura da
// stendere lungo l'anello attorno alle isole (ripetuta fa righe): qui il colore del suo bordo esterno,
// variato piano a grandi macchie, e i riflessi del sole
uniform bool world_cross = false;
uniform vec3 deep_col : source_color = vec3(0.004, 0.184, 0.333);

varying vec3 wpos;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 uv = world_uv ? wpos.xz / tile : UV;
	uv += scroll * TIME + vec2(sin(TIME * 0.9), cos(TIME * 0.7)) * sway;
	vec3 col = texture(tex, uv).rgb;
	if (world_uv && world_cross) {
		float v1 = texture(normal_tex, wpos.xz * 0.0071 + vec2(TIME * 0.002, 0.0)).r;
		float v2 = texture(normal_tex, wpos.xz * 0.0029 + vec2(0.0, TIME * 0.0013)).g;
		col = deep_col * (0.86 + 0.3 * (v1 * 0.6 + v2 * 0.4));
	}
	vec2 nuv = wpos.xz * 0.11;
	vec3 n1 = texture(normal_tex, nuv + vec2(TIME * 0.021, TIME * 0.013)).rgb;
	vec3 n2 = texture(normal_tex, nuv * 1.7 + vec2(-TIME * 0.017, TIME * 0.024)).rgb;
	NORMAL_MAP = mix(vec3(0.5, 0.5, 1.0), normalize(n1 + n2 - 1.0) * 0.5 + 0.5, glint);
	float d = length(wpos - CAMERA_POSITION_WORLD);
	float far = world_uv ? smoothstep(fade_start, fade_end, d) : 0.0;
	ALBEDO = mix(col, horizon_col, far);
	ROUGHNESS = rough;
	SPECULAR = 0.6;
}
␀␀␀␀␀␀␀␀shader_type sky;
// Cielo di notte di Eggmanland (cinematiche di Eggmanland Atto 1, egl1_cine_base.gd), come nel
// riferimento di Sonic Unleashed dell'utente: nuvole basse e fitte color cremisi cupo, accese da
// sotto dal rosso delle luci del parco (piÃ¹ chiare verso l'orizzonte), zenit quasi nero violaceo,
// orizzonte rosso. Stessa texture di rumore e stesso vento globale dei cieli del gioco.

uniform vec3 zenith : source_color = vec3(0.04, 0.015, 0.04);
uniform vec3 horizon : source_color = vec3(0.16, 0.022, 0.035);
uniform vec3 below : source_color = vec3(0.05, 0.01, 0.03);
uniform vec3 cloud_dark : source_color = vec3(0.06, 0.012, 0.025);
uniform vec3 cloud_lit : source_color = vec3(0.3, 0.06, 0.08);
uniform sampler2D cloud_noise : filter_linear_mipmap, repeat_enable;
uniform float cloud_cover = 0.34;
uniform float cloud_scale = 0.22;
uniform float cloud_speed = 0.004;
global uniform float vento;

void sky() {
	vec3 d = normalize(EYEDIR);
	float y = d.y;
	vec3 col;
	if (y >= 0.0) {
		col = mix(horizon, zenith, smoothstep(0.0, 0.45, pow(y, 0.7)));
		float tm = TIME * cloud_speed * vento;
		vec2 uv = d.xz / (y + 0.1) * cloud_scale * vec2(1.0, 1.6) + vec2(tm, tm * 0.3);
		float a = texture(cloud_noise, uv * 0.6).r;
		float b = texture(cloud_noise, uv * 1.9 + vec2(0.31, 0.77) + vec2(tm * 0.9, tm * 0.35)).r;
		float c = a * 0.7 + b * 0.3;
		float dens = smoothstep(cloud_cover, cloud_cover + 0.3, c);
		// accese da sotto: piÃ¹ rosse vicino all'orizzonte e dove sono sottili
		float glow = (1.0 - smoothstep(0.0, 0.5, y)) * (0.55 + 0.45 * (1.0 - smoothstep(cloud_cover + 0.15, cloud_cover + 0.45, c)));
		vec3 cl = mix(cloud_dark, cloud_lit, glow);
		col = mix(col, cl, dens * smoothstep(0.0, 0.08, y) * 0.95);
	} else {
		col = mix(horizon, below, smoothstep(0.0, -0.1, y));
	}
	COLOR = col;
}
␀␀␀␀␀shader_type spatial;
// Braci nell'aria (Angel Island Atto 2): un campo di scintille attorno alla camera. Le istanze
// hanno posizioni a caso in un cubo di lato "box"; lo shader le fa salire col vento e le riavvolge
// attorno alla camera, cosÃ¬ il campo la segue senza script nÃ© particelle (niente buffer da
// riempire a ogni fotogramma). Si vedono solo con la foresta in fiamme ("burn").

render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, skip_vertex_transform, fog_disabled;

#include "res://shaders/env/burn.gdshaderinc"

uniform float box = 60.0;
uniform float energy = 3.6;
uniform vec3 color : source_color = vec3(1.0, 0.45, 0.08);
// una brace su quattro Ã¨ piÃ¹ calda (giallo-arancio) e un filo piÃ¹ grande: il campo non Ã¨ tutto uguale
uniform vec3 color_hot : source_color = vec3(1.0, 0.74, 0.3);

varying float v_a;
varying vec2 v_uv;
varying float v_hot;

void vertex() {
	vec3 org = MODEL_MATRIX[3].xyz;
	float seed = burn_hash(org.xz * 3.7 + vec2(org.y * 2.3, 1.9));
	float seed2 = burn_hash(org.zy * 2.9 + vec2(5.3, org.x));
	vec3 vel = vec3(0.8 + seed2 * 1.6, 1.2 + seed * 2.2, -0.4 + seed2 * 0.8);
	vec3 p = org + vel * TIME;
	p += vec3(sin(TIME * (1.3 + seed * 2.0) + seed * 30.0), 0.0, cos(TIME * (1.1 + seed2 * 1.7) + seed2 * 30.0)) * 0.6;
	vec3 cam = INV_VIEW_MATRIX[3].xyz;
	p = cam + mod(p - cam + box * 0.5, box) - box * 0.5;
	float d = length(p - cam);
	float flick = 0.55 + 0.45 * sin(TIME * (9.0 + seed * 8.0) + seed2 * 40.0);
	v_a = smoothstep(0.35, 0.8, burn) * (1.0 - smoothstep(box * 0.3, box * 0.48, d)) * smoothstep(1.2, 3.5, d) * flick;
	v_hot = step(0.75, seed2);
	// (piÃ¹ grandi da lontano: le scintille si vedono anche in fondo, vicino restano piccole)
	float s = (0.035 + seed * 0.05 + v_hot * 0.015) * (1.0 + d * 0.02);
	vec3 fwd = normalize(cam - p);
	vec3 right = normalize(cross(vec3(0.0, 1.0, 0.0), fwd));
	vec3 up = cross(fwd, right);
	// scie corte nella direzione del moto
	vec3 wp = p + right * VERTEX.x * s + up * VERTEX.y * s * 2.2;
	VERTEX = (VIEW_MATRIX * vec4(wp, 1.0)).xyz;
	v_uv = UV;
}

void fragment() {
	if (v_a <= 0.002) {
		discard;
	}
	vec2 q = v_uv - 0.5;
	float r = 1.0 - smoothstep(0.1, 0.5, length(q * vec2(1.0, 0.6)));
	// nucleo chiaro e alone colorato
	vec3 c = mix(color, color_hot, v_hot);
	c = mix(c, vec3(1.0, 0.86, 0.6), smoothstep(0.55, 0.95, r) * 0.4);
	ALBEDO = c * energy * r * v_a;
}
shader_type spatial;
// Smeraldo Madre: gemma sfaccettata che pulsa di luce verde, bordo luminoso (fresnel).

render_mode diffuse_burley, specular_schlick_ggx;

uniform vec3 base_col : source_color = vec3(0.02, 0.55, 0.16);
uniform vec3 glow_col : source_color = vec3(0.06, 0.95, 0.30);
uniform float glow = 0.9;

void fragment() {
	float fres = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 2.5);
	float pulse = 0.82 + 0.18 * sin(TIME * 2.2);
	// riflessi interni finti: bande che cambiano con la direzione di vista
	float inner = 0.5 + 0.5 * sin(dot(NORMAL, vec3(5.0, 7.0, 3.0)) + dot(VIEW, vec3(3.0, -2.0, 4.0)) * 2.0);
	ALBEDO = base_col;
	EMISSION = glow_col * glow * pulse * (0.3 + inner * 0.3 + fres * 0.9);
	METALLIC = 0.3;
	ROUGHNESS = 0.04;
	SPECULAR = 1.0;
	RIM = 0.6;
	RIM_TINT = 0.3;
}
␀shader_type spatial;
// Fiamme della foresta che brucia (Angel Island Atto 2): un quadrato 1x1 con la base in basso
// (QuadMesh con center_offset y 0.5) girato verso la camera attorno alla verticale; la scala
// dell'istanza dÃ  larghezza (x) e altezza (y). La forma Ã¨ procedurale: una goccia deformata da due
// rumori che salgono, lingue che si staccano in cima, nucleo giallo, bordi rossi. Alfa
// premoltiplicata con alfa piÃ¹ bassa del colore: in parte additiva (brilla col glow) ma copre lo
// sfondo quanto basta per restare arancione sul cielo rosso.
// Si accende con "burn" (0 giungla verde .. 1 in fiamme): ogni fiamma a un suo momento (spread),
// cosÃ¬ l'incendio si allarga invece di accendersi tutto insieme.

render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_disabled, shadows_disabled, skip_vertex_transform;

#include "res://shaders/env/burn.gdshaderinc"

uniform sampler2D noise_tex : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform float energy = 2.4;
uniform float opacity = 0.55;       // quanto copre lo sfondo (0 = solo additiva)
uniform float speed = 1.0;
uniform float spread = 0.6;         // accensione scaglionata: soglie di burn tra 0.05 e 0.05 + spread
uniform float near_fade = 2.0;      // si dissolve cosÃ¬ vicino alla camera (m)
uniform float far_soft = 0.0;       // > 0: fiamme lontane piÃ¹ morbide e meno dettagliate

varying float v_seed;
varying float v_k;

void vertex() {
	vec3 org = MODEL_MATRIX[3].xyz;
	float sx = length(MODEL_MATRIX[0].xyz);
	float sy = length(MODEL_MATRIX[1].xyz);
	v_seed = burn_hash(org.xz * 1.37 + vec2(org.y * 0.71, 3.1));
	float th = 0.05 + v_seed * spread;
	v_k = smoothstep(th, th + 0.25, burn);
	vec3 cam = INV_VIEW_MATRIX[3].xyz;
	vec3 to = cam - org;
	to.y = 0.0;
	vec3 fwd = length(to) > 0.001 ? normalize(to) : vec3(0.0, 0.0, 1.0);
	vec3 right = normalize(cross(vec3(0.0, 1.0, 0.0), fwd));
	float pulse = 0.88 + 0.12 * sin(TIME * (2.6 + v_seed) + v_seed * 20.0);
	float h = sy * v_k * pulse;
	vec3 wp = org + right * VERTEX.x * sx * (0.6 + 0.4 * v_k) + vec3(0.0, VERTEX.y * h, 0.0);
	// la cima ondeggia
	wp += right * sin(TIME * 2.1 + v_seed * 12.0) * 0.1 * VERTEX.y * sx;
	VERTEX = (VIEW_MATRIX * vec4(wp, 1.0)).xyz;
	NORMAL = normalize((VIEW_MATRIX * vec4(fwd, 0.0)).xyz);
}

void fragment() {
	if (v_k <= 0.002) {
		discard;
	}
	float y = 1.0 - UV.y;
	float x = UV.x - 0.5;
	float t = TIME * speed * (0.85 + v_seed * 0.3);
	float n1 = texture(noise_tex, vec2(UV.x * 0.5 + v_seed * 3.1, y * 0.42 - t * 0.85)).r;
	float n2 = texture(noise_tex, vec2(UV.x * 1.25 - v_seed * 1.7, y * 1.05 - t * 1.6)).r;
	float n = mix(n1 * 0.6 + n2 * 0.4, n1, far_soft);
	x += (n - 0.5) * 0.36 * (0.25 + y);
	// goccia: larga in basso, stretta in cima
	float w = 0.44 * pow(max(1.0 - y, 0.0), 0.85) * smoothstep(-0.02, 0.12, y);
	float body = 1.0 - smoothstep(w * 0.4, w, abs(x));
	// lingue: il rumore mangia la parte alta
	float f = body * (1.0 - smoothstep(0.1, 0.95, y * (0.55 + n * 1.25)));
	f = clamp(f * 1.7 - n * 0.5 * y, 0.0, 1.0);
	vec3 c_edge = vec3(0.85, 0.1, 0.015);
	vec3 c_mid = vec3(1.0, 0.42, 0.05);
	vec3 c_core = vec3(1.0, 0.76, 0.3);
	vec3 col = mix(c_edge, c_mid, smoothstep(0.08, 0.42, f));
	col = mix(col, c_core, smoothstep(0.62, 0.95, f) * (1.0 - y * 0.6));
	float a = smoothstep(0.02, 0.22, f) * v_k;
	float near = smoothstep(near_fade * 0.3, near_fade, -VERTEX.z);
	a *= near;
	ALBEDO = col * energy * a;
	ALPHA = clamp(a * opacity, 0.0, 1.0);
}
␀␀␀␀␀␀shader_type spatial;
// Fogliame (fronde di palma, chiome, felci, cespugli, fiori): ritaglio alfa, vento,
// luce che filtra attraverso le foglie. COLOR.rgb = tinta/occlusione, COLOR.a = flessibilitÃ .

render_mode cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap_anisotropic, repeat_disable;
uniform vec4 tint : source_color = vec4(1.0);
uniform float alpha_cut = 0.45;
uniform float tex_size = 512.0;
uniform float wind_strength = 0.12;
uniform float wind_speed = 1.3;
uniform vec3 translucency : source_color = vec3(0.35, 0.5, 0.12);
uniform float roughness = 0.75;
uniform float keep_normals = 0.0;  // 1 = normali sferiche giÃ  nella mesh (non girarle sul retro)
uniform float burn_resist = 0.0;   // Atto 2: quanto resiste al fuoco (fiori: restano rosa)
// impostazioni grafiche (Grafica, "Vegetazione"): quota di piante disegnate; le altre si chiudono
// in un punto (niente pixel da disegnare). Solo erba, felci e fiori, scelte a caso per pianta.
uniform float density = 1.0;

#include "res://shaders/env/burn.gdshaderinc"
#include "res://shaders/env/breeze.gdshaderinc"

varying vec3 b_org;

void vertex() {
	vec3 org = MODEL_MATRIX[3].xyz;
	b_org = org;
	float ph = org.x * 0.137 + org.z * 0.211;
	float flex = COLOR.a;
	float t = TIME * wind_speed;
	float bz = breeze(org, ph);
	float amp = wind_strength * (1.0 + bz * 0.8);
	float s1 = sin(t + ph + VERTEX.y * 0.15) * 0.7 + sin(t * 2.7 + ph * 1.9 + VERTEX.x * 0.6) * 0.3;
	float s2 = sin(t * 1.3 + ph * 0.7 + VERTEX.z * 0.4) * 0.5;
	VERTEX.x += s1 * flex * amp;
	VERTEX.z += s2 * flex * amp * 0.7;
	VERTEX.y += (s1 * 0.5 + 0.5) * flex * amp * 0.25;
	VERTEX += breeze_lean(bz, flex, wind_strength, mat3(MODEL_MATRIX));
	if (density < 0.999 && burn_hash(org.xz * 1.731 + vec2(5.3, 9.1)) > density) {
		VERTEX = vec3(0.0);
	}
}

void fragment() {
	vec4 tx = texture(albedo_tex, UV);
	// le foglie non spariscono da lontano: compensa la perdita di alfa nelle mipmap
	vec2 dx = dFdx(UV * tex_size);
	vec2 dy = dFdy(UV * tex_size);
	float lod = 0.5 * log2(max(dot(dx, dx), dot(dy, dy)));
	float a = tx.a * (1.0 + max(lod, 0.0) * 0.35);
	// ritaglio alfa con antialiasing dei bordi (alpha to coverage con MSAA), niente discard secco
	ALPHA = a;
	ALPHA_SCISSOR_THRESHOLD = alpha_cut;
	ALPHA_ANTIALIASING_EDGE = alpha_cut > 0.0 ? 0.3 : 0.0;
	ALPHA_TEXTURE_COORDINATE = UV * tex_size;
	if (keep_normals > 0.5 && !FRONT_FACING) {
		NORMAL = -NORMAL;
	}
	ALBEDO = tx.rgb * tint.rgb * COLOR.rgb;
	ROUGHNESS = roughness;
	SPECULAR = 0.35;
	BACKLIGHT = translucency * COLOR.rgb;
	if (burn > 0.0) {
		// Atto 2: ogni pianta brucia secondo la macchia in cui sta (piÃ¹ un po' di caso)
		float k = burn * (1.0 - burn_resist);
		float m = clamp(burn_mask(b_org.xz) + (burn_hash(b_org.xz * 3.7) - 0.5) * 0.35, 0.0, 1.0);
		vec3 em;
		ALBEDO = burn_leaf(ALBEDO, m, k, em);
		BACKLIGHT = mix(BACKLIGHT, BACKLIGHT * vec3(1.2, 0.55, 0.2), k) * (1.0 - smoothstep(0.6, 0.9, m) * k);
		// braci sparse sulle foglie carbonizzate
		float sp = smoothstep(0.8, 0.95, burn_vnoise(UV * 7.0 + b_org.xz * 0.37));
		EMISSION = em * sp * 1.4 * burn_flicker(b_org.xz);
	}
}
shader_type spatial;
// Copia di foliage.gdshader (stesso aspetto) con vento a raffiche e terremoto: usata solo
// durante la cinematica d'apertura (vedi wind_sway.gdshaderinc).
// Fogliame (fronde di palma, chiome, felci, cespugli, fiori): ritaglio alfa, vento,
// luce che filtra attraverso le foglie. COLOR.rgb = tinta/occlusione, COLOR.a = flessibilitÃ .

render_mode cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap_anisotropic, repeat_disable;
uniform vec4 tint : source_color = vec4(1.0);
uniform float alpha_cut = 0.45;
uniform float tex_size = 512.0;
uniform float wind_strength = 0.12;
uniform float wind_speed = 1.3;
uniform vec3 translucency : source_color = vec3(0.35, 0.5, 0.12);
uniform float roughness = 0.75;
uniform float keep_normals = 0.0;  // 1 = normali sferiche giÃ  nella mesh (non girarle sul retro)
uniform float burn_resist = 0.0;   // Atto 2: quanto resiste al fuoco (fiori: restano rosa)
// impostazioni grafiche (Grafica, "Vegetazione"): quota di piante disegnate; le altre si chiudono
// in un punto (niente pixel da disegnare). Solo erba, felci e fiori, scelte a caso per pianta.
uniform float density = 1.0;

#include "res://shaders/env/burn.gdshaderinc"
#include "res://shaders/env/breeze.gdshaderinc"

varying vec3 b_org;

#include "res://shaders/env/wind_sway.gdshaderinc"

void vertex() {
	vec3 org = MODEL_MATRIX[3].xyz;
	b_org = org;
	float ph = org.x * 0.137 + org.z * 0.211;
	float flex = COLOR.a;
	float t = TIME * wind_speed;
	float bz = breeze(org, ph);
	float amp = wind_strength * (1.0 + gust * 1.8 + bz * 0.8);
	float s1 = sin(t + ph + VERTEX.y * 0.15) * 0.7 + sin(t * 2.7 + ph * 1.9 + VERTEX.x * 0.6) * 0.3;
	float s2 = sin(t * 1.3 + ph * 0.7 + VERTEX.z * 0.4) * 0.5;
	VERTEX.x += s1 * flex * amp;
	VERTEX.z += s2 * flex * amp * 0.7;
	VERTEX.y += (s1 * 0.5 + 0.5) * flex * amp * 0.25;
	VERTEX += wind_extra(org, ph, flex, wind_strength, mat3(MODEL_MATRIX));
	VERTEX += breeze_lean(bz, flex, wind_strength, mat3(MODEL_MATRIX));
	if (density < 0.999 && burn_hash(org.xz * 1.731 + vec2(5.3, 9.1)) > density) {
		VERTEX = vec3(0.0);
	}
}

void fragment() {
	vec4 tx = texture(albedo_tex, UV);
	// le foglie non spariscono da lontano: compensa la perdita di alfa nelle mipmap
	vec2 dx = dFdx(UV * tex_size);
	vec2 dy = dFdy(UV * tex_size);
	float lod = 0.5 * log2(max(dot(dx, dx), dot(dy, dy)));
	float a = tx.a * (1.0 + max(lod, 0.0) * 0.35);
	// ritaglio alfa con antialiasing dei bordi (alpha to coverage con MSAA), niente discard secco
	ALPHA = a;
	ALPHA_SCISSOR_THRESHOLD = alpha_cut;
	ALPHA_ANTIALIASING_EDGE = alpha_cut > 0.0 ? 0.3 : 0.0;
	ALPHA_TEXTURE_COORDINATE = UV * tex_size;
	if (keep_normals > 0.5 && !FRONT_FACING) {
		NORMAL = -NORMAL;
	}
	ALBEDO = tx.rgb * tint.rgb * COLOR.rgb;
	ROUGHNESS = roughness;
	SPECULAR = 0.35;
	BACKLIGHT = translucency * COLOR.rgb;
	if (burn > 0.0) {
		// Atto 2: ogni pianta brucia secondo la macchia in cui sta (piÃ¹ un po' di caso)
		float k = burn * (1.0 - burn_resist);
		float m = clamp(burn_mask(b_org.xz) + (burn_hash(b_org.xz * 3.7) - 0.5) * 0.35, 0.0, 1.0);
		vec3 em;
		ALBEDO = burn_leaf(ALBEDO, m, k, em);
		BACKLIGHT = mix(BACKLIGHT, BACKLIGHT * vec3(1.2, 0.55, 0.2), k) * (1.0 - smoothstep(0.6, 0.9, m) * k);
		// braci sparse sulle foglie carbonizzate
		float sp = smoothstep(0.8, 0.95, burn_vnoise(UV * 7.0 + b_org.xz * 0.37));
		EMISSION = em * sp * 1.4 * burn_flicker(b_org.xz);
	}
}
␀␀␀␀␀␀␀␀␀// Angel Island: funzioni condivise (roccia stratificata, erba, sabbia).

uniform sampler2D noise_a : hint_default_white, filter_linear_mipmap, repeat_enable;  // rumore morbido senza cuciture
uniform sampler2D noise_b : hint_default_white, filter_linear_mipmap, repeat_enable;  // grana fine

vec3 srgb(vec3 c) { return pow(c, vec3(2.2)); }

float n2(vec2 p) { return texture(noise_a, p).r; }
float g2(vec2 p) { return texture(noise_b, p).r; }

float hash11(float p) {
	p = fract(p * 0.1031);
	p *= p + 33.33;
	p *= p + p;
	return fract(p);
}

// grana triplanare (valore 0..1) per superfici ripide
float tri_grain(vec3 wp, vec3 n, float s) {
	vec3 w = pow(abs(n), vec3(4.0));
	w /= (w.x + w.y + w.z);
	return g2(wp.zy * s) * w.x + g2(wp.xz * s) * w.y + g2(wp.xy * s) * w.z;
}
float tri_soft(vec3 wp, vec3 n, float s) {
	vec3 w = pow(abs(n), vec3(4.0));
	w /= (w.x + w.y + w.z);
	return n2(wp.zy * s) * w.x + n2(wp.xz * s) * w.y + n2(wp.xy * s) * w.z;
}

// tavolozza degli strati di roccia (toni caldi di Angel Island)
vec3 strata_color(float k) {
	float r = hash11(floor(k) * 7.31 + 3.0);
	vec3 c;
	// (un filo piÃ¹ sature e calde: sotto il sole forte i toni chiari diventavano pastello)
	if (r < 0.22) c = vec3(0.88, 0.59, 0.32);        // ocra
	else if (r < 0.42) c = vec3(0.85, 0.45, 0.22);   // arancio
	else if (r < 0.56) c = vec3(0.91, 0.72, 0.46);   // sabbia chiara
	else if (r < 0.72) c = vec3(0.66, 0.34, 0.20);   // bruno rossiccio
	else if (r < 0.88) c = vec3(0.79, 0.53, 0.30);   // tan
	else c = vec3(0.57, 0.36, 0.31);                 // bruno violaceo
	return srgb(c);
}

// roccia: strati orizzontali (con leggera ondulazione) + grana + fessure
vec3 rock_albedo(vec3 wp, vec3 n, out float rough) {
	float warp = (n2(wp.xz * 0.008) - 0.5) * 1.4 + (n2(wp.xz * 0.05 + 0.3) - 0.5) * 0.3;
	float yy = wp.y * 0.42 + warp;
	float band = fract(yy);
	vec3 c = mix(strata_color(yy), strata_color(yy + 1.0), smoothstep(0.86, 1.0, band) * 0.0);
	float gr = tri_soft(wp, n, 0.09);
	float gs = tri_soft(wp, n, 0.025);
	c *= 0.9 + gr * 0.18;
	c = mix(c, c * vec3(0.82, 0.76, 0.88), gs * 0.5);
	// linee morbide tra gli strati (niente fessure stirate: da lontano facevano un codice a barre)
	float edge = smoothstep(0.0, 0.16, band) * smoothstep(1.0, 0.84, band);
	c *= mix(0.78, 1.0, edge);
	rough = 0.88;
	return c;
}

// erba: due verdi tropicali con macchie
vec3 grass_albedo(vec3 wp, float tint) {
	float a = n2(wp.xz * 0.018);
	float b = n2(wp.xz * 0.09 + 0.5);
	float f = g2(wp.xz * 0.6);
	vec3 bright = srgb(vec3(0.36, 0.66, 0.16));
	vec3 deep = srgb(vec3(0.13, 0.42, 0.11));
	vec3 yellowish = srgb(vec3(0.56, 0.70, 0.20));
	vec3 c = mix(deep, bright, smoothstep(0.3, 0.7, a));
	c = mix(c, yellowish, smoothstep(0.62, 0.82, b) * 0.45);
	c = mix(c, deep * 0.85, (1.0 - tint) * 0.25);
	c *= 0.86 + f * 0.26;
	return c;
}

vec3 sand_albedo(vec3 wp) {
	float a = n2(wp.xz * 0.03);
	float f = g2(wp.xz * 0.8);
	// increspature del vento
	float rip = sin(wp.x * 2.2 + wp.z * 0.6 + n2(wp.xz * 0.05) * 9.0) * 0.5 + 0.5;
	// sabbia dorata (piÃ¹ calda di prima: al sole forte la vecchia diventava quasi bianca); il
	// chiaro si ferma un po' sotto il bianco, cosÃ¬ al sole pieno restano visibili grana e increspature
	vec3 c = mix(srgb(vec3(0.81, 0.63, 0.39)), srgb(vec3(0.91, 0.78, 0.54)), a);
	c *= 0.87 + f * 0.16 + rip * 0.08;
	return c;
}

vec3 dirt_albedo(vec3 wp) {
	float a = n2(wp.xz * 0.07);
	float f = g2(wp.xz * 1.1);
	// terra battuta chiara e calda (in ombra la vecchia, piÃ¹ scura, diventava quasi nera)
	vec3 c = mix(srgb(vec3(0.56, 0.37, 0.21)), srgb(vec3(0.72, 0.51, 0.31)), a);
	c *= 0.82 + f * 0.3;
	return c;
}

vec3 paving_albedo(vec3 wp) {
	// lastre di pietra antica degli Echidna
	vec2 q = wp.xz / vec2(2.2, 1.6);
	q.x += floor(q.y) * 0.5;
	vec2 cell = floor(q);
	vec2 f = fract(q);
	float edge = min(min(f.x, 1.0 - f.x) * 2.2, min(f.y, 1.0 - f.y) * 1.6);
	float r = hash11(cell.x * 17.0 + cell.y * 131.0);
	vec3 c = mix(srgb(vec3(0.78, 0.67, 0.48)), srgb(vec3(0.92, 0.83, 0.63)), r);
	c *= 0.88 + g2(wp.xz * 0.5) * 0.22;
	c *= mix(0.62, 1.0, smoothstep(0.02, 0.12, edge));
	return c;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Roccia del cratere infernale della cinematica d'apertura dell'Atto 2 (scripts/cinematic/mk_crater.gd).
// La texture del terreno (crater_tx.png, rossa con i canali di scolo piÃ¹ accesi) dÃ  tre materiali:
//  - roccia: basalto scuro con un filo di rosso, granulosa (rumore in coordinate mondo),
//  - cenere: le creste chiare della texture diventano grigio-rosate e polverose,
//  - vene di lava: i canali rossi e saturi brillano (arancione al centro, rosso ai bordi) e
//    pulsano lenti; piÃ¹ vicino a hot_pos (Metal Knuckles) e con "rage" alta si accendono di piÃ¹.
// Qua e lÃ , sul piano, pozze di lava (macchie rade di rumore grande).

render_mode diffuse_burley, specular_schlick_ggx;

uniform sampler2D tex : source_color, filter_linear_mipmap, repeat_disable;
uniform sampler2D noise_soft : filter_linear_mipmap, repeat_enable;
uniform sampler2D noise_grain : filter_linear_mipmap, repeat_enable;
uniform float lava_energy = 5.0;
uniform float rage = 0.0;                 // 0 calmo .. 1 furioso (vene piÃ¹ larghe e accese)
uniform vec3 hot_pos = vec3(0.0);         // punto locale attorno a cui la lava Ã¨ piÃ¹ viva
uniform float hot_radius = 14.0;
uniform float pools = 1.0;                // quante pozze di lava sul piano (0 nessuna)

varying vec3 lpos;
varying float flat_k;

void vertex() {
	lpos = VERTEX;
	flat_k = smoothstep(0.86, 0.97, NORMAL.y);
}

void fragment() {
	// le soglie sono sui valori della texture cosÃ¬ come si vedono (sRGB): qui torna lineare
	vec3 tx = sqrt(texture(tex, UV).rgb);
	float sat = tx.r - max(tx.g, tx.b);
	float lum = dot(tx, vec3(0.3, 0.59, 0.11));
	vec2 wp = lpos.xz;
	float n1 = texture(noise_soft, wp * 0.045).r;
	float n2 = texture(noise_soft, wp * 0.21 + vec2(0.37, 0.11)).r;
	float gr = texture(noise_grain, wp * 0.9).r;
	float gr2 = texture(noise_grain, wp * 3.7 + vec2(0.5)).r;

	// vicino a Metal Knuckles e con la rabbia le vene si allargano
	float near = exp(-pow(length(lpos - hot_pos) / hot_radius, 2.0));
	float wide = 0.06 * rage + 0.05 * near * (0.4 + rage);
	float vein = smoothstep(0.29 - wide, 0.46 - wide, sat) * (1.0 - smoothstep(0.16, 0.3, tx.g));
	// i canali si spezzano un po' (non tubi perfetti) e respirano
	vein *= smoothstep(0.25, 0.6, n2 + 0.25);
	float pulse = 0.72 + 0.28 * sin(TIME * 1.7 + n1 * 9.0 - length(wp) * 0.25);
	float ash = smoothstep(0.32, 0.55, min(tx.g, tx.b) + 0.08 * (n2 - 0.5));

	// roccia: basalto scuro, rosso spento nei solchi
	vec3 rock = mix(vec3(0.07, 0.055, 0.052), vec3(0.19, 0.1, 0.08), smoothstep(0.02, 0.35, lum));
	rock *= 0.65 + 0.5 * gr * (0.6 + 0.4 * gr2);
	rock = mix(rock, rock * vec3(1.35, 0.7, 0.6), clamp(sat * 1.6, 0.0, 1.0));
	vec3 ashc = vec3(0.32, 0.27, 0.26) * (0.75 + 0.35 * gr);
	vec3 col = mix(rock, ashc, ash * 0.85);
	// crosta scura attorno alle vene (lava raffreddata)
	float crust = smoothstep(0.18, 0.3, sat) * (1.0 - vein);
	col *= 1.0 - 0.45 * crust;

	// pozze: macchie rade sul piano, col bordo frastagliato
	float pn = texture(noise_soft, wp * 0.03 + vec2(0.73, 0.21)).r + (n2 - 0.5) * 0.1;
	float pool = smoothstep(0.75, 0.78, pn) * flat_k * pools;

	float hot = clamp(vein + pool * 0.8, 0.0, 1.0);
	vec3 lava = mix(vec3(0.9, 0.08, 0.01), vec3(1.0, 0.42, 0.06), smoothstep(0.35, 0.95, hot));
	lava = mix(lava, vec3(1.0, 0.78, 0.35), smoothstep(0.85, 1.0, hot) * near);
	float e = hot * pulse * lava_energy * (0.55 + 0.45 * rage + 0.8 * near * (0.3 + rage));

	ALBEDO = mix(col, vec3(0.05, 0.01, 0.0), hot * 0.9);
	ROUGHNESS = mix(0.82 - 0.2 * gr2, 0.95, ash) * (1.0 - 0.3 * hot);
	SPECULAR = 0.35;
	EMISSION = lava * e;
	// micro-rilievo dal rumore fine (la mesh Ã¨ liscia a questa scala)
	vec3 bump = vec3(gr2 - 0.5, 0.0, gr - 0.5) * 0.35 * (1.0 - hot);
	NORMAL = normalize(NORMAL + (VIEW_MATRIX * vec4(bump, 0.0)).xyz);
}
␀␀␀shader_type spatial;
// Cielo del cratere infernale (scripts/cinematic/mk_crater.gd): una sfera grande vista da dentro.
// Nubi di cenere che vorticano lente, illuminate da sotto dal bagliore della lava (arancione
// vicino all'orizzonte, quasi nero allo zenit), un sole nero eclissato con la corona rossa e i
// lampi (flash) che accendono le nubi.

render_mode unshaded, cull_front, depth_draw_never, fog_disabled, shadows_disabled;

uniform sampler2D clouds : filter_linear_mipmap, repeat_enable;
uniform vec3 sun_dir = vec3(0.35, 0.42, -0.84);
uniform float flash = 0.0;
uniform float spin = 0.004;

varying vec3 dir;

void vertex() {
	dir = normalize(VERTEX);
}

void fragment() {
	vec3 d = normalize(dir);
	float h = d.y;
	// coordinate delle nubi: proiezione sul piano del cielo, che gira piano attorno allo zenit
	float a = TIME * spin;
	mat2 r = mat2(vec2(cos(a), sin(a)), vec2(-sin(a), cos(a)));
	vec2 p = r * (d.xz / (max(h, 0.0) + 0.18));
	float c1 = texture(clouds, p * 0.22 + vec2(TIME * 0.006, 0.0)).r;
	float c2 = texture(clouds, p * 0.6 - vec2(0.0, TIME * 0.011)).r;
	float c = smoothstep(0.3, 0.85, c1 * 0.65 + c2 * 0.45);

	float glow = exp(-max(h, 0.0) * 5.0);            // bagliore della lava sull'orizzonte
	vec3 top = vec3(0.016, 0.006, 0.006);
	vec3 low = vec3(0.42, 0.07, 0.025);
	vec3 col = mix(top, low, glow);
	// nubi: scure, col bordo inferiore acceso dal fuoco
	vec3 cloud_lit = vec3(0.7, 0.16, 0.04) * (0.25 + 0.75 * glow);
	col = mix(col, mix(vec3(0.03, 0.012, 0.01), cloud_lit, smoothstep(0.35, 1.0, c2) * (0.4 + glow)), c * 0.85);

	// sole nero con la corona
	float sd = acos(clamp(dot(d, normalize(sun_dir)), -1.0, 1.0));
	float disc = 1.0 - smoothstep(0.075, 0.08, sd);
	float corona = exp(-max(sd - 0.078, 0.0) * 34.0) * (1.0 - disc);
	float rays = 0.6 + 0.4 * sin(atan(d.x - sun_dir.x, d.y - sun_dir.y) * 23.0 + TIME * 0.3);
	col += vec3(2.4, 0.5, 0.12) * corona * rays * (1.0 - c * 0.6);
	col = mix(col, vec3(0.0), disc * (1.0 - c * 0.5));

	// lampi: le nubi si accendono di un bianco caldo
	col += vec3(1.4, 0.75, 0.6) * flash * (0.25 + c * 1.2) * smoothstep(-0.1, 0.4, h);
	// sotto l'orizzonte (dietro i bordi del cratere): rosso scuro uniforme
	col = mix(col, vec3(0.18, 0.03, 0.012), smoothstep(0.0, -0.15, h));
	ALBEDO = col;
}
␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Massi e rocce sparse: stessa roccia stratificata delle scogliere, muschio sulle facce in alto.

render_mode diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/island_common.gdshaderinc"
#include "res://shaders/env/burn.gdshaderinc"

uniform float moss = 0.6;

varying vec3 wpos;
varying vec3 wnrm;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wnrm);
	float rr;
	vec3 c = rock_albedo(wpos, n, rr);
	float m = smoothstep(0.55, 0.85, n.y + (n2(wpos.xz * 0.2) - 0.5) * 0.5) * moss;
	vec3 mg = grass_albedo(wpos, 0.3) * 0.8;
	if (burn > 0.0) {
		// Atto 2: muschio bruciato e fuliggine
		float bm = burn_mask(wpos.xz);
		vec3 em;
		mg = burn_ground(mg, bm, burn, 0.5, em);
		c = mix(c, c * vec3(0.55, 0.5, 0.46), burn * (0.3 + 0.5 * bm));
	}
	c = mix(c, mg, m);
	ALBEDO = c * COLOR.rgb;
	ROUGHNESS = rr;
	SPECULAR = 0.3;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type sky;
// Cielo del mattino di Angel Island: gradiente blu intenso (come nei Sonic moderni), foschia
// chiara e azzurra all'orizzonte, alone caldo del sole e cumuli grandi e morbidi.

uniform vec3 zenith : source_color = vec3(0.02, 0.20, 0.78);
uniform vec3 mid : source_color = vec3(0.12, 0.45, 0.95);
uniform vec3 horizon : source_color = vec3(0.62, 0.86, 1.0);
uniform vec3 sea_far : source_color = vec3(0.28, 0.58, 0.82);
uniform vec3 sun_glow : source_color = vec3(1.0, 0.84, 0.58);
uniform float sun_size = 0.9997;
uniform sampler2D cloud_noise : filter_linear_mipmap, repeat_enable;
uniform float cloud_cover = 0.5;
uniform float cloud_scale = 0.22;
// scorrimento delle nuvole col vento (unitÃ  della texture al secondo); il dettaglio scorre a
// velocitÃ  diverse, cosÃ¬ i cumuli cambiano forma piano mentre passano. "vento" (globale) lo
// spengono le impostazioni grafiche (Cielo animato: nuvole ferme).
uniform float cloud_speed = 0.004;
global uniform float vento;
// Atto 2: cielo della foresta in fiamme (0 = mattino azzurro, 1 = rosso-arancio pieno di fumo)
uniform float burn = 0.0;
uniform vec3 burn_zenith : source_color = vec3(0.16, 0.035, 0.03);
uniform vec3 burn_mid : source_color = vec3(0.62, 0.12, 0.03);
uniform vec3 burn_horizon : source_color = vec3(1.0, 0.46, 0.1);
uniform vec3 burn_smoke : source_color = vec3(0.13, 0.08, 0.07);

// masse grandi a bassa frequenza (cumuli interi, non batuffoli sparsi) e due ottave di dettaglio
// che lavorano soprattutto sui bordi
float clouds(vec2 uv, float tm) {
	float a = texture(cloud_noise, uv * 0.6).r;
	float b = texture(cloud_noise, uv * 1.9 + vec2(0.31, 0.77) + vec2(tm * 0.9, tm * 0.35)).r;
	float c = texture(cloud_noise, uv * 4.7 + vec2(0.13, 0.41) + vec2(tm * 2.2, -tm * 0.6)).r;
	return a * 0.64 + b * 0.24 + c * 0.12;
}

void sky() {
	vec3 d = normalize(EYEDIR);
	float y = d.y;
	vec3 col;
	if (y >= 0.0) {
		float t1 = pow(clamp(y, 0.0, 1.0), 0.45);
		col = mix(horizon, mid, smoothstep(0.0, 0.35, t1));
		col = mix(col, zenith, smoothstep(0.3, 1.0, t1));
	} else {
		col = mix(horizon, sea_far, smoothstep(0.0, -0.06, y));
	}
	vec3 L = LIGHT0_DIRECTION;
	float sd = dot(d, L);
	// alone del sole: ampio e caldo, piÃ¹ stretto e chiaro vicino al disco
	col += sun_glow * (pow(max(sd, 0.0), 8.0) * 0.28 + pow(max(sd, 0.0), 64.0) * 0.45);
	col = mix(col, col * vec3(1.05, 0.98, 0.9), (1.0 - smoothstep(0.0, 0.25, abs(y))) * 0.3 * max(sd * 0.5 + 0.5, 0.0));
	if (!AT_CUBEMAP_PASS && sd > sun_size) {
		col += vec3(6.0, 5.4, 4.4) * smoothstep(sun_size, sun_size + 0.0001, sd);
	}
	if (burn > 0.0) {
		// cielo rosso del fuoco: arancio acceso all'orizzonte (le fiamme dietro la giungla), rosso
		// cupo in alto; il sole Ã¨ un disco arancione velato dal fumo
		float t1 = pow(clamp(y, 0.0, 1.0), 0.5);
		vec3 bc = mix(burn_horizon * 1.05, burn_mid, smoothstep(0.0, 0.32, t1));
		bc = mix(bc, burn_zenith, smoothstep(0.28, 0.95, t1));
		if (y < 0.0) {
			bc = mix(burn_horizon * 1.1, burn_mid * 0.45, smoothstep(0.0, -0.12, y));
		}
		// bagliore delle fiamme lontane: pulsa piano lungo l'orizzonte
		float az = atan(d.z, d.x);
		float glow = (0.75 + 0.25 * sin(az * 5.0 + TIME * 0.7) * sin(az * 3.0 - TIME * 0.45)) * (1.0 - smoothstep(0.0, 0.18, abs(y)));
		bc += vec3(1.0, 0.32, 0.04) * glow * 0.45;
		bc += vec3(1.0, 0.45, 0.12) * pow(max(sd, 0.0), 10.0) * 0.5;
		if (!AT_CUBEMAP_PASS) {
			bc += vec3(2.2, 0.75, 0.15) * smoothstep(sun_size - 0.0002, sun_size + 0.0001, sd);
		}
		col = mix(col, bc, burn);
	}
	// cumuli
	if (y > 0.0) {
		float tm = TIME * cloud_speed * vento;
		vec2 uv = d.xz / (y + 0.12) * cloud_scale + vec2(tm, tm * 0.25);
		float c = clouds(uv, tm);
		float dens = smoothstep(cloud_cover, cloud_cover + 0.16, c);
		// luce: campione spostato verso il sole
		vec2 toward = normalize(L.xz + vec2(0.0001)) * 0.03;
		float c2 = clouds(uv + toward, tm);
		float lit = clamp((c - c2) * 6.0 + 0.62, 0.0, 1.0);
		// spessore: il cuore del cumulo Ã¨ appena piÃ¹ grigio-azzurro, i bordi sottili bianchi
		float thick = smoothstep(cloud_cover + 0.1, cloud_cover + 0.32, c);
		vec3 cl = mix(vec3(0.66, 0.74, 0.88), vec3(1.0, 0.99, 0.96), lit);
		cl = mix(cl, cl * vec3(0.9, 0.93, 0.98), thick * (1.0 - lit) * 0.6);
		cl += sun_glow * pow(max(sd, 0.0), 6.0) * 0.4 * (1.0 - dens);
		float fade = smoothstep(0.02, 0.2, y);
		if (burn > 0.0) {
			// le nuvole diventano fumo: piÃ¹ fitte, scure, illuminate di arancio dal basso
			float dens_b = smoothstep(cloud_cover - 0.2, cloud_cover + 0.1, c);
			vec3 sm = mix(burn_smoke, burn_smoke * 2.6 + vec3(0.3, 0.08, 0.0), lit * 0.5);
			sm += vec3(0.9, 0.25, 0.02) * (1.0 - smoothstep(0.02, 0.35, y)) * (1.0 - thick) * 0.6;
			cl = mix(cl, sm, burn);
			dens = mix(dens, dens_b, burn);
			fade = mix(fade, smoothstep(0.0, 0.1, y), burn);
		}
		col = mix(col, cl, dens * fade * 0.97);
	}
	COLOR = col;
}
␀␀shader_type spatial;
// Colonne di fumo della foresta che brucia (Angel Island Atto 2). Ogni istanza Ã¨ uno sbuffo di una
// colonna: l'origine dell'istanza Ã¨ la base della colonna, la scala x la grandezza dello sbuffo e
// la scala y l'altezza della colonna. Lo sbuffo sale in loop (fase diversa per istanza), si
// allarga, va col vento e svanisce; in basso Ã¨ illuminato dal fuoco, in alto Ã¨ fumo scuro.
// Si vede solo con la foresta in fiamme ("burn").

render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled, skip_vertex_transform;

#include "res://shaders/env/burn.gdshaderinc"

uniform sampler2D puff : source_color, filter_linear_mipmap, repeat_disable;
uniform vec3 smoke_dark : source_color = vec3(0.075, 0.06, 0.058);
uniform vec3 smoke_lit : source_color = vec3(0.72, 0.29, 0.08);
uniform float opacity = 0.72;
uniform float rise = 0.045;          // giri di vita al secondo
uniform vec2 wind = vec2(0.35, 0.12); // spostamento in cima, in frazioni dell'altezza

varying float v_life;
varying float v_a;
varying float v_rot;

void vertex() {
	vec3 org = MODEL_MATRIX[3].xyz;
	float size = length(MODEL_MATRIX[0].xyz);
	float hcol = length(MODEL_MATRIX[1].xyz);
	float seed = burn_hash(org.xz * 0.91 + vec2(org.y * 1.3, 7.7));
	float k = smoothstep(0.25 + seed * 0.3, 0.6 + seed * 0.3, burn);
	float life = fract(TIME * rise * (0.8 + seed * 0.4) + seed * 7.0);
	v_life = life;
	vec3 c = org + vec3(wind.x, 1.0, wind.y) * hcol * life + vec3(sin(seed * 40.0), 0.0, cos(seed * 40.0)) * size * 0.3 * life;
	float s = size * (0.45 + life * 1.3);
	vec3 cam = INV_VIEW_MATRIX[3].xyz;
	vec3 fwd = normalize(cam - c);
	vec3 right = normalize(cross(vec3(0.0, 1.0, 0.0), fwd));
	vec3 up = cross(fwd, right);
	float r = seed * 6.28 + TIME * 0.05 * (seed - 0.5);
	v_rot = r;
	vec2 q = VERTEX.xy * s;
	vec3 wp = c + right * q.x + up * q.y;
	VERTEX = (VIEW_MATRIX * vec4(wp, 1.0)).xyz;
	NORMAL = normalize((VIEW_MATRIX * vec4(fwd, 0.0)).xyz);
	v_a = k * smoothstep(0.0, 0.12, life) * (1.0 - smoothstep(0.55, 1.0, life));
}

void fragment() {
	if (v_a <= 0.002) {
		discard;
	}
	vec2 uv = UV - 0.5;
	uv = mat2(vec2(cos(v_rot), sin(v_rot)), vec2(-sin(v_rot), cos(v_rot))) * uv + 0.5;
	vec4 t = texture(puff, uv);
	float lum = dot(t.rgb, vec3(0.333));
	// in basso il riflesso del fuoco, in alto fumo scuro
	vec3 col = mix(smoke_lit * (0.5 + lum * 0.6), smoke_dark * (0.6 + lum * 0.6), smoothstep(0.0, 0.25, v_life));
	float near = smoothstep(1.0, 6.0, -VERTEX.z);
	ALBEDO = col;
	ALPHA = clamp(t.a * v_a * opacity * near, 0.0, 1.0);
}
shader_type spatial;
// Schiuma ribollente alla base della cascata (disco sull'acqua della laguna).

render_mode blend_mix, cull_disabled, depth_draw_never, diffuse_burley;

uniform sampler2D foam_noise : hint_default_white, filter_linear_mipmap, repeat_enable;

void fragment() {
	vec2 c = UV * 2.0 - 1.0;
	float r = length(c);
	float a = atan(c.y, c.x);
	float t = TIME;
	float n1 = texture(foam_noise, vec2(a * 0.6, r * 1.5 - t * 0.35)).r;
	float n2 = texture(foam_noise, UV * 3.0 + vec2(t * 0.05, -t * 0.08)).r;
	float rings = sin(r * 18.0 - t * 4.0) * 0.5 + 0.5;
	float f = n1 * 0.55 + n2 * 0.45 + rings * 0.15;
	float mask = 1.0 - smoothstep(0.35, 1.0, r);
	float foam = smoothstep(0.35, 0.65, f * (0.6 + mask * 0.8)) * mask;
	ALBEDO = vec3(0.96, 0.99, 1.0);
	EMISSION = vec3(0.08);
	ROUGHNESS = 0.7;
	ALPHA = foam * 0.95;
}
␀shader_type spatial;
render_mode cull_disabled;
// La scritta CASINO (cst_cajino11): nel gioco le lettere hanno la faccia davanti color crema e i
// fianchi a righe blu; il file ha una sola immagine (le righe blu) per tutte le facce. Le facce
// rivolte verso la piazza (dal centro della tettoia in fuori) diventano crema.
uniform sampler2D tex : source_color, filter_linear_mipmap;
uniform vec2 center = vec2(-61.85, 90.6);
uniform vec3 face_col : source_color = vec3(0.66, 0.63, 0.4);
varying vec3 wpos;
varying vec3 wnrm;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec2 radial = normalize(wpos.xz - center);
	float front = abs(dot(normalize(wnrm.xz + vec2(1e-4)), radial)) * (1.0 - abs(wnrm.y));
	vec3 side = texture(tex, UV).rgb * 1.4;
	ALBEDO = mix(side, face_col, step(0.7, front));
	ROUGHNESS = 0.5;
	METALLIC = 0.15;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Acqua di Station Square (tools/build_station_square.gd): turchese e trasparente come in Sonic
// Adventure. La texture dell'acqua del modello (sswater00, ...) che scorre, i riflessi del sole
// (mappa di normali) e, dove l'acqua Ã¨ bassa, il fondale che si vede sotto (si legge la profonditÃ 
// della scena dietro l'acqua): piÃ¹ Ã¨ fonda, piÃ¹ Ã¨ turchese pieno.

render_mode blend_mix, depth_draw_always, cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform sampler2D tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D normal_tex : hint_normal, filter_linear_mipmap, repeat_enable;
uniform sampler2D depth_tex : hint_depth_texture, filter_linear;
uniform vec2 scroll = vec2(0.006, 0.003);
uniform bool world_uv = true;               // UV = xz del mondo / tile
uniform float tile = 12.8;
uniform vec3 tint : source_color = vec3(0.38, 0.8, 0.88);   // moltiplica la texture (piÃ¹ chiara)
uniform vec3 deep_col : source_color = vec3(0.0, 0.36, 0.55);
uniform vec3 horizon_col : source_color = vec3(0.45, 0.72, 0.92);
uniform float fade_start = 250.0;
uniform float fade_end = 1400.0;
uniform float glint = 0.7;
uniform float rough = 0.08;
uniform float clear_depth = 4.0;            // metri d'acqua dopo cui non si vede piÃ¹ il fondo
uniform float min_alpha = 0.25;
// col renderer Compatibility (OpenGL) la profonditÃ  va da -1 a 1: lo imposta level_af.gd
uniform bool gl_depth = false;

varying vec3 wpos;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 uv = world_uv ? wpos.xz / tile : UV;
	uv += scroll * TIME;
	vec3 col = texture(tex, uv).rgb * tint;
	vec2 nuv = wpos.xz * 0.11;
	vec3 n1 = texture(normal_tex, nuv + vec2(TIME * 0.021, TIME * 0.013)).rgb;
	vec3 n2 = texture(normal_tex, nuv * 1.7 + vec2(-TIME * 0.017, TIME * 0.024)).rgb;
	NORMAL_MAP = mix(vec3(0.5, 0.5, 1.0), normalize(n1 + n2 - 1.0) * 0.5 + 0.5, glint);
	// profonditÃ  dell'acqua sotto questo punto (lungo il raggio della vista)
	float zd = texture(depth_tex, SCREEN_UV).r;
	if (gl_depth) {
		zd = zd * 2.0 - 1.0;
	}
	vec4 vp = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, zd, 1.0);
	vp.xyz /= vp.w;
	float thick = max(0.0, -vp.z + VERTEX.z);
	float deep = smoothstep(0.0, clear_depth, thick);
	col = mix(col, deep_col, deep * 0.55);
	float d = length(wpos - CAMERA_POSITION_WORLD);
	float far = smoothstep(fade_start, fade_end, d);
	ALBEDO = mix(col, horizon_col, far);
	ALPHA = clamp(mix(min_alpha, 1.0, deep) + far, 0.0, 1.0);
	ROUGHNESS = rough;
	SPECULAR = 0.6;
}
␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Pietra delle rovine degli Echidna: blocchi squadrati (UV in metri), muschio sulle facce
// in alto, glifi incisi turchesi dove COLOR.a > 0.5. COLOR.rgb = occlusione/tinta.

render_mode diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/island_common.gdshaderinc"

uniform vec3 stone_a : source_color = vec3(0.78, 0.72, 0.62);
uniform vec3 stone_b : source_color = vec3(0.62, 0.58, 0.52);
uniform vec3 glyph_col : source_color = vec3(0.15, 0.85, 0.75);
uniform float glyph_glow = 1.6;
uniform float glyph_scale = 2.6;
uniform float block_w = 1.6;
uniform float block_h = 0.8;
uniform float moss_amount = 0.55;

varying vec3 wpos;
varying vec3 wnrm;

float glyph(vec2 uv) {
	// motivi geometrici: cerchi concentrici e rombi in celle da 1 m
	vec2 c = fract(uv) - 0.5;
	vec2 id = floor(uv);
	float r = hash11(id.x * 13.0 + id.y * 71.0);
	// solo una cella su tre porta un glifo
	if (hash11(id.x * 29.0 + id.y * 7.0 + 11.0) > 0.42) {
		return 0.0;
	}
	float d;
	if (r < 0.33) {
		d = abs(length(c) - 0.22);
	} else if (r < 0.66) {
		d = abs(abs(c.x) + abs(c.y) - 0.24);
	} else {
		d = max(abs(abs(c.x) - 0.12), abs(c.y) - 0.2);
	}
	return 1.0 - smoothstep(0.02, 0.045, d);
}

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wnrm);
	vec2 q = UV / vec2(block_w, block_h);
	q.x += floor(q.y) * 0.5;
	vec2 cell = floor(q);
	vec2 f = fract(q);
	float edge = min(min(f.x, 1.0 - f.x) * block_w, min(f.y, 1.0 - f.y) * block_h);
	float r = hash11(cell.x * 7.0 + cell.y * 113.0 + 5.0);
	vec3 c = mix(stone_b, stone_a, r * 0.7 + 0.3 * tri_soft(wpos, n, 0.15));
	c *= 0.82 + tri_grain(wpos, n, 0.6) * 0.25;
	c *= mix(0.5, 1.0, smoothstep(0.02, 0.09, edge));
	// macchie scure e muschio
	float wear = tri_soft(wpos, n, 0.05);
	c = mix(c, c * vec3(0.7, 0.72, 0.68), smoothstep(0.55, 0.8, wear) * 0.6);
	float m = smoothstep(0.5, 0.9, n.y + (tri_soft(wpos, n, 0.3) - 0.5) * 0.8) * moss_amount;
	m = max(m, smoothstep(0.62, 0.85, wear) * 0.35 * moss_amount);
	c = mix(c, grass_albedo(wpos, 0.3) * 0.75, m);
	vec3 em = vec3(0.0);
	if (COLOR.a > 0.5) {
		float g = glyph(UV * glyph_scale);
		// incisi: scuri nel solco, un filo di luce
		c = mix(c, c * 0.45, g);
		em = glyph_col * g * glyph_glow;
	}
	ALBEDO = c * COLOR.rgb;
	EMISSION = em;
	ROUGHNESS = 0.85;
	SPECULAR = 0.35;
}
␀shader_type sky;
// Cielo del tramonto (scena all'Eggmanland): arancione acceso e oro attorno al sole basso sul mare,
// rosa e viola salendo, blu-viola cupo allo zenit dalla parte opposta; nuvole lunghe e basse
// illuminate da sotto (ventre arancio-rosa, bordi d'oro verso il sole, grigio-viola in ombra).
// Stessa texture di rumore del cielo di Angel Island (cloud_noise) e stesso vento globale.

uniform vec3 zenith : source_color = vec3(0.16, 0.12, 0.36);
uniform vec3 mid : source_color = vec3(0.95, 0.44, 0.26);
uniform vec3 horizon : source_color = vec3(1.0, 0.6, 0.22);
uniform vec3 horizon_away : source_color = vec3(0.95, 0.5, 0.34);  // orizzonte dalla parte opposta al sole
uniform vec3 sea_far : source_color = vec3(0.42, 0.24, 0.22);
uniform vec3 sun_glow : source_color = vec3(1.0, 0.62, 0.22);
uniform float sun_size = 0.99935;
uniform sampler2D cloud_noise : filter_linear_mipmap, repeat_enable;
uniform float cloud_cover = 0.52;
uniform float cloud_scale = 0.16;
uniform float cloud_speed = 0.003;
global uniform float vento;

float clouds(vec2 uv, float tm) {
	float a = texture(cloud_noise, uv * 0.6).r;
	float b = texture(cloud_noise, uv * 1.9 + vec2(0.31, 0.77) + vec2(tm * 0.9, tm * 0.35)).r;
	float c = texture(cloud_noise, uv * 4.7 + vec2(0.13, 0.41) + vec2(tm * 2.2, -tm * 0.6)).r;
	return a * 0.64 + b * 0.24 + c * 0.12;
}

void sky() {
	vec3 d = normalize(EYEDIR);
	float y = d.y;
	vec3 L = LIGHT0_DIRECTION;
	float sd = dot(d, L);
	// quanto si guarda verso il sole (in pianta): l'orizzonte Ã¨ oro da quella parte, rosa dall'altra
	float toward = clamp(dot(normalize(d.xz + vec2(0.0001)), normalize(L.xz + vec2(0.0001))) * 0.5 + 0.5, 0.0, 1.0);
	vec3 hz = mix(horizon_away, horizon, pow(toward, 1.6));
	vec3 col;
	if (y >= 0.0) {
		float t1 = pow(clamp(y, 0.0, 1.0), 0.5);
		col = mix(hz, mid, smoothstep(0.0, 0.32, t1));
		// verso lo zenit: dall'arancio al viola passando per un rosa caldo
		col = mix(col, mix(mid, zenith, 0.45) * vec3(1.0, 0.82, 1.05), smoothstep(0.45, 0.75, t1));
		col = mix(col, zenith, smoothstep(0.72, 1.0, t1));
	} else {
		col = mix(hz, sea_far, smoothstep(0.0, -0.08, y));
	}
	// alone del sole: largo e arancione, piÃ¹ stretto e giallo vicino al disco
	col += sun_glow * (pow(max(sd, 0.0), 6.0) * 0.5 + pow(max(sd, 0.0), 48.0) * 0.8);
	col += vec3(1.0, 0.85, 0.5) * pow(max(sd, 0.0), 400.0) * 1.2;
	if (!AT_CUBEMAP_PASS && sd > sun_size) {
		col += vec3(4.0, 2.3, 0.8) * smoothstep(sun_size, sun_size + 0.00012, sd);
	}
	if (y > 0.0) {
		float tm = TIME * cloud_speed * vento;
		// nuvole schiacciate e allungate (strati del tramonto)
		vec2 uv = d.xz / (y + 0.08) * cloud_scale * vec2(1.0, 2.2) + vec2(tm, tm * 0.25);
		float c = clouds(uv, tm);
		float dens = smoothstep(cloud_cover, cloud_cover + 0.18, c);
		vec2 tw = normalize(L.xz + vec2(0.0001)) * 0.03;
		float c2 = clouds(uv + tw, tm);
		float lit = clamp((c - c2) * 6.0 + 0.5, 0.0, 1.0);
		float thick = smoothstep(cloud_cover + 0.1, cloud_cover + 0.32, c);
		vec3 shade = mix(vec3(0.36, 0.22, 0.34), vec3(0.62, 0.32, 0.36), toward);
		vec3 cl = mix(shade, vec3(1.0, 0.55, 0.32), lit * (0.55 + 0.45 * toward));
		cl = mix(cl, cl * 0.82, thick * (1.0 - lit) * 0.5);
		// bordi d'oro verso il sole
		cl += vec3(1.0, 0.7, 0.3) * pow(max(sd, 0.0), 5.0) * (1.0 - thick) * 0.9;
		float fade = smoothstep(0.015, 0.16, y);
		col = mix(col, cl, dens * fade * 0.95);
	}
	COLOR = col;
}
␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Terreno di Angel Island: erba / sabbia / terra / roccia stratificata / lastre, miscelati
// per pendenza e per le maschere dipinte dal generatore (COLOR = sabbia, sentiero, pietra, tinta).

render_mode diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/island_common.gdshaderinc"
#include "res://shaders/env/burn.gdshaderinc"

uniform float sea_level = -1.0;
uniform float wet_band = 0.55;

varying vec3 wpos;
varying vec3 wnrm;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = normalize(wnrm);
	float slope = n.y;
	float sand_m = COLOR.r;
	float path_m = COLOR.g;
	float stone_m = COLOR.b;
	float tint = COLOR.a;

	float jitter = (n2(wpos.xz * 0.11) - 0.5) * 0.16;
	float rock_w = 1.0 - smoothstep(0.58 + jitter, 0.74 + jitter, slope);

	float rr;
	vec3 rock = rock_albedo(wpos, n, rr);
	vec3 grass = grass_albedo(wpos, tint);
	// bordo piÃ¹ scuro dove l'erba piega verso la scogliera (stile S3)
	float rim = smoothstep(0.93, 0.78, slope) * (1.0 - rock_w);
	grass = mix(grass, srgb(vec3(0.07, 0.28, 0.08)), rim * 0.75);
	// Atto 2: erba bruciata a chiazze (ocra, cenere con le braci), parti ancora verdi
	vec3 ember = vec3(0.0);
	float bm = 0.0;
	if (burn > 0.0) {
		bm = clamp(burn_mask(wpos.xz) + (n2(wpos.xz * 0.06) - 0.5) * 0.5, 0.0, 1.0);
		grass = burn_ground(grass, bm, burn, g2(wpos.xz * 0.35), ember);
	}

	vec3 sand = sand_albedo(wpos);
	float wet = 1.0 - smoothstep(sea_level + 0.15, sea_level + wet_band, wpos.y);
	sand = mix(sand, sand * vec3(0.5, 0.45, 0.38), wet);
	vec3 dirt = dirt_albedo(wpos);
	vec3 pave = paving_albedo(wpos);

	// passaggio erba/sabbia frastagliato
	// bordo sabbia/erba morbido e ondulato (rumore a bassa frequenza, non la grana fine)
	float sm = smoothstep(0.3, 0.7, sand_m + (n2(wpos.xz * 0.045) - 0.5) * 0.7);
	float pm = smoothstep(0.3, 0.7, path_m + (g2(wpos.xz * 0.5) - 0.5) * 0.45);
	float stm = smoothstep(0.4, 0.6, stone_m);

	vec3 c = grass;
	float rough = 0.92;
	c = mix(c, dirt, pm);
	c = mix(c, sand, sm);
	rough = mix(rough, mix(0.86, 0.35, wet), sm);
	c = mix(c, pave, stm);
	c = mix(c, rock, rock_w);
	rough = mix(rough, rr, rock_w);

	// sotto il livello del mare: sabbia piÃ¹ fredda (la colora l'acqua)
	float under = 1.0 - smoothstep(sea_level - 0.6, sea_level, wpos.y);
	c = mix(c, c * vec3(0.85, 0.95, 0.95), under);
	if (burn > 0.0) {
		// fuliggine sulla terra e sulla roccia, braci solo nell'erba bruciata
		c = mix(c, c * vec3(0.62, 0.55, 0.5), burn * smoothstep(0.35, 0.9, bm) * max(pm, rock_w) * 0.8);
		// sentiero coperto di cenere: meno saturo (sotto la luce arancione diventava rosso acceso)
		float lum_c = dot(c, vec3(0.3, 0.59, 0.11));
		c = mix(c, vec3(lum_c) * vec3(1.04, 0.96, 0.9), burn * pm * 0.5);
		float grass_w = (1.0 - pm) * (1.0 - sm) * (1.0 - stm) * (1.0 - rock_w);
		EMISSION = ember * grass_w * 1.3 * burn_flicker(wpos.xz);
	}

	ALBEDO = c;
	ROUGHNESS = rough;
	SPECULAR = 0.35;
}
␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Acqua di Angel Island (mare, laguna, fiume) in stile Sonic Adventure / Generations: onde nel
// vertex shader, colore secondo la profonditÃ  reale (DEPTH_TEXTURE), schiuma a riva che va e
// viene, rifrazione, caustiche che danzano sul fondo dove l'acqua Ã¨ bassa, reticolo di riflessi
// che scorre sul pelo, luccichii del sole, schiuma che scorre col fiume.
// Da sotto (telecamera sott'acqua) il pelo Ã¨ la "finestra" sul cielo con il riflesso totale ai
// bordi (lato posteriore delle facce, FRONT_FACING falso).

render_mode blend_mix, depth_draw_always, cull_disabled, diffuse_burley, specular_schlick_ggx;

#include "res://shaders/env/water_common.gdshaderinc"

uniform sampler2D depth_tex : hint_depth_texture, filter_linear_mipmap;
uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap;
uniform sampler2D normal_a : hint_normal, filter_linear_mipmap, repeat_enable;
uniform sampler2D foam_noise : hint_default_white, filter_linear_mipmap, repeat_enable;

uniform vec3 shallow_col : source_color = vec3(0.30, 0.95, 0.86);
uniform vec3 deep_col : source_color = vec3(0.02, 0.32, 0.52);
uniform vec3 far_col : source_color = vec3(0.05, 0.38, 0.60);
uniform float clarity = 0.28;          // quanto in fretta l'acqua diventa opaca
uniform float wave_amp = 0.18;
uniform float wave_len = 18.0;
uniform float normal_scale = 0.06;
uniform float normal_strength = 0.55;
uniform float foam_dist = 0.9;
uniform float foam_amount = 1.0;
uniform vec2 flow = vec2(0.6, 0.25);   // m/s nello spazio mondo (mare) o in UV (fiume)
uniform bool flow_in_uv = false;
uniform float far_fade = 900.0;
uniform vec2 island_center = vec2(-20.0, -100.0);
// --- stile Sonic
uniform vec3 sun_dir = vec3(0.70, 0.56, 0.44);   // verso il sole (sky_water.gd, SUN_DIR)
uniform float caustic_amount = 1.0;   // luce che danza sul fondo, dove l'acqua Ã¨ bassa
uniform float caustic_scale = 0.55;   // celle per metro
uniform float glint_amount = 1.0;     // luccichii del sole
uniform float surf_lines = 0.35;      // reticolo di riflessi che scorre sul pelo
uniform float flow_foam = 0.0;        // fiume: strisce di schiuma che scorrono (flow_in_uv)
uniform vec3 under_col : source_color = vec3(0.05, 0.36, 0.48);   // pelo visto da sotto
uniform float under_fog = 0.09;
// quota del fondo sotto l'acqua (laguna, fiume: waters.gd): la profonditÃ  non dipende dalla
// depth texture (che con l'MSAA puÃ² mancare: tutta l'acqua diventerebbe opaca). Senza mappa
// (floor_rect.z = 0, il mare) si usa solo la depth texture.
uniform sampler2D floor_map : filter_linear, repeat_disable;
uniform vec4 floor_rect = vec4(0.0);   // x0, z0, larghezza, lunghezza (m)
// buco circolare (x, z, raggio): il mare passa sotto tutta l'isola e taglierebbe le conche
// scavate sotto il livello del mare (waters.gd lo apre sopra la conca della laguna)
uniform vec3 cut_circle = vec3(0.0);

varying vec3 wpos;
varying float crest;

vec3 wave(vec2 p, vec2 dir, float len, float amp, float speed, inout float c) {
	float k = 6.2831853 / len;
	float f = k * (dot(dir, p) - speed * TIME);
	c += sin(f) * amp;
	return vec3(dir.x * cos(f) * amp * 0.6, sin(f) * amp, dir.y * cos(f) * amp * 0.6);
}

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float c = 0.0;
	if (wave_amp > 0.0) {
		float dist = length(wpos.xz - CAMERA_POSITION_WORLD.xz);
		float fade = 1.0 - smoothstep(250.0, 700.0, dist);
		vec3 o = vec3(0.0);
		o += wave(wpos.xz, normalize(vec2(-1.0, 0.25)), wave_len, wave_amp, 2.4, c);
		o += wave(wpos.xz, normalize(vec2(-0.7, -0.6)), wave_len * 0.57, wave_amp * 0.5, 1.9, c);
		o += wave(wpos.xz, normalize(vec2(-0.9, 0.8)), wave_len * 0.31, wave_amp * 0.3, 1.5, c);
		VERTEX += o * fade;
		// normali delle onde (differenze finite)
		float e = 0.6;
		float dummy = 0.0;
		vec3 ox = wave(wpos.xz + vec2(e, 0.0), normalize(vec2(-1.0, 0.25)), wave_len, wave_amp, 2.4, dummy)
			+ wave(wpos.xz + vec2(e, 0.0), normalize(vec2(-0.7, -0.6)), wave_len * 0.57, wave_amp * 0.5, 1.9, dummy);
		vec3 oz = wave(wpos.xz + vec2(0.0, e), normalize(vec2(-1.0, 0.25)), wave_len, wave_amp, 2.4, dummy)
			+ wave(wpos.xz + vec2(0.0, e), normalize(vec2(-0.7, -0.6)), wave_len * 0.57, wave_amp * 0.5, 1.9, dummy);
		vec3 o2 = o - wave(wpos.xz, normalize(vec2(-0.9, 0.8)), wave_len * 0.31, wave_amp * 0.3, 1.5, dummy);
		vec3 tx = vec3(e, 0.0, 0.0) + (ox - o2) * fade;
		vec3 tz = vec3(0.0, 0.0, e) + (oz - o2) * fade;
		NORMAL = normalize(cross(tz, tx));
		crest = c / wave_amp;
	} else {
		crest = 0.0;
	}
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	if (cut_circle.z > 0.0 && distance(wpos.xz, cut_circle.xy) < cut_circle.z) {
		discard;
	}
	float dist = length(wpos - CAMERA_POSITION_WORLD);
	vec2 uvw;
	vec2 f1;
	vec2 f2;
	vec2 drift;   // spostamento del reticolo di riflessi (segue la corrente)
	if (flow_in_uv) {
		uvw = UV;
		f1 = UV * vec2(1.0, 1.0) + vec2(0.0, -TIME * flow.y);
		f2 = UV * vec2(1.7, 1.7) + vec2(0.13, -TIME * flow.y * 1.35);
		drift = vec2(0.0, -TIME * flow.y * 10.0);
	} else {
		uvw = wpos.xz * normal_scale;
		f1 = uvw + TIME * flow * normal_scale;
		f2 = uvw * 1.9 + vec2(0.37, 0.71) - TIME * flow.yx * normal_scale * 1.3;
		drift = TIME * flow * 0.6;
	}
	vec3 na = texture(normal_a, f1).rgb * 2.0 - 1.0;
	vec3 nb = texture(normal_a, f2).rgb * 2.0 - 1.0;
	// terzo strato fine e veloce: increspature che si vedono muovere anche da vicino
	vec3 nc = texture(normal_a, uvw * 4.3 + vec2(TIME * 0.11, -TIME * 0.07)).rgb * 2.0 - 1.0;
	vec3 nm = normalize(vec3(na.xy + nb.xy + nc.xy * 0.45, 1.0));
	float nfade = 1.0 - smoothstep(60.0, far_fade, dist) * 0.8;
	NORMAL_MAP = normalize(vec3(nm.xy * normal_strength * nfade, 1.0)) * 0.5 + 0.5;
	vec3 v_w = normalize(CAMERA_POSITION_WORLD - wpos);

	if (!FRONT_FACING) {
		// ---- da sotto: finestra di Snell sul cielo (deformata dalle onde) e riflesso totale ai bordi
		vec2 off = nm.xy * 0.05;
		vec3 sky = textureLod(screen_tex, SCREEN_UV + off, 0.0).rgb;
		float cv = clamp(dot(NORMAL, VIEW), 0.0, 1.0);
		float tir = 1.0 - smoothstep(0.5, 0.78, cv);
		vec3 win = sky * vec3(0.62, 0.92, 1.05) + under_col * 0.35;
		float ln = water_caustic(wpos.xz * 0.5 + drift, TIME * 0.8);
		win += vec3(0.6, 0.85, 0.9) * ln * 0.12;
		// riflesso totale: il fondo riflesso, mosso dalle onde, con le linee di luce che scorrono
		vec3 mirror = under_col * (0.62 + (nm.x + nm.y) * 0.18) + vec3(0.45, 0.75, 0.8) * ln * 0.16;
		vec3 col = mix(win, mirror, tir);
		col = mix(col, under_col * 0.9, 1.0 - exp(-dist * under_fog));
		ALBEDO = vec3(0.0);
		EMISSION = col;
		ROUGHNESS = 1.0;
		SPECULAR = 0.0;
		METALLIC = 0.0;
		ALPHA = 0.97;
	} else {
		// profonditÃ  della scena dietro l'acqua
		float raw = textureLod(depth_tex, SCREEN_UV, 0.0).r;
		vec4 vp = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, raw, 1.0);
		vp.xyz /= vp.w;
		vec3 behind = (INV_VIEW_MATRIX * vec4(vp.xyz, 1.0)).xyz;
		float view_depth = max(length(vp.xyz) - length(VERTEX), 0.0);
		float vert_depth = max(wpos.y - behind.y, 0.0);
		vec3 ray = -v_w;
		if (floor_rect.z > 0.0) {
			// dalla mappa del fondo: verticale esatta, lungo lo sguardo come se il fondo fosse piano;
			// un oggetto in acqua (depth texture valida e piÃ¹ vicina) accorcia tutte e due
			float fl = texture(floor_map, (wpos.xz - floor_rect.xy) / floor_rect.zw).r;
			float mv = max(wpos.y - fl, 0.0);
			float mview = mv / max(-ray.y, 0.12);
			if (raw <= 0.00001) {
				vert_depth = mv;
				view_depth = mview;
				behind = wpos + ray * mview;
			} else {
				vert_depth = min(vert_depth, mv);
				view_depth = min(view_depth, mview);
			}
		} else if (raw <= 0.00001) {
			view_depth = 1000.0;
			vert_depth = 1000.0;
		}
		float depth = min(view_depth * 0.6 + vert_depth * 0.4, 1000.0);

		// rifrazione (si vede la sabbia sotto)
		vec2 off = nm.xy * 0.025 * clamp(vert_depth, 0.0, 1.0) * nfade;
		vec3 refr = textureLod(screen_tex, SCREEN_UV + off, 0.0).rgb;
		// caustiche sul fondo: forti dove l'acqua Ã¨ bassa, spente lontano e nel profondo
		float cfade = (1.0 - smoothstep(0.4, 5.0, vert_depth)) * smoothstep(0.03, 0.25, vert_depth) * (1.0 - smoothstep(35.0, 90.0, dist));
		if (cfade > 0.001 && caustic_amount > 0.0) {
			vec2 cp = behind.xz * caustic_scale + nm.xy * 0.35;
			float ca = water_caustic(cp, TIME * 1.15);
			refr += refr * vec3(0.9, 1.0, 0.95) * ca * 0.75 * caustic_amount * cfade;
		}
		float t = 1.0 - exp(-depth * clarity);
		vec3 body = mix(shallow_col, deep_col, smoothstep(0.0, 1.0, t));
		body = mix(body, far_col, smoothstep(150.0, 900.0, dist));
		vec3 tinted = refr * mix(vec3(1.0), shallow_col * 1.15, clamp(t * 2.0, 0.25, 1.0));

		// schiuma a riva: fascia irregolare con piccole onde che arrivano
		float fn = texture(foam_noise, wpos.xz * 0.11 + vec2(TIME * 0.02, 0.0)).r;
		float fn2 = texture(foam_noise, wpos.xz * 0.37 - vec2(0.0, TIME * 0.05)).r;
		float shore = 1.0 - smoothstep(0.0, foam_dist * (0.6 + fn * 0.8), vert_depth);
		float lap = smoothstep(0.55, 0.95, sin(vert_depth * 9.0 / foam_dist - TIME * 2.2 + fn * 6.0) * 0.5 + 0.5) * (1.0 - smoothstep(0.0, foam_dist * 2.2, vert_depth));
		float foam = clamp(shore * smoothstep(0.25, 0.6, fn2 + shore * 0.4) + lap * 0.6 * step(0.45, fn2), 0.0, 1.0);
		foam += smoothstep(0.75, 1.1, crest) * smoothstep(0.5, 0.75, fn2) * 0.5;
		if (flow_in_uv && flow_foam > 0.0) {
			// fiume: strisce di schiuma allungate nel verso della corrente, piÃ¹ fitte vicino alle sponde
			float s1 = texture(foam_noise, vec2(UV.x * 1.9, UV.y * 0.22 - TIME * flow.y * 1.8)).r;
			float s2 = texture(foam_noise, vec2(UV.x * 4.1 + 0.3, UV.y * 0.55 - TIME * flow.y * 2.6)).r;
			float bank = 1.0 - smoothstep(0.0, 0.16, min(UV.x, 1.0 - UV.x));
			float streak = smoothstep(0.58, 0.74, s1 * 0.65 + s2 * 0.45 + bank * 0.25);
			foam += streak * flow_foam * (0.55 + bank * 0.45);
		}
		foam = clamp(foam * foam_amount, 0.0, 1.0);

		// reticolo di riflessi che scorre sul pelo (le "onde disegnate" di Emerald Coast)
		float lines = 0.0;
		if (surf_lines > 0.0) {
			float lf = 1.0 - smoothstep(25.0, 110.0, dist);
			if (lf > 0.0) {
				lines = water_caustic(wpos.xz * 0.32 + nm.xy * 0.25 + drift * 0.5, TIME * 0.7) * lf * surf_lines * smoothstep(0.05, 0.6, vert_depth);
			}
		}

		float fres = pow(1.0 - clamp(dot(normalize(VIEW), vec3(0.0, 0.0, 1.0)), 0.0, 1.0), 5.0);
		ALBEDO = mix(body * t * 0.9 + vec3(0.75, 0.95, 1.0) * lines * 0.22, vec3(0.95, 0.98, 1.0), foam);
		EMISSION = tinted * (1.0 - t) * (1.0 - foam) * (1.0 - fres * 0.6) * 0.9;
		// luccichii del sole (oltre il bianco: il bagliore li fa brillare)
		if (glint_amount > 0.0) {
			vec3 n_w = normalize(vec3(nm.x * 0.9, 1.0, nm.y * 0.9));
			float gl = water_glints(wpos, n_w, v_w, normalize(sun_dir), TIME, dist);
			EMISSION += vec3(1.0, 0.97, 0.88) * gl * 5.0 * glint_amount * (1.0 - foam);
		}
		ROUGHNESS = mix(0.03, 0.7, foam);
		SPECULAR = 0.6;
		METALLIC = 0.0;
		ALPHA = smoothstep(0.0, 0.12, vert_depth);
	}
}
␀␀␀␀␀␀shader_type spatial;
// Cascata: velo d'acqua che scorre verso il basso, striature di schiuma, bordi sfumati.
// UV.x = traverso (0..1), UV.y = metri di caduta / 6.

render_mode blend_mix, cull_disabled, depth_draw_never, diffuse_burley, specular_schlick_ggx;

uniform sampler2D streaks : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform vec3 water_col : source_color = vec3(0.45, 0.85, 0.88);
uniform vec3 foam_col : source_color = vec3(0.97, 0.99, 1.0);
uniform float speed = 1.6;
uniform float opacity = 0.9;
uniform float layer_offset = 0.0;
uniform float foam_bias = 0.0;

void fragment() {
	vec2 uv = UV;
	float t = TIME * speed;
	float s1 = texture(streaks, vec2(uv.x * 3.0 + layer_offset, uv.y * 0.35 - t * 0.55)).r;
	float s2 = texture(streaks, vec2(uv.x * 7.0 + 0.37 + layer_offset, uv.y * 0.8 - t * 0.9)).r;
	float s3 = texture(streaks, vec2(uv.x * 15.0 + 0.11, uv.y * 1.6 - t * 1.4)).r;
	float streak = s1 * 0.5 + s2 * 0.35 + s3 * 0.15;
	// piÃ¹ schiuma in alto (bordo) e in basso (impatto)
	float top = 1.0 - smoothstep(0.0, 0.25, uv.y);
	float bottom = smoothstep(4.6, 6.4, uv.y);
	float foam = smoothstep(0.42 - foam_bias, 0.75 - foam_bias, streak + top * 0.35 + bottom * 0.5);
	float edge = smoothstep(0.0, 0.08, uv.x) * smoothstep(1.0, 0.92, uv.x);
	vec3 c = mix(water_col, foam_col, foam);
	ALBEDO = c;
	EMISSION = c * 0.18;
	ROUGHNESS = mix(0.15, 0.6, foam);
	SPECULAR = 0.5;
	ALPHA = clamp((0.55 + foam * 0.45) * opacity * edge, 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀␀// Funzioni comuni dell'acqua: caustiche (reticolo di luce che danza sul fondo) e luccichii del sole.
// Usate dal pelo dell'acqua (water.gdshader) e dallo schermo sott'acqua (underwater_screen).

vec2 wc_hash2(vec2 p) {
	p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
	return fract(sin(p) * 43758.5453);
}

float wc_hash1(vec2 p) {
	return fract(sin(dot(p, vec2(41.31, 289.13))) * 15731.743);
}

// Bordo delle celle di Voronoi con i centri che si muovono in tondo (F2 - F1): linee sottili.
float wc_cells(vec2 p, float t) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	float d1 = 8.0;
	float d2 = 8.0;
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 g = vec2(float(x), float(y));
			vec2 o = wc_hash2(i + g);
			o = 0.5 + 0.42 * sin(t + 6.2831853 * o);
			vec2 r = g + o - f;
			float d = dot(r, r);
			if (d < d1) {
				d2 = d1;
				d1 = d;
			} else if (d < d2) {
				d2 = d;
			}
		}
	}
	return sqrt(d2) - sqrt(d1);
}

// Caustiche: due reticoli che scorrono in versi diversi; dove si incrociano la luce Ã¨ piÃ¹ forte.
// Restituisce 0..~2.4 (0 = niente luce in piÃ¹).
float water_caustic(vec2 p, float t) {
	float a = wc_cells(p, t * 1.1);
	float b = wc_cells(p * 1.37 + vec2(3.1, 7.7), -t * 0.9 + 1.7);
	float la = 1.0 - smoothstep(0.0, 0.17, a);
	float lb = 1.0 - smoothstep(0.0, 0.17, b);
	return la * 0.55 + lb * 0.55 + la * lb * 1.3;
}

// Luccichii del sole: punti che si accendono e si spengono dove l'onda riflette il sole verso
// la telecamera. wp: punto sul pelo (mondo), n: normale dell'onda (mondo), v: verso la telecamera.
float water_glints(vec3 wp, vec3 n, vec3 v, vec3 sun, float t, float dist) {
	vec3 r = reflect(-v, n);
	float lobe = pow(max(dot(r, sun), 0.0), 18.0);
	if (lobe < 0.002) {
		return 0.0;
	}
	float out_g = 0.0;
	// due griglie: fitta vicino, larga lontano (i punti non diventano piÃ¹ piccoli di un pixel)
	for (int k = 0; k < 2; k++) {
		float sc = k == 0 ? 4.0 : 0.9;
		float w = k == 0 ? 1.0 - smoothstep(18.0, 45.0, dist) : smoothstep(12.0, 40.0, dist) * (1.0 - smoothstep(160.0, 320.0, dist));
		if (w <= 0.0) {
			continue;
		}
		vec2 q = wp.xz * sc;
		vec2 cell = floor(q);
		float h = wc_hash1(cell + float(k) * 17.0);
		float tw = 0.5 + 0.5 * sin(t * (3.0 + h * 6.0) + h * 40.0);
		vec2 c = wc_hash2(cell) * 0.6 + 0.2;
		float d = length(fract(q) - c);
		out_g += step(0.8, h) * pow(tw, 5.0) * (1.0 - smoothstep(0.03, 0.16, d)) * w;
	}
	return out_g * lobe;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀// Vento e terremoto per la vegetazione (solo durante la cinematica d'apertura: lo script della
// intro sostituisce per qualche secondo foliage/bark con foliage_wind/bark_wind e poi li rimette).
// flex = COLOR.a (flessibilitÃ  dipinta nella mesh: 0 alla base, 1 in punta).
uniform float gust = 0.0;              // 0..1 raffica: oscillazione piÃ¹ ampia e piega sottovento
uniform vec2 wind_dir = vec2(-0.6, -0.8);
uniform float quake = 0.0;             // 0..1 terremoto: scossa veloce di tutta la pianta
// onda d'urto dell'atterraggio di Knuckles: il fronte parte da blast_pos e corre sulla sabbia;
// quando arriva, la pianta si piega di colpo lontano dal centro e torna su oscillando
uniform vec3 blast_pos = vec3(0.0);
uniform float blast_age = -1.0;        // secondi dall'impatto (< 0 = niente)
uniform float blast_strength = 0.0;
uniform float blast_speed = 45.0;      // m/s del fronte
uniform float blast_radius = 34.0;     // oltre non arriva

// Tutto scala con wind_strength del materiale (come l'oscillazione originale), cosÃ¬ tronco e
// fronde della stessa palma restano attaccati.
vec3 wind_extra(vec3 org, float ph, float flex, float ws, mat3 model_basis) {
	// piega sottovento che "respira" con raffiche che attraversano l'isola
	float wave = 0.55 + 0.45 * sin(TIME * 0.9 - dot(org.xz, wind_dir) * 0.045 + ph * 0.3);
	vec3 wl = inverse(model_basis) * vec3(wind_dir.x, 0.0, wind_dir.y);
	vec3 d = wl * flex * gust * ws * 3.0 * wave;
	// scossa del terremoto: veloce, irregolare, diversa per ogni pianta
	float q = quake * flex;
	vec3 j = vec3(sin(TIME * 29.0 + ph * 3.1) + 0.5 * sin(TIME * 47.0 + ph * 5.3),
		0.35 * sin(TIME * 23.0 + ph * 1.7),
		sin(TIME * 33.0 + ph * 2.3) + 0.5 * sin(TIME * 41.0 + ph * 4.1));
	d += inverse(model_basis) * j * q * ws * 1.3;
	if (blast_age > 0.0 && blast_strength > 0.0) {
		vec2 dv = org.xz - blast_pos.xz;
		float dist = length(dv);
		float a = blast_age - dist / blast_speed;
		if (a > 0.0 && dist < blast_radius) {
			float fall = 1.0 - smoothstep(blast_radius * 0.3, blast_radius, dist);
			float env = (1.0 - exp(-a * 28.0)) * exp(-a * 2.4) * (0.75 + 0.25 * cos(a * 9.0));
			vec2 dir = dv / max(dist, 0.5);
			d += inverse(model_basis) * vec3(dir.x, -0.18, dir.y) * flex * ws * blast_strength * fall * env * 11.0;
		}
	}
	return d;
}
␀␀␀␀␀␀shader_type spatial;
// Frammento dello Smeraldo Madre di Sonic Adventure 2: la texture originale (32x32) non Ã¨ stesa con
// le UV ma usata come environment map, come facevano le gemme sul Dreamcast: il colore dipende dalla
// normale vista dalla camera e scorre sulle facce mentre il frammento gira.
render_mode blend_mix, cull_back, specular_schlick_ggx;

uniform sampler2D env_tex : source_color, filter_linear_mipmap, repeat_enable;
uniform float glow : hint_range(0.0, 3.0) = 0.3;
uniform float brightness : hint_range(0.0, 3.0) = 0.95;

void fragment() {
	vec2 uv = NORMAL.xy * vec2(0.5, -0.5) + 0.5;
	vec3 c = texture(env_tex, uv).rgb * brightness;
	ALBEDO = c;
	EMISSION = c * glow;
	ROUGHNESS = 0.2;
	SPECULAR = 0.5;
	METALLIC = 0.0;
}
␀␀␀␀␀␀shader_type spatial;
// Schermo dei monitor degli scudi elementali (Sonic 3 & Knuckles): stesso fondo blu e stesse righe
// dello schermo degli anelli (scenes/objects/item_monitor.tscn), icona per tipo.
// kind: 0 = scudo di fuoco (palla di fiamme), 1 = bolla (sfera azzurra col riflesso),
// 2 = elettrico (sfera gialla col fulmine).
render_mode cull_back;
uniform int kind = 0;
uniform vec4 bg_top : source_color = vec4(0.06, 0.32, 0.7, 1.0);
uniform vec4 bg_bot : source_color = vec4(0.01, 0.05, 0.2, 1.0);
uniform float aspect = 1.27;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float vnoise(vec2 x) {
	vec2 i = floor(x);
	vec2 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}

// segmento con spessore (fulmine)
float seg(vec2 p, vec2 a, vec2 b, float w) {
	vec2 pa = p - a;
	vec2 ba = b - a;
	float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
	return length(pa - ba * h) - w;
}

void fragment() {
	vec2 uv = UV * 2.0 - 1.0;
	uv.x *= aspect;
	uv.y = -uv.y;
	vec2 p = uv * 1.12;
	float r = length(p);
	float aa = fwidth(r) * 1.2;
	vec3 bg = mix(bg_bot.rgb, bg_top.rgb, 1.0 - UV.y);
	bg += vec3(0.05, 0.12, 0.25) * smoothstep(0.9, 0.0, length(uv * vec2(0.8, 1.0)));
	vec3 col = bg;
	if (kind == 0) {
		// palla di fuoco con le lingue di fiamma che salgono
		float ang = atan(p.x, p.y);
		float up = clamp(p.y / max(r, 1e-3), -1.0, 1.0) * 0.5 + 0.5;
		float lick = vnoise(vec2(ang * 3.0, TIME * 5.0)) * 0.22 * up + vnoise(vec2(ang * 7.0, TIME * 8.0)) * 0.08;
		float edge = 0.5 + lick + up * 0.08;
		float ball = smoothstep(edge + aa, edge - aa, r);
		float heat = clamp(1.0 - r / edge + vnoise(p * 6.0 - vec2(0.0, TIME * 6.0)) * 0.35, 0.0, 1.0);
		vec3 f = mix(vec3(0.8, 0.05, 0.0), vec3(1.0, 0.45, 0.0), smoothstep(0.1, 0.45, heat));
		f = mix(f, vec3(1.0, 0.95, 0.5), smoothstep(0.5, 0.85, heat));
		float outline = smoothstep(edge + 0.05 + aa, edge + 0.05 - aa, r) * (1.0 - ball);
		col = mix(col, vec3(0.1, 0.0, 0.0), outline * 0.8);
		col = mix(col, f, ball);
	} else if (kind == 1) {
		// bolla: sfera azzurra trasparente, bordo piÃ¹ scuro, riflessi bianchi
		float ball = smoothstep(0.62 + aa, 0.62 - aa, r);
		float rim = smoothstep(0.3, 0.62, r);
		vec3 b = mix(vec3(0.45, 0.85, 1.0), vec3(0.1, 0.35, 0.95), rim);
		b = mix(bg, b, 0.55 + rim * 0.45);
		float hl = smoothstep(0.16, 0.1, length(p - vec2(-0.22, 0.26)));
		float hl2 = smoothstep(0.07, 0.04, length(p - vec2(0.28, -0.25)));
		b = mix(b, vec3(1.0), max(hl, hl2 * 0.8));
		float wob = sin(TIME * 4.0) * 0.01;
		float outline = smoothstep(0.67 + wob + aa, 0.67 + wob - aa, r) * (1.0 - ball);
		col = mix(col, vec3(0.9, 1.0, 1.0), outline * 0.9);
		col = mix(col, b, ball);
	} else {
		// elettrico: sfera gialla col fulmine arancio e guizzi bianchi
		float ball = smoothstep(0.6 + aa, 0.6 - aa, r);
		vec3 b = mix(vec3(1.0, 0.98, 0.7), vec3(1.0, 0.7, 0.05), smoothstep(0.1, 0.6, r));
		float d = min(min(seg(p, vec2(0.12, 0.42), vec2(-0.16, 0.0), 0.06), seg(p, vec2(-0.16, 0.0), vec2(0.12, 0.02), 0.06)),
			seg(p, vec2(0.12, 0.02), vec2(-0.1, -0.42), 0.06));
		float bolt = smoothstep(0.012, -0.012, d);
		b = mix(b, vec3(0.9, 0.3, 0.0), bolt);
		float zap = step(0.8, fract(TIME * 2.5));
		float arc = smoothstep(0.03, 0.0, abs(r - 0.66 - 0.04 * sin(atan(p.y, p.x) * 9.0 + TIME * 20.0))) * zap;
		float outline = smoothstep(0.65 + aa, 0.65 - aa, r) * (1.0 - ball);
		col = mix(col, vec3(0.1, 0.05, 0.0), outline * 0.8);
		col = mix(col, b, ball);
		col += vec3(1.0, 1.0, 0.8) * arc;
	}
	// scintilla a 4 punte, come sullo schermo degli anelli
	float tw = pow(max(sin(TIME * 3.1416 * 0.5), 0.0), 24.0);
	vec2 sp = p - vec2(-0.36, 0.42);
	float star = max(smoothstep(0.035, 0.0, abs(sp.x)) * smoothstep(0.26, 0.0, abs(sp.y)),
		smoothstep(0.035, 0.0, abs(sp.y)) * smoothstep(0.26, 0.0, abs(sp.x)));
	star = max(star, smoothstep(0.07, 0.0, length(sp)));
	col += vec3(1.0, 1.0, 0.9) * star * tw * 1.5;
	float roll = fract(UV.y * 1.0 - TIME * 0.25);
	col *= 0.9 + 0.1 * smoothstep(0.0, 0.08, roll) * smoothstep(0.2, 0.08, roll) + 0.04;
	col *= 0.93 + 0.07 * sin(UV.y * 160.0);
	col *= smoothstep(1.5, 0.5, length(uv * vec2(0.75, 1.0)));
	ALBEDO = vec3(0.0);
	EMISSION = col * 1.15;
	ROUGHNESS = 0.06;
	SPECULAR = 0.65;
}
␀␀␀␀␀␀shader_type spatial;
// Metal Knuckles ricostruito: l'occhio da un lato Ã¨ morto. Passata in piÃ¹ sopra il materiale degli
// occhi (next_pass): dal lato "side" (x locale della mesh) copre il bagliore con vetro nero
// crepato a ragnatela, con un filo rosso che ogni tanto prova a riaccendersi (glow).
render_mode blend_mix, depth_draw_never, cull_disabled;

uniform float side = 1.0;
uniform float glow = 0.6;
uniform vec3 glow_col : source_color = vec3(1.0, 0.05, 0.02);

varying vec3 lp;

float h21(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

vec2 h22(vec2 p) {
	return fract(sin(vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)))) * 43758.5453);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(h21(i), h21(i + vec2(1, 0)), f.x), mix(h21(i + vec2(0, 1)), h21(i + vec2(1, 1)), f.x), f.y);
}

// distanza dal bordo piÃ¹ vicino tra due celle (le crepe sono i bordi)
float edge(vec2 p) {
	vec2 n = floor(p);
	vec2 f = fract(p);
	vec2 mg;
	vec2 mr;
	float md = 8.0;
	for (int j = -1; j <= 1; j++)
	for (int i = -1; i <= 1; i++) {
		vec2 g = vec2(float(i), float(j));
		vec2 r = g + h22(n + g) - f;
		float d = dot(r, r);
		if (d < md) { md = d; mr = r; mg = g; }
	}
	md = 8.0;
	for (int j = -2; j <= 2; j++)
	for (int i = -2; i <= 2; i++) {
		vec2 g = mg + vec2(float(i), float(j));
		vec2 r = g + h22(n + g) - f;
		if (dot(mr - r, mr - r) > 0.00001)
			md = min(md, dot(0.5 * (mr + r), normalize(r - mr)));
	}
	return md;
}

void vertex() {
	lp = VERTEX;
	VERTEX += NORMAL * 0.0015;
}

void fragment() {
	if (lp.x * side < 0.015) {
		discard;
	}
	vec2 wob = vec2(vnoise(lp.yz * 260.0), vnoise(lp.yz * 260.0 + 7.0)) - 0.5;
	float e = edge(lp.yz * 38.0 + wob * 0.4);
	float line = 1.0 - smoothstep(0.015, 0.05, e);
	ALBEDO = mix(vec3(0.035, 0.03, 0.03), vec3(0.32, 0.3, 0.3), line * 0.6);
	METALLIC = 0.4;
	ROUGHNESS = mix(0.08, 0.7, line);
	EMISSION = glow_col * glow * (1.0 - smoothstep(0.0, 0.02, e));
	ALPHA = 1.0;
}
␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Metal Knuckles ricostruito: passata in piÃ¹ sopra la corazza (next_pass dei materiali del
// modello). Dove sono arrivati i pugni di Knuckles (hits) la corazza Ã¨ crepata: fessure annerite
// con un filo arancione acceso dentro (i circuiti scoperti) e fuliggine intorno; Eggman ha
// richiuso ogni colpo con un cordone di saldatura argentato tutto intorno.
// Le crepe usano la posizione a riposo di ogni vertice (CUSTOM0, vedi _rest_positions nel
// MetalKnucklesCannonAnimator), cosÃ¬ restano attaccate alla corazza mentre si muove.
render_mode blend_mix, depth_draw_never, cull_back;

uniform vec4 hits[8];              // xyz = centro del colpo (spazio della mesh a riposo), w = raggio
uniform int hit_count = 0;
uniform float density = 15.0;      // celle delle crepe per metro
uniform vec3 glow_col : source_color = vec3(1.0, 0.32, 0.06);
uniform float glow = 3.2;

varying vec3 rp;

vec3 h33(vec3 p) {
	p = vec3(dot(p, vec3(127.1, 311.7, 74.7)), dot(p, vec3(269.5, 183.3, 246.1)), dot(p, vec3(113.5, 271.9, 124.6)));
	return fract(sin(p) * 43758.5453);
}

float h31(vec3 p) {
	return fract(sin(dot(p, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
}

float vnoise(vec3 p) {
	vec3 i = floor(p);
	vec3 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(h31(i), h31(i + vec3(1, 0, 0)), f.x), mix(h31(i + vec3(0, 1, 0)), h31(i + vec3(1, 1, 0)), f.x), f.y),
		mix(mix(h31(i + vec3(0, 0, 1)), h31(i + vec3(1, 0, 1)), f.x), mix(h31(i + vec3(0, 1, 1)), h31(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

// F2 - F1 delle celle: vicino a zero sui bordi tra due celle (le crepe)
float cells(vec3 p) {
	vec3 n = floor(p);
	vec3 f = fract(p);
	float d1 = 8.0;
	float d2 = 8.0;
	for (int k = -1; k <= 1; k++)
	for (int j = -1; j <= 1; j++)
	for (int i = -1; i <= 1; i++) {
		vec3 g = vec3(float(i), float(j), float(k));
		vec3 r = g + h33(n + g) - f;
		float d = length(r);
		if (d < d1) { d2 = d1; d1 = d; }
		else if (d < d2) { d2 = d; }
	}
	return d2 - d1;
}

void vertex() {
	rp = CUSTOM0.xyz;
	VERTEX += NORMAL * 0.0012;
}

void fragment() {
	// quanto Ã¨ vicino a un colpo (1 al centro) e il bordo dove Ã¨ stato saldato
	float zone = 0.0;
	float rim = 0.0;
	for (int i = 0; i < hit_count; i++) {
		float r = hits[i].w;
		float d = length(rp - hits[i].xyz) / r;
		d += (vnoise(rp * 40.0 + float(i) * 7.0) - 0.5) * 0.25;   // bordo irregolare
		zone = max(zone, 1.0 - smoothstep(0.55, 0.95, d));
		rim = max(rim, 1.0 - smoothstep(0.0, 0.05, abs(d - 1.05)));
	}
	vec3 wob = vec3(vnoise(rp * 140.0), vnoise(rp * 140.0 + 17.0), vnoise(rp * 140.0 + 31.0)) - 0.5;
	float e = cells(rp * density + wob * 0.18);
	float crack = (1.0 - smoothstep(0.05, 0.13, e)) * zone;
	float core = (1.0 - smoothstep(0.0, 0.05, e)) * zone * smoothstep(0.25, 0.45, vnoise(rp * 18.0));
	float soot = zone * 0.3 * (0.5 + 0.5 * vnoise(rp * 25.0));
	float bead = 0.7 + 0.3 * sin(dot(rp, vec3(1.0, 1.3, 0.7)) * 700.0);
	vec3 col = mix(vec3(0.06, 0.045, 0.04), vec3(0.015, 0.012, 0.01), crack);
	float a = max(crack, soot);
	if (rim > a) {
		col = vec3(0.55, 0.55, 0.58) * bead;
		a = rim;
		METALLIC = 0.9;
		ROUGHNESS = 0.45;
	} else {
		METALLIC = 0.3;
		ROUGHNESS = mix(0.7, 0.95, crack);
	}
	if (a < 0.02) {
		discard;
	}
	ALBEDO = col;
	float fl = 0.75 + 0.25 * sin(TIME * 3.0 + vnoise(rp * 9.0) * 6.28);
	EMISSION = glow_col * glow * core * fl;
	ALPHA = a;
}
␀␀␀␀␀␀␀␀␀␀␀␀// Mira dell'attacco a ricerca di Sonic (stile Sonic Unleashed / Generations): anello azzurro con
// il filo bianco al centro, quattro triangoli che puntano verso il bersaglio, un anello interno
// tratteggiato, un bordo blu scuro e un alone morbido additivo. Tutto calcolato come distanza con segno (SDF): nitido a
// qualsiasi scala, nessuna texture. Rotazione, scala e trasparenza le dÃ  il nodo
// (scripts/ui/lock_on_reticle.gd); qui solo il lampo dell'aggancio e la pulsazione dell'alone.
//
// Alfa premoltiplicata: l'alone si somma alla scena (additivo, alfa zero) mentre tratti e bordo
// la coprono, cosÃ¬ la mira si legge anche contro il cielo chiaro.
shader_type canvas_item;
render_mode blend_premul_alpha, unshaded;

uniform float half_size = 128.0;                   // metÃ  lato del quadrato disegnato, in px
uniform float flash : hint_range(0.0, 1.0) = 0.0;  // lampo dell'aggancio: verso il bianco, alone piÃ¹ ampio
uniform float glow : hint_range(0.0, 2.0) = 1.0;   // intensitÃ  dell'alone (pulsazione)
uniform float inner_angle = 0.0;                   // rotazione propria dell'anello tratteggiato

const float RING_R = 47.0;     // anello principale
const float RING_W = 5.5;
const float TRI_TIP = 56.0;    // triangoli: punta verso il centro...
const float TRI_BASE = 86.0;   // ...base verso l'esterno
const float TRI_HALF = 15.0;
const float DASH_R = 33.0;     // anello interno tratteggiato
const float DASH_W = 2.2;
const float DASHES = 8.0;
const float GLOW_R = 9.0;      // raggio dell'alone (px)
const float RIM = 2.2;         // bordo scuro attorno ai tratti (px)

const vec3 CYAN = vec3(0.30, 0.86, 1.0);
const vec3 DEEP = vec3(0.06, 0.50, 1.0);
const vec3 WHITE = vec3(0.93, 1.0, 1.0);
const vec3 RIM_COL = vec3(0.02, 0.17, 0.55);


// smoothstep "al contrario" (da e0 a e1 con e0 > e1): smoothstep vuole e0 < e1.
float sstep_down(float e0, float e1, float x) {
	return 1.0 - smoothstep(e1, e0, x);
}


// Triangolo isoscele lungo +x (punta in TRI_TIP, base in TRI_BASE), ripetuto nei 4 quadranti.
// Distanza esatta (sdTriangleIsosceles di Inigo Quilez): l'alone resta attaccato al triangolo.
float sd_brackets(vec2 p) {
	float qa = TAU * 0.25;
	float a = mod(atan(p.y, p.x) + qa * 0.5, qa) - qa * 0.5;
	vec2 l = length(p) * vec2(cos(a), sin(a));
	vec2 t = vec2(abs(l.y), l.x - TRI_TIP);      // punta nell'origine, base a y = h
	vec2 q = vec2(TRI_HALF, TRI_BASE - TRI_TIP);
	vec2 ea = t - q * clamp(dot(t, q) / dot(q, q), 0.0, 1.0);
	vec2 eb = t - q * vec2(clamp(t.x / q.x, 0.0, 1.0), 1.0);
	float s = -sign(q.y);
	vec2 d = min(vec2(dot(ea, ea), s * (t.x * q.y - q.x * t.y)), vec2(dot(eb, eb), s * (t.y - q.y)));
	return -sqrt(d.x) * sign(d.y);
}


void fragment() {
	vec2 p = (UV - 0.5) * 2.0 * half_size;
	float r = length(p);
	float aa = max(fwidth(r), 0.0005) * 0.85;

	float d_ring = abs(r - RING_R) - RING_W * 0.5;
	float d_tri = sd_brackets(p);
	float seg = TAU / DASHES;
	float m = fract((atan(p.y, p.x) + inner_angle) / seg);
	float d_dash = max(abs(r - DASH_R) - DASH_W * 0.5, (abs(m - 0.32) - 0.2) * seg * DASH_R);
	float d_main = min(d_ring, d_tri);

	// riempimento: anello con il filo bianco al centro, triangoli dal bianco della punta
	// all'azzurro della base; sul lampo dell'aggancio tutto verso il bianco
	float c_ring = sstep_down(aa, -aa, d_ring);
	float c_tri = sstep_down(aa, -aa, d_tri);
	float c_dash = sstep_down(aa, -aa, d_dash) * 0.75;
	vec3 ring_col = mix(CYAN, WHITE, sstep_down(RING_W * 0.5, 0.3, abs(r - RING_R)) * 0.9);
	vec3 tri_col = mix(WHITE, CYAN, smoothstep(TRI_TIP + 2.0, TRI_BASE - 4.0, r));
	float fill = max(c_ring, c_tri);
	vec3 fill_col = c_ring >= c_tri ? ring_col : tri_col;
	fill_col = mix(fill_col, WHITE, flash * 0.8);

	// bordo blu scuro attorno ai tratti (stile HUD di Sonic): si legge su cielo ed erba
	float rim = sstep_down(RIM + aa, RIM - aa, d_main);
	vec3 rim_col = mix(RIM_COL, CYAN, flash * 0.6);

	// alone additivo fuori dal bordo (piÃ¹ ampio e chiaro sul lampo), sfumato prima dei lati
	// del quadrato
	float dg = max(d_main - RIM, 0.0);
	float g = exp(-dg / (GLOW_R * (1.0 + flash * 0.7))) * (0.5 + 0.55 * flash) * glow;
	g *= 1.0 - smoothstep(half_size * 0.72, half_size * 0.97, r);
	vec3 glow_col = mix(DEEP, CYAN, exp(-dg / 5.0));

	// composizione in alfa premoltiplicata: riempimento sopra il bordo, sopra alone e ombra
	vec3 col = glow_col * g;
	float alpha = sstep_down(RIM + 4.0, RIM, d_main) * 0.3;   // ombra sottile appena fuori
	col = rim_col * rim * 0.9 + col * (1.0 - rim * 0.9);
	alpha = rim * 0.9 + alpha * (1.0 - rim * 0.9);
	col = CYAN * c_dash + col * (1.0 - c_dash);
	alpha = c_dash + alpha * (1.0 - c_dash);
	col = fill_col * fill + col * (1.0 - fill);
	alpha = fill + alpha * (1.0 - fill);

	float k = COLOR.a;   // trasparenza del nodo (modulate)
	COLOR = vec4(col * k, alpha * k);
}
␀␀␀␀␀␀shader_type canvas_item;
// Logo: lampo di luce diagonale che attraversa le parti piene (maschera) e flash bianco all'entrata.

uniform sampler2D shine_mask : filter_linear_mipmap;
// posizione del lampo lungo la diagonale (-0.3 = fuori a sinistra, 1.3 = fuori a destra)
uniform float shine_pos = -1.0;
uniform float shine_width = 0.07;
uniform float shine_strength = 1.0;
uniform float slant = 0.18;
uniform float flash : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec4 c = texture(TEXTURE, UV);
	float m = texture(shine_mask, UV).r;
	float s = UV.x + (1.0 - UV.y) * slant;
	float d = (s - shine_pos) / shine_width;
	float band = exp(-d * d) + 0.45 * exp(-pow((s - shine_pos + shine_width * 2.6) / (shine_width * 0.35), 2.0));
	c.rgb += (vec3(1.0) - c.rgb * 0.35) * band * m * shine_strength;
	c.rgb = mix(c.rgb, vec3(1.0), flash);
	COLOR = c * COLOR;
}
␀␀␀␀shader_type canvas_item;
// Righe di scansione sottili sopra a tutto (2-3 pixel reali per riga).
uniform float strength : hint_range(0.0, 1.0) = 0.06;

void fragment() {
	float px = max(2.0, floor(1.0 / SCREEN_PIXEL_SIZE.y / 360.0 + 0.5));
	float sl = step(px * 0.5, mod(FRAGCOORD.y, px));
	COLOR = vec4(0.02, 0.05, 0.18, strength * sl);
}
␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
// Ombra morbida di una figura ritagliata: usa l'alfa sfocato (mipmap) tinto di blu scuro.
uniform vec4 tint : source_color = vec4(0.03, 0.08, 0.30, 1.0);
uniform float opacity : hint_range(0.0, 1.0) = 0.35;
uniform float blur_lod = 3.5;

void fragment() {
	float a = textureLod(TEXTURE, UV, blur_lod).a;
	COLOR = vec4(tint.rgb, a * opacity * COLOR.a);
}
␀␀␀␀shader_type canvas_item;
// Fasce blu in alto e in basso (rigate finemente, con sfumatura) separate dal centro
// da una linea bianca netta, come nel title screen del SADX. Il centro resta trasparente.

// confini in UV (riferiti a 1080 righe)
uniform float top_end = 0.1315;     // 142 px
uniform float line_w = 0.0185;      // 20 px
uniform float bottom_start = 0.8648; // 934 px
// quanto le fasce sono "aperte" (0 = coprono tutto lo schermo, 1 = posizione normale)
uniform float open : hint_range(0.0, 1.0) = 1.0;
uniform float menu_mix : hint_range(0.0, 1.0) = 0.0;
uniform vec4 title_left : source_color = vec4(0.02, 0.06, 0.78, 1.0);
uniform vec4 title_right : source_color = vec4(0.16, 0.07, 0.46, 1.0);
uniform vec4 menu_left : source_color = vec4(0.36, 0.41, 0.78, 1.0);
uniform vec4 menu_right : source_color = vec4(0.45, 0.43, 0.62, 1.0);

void fragment() {
	vec2 uv = UV;
	float te = mix(0.5, top_end, open);
	float bs = mix(0.5, bottom_start, open);
	float in_top = step(uv.y, te);
	float in_bot = step(bs, uv.y);
	float line_top = step(te, uv.y) * step(uv.y, te + line_w);
	float line_bot = step(bs - line_w, uv.y) * step(uv.y, bs);

	// colore della fascia: blu reale a sinistra, indaco/viola a destra
	vec3 l = mix(title_left.rgb, menu_left.rgb, menu_mix);
	vec3 r = mix(title_right.rgb, menu_right.rgb, menu_mix);
	vec3 band = mix(l, r, smoothstep(0.0, 1.0, uv.x));
	// sfumatura verticale: piÃ¹ scura verso il bordo esterno dello schermo
	float edge_d = in_top > 0.5 ? (te - uv.y) / te : (uv.y - bs) / (1.0 - bs);
	band *= mix(1.0, 0.82, smoothstep(0.0, 1.0, edge_d));
	// riflesso morbido lungo il bordo interno
	band += vec3(0.06, 0.08, 0.20) * (1.0 - smoothstep(0.0, 0.25, edge_d));
	// righe fini (periodo 4 px su 1080), ben visibili come nel SADX
	float stripe = step(0.5, fract(uv.y * 1080.0 / 4.0));
	band *= 1.0 - 0.22 * stripe;

	// linea bianca, con un velo azzurro verso il centro
	float lt = (uv.y - te) / line_w;     // 0..1 dentro la linea alta
	float lb = (bs - uv.y) / line_w;     // 0..1 dentro la linea bassa
	vec3 white = vec3(1.0);
	float a_line = max(line_top, line_bot);
	float tint = line_top > 0.5 ? smoothstep(0.55, 1.0, lt) : smoothstep(0.55, 1.0, lb);
	white = mix(white, vec3(0.86, 0.94, 1.0), tint * 0.6);

	vec3 col = band;
	float a = max(in_top, in_bot);
	if (a_line > 0.5) {
		col = white;
		a = 1.0;
	}
	COLOR = vec4(col, a);
}
␀␀␀␀shader_type canvas_item;
// Sfondo del title screen in stile Sonic Adventure DX: acqua azzurra con caustiche bianche
// che scorrono, nuvole sfilacciate, grandi archi concentrici e righe di scansione.
// Disegnato su un ColorRect a tutto schermo (UV 0..1).

uniform float aspect = 1.7777778;
// 0 = title screen, 1 = menu (cambia il punto di vista come nel SADX).
uniform float menu_mix : hint_range(0.0, 1.0) = 0.0;
uniform float speed = 1.0;
uniform vec4 sky_top : source_color = vec4(0.13, 0.60, 0.95, 1.0);
uniform vec4 sky_bottom : source_color = vec4(0.27, 0.72, 0.98, 1.0);
uniform vec4 deep : source_color = vec4(0.05, 0.42, 0.86, 1.0);
// nel menu lo sfondo Ã¨ piÃ¹ chiaro e pieno di nuvole
uniform vec4 menu_tint : source_color = vec4(0.70, 0.88, 0.99, 1.0);

vec2 hash2(vec2 p) {
	p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
	return fract(sin(p) * 43758.5453);
}

float hash1(vec2 p) {
	return fract(sin(dot(p, vec2(41.3, 289.1))) * 15731.743);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash1(i), hash1(i + vec2(1.0, 0.0)), u.x),
			mix(hash1(i + vec2(0.0, 1.0)), hash1(i + vec2(1.0, 1.0)), u.x), u.y);
}

float fbm(vec2 p) {
	float a = 0.5;
	float s = 0.0;
	for (int i = 0; i < 5; i++) {
		s += a * vnoise(p);
		p = p * 2.03 + vec2(17.1, 9.2);
		a *= 0.5;
	}
	return s;
}

// rumore morbido a due ottave (per la distorsione: linee ondulate ma non seghettate)
float fbm2(vec2 p) {
	return 0.65 * vnoise(p) + 0.35 * vnoise(p * 2.1 + vec2(3.1, 7.7));
}

// Rete di caustiche: distanza dal bordo fra celle di Voronoi animate (F2 - F1: 0 sul bordo).
float cell_edge(vec2 p, float t) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	float f1 = 8.0;
	float f2 = 8.0;
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 g = vec2(float(x), float(y));
			vec2 h = hash2(i + g);
			vec2 o = 0.5 + 0.38 * sin(t * (0.6 + 0.5 * h) + 6.2831 * h);
			float d = length(g + o - f);
			if (d < f1) {
				f2 = f1;
				f1 = d;
			} else if (d < f2) {
				f2 = d;
			}
		}
	}
	return f2 - f1;
}

// Linea di caustica morbida di spessore w, con un alone attorno.
float caustic_line(float e, float w, float halo) {
	return exp(-(e / w) * (e / w)) + halo * exp(-e * 5.5);
}

float ring(vec2 p, vec2 c, float r, float w) {
	float d = abs(length(p - c) - r);
	return 1.0 - smoothstep(w * 0.4, w, d);
}

void fragment() {
	float t = TIME * speed;
	vec2 uv = UV;
	// spazio con le proporzioni dello schermo (x 0..aspect, y 0..1)
	vec2 p = vec2(uv.x * aspect, uv.y);

	// colore di base: azzurro chiaro, piÃ¹ profondo in basso a destra
	vec3 col = mix(sky_top.rgb, sky_bottom.rgb, smoothstep(0.1, 1.0, uv.y * 0.7 + uv.x * 0.3));
	col = mix(col, deep.rgb, 0.35 * smoothstep(0.55, 0.0, uv.y + uv.x * 0.15) * (1.0 - menu_mix));
	col = mix(col, menu_tint.rgb, menu_mix * 0.55);

	// distorsione lenta dell'acqua
	vec2 q = p * 3.1 + vec2(t * 0.045, t * 0.02);
	vec2 warp = vec2(fbm2(q + vec2(0.0, t * 0.05)), fbm2(q + vec2(5.2, 1.3) - vec2(t * 0.04, 0.0))) - 0.5;
	// la superficie Ã¨ vista di sbieco: celle piÃ¹ larghe che alte, come nel SADX
	vec2 wq = vec2(p.x, p.y * 1.7);
	vec2 cp = wq * 2.6 + warp * 1.1 + vec2(t * 0.05, -t * 0.02);
	float e1 = cell_edge(cp, t * 0.9);
	float e2 = cell_edge(cp * 1.7 + vec2(3.7, 1.1) + warp * 0.6, t * 1.2);
	// spessore che cambia da zona a zona: linee sottili e fasci larghi, non un reticolo uniforme
	float wv = 0.05 + 0.10 * fbm(p * 2.0 + vec2(3.0 + t * 0.01, 1.0));
	float l1 = caustic_line(e1, wv, 0.35);
	float l2 = caustic_line(e2, wv * 0.8, 0.25);
	// dove i due strati si incrociano si accendono riflessi quasi bianchi
	float caus = l1 * 0.8 + l2 * 0.35 + l1 * l2 * 1.2;
	// zone di riverbero del sole che si spostano piano: lÃ¬ l'acqua sbianca, altrove le linee si attenuano
	float glare = smoothstep(0.45, 0.80, fbm(p * vec2(0.9, 1.4) + vec2(-t * 0.018, t * 0.006)));
	caus *= 0.5 + 0.8 * glare;
	vec3 line_col = vec3(0.88, 0.98, 1.0);
	col = mix(col, line_col, clamp(caus, 0.0, 1.0) * mix(0.92, 0.55, menu_mix));
	col = mix(col, vec3(0.80, 0.95, 1.0), glare * 0.22);

	// nuvole sfilacciate (a sinistra e in alto a destra), che scivolano lente
	vec2 cq = vec2(p.x * 1.5 - t * 0.012, p.y * 3.2);
	float cl = fbm(cq + fbm(cq * 1.7 + t * 0.01) * 0.9);
	float cloud_zone = smoothstep(0.62, 0.0, uv.x) * smoothstep(1.05, 0.25, uv.y) * 1.25
			+ smoothstep(0.55, 1.0, uv.x) * smoothstep(0.55, 0.05, uv.y) * 0.9;
	cloud_zone = mix(cloud_zone, 0.8 + 0.4 * smoothstep(0.6, 0.0, uv.y) + 0.3 * smoothstep(0.6, 1.0, uv.x), menu_mix);
	float clouds = smoothstep(0.40, 0.72, cl) * clamp(cloud_zone, 0.0, 1.0);
	col = mix(col, vec3(0.97, 0.99, 1.0), clouds * mix(0.8, 0.9, menu_mix));

	// grandi archi concentrici, appena visibili, che ruotano piano
	vec2 rc = mix(vec2(0.62 * aspect, 0.52), vec2(0.36 * aspect, 0.46), menu_mix);
	vec2 rd = p - rc;
	float ang = atan(rd.y, rd.x);
	float arcs = 0.0;
	arcs += ring(p, rc, 0.44, 0.008) * smoothstep(-0.5, 0.4, sin(ang * 1.0 + t * 0.05));
	arcs += ring(p, rc, 0.475, 0.004) * 0.8 * smoothstep(-0.6, 0.3, sin(ang * 1.0 - t * 0.04 + 2.0));
	arcs += ring(p, rc, 0.62, 0.012) * 0.6 * smoothstep(-0.3, 0.7, sin(ang + 1.0 + t * 0.03));
	arcs += ring(p, rc, 0.31, 0.005) * 0.55 * smoothstep(0.0, 0.8, sin(ang * 2.0 - t * 0.06));
	col = mix(col, vec3(1.0), clamp(arcs, 0.0, 1.0) * 0.75);

	// vignetta leggerissima
	col *= 1.0 - 0.10 * smoothstep(0.5, 1.2, length((uv - 0.5) * vec2(1.4, 1.0)));

	// righe di scansione (2-3 pixel reali)
	float px = max(2.0, floor(1.0 / SCREEN_PIXEL_SIZE.y / 360.0 + 0.5));
	float sl = step(px * 0.5, mod(FRAGCOORD.y, px));
	col *= 1.0 - 0.07 * sl;

	COLOR = vec4(col, 1.0);
}
␀␀␀// CHAOS CONTROL a tutto schermo (boss_design.md D S2 E4, E.2; pacchetto effetti, EglbFx.chaos_pulse):
// un'onda grigia parte da "center" (UV dello schermo, il punto nell'aria tra gli eroi ed Eggman) e
// attraversa il quadro (ripple_k 0..1 = da center a oltre i bordi), dietro di sÃ© desatura (tinta
// "tint"), sul fronte piega lo sfondo; "scan" righe orizzontali, "freeze" contrasto del quadro
// fermo. amount 0..1 dosa tutto (0 = spento).
shader_type canvas_item;
render_mode unshaded, blend_mix;

uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap, repeat_disable;
uniform float amount : hint_range(0.0, 1.0) = 0.0;
uniform float ripple_k : hint_range(0.0, 1.0) = 0.0;
uniform vec2 center = vec2(0.5, 0.5);
uniform float scan : hint_range(0.0, 1.0) = 0.0;
uniform vec4 tint : source_color = vec4(0.84, 0.87, 0.92, 1.0);
uniform float freeze : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec2 uv = SCREEN_UV;
	float aspect = SCREEN_PIXEL_SIZE.y / max(SCREEN_PIXEL_SIZE.x, 1e-6);
	vec2 d = uv - center;
	vec2 da = vec2(d.x * aspect, d.y);
	float r = length(da);
	float front = ripple_k * (1.2 + aspect * 0.5);
	float band = exp(-pow((r - front) / 0.05, 2.0)) * step(0.001, ripple_k);
	vec2 dir = r > 1e-4 ? da / r : vec2(0.0);
	vec2 off = vec2(dir.x / aspect, dir.y) * band * 0.025 * amount;
	vec3 c = textureLod(screen_tex, uv - off, 0.0).rgb;
	float lum = dot(c, vec3(0.299, 0.587, 0.114));
	float behind = smoothstep(front + 0.02, front - 0.08, r);
	float desat = clamp(behind * amount, 0.0, 1.0);
	vec3 g = vec3(lum) * tint.rgb;
	g = mix(g, clamp((g - 0.5) * 1.25 + 0.5, 0.0, 1.0), freeze);
	vec3 col = mix(c, g, desat);
	col += vec3(0.85, 0.9, 1.0) * band * 0.35 * amount;
	float line = 0.5 + 0.5 * sin(uv.y / max(SCREEN_PIXEL_SIZE.y, 1e-6) * 1.5708);
	float roll = smoothstep(0.0, 0.04, fract(uv.y * 0.7 - TIME * 0.45)) * (1.0 - smoothstep(0.04, 0.09, fract(uv.y * 0.7 - TIME * 0.45)));
	col *= 1.0 - scan * amount * (0.22 * line);
	col += vec3(roll) * scan * amount * 0.08;
	COLOR = vec4(col, step(0.001, amount));
}
␀␀␀␀␀␀␀␀␀// Increspatura del Chaos Control nel mondo (boss_design.md B.3, C.7; pacchetto effetti,
// EglbFx.chaos_ripple e chaos_warp): una sfera che si allarga (la scala la porta EglbFx), dentro lo
// sfondo (screen texture) desaturato in grigio ("desat"), sul guscio ("width": spessore, 0..1 del
// raggio visto) l'aria piegata e un bordo bianco-giallo; all'inizio il lampo ("pop") nel colore
// ring_col della tavolozza Heroes. k 0..1 avanzamento (0 il lampo, 1 sparita); alpha dosa tutto.
shader_type spatial;
render_mode unshaded, blend_mix, cull_back, depth_draw_never, shadows_disabled, fog_disabled;

uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap, repeat_disable;
uniform float k : hint_range(0.0, 1.0) = 0.0;
uniform vec4 ring_col : source_color = vec4(1.0, 0.97, 0.8, 1.0);
uniform float desat : hint_range(0.0, 1.0) = 1.0;
uniform float width : hint_range(0.0, 1.0) = 0.35;
uniform float alpha : hint_range(0.0, 1.0) = 1.0;

void fragment() {
	float facing = clamp(dot(NORMAL, VIEW), 0.0, 1.0);
	float edge = 1.0 - facing;
	float shell = smoothstep(1.0 - width, 1.0 - width * 0.35, edge);
	vec2 off = NORMAL.xy * 0.05 * shell * (1.0 - k);
	vec3 bg = textureLod(screen_tex, SCREEN_UV - off, 0.0).rgb;
	float lum = dot(bg, vec3(0.299, 0.587, 0.114));
	vec3 grey = vec3(lum) * vec3(0.9, 0.93, 0.98);
	float g = desat * mix(0.75, 1.0, shell) * (1.0 - k * 0.5);
	vec3 col = mix(bg, grey, g);
	float pop = exp(-k * 9.0);
	col += ring_col.rgb * (pow(edge, 4.0) * 1.8 * (1.0 - k) + pop * (1.0 - edge * 0.6) * 1.6);
	ALBEDO = col;
	ALPHA = clamp(alpha * (1.0 - smoothstep(0.7, 1.0, k)), 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀␀␀␀// Strato di nuvole cremisi sopra l'arena dei boss di Eggmanland (boss_design.md B.3, D F4 e F10,
// arena B; pacchetto effetti, EglbFx.cloud_deck). Un piano 600 m sopra O visto da sotto (e da sopra
// nel decollo del finale): il rumore delle nuvole dell'Atto 1 (noise_tex) tinto di cremisi, che
// scorre (scroll) e gira attorno al buco (swirl). Il buco nell'atmosfera del finale: hole_radius in
// metri attorno a hole_center (xz locali), bordo acceso (hole_glow), dentro lo spazio con le stelle
// (star_density); resta aperto per le lotte 2-3. punch_t (secondi da quando lo attraversano, < 0
// spento) e punch_pos: anello di vapore che si allarga e un lampo bianco (D F4). deck_size: lato del
// piano (il bordo sfuma). opacity 0 lo spegne.
shader_type spatial;
render_mode unshaded, blend_mix, cull_disabled, depth_draw_never, shadows_disabled, fog_disabled;

uniform sampler2D noise_tex : repeat_enable, filter_linear_mipmap;
uniform vec4 tint : source_color = vec4(0.62, 0.06, 0.08, 1.0);
uniform vec4 tint_dark : source_color = vec4(0.16, 0.012, 0.02, 1.0);
uniform float swirl = 0.0;
uniform float hole_radius = 0.0;
uniform float hole_glow = 0.0;
uniform vec2 hole_center = vec2(0.0, 0.0);
uniform float star_density = 0.6;
uniform float deck_size = 2400.0;
uniform vec2 scroll = vec2(0.004, 0.0015);
uniform float punch_t = -1.0;
uniform vec2 punch_pos = vec2(0.0, 0.0);
uniform float opacity = 1.0;

varying vec2 v_p;

void vertex() {
	v_p = VERTEX.xz;
}

float hash2(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void fragment() {
	vec2 p = v_p;
	vec2 q = p - hole_center;
	float dist = length(q);
	// gorgo attorno al buco: piÃ¹ forte vicino al bordo, lento nel tempo
	float ang = swirl * (2.2 * exp(-dist / (hole_radius + 160.0)) + TIME * 0.04);
	float cs = cos(ang);
	float sn = sin(ang);
	vec2 sp = hole_center + vec2(cs * q.x - sn * q.y, sn * q.x + cs * q.y);
	vec2 uv = sp / 900.0;
	float n1 = texture(noise_tex, uv + scroll * TIME).r;
	float n2 = texture(noise_tex, uv * 2.7 - scroll * TIME * 1.6 + vec2(0.37, 0.11)).r;
	float dens = smoothstep(0.25, 0.75, n1 * 0.65 + n2 * 0.35);
	vec3 col = mix(tint_dark.rgb, tint.rgb, dens);
	col += tint.rgb * pow(n2, 3.0) * 0.45;
	float a = mix(0.55, 1.0, dens);
	// il buco nell'atmosfera, con il bordo frastagliato dalle nuvole
	float edge_w = max(8.0, hole_radius * 0.12);
	float has_hole = step(0.01, hole_radius);
	float rr = dist + (n1 - 0.5) * edge_w * 1.4;
	float inside = (1.0 - smoothstep(hole_radius - edge_w * 0.3, hole_radius + edge_w * 0.7, rr)) * has_hole;
	vec2 cell = floor(p / 6.0);
	float h = hash2(cell);
	vec2 f = fract(p / 6.0) - 0.5 - (vec2(hash2(cell + 7.1), hash2(cell + 3.3)) - 0.5) * 0.6;
	float star = step(1.0 - star_density * 0.25, h) * smoothstep(0.14, 0.0, length(f));
	star *= 0.6 + 0.4 * sin(TIME * 3.0 + h * 40.0);
	vec3 space = vec3(0.004, 0.004, 0.014) + vec3(star) * 1.8;
	float ring = exp(-pow((rr - hole_radius) / edge_w, 2.0)) * hole_glow * has_hole;
	col = mix(col, space, inside);
	col += mix(vec3(1.0, 0.42, 0.14), vec3(1.0, 0.92, 0.75), clamp(ring, 0.0, 1.0)) * ring * 2.5;
	a = mix(a, 1.0, inside);
	// attraversamento: anello di vapore e lampo
	if (punch_t >= 0.0 && punch_t < 6.0) {
		float pr = 6.0 + punch_t * 70.0;
		float pd = length(p - punch_pos);
		float pring = exp(-pow((pd - pr) / (6.0 + punch_t * 10.0), 2.0)) * exp(-punch_t * 0.9);
		float flare = exp(-pd / 20.0) * exp(-punch_t * 5.0);
		col += vec3(1.0, 0.95, 0.9) * (pring * 1.5 + flare * 4.0);
		a = max(a, clamp(pring + flare, 0.0, 1.0));
	}
	float fadeout = 1.0 - smoothstep(deck_size * 0.36, deck_size * 0.5, length(p));
	ALBEDO = col;
	ALPHA = clamp(a * opacity * fadeout, 0.0, 1.0);
}
␀␀␀␀// Campo di energia della trappola di Eggman attorno a Super Sonic (boss_design.md I.1, I.2;
// pacchetto effetti, EglbTrapMachine): su una sfera di raggio 1.6 m. Bordo viola-blu in controluce
// (col_a al centro, col_b sul bordo, rim_power), fulmini che strisciano sulla superficie (bolt_rate
// scatti al secondo), crepe accese ("crack" 0..1: la scena le tiene basse, 0.25), increspatura dal
// punto colpito (hit_dir nello spazio della sfera, hit_t secondi dal pugno), "fade" la spegne.
// Additiva, a due facce, solo cosmetica.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform float crack : hint_range(0.0, 1.0) = 0.0;
uniform float energy = 1.2;
uniform vec4 col_a : source_color = vec4(0.55, 0.3, 1.0, 1.0);
uniform vec4 col_b : source_color = vec4(0.25, 0.55, 1.0, 1.0);
uniform float rim_power = 2.5;
uniform float bolt_rate = 9.0;
uniform float hit_t = 9.0;
uniform vec3 hit_dir = vec3(0.0, 0.0, 1.0);
uniform float fade = 1.0;

varying vec3 v_obj;

float hash3(vec3 p) {
	return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
}

float vn3(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	float a = mix(mix(hash3(i), hash3(i + vec3(1, 0, 0)), f.x), mix(hash3(i + vec3(0, 1, 0)), hash3(i + vec3(1, 1, 0)), f.x), f.y);
	float b = mix(mix(hash3(i + vec3(0, 0, 1)), hash3(i + vec3(1, 0, 1)), f.x), mix(hash3(i + vec3(0, 1, 1)), hash3(i + vec3(1, 1, 1)), f.x), f.y);
	return mix(a, b, f.z);
}

void vertex() {
	v_obj = normalize(VERTEX);
}

void fragment() {
	float facing = abs(dot(normalize(NORMAL), normalize(VIEW)));
	float rim = pow(1.0 - facing, rim_power);
	vec3 o = v_obj;
	// fulmini che strisciano: curve di livello di un rumore che scorre, accese a scatti
	float step_t = floor(TIME * bolt_rate);
	vec3 drift = vec3(TIME * 0.7, -TIME * 1.1, TIME * 0.4);
	float n1 = vn3(o * 3.2 + drift + vec3(step_t * 0.37));
	float n2 = vn3(o * 7.5 - drift * 1.6 + vec3(step_t * 0.11));
	float b1 = smoothstep(0.035, 0.0, abs(n1 - 0.5)) * step(0.35, hash3(vec3(step_t, 1.0, 2.0)) + 0.4);
	float b2 = smoothstep(0.025, 0.0, abs(n2 - 0.5)) * 0.6;
	float bolts = clamp(b1 + b2, 0.0, 1.5);
	float veil = 0.06 + 0.06 * vn3(o * 2.0 + drift * 0.5);
	// increspatura dal pugno
	float ang = acos(clamp(dot(o, normalize(hit_dir)), -1.0, 1.0));
	float ripple = smoothstep(0.3, 0.0, abs(ang - hit_t * 4.5)) * exp(-hit_t * 3.0) * 2.2;
	float spot = smoothstep(0.6, 0.0, ang) * exp(-hit_t * 8.0) * 2.5;
	// crepe
	float cn = vn3(o * 4.0) * 0.65 + vn3(o * 11.0) * 0.35;
	float cr = smoothstep(0.03, 0.0, abs(cn - 0.5)) * step(0.005, crack) * (0.5 + 1.5 * crack) * step(1.0 - crack * 1.6, vn3(o * 2.2 + 5.0) + 0.2);
	float a = veil + rim * 0.9 + bolts * (0.35 + 0.65 * rim) + ripple + spot + cr * 1.4;
	vec3 c = mix(col_a.rgb, col_b.rgb, clamp(rim + 0.3 * n1, 0.0, 1.0));
	c = mix(c, vec3(0.92, 0.9, 1.0), clamp(bolts * 0.6 + spot * 0.4 + cr * 0.5, 0.0, 1.0));
	ALBEDO = c * a * energy * fade;
}
␀␀␀␀␀// Le lettere "CHAOS CONTROL" (boss_design.md E.2; pacchetto effetti, EglbFx.glitch_text): su un
// TextureRect che mostra la parola giÃ  disegnata (SubViewport trasparente, la font del design).
// Gradiente cromato in tre colori (chrome_top, chrome_mid, chrome_bottom) con la linea
// dell'orizzonte a metÃ , separazione RGB ("split" in pixel della texture), strisce orizzontali
// spostate a scatti ("glitch" 0..1, "seed"), righe ("scan"), lampo bianco ("punch" 0..1,
// all'ingresso di ogni parola).
shader_type canvas_item;
render_mode unshaded, blend_mix;

uniform float split = 0.0;
uniform float glitch : hint_range(0.0, 1.0) = 0.0;
uniform vec4 chrome_top : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform vec4 chrome_mid : source_color = vec4(0.5, 0.56, 0.68, 1.0);
uniform vec4 chrome_bottom : source_color = vec4(0.95, 0.97, 1.0, 1.0);
uniform float scan : hint_range(0.0, 1.0) = 0.0;
uniform float seed = 0.0;
uniform float punch : hint_range(0.0, 1.0) = 0.0;

float h1(float n) {
	return fract(sin(n * 12.9898 + 78.233) * 43758.5453);
}

void fragment() {
	vec2 uv = UV;
	float t = floor(TIME * 24.0);
	float row = floor(uv.y * 14.0);
	float on = step(0.62, h1(row * 1.7 + t + seed * 3.0));
	uv.x += (h1(row + t * 3.1 + seed * 11.0) - 0.5) * 0.08 * glitch * on;
	vec2 so = vec2(split * TEXTURE_PIXEL_SIZE.x, 0.0);
	float ar = texture(TEXTURE, uv + so).a;
	float ag = texture(TEXTURE, uv).a;
	float ab = texture(TEXTURE, uv - so).a;
	float y = UV.y;
	vec3 ch = y < 0.5 ? mix(chrome_top.rgb, chrome_mid.rgb, smoothstep(0.18, 0.5, y)) : mix(chrome_mid.rgb * 0.45, chrome_bottom.rgb, smoothstep(0.5, 0.85, y));
	vec3 col = ch * ag;
	col += vec3(1.0, 0.12, 0.15) * max(ar - ag, 0.0);
	col += vec3(0.1, 0.75, 1.0) * max(ab - ag, 0.0);
	float a = max(ag, max(ar, ab));
	float sl = step(0.5, fract(UV.y / max(TEXTURE_PIXEL_SIZE.y, 1e-6) * 0.25));
	col *= 1.0 - scan * 0.35 * sl;
	col = mix(col, vec3(1.0), punch);
	COLOR = vec4(col, a);
}
␀␀␀␀␀␀␀// Passate a schermo della sequenza dei boss di Eggmanland (boss_design.md B.3; pacchetto effetti,
// EglbFx): un ColorRect a tutto schermo su un CanvasLayer che legge lo schermo.
//  mode 0 IMPATTO: soglia in bianco e nero, negativo nei fotogrammi dispari (frame_i), linee radiali
//         dal centro; 4-6 fotogrammi a 60 fps (EglbFx.impact_frames), mai un taglio nel mezzo.
//  mode 1 CONFUSIONE (vista di Knuckles, S4 T12): sfocatura, doppia immagine, aberrazione, vignetta.
//  mode 2 RADIALE (FIN F10): sfocatura verso il centro.
//  mode 3 LAMPO: il colore tint su tutto (alpha = amount * tint.a).
// amount 0 = spento (il nodo resta nascosto da EglbFx quando amount Ã¨ 0).
shader_type canvas_item;
render_mode unshaded, blend_mix;

uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap, repeat_disable;
uniform int mode = 0;
uniform float amount : hint_range(0.0, 1.0) = 0.0;
uniform int frame_i = 0;
uniform vec2 center = vec2(0.5, 0.5);
uniform float threshold : hint_range(0.0, 1.0) = 0.42;
uniform float lines : hint_range(0.0, 1.0) = 1.0;
uniform float seed = 0.0;
uniform vec4 tint : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform float blur : hint_range(0.0, 1.0) = 0.0;
uniform float chroma : hint_range(0.0, 1.0) = 0.0;
uniform float vignette : hint_range(0.0, 1.0) = 0.0;

float hash1(float n) {
	return fract(sin(n * 12.9898 + 4.1414) * 43758.5453);
}

vec3 scr(vec2 uv, float lod) {
	return textureLod(screen_tex, clamp(uv, vec2(0.001), vec2(0.999)), lod).rgb;
}

void fragment() {
	vec2 uv = SCREEN_UV;
	float aspect = SCREEN_PIXEL_SIZE.y / max(SCREEN_PIXEL_SIZE.x, 1e-6);
	vec2 d = uv - center;
	vec2 da = vec2(d.x * aspect, d.y);
	float r = length(da);
	vec3 col = scr(uv, 0.0);
	float a = amount;
	if (mode == 0) {
		float lum = dot(col, vec3(0.299, 0.587, 0.114));
		float bw = step(threshold, lum);
		// raggi: settori angolari accesi a caso (cambiano a ogni fotogramma), piÃ¹ fitti lontano dal centro
		float ang = atan(da.y, da.x);
		float sect = floor((ang + PI) / TAU * 90.0);
		float h = hash1(sect + seed * 17.0 + float(frame_i) * 31.0);
		float ray = step(0.72, h) * smoothstep(0.06 + 0.3 * h, 0.55, r) * lines;
		// un disco nero attorno al centro dell'impatto nei primi fotogrammi
		float core = smoothstep(0.09, 0.03, r) * step(float(frame_i), 1.5);
		bw = clamp(max(bw, ray) - core, 0.0, 1.0);
		if (frame_i % 2 == 1) {
			bw = 1.0 - bw;
		}
		col = mix(vec3(0.0), tint.rgb, bw);
	} else if (mode == 1) {
		float t = TIME;
		vec2 wob = vec2(sin(t * 1.7), cos(t * 1.3)) * 0.012 * amount;
		float lod = blur * 4.0;
		vec2 dbl = vec2(0.018 + 0.01 * sin(t * 2.3), 0.006 * cos(t * 1.9)) * amount;
		vec2 ch = d * 0.025 * chroma;
		vec3 c1;
		c1.r = scr(uv + wob + ch, lod).r;
		c1.g = scr(uv + wob, lod).g;
		c1.b = scr(uv + wob - ch, lod).b;
		vec3 c2 = scr(uv + wob + dbl, lod + 0.5);
		col = mix(c1, c2, 0.4 * amount);
		float v = smoothstep(0.35, 0.95, r) * vignette;
		col *= 1.0 - v;
		col = mix(col, col * tint.rgb, 0.3 * amount);
	} else if (mode == 2) {
		vec3 acc = vec3(0.0);
		float k = 0.12 * amount;
		for (int i = 0; i < 10; i++) {
			float s = 1.0 - k * float(i) / 9.0;
			acc += scr(center + d * s, blur * 2.0);
		}
		col = acc / 10.0;
		col *= 1.0 - smoothstep(0.4, 1.0, r) * vignette;
		col = mix(col, tint.rgb, 0.15 * amount * tint.a);
	} else {
		col = tint.rgb;
		a = amount * tint.a;
	}
	COLOR = vec4(col, clamp(a, 0.0, 1.0));
}
␀␀// Griglia di lava sopra la fossa dell'arena dei boss di Eggmanland (boss_design.md B.3; pacchetto
// effetti, EglbFx.lava_grating). Opaca (niente trasparenza): sbarre di metallo scuro in una maglia
// quadrata e, nei vuoti, la lava che scorre 0.8 m piÃ¹ sotto (parallasse finta, emissiva). "bars":
// sbarre lungo i 24 m del diametro della fossa; "heat" luminositÃ  della lava; "scroll" velocitÃ 
// della colata; "crack" 0..1 crepe accese sulle sbarre (arena B, dopo il colpo finale).
shader_type spatial;
render_mode cull_back, diffuse_burley, specular_schlick_ggx;

uniform float heat = 1.0;
uniform float scroll = 0.15;
uniform float bars = 16.0;
uniform vec4 hot : source_color = vec4(1.0, 0.62, 0.12, 1.0);
uniform vec4 warm : source_color = vec4(0.55, 0.05, 0.0, 1.0);
uniform vec4 metal : source_color = vec4(0.13, 0.11, 0.11, 1.0);
uniform float crack = 0.0;

varying vec3 v_obj;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float vn(vec2 x) {
	vec2 i = floor(x);
	vec2 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}

float fbm(vec2 p) {
	float s = 0.0;
	float a = 0.5;
	for (int i = 0; i < 4; i++) {
		s += a * vn(p);
		p = p * 2.03 + vec2(1.7, 9.2);
		a *= 0.5;
	}
	return s;
}

void vertex() {
	v_obj = VERTEX;
}

void fragment() {
	vec2 p = v_obj.xz;
	float pitch = 24.0 / max(bars, 1.0);
	vec2 fg = abs(fract(p / pitch) - 0.5);
	float main_bar = smoothstep(0.34, 0.38, fg.x);
	float cross_bar = smoothstep(0.42, 0.45, fg.y);
	float bar = max(main_bar, cross_bar);
	// la lava 0.8 m sotto la griglia, vista attraverso i vuoti
	vec3 vw = (INV_VIEW_MATRIX * vec4(VIEW, 0.0)).xyz;
	vec2 lp = p - vw.xz / max(vw.y, 0.25) * 0.8;
	float n = fbm(lp * 0.35 + vec2(TIME * scroll, TIME * scroll * 0.6));
	float n2 = fbm(lp * 1.1 - vec2(TIME * scroll * 1.7, 0.0));
	float lav = smoothstep(0.3, 0.8, n * 0.7 + n2 * 0.3);
	vec3 lava = mix(warm.rgb, hot.rgb, lav) * (0.5 + 1.8 * heat);
	// i bordi delle sbarre arrossati dal calore sotto
	float lip = (1.0 - smoothstep(0.0, 0.06, fg.x - 0.34)) * main_bar + (1.0 - smoothstep(0.0, 0.04, fg.y - 0.42)) * cross_bar;
	float cn = fbm(p * 0.6) * 0.7 + vn(p * 3.1) * 0.3;
	float cr = smoothstep(0.035, 0.0, abs(cn - 0.5)) * crack * (0.7 + 0.3 * sin(TIME * 2.0 + p.x));
	ALBEDO = mix(vec3(0.02, 0.01, 0.01), metal.rgb, bar);
	METALLIC = bar * 0.8;
	ROUGHNESS = mix(1.0, 0.55, bar);
	EMISSION = mix(lava, warm.rgb * heat * 0.6 * clamp(lip, 0.0, 1.0) + hot.rgb * cr * 4.0, bar);
}
␀␀␀␀␀␀// Metallo liquido sulla pelle di Neo Metal Sonic (boss_design.md D S3 G3-G4; pacchetto effetti,
// EglbFx.liquid_metal): sovrapposto ai materiali (material_overlay). Cromo che scorre ("flow"),
// riflesso finto di un cielo a bande (tint chiaro sopra, tint_dark sotto), bordo acceso in
// controluce ("rim"), increspatura dei vertici ("ripple", metri); "amount" 0..1 quanta pelle Ã¨
// coperta (macchie che crescono fino a coprire tutto), "dissolve" 0..1 la copertura che si sfalda.
shader_type spatial;
render_mode unshaded, blend_mix, cull_back, depth_draw_never, shadows_disabled;

uniform float amount : hint_range(0.0, 1.0) = 0.0;
uniform float flow = 0.6;
uniform float ripple = 0.0;
uniform vec4 tint : source_color = vec4(0.82, 0.88, 0.95, 1.0);
uniform vec4 tint_dark : source_color = vec4(0.18, 0.22, 0.3, 1.0);
uniform float rim = 0.6;
uniform float dissolve : hint_range(0.0, 1.0) = 0.0;

varying vec3 v_obj;

float hash3(vec3 p) {
	return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
}

float vn3(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	float a = mix(mix(hash3(i), hash3(i + vec3(1, 0, 0)), f.x), mix(hash3(i + vec3(0, 1, 0)), hash3(i + vec3(1, 1, 0)), f.x), f.y);
	float b = mix(mix(hash3(i + vec3(0, 0, 1)), hash3(i + vec3(1, 0, 1)), f.x), mix(hash3(i + vec3(0, 1, 1)), hash3(i + vec3(1, 1, 1)), f.x), f.y);
	return mix(a, b, f.z);
}

void vertex() {
	v_obj = VERTEX;
	float w = sin(VERTEX.y * 9.0 - TIME * 5.0 * flow) * 0.5 + vn3(VERTEX * 4.0 + vec3(0.0, -TIME * flow, 0.0)) - 0.5;
	VERTEX += NORMAL * (0.004 + ripple * w) * step(0.001, amount);
}

void fragment() {
	vec3 p = v_obj * 5.0 + vec3(0.0, -TIME * flow, TIME * flow * 0.3);
	float n = vn3(p) * 0.6 + vn3(p * 2.3) * 0.4;
	vec3 nrm = normalize(NORMAL + (vec3(vn3(p + 3.1), vn3(p + 7.7), vn3(p + 1.3)) - 0.5) * 0.9);
	vec3 refl = reflect(-VIEW, nrm);
	float sky = smoothstep(-0.15, 0.3, refl.y);
	float band = smoothstep(0.02, 0.0, abs(refl.y - 0.05)) * 0.8;
	vec3 col = mix(tint_dark.rgb, tint.rgb, sky) + vec3(band) + tint.rgb * pow(max(refl.y, 0.0), 24.0) * 2.0;
	float fres = pow(1.0 - clamp(dot(nrm, VIEW), 0.0, 1.0), 3.0);
	col += tint.rgb * fres * rim;
	float cover = smoothstep(1.0 - amount - 0.08, 1.0 - amount + 0.08, n * 0.98 + 0.01);
	float dn = vn3(v_obj * 7.0);
	float keep = smoothstep(dissolve - 0.05, dissolve + 0.05, dn);
	float edge = (1.0 - abs(keep * 2.0 - 1.0)) * step(0.001, dissolve);
	col += vec3(0.7, 0.85, 1.0) * edge * 1.5;
	ALBEDO = col;
	ALPHA = clamp(cover * keep * step(0.001, amount), 0.0, 1.0);
}
// Funzioni comuni agli effetti Glitter (Generations/Unleashed).
// I colori di Glitter sono in spazio sRGB (gamma): convertiti in lineare per il renderer di Godot.
vec3 gens_srgb_to_linear(vec3 c) {
	vec3 lo = c / 12.92;
	vec3 hi = pow((max(c, vec3(0.0)) + 0.055) / 1.055, vec3(2.4));
	return mix(lo, hi, step(vec3(0.04045), c));
}
␀␀␀// Particelle "Mesh" di Glitter (coni del boost, gusci della palla, onde dello stomp).
// tint: colore della particella (sRGB, alfa compresa) impostato per istanza.
#include "res://shaders/vfx/gens/gens_common.gdshaderinc"

uniform sampler2D tex : source_color, filter_linear_mipmap, repeat_enable;
uniform float gain = 1.0;
instance uniform vec4 tint = vec4(1.0);

void fragment() {
	vec4 t = texture(tex, UV);
	ALBEDO = t.rgb * gens_srgb_to_linear(tint.rgb) * gain;
	ALPHA = clamp(t.a * tint.a, 0.0, 1.0);
}
␀␀shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;
#include "res://shaders/vfx/gens/gens_mesh.gdshaderinc"
␀shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_back, shadows_disabled, fog_disabled;
#include "res://shaders/vfx/gens/gens_mesh.gdshaderinc"
␀␀␀␀␀// Quad delle particelle Glitter disegnati con una MultiMesh (un'istanza per particella).
// INSTANCE_CUSTOM: x = fotogramma dell'atlante, y = colonne + righe*16,
// z = perno X, w = perno Y + 10*modo (0 billboard, 1 orientato, 2 allineato alla velocita').
// Per il billboard la base dell'istanza contiene rotazione e scala 2D (spazio vista);
// per il modo 2 la colonna Y e' la direzione del moto (in mondo) gia' scalata.
#include "res://shaders/vfx/gens/gens_common.gdshaderinc"

uniform sampler2D tex : source_color, filter_linear_mipmap, repeat_disable;
uniform float gain = 1.0;

varying vec4 v_color;

void vertex() {
	vec4 cu = INSTANCE_CUSTOM;
	float mode = floor(cu.w / 10.0 + 0.5);
	vec2 piv = vec2(cu.z, cu.w - mode * 10.0);
	vec2 q = VERTEX.xy + piv;
	vec3 o = MODEL_MATRIX[3].xyz;
	vec3 vp;
	if (mode < 0.5) {
		vec3 c = (VIEW_MATRIX * vec4(o, 1.0)).xyz;
		vp = c + vec3(MODEL_MATRIX[0].xy * q.x + MODEL_MATRIX[1].xy * q.y, 0.0);
	} else if (mode < 1.5) {
		vp = (VIEW_MATRIX * (MODEL_MATRIX * vec4(q, 0.0, 1.0))).xyz;
	} else {
		vec3 c = (VIEW_MATRIX * vec4(o, 1.0)).xyz;
		vec3 d = (VIEW_MATRIX * vec4(MODEL_MATRIX[1].xyz, 0.0)).xyz;
		float w = MODEL_MATRIX[0].x;
		vec2 dn = length(d.xy) > 1e-5 ? normalize(d.xy) : vec2(0.0, 1.0);
		vec2 side = vec2(dn.y, -dn.x);
		vp = c + vec3(side * q.x * w + d.xy * q.y, d.z * q.y);
	}
	VERTEX = vp;
	float cols = mod(cu.y, 16.0);
	float rows = floor(cu.y / 16.0 + 0.001);
	cols = max(cols, 1.0);
	rows = max(rows, 1.0);
	float f = cu.x;
	vec2 cell = vec2(mod(f, cols), mod(floor(f / cols), rows));
	UV = (cell + UV) / vec2(cols, rows);
	v_color = vec4(gens_srgb_to_linear(COLOR.rgb), COLOR.a);
}

void fragment() {
	vec4 t = texture(tex, UV);
	ALBEDO = t.rgb * v_color.rgb * gain;
	ALPHA = clamp(t.a * v_color.a, 0.0, 1.0);
}
␀␀␀␀␀␀␀␀shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled, skip_vertex_transform;
#include "res://shaders/vfx/gens/gens_quad.gdshaderinc"
␀␀␀␀␀␀␀␀␀␀shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled, skip_vertex_transform;
#include "res://shaders/vfx/gens/gens_quad.gdshaderinc"
␀␀␀␀␀␀␀␀␀␀// Scie a nastro (particelle "Locus" di Glitter, scia della palla): la linea centrale arriva
// in VERTEX, la tangente in NORMAL e la mezza larghezza (con segno) in UV2.x; il nastro
// si apre sempre verso la camera. UV.x lungo la scia (0 = testa), UV.y attraverso.
#include "res://shaders/vfx/gens/gens_common.gdshaderinc"

uniform sampler2D tex : source_color, filter_linear_mipmap, repeat_enable;
uniform float gain = 1.0;
uniform float edge_soft = 0.5;

varying vec4 v_color;

void vertex() {
	vec3 p = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	vec3 t = (MODELVIEW_MATRIX * vec4(NORMAL, 0.0)).xyz;
	vec3 s = cross(t, p);
	if (length(s) < 1e-6) {
		s = vec3(1.0, 0.0, 0.0);
	}
	VERTEX = p + normalize(s) * UV2.x;
	v_color = vec4(gens_srgb_to_linear(COLOR.rgb), COLOR.a);
}

void fragment() {
	vec4 t = texture(tex, UV);
	float e = 1.0 - abs(UV.y * 2.0 - 1.0);
	float edge = edge_soft > 0.001 ? smoothstep(0.0, edge_soft, e) : 1.0;
	ALBEDO = t.rgb * v_color.rgb * gain;
	ALPHA = clamp(t.a * v_color.a * edge, 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled, skip_vertex_transform;
#include "res://shaders/vfx/gens/gens_ribbon.gdshaderinc"
␀␀␀␀␀␀␀␀shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled, skip_vertex_transform;
#include "res://shaders/vfx/gens/gens_ribbon.gdshaderinc"
␀␀␀␀␀␀␀␀shader_type particles;
// Proiettili della schiacciata (spazio locale, terreno a y = 0, metri per radius = 9):
//   mode 0: zolle di sabbia che volano ad arco, ricadono e si sfaldano nella sabbia;
//   mode 1: spruzzi di sabbia veloci e radenti (strisce allineate alla velocitÃ );
//   mode 2: sassi e frammenti (mesh illuminata) che ruotano, rimbalzano una volta e restano;
//   mode 3: scintille dell'impatto (strisce additive brevissime).
// Le strisce (1, 3) portano nell'asse Y della particella la scia (velocitÃ  * durata).
// CasualitÃ  solo da NUMBER e seed: deterministica.

uniform int mode = 0;
uniform float radius = 9.0;
uniform float strength = 1.0;
uniform int seed = 1;

float h(uint n) {
	n = (n << 13u) ^ n;
	n = n * (n * n * 15731u + 789221u) + 1376312589u;
	return float(n & 0x7fffffffu) / 2147483647.0;
}

uint base_seed(uint num) {
	return num * 13u + uint(seed) * 7919u + uint(mode) * 15485863u;
}

mat3 axis_rot(vec3 ax, float a) {
	float c = cos(a);
	float s = sin(a);
	float t = 1.0 - c;
	return mat3(
		vec3(t * ax.x * ax.x + c, t * ax.x * ax.y + s * ax.z, t * ax.x * ax.z - s * ax.y),
		vec3(t * ax.x * ax.y - s * ax.z, t * ax.y * ax.y + c, t * ax.y * ax.z + s * ax.x),
		vec3(t * ax.x * ax.z + s * ax.y, t * ax.y * ax.z - s * ax.x, t * ax.z * ax.z + c));
}

void start() {
	uint s = base_seed(NUMBER);
	float r1 = h(s + 1u);
	float r2 = h(s + 2u);
	float r3 = h(s + 3u);
	float r4 = h(s + 4u);
	float r5 = h(s + 5u);
	float k = radius / 9.0;
	float sk = sqrt(k) * mix(0.7, 1.0, clamp(strength, 0.0, 1.5));
	float a = r1 * 6.2831853;
	vec2 d = vec2(cos(a), sin(a));
	float elev;
	float sp;
	float sz;
	float y0 = 0.15;
	if (mode == 0) {
		elev = mix(0.4, 1.3, r2);
		sp = mix(5.0, 13.0, r3 * r3) * sk;
		sz = mix(0.1, 0.32, r5 * r5) * k;
	} else if (mode == 1) {
		elev = mix(0.06, 0.45, r2 * r2);
		sp = mix(8.0, 20.0, r3) * sk;
		sz = mix(0.6, 1.0, r5);
	} else if (mode == 2) {
		elev = mix(0.55, 1.3, r2);
		sp = mix(4.5, 12.0, r3 * r3) * sk;
		sz = mix(0.08, 0.27, r5 * r5) * k;
	} else {
		elev = mix(0.08, 1.35, r2);
		sp = mix(9.0, 24.0, r3) * sk;
		sz = mix(0.5, 1.0, r5);
		y0 = 0.3;
	}
	vec3 dir = vec3(d.x * cos(elev), sin(elev), d.y * cos(elev));
	TRANSFORM = mat4(1.0);
	TRANSFORM[0].x = 1e-4;
	TRANSFORM[1].y = 1e-4;
	TRANSFORM[2].z = 1e-4;
	TRANSFORM[3].xyz = vec3(d.x * r4 * 0.5 * k, y0 * k, d.y * r4 * 0.5 * k);
	VELOCITY = dir * sp;
	// x = angolo di rotazione, y = etÃ  0..1, z = dimensione, w = istante dell'atterraggio (0 = in volo)
	CUSTOM = vec4(r4 * 6.2831853, 0.0, sz, 0.0);
	COLOR = vec4(1.0, mix(0.85, 1.1, r1), 0.0, 0.0);
}

void process() {
	CUSTOM.y += DELTA / LIFETIME;
	float t = CUSTOM.y;
	uint s = base_seed(NUMBER);
	float q1 = h(s + 21u);
	float k = radius / 9.0;
	float g = mode == 3 ? 6.0 : (mode == 1 ? 13.0 : 17.0);
	float drag = mode == 1 ? 1.6 : (mode == 3 ? 3.5 : 0.35);
	vec3 p = TRANSFORM[3].xyz;
	if (CUSTOM.w <= 0.0) {
		VELOCITY.y -= g * k * DELTA;
		VELOCITY *= exp(-drag * DELTA);
		float ny = p.y + VELOCITY.y * DELTA;
		if (ny < 0.0 && VELOCITY.y < 0.0) {
			if (mode == 2 && COLOR.b < 0.5) {
				// un rimbalzo smorzato, poi si posa
				VELOCITY.y *= -0.32;
				VELOCITY.xz *= 0.45;
				COLOR.b = 1.0;
			} else {
				CUSTOM.w = max(t, 1e-4);
				VELOCITY = vec3(0.0);
				TRANSFORM[3].y = mode == 2 ? CUSTOM.z * 0.35 : 0.0;
			}
		}
	}
	float landed_for = CUSTOM.w > 0.0 ? (t - CUSTOM.w) * LIFETIME : -1.0;
	if (mode == 1 || mode == 3) {
		// striscia: asse Y = scia (velocitÃ  * durata), X/Z = scala dello spessore
		float trail = mode == 1 ? 0.07 : 0.04;
		vec3 tr = VELOCITY * trail;
		if (length(tr) < 1e-4) {
			tr = vec3(0.0, 1e-4, 0.0);
		}
		float w = CUSTOM.z * k;
		float a;
		if (mode == 1) {
			a = smoothstep(0.0, 0.04, t) * (1.0 - smoothstep(0.2, 0.8, t)) * 0.6;
			if (landed_for >= 0.0) {
				a = 0.0;
			}
		} else {
			a = (1.0 - smoothstep(0.1, 1.0, t)) * 1.0;
		}
		TRANSFORM[0].xyz = vec3(w, 0.0, 0.0);
		TRANSFORM[1].xyz = tr;
		TRANSFORM[2].xyz = vec3(0.0, 0.0, w);
		COLOR.a = a;
		if (a <= 0.0) {
			ACTIVE = false;
		}
	} else {
		float spin_rate = mix(4.0, 14.0, q1) * (mode == 2 ? 1.0 : 0.6);
		if (CUSTOM.w <= 0.0) {
			CUSTOM.x += spin_rate * DELTA;
		}
		vec3 ax = normalize(vec3(h(s + 22u), h(s + 23u), h(s + 24u)) - 0.5 + vec3(1e-3));
		float sc = CUSTOM.z * smoothstep(0.0, 0.03, t);
		vec3 squash = vec3(1.0);
		if (mode == 0) {
			// la zolla atterrata si spiaccica e affonda nella sabbia
			if (landed_for >= 0.0) {
				float f = clamp(landed_for / 0.45, 0.0, 1.0);
				squash = vec3(1.0 + f * 0.8, 1.0 - f * 0.85, 1.0 + f * 0.8);
				sc *= 1.0 - f * 0.55;
				if (f >= 1.0) {
					ACTIVE = false;
				}
			}
		} else {
			sc *= 1.0 - smoothstep(0.85, 1.0, t);
		}
		mat3 b = axis_rot(ax, CUSTOM.x) * (sc + 1e-4);
		if (mode == 0) {
			// billboard: niente rotazione 3D, solo scala (lo schiacciamento va in Y mondo)
			b = mat3(vec3(sc * squash.x, 0.0, 0.0), vec3(0.0, sc * squash.y, 0.0), vec3(0.0, 0.0, sc * squash.z));
		}
		TRANSFORM[0].xyz = b[0];
		TRANSFORM[1].xyz = b[1];
		TRANSFORM[2].xyz = b[2];
		COLOR.a = 1.0;
	}
}
␀␀␀␀␀␀␀shader_type spatial;
// Zolla di sabbia: billboard opaco a forma di grumo irregolare (scarto dei pixel), con luce
// finta da sfera verso il sole del livello. Opaco = niente ordinamento, costa pochissimo.

render_mode unshaded, cull_disabled, shadows_disabled;

uniform sampler2D noise_a : filter_linear_mipmap, repeat_enable;
uniform vec3 sun_dir = vec3(0.45, 0.75, 0.48);
uniform vec3 lit_col = vec3(0.95, 0.68, 0.36);
uniform vec3 shade_col = vec3(0.28, 0.19, 0.10);

varying vec4 v_custom;
varying vec3 v_sun;
varying float v_squash;

void vertex() {
	vec3 sc = vec3(length(MODEL_MATRIX[0].xyz), length(MODEL_MATRIX[1].xyz), length(MODEL_MATRIX[2].xyz));
	// billboard che perÃ² mantiene lo schiacciamento verticale (zolla spiaccicata)
	v_squash = sc.y / max(sc.x, 1e-5);
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0] * sc.x, INV_VIEW_MATRIX[1] * sc.y, INV_VIEW_MATRIX[2] * sc.x, MODEL_MATRIX[3]);
	v_custom = INSTANCE_CUSTOM;
	v_sun = normalize((VIEW_MATRIX * vec4(sun_dir, 0.0)).xyz);
}

void fragment() {
	vec2 c = (UV - 0.5) * 2.0;
	c.y = -c.y;
	float a = v_custom.x;
	vec2 cr = mat2(vec2(cos(a), sin(a)), vec2(-sin(a), cos(a))) * c;
	vec2 o = vec2(fract(v_custom.x * 0.37), fract(v_custom.z * 13.1));
	float n = texture(noise_a, cr * 0.22 + o).r;
	float n2 = texture(noise_a, cr * 0.6 + o * 1.7).r;
	float r = length(c);
	if (r + (n - 0.5) * 0.9 > 0.78) {
		discard;
	}
	vec3 nrm = normalize(vec3(c * 1.1 + (vec2(n, n2) - 0.5) * 1.2, sqrt(max(1.0 - r * r, 0.05))));
	float l = clamp(dot(nrm, v_sun) * 0.75 + 0.35, 0.0, 1.0);
	ALBEDO = mix(shade_col, lit_col, l) * (0.82 + 0.3 * n2) * COLOR.g;
}
shader_type spatial;
// Sbuffo di sabbia: billboard morbido col rumore, luce finta da una sfera (sole del livello)
// e particella "morbida" (sfuma dove tocca il terreno, niente tagli netti).

render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled;

uniform sampler2D noise_a : filter_linear_mipmap, repeat_enable;
uniform sampler2D depth_tex : hint_depth_texture, filter_nearest, repeat_disable;
uniform vec3 sun_dir = vec3(0.45, 0.75, 0.48);   // verso il sole, spazio mondo
uniform vec3 lit_col = vec3(1.18, 0.94, 0.62);
uniform vec3 shade_col = vec3(0.44, 0.36, 0.27);
uniform float soft = 0.7;
uniform float t_time = 0.0;

varying vec4 v_custom;
varying vec3 v_sun;

void vertex() {
	vec3 sc = vec3(length(MODEL_MATRIX[0].xyz), length(MODEL_MATRIX[1].xyz), length(MODEL_MATRIX[2].xyz));
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0] * sc.x, INV_VIEW_MATRIX[1] * sc.y, INV_VIEW_MATRIX[2] * sc.z, MODEL_MATRIX[3]);
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
	v_custom = INSTANCE_CUSTOM;
	v_sun = normalize((VIEW_MATRIX * vec4(sun_dir, 0.0)).xyz);
}

void fragment() {
	vec2 c = (UV - 0.5) * 2.0;
	c.y = -c.y;
	float a = v_custom.x;
	vec2 cr = mat2(vec2(cos(a), sin(a)), vec2(-sin(a), cos(a))) * c;
	float n = texture(noise_a, cr * 0.32 + v_custom.ww * 3.7 + vec2(t_time * 0.015, 0.0)).r;
	float n2 = texture(noise_a, cr * 0.85 - v_custom.ww * 5.1 + vec2(0.0, t_time * 0.03)).r;
	float r = length(c);
	float rr = r + (n - 0.5) * 0.85;
	float puff = 1.0 - smoothstep(0.38, 0.78, rr);
	puff *= 0.7 + 0.4 * n2;
	// normale di una sfera bitorzoluta, luce del sole + controluce morbida
	vec3 nrm = normalize(vec3(c * 0.9 + (vec2(n, n2) - 0.5) * 0.9, sqrt(max(1.0 - r * r, 0.08))));
	float l = clamp(dot(nrm, v_sun) * 0.8 + 0.38, 0.0, 1.0);
	vec3 col = mix(shade_col, lit_col, l) * vec3(COLOR.r, mix(1.0, COLOR.r, 0.85), mix(1.0, COLOR.r, 0.6)) * COLOR.g;
	ALBEDO = col;
	float dep = texture(depth_tex, SCREEN_UV).r;
	vec4 vp = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, dep, 1.0);
	float scene_z = -vp.z / vp.w;
	float fade = clamp((scene_z + VERTEX.z) / soft, 0.0, 1.0);
	ALPHA = clamp(COLOR.a * puff, 0.0, 1.0) * fade;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type particles;
// Polvere di sabbia della schiacciata (spazio locale, terreno a y = 0, metri per radius = 9).
//   mode 0: anello di sbuffi sparati raso terra che frenano a 0.3..1 raggio e poi si gonfiano
//           e salgono lenti (il "muro" di sabbia che si allarga);
//   mode 1: colonna centrale che sale dal punto dell'impatto.
// CasualitÃ  solo da NUMBER e seed: deterministica.

uniform int mode = 0;
uniform float radius = 9.0;
uniform float strength = 1.0;
uniform int seed = 1;

float h(uint n) {
	n = (n << 13u) ^ n;
	n = n * (n * n * 15731u + 789221u) + 1376312589u;
	return float(n & 0x7fffffffu) / 2147483647.0;
}

uint base_seed(uint num) {
	return num * 7u + uint(seed) * 7919u + uint(mode) * 104729u;
}

void start() {
	uint s = base_seed(NUMBER);
	float r1 = h(s + 1u);
	float r2 = h(s + 2u);
	float r3 = h(s + 3u);
	float r4 = h(s + 4u);
	float r5 = h(s + 5u);
	float r6 = h(s + 6u);
	float k = radius / 9.0;
	float st = mix(0.75, 1.0, clamp(strength, 0.0, 1.5));
	vec3 pos;
	vec3 vel;
	float life;
	if (mode == 0) {
		float a = float(NUMBER) * 2.3999632 + r1 * 0.6;
		vec2 d = vec2(cos(a), sin(a));
		float reach = mix(0.22, 1.0, pow(r2, 0.8)) * radius * st;
		float sp = reach * 3.4 * mix(0.9, 1.1, r3);
		pos = vec3(d.x * 0.5 * k, mix(0.2, 0.7, r4) * k, d.y * 0.5 * k);
		vel = vec3(d.x * sp, mix(0.6, 4.5, r5 * r5) * k * st, d.y * sp);
		life = mix(0.55, 1.0, r6);
	} else {
		float a = r1 * 6.2831853;
		vec2 d = vec2(cos(a), sin(a)) * sqrt(r2);
		pos = vec3(d.x * 0.7 * k, 0.4 * k, d.y * 0.7 * k);
		float up = mix(3.0, 12.0, r4 * r4) * k * st;
		vel = vec3(d.x * mix(1.5, 5.5, r3) * k, up, d.y * mix(1.5, 5.5, r3) * k);
		life = mix(0.5, 1.0, r6);
	}
	TRANSFORM = mat4(1.0);
	TRANSFORM[0].x = 1e-3;
	TRANSFORM[1].y = 1e-3;
	TRANSFORM[2].z = 1e-3;
	TRANSFORM[3].xyz = pos;
	VELOCITY = vel;
	// x = rotazione del billboard, y = etÃ  0..1, z = durata relativa, w = variazione
	CUSTOM = vec4(r6 * 6.2831853, 0.0, life, r3);
	COLOR = vec4(1.0, 1.0, 1.0, 0.0);
}

void process() {
	CUSTOM.y += DELTA / LIFETIME;
	uint s = base_seed(NUMBER);
	float q1 = h(s + 11u);
	float q2 = h(s + 12u);
	float q3 = h(s + 13u);
	float t = CUSTOM.y / CUSTOM.z;
	if (t >= 1.0) {
		ACTIVE = false;
	}
	float age = CUSTOM.y * LIFETIME;
	float k = radius / 9.0;
	vec3 p = TRANSFORM[3].xyz;
	float drag_h = mode == 0 ? 3.4 : 1.8;
	float drag_v = mode == 0 ? 2.6 : 1.4;
	float buoy = mode == 0 ? mix(0.25, 0.9, q1) * k : 0.35 * k;
	VELOCITY.xz *= exp(-drag_h * DELTA);
	VELOCITY.y = VELOCITY.y * exp(-drag_v * DELTA) + buoy * DELTA;
	// turbolenza morbida (rotolamento verso l'esterno degli sbuffi)
	vec3 turb = vec3(sin(p.z * 0.7 + age * 1.3 + q2 * 6.0), 0.0, cos(p.x * 0.7 - age * 1.1 + q3 * 6.0)) * 0.6 * k;
	VELOCITY += turb * DELTA;
	float s0 = (mode == 0 ? mix(0.35, 0.8, q2) : mix(0.5, 1.0, q2)) * k;
	float s1 = (mode == 0 ? mix(1.3, 2.8, q3) : mix(1.8, 3.4, q3)) * k;
	float st = mix(0.8, 1.0, clamp(strength, 0.0, 1.0));
	float sz = mix(s0, s1, 1.0 - exp(-age * (mode == 0 ? 1.9 : 1.3))) * st;
	// lo sbuffo resta appoggiato sopra la sabbia
	float floor_y = sz * 0.3;
	if (p.y < floor_y) {
		TRANSFORM[3].y = floor_y;
		VELOCITY.y = max(VELOCITY.y, 0.0);
	}
	TRANSFORM[0].xyz = vec3(sz, 0.0, 0.0);
	TRANSFORM[1].xyz = vec3(0.0, sz, 0.0);
	TRANSFORM[2].xyz = vec3(0.0, 0.0, sz);
	CUSTOM.x += DELTA * (q1 - 0.5) * 0.8;
	float a = smoothstep(0.0, 0.025, t) * (1.0 - smoothstep(0.22, 1.0, t)) * mix(1.0, 0.6, t);
	a *= mode == 0 ? 0.95 : 0.85;
	// appena nati sono piÃ¹ chiari (sabbia fresca, controluce del lampo)
	float fresh = exp(-age * 5.0);
	COLOR = vec4(1.0 + fresh * 0.5, mix(0.88, 1.06, q1), 1.0, a);
}
␀␀␀␀␀shader_type spatial;
// Lampo al pugno: billboard additivo con nucleo bianco, alone caldo, raggi a stella che si
// assottigliano verso l'esterno (stile anime) e un alone sottile che si allarga.
// Non usa il test di profonditÃ  (il terreno taglierebbe metÃ  lampo): legge invece la
// profonditÃ  al centro e si attenua se qualcosa di vicino lo copre davvero.

render_mode unshaded, blend_add, depth_test_disabled, depth_draw_never, cull_disabled, fog_disabled, shadows_disabled;

uniform sampler2D depth_tex : hint_depth_texture, filter_nearest, repeat_disable;
uniform float strength = 0.0;
uniform float ring = 0.3;           // raggio dell'alone (0..1 del quad)
uniform float rot = 0.0;
uniform vec3 tint = vec3(1.0, 0.82, 0.55);

varying vec3 v_center;

void vertex() {
	vec3 sc = vec3(length(MODEL_MATRIX[0].xyz), length(MODEL_MATRIX[1].xyz), length(MODEL_MATRIX[2].xyz));
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0] * sc.x, INV_VIEW_MATRIX[1] * sc.y, INV_VIEW_MATRIX[2] * sc.z, MODEL_MATRIX[3]);
	v_center = (VIEW_MATRIX * vec4(MODEL_MATRIX[3].xyz, 1.0)).xyz;
}

void fragment() {
	vec2 c = (UV - 0.5) * 2.0;
	float r = length(c);
	float ang = atan(c.y, c.x);
	float core = exp(-r * r * 40.0) * 10.0 + exp(-r * r * 9.0) * 3.0;
	float halo = exp(-r * r * 5.0) * 0.7;
	// striscia orizzontale (anamorfica)
	float streak = exp(-c.y * c.y * 1400.0) * exp(-abs(c.x) * 2.6) * 3.0;
	// 4 raggi lunghi + 8 corti, sempre piÃ¹ sottili verso l'esterno
	float s4 = pow(abs(cos(2.0 * (ang + rot))), 14.0 + 200.0 * r) * (1.0 - smoothstep(0.05, 1.0, r)) * 4.5;
	float s8 = pow(abs(cos(4.0 * (ang - rot * 0.6 + 0.39))), 24.0 + 320.0 * r) * (1.0 - smoothstep(0.0, 0.7, r)) * 2.4;
	float rg = exp(-pow((r - ring) / 0.03, 2.0)) * 1.6 * (1.0 - ring);
	float v = core + halo + s4 + s8 + rg + streak;
	v *= 1.0 - smoothstep(0.9, 1.0, r);
	// occlusione: profonditÃ  della scena al centro del lampo
	vec4 cp = PROJECTION_MATRIX * vec4(v_center, 1.0);
	vec2 cuv = clamp(cp.xy / cp.w * 0.5 + 0.5, vec2(0.0), vec2(1.0));
	float dep = texture(depth_tex, cuv).r;
	vec4 sp = INV_PROJECTION_MATRIX * vec4(cuv * 2.0 - 1.0, dep, 1.0);
	float scene_z = -sp.z / sp.w;
	float occ = smoothstep(1.4, 0.6, -v_center.z - scene_z);
	vec3 col = mix(tint, vec3(1.0), clamp(core * 0.25, 0.0, 1.0));
	ALBEDO = col * v * strength * mix(0.35, 1.0, occ);
}
␀␀␀␀shader_type spatial;
// Sasso/frammento della schiacciata: roccia sabbiosa illuminata dalla scena.

render_mode cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec3 albedo_a = vec3(0.20, 0.15, 0.10);
uniform vec3 albedo_b = vec3(0.42, 0.33, 0.21);

varying float v_var;

void vertex() {
	v_var = fract(INSTANCE_CUSTOM.z * 37.3);
}

void fragment() {
	ALBEDO = mix(albedo_a, albedo_b, v_var);
	ROUGHNESS = 0.92;
	SPECULAR = 0.3;
}
␀␀␀␀␀␀␀␀shader_type spatial;
// Onda d'urto della schiacciata, proiettata sul terreno vero (anche se irregolare): un box
// attorno al punto d'impatto ricostruisce dalla profonditÃ  il punto di scena dietro ogni pixel
// e disegna, solo sulle superfici rivolte in alto vicino alla quota dell'impatto:
//  - la distorsione dell'aria sul fronte dell'onda (screen texture spostata radialmente);
//  - il filo luminoso del fronte (HDR, il glow del livello lo fa brillare);
//  - l'anello di luce che segue il fronte e la vampata al centro.
// Costo: 1 profonditÃ  + 1 normale + 1 rumore + 1 screen texture per pixel coperto, e solo
// per ~0.8 s (poi il box viene nascosto).

render_mode unshaded, blend_premul_alpha, cull_front, depth_test_disabled, depth_draw_never, fog_disabled, shadows_disabled;

uniform sampler2D screen_tex : hint_screen_texture, filter_linear, repeat_disable;
uniform sampler2D depth_tex : hint_depth_texture, filter_nearest, repeat_disable;
uniform sampler2D nr_tex : hint_normal_roughness_texture, filter_nearest, repeat_disable;
uniform sampler2D noise_a : filter_linear_mipmap, repeat_enable;

uniform float shock_r = 0.0;        // raggio del fronte (m)
uniform float shock_w = 0.6;        // spessore della fascia distorta (m)
uniform float distort = 0.0;        // spostamento massimo (m) sul fronte
uniform float edge = 0.0;           // intensitÃ  del filo luminoso
uniform float edge_w = 0.08;        // spessore del filo (m)
uniform float glow = 0.0;           // anello di luce dietro al fronte
uniform float core = 0.0;           // vampata al centro
uniform float max_r = 9.0;          // raggio finale (per sfumare il bordo)
uniform float band_h = 1.6;         // tolleranza in quota attorno al punto d'impatto (m)
uniform vec3 edge_col = vec3(1.0, 0.93, 0.78);
uniform vec3 glow_col = vec3(1.0, 0.72, 0.36);
uniform float seed = 0.0;

vec2 to_uv(mat4 proj, mat4 view, vec3 wp) {
	vec4 c = proj * (view * vec4(wp, 1.0));
	return c.xy / c.w * 0.5 + 0.5;
}

void fragment() {
	float depth = texture(depth_tex, SCREEN_UV).r;
	vec4 vp = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, depth, 1.0);
	vp.xyz /= vp.w;
	vec3 wp = (INV_VIEW_MATRIX * vec4(vp.xyz, 1.0)).xyz;
	vec3 ctr = MODEL_MATRIX[3].xyz;
	vec3 d = wp - ctr;
	float r = length(d.xz);
	// solo terreno: vicino alla quota dell'impatto e rivolto verso l'alto
	vec3 nv = texture(nr_tex, SCREEN_UV).xyz * 2.0 - 1.0;
	float up = (INV_VIEW_MATRIX * vec4(nv, 0.0)).y;
	float mask = smoothstep(band_h, band_h * 0.5, abs(d.y)) * smoothstep(0.35, 0.7, up);
	mask *= 1.0 - smoothstep(max_r * 1.05, max_r * 1.15, r);
	if (mask < 0.002 || r > max_r * 1.2) {
		discard;
	}
	vec2 dir = d.xz / max(r, 1e-3);
	float ang = atan(dir.y, dir.x);
	// rumore lungo il fronte: l'anello Ã¨ "spezzato" come nei cartoni
	float n = texture(noise_a, vec2(ang * 0.6366 + seed, shock_r * 0.05)).r;
	float n2 = texture(noise_a, vec2(ang * 1.9099 - seed * 0.7, r * 0.11)).r;
	float x = (r - shock_r) / max(shock_w, 1e-3);
	// lente: comprime davanti al fronte e stira dietro (derivata di una gaussiana)
	float lens = -x * exp(-x * x * 1.6) * 1.2;
	float band = exp(-x * x * 0.9);
	vec3 off = vec3(dir.x, 0.0, dir.y) * distort * lens * (0.6 + 0.8 * n);
	vec2 uv = to_uv(PROJECTION_MATRIX, VIEW_MATRIX, wp + off);
	vec3 scene = texture(screen_tex, uv).rgb;
	// filo del fronte, un po' piÃ¹ avanti della fascia, spezzato dal rumore
	float xe = (r - shock_r - shock_w * 0.25) / max(edge_w, 1e-3);
	float e = exp(-xe * xe) * smoothstep(0.32, 0.6, n2 + n * 0.3);
	e += exp(-xe * xe * 0.15) * 0.06;
	// anello di luce caldo che segue il fronte, piÃ¹ largo e morbido
	float xg = (r - shock_r * 0.9) / max(shock_r * 0.12 + 0.3, 0.3);
	float g = exp(-xg * xg) * (0.55 + 0.6 * n);
	float c = exp(-r * r / max(max_r * max_r * 0.012, 0.05));
	vec3 add = edge_col * e * edge + glow_col * g * glow + edge_col * c * core;
	float a = band * mask * step(0.0005, distort);
	ALBEDO = scene * a + add * mask;
	ALPHA = a;
}
␀␀␀␀␀␀␀␀␀shader_type spatial;
// Scintilla dell'impatto: striscia additiva HDR allineata alla velocitÃ .

render_mode unshaded, blend_add, depth_draw_never, cull_disabled, fog_disabled, shadows_disabled, skip_vertex_transform;

uniform float width_m = 0.045;
uniform float hdr = 4.0;
uniform vec3 col = vec3(1.0, 0.86, 0.6);

void vertex() {
	vec3 c = (MODELVIEW_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
	vec3 ax = (MODELVIEW_MATRIX * vec4(0.0, 1.0, 0.0, 0.0)).xyz;
	float sc = length(MODELVIEW_MATRIX[0].xyz);
	vec3 s = cross(ax, c);
	float sl = length(s);
	s = sl > 1e-6 ? s / sl : vec3(1.0, 0.0, 0.0);
	float pix = 2.0 * max(-c.z, 0.01) / (PROJECTION_MATRIX[1][1] * VIEWPORT_SIZE.y);
	float w = max(width_m * sc, pix * 0.9);
	float tail = VERTEX.y + 0.5;
	VERTEX = c + ax * tail * -1.0 + s * VERTEX.x * 2.0 * w * mix(1.0, 0.2, tail);
}

void fragment() {
	float x = abs(UV.x - 0.5) * 2.0;
	float along = UV.y;
	float body = (1.0 - x * x) * smoothstep(0.0, 0.3, along) * (0.3 + 0.7 * along);
	ALBEDO = col * body * COLOR.a * hdr;
}
shader_type spatial;
// Spruzzo di sabbia: striscia allineata alla velocitÃ  (asse Y della particella), sfumata.

render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled, skip_vertex_transform;

uniform float width_m = 0.08;
uniform vec3 col = vec3(1.15, 0.92, 0.6);

void vertex() {
	vec3 c = (MODELVIEW_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
	vec3 ax = (MODELVIEW_MATRIX * vec4(0.0, 1.0, 0.0, 0.0)).xyz;
	float sc = length(MODELVIEW_MATRIX[0].xyz);
	vec3 s = cross(ax, c);
	float sl = length(s);
	s = sl > 1e-6 ? s / sl : vec3(1.0, 0.0, 0.0);
	float pix = 2.0 * max(-c.z, 0.01) / (PROJECTION_MATRIX[1][1] * VIEWPORT_SIZE.y);
	float w = max(width_m * sc, pix * 0.9);
	float tail = VERTEX.y + 0.5;
	VERTEX = c + ax * tail * -1.0 + s * VERTEX.x * 2.0 * w * mix(1.0, 0.2, tail);
}

void fragment() {
	float x = abs(UV.x - 0.5) * 2.0;
	float along = UV.y;
	float body = (1.0 - x * x) * smoothstep(0.0, 0.35, along) * (0.25 + 0.75 * along);
	ALBEDO = col * COLOR.g;
	ALPHA = clamp(body * COLOR.a, 0.0, 1.0);
}
␀␀␀␀␀␀shader_type spatial;
// Il cratere del laser sulla vetta (piano_atto2 Â§4.1; scripts/env/gen_iczb/vetta.gd, nodo Vetta/Cratere): la
// conca di vetro di ghiaccio fuso larga 7 m dove c'era il piedistallo. Coordinate locali del disco (centro
// 0, raggio "radius", la conca scende verso il centro nella mesh). Vetro di ghiaccio blu profondo e lucido
// con le increspature concentriche del ghiaccio che si Ã¨ rifatto; dal bordo verso il centro le crepe
// incandescenti arancio-oro che si spengono con "heat" (1 appena colpito, 0 freddo); "on" fa crescere la
// conca dal centro (0 niente, 1 tutta). Il bordo Ã¨ un taglio netto (alpha scissor: resta opaco).
// Mai viola: il blu va verso il verde acqua, il caldo verso l'arancio.

render_mode cull_back, diffuse_burley, specular_schlick_ggx;

uniform float on = 0.0;
uniform float heat = 1.0;
uniform float radius = 3.5;
uniform vec3 glass_deep : source_color = vec3(0.02, 0.12, 0.22);
uniform vec3 glass_light : source_color = vec3(0.32, 0.7, 0.86);
uniform vec3 snow : source_color = vec3(0.86, 0.91, 0.96);
uniform vec3 hot : source_color = vec3(1.0, 0.5, 0.12);
uniform vec3 hot_core : source_color = vec3(1.0, 0.86, 0.5);

varying vec3 lp;

float hash2(vec2 p) {
	p = fract(p * vec2(0.3183, 0.3679) + 0.11);
	p *= 17.0;
	return fract(p.x * p.y * (p.x + p.y));
}

float vnoise(vec2 x) {
	vec2 i = floor(x);
	vec2 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash2(i), hash2(i + vec2(1, 0)), f.x), mix(hash2(i + vec2(0, 1)), hash2(i + vec2(1, 1)), f.x), f.y);
}

void vertex() {
	lp = VERTEX;
}

void fragment() {
	float r = length(lp.xz) / max(radius, 0.01);
	float ang = atan(lp.z, lp.x);
	float grow = on * 1.08;
	// fuori dalla conca (o non ancora cresciuta) il disco non si vede
	float edge = 1.0 - smoothstep(grow - 0.12, grow, r);
	float rim = smoothstep(0.72, 0.98, r);
	if (edge <= 0.01) {
		discard;
	}
	// increspature concentriche, mosse dal rumore
	float n = vnoise(lp.xz * 1.7) * 0.6 + vnoise(lp.xz * 4.3) * 0.4;
	float rip = sin((r * 18.0 + n * 3.0) * 3.14159) * 0.5 + 0.5;
	vec3 glass = mix(glass_deep, glass_light, clamp(0.25 + r * 0.55 + rip * 0.15, 0.0, 1.0));
	vec3 col = mix(glass, snow, rim * 0.85);
	// crepe calde: creste del rumore radiale
	float cn = vnoise(vec2(ang * 4.0, r * 6.0)) * 0.6 + vnoise(vec2(ang * 11.0, r * 14.0)) * 0.4;
	float crack = (1.0 - smoothstep(0.0, 0.05, abs(cn - 0.5))) * (1.0 - rim);
	float core = 1.0 - smoothstep(0.0, 0.35, r);
	ALBEDO = mix(col, vec3(0.05, 0.03, 0.02), crack * 0.6);
	METALLIC = 0.1;
	ROUGHNESS = mix(0.06, 0.55, rim);
	SPECULAR = 0.8;
	EMISSION = (hot * crack * 2.4 + hot_core * core * 1.2) * heat + glass_light * 0.06 * (1.0 - rim);
	// il bordo: taglio netto (alpha scissor, pipeline opaca)
	ALPHA = edge;
	ALPHA_SCISSOR_THRESHOLD = 0.5;
}
␀␀␀␀shader_type spatial;
// Neo Metal Sonic e Super Neo Metal Sonic (scripts/bosses/iczb_neo_look.gd): il corpo del glb
// (assets/characters/neo_metal_sonic/neo_metal_sonic.glb, superficie 0) con la sua texture. Override
// per istanza. Fuori dalla fascia d'oro il modello resta com'Ã¨ (metallo 0.45, rugositÃ  0.35, come il
// materiale importato). Dentro la fascia d'oro (fra gold_lo e gold_hi, quote del glb: piedi 0, testa
// 1.05) la texture si separa per colore, come il riferimento riferimenti/neo_metal/super_neo_metal_sonic.png:
//   - i pannelli blu diventano arancio-oro (#E8902A -> #FFC23A secondo la luminositÃ  della pittura);
//   - argento e bianco restano argento appena caldo;
//   - il rosso (saturo) resta rosso;
//   - i neri e il mantello diventano marrone-nero (#2A2018, mai viola), il mantello stracciato in fondo;
//   - il giallo resta oro, piÃ¹ acceso;
//   - i piedi (sotto 0.085) arancio-rossi, gli stivali del riferimento.
// I colori li dÃ  lo script (i default qui sotto non passano in lineare). Metallo 0.5, rugositÃ  0.42 (a 0.8 e 0.3 rifletteva la neve e il cielo: oro slavato, quasi bianco), bordo d'oro che pulsa (rim, pulse), un poco di luce propria (si legge
// anche in controluce), glow per il lampo dei colpi. Il bordo della fascia che sale (la
// trasformazione) Ã¨ una riga d'oro acceso. damage: crepe incandescenti (Neo battuto, scene).
// Fuori dall'oro (Neo normale) con normal_fix 1: il blu del glb va verso il blu-ciano (tinta blue_hue,
// ~218 gradi, G appena sopra R) e il mantello e i neri verso un nero opaco col verde appena sopra rosso
// e blu (cape_nrm): sotto le luci calde delle scene (fuoco di Knuckles, occhi rossi) il blu scuro e il
// mantello metallico che rifletteva il cielo passavano al viola; un marrone sotto il cielo azzurro
// (R e B sopra G) faceva lo stesso, il nero verdognolo va al bruno col fuoco e al grigio-blu col cielo.
// Il viola vero nasceva perÃ² dove una luce rossa/arancio si spegne su una superficie giÃ  azzurrata dal
// cielo (R e B alti, G basso): light() qui sotto rifÃ  la luce standard (Lambert + GGX, come i default
// burley/schlick_ggx a meno di un niente) e per Neo normale toglie parte del colore alle luci
// (light_desat): il fuoco e gli occhi illuminano piÃ¹ bianchi, il blu resta blu.

render_mode cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform float near_fade = 0.0;        // m: piÃ¹ vicino di cosÃ¬ alla camera si dissolve a retino (0 = mai)

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform float gold_lo = -1.0;
uniform float gold_hi = -1.0;
uniform float edge_w = 0.05;          // spessore della riga che sale (unitÃ  del glb)
uniform vec3 gold_dark : source_color = vec3(0.85, 0.42, 0.1);
uniform vec3 gold_light : source_color = vec3(1.0, 0.68, 0.2);
uniform vec3 cape_col : source_color = vec3(0.165, 0.125, 0.094);
uniform vec3 boot_col : source_color = vec3(0.93, 0.36, 0.12);
uniform vec3 silver_tint : source_color = vec3(1.0, 0.96, 0.88);
uniform vec3 rim_col : source_color = vec3(1.0, 0.78, 0.36);
uniform vec3 edge_col : source_color = vec3(1.0, 0.86, 0.5);
uniform float rim = 0.55;
uniform float gold_metal = 0.5;      // il metallo dell'oro (0.8 rifletteva la neve: oro slavato)
uniform float gold_rough = 0.42;
uniform float rim_power = 2.6;
uniform float pulse = 0.25;
uniform float pulse_hz = 1.1;
uniform float self_lit = 0.22;        // luce propria dell'oro
uniform float glow = 0.0;             // lampo (colpi, trasformazione)
uniform vec3 glow_col : source_color = vec3(1.0, 0.9, 0.62);
uniform float tatter = 1.0;           // mantello stracciato nella fascia d'oro
uniform float damage = 0.0;           // crepe incandescenti
uniform float base_rim = 0.12;        // un filo di bordo anche fuori dall'oro (Neo normale sulla neve)
// cape_uv: il mantello nella texture (un rettangolino nero: catene left_skirt / right_skirt)
uniform vec4 cape_uv = vec4(0.333, 0.438, 0.354, 0.456);
uniform float normal_fix = 1.0;       // Neo normale: blu verso il blu-ciano, mantello marrone-nero opaco
uniform float blue_hue = 218.0;       // la tinta del blu di Neo normale (gradi)
uniform vec3 cape_nrm : source_color = vec3(0.113, 0.137, 0.125);  // mantello di Neo normale
uniform float light_desat = 0.8;      // Neo normale: quanto colore si toglie alle luci (0: luci vere)

varying vec3 v_pos;
varying float v_hem;
varying float v_desat;

float hash3(vec3 p) {
	p = fract(p * 0.3183099 + vec3(0.11, 0.17, 0.13));
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float vnoise(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(hash3(i), hash3(i + vec3(1, 0, 0)), f.x), mix(hash3(i + vec3(0, 1, 0)), hash3(i + vec3(1, 1, 0)), f.x), f.y),
		mix(mix(hash3(i + vec3(0, 0, 1)), hash3(i + vec3(1, 0, 1)), f.x), mix(hash3(i + vec3(0, 1, 1)), hash3(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

void vertex() {
	v_pos = VERTEX;
	// orlo del mantello: le ossa in fondo alle catene (left_skirt03 14, right_skirt03 17) pesano 1,
	// quelle di mezzo (13, 16) 0.5: la sfumatura dell'orlo segue il mantello anche quando si alza
	float h = 0.0;
	for (int i = 0; i < 4; i++) {
		uint b = BONE_INDICES[i];
		float w = BONE_WEIGHTS[i];
		if (b == 14u || b == 17u) {
			h += w;
		} else if (b == 13u || b == 16u) {
			h += 0.5 * w;
		}
	}
	v_hem = h;
}

vec3 to_srgb(vec3 c) {
	return pow(max(c, vec3(0.0)), vec3(1.0 / 2.2));
}

vec3 to_lin(vec3 c) {
	return pow(max(c, vec3(0.0)), vec3(2.2));
}

vec3 hsv2rgb(vec3 c) {
	vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
	return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}

// retino 4x4 (Bayer) per la dissolvenza vicino alla camera (near_fade)
float bayer4(vec2 p) {
	ivec2 q = ivec2(mod(p, 4.0));
	const float m[16] = { 0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0 };
	return (m[q.x + q.y * 4] + 0.5) / 16.0;
}

void fragment() {
	// vicino alla camera si dissolve a retino (lo scontro: la camera di gioco dentro la corona)
	if (near_fade > 0.0) {
		float nf = clamp((length(VERTEX) - near_fade * 0.45) / (near_fade * 0.55), 0.0, 1.0);
		if (nf < bayer4(FRAGCOORD.xy)) {
			discard;
		}
	}
	vec4 t = texture(albedo_tex, UV);
	vec3 c = t.rgb;
	vec3 s = to_srgb(c);
	float mx = max(s.r, max(s.g, s.b));
	float mn = min(s.r, min(s.g, s.b));
	float ch = mx - mn;
	float sat = ch / max(mx, 1e-3);
	float hue = 0.0;
	if (ch > 1e-3) {
		if (mx == s.r) {
			hue = mod(60.0 * (s.g - s.b) / ch, 360.0);
		} else if (mx == s.g) {
			hue = 60.0 * (2.0 + (s.b - s.r) / ch);
		} else {
			hue = 60.0 * (4.0 + (s.r - s.g) / ch);
		}
	}
	float in_gold = step(gold_lo, v_pos.y) * step(v_pos.y, gold_hi);
	// riga accesa sul bordo che si muove (solo mentre Ã¨ dentro il corpo)
	float e_hi = (1.0 - smoothstep(0.0, edge_w, abs(v_pos.y - gold_hi))) * step(-0.02, gold_hi) * step(gold_hi, 1.08);
	float e_lo = (1.0 - smoothstep(0.0, edge_w, abs(v_pos.y - gold_lo))) * step(-0.02, gold_lo) * step(gold_lo, 1.08);
	float edge = max(e_hi, e_lo);

	float blue = smoothstep(0.22, 0.38, sat) * smoothstep(180.0, 195.0, hue) * (1.0 - smoothstep(262.0, 285.0, hue));
	float yellow = smoothstep(0.3, 0.45, sat) * smoothstep(32.0, 42.0, hue) * (1.0 - smoothstep(66.0, 78.0, hue));
	float grey = 1.0 - smoothstep(0.14, 0.3, sat);
	float black = grey * (1.0 - smoothstep(0.1, 0.22, mx));
	float cape = step(cape_uv.x, UV.x) * step(UV.x, cape_uv.z) * step(cape_uv.y, UV.y) * step(UV.y, cape_uv.w);
	float dark = max(black, cape);

	vec3 gold = mix(gold_dark, gold_light, smoothstep(0.08, 0.9, mx));
	vec3 g = c;
	g = mix(g, gold, blue);
	g = mix(g, c * silver_tint * 1.06, grey * (1.0 - dark));
	g = mix(g, gold_light * 1.05, yellow);
	g = mix(g, cape_col, dark);
	// stivali: il blu e il nero dei piedi diventano arancio-rosso (l'argento resta)
	float boot = (1.0 - smoothstep(0.075, 0.095, v_pos.y)) * max(blue, black) * (1.0 - cape);
	g = mix(g, boot_col, boot);

	// Neo normale: il blu (anche quello che tira al viola nella pittura) ruotato verso blue_hue con la
	// stessa saturazione e luce; mantello e neri marrone-nero opachi
	float blue_n = smoothstep(0.1, 0.22, sat) * smoothstep(172.0, 186.0, hue) * (1.0 - smoothstep(305.0, 325.0, hue));
	vec3 nrm = mix(c, to_lin(hsv2rgb(vec3(blue_hue / 360.0, sat, mx))), blue_n * normal_fix);
	float dark_n = max(cape, black * 0.85) * normal_fix;
	nrm = mix(nrm, cape_nrm * (0.75 + 0.5 * mx), dark_n);

	float ndv = clamp(abs(dot(NORMAL, VIEW)), 0.0, 1.0);
	float fres = pow(1.0 - ndv, rim_power);
	float beat = 1.0 + pulse * sin(TIME * TAU * pulse_hz);
	float goldish = max(blue, yellow) * (1.0 - boot);

	ALBEDO = mix(nrm, g, in_gold);
	METALLIC = mix(mix(0.45, 0.2, dark_n), mix(gold_metal, 0.25, dark), in_gold);
	ROUGHNESS = mix(mix(0.35, 0.78, dark_n), mix(gold_rough, 0.75, dark), in_gold);
	vec3 em = nrm * fres * base_rim * (1.0 - in_gold);
	em += in_gold * (g * self_lit * (0.6 + 0.4 * ndv) * (goldish + boot * 0.6) * beat
		+ rim_col * fres * rim * beat * (1.0 - dark * 0.7));
	em += edge_col * edge * 4.0;
	em += glow_col * glow * (0.5 + fres);
	// crepe: creste del rumore, sottili, arancio incandescente
	if (damage > 0.0) {
		float n = vnoise(v_pos * 34.0) * 0.6 + vnoise(v_pos * 71.0) * 0.4;
		float crack = (1.0 - smoothstep(0.0, 0.035, abs(n - 0.5))) * smoothstep(1.0 - damage, 1.0 - damage * 0.5, vnoise(v_pos * 6.0 + 3.1));
		ALBEDO = mix(ALBEDO, vec3(0.03, 0.02, 0.015), crack * 0.8);
		em += vec3(1.0, 0.42, 0.08) * crack * 2.5 * damage;
	}
	EMISSION = em;
	v_desat = light_desat * normal_fix * (1.0 - in_gold);
	// mantello stracciato: l'orlo (v_hem verso 1) si sfrangia col rumore attorno al corpo
	if (in_gold > 0.5 && cape > 0.5 && tatter > 0.0) {
		float ang = atan(v_pos.x, v_pos.z);
		float n = vnoise(vec3(ang * 5.0, 0.0, 0.0)) * 0.65 + vnoise(vec3(ang * 17.0, 3.0, 0.0)) * 0.35;
		if (v_hem > 1.0 - tatter * (0.12 + 0.34 * n)) {
			discard;
		}
	}
}

// La luce standard (diffusa di Lambert, speculare GGX con Fresnel di Schlick e visibilitÃ  di Smith),
// con il colore delle luci ammorbidito verso il grigio della stessa luminositÃ  per Neo normale.
void light() {
	float ndl = clamp(dot(NORMAL, LIGHT), 0.0, 1.0);
	vec3 lc = LIGHT_COLOR;
	lc = mix(lc, vec3(dot(lc, vec3(0.299, 0.587, 0.114))), v_desat);
	DIFFUSE_LIGHT += ndl * ATTENUATION * lc / PI;
	vec3 hv = normalize(VIEW + LIGHT);
	float ndh = clamp(dot(NORMAL, hv), 0.0, 1.0);
	float ldh = clamp(dot(LIGHT, hv), 0.0, 1.0);
	float ndv = clamp(dot(NORMAL, VIEW), 1e-4, 1.0);
	float a = max(ROUGHNESS * ROUGHNESS, 0.002);
	float a2 = a * a;
	float dd = ndh * ndh * (a2 - 1.0) + 1.0;
	float d = a2 / (PI * dd * dd);
	float k = a * 0.5;
	float vis = 0.25 / ((ndl * (1.0 - k) + k) * (ndv * (1.0 - k) + k));
	vec3 f0 = mix(vec3(0.04), ALBEDO, METALLIC);
	vec3 f = f0 + (1.0 - f0) * pow(1.0 - ldh, 5.0);
	SPECULAR_LIGHT += ndl * d * vis * f * lc * ATTENUATION * SPECULAR_AMOUNT;
}
␀␀␀␀shader_type spatial;
// I pezzi aggiunti di Super Neo Metal Sonic (scripts/bosses/iczb_neo_look.gd): la corona a stella dietro
// la testa, le pinne delle orecchie, il nucleo del petto, gli artigli, le spine. Geometria procedurale
// coi colori nei vertici (lineari): arancio-oro col bordo chiaro e la striscia argento al centro,
// argento degli artigli, il disco del nucleo. UV.x = indice del pezzo nella corona (0-5 le lame, 6-7 le
// pinne): con use_open ogni pezzo cresce dal centro della corona (open[i], 0 chiuso .. 1 aperto: la
// corona che si apre una lama alla volta). UV.y = quanto il vertice si accende da sÃ© (il centro del
// nucleo). UV2.x = dove sta il vertice lungo il pezzo (artigli, spine: crescono fino a grow).
// Bordo d'oro che pulsa come il corpo. I colori degli uniform li dÃ  lo script.

render_mode cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform float near_fade = 0.0;        // m: piÃ¹ vicino di cosÃ¬ alla camera si dissolve a retino (0 = mai)

uniform float open[8];
uniform float use_open = 0.0;
uniform float metal = 0.4;
uniform float rough = 0.4;
uniform float self_lit = 0.2;
uniform float emit = 1.0;             // forza dei vertici accesi (nucleo)
uniform vec3 emit_col : source_color = vec3(1.0, 0.55, 0.12);
uniform float glow = 0.0;
uniform vec3 glow_col : source_color = vec3(1.0, 0.9, 0.62);
uniform vec3 rim_col : source_color = vec3(1.0, 0.8, 0.4);
uniform float rim = 0.5;
uniform float pulse = 0.25;
uniform float pulse_hz = 1.1;
uniform float grow = 1.0;             // i pezzi con la pelle crescono dalla base alla punta (UV2.x)

void vertex() {
	if (use_open > 0.5) {
		int i = clamp(int(UV.x + 0.5), 0, 7);
		VERTEX *= max(open[i], 0.0);
	}
}

// retino 4x4 (Bayer) per la dissolvenza vicino alla camera (near_fade)
float bayer4(vec2 p) {
	ivec2 q = ivec2(mod(p, 4.0));
	const float m[16] = { 0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0 };
	return (m[q.x + q.y * 4] + 0.5) / 16.0;
}

void fragment() {
	// vicino alla camera si dissolve a retino (lo scontro: la camera di gioco dentro la corona)
	if (near_fade > 0.0) {
		float nf = clamp((length(VERTEX) - near_fade * 0.45) / (near_fade * 0.55), 0.0, 1.0);
		if (nf < bayer4(FRAGCOORD.xy)) {
			discard;
		}
	}
	if (UV2.x > grow + 0.001) {
		discard;
	}
	float ndv = clamp(abs(dot(NORMAL, VIEW)), 0.0, 1.0);
	float fres = pow(1.0 - ndv, 2.6);
	float beat = 1.0 + pulse * sin(TIME * TAU * pulse_hz);
	ALBEDO = COLOR.rgb;
	METALLIC = metal;
	ROUGHNESS = rough;
	EMISSION = COLOR.rgb * self_lit * (0.6 + 0.4 * ndv) * beat + emit_col * UV.y * emit * 3.0 * beat
		+ rim_col * fres * rim * beat + glow_col * glow * (0.5 + fres);
}
␀␀␀␀shader_type canvas_item;
// Il flashback di Doomsday (finale di Launch Base): lo screenshot di Sonic 3 & Knuckles dell'utente a tutto
// schermo (cover) o dentro un riquadro (contain, l'eco), con l'avvicinamento, la scossa, il lampo bianco e
// i colori di Hyper Sonic: dentro il suo riquadro i pixel chiari e rosati (il corpo, non le stelline nÃ© i
// guanti) prendono la tinta del ciclo (menta, giallo, ciano, pesca: mai viola).

uniform sampler2D pic : source_color, filter_linear, repeat_disable;
uniform float view_aspect = 1.7778;
uniform float pic_aspect = 1.7425;
uniform bool contain = false;
uniform vec2 center = vec2(0.5, 0.5);
uniform float zoom = 1.0;
uniform vec2 shake = vec2(0.0);
uniform float flash = 0.0;
uniform float alpha = 1.0;
uniform vec3 tint = vec3(1.0);
uniform float tint_k = 0.0;
uniform vec4 mask_rect = vec4(0.538, 0.425, 0.682, 0.688);   // x0 y0 x1 y1 (UV dello screenshot)
uniform vec4 excl_rect = vec4(0.538, 0.62, 0.578, 0.688);    // i lacci bianchi delle scarpe

void fragment() {
	vec2 s = UV - 0.5;
	vec2 k = vec2(1.0);
	bool wide = view_aspect > pic_aspect;
	if (contain) {
		k = wide ? vec2(view_aspect / pic_aspect, 1.0) : vec2(1.0, pic_aspect / view_aspect);
	} else {
		k = wide ? vec2(1.0, pic_aspect / view_aspect) : vec2(view_aspect / pic_aspect, 1.0);
	}
	vec2 p = s * k / zoom + center + shake;
	float inside = step(0.0, p.x) * step(p.x, 1.0) * step(0.0, p.y) * step(p.y, 1.0);
	vec3 col = texture(pic, clamp(p, vec2(0.0), vec2(1.0))).rgb;
	if (tint_k > 0.0) {
		float in_r = step(mask_rect.x, p.x) * step(p.x, mask_rect.z) * step(mask_rect.y, p.y) * step(p.y, mask_rect.w);
		float ex = step(excl_rect.x, p.x) * step(p.x, excl_rect.z) * step(excl_rect.y, p.y) * step(p.y, excl_rect.w);
		float mn = min(col.r, min(col.g, col.b));
		float pale = smoothstep(0.45, 0.6, mn) * smoothstep(0.0, 0.05, col.r - col.b);
		float m = in_r * (1.0 - ex) * pale;
		float lum = dot(col, vec3(0.3, 0.59, 0.11));
		col = mix(col, tint * (lum * 1.05 + 0.05), m * tint_k);
	}
	col = mix(col, vec3(1.0), flash);
	// nell'eco il nero dello spazio non fa un riquadro scuro nel cielo: trasparente
	float a = contain ? inside * smoothstep(0.06, 0.3, max(col.r, max(col.g, col.b))) : 1.0;
	if (contain) {
		// i bordi sfumati: l'eco senza spigoli
		a *= smoothstep(0.0, 0.15, p.x) * smoothstep(1.0, 0.85, p.x) * smoothstep(0.0, 0.2, p.y) * smoothstep(1.0, 0.8, p.y);
	}
	COLOR = vec4(col, alpha * a);
}
␀shader_type spatial;
// Il laser caldo delle scene di Ice Cap (scripts/cinematic/iczb_laser.gd): copia di
// shaders/vfx/plasma/plasma_beam.gdshader (rumore che scorre lungo il raggio, al centro piÃ¹ chiaro) ma IN
// MISCELA NORMALE, non additiva: oro e arancio sommati al cielo blu verrebbero lilla o viola (vedi il
// commento di scripts/vfx/mk_mega_beam.gd). Su una CylinderMesh alta 1 lungo Y, scalata alla lunghezza.
// "t" Ã¨ l'orologio del raggio (lo fa avanzare lo script, anche al rallentatore), non TIME.

render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform vec4 color : source_color = vec4(1.0, 0.71, 0.23, 1.0);   // il bordo dello strato
uniform vec4 core : source_color = vec4(1.0, 0.97, 0.88, 1.0);    // dove si guarda il cilindro di fronte
uniform float energy = 2.0;          // >1: oltre il bianco (bagliore dell'Environment)
uniform float fade = 1.0;
uniform float opacity = 1.0;         // quanto copre al centro (gli strati esterni meno)
uniform float edge_pow = 1.2;        // quanto sfuma verso i bordi (alto = strato sottile)
uniform float scroll = 6.0;          // giri di rumore al secondo lungo il raggio
uniform float length_m = 10.0;       // lunghezza in metri (scala del rumore)
uniform float t = 0.0;               // l'orologio del raggio
uniform float soft_end = 0.0;        // 0..1: sfuma verso le due estremitÃ 

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vn(vec2 x) {
	vec2 i = floor(x); vec2 f = fract(x); f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}

void fragment() {
	float facing = abs(dot(normalize(NORMAL), normalize(VIEW)));
	float along = (1.0 - UV.y) * length_m;
	float n = vn(vec2(UV.x * 6.0, along * 0.9 - t * scroll)) * 0.5
		+ vn(vec2(UV.x * 13.0 + 3.1, along * 2.3 - t * scroll * 1.7)) * 0.5;
	float prof = pow(facing, edge_pow);
	float ends = mix(1.0, smoothstep(0.0, 0.2, UV.y) * smoothstep(1.0, 0.75, UV.y), soft_end);
	vec3 c = mix(color.rgb, core.rgb, smoothstep(0.55, 0.97, facing));
	ALBEDO = c * energy * (0.8 + 0.35 * n);
	ALPHA = clamp(prof * (0.7 + 0.45 * n) * opacity * fade * ends, 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀␀␀// La sagoma in controluce (scena 2 "Patrizio", piano atto 2 Â§5.5 e Â§5.9: la mano che ferma il super
// laser). Messa come material_overlay su tutte le mesh di Patrizio (corpo, guanti, occhi): nero pieno,
// nessun colore, solo un bordo sottile caldo dove la superficie gira di taglio verso la camera (il bianco
// del raggio dietro). Opaca (scrive la profonditÃ ): il bagliore del raggio dietro non le passa davanti.
// "k" scala il bordo (1 pieno, 0 nero del tutto).
// Il bordo resta sotto il bianco del pelo anche con l'esposizione alta della battuta (la prova dei
// fotogrammi della mano conta i pixel bianchi e rossi dentro la sagoma).
shader_type spatial;
render_mode unshaded, cull_back, depth_draw_always, shadows_disabled, ambient_light_disabled, fog_disabled;

uniform float k : hint_range(0.0, 1.0) = 1.0;
// il bordo (lineare): caldo e scuro, mai bianco
uniform vec3 rim_col = vec3(0.55, 0.3, 0.1);
uniform float rim_w : hint_range(0.0, 1.0) = 0.22;

void fragment() {
	float f = 1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0);
	float rim = smoothstep(1.0 - rim_w, 1.0, f);
	ALBEDO = rim_col * rim * k;
}
␀␀␀␀␀shader_type spatial;
// Disegno delle particelle del fuoco di Knuckles (lavoro "fuocoknux"): UN solo shader per fiamme,
// braci e fumo (kind), con il movimento di fire_particles.gdshader.
//   fiamma (0): un pezzo di fuoco vero che brucia (flipbook 8x8 generato da
//     tools/vfx_fire/gen_fire_textures.py: un ciclo che si ripete senza salti; canale R il fuoco
//     che sale da quello che brucia, canale B una palla di fuoco che ribolle per vampate e scie,
//     scelti da "shape"), mostrato da un punto a caso del ciclo per ogni particella (mai due uguali) e a
//     velocitÃ  vera (loop_rate), sfumando tra due fotogrammi vicini. La particella ci mette la sua
//     vita: si accende, si raffredda (giallo-bianco -> arancio -> rosso scuro), si consuma dalle
//     parti fredde (punte, filamenti, bordi: erode) e la sua base si stacca (lift): si spezza in
//     lingue e filamenti che spariscono, mai una goccia tonda che sbiadisce intera.
//     Il quadrato si allinea all'asse della particella (il vento relativo: correndo il fuoco si
//     piega all'indietro) con la base sul punto della particella, attaccata a quello che brucia.
//   brace (1): puntino incandescente allungato lungo la velocitÃ  che si raffredda e tremola.
//   fumo (2): sbuffo grigio tenue (canale G) rivolto alla camera che gira piano.
// Luce e copertura separate (alfa premoltiplicata): il corpo e le punte coprono lo sfondo almeno
// quanto emettono (sul cielo e sulla sabbia chiari restano giallo, arancio, rosso scuro e poi fumo
// scuro sottile: mai una velatura rosa), il nucleo caldo copre meno e si somma (supera 1 per il
// bagliore), oltre le punte un velo sottile di fumo scuro.
// Davanti al corpo (instance uniform "body": centro e raggio, lo mette chi accende il fuoco) le
// fiamme tra la camera e il personaggio diventano quasi trasparenti, punto per punto dove coprono
// la sagoma: il fuoco si vede sui contorni, sopra la testa e dietro, faccia e busto restano leggibili.
// I colori (c0..c4, dal fumo al bianco) li mette scripts/vfx/knux_fire.gd per tavolozza.

render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled, skip_vertex_transform;

uniform sampler2D flipbook : filter_linear_mipmap, repeat_disable, hint_default_black;
// dettaglio fine (fire_noise.png, si ripete): sposta il dominio del flipbook con un rumore che sale
// e ci mette creste sottili, in metri: da vicino il fuoco resta nitido e si muove sempre (niente
// ingrandimento sfocato dei fotogrammi)
uniform sampler2D detail_noise : filter_linear_mipmap, repeat_enable, hint_default_black;
uniform float detail = 1.0;
uniform int kind = 0;               // 0 fiamma, 1 brace, 2 fumo
uniform float energy = 1.0;         // luminositÃ 
uniform float opacity = 0.6;        // quanto copre lo sfondo (il corpo arancio)
uniform float smoke_mix = 0.3;      // fiamme: fumo grigio sulle fiamme che si spengono
uniform float shape = 0.0;          // fiamme: 0 fuoco che sale (R), 1 palla di fuoco che ribolle (B)
uniform float loop_rate = 0.5;      // cicli del flipbook al secondo (velocitÃ  vera del fuoco)
uniform float cool = 0.45;          // fiamme: quanto si raffreddano verso la fine della vita
uniform float erode = 0.35;         // fiamme: invecchiando si consumano dai bordi e dalle punte
uniform float base_soft = 0.0;      // fiamme: base sfumata (nasce dal corpo, nessun bordo sotto)
uniform float lift = 0.0;           // fiamme: invecchiando la base si stacca (non piÃ¹ alimentata):
                                    // restano le lingue e i filamenti in cima, mai una goccia tonda
uniform float base_offset = 0.45;   // fiamme: la base del fuoco sul punto della particella
uniform float fade_near = 0.9;      // si dissolve cosÃ¬ vicino alla camera (m)
uniform float front_fade = 0.88;    // quanto si spengono le fiamme davanti al corpo
uniform float core_add = 0.45;      // fiamme: quanto il nucleo caldo si somma (copre meno) invece di coprire
uniform float soot = 0.4;           // fiamme: quanto copre il velo di fumo oltre il fronte delle punte (e
                                    // delle lingue che si spengono)
uniform vec3 soot_color = vec3(0.16, 0.14, 0.12);
uniform vec3 smoke_color = vec3(0.17, 0.155, 0.14);
uniform vec3 c0 = vec3(0.15, 0.035, 0.008); // brace che muore, quasi fumo
uniform vec3 c1 = vec3(0.55, 0.1, 0.008);    // rosso scuro delle punte
uniform vec3 c2 = vec3(1.0, 0.3, 0.02);     // arancio del corpo
uniform vec3 c3 = vec3(1.0, 0.52, 0.09);    // giallo-arancio
uniform vec3 c4 = vec3(1.0, 0.82, 0.45);    // giallo-bianco della base
instance uniform vec4 body = vec4(0.0);     // centro del corpo (mondo) e raggio; raggio 0 = niente

varying flat vec4 v_cell;   // origini nell'atlante dei due fotogrammi
varying vec2 v_luv;         // coordinate nel fotogramma (giÃ  specchiate)
varying vec2 v_size;        // larghezza e lunghezza del quadrato (m)
varying float v_blend;
varying vec4 v_data;   // temperatura, etÃ , seme, forza
varying vec2 v_q;      // -1..1 nel quadrato
varying vec3 v_world;  // il punto nel mondo (per "davanti al corpo")

vec3 ramp(float h) {
	vec3 c = mix(c0, c1, smoothstep(0.0, 0.2, h));
	c = mix(c, c2, smoothstep(0.2, 0.45, h));
	c = mix(c, c3, smoothstep(0.45, 0.72, h));
	return mix(c, c4, smoothstep(0.75, 1.0, h));
}

void vertex() {
	vec3 pos = MODEL_MATRIX[3].xyz;
	float wid = length(MODEL_MATRIX[0].xyz);
	vec3 axv = MODEL_MATRIX[1].xyz;
	float len = length(axv);
	vec3 cr = INV_VIEW_MATRIX[0].xyz;
	vec3 cu = INV_VIEW_MATRIX[1].xyz;
	vec3 cam = INV_VIEW_MATRIX[3].xyz;
	vec3 to_cam = normalize(cam - pos);
	vec3 r;
	vec3 u;
	float off = 0.0;
	if (kind == 2) {
		// fumo: rivolto alla camera, ruotato
		float a = INSTANCE_CUSTOM.x;
		r = cr * cos(a) + cu * sin(a);
		u = cu * cos(a) - cr * sin(a);
		len = wid;
	} else {
		// fuoco o scia: lungo l'asse della particella, girato verso la camera attorno all'asse;
		// con l'asse quasi verso la camera torna un quadrato rivolto alla camera (corto)
		vec3 ax = len > 0.00001 ? axv / len : vec3(0.0, 1.0, 0.0);
		vec3 rr = cross(ax, to_cam);
		float rl = length(rr);
		float k = smoothstep(0.08, 0.4, rl);
		rr = rl > 0.00001 ? rr / rl : cr;
		r = normalize(mix(cr, rr, k));
		u = normalize(mix(cu, ax, k));
		len = mix(wid, len, k);
		off = kind == 0 ? base_offset : 0.0;
	}
	v_size = vec2(wid, len);
	vec3 world = pos + r * (VERTEX.x * wid) + u * ((VERTEX.y + off) * len);
	VERTEX = (VIEW_MATRIX * vec4(world, 1.0)).xyz;
	NORMAL = vec3(0.0, 0.0, 1.0);
	v_world = world;
	v_data = vec4(COLOR.r, INSTANCE_CUSTOM.y, COLOR.b, COLOR.a);
	v_q = UV * 2.0 - 1.0;
	// fotogrammi del ciclo: da un punto a caso (il seme) a velocitÃ  vera
	float fr = fract(TIME * loop_rate + COLOR.b * 7.31 + INSTANCE_CUSTOM.z) * 64.0;
	float f0 = floor(fr);
	float f1 = mod(f0 + 1.0, 64.0);
	v_blend = fr - f0;
	vec2 uv = UV;
	if (fract(COLOR.b * 13.7) > 0.5) {
		uv.x = 1.0 - uv.x;   // metÃ  specchiate: piÃ¹ varietÃ 
	}
	v_luv = uv;
	v_cell.xy = vec2(mod(f0, 8.0), floor(f0 / 8.0)) / 8.0;
	v_cell.zw = vec2(mod(f1, 8.0), floor(f1 / 8.0)) / 8.0;
}

// i due fotogrammi vicini sfumati, nel punto luv del fotogramma (tenuto dentro il fotogramma)
vec4 frames(vec2 luv) {
	luv = clamp(luv, vec2(0.004), vec2(0.996)) / 8.0;
	return mix(texture(flipbook, v_cell.xy + luv), texture(flipbook, v_cell.zw + luv), v_blend);
}

// Davanti al corpo, punto per punto: il raggio dalla camera a questo punto passa sulla sagoma del
// personaggio (vicino al suo asse, un segmento verticale dalle gambe alla testa) e il punto sta tra
// la camera e il corpo, non troppo lontano da lui. Solo lÃ¬ le fiamme si fanno trasparenti: la
// parte di una lingua che esce sopra la testa o fuori dai contorni resta piena (sul cielo una
// fiamma trasparente diventa una velatura rosa), anche se nasce davanti al petto.
float front_of_body(vec3 cam, vec3 p, vec4 bd) {
	vec3 rd = p - cam;
	float tf = length(rd);
	rd /= max(tf, 0.0001);
	vec3 a = bd.xyz - vec3(0.0, 1.2 * bd.w, 0.0);
	vec3 ab = vec3(0.0, 2.7 * bd.w, 0.0);
	vec3 w0 = cam - a;
	float b_ = dot(rd, ab);
	float c_ = dot(ab, ab);
	float d_ = dot(rd, w0);
	float e_ = dot(ab, w0);
	float den = c_ - b_ * b_;
	float sg = den > 0.00001 ? clamp((e_ - b_ * d_) / den, 0.0, 1.0) : 1.0;
	vec3 q = a + ab * sg;
	float t = dot(q - cam, rd);
	float dist = length(cam + rd * t - q);
	float ahead = t - tf;
	// (sopra la testa niente: lÃ¬ dietro c'Ã¨ il cielo, le fiamme restano piene)
	float py = cam.y + rd.y * t;
	return (1.0 - smoothstep(0.6 * bd.w, 0.9 * bd.w, dist))
		* (1.0 - smoothstep(a.y + ab.y - 0.05 * bd.w, a.y + ab.y + 0.3 * bd.w, py))
		* smoothstep(-0.05 * bd.w, 0.3 * bd.w, ahead) * (1.0 - smoothstep(2.5 * bd.w, 5.0 * bd.w, ahead));
}

void fragment() {
	float near = smoothstep(fade_near * 0.3, fade_near, -VERTEX.z);
	float force = v_data.w * near;
	if (body.w > 0.0) {
		force *= 1.0 - front_fade * front_of_body(INV_VIEW_MATRIX[3].xyz, v_world, body);
	}
	float age = v_data.y;
	if (kind == 1) {
		// brace: nucleo incandescente con alone, si raffredda (bianco -> arancio -> rosso) e tremola
		float d = length(v_q);
		float g = 1.0 - smoothstep(0.0, 1.0, d);
		g *= g;
		float h = clamp(v_data.x * (1.0 - age * 0.8), 0.0, 1.0);
		float flick = 0.7 + 0.3 * sin(TIME * 23.0 + v_data.z * 91.0);
		float a = g * force * (1.0 - smoothstep(0.75, 1.0, age));
		ALBEDO = ramp(h) * energy * (0.6 + 3.0 * h * h) * flick * a;
		ALPHA = a * opacity * 0.5;
	} else if (kind == 2) {
		// fumo grigio tenue: nasce trasparente, si gonfia, si dirada
		vec4 t = frames(v_luv);
		float life = smoothstep(0.0, 0.25, age) * (1.0 - smoothstep(0.45, 1.0, age));
		float dns = t.g * force * opacity * life;
		ALBEDO = smoke_color * dns;
		ALPHA = clamp(dns, 0.0, 1.0);
	} else {
		float yb = 0.5 - 0.5 * v_q.y;   // 0 alla base .. 1 in cima al quadrato
		// dettaglio in metri: il rumore sale (piÃ¹ veloce delle creste fini), sposta il flipbook di
		// piÃ¹ verso la cima, dove il fuoco si spezza
		vec2 pm = vec2(v_q.x * v_size.x, yb * v_size.y) + v_data.z * 7.0;
		vec2 w = texture(detail_noise, vec2(pm.x * 1.6, -pm.y * 1.6 + TIME * 1.3)).rg - 0.5;
		float wa = 0.07 * detail * (0.3 + 0.7 * yb);
		vec4 t = frames(v_luv + w * vec2(2.0 * wa, wa));
		float dr = texture(detail_noise, vec2(pm.x * 3.5, -pm.y * 3.0 + TIME * 2.4) + w * 0.3).b;
		// la vita della particella: si accende, si raffredda e si consuma (le parti fredde, cioÃ¨
		// punte, filamenti e bordi, spariscono per prime: il fuoco si spezza, non sbiadisce intero)
		// (anche l'accensione passa dal calore: prima le parti piÃ¹ calde, poi il resto)
		float fin = 1.0 - smoothstep(0.75, 1.0, age);
		float ero = erode * smoothstep(0.2, 1.0, age) + 0.6 * (1.0 - smoothstep(0.0, 0.15, age));
		float h = clamp((mix(t.r, t.b, shape) * v_data.x - ero) * (1.0 + ero) * (1.05 - cool * age), 0.0, 1.0);
		// creste sottili: il fronte della fiamma increspato, nitido anche da vicino
		h = clamp(h * mix(1.0, 0.82 + 0.4 * dr, detail) - 0.05 * detail * (1.0 - dr) * (1.0 - h), 0.0, 1.0);
		if (base_soft > 0.0) {
			h *= smoothstep(0.0, base_soft, yb);
		}
		if (lift > 0.0) {
			float l = lift * smoothstep(0.15, 1.0, age);
			h *= smoothstep(l - 0.05, l + 0.25, yb);
		}
		// la luce cresce col calore (il nucleo supera 1). Il corpo e le punte coprono lo sfondo
		// (alfa premoltiplicata: la fuliggine che brucia assorbe la luce di dietro): un rosso che
		// emette ma lascia passare il cielo diventa una velatura rosa. Giallo -> arancio -> rosso scuro
		// pieni, poi un velo sottile di fumo; solo il nucleo caldo copre meno e si somma.
		float top = smoothstep(0.3, 0.75, yb);
		// a fine vita la lingua si raffredda (la luce scende lungo la rampa fino al rosso scuro e si
		// spegne): resta fumo sottile che sparisce, mai un rosso trasparente
		float hc = h * smoothstep(0.3, 1.0, fin);
		// dove la fiamma emette: in cima con un fronte netto (la zona luminosa di una fiamma vera ha
		// un bordo), alla base sfumata sul corpo
		float cov = mix(smoothstep(0.08, 0.22, hc), smoothstep(0.08, 0.13, hc), top);
		// copertura: in cima piena dove emette e giÃ  prima (nessun rosso lascia passare il cielo:
		// rosso + blu = rosa), oltre il fronte e dove la lingua si Ã¨ spenta solo un velo di fumo
		// (soot: quanto copre); alla base cresce con la luce
		float occ_h = mix(opacity * smoothstep(0.06, 0.22, h),
			smoothstep(0.02, 0.1, h) * (cov + (1.0 - cov) * soot), top);
		vec3 col = ramp(hc) * energy * (0.3 + 0.55 * smoothstep(0.1, 0.6, hc) + 1.1 * hc * hc * hc) * cov;
		float occ = occ_h * (1.0 - core_add * smoothstep(0.6, 0.95, h));
		// la parte che copre senza emettere (il velo di fumo) ha il colore del fumo scuro
		float dark = max(occ_h - cov, 0.0);
		float sm = t.g * smoke_mix * smoothstep(0.35, 0.9, age) * (1.0 - occ_h);
		float f = force * smoothstep(0.0, 0.04, age) * smoothstep(0.0, 0.45, fin);
		ALBEDO = (col + soot_color * dark + smoke_color * sm) * f;
		ALPHA = clamp((occ + sm * 0.6) * f, 0.0, 1.0);
	}
}
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type particles;
// Movimento delle particelle del fuoco di Knuckles (lavoro "fuocoknux"): UN solo shader per tutti
// gli emettitori del suo fuoco (fiamme, nuclei, braci, fumo, vampate, anelli di fuoco, pugni), che
// cambiano solo i parametri (scripts/vfx/knux_fire.gd li costruisce). Al posto di
// ParticleProcessMaterial, che fa uno shader diverso per ogni combinazione di opzioni: qui una
// pipeline sola, preparata nella schermata di caricamento.
//
// Fisica del fuoco: il gas caldo nasce col corpo che brucia (eredita parte della sua velocitÃ ),
// l'aria lo frena (drag) e il calore lo spinge in alto (galleggiamento), una turbolenza che scorre lo
// fa ondeggiare e arricciare. La particella non gira a caso: la lingua si allinea al vento relativo
// al corpo (correndo le fiamme si piegano all'indietro, da fermo salgono dritte), le braci si
// allungano lungo la loro velocitÃ  (scia di movimento). Il disegno lo fa fire_particle.gdshader, che
// legge da qui: TRANSFORM[1] = asse della lingua per la sua lunghezza, |TRANSFORM[0]| = larghezza,
// CUSTOM = (angolo, etÃ  0..1, seme 0..1, durata relativa), COLOR.r = temperatura, COLOR.a = forza.
// AMOUNT_RATIO (GPUParticles3D.amount_ratio) dirada l'emissione: Ã¨ la qualitÃ  del preset grafico.

// --- nascita ---
uniform vec3 box = vec3(0.3, 0.4, 0.3);         // mezze misure della scatola di emissione (m, spazio dell'emettitore)
uniform float sphere = 0.0;                     // piÃ¹ un punto a caso in una sfera di questo raggio (m)
uniform float ring = 0.0;                       // anello orizzontale di questo raggio (m) invece della scatola
uniform vec3 direction = vec3(0.0, 1.0, 0.0);   // direzione di partenza (spazio dell'emettitore)
uniform float spread = 15.0;                    // apertura del cono (gradi; 180 = ogni direzione)
uniform vec2 speed = vec2(0.5, 1.5);            // velocitÃ  di partenza min, max (m/s)
uniform float radial_speed = 0.0;               // in piÃ¹, verso l'esterno dal centro (m/s): anelli e palle di fuoco
uniform float inherit = 0.0;                    // parte della velocitÃ  dell'emettitore che si porta dietro
uniform vec2 life = vec2(0.7, 1.0);             // durata, in parti di LIFETIME (min, max)
uniform vec2 size = vec2(0.4, 0.7);             // larghezza (m) min, max
uniform float intensity = 1.0;                  // forza delle particelle che nascono ora (sfumatura accesa/spenta)
uniform vec2 heat = vec2(0.85, 1.1);            // temperatura di ogni particella (moltiplica quella della texture)
// --- vita ---
uniform float buoyancy = 3.0;                   // spinta verso l'alto (m/sÂ², negativa = cade)
uniform float drag = 2.0;                       // frenata dell'aria (1/s)
uniform float turbulence = 1.5;                 // forza della turbolenza (m/sÂ²)
uniform float turb_scale = 1.3;                 // finezza della turbolenza (1/m)
uniform float radial_accel = 0.0;               // verso il centro dell'emettitore se negativa (carica)
uniform float orbit = 0.0;                      // giro attorno all'asse verticale dell'emettitore (m/sÂ²)
uniform vec3 size_curve = vec3(0.45, 1.0, 0.35); // larghezza a nascita, picco, fine (moltiplica size)
uniform float size_peak = 0.3;                  // etÃ  del picco
// --- forma ---
uniform float aspect = 1.6;                     // lunghezza della lingua / larghezza
uniform float stretch = 0.06;                   // allungamento in piÃ¹ lungo il vento relativo (s)
uniform float upright = 1.0;                    // quanto la lingua tende a stare dritta (il calore sale)
uniform float rel_wind = 1.0;                   // 1: il vento Ã¨ relativo all'emettitore (fiamme del corpo); 0: velocitÃ  vera (braci)
uniform float spin = 0.0;                       // giri a caso (rad/s, Â±), per il fumo

uint hash_u(uint x) {
	x = ((x >> uint(16)) ^ x) * uint(73244475);
	x = ((x >> uint(16)) ^ x) * uint(73244475);
	x = (x >> uint(16)) ^ x;
	return x;
}

float rnd(inout uint s) {
	s = hash_u(s + uint(1640531527));
	return float(s & uint(16777215)) / 16777215.0;
}

vec3 cone_dir(vec3 d, float deg, inout uint s) {
	d = length(d) > 0.0001 ? normalize(d) : vec3(0.0, 1.0, 0.0);
	float a = deg * 0.01745329;
	float z = mix(1.0, cos(a), rnd(s));
	float phi = rnd(s) * 6.2831853;
	float r = sqrt(max(1.0 - z * z, 0.0));
	vec3 l = vec3(r * cos(phi), r * sin(phi), z);
	vec3 up = abs(d.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
	vec3 t = normalize(cross(up, d));
	vec3 b = cross(d, t);
	return t * l.x + b * l.y + d * l.z;
}

float size_at(float age) {
	return age < size_peak
		? mix(size_curve.x, size_curve.y, smoothstep(0.0, size_peak, age))
		: mix(size_curve.y, size_curve.z, smoothstep(size_peak, 1.0, age));
}

// orientamento: asse della lingua per la sua lunghezza, larghezza sugli altri due assi
// velocitÃ  dell'emettitore, limitata (un teletrasporto in un fotogramma non lancia le fiamme)
vec3 emitter_v(vec3 ev) {
	float l = length(ev);
	return l > 60.0 ? ev * (60.0 / l) : ev;
}

void shape(inout mat4 xf, vec3 vel, vec3 emitter_vel, float age, float base, float seed) {
	float w = base * size_at(age);
	vec3 wind = vel - emitter_v(emitter_vel) * rel_wind;
	vec3 ax = wind * stretch + vec3(0.0, upright * 0.6, 0.0);
	float al = length(ax);
	ax = al > 0.0001 ? ax / al : vec3(0.0, 1.0, 0.0);
	// fuochi piÃ¹ alti e piÃ¹ bassi: ognuno il suo slancio
	float asp = aspect * mix(0.8, 1.35, fract(seed * 5.37));
	float len = w * asp + length(wind) * stretch * w * 2.0;
	vec3 up = abs(ax.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
	vec3 t = normalize(cross(up, ax));
	vec3 b = cross(ax, t);
	xf[0].xyz = t * w;
	xf[1].xyz = ax * len;
	xf[2].xyz = b * w;
}

void start() {
	uint s = hash_u(NUMBER + uint(1) + RANDOM_SEED);
	if (rnd(s) > AMOUNT_RATIO) {
		ACTIVE = false;
	}
	vec3 p;
	vec3 out_dir = vec3(0.0);
	if (ring > 0.0) {
		float a = rnd(s) * 6.2831853;
		out_dir = vec3(cos(a), 0.0, sin(a));
		p = out_dir * ring + vec3((rnd(s) * 2.0 - 1.0) * box.x, (rnd(s) * 2.0 - 1.0) * box.y, (rnd(s) * 2.0 - 1.0) * box.z);
	} else {
		p = vec3((rnd(s) * 2.0 - 1.0) * box.x, (rnd(s) * 2.0 - 1.0) * box.y, (rnd(s) * 2.0 - 1.0) * box.z);
		if (sphere > 0.0) {
			vec3 sd = cone_dir(vec3(0.0, 1.0, 0.0), 180.0, s);
			p += sd * sphere * pow(rnd(s), 0.333);
		}
		out_dir = length(p) > 0.0001 ? normalize(p) : cone_dir(vec3(0.0, 1.0, 0.0), 180.0, s);
	}
	vec3 v = cone_dir(direction, spread, s) * mix(speed.x, speed.y, rnd(s)) + out_dir * radial_speed;
	float base = mix(size.x, size.y, rnd(s));
	if (RESTART_POSITION) {
		TRANSFORM = mat4(1.0);
		TRANSFORM[3].xyz = p;
		TRANSFORM = EMISSION_TRANSFORM * TRANSFORM;
	}
	if (RESTART_VELOCITY) {
		VELOCITY = (EMISSION_TRANSFORM * vec4(v, 0.0)).xyz + emitter_v(EMITTER_VELOCITY) * inherit;
	}
	// la scala dell'emettitore (Metal Knuckles Ã¨ piÃ¹ grosso) vale anche per le particelle
	float sc = length(EMISSION_TRANSFORM[0].xyz);
	CUSTOM = vec4(rnd(s) * 6.2831853, 0.0, rnd(s), mix(life.x, life.y, rnd(s)));
	COLOR = vec4(mix(heat.x, heat.y, rnd(s)), base * sc / 8.0, rnd(s), intensity);
	mat4 xf = TRANSFORM;
	shape(xf, VELOCITY, EMITTER_VELOCITY, 0.0, base * sc, COLOR.b);
	TRANSFORM = xf;
}

void process() {
	float age = CUSTOM.y + DELTA / max(LIFETIME * CUSTOM.w, 0.001);
	CUSTOM.y = age;
	if (age >= 1.0) {
		ACTIVE = false;
	}
	vec3 p = TRANSFORM[3].xyz;
	float sd = COLOR.b * 37.0;
	float k = turb_scale;
	float tt = TIME * 1.7;
	// turbolenza che scorre verso l'alto (vortici che salgono col fuoco): somma di onde sfasate
	vec3 turb = vec3(
		sin(p.y * k * 2.3 - tt * 3.1 + sd) + 0.5 * sin(p.z * k * 3.7 + tt * 2.3 + sd * 1.7),
		0.4 * sin(p.x * k * 2.9 + tt * 1.9 + sd * 2.3),
		sin(p.y * k * 2.1 - tt * 2.7 + sd * 3.1) + 0.5 * sin(p.x * k * 3.3 - tt * 2.1 + sd * 0.7));
	vec3 acc = vec3(0.0, buoyancy, 0.0) + turb * turbulence;
	vec3 c = EMISSION_TRANSFORM[3].xyz;
	vec3 rel = p - c;
	if (radial_accel != 0.0 && length(rel) > 0.001) {
		acc += normalize(rel) * radial_accel;
	}
	if (orbit != 0.0) {
		vec3 h = vec3(rel.x, 0.0, rel.z);
		if (length(h) > 0.001) {
			acc += normalize(cross(vec3(0.0, 1.0, 0.0), h)) * orbit;
		}
	}
	VELOCITY += acc * DELTA;
	VELOCITY *= 1.0 / (1.0 + drag * DELTA);
	CUSTOM.x += spin * (COLOR.b * 2.0 - 1.0) * DELTA;
	mat4 xf = TRANSFORM;
	shape(xf, VELOCITY, EMITTER_VELOCITY, age, COLOR.g * 8.0, COLOR.b);
	TRANSFORM = xf;
}
␀␀␀␀␀␀shader_type spatial;
// Guscio di fiamme del fuoco di Knuckles (lavoro "fuocoknux") su un cilindro o un cono aperto
// (CylinderMesh): il boost infuocato (cono con la punta in avanti, le fiamme scorrono verso la coda)
// e l'aura di fuoco (cilindro attorno al corpo, le fiamme salgono). Lungo l'asse scorrono lingue di
// fuoco: rumore di una texture senza cuciture (assets/vfx/fire/fire_noise.png, molto piÃ¹ leggero del
// rumore calcolato) stirato lungo il flusso, con le creste che fanno le lingue; piene all'inizio,
// sempre piÃ¹ rotte verso la coda dove si spengono in rosso scuro. Visto di taglio il guscio sparisce
// (niente sagoma netta del cilindro), davanti al corpo resta leggero (si vede il personaggio dentro). Colori: la stessa rampa
// del corpo nero delle particelle (fire_particle.gdshader). Alfa premoltiplicata.
// L'asse della mesh: +Y = inizio del flusso (punta del cono, base dell'aura), -Y = coda.

render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform sampler2D noise_tex : filter_linear_mipmap, repeat_enable, hint_default_black;
uniform float heat = 0.0;          // 0 spento .. 1 pieno (sfumato dallo script)
uniform float half_len = 1.0;      // metÃ  della lunghezza della mesh (m), come la CylinderMesh
uniform float hot = 0.0;           // 0 guscio esterno, 1 nucleo interno (piÃ¹ caldo e pieno)
uniform float flow = 2.4;          // scorrimento del rumore lungo l'asse (ripetizioni al secondo)
uniform float around = 3.0;        // ripetizioni del rumore attorno all'asse (intero: senza cucitura)
uniform float along = 1.3;         // ripetizioni lungo l'asse
uniform float reach = 1.0;         // fin dove arrivano le lingue (1 = quasi in coda)
uniform float seed = 0.0;
uniform float energy = 1.0;
uniform float opacity = 0.5;       // quanto copre lo sfondo
uniform float rim_power = 1.5;     // quanto in fretta si alleggerisce davanti al corpo
uniform float wobble = 0.12;       // il guscio trema allargandosi verso la coda
uniform float fade_near = 1.6;     // vicino alla camera si dissolve (m)
uniform vec2 close_fade = vec2(1.5, 6.5); // da vicino (inquadrature strette) il guscio si alleggerisce:
                                   // a close_fade.x m resta il 35%, da close_fade.y m pieno
uniform vec3 c0 = vec3(0.12, 0.012, 0.0);
uniform vec3 c1 = vec3(0.7, 0.07, 0.0);
uniform vec3 c2 = vec3(1.0, 0.3, 0.02);
uniform vec3 c3 = vec3(1.0, 0.62, 0.13);
uniform vec3 c4 = vec3(1.0, 0.93, 0.7);

varying float axial;   // 0 all'inizio del flusso, 1 in coda

vec3 ramp(float h) {
	vec3 c = mix(c0, c1, smoothstep(0.0, 0.2, h));
	c = mix(c, c2, smoothstep(0.2, 0.45, h));
	c = mix(c, c3, smoothstep(0.45, 0.72, h));
	return mix(c, c4, smoothstep(0.75, 1.0, h));
}

void vertex() {
	axial = clamp((half_len - VERTEX.y) / (2.0 * half_len), 0.0, 1.0);
	float ang = UV.x * 6.2831853;
	float wob = sin(TIME * 21.0 + ang * 5.0 + axial * 9.0 + seed * 7.0) * 0.5
			+ sin(TIME * 33.0 - ang * 3.0 + axial * 13.0 + seed * 3.0) * 0.5;
	VERTEX.xz *= 1.0 + axial * wobble * (1.0 + wob);
}

void fragment() {
	float t = TIME * flow;
	vec2 uv = vec2(UV.x * around + seed, axial * along - t);
	float n1 = texture(noise_tex, uv).r;
	float n2 = texture(noise_tex, uv * vec2(2.0, 1.6) + vec2(0.37, -t * 0.55)).g;
	// creste stirate lungo il flusso: le lingue
	float rid = texture(noise_tex, vec2(UV.x * around * 2.0 + seed * 1.7, axial * along * 0.55 - t * 1.25)).b;
	float n = n1 * 0.5 + n2 * 0.3 + rid * 0.45;
	float body = n + 0.62 * reach - axial * (1.25 + 0.25 * (1.0 - hot));
	// contrasto alto: restano solo le creste (lingue separate), mai una velatura piena
	float h = smoothstep(0.34, 0.8, body);
	// inizio morbido e coda che si spegne, rosicchiati dal rumore (mai un bordo dritto)
	float ax_n = axial + (n1 - 0.5) * 0.14;
	h *= smoothstep(0.0, 0.18, ax_n) * (1.0 - smoothstep(0.75, 1.0, ax_n));
	// di taglio il guscio sparisce del tutto giÃ  lontano dalla sagoma (niente contorno del
	// cilindro, neanche sfumato); arde sul corpo, un po' piÃ¹ leggero proprio davanti (il
	// personaggio si vede dentro)
	float f = abs(dot(normalize(NORMAL), normalize(VIEW)));
	float shell = smoothstep(0.12, 0.8, f) * (1.0 - (0.55 - 0.35 * hot) * pow(smoothstep(0.8, 1.0, f), rim_power));
	float dist = length(VERTEX);
	float near = smoothstep(fade_near * 0.3, fade_near, dist) * mix(0.35, 1.0, smoothstep(close_fade.x, close_fade.y, dist));
	float temp = clamp(h * (0.5 + 0.38 * hot) * (1.05 - axial * 0.55), 0.0, 1.0);
	// come le lingue: il bordo freddo e fioco sfuma via (niente velatura rossa sul cielo)
	float a = smoothstep(0.08, 0.3, temp) * shell * heat * near;
	// luce e copertura separate, come le particelle: le lingue coprono lo sfondo (sul cielo chiaro
	// restano arancio e rosso scuro, mai rosa), il nucleo caldo copre meno e si somma
	ALBEDO = ramp(temp) * energy * (0.3 + 0.55 * smoothstep(0.1, 0.6, temp) + 1.1 * temp * temp * temp) * a;
	// copre almeno quanto emette (comincia un po' prima della luce): il rosso delle punte tiene il
	// colore sugli sfondi chiari invece di velarli di rosa
	float ao = smoothstep(0.04, 0.18, temp) * shell * heat * near;
	ALPHA = clamp(ao * opacity * (1.0 - 0.45 * smoothstep(0.6, 0.95, temp)), 0.0, 1.0);
}
␀␀shader_type spatial;
// Distorsione del calore sopra il fuoco di Knuckles (lavoro "fuocoknux"): un quadrato rivolto alla
// camera che sposta l'immagine dietro di sÃ© con un rumore che sale (l'aria calda che tremola).
// Una copia dello schermo per fotogramma (come l'acqua): accesa solo con la grafica Alta e Ultra
// (scripts/vfx/knux_fire.gd), ma la pipeline si prepara sempre nella schermata di caricamento.
// Si disegna prima delle fiamme (render_priority piÃ¹ bassa): copre solo lo sfondo, non il fuoco.
// Forza per oggetto (instance uniform "haze"): un materiale solo per tutti.
// Solo spostamento, mai colore: dove l'aria non trema copre appena (alfa che segue lo spostamento),
// cosÃ¬ anche se la copia dello schermo non combacia del tutto con l'immagine (sfocato, nebbia,
// effetti trasparenti dietro) non resta mai una colonna lattiginosa: si vede solo il tremolio.

render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform sampler2D screen_tex : hint_screen_texture, filter_linear, repeat_disable;
uniform sampler2D noise_tex : filter_linear_mipmap, repeat_enable, hint_default_black;
uniform float strength = 0.012;    // spostamento massimo (parte dello schermo)
uniform float rise = 0.9;          // salita del tremolio (ripetizioni al secondo)
instance uniform float haze = 0.0; // 0 niente .. 1 pieno

void vertex() {
	// rivolto alla camera, con la scala del nodo
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], MODEL_MATRIX[3]);
	MODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0),
		vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0),
		vec4(0.0, 0.0, 0.0, 1.0));
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
}

void fragment() {
	vec2 q = UV * 2.0 - 1.0;
	// piÃ¹ forte in alto (sopra le fiamme), sfumato sui bordi (un ovale stretto sulla sagoma)
	float m = (1.0 - smoothstep(0.2, 1.0, length(q * vec2(1.0, 0.85)))) * (0.55 + 0.45 * (1.0 - UV.y)) * haze;
	float t = TIME * rise;
	vec2 n = texture(noise_tex, UV * vec2(1.4, 1.0) + vec2(0.0, t)).rg - 0.5;
	n += (texture(noise_tex, UV * vec2(3.1, 2.3) + vec2(0.31, t * 1.9)).rg - 0.5) * 0.6;
	vec2 d = n * strength * m;
	vec2 suv = clamp(SCREEN_UV + d, vec2(0.0), vec2(1.0));
	ALBEDO = textureLod(screen_tex, suv, 0.0).rgb;
	// copre quanto sposta (in pixel): niente spostamento, niente copertura
	float px = length(d * VIEWPORT_SIZE);
	ALPHA = clamp(m * 1.5, 0.0, 0.9) * smoothstep(0.15, 1.2, px);
}
␀␀␀␀␀shader_type spatial;
// Launch Base Zone, lo SCONTRO del cielo: il MIRINO D'ORO sui punti deboli aperti di Metal Overlord
// (scripts/bosses/lbz_overlord.gd, un quadrato per punto, girato verso la camera, sopra a tutto). Prima
// era un bagliore piccolo che non si notava: adesso un bersaglio grande che pulsa, un anello che gira
// con quattro tacche, un anello interno fisso e il cuore acceso; "lock" (0..1, lo scrive lo scontro sul
// PC di chi guarda quando lo SCATTO lo aggancerebbe) stringe le tacche verso il centro e lo fa piÃ¹
// bianco. Oro e arancio soli, col contorno scuro (si legge sul blu dell'Overlord come sulle nubi
// bianche), mai viola.

render_mode unshaded, blend_mix, depth_draw_never, depth_test_disabled, cull_disabled, shadows_disabled, fog_disabled;

uniform vec3 gold : source_color = vec3(1.0, 0.76, 0.22);
uniform vec3 hot : source_color = vec3(1.0, 0.95, 0.70);
uniform float energy = 2.2;
uniform float lock = 0.0;
uniform float alpha = 1.0;

void vertex() {
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], MODEL_MATRIX[3]);
	MODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, 1.0, 0.0), vec4(0.0, 0.0, 0.0, 1.0));
}

void fragment() {
	vec2 q = UV * 2.0 - 1.0;
	float r = length(q);
	float ang = atan(q.y, q.x);
	float pulse = 0.5 + 0.5 * sin(TIME * 9.0);
	// l'anello esterno che gira, rotto in quattro archi
	float spin = ang + TIME * 2.2;
	float arcs = smoothstep(0.15, 0.35, abs(sin(spin * 2.0)));
	float d_o = abs(r - 0.82);
	float ring_o = (1.0 - smoothstep(0.035, 0.05, d_o)) * arcs;
	float ink_o = (1.0 - smoothstep(0.07, 0.09, d_o)) * arcs;
	// le quattro tacche verso il centro (con "lock" si stringono)
	float tk_r = mix(0.6, 0.36, lock);
	float tick = 0.0;
	float ink_t = 0.0;
	for (int i = 0; i < 4; i++) {
		float a = float(i) * 1.5708 + 0.7854 - TIME * 1.1 * (1.0 - lock);
		vec2 dir = vec2(cos(a), sin(a));
		float along = dot(q, dir);
		float across = abs(dot(q, vec2(-dir.y, dir.x)));
		float inr = step(tk_r, along) * step(along, tk_r + 0.18);
		tick += (1.0 - smoothstep(0.03, 0.045, across)) * inr;
		ink_t += (1.0 - smoothstep(0.06, 0.08, across)) * step(tk_r - 0.03, along) * step(along, tk_r + 0.21);
	}
	// l'anello interno e il cuore
	float d_i = abs(r - 0.3 - 0.04 * pulse);
	float ring_i = 1.0 - smoothstep(0.025, 0.04, d_i);
	float ink_i = 1.0 - smoothstep(0.06, 0.08, d_i);
	float core = exp(-r * r * 40.0) * (0.8 + 0.6 * pulse);
	float m = clamp(ring_o + tick + ring_i + core, 0.0, 1.0);
	float ink = clamp(ink_o + ink_t + ink_i, 0.0, 1.0);
	vec3 col = mix(gold, hot, clamp(core + lock * 0.5, 0.0, 1.0)) * energy * (0.85 + 0.3 * pulse);
	ALBEDO = mix(vec3(0.03, 0.02, 0.0), col, m);
	ALPHA = clamp(max(m, ink * 0.7), 0.0, 1.0) * alpha;
}
␀␀␀// Metal Overlord del cielo di Launch Base (scripts/bosses/lbz_overlord.gd), corpo unito come quello
// dell'Eggmanland (assets/bosses/eglb/metal_overlord_mat/metal_overlord_body.gdshader, che non si tocca:
// stessi uniform, cosÃ¬ metal_overlord_rig.gd _apply_materials ci scrive glow, flash e strain) ma SENZA
// VIOLA (regola del gioco: all'utente il viola non piace):
//   - le tessiture blu-viola e viola del glb (tinta 232-335 gradi) diventano blu acciaio (218-226: il blu
//     di Metal Sonic), le altre (rosso, arancio, ciano, grigi) restano;
//   - bordo e bagliore del petto coi colori dati dallo script (azzurro e oro, non viola);
//   - una light() propria: il colore delle luci arriva desaturato (light_desat) sul metallo, cosÃ¬ il fuoco
//     delle rovine e il tramonto non spingono il blu verso il viola.
// Ogni vertice porta nel COLORE il suo strato dell'array (r = strato / 255), il metallo (g) e la ruviditÃ  (b).
shader_type spatial;
render_mode cull_disabled, depth_draw_opaque;

uniform sampler2DArray layers : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec4 rim_color : source_color = vec4(0.35, 0.7, 1.0, 1.0);
uniform float rim_strength = 0.35;
uniform float flash = 0.0;                 // lampo bianco del colpo (0..1)
uniform vec4 glow_color : source_color = vec4(1.0, 0.62, 0.18, 1.0);
uniform vec3 glow_center = vec3(0.0, 1.43, 0.19);   // spazio del modello (petto, sopra il nucleo)
uniform float glow_radius = 0.42;
uniform float glow = 0.0;                  // bagliore del petto (0..1)
uniform float strain = 0.0;                // scintille di fatica su tutto il corpo (barcollare)
uniform float time_ofs = 0.0;
uniform float blue_hue = 218.0;            // gradi: dove va il blu-viola del glb
uniform float light_desat = 0.6;           // quanto il colore delle luci si perde sul corpo

varying vec3 mpos;

void vertex() {
	mpos = VERTEX;
}

float hash31(vec3 p) {
	p = fract(p * 0.1031);
	p += dot(p, p.yzx + 33.33);
	return fract((p.x + p.y) * p.z);
}

vec3 rgb2hsv(vec3 c) {
	vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
	vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
	vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
	float d = q.x - min(q.w, q.y);
	float e = 1.0e-10;
	return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsv2rgb(vec3 c) {
	vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
	return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}

vec3 to_srgb(vec3 c) {
	return pow(max(c, vec3(0.0)), vec3(1.0 / 2.2));
}

vec3 to_lin(vec3 c) {
	return pow(max(c, vec3(0.0)), vec3(2.2));
}

void fragment() {
	float layer = floor(COLOR.r * 255.0 + 0.5);
	vec3 alb = texture(layers, vec3(UV, layer)).rgb;
	// il blu-viola e il viola (tinta 232-335) al blu acciaio, in sRGB come le tinte misurate
	vec3 hsv = rgb2hsv(to_srgb(alb));
	float hue = hsv.x * 360.0;
	float viola = smoothstep(0.08, 0.16, hsv.y) * smoothstep(226.0, 236.0, hue) * (1.0 - smoothstep(335.0, 345.0, hue));
	float nh = blue_hue + clamp((hue - 232.0) * 0.08, 0.0, 8.0);
	vec3 blu = to_lin(hsv2rgb(vec3(nh / 360.0, hsv.y * 0.85, hsv.z * 0.9)));
	ALBEDO = mix(alb, blu, viola);
	METALLIC = COLOR.g;
	ROUGHNESS = COLOR.b;
	SPECULAR = 0.5;
	float ndv = clamp(dot(NORMAL, VIEW), 0.0, 1.0);
	float rim = pow(1.0 - ndv, 3.0);
	vec3 e = rim_color.rgb * rim * rim_strength;
	float g = glow * smoothstep(glow_radius, glow_radius * 0.15, distance(mpos, glow_center));
	e += glow_color.rgb * g * 4.0;
	if (strain > 0.001) {
		float n = hash31(floor(mpos * 24.0) + floor((TIME + time_ofs) * 14.0));
		e += glow_color.rgb * strain * step(0.93, n) * 3.0;
	}
	e += vec3(1.0) * flash * 1.6;
	EMISSION = e;
}

// Lambert + GGX (Schlick, Smith) con la luce desaturata: si vede quanto Ã¨ forte, non di che colore Ã¨.
void light() {
	vec3 n = NORMAL;
	vec3 l = LIGHT;
	vec3 v = VIEW;
	vec3 h = normalize(l + v);
	float ndl = clamp(dot(n, l), 0.0, 1.0);
	float ndv = clamp(dot(n, v), 0.001, 1.0);
	float ndh = clamp(dot(n, h), 0.0, 1.0);
	float vdh = clamp(dot(v, h), 0.0, 1.0);
	float luma = dot(LIGHT_COLOR, vec3(0.299, 0.587, 0.114));
	vec3 lc = mix(LIGHT_COLOR, vec3(luma), light_desat);
	float a = max(ROUGHNESS * ROUGHNESS, 0.002);
	float a2 = a * a;
	float dd = ndh * ndh * (a2 - 1.0) + 1.0;
	float D = a2 / (PI * dd * dd);
	float k = (ROUGHNESS + 1.0) * (ROUGHNESS + 1.0) / 8.0;
	float G = (ndl / (ndl * (1.0 - k) + k)) * (ndv / (ndv * (1.0 - k) + k));
	vec3 f0 = mix(vec3(0.04), ALBEDO, METALLIC);
	vec3 F = f0 + (1.0 - f0) * pow(1.0 - vdh, 5.0);
	vec3 spec = D * G * F / max(4.0 * ndl * ndv, 0.001);
	vec3 kd = (1.0 - F) * (1.0 - METALLIC);
	DIFFUSE_LIGHT += kd * ALBEDO / PI * lc * ATTENUATION * ndl * PI;
	SPECULAR_LIGHT += spec * lc * ATTENUATION * ndl;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// La sfera dorata di chi vola senza forma Super nello scontro del cielo di Launch Base (scripts/level/
// lbz_sfera.gd, piano_atto2 Â§4.5): come il riferimento team_super_heroes.png, un guscio bianco-oro
// trasparente col bordo acceso (Fresnel) e dentro lingue di luce che girano attorno al personaggio
// rannicchiato. Additiva sul bordo, quasi trasparente al centro (il personaggio si vede). Niente viola:
// solo bianco, crema, oro e arancio.
// I colori li dÃ  lo script (i default qui sotto non passano in lineare).

render_mode blend_add, unshaded, cull_back, depth_draw_never, shadows_disabled;

uniform vec3 col_rim : source_color = vec3(1.0, 0.86, 0.45);
uniform vec3 col_core : source_color = vec3(1.0, 0.97, 0.86);
uniform vec3 col_deep : source_color = vec3(1.0, 0.55, 0.12);
uniform float rim_power = 2.2;
uniform float energy = 1.0;          // 0 spenta .. 1 accesa (comparsa e scomparsa)
uniform float flash = 0.0;           // lampo (scatto, colpo)
uniform float speed = 1.0;           // velocitÃ  delle lingue
uniform float seed = 0.0;

varying vec3 v_obj;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}

void vertex() {
	v_obj = normalize(VERTEX);
}

void fragment() {
	float ndv = clamp(abs(dot(NORMAL, VIEW)), 0.0, 1.0);
	float fres = pow(1.0 - ndv, rim_power);
	// lingue di luce: bande di rumore che scorrono lungo la longitudine, due strati controrotanti
	float lon = atan(v_obj.x, v_obj.z);
	float lat = asin(clamp(v_obj.y, -1.0, 1.0));
	float t = TIME * speed + seed * 7.13;
	float n1 = vnoise(vec2(lon * 2.0 + t * 1.7, lat * 3.0 - t * 0.6));
	float n2 = vnoise(vec2(-lon * 3.0 + t * 1.1 + 4.0, lat * 4.0 + t * 0.9));
	float tongue = smoothstep(0.62, 0.92, n1) * 0.8 + smoothstep(0.68, 0.95, n2) * 0.6;
	// bagliore pulsante
	float beat = 0.85 + 0.15 * sin(TIME * 5.3 + seed * 3.1);
	vec3 c = col_rim * fres * 1.6 * beat;
	c += mix(col_deep, col_core, ndv) * tongue * (0.35 + 0.65 * fres);
	c += col_core * 0.05;
	c += col_core * flash * (0.6 + fres);
	ALBEDO = c * energy;
}
␀␀␀␀// Bolla di distorsione della scena d'entrata di Mecha Knuckles (mecha_boss_intro.gd): il
// teletrasporto (l'aria che si piega attorno a lui, risucchiata o sputata fuori) e l'onda d'urto
// della parata. Una sfera: dentro lo sfondo (screen texture) spostato lungo la normale vista dalla
// camera, sul bordo un anello di luce gialla, dentro un velo giallo. Shader statico condiviso da
// tutte le bolle (un materiale per bolla, stessi uniform).
shader_type spatial;
render_mode unshaded, blend_mix, cull_back, depth_draw_never, shadows_disabled, fog_disabled;

uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap, repeat_disable;
uniform vec3 tint : source_color = vec3(1.0, 0.82, 0.22);
uniform float strength = 0.0;   // quanto piega lo sfondo (0..1)
uniform float rim = 0.0;        // anello di luce sul bordo
uniform float fill = 0.0;       // velo luminoso dentro
uniform float thin = 0.0;       // 1 = solo il guscio (onda d'urto): il centro resta pulito

void fragment() {
	float facing = clamp(dot(NORMAL, VIEW), 0.0, 1.0);
	float edge = 1.0 - facing;                       // 0 al centro della sfera, 1 sul contorno
	float shell = mix(1.0, smoothstep(0.25, 0.85, edge), thin);
	vec2 off = NORMAL.xy * 0.07 * strength * shell * (0.4 + 0.6 * edge);
	vec3 bg = textureLod(screen_tex, SCREEN_UV - off, 0.0).rgb;
	vec3 col = bg;
	col += tint * (pow(edge, 3.0) * rim * 2.6 + fill * (1.0 - 0.5 * edge) * shell);
	ALBEDO = col;
	ALPHA = clamp(max(strength * shell, rim * pow(edge, 2.0) + fill * shell), 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Immagine residua di Metal Knuckles (pugno a razzo, planata, picchiata): la sagoma del corpo
// rimasta indietro, rosso cupo dentro e bordo arancio acceso in controluce. Semitrasparente (non
// additiva: sull'arena arancione resta rossa invece di diventare bianca), sfuma con "alpha"
// (mk_fx.gd). Solo cosmetica.

render_mode unshaded, blend_mix, depth_draw_never, cull_back, shadows_disabled, fog_disabled;

uniform vec4 color : source_color = vec4(0.45, 0.02, 0.0, 1.0);
uniform vec4 rim_color : source_color = vec4(1.0, 0.26, 0.03, 1.0);
uniform float alpha = 1.0;
uniform float energy = 1.0;

void fragment() {
	float facing = clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0);
	float rim = pow(1.0 - facing, 1.8);
	ALBEDO = mix(color.rgb, rim_color.rgb * energy, rim);
	ALPHA = clamp((0.3 + 0.65 * rim) * alpha, 0.0, 1.0);
}
␀␀shader_type spatial;
// Onda d'urto della schiacciata di Metal Knuckles: fascia cilindrica aperta che si allarga sul
// terreno. Bianca-arancio alla base, sfuma verso l'alto, con strappi di rumore che scorrono.
// Additiva, solo cosmetica (il danno lo calcola mk_hazards.gd).

render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform float fade = 1.0;
uniform float energy = 2.2;
uniform vec4 hot : source_color = vec4(1.0, 0.85, 0.55, 1.0);
uniform vec4 cold : source_color = vec4(1.0, 0.3, 0.05, 1.0);

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vn(vec2 x) {
	vec2 i = floor(x); vec2 f = fract(x); f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}

void fragment() {
	float h = UV.y;           // 0 in alto, 1 in basso (CylinderMesh)
	float n = vn(vec2(UV.x * 40.0, h * 3.0 - TIME * 6.0));
	float a = pow(h, 2.5) * (0.55 + 0.45 * n);
	vec3 c = mix(cold.rgb, hot.rgb, pow(h, 6.0));
	ALBEDO = c * a * energy * fade;
}
␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Avvisi a terra del boss Metal Knuckles (dove arriverÃ  il colpo): anello che si stringe sul
// bersaglio della schiacciata, corsia del pugno a razzo con frecce che scorrono, cerchio dove
// cadrÃ  una bomba, ventaglio del lanciafiamme (mode 3). Disegnato su un PlaneMesh appoggiato al
// suolo; additivo, rosso che pulsa.

render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform int mode = 0;               // 0 anello, 1 corsia con frecce, 2 cerchio pieno, 3 ventaglio
uniform vec4 color : source_color = vec4(1.0, 0.12, 0.05, 1.0);
uniform float energy = 2.0;
uniform float fade = 1.0;           // 0..1, comparsa/scomparsa
uniform float ring = 0.8;           // raggio dell'anello (0..1 del mezzo lato)
uniform float width = 0.08;         // spessore dell'anello
uniform float pulse = 8.0;          // pulsazioni al secondo (rad/s)
uniform float aspect = 1.0;         // corsia: lunghezza / larghezza
uniform float half_angle = 0.96;    // ventaglio: mezza apertura (rad), centrato sull'avanti (-Z)
uniform float side = 1.0;           // ventaglio: +1 il getto parte da sinistra, -1 da destra
uniform float inner = 0.12;         // ventaglio: raggio vuoto attorno al boss (0..1)

void fragment() {
	vec2 p = UV * 2.0 - 1.0;
	float a = 0.0;
	float puls = 0.65 + 0.35 * sin(TIME * pulse);
	if (mode == 0) {
		float r = length(p);
		a = smoothstep(width, 0.0, abs(r - ring)) + 0.25 * smoothstep(ring, 0.0, r) * smoothstep(1.0, 0.98, r);
		a *= step(r, 1.0);
	} else if (mode == 1) {
		// corsia lungo V: bordi pieni, frecce ">" che scorrono in avanti (V cresce in avanti)
		float edge = smoothstep(0.75, 0.95, abs(p.x));
		float v = UV.y * aspect;
		float chev = fract(v * 0.5 - abs(p.x) * 0.35 - TIME * 2.5);
		float arrow = smoothstep(0.0, 0.08, chev) * smoothstep(0.35, 0.2, chev) * step(abs(p.x), 0.75);
		float ends = smoothstep(0.0, 0.03, UV.y) * smoothstep(1.0, 0.97, UV.y);
		a = (edge * 0.9 + arrow * 0.7 + 0.12) * ends * step(abs(p.x), 1.0);
	} else if (mode == 2) {
		float r = length(p);
		a = (smoothstep(1.0, 0.85, r) * 0.35 + smoothstep(0.12, 0.0, abs(r - 0.9)) * 0.9) * step(r, 1.0);
	} else {
		// ventaglio del lanciafiamme: settore pieno tenue, bordo esterno, il lato da cui parte il
		// getto piÃ¹ acceso e frecce ad arco che scorrono nel verso in cui girerÃ 
		float r = length(p);
		float ang = atan(p.x, -p.y);          // 0 avanti, + verso destra (+X)
		float inside = step(abs(ang), half_angle) * step(r, 1.0) * smoothstep(inner, inner + 0.03, r);
		float rim = smoothstep(0.04, 0.0, abs(r - 0.97));
		float start_a = -side * half_angle;   // il getto parte dal lato sinistro (-X) con side = +1
		float d_start = abs(ang - start_a) * r;
		float start_edge = smoothstep(0.045, 0.0, d_start);
		float u = (ang - start_a) * side / (2.0 * half_angle);   // 0 inizio .. 1 fine del giro
		float chev = fract(u * 6.0 - r * 0.6 - TIME * 1.6);
		float arrow = smoothstep(0.0, 0.1, chev) * smoothstep(0.32, 0.18, chev) * smoothstep(0.35, 0.5, r);
		a = inside * (0.16 + rim * 0.9 + start_edge * 1.4 + arrow * 0.45);
	}
	ALBEDO = color.rgb * a * energy * fade * puls;
}
␀␀␀␀␀␀␀␀shader_type spatial;
// Archi elettrici gialli di Mecha Knuckles (aura del sovraccarico, mani cariche, scariche della
// sconfitta, stordito): un QuadMesh 1x1 che il vertex shader stende come un nastro rivolto alla
// telecamera dal punto "a" al punto "b" (mondo); il fulmine frastagliato si rifÃ  "rate" volte al
// secondo. Un solo materiale per tutti gli archi: estremi, seme e intensitÃ  sono parametri
// d'istanza. Chi lo usa mette il nodo a metÃ  fra a e b con un custom_aabb che li contiene.

render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled, skip_vertex_transform;

instance uniform vec3 a = vec3(0.0);
instance uniform vec3 b = vec3(0.0, 1.0, 0.0);
instance uniform float seed = 0.0;
instance uniform float alpha = 1.0;
uniform vec4 color : source_color = vec4(1.0, 0.78, 0.12, 1.0);
uniform vec4 core : source_color = vec4(1.0, 1.0, 0.9, 1.0);
uniform float energy = 3.2;
uniform float width = 0.28;          // mezza larghezza del nastro (metri): quanto puÃ² frastagliarsi
uniform float rate = 16.0;

varying float v_len;

float hash(float x) { return fract(sin(x * 127.1) * 43758.5453); }
float n1(float x) {
	float i = floor(x); float f = fract(x); f = f * f * (3.0 - 2.0 * f);
	return mix(hash(i), hash(i + 1.0), f) * 2.0 - 1.0;
}

void vertex() {
	float t = VERTEX.y + 0.5;
	vec3 wp = mix(a, b, t);
	vec3 axis = b - a;
	vec3 cam = INV_VIEW_MATRIX[3].xyz;
	vec3 side = cross(axis, cam - wp);
	side = length(side) > 1e-5 ? normalize(side) : vec3(1.0, 0.0, 0.0);
	wp += side * VERTEX.x * 2.0 * width;
	VERTEX = (VIEW_MATRIX * vec4(wp, 1.0)).xyz;
	NORMAL = vec3(0.0, 0.0, 1.0);
	v_len = max(length(axis), 0.01);
}

void fragment() {
	float x = UV.x * 2.0 - 1.0;          // -1..1 attraverso il nastro
	float y = UV.y;
	float k = floor(TIME * rate) + seed * 31.0;
	// spostamento del fulmine: due ottave, nullo alle estremitÃ 
	float env = sin(y * 3.14159);
	float off = (n1(y * v_len * 2.2 + k * 7.3) * 0.7 + n1(y * v_len * 6.0 + k * 3.1) * 0.3) * env * 0.75;
	float d = abs(x - off);
	float line = smoothstep(0.16, 0.0, d);
	float halo = smoothstep(0.7, 0.0, d) * 0.35;
	vec3 c = mix(color.rgb, core.rgb, line);
	ALBEDO = c * (line + halo) * energy * alpha;
}
␀␀␀shader_type spatial;
// Sfere di plasma giallo di Mecha Knuckles (colpi dalle mani, sfere che curvano, sfere da
// rimandare, il colpo caricato): nucleo quasi bianco, bordo giallo acceso, plasma che ribolle e
// gira. Additiva su una SphereMesh; "pulse" > 0 la fa pulsare (le sfere da colpire), "fade" la
// spegne. Solo cosmetica (il danno lo calcola mecha_hazards.gd).

render_mode unshaded, blend_add, depth_draw_never, cull_back, shadows_disabled, fog_disabled;

uniform vec4 core : source_color = vec4(1.0, 0.98, 0.82, 1.0);
uniform vec4 edge : source_color = vec4(1.0, 0.72, 0.08, 1.0);
uniform float energy = 2.6;
uniform float fade = 1.0;
uniform float swirl = 3.0;          // velocitÃ  del ribollire
uniform float pulse = 0.0;          // 0..1: pulsazione forte (bersaglio da colpire)
uniform float seed = 0.0;

varying vec3 v_obj;

float hash3(vec3 p) { return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453); }
float vn3(vec3 x) {
	vec3 i = floor(x); vec3 f = fract(x); f = f * f * (3.0 - 2.0 * f);
	float a = mix(mix(hash3(i), hash3(i + vec3(1, 0, 0)), f.x), mix(hash3(i + vec3(0, 1, 0)), hash3(i + vec3(1, 1, 0)), f.x), f.y);
	float b = mix(mix(hash3(i + vec3(0, 0, 1)), hash3(i + vec3(1, 0, 1)), f.x), mix(hash3(i + vec3(0, 1, 1)), hash3(i + vec3(1, 1, 1)), f.x), f.y);
	return mix(a, b, f.z);
}

void vertex() {
	v_obj = normalize(VERTEX);
}

void fragment() {
	float facing = clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0);
	float rim = pow(1.0 - facing, 1.6);
	float t = TIME * swirl + seed * 17.0;
	// due strati di rumore che girano in versi opposti attorno all'asse verticale
	float c = cos(t * 0.35), s = sin(t * 0.35);
	vec3 p1 = vec3(v_obj.x * c - v_obj.z * s, v_obj.y, v_obj.x * s + v_obj.z * c);
	float n = vn3(p1 * 3.2 + vec3(0.0, t * 0.6, 0.0)) * 0.6 + vn3(v_obj * 6.5 - vec3(t * 0.4)) * 0.4;
	float puls = 1.0 + pulse * (0.45 * sin(TIME * 14.0) + 0.25);
	float body = mix(0.55, 1.0, smoothstep(0.25, 0.85, n));
	// nucleo bianco solo al centro, il resto giallo: anche su un fondo chiaro si legge il colore
	float hot = smoothstep(0.72, 1.0, facing);
	vec3 col = mix(edge.rgb, core.rgb, clamp(hot * 0.9 + (n - 0.5) * 0.3, 0.0, 1.0));
	// venature piÃ¹ chiare che scorrono sulla superficie
	float vein = smoothstep(0.06, 0.0, abs(n - 0.55)) * 0.45;
	ALBEDO = (col * body + vec3(1.0, 0.92, 0.6) * vein) * energy * fade * puls * (0.7 + rim * 0.8);
}
␀␀␀␀␀shader_type spatial;
// Raggi di plasma giallo (il laser dagli occhi, la linea di mira, la colonna del teletrasporto):
// su una CylinderMesh alta 1 lungo Y, scalata alla lunghezza. Al centro (dove si guarda il
// cilindro di fronte) Ã¨ quasi bianco, ai bordi sfuma nel giallo; il plasma scorre lungo il raggio.
// "dash" > 0 lo fa a trattini che scorrono (linea di mira). Additivo, solo cosmetico.

render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform vec4 color : source_color = vec4(1.0, 0.75, 0.1, 1.0);
uniform vec4 core : source_color = vec4(1.0, 0.98, 0.85, 1.0);
uniform float energy = 3.0;
uniform float fade = 1.0;
uniform float scroll = 6.0;         // scorrimento lungo il raggio (giri di rumore al secondo)
uniform float length_m = 10.0;      // lunghezza in metri (per la scala del rumore e dei trattini)
uniform float dash = 0.0;           // 0..1: trattini che scorrono verso la punta
uniform float soft_end = 0.0;       // 0..1: sfuma verso le due estremitÃ  (colonna del teletrasporto)

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vn(vec2 x) {
	vec2 i = floor(x); vec2 f = fract(x); f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}

void fragment() {
	float facing = abs(dot(normalize(NORMAL), normalize(VIEW)));
	float prof = pow(facing, 1.4);
	float along = (1.0 - UV.y) * length_m;      // 0 alla base (y = -0.5), cresce verso la punta
	float n = vn(vec2(UV.x * 6.0, along * 0.9 - TIME * scroll)) * 0.5 + vn(vec2(UV.x * 13.0 + 3.1, along * 2.3 - TIME * scroll * 1.7)) * 0.5;
	float a = prof * (0.65 + 0.55 * n);
	float d = mix(1.0, step(0.45, fract(along * 0.9 - TIME * 3.0)), dash);
	float ends = mix(1.0, smoothstep(0.0, 0.25, UV.y) * smoothstep(1.0, 0.6, UV.y), soft_end);
	vec3 c = mix(color.rgb, core.rgb, smoothstep(0.55, 0.95, facing));
	ALBEDO = c * a * d * ends * energy * fade;
}
␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Terreno bruciato dal laser e dal colpo caricato di Mecha Knuckles: chiazza su un PlaneMesh
// appoggiato al suolo. Appena colpito Ã¨ incandescente (giallo-bianco che pulsa), poi si raffredda
// in arancio e resta una bruciatura scura che sparisce. Un solo materiale per tutte le chiazze:
// il calore, la dissolvenza e il seme sono parametri d'istanza. Solo cosmetico.

render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

instance uniform float heat = 1.0;    // 1 appena bruciato .. 0 freddo
instance uniform float alpha = 1.0;   // dissolvenza della bruciatura
instance uniform float seed = 0.0;
uniform vec4 hot : source_color = vec4(1.0, 0.92, 0.55, 1.0);
uniform vec4 warm : source_color = vec4(1.0, 0.42, 0.05, 1.0);
uniform vec4 char_col : source_color = vec4(0.06, 0.045, 0.035, 1.0);
uniform float energy = 3.0;

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vn(vec2 x) {
	vec2 i = floor(x); vec2 f = fract(x); f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}

void fragment() {
	vec2 p = UV * 2.0 - 1.0;
	float r = length(p);
	float n = vn(p * 3.0 + seed * 13.0) * 0.6 + vn(p * 7.0 - seed * 5.0) * 0.4;
	float shape = smoothstep(1.0, 0.55, r + (n - 0.5) * 0.5);
	// il cuore della bruciatura resta caldo piÃ¹ a lungo dei bordi
	float h = clamp(heat * 1.3 - r * 0.45 + (n - 0.5) * 0.3, 0.0, 1.0);
	float flick = 0.85 + 0.15 * sin(TIME * 23.0 + seed * 40.0);
	vec3 glow = mix(warm.rgb, hot.rgb, smoothstep(0.5, 1.0, h)) * energy * flick;
	ALBEDO = mix(char_col.rgb, glow, smoothstep(0.05, 0.6, h));
	ALPHA = clamp(shape * alpha * mix(0.8, 1.0, h), 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Cupola del campo energetico giallo di Mecha Knuckles (su una SphereMesh): bordo acceso in
// controluce, maglia esagonale che scorre piano, increspatura che si allarga dal punto colpito
// (hit_dir nello spazio della sfera, hit_t secondi dal colpo), crepe che si accendono e
// sfarfallano ("crack" 0..1). Additiva, a due facce; "fade" la spegne. Solo cosmetica.

render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform vec4 color : source_color = vec4(1.0, 0.8, 0.15, 1.0);
uniform vec4 rim_color : source_color = vec4(1.0, 0.96, 0.7, 1.0);
uniform float energy = 1.1;
uniform float fade = 1.0;
uniform vec3 hit_dir = vec3(0.0, 0.0, 1.0);
uniform float hit_t = 9.0;
uniform float crack = 0.0;
uniform float flicker = 0.0;

varying vec3 v_obj;

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vn(vec2 x) {
	vec2 i = floor(x); vec2 f = fract(x); f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}

// distanza dal bordo della cella esagonale (0 sul bordo)
float hex_edge(vec2 p) {
	vec2 s = vec2(1.0, 1.7320508);
	vec2 a = mod(p, s) - s * 0.5;
	vec2 b = mod(p - s * 0.5, s) - s * 0.5;
	vec2 g = dot(a, a) < dot(b, b) ? a : b;
	g = abs(g);
	float d = max(dot(g, s * 0.5), g.x);
	return 0.5 - d;
}

void vertex() {
	v_obj = normalize(VERTEX);
}

void fragment() {
	float facing = abs(dot(normalize(NORMAL), normalize(VIEW)));
	float rim = pow(1.0 - facing, 3.0);
	vec2 huv = vec2(UV.x * 28.0, UV.y * 9.0 - TIME * 0.25);
	float hex = smoothstep(0.07, 0.0, hex_edge(huv));
	float n = vn(vec2(UV.x * 10.0, UV.y * 6.0) + TIME * 0.6);
	// increspatura dal punto colpito: un anello che corre sulla sfera e si spegne
	float ang = acos(clamp(dot(v_obj, normalize(hit_dir)), -1.0, 1.0));
	float front = hit_t * 4.0;
	float ripple = smoothstep(0.35, 0.0, abs(ang - front)) * exp(-hit_t * 3.5) * 2.5;
	float spot = smoothstep(0.7, 0.0, ang) * exp(-hit_t * 7.0) * 2.0;
	// crepe: linee frastagliate che si accendono man mano
	float cn = vn(vec2(UV.x * 18.0, UV.y * 7.0)) * 0.65 + vn(vec2(UV.x * 41.0, UV.y * 15.0)) * 0.35;
	float cr = smoothstep(0.035, 0.0, abs(cn - 0.5)) * step(0.01, crack) * (0.6 + crack);
	float fl = 1.0 - flicker * step(0.6, fract(TIME * 13.0 + n));
	// a due facce: il velo e la maglia vanno tenui (il davanti e il dietro si sommano), il bordo
	// in controluce e le increspature fanno leggere la cupola
	float a = 0.02 + rim * 0.8 + hex * (0.06 + 0.35 * rim) * (0.7 + 0.3 * n) + ripple * (0.35 + hex) + spot * 0.6 + cr * 1.3;
	vec3 c = mix(color.rgb, rim_color.rgb, clamp(rim + ripple * 0.5 + cr, 0.0, 1.0));
	ALBEDO = c * a * energy * fade * fl;
}
shader_type spatial;
// Segno d'arrivo del teletrasporto di Mecha Knuckles (su un PlaneMesh a terra): un cerchio di
// segni che gira, una stella interna e un anello che si stringe verso il centro man mano che
// l'arrivo si avvicina ("charge" 0..1). "urgent" lo fa pulsare piÃ¹ forte (arriva alle spalle di un
// giocatore). Additivo, giallo; "fade" lo spegne. Solo cosmetico.

render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform vec4 color : source_color = vec4(1.0, 0.8, 0.14, 1.0);
uniform vec4 core : source_color = vec4(1.0, 0.97, 0.75, 1.0);
uniform float energy = 2.6;
uniform float fade = 1.0;
uniform float charge = 0.0;
uniform float urgent = 0.0;

void fragment() {
	vec2 p = UV * 2.0 - 1.0;
	float r = length(p);
	float ang = atan(p.y, p.x);
	float spin = TIME * 1.8;
	// cerchio esterno doppio
	float outer = smoothstep(0.035, 0.0, abs(r - 0.92)) + smoothstep(0.02, 0.0, abs(r - 0.82)) * 0.7;
	// segni (tacche) fra i due cerchi, che girano
	float ticks = step(0.5, fract((ang + spin) * 12.0 / 6.28318)) * step(0.83, r) * step(r, 0.91);
	ticks *= step(0.3, fract((ang + spin) * 3.0 / 6.28318 + 0.1));
	// stella a sei punte che gira al contrario
	float a6 = cos((ang - spin * 1.4) * 3.0);
	float star = smoothstep(0.03, 0.0, abs(r - (0.35 + 0.22 * a6 * a6))) * step(r, 0.62);
	// anello che si stringe sul centro (l'arrivo) e il centro che si accende
	float closing = mix(0.8, 0.05, charge);
	float inner = smoothstep(0.05, 0.0, abs(r - closing)) * (0.6 + charge);
	float hub = smoothstep(0.25, 0.0, r) * charge * charge * 1.6;
	float puls = 0.75 + 0.25 * sin(TIME * mix(10.0, 26.0, urgent));
	float a = (outer * 0.9 + ticks * 0.6 + star * 0.55 + inner + hub) * step(r, 1.0);
	vec3 c = mix(color.rgb, core.rgb, clamp(hub + inner * 0.4, 0.0, 1.0));
	ALBEDO = c * a * energy * fade * puls * (1.0 + urgent * 0.35);
}
␀␀␀␀␀shader_type spatial;
// Oro del ring portal (slz_portal_outro.gd): l'anello d'oro dei film di Sonic che si allarga in un
// grande anello verticale. Metallo caldo come gli anelli del gioco, bande di luce che girano attorno
// e scintille; "energy" lo accende quando il portale Ã¨ aperto (bordo d'oro brillante).

render_mode specular_schlick_ggx;

// colori giÃ  lineari: oro = Color(1, 0.76, 0.12) degli anelli, bagliore caldo
const vec3 gold = vec3(1.0, 0.539, 0.0137);
const vec3 glow = vec3(0.42, 0.2, 0.01);
uniform float energy = 0.0;
uniform float spin = 4.0;

varying vec3 lp;

float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }

void vertex() {
	lp = VERTEX;
}

void fragment() {
	float a = atan(lp.z, lp.x);
	float band = pow(0.5 + 0.5 * sin(a * 3.0 - TIME * spin + lp.y * 4.0), 6.0);
	float band2 = pow(0.5 + 0.5 * sin(a * 7.0 + TIME * spin * 1.7), 10.0);
	vec2 cellp = floor(vec2(a * 40.0, lp.y * 30.0 + TIME * 3.0));
	float tw = step(0.965, hash(cellp + floor(TIME * 9.0)));
	float fres = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 2.0);
	ALBEDO = gold;
	METALLIC = 1.0;
	ROUGHNESS = 0.16;
	vec3 e = glow * (0.35 + 0.9 * band + 0.4 * fres) + vec3(1.0, 0.85, 0.5) * tw * 1.2;
	// portale aperto: il bordo brilla d'oro, con lampi bianchi che corrono
	e += (vec3(1.0, 0.55, 0.08) * (0.55 + 0.8 * band) + vec3(1.0, 0.85, 0.55) * band2 * 1.0) * energy;
	EMISSION = e;
}
␀␀␀␀␀␀␀␀shader_type spatial;
// Il vortice dentro il ring portal (slz_portal_outro.gd): un disco che si apre dal centro ("open"),
// con bracci di luce dorata e bianca che girano verso il centro e, in mezzo, la finestra sull'altra
// dimensione: l'immagine della spiaggia di Emerald Coast resa da una telecamera che sta di lÃ  dal
// portale (SubViewport), presa in coordinate dello schermo cosÃ¬ si vede in prospettiva, come da una
// finestra, e appena distorta dal gorgo. Senza finestra (use_window falso) Ã¨ tutto luce.

render_mode unshaded, cull_disabled;

uniform sampler2D window : source_color, filter_linear, repeat_disable;
uniform bool use_window = false;
uniform float open = 0.0;           // raggio aperto (0..1 del disco)
uniform float swirl = 1.0;          // quanto gorgo (1 appena aperto, poi si calma)
uniform float glow = 1.0;
uniform float spin_speed = 2.2;
uniform vec3 col_a : source_color = vec3(1.0, 0.82, 0.35);
uniform vec3 col_b : source_color = vec3(0.55, 0.85, 1.0);

void fragment() {
	vec2 p = UV * 2.0 - 1.0;
	float r = length(p);
	float ro = max(open, 0.001);
	if (r > ro) {
		discard;
	}
	float a = atan(p.y, p.x);
	float q = r / ro;
	// bracci a spirale che girano e scendono verso il centro
	float lr = log(max(r, 0.02));
	float arms = sin(a * 3.0 + lr * 6.0 - TIME * spin_speed * 3.0);
	float arms2 = sin(a * 5.0 - lr * 4.0 + TIME * spin_speed * 2.1 + 1.7);
	float spiral = smoothstep(0.1, 1.0, arms) * 0.75 + smoothstep(0.55, 1.0, arms2) * 0.35;
	vec3 light = mix(col_b, col_a, 0.5 + 0.5 * sin(a * 2.0 + TIME * 1.3 + r * 6.0));
	// quanto Ã¨ ancora agitato (appena aperto: 1; calmo: 0)
	float storm = clamp((swirl - 0.35) / 0.65, 0.0, 1.0);
	vec3 col;
	if (use_window) {
		// finestra: coordinate dello schermo girate un poco attorno al centro del disco (gorgo)
		float tw = swirl * (1.0 - q) * 0.9 + swirl * 0.25;
		vec2 d = vec2(-p.y, p.x) * tw * 0.06 + p * (1.0 - q) * swirl * 0.03;
		// (l'immagine Ã¨ giÃ  passata dal suo tonemap: sotto 1, cosÃ¬ il bagliore della cittÃ  non la
		// sbianca)
		vec3 win = texture(window, clamp(SCREEN_UV + d, vec2(0.002), vec2(0.998))).rgb * 0.92;
		// alti compressi: guardando verso il sole di lÃ  la finestra non diventa un disco bianco
		// (da vicino riempie lo schermo e il bagliore della cittÃ  la sbiancava)
		win = win / (1.0 + 0.45 * max(win.r, max(win.g, win.b)));
		// in mezzo la spiaggia limpida, verso il bordo il gorgo di luce che gira
		float edge = smoothstep(0.42, 1.0, q);
		float k = edge * (0.4 + 0.6 * spiral) * (0.55 + 0.45 * storm) + storm * (1.0 - edge) * (0.35 + 0.4 * spiral);
		col = mix(win, light * 0.85, clamp(k, 0.0, 0.8));
	} else {
		// tutto luce: il tunnel che gira, azzurro profondo in fondo e oro verso il bordo
		vec3 deep = vec3(0.12, 0.32, 0.95);
		col = mix(deep, light, smoothstep(0.1, 0.9, q)) * (0.55 + 0.75 * spiral);
		col += vec3(1.0, 0.96, 0.85) * (1.0 - smoothstep(0.0, 0.45, q)) * (0.4 + 0.4 * storm);
	}
	// bordo bianco-oro dove il disco si apre
	float rim = smoothstep(0.86, 1.0, q);
	col += vec3(1.0, 0.72, 0.3) * rim * 0.9 * glow;
	ALBEDO = col * (0.8 + 0.2 * glow);
}
␀␀␀␀␀␀␀␀shader_type spatial;
// Crepa incandescente che corre sul terreno (fuga da Star Light Zone, slz_ruin.gd): nastro steso a
// terra, UV.x = 0..1 lungo la crepa (anche i rami partono dal loro punto), UV.y = 0..1 di traverso.
// "reveal" fin dove Ã¨ giÃ  aperta (la punta Ã¨ piÃ¹ chiara); "heat" quanto brucia (si raffredda).
// Additiva: sull'asfalto scuro si vede la lava sotto; il fondo nero della spaccatura lo fa il bordo.

render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform float reveal = 0.0;
uniform float heat = 1.0;
uniform vec3 hot : source_color = vec3(1.0, 0.86, 0.45);
uniform vec3 warm : source_color = vec3(1.0, 0.32, 0.04);
uniform vec3 deep : source_color = vec3(0.45, 0.04, 0.0);

void fragment() {
	float x = abs(UV.y * 2.0 - 1.0);
	// nucleo stretto e caldo, alone piÃ¹ largo e scuro
	float core = 1.0 - smoothstep(0.0, 0.45, x);
	float glow = 1.0 - smoothstep(0.2, 1.0, x);
	float open = smoothstep(reveal, reveal - 0.03, UV.x);
	float tip = smoothstep(reveal - 0.12, reveal, UV.x) * open;
	float flick = 0.82 + 0.18 * sin(TIME * 19.0 + UV.x * 57.0) * sin(TIME * 7.3 + UV.x * 13.0);
	vec3 c = deep * glow + warm * glow * glow + hot * core * core;
	c += hot * tip * 1.5;
	ALBEDO = c * open * heat * flick * 1.6;
}
␀␀␀␀␀␀␀␀␀shader_type spatial;
// Palla di fuoco (meteora di Metal Knuckles, esplosione finale di Star Light Zone): sfera o
// ellissoide additivo. Nucleo bianco-giallo dove la si guarda di fronte, bordo arancio-rosso che
// sfuma; lingue di fuoco dal rumore che scorre lungo "flow" (spazio del modello). "fade" la spegne,
// "turb" quanto Ã¨ strappata, "energy" la luminositÃ , "rim" la fa guscio (bordi accesi).

render_mode unshaded, blend_add, depth_draw_never, cull_back, shadows_disabled, fog_disabled;

uniform sampler2D noise_tex : filter_linear_mipmap, repeat_enable;
uniform vec4 core : source_color = vec4(1.0, 0.95, 0.75, 1.0);
uniform vec4 mid : source_color = vec4(1.0, 0.55, 0.12, 1.0);
uniform vec4 edge : source_color = vec4(0.9, 0.12, 0.02, 1.0);
uniform float energy = 3.0;
uniform float fade = 1.0;
uniform float turb = 0.6;
uniform vec3 flow = vec3(0.0, 1.0, 0.0);
uniform float flow_speed = 1.5;
uniform float noise_scale = 1.2;
// 0 = palla piena (luminosa dove la si guarda di fronte), 1 = guscio (luminoso sui bordi, trasparente
// in mezzo: si vede chi c'Ã¨ dentro)
uniform float rim = 0.0;
// 0 = chiusa; >0 sfuma via la metÃ  +Y del modello (la coda: lingua di fuoco aperta, non un ovale)
uniform float tail_fade = 0.0;

varying vec3 mpos;

void vertex() {
	mpos = VERTEX;
}

void fragment() {
	float facing = clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0);
	vec3 q = mpos * noise_scale - flow * TIME * flow_speed;
	float n = texture(noise_tex, q.xy * 0.35 + q.z * 0.17).r * 0.6 + texture(noise_tex, q.zy * 0.7 + vec2(0.37, 0.11)).r * 0.4;
	float body = mix(pow(facing, 0.8), pow(1.0 - facing, 1.6), rim);
	float k = clamp(body + (n - 0.5) * turb * 1.6, 0.0, 1.0);
	vec3 c = mix(edge.rgb, mid.rgb, smoothstep(0.15, 0.55, k));
	c = mix(c, core.rgb, smoothstep(0.6, 0.95, k));
	float a = smoothstep(0.02, 0.35, k);
	a *= 1.0 - tail_fade * smoothstep(-0.2, 0.9, mpos.y + (n - 0.5) * 0.6);
	ALBEDO = c * a * energy * fade;
}
␀␀␀shader_type spatial;
// Onda d'urto nell'aria (colpi dell'evento finale di Star Light Zone, lavoro slzboss): anello
// sottile additivo su un quadrato sempre girato verso la camera. La scala del nodo Ã¨ il diametro;
// "thick" lo spessore (frazione del raggio), "fade" lo spegne. Rumore che lo strappa un po'.

render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform sampler2D noise_tex : filter_linear_mipmap, repeat_enable;
uniform vec4 col : source_color = vec4(1.0, 0.8, 0.5, 1.0);
uniform vec4 edge_col : source_color = vec4(1.0, 0.35, 0.08, 1.0);
uniform float energy = 2.0;
uniform float fade = 1.0;
uniform float thick = 0.12;
uniform float seed = 0.0;

void vertex() {
	mat4 w = mat4(normalize(INV_VIEW_MATRIX[0]), normalize(INV_VIEW_MATRIX[1]), normalize(INV_VIEW_MATRIX[2]), MODEL_MATRIX[3]);
	float s = length(MODEL_MATRIX[0].xyz);
	MODELVIEW_MATRIX = VIEW_MATRIX * w * mat4(vec4(s, 0.0, 0.0, 0.0), vec4(0.0, s, 0.0, 0.0), vec4(0.0, 0.0, s, 0.0), vec4(0.0, 0.0, 0.0, 1.0));
}

void fragment() {
	vec2 p = UV * 2.0 - 1.0;
	float r = length(p);
	float ang = atan(p.y, p.x);
	float n = texture(noise_tex, vec2(ang * 0.6 + seed, r * 0.5 + seed * 0.3)).r;
	float d = abs(r - (0.92 - thick * 0.5));
	float ring = 1.0 - smoothstep(0.0, thick * (0.6 + 0.8 * n), d);
	float inner = smoothstep(0.35, 0.9, r) * (1.0 - smoothstep(0.9, 0.98, r)) * 0.08;
	vec3 c = mix(edge_col.rgb, col.rgb, ring);
	ALBEDO = c * (ring * (0.6 + 0.6 * n) + inner) * energy * fade;
}
␀␀␀␀␀␀shader_type spatial;
// Scia di fuoco della meteora di Metal Knuckles (lavoro slzboss): nastro additivo lungo l'asse Y
// del modello, sempre girato verso la camera attorno a quell'asse. La mesh Ã¨ un QuadMesh da y 0
// (testa) a y -1 (coda); la colonna Y della base del nodo Ã¨ la direzione della corsa per la
// lunghezza della scia (m). Largo "width" m alla testa, si stringe e si spegne verso la coda.

render_mode unshaded, blend_add, cull_disabled, depth_draw_never, shadows_disabled, fog_disabled;

uniform sampler2D noise_tex : filter_linear_mipmap, repeat_enable;
uniform vec4 head_col : source_color = vec4(1.0, 0.93, 0.72, 1.0);
uniform vec4 mid_col : source_color = vec4(1.0, 0.45, 0.1, 1.0);
uniform vec4 tail_col : source_color = vec4(0.55, 0.07, 0.02, 1.0);
uniform float energy = 2.5;
uniform float fade = 1.0;
uniform float width = 6.0;

varying float vlen;

void vertex() {
	vec3 axis = MODEL_MATRIX[1].xyz;
	float len = max(length(axis), 0.001);
	axis /= len;
	vec3 head = MODEL_MATRIX[3].xyz;
	float u = clamp(-VERTEX.y, 0.0, 1.0);
	vec3 p = head - axis * u * len;
	vec3 to_cam = normalize(CAMERA_POSITION_WORLD - p);
	vec3 side = cross(axis, to_cam);
	float sl = length(side);
	side = sl > 0.001 ? side / sl : vec3(1.0, 0.0, 0.0);
	float w = width * mix(1.0, 0.12, sqrt(u));
	p += side * VERTEX.x * w;
	vlen = u;
	POSITION = PROJECTION_MATRIX * (VIEW_MATRIX * vec4(p, 1.0));
}

void fragment() {
	float u = vlen;
	float x = abs(UV.x * 2.0 - 1.0);
	float n = texture(noise_tex, vec2(UV.x * 0.7 + u * 0.3, u * 7.0 - TIME * 2.5)).r;
	float core = pow(clamp(1.0 - x, 0.0, 1.0), 1.4);
	vec3 c = mix(head_col.rgb, mid_col.rgb, smoothstep(0.0, 0.18, u));
	c = mix(c, tail_col.rgb, smoothstep(0.18, 0.8, u));
	float a = core * (1.0 - smoothstep(0.45, 1.0, u)) * (0.55 + 0.9 * n);
	a *= smoothstep(0.0, 0.015, u + 0.004);
	ALBEDO = c * a * energy * fade;
}
␀␀␀shader_type spatial;
// Fulmini del TimePortal: nastri additivi rivolti alla camera, rigenerati dalla CPU.
// VERTEX = punto della polilinea, NORMAL = tangente, UV.x = lato (-1/1), UV.y = 0..1 lungo il
// ramo, UV2.x = semi-spessore del nucleo (m, spazio locale), UV2.y = luminositÃ ,
// CUSTOM0 = (nascita, durata, seme): inviluppo e sfarfallio dei colpi di ritorno.

render_mode unshaded, blend_add, cull_disabled, depth_draw_never, fog_disabled, shadows_disabled, skip_vertex_transform;

uniform float halo_k = 9.0;               // larghezza del bagliore / larghezza del nucleo
uniform vec3 core_col = vec3(2.2, 1.7, 3.0);
uniform vec3 glow_col = vec3(1.5, 0.14, 1.6);
uniform float hdr = 3.2;
#include "res://shaders/vfx/time_portal/palette.gdshaderinc"
uniform float t_time = 0.0;

varying float v_side;
varying float v_bright;
varying float v_core;

void vertex() {
	vec3 p = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	vec3 t = (MODELVIEW_MATRIX * vec4(NORMAL, 0.0)).xyz;
	float sc = length(MODELVIEW_MATRIX[0].xyz);
	vec3 s = cross(t, p);
	float sl = length(s);
	s = sl > 1e-6 ? s / sl : vec3(1.0, 0.0, 0.0);
	float core = UV2.x * sc;
	// almeno ~0.8 pixel di nucleo: oltre, si allarga e si attenua (niente sfarfallio da aliasing)
	float pix = 2.0 * max(-p.z, 0.01) / (PROJECTION_MATRIX[1][1] * VIEWPORT_SIZE.y);
	float age = t_time - CUSTOM0.x;
	float x = age / max(CUSTOM0.y, 1e-3);
	float env = clamp(age / 0.02, 0.0, 1.0) * max(1.0 - x * x, 0.0);
	float hv = fract(sin(CUSTOM0.z * 12.9898 + floor(age * 34.0) * 78.233) * 43758.5453);
	env *= hv > 0.3 ? 1.0 : 0.22;
	env *= step(0.0, age) * step(x, 1.0);
	float b = UV2.y * env;
	float cmin = pix * 1.1;
	if (core < cmin) {
		b *= core / cmin;
		core = cmin;
	}
	float hw = core * halo_k;
	VERTEX = p + s * UV.x * hw;
	v_side = UV.x;
	v_bright = b;
	v_core = 1.0 / halo_k;
}

void fragment() {
	float x = abs(v_side);
	float core = 1.0 - smoothstep(v_core * 0.3, v_core * 1.1, x);
	float glow = exp(-x * 5.0) * (1.0 - x) + exp(-x * 14.0) * 0.6;
	ALBEDO = (rc(core_col) * core * 2.2 + rc(glow_col) * glow * 1.1) * v_bright * hdr;
}
␀␀shader_type spatial;
// Scheggia scura: quasi nera, illuminata dal sole e con un filo di riflesso viola sui bordi.

render_mode cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform float rim_glow = 1.0;
#include "res://shaders/vfx/time_portal/palette.gdshaderinc"

void fragment() {
	ALBEDO = vec3(0.035, 0.022, 0.05);
	ROUGHNESS = 0.45;
	METALLIC = 0.2;
	float fres = pow(1.0 - clamp(abs(dot(NORMAL, VIEW)), 0.0, 1.0), 3.0);
	EMISSION = rc(vec3(0.9, 0.15, 1.3)) * fres * rim_glow;
}
␀␀␀shader_type particles;
// Schegge scure che fluttuano attorno allo squarcio (girano nel vortice e vengono risucchiate);
// in modalitÃ  burst vengono sparate fuori dal centro.

uniform vec2 extent = vec2(-5.0, 6.0);
uniform float open_amt = 0.0;
uniform float t_time = 0.0;
uniform bool burst_mode = false;

float h(uint n) {
	n = (n << 13u) ^ n;
	n = n * (n * n * 15731u + 789221u) + 1376312589u;
	return float(n & 0x7fffffffu) / 2147483647.0;
}

mat3 axis_rot(vec3 ax, float a) {
	float c = cos(a);
	float s = sin(a);
	float t = 1.0 - c;
	return mat3(
		vec3(t * ax.x * ax.x + c, t * ax.x * ax.y + s * ax.z, t * ax.x * ax.z - s * ax.y),
		vec3(t * ax.x * ax.y - s * ax.z, t * ax.y * ax.y + c, t * ax.y * ax.z + s * ax.x),
		vec3(t * ax.x * ax.z + s * ax.y, t * ax.y * ax.z - s * ax.x, t * ax.z * ax.z + c));
}

void start() {
	uint s = NUMBER * 13u + (burst_mode ? 3001u : 41u);
	float r1 = h(s + 1u);
	float r2 = h(s + 2u);
	float r3 = h(s + 3u);
	float r4 = h(s + 4u);
	float cy = (extent.x + extent.y) * 0.5;
	float a = r1 * 6.2831853;
	vec2 d = vec2(cos(a), sin(a));
	vec3 pos;
	vec3 vel;
	if (burst_mode) {
		pos = vec3(d * vec2(2.0, 6.0) * r2, 0.5 + r3);
		pos.y += cy;
		vel = vec3(d * mix(12.0, 48.0, r3 * r3), mix(-3.0, 16.0, r4));
	} else {
		float rad = mix(9.0, 30.0, sqrt(r2));
		pos = vec3(d.x * rad, d.y * rad * 1.35 + cy, mix(-6.0, 9.0, r3));
		vel = vec3(-d.y, d.x, 0.0) * mix(0.8, 2.6, r4) - vec3(d, 0.0) * 0.4;
		if (open_amt < 0.12) {
			ACTIVE = false;
		}
	}
	TRANSFORM = mat4(1.0);
	TRANSFORM[3].xyz = pos;
	VELOCITY = vel;
	CUSTOM = vec4(r4 * 6.28, 0.0, mix(0.25, 1.0, r1 * r1), r3);
}

void process() {
	CUSTOM.y += DELTA / LIFETIME;
	float t = CUSTOM.y;
	uint s = NUMBER * 13u + (burst_mode ? 3001u : 41u);
	vec3 ax = normalize(vec3(h(s + 7u), h(s + 8u), h(s + 9u)) - 0.5 + vec3(1e-3));
	float spin = mix(0.6, 3.0, h(s + 10u)) * (burst_mode ? 3.0 : 1.0);
	float cy = (extent.x + extent.y) * 0.5;
	vec3 p = TRANSFORM[3].xyz;
	vec2 q = p.xy - vec2(0.0, cy);
	if (burst_mode) {
		VELOCITY *= max(0.0, 1.0 - 0.9 * DELTA);
		VELOCITY.y -= 4.0 * DELTA;
	} else {
		// orbita nel vortice e lenta caduta verso lo squarcio
		float r = max(length(q), 0.5);
		vec2 tang = vec2(-q.y, q.x) / r;
		vec2 tv = tang * mix(1.0, 3.0, 8.0 / (r + 4.0)) - q / r * mix(0.3, 1.2, 6.0 / (r + 3.0));
		VELOCITY.xy = mix(VELOCITY.xy, tv * (0.6 + open_amt), min(1.0, DELTA * 0.8));
		VELOCITY.z *= max(0.0, 1.0 - DELTA * 0.5);
	}
	CUSTOM.x += spin * DELTA;
	float sz = CUSTOM.z * (burst_mode ? 1.6 : 1.0);
	float grow = smoothstep(0.0, 0.08, t) * (1.0 - smoothstep(0.82, 1.0, t));
	if (!burst_mode) {
		grow *= smoothstep(0.1, 0.3, open_amt) * smoothstep(1.2, 3.5, length(q * vec2(1.0, 0.4)));
	}
	mat3 b = axis_rot(ax, CUSTOM.x) * (sz * grow + 1e-4);
	TRANSFORM[0].xyz = b[0];
	TRANSFORM[1].xyz = b[1];
	TRANSFORM[2].xyz = b[2];
	COLOR = vec4(1.0);
}
␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Lampo accecante del burst: billboard additivo con nucleo, alone e striscia orizzontale.

render_mode unshaded, blend_add, depth_draw_never, cull_disabled, fog_disabled, shadows_disabled;

uniform float strength = 0.0;
uniform vec3 tint = vec3(1.0, 0.75, 1.3);
#include "res://shaders/vfx/time_portal/palette.gdshaderinc"

void vertex() {
	vec3 sc = vec3(length(MODEL_MATRIX[0].xyz), length(MODEL_MATRIX[1].xyz), length(MODEL_MATRIX[2].xyz));
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0] * sc.x, INV_VIEW_MATRIX[1] * sc.y, INV_VIEW_MATRIX[2] * sc.z, MODEL_MATRIX[3]);
}

void fragment() {
	vec2 c = (UV - 0.5) * 2.0;
	float r2 = dot(c, c);
	float core = exp(-r2 * 30.0) * 6.0;
	float glow = exp(-r2 * 5.0) * 1.6 + exp(-sqrt(r2) * 3.5) * 0.5;
	float streak = exp(-c.y * c.y * 900.0) * exp(-abs(c.x) * 2.2) * 2.5;
	float v = (core + glow + streak) * (1.0 - smoothstep(0.85, 1.0, sqrt(r2)));
	ALBEDO = rc(tint) * v * strength;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀// Tavolozza del TimePortal: red = 0 squarcio viola (quello dell'Atto 1), red = 1 squarcio
// cremisi (Metal Knuckles nell'Atto 2). rc() porta ogni colore viola/magenta sul rosso
// tenendone la luminositÃ : il canale piÃ¹ forte tra rosso e blu diventa il rosso, il blu quasi
// sparisce e il verde cala un po' (bianco caldo nel nucleo, cremisi sul bordo).
// yellow = 1: squarcio giallo vivo (Mecha Knuckles, Emerald Coast): il canale piÃ¹ forte tra rosso
// e blu va su rosso e verde, il blu sparisce (bianco-giallo accecante nel nucleo, giallo oro sul
// bordo, ambra cupa nel vuoto). A 0 (predefinito) i colori restano esattamente quelli di prima.
uniform float red : hint_range(0.0, 1.0) = 0.0;
uniform float yellow : hint_range(0.0, 1.0) = 0.0;

vec3 yc(vec3 c) {
	float m = max(c.r, c.b);
	// i toni scuri tirano all'ambra (niente verde oliva), quelli accesi al giallo pieno
	float g = m * mix(0.42, 0.88, smoothstep(0.12, 0.9, m)) + c.g * 0.35;
	return vec3(m, g, min(c.r, c.b) * 0.05 + c.g * 0.12);
}

vec3 rc(vec3 c) {
	vec3 r = mix(c, vec3(max(c.r, c.b), c.g * 0.6, min(c.r, c.b) * 0.08), red);
	return mix(r, yc(c), yellow);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Squarcio spazio-temporale (TimePortal): un unico quad nel piano XY locale che disegna
//  - il cielo attorno distorto a vortice e "risucchiato" verso lo squarcio (screen texture),
//  - l'onda d'urto del burst,
//  - il vuoto cremisi-viola con fumo/nebulosa in parallasse,
//  - il bordo strappato incandescente, le fibre sfilacciate, gli strappi laterali e i lembi.
// La forma arriva da una texture di profilo (bordi sinistro/destro per ogni Y) calcolata dalla
// CPU (time_portal.gd), piÃ¹ strappi e lembi passati come array. Tutto in metri "REF" (40 m).
// Costo: 3 letture del profilo, 2 della profonditÃ , 1 della screen texture (3 sul fronte
// dell'onda d'urto), 16 del rumore dentro il vuoto; nessun ciclo oltre 14 passi.

render_mode unshaded, blend_premul_alpha, cull_disabled, depth_draw_never, fog_disabled, shadows_disabled;

uniform sampler2D screen_tex : hint_screen_texture, filter_linear, repeat_disable;
uniform sampler2D depth_tex : hint_depth_texture, filter_nearest, repeat_disable;
uniform sampler2D profile : filter_linear, repeat_disable;   // r=xl g=xr b=crepa a=semi-larghezza
uniform sampler2D noise_a : filter_linear_mipmap, repeat_enable;   // fbm morbido
uniform sampler2D noise_b : filter_linear_mipmap, repeat_enable;   // fbm "ridged"

uniform float t_time = 0.0;
uniform float open_amt = 0.0;
uniform float intensity = 1.0;
uniform float span = 46.0;
uniform vec2 extent = vec2(-5.0, 6.0);     // (y fondo, y cima) della crepa
uniform float flash = 0.0;                 // lampo dei fulmini 0..1.6
uniform float burst_flash = 0.0;           // lampo del burst 0..1
uniform float shock_t = -1.0;              // secondi dal burst (<0 = niente onda)
uniform float sea_level = -1.0;            // y mondo del mare (lÃ¬ il cielo non si distorce)
uniform float fade = 1.0;                  // dissolvenza generale (chiusura)

uniform vec4 spike_a[14];                  // strappi laterali: (base.x, base.y, punta.x, punta.y)
uniform vec4 spike_b[14];                  // (raggio base, -, -, -)
uniform int spike_n = 0;
uniform vec4 flap_a[6];                    // lembi: (radice.x, radice.y, gomito.x, gomito.y)
uniform vec4 flap_b[6];                    // (punta.x, punta.y, spessore, -)
uniform int flap_n = 0;
uniform vec4 hot[4];                       // punti appena strappati: (x, y, forza, raggio)
#include "res://shaders/vfx/time_portal/palette.gdshaderinc"

const vec3 C_CORE0 = vec3(3.6, 2.6, 5.6);   // filo bianco-viola accecante
const vec3 C_RIM0 = vec3(0.8, 0.05, 0.85);  // bagliore magenta del bordo
const vec3 C_HALO0 = vec3(0.2, 0.03, 0.36); // alone viola tenue attorno
// gli stessi colori passati per la tavolozza (viola o rosso)
#define C_CORE rc(C_CORE0)
#define C_RIM rc(C_RIM0)
#define C_HALO rc(C_HALO0)

varying vec3 lpos;
varying vec3 lcam;

void vertex() {
	lpos = VERTEX;
	lcam = (inverse(MODEL_MATRIX) * vec4(CAMERA_POSITION_WORLD, 1.0)).xyz;
}

float h11(float n) {
	return fract(sin(n * 127.1 + 311.7) * 43758.5453);
}

mat2 rot2(float a) {
	float c = cos(a);
	float s = sin(a);
	return mat2(vec2(c, s), vec2(-s, c));
}

// segmento rastremato (cono 2D): negativo dentro
float sd_cone(vec2 p, vec2 a, vec2 b, float ra, float rb) {
	vec2 ba = b - a;
	vec2 pa = p - a;
	float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
	return length(pa - ba * h) - mix(ra, rb, h);
}

float world_y(mat4 inv_proj, mat4 inv_view, vec2 uv, float depth) {
	vec4 vp = inv_proj * vec4(uv * 2.0 - 1.0, depth, 1.0);
	return (inv_view * vec4(vp.xyz / vp.w, 1.0)).y;
}

float sd_seg(vec2 p, vec2 a, vec2 b) {
	vec2 ba = b - a;
	vec2 pa = p - a;
	float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
	return length(pa - ba * h);
}

// micro-dentellatura del bordo (dente di sega con ampiezza casuale)
float micro(float y, float s) {
	float x = y / 0.23 + s;
	float c = floor(x);
	float f = fract(x);
	float a = h11(c + s * 13.0);
	return (h11(c * 1.7 + s) < 0.5 ? f : 1.0 - f) * a;
}

// fibre sfilacciate: fili tesi attraverso la fessura finchÃ© Ã¨ stretta, poi spezzati a penzoloni
float fibres(vec2 p, float xl, float xr, float pw) {
	float cell = 0.5;
	float ci = floor(p.y / cell);
	float gap = xr - xl;
	float best = 0.0;
	for (int k = -1; k <= 1; k++) {
		float c = ci + float(k);
		if (h11(c * 0.73 + 4.1) < 0.62) {
			continue;
		}
		float yc = (c + 0.15 + 0.7 * h11(c + 17.3)) * cell;
		float brk = mix(0.3, 3.0, h11(c + 5.1) * h11(c + 6.6));
		float sl = (h11(c + 3.3) - 0.5) * 0.5;
		float d;
		if (gap < brk) {
			d = sd_seg(p, vec2(xl - 0.05, yc), vec2(xr + 0.05, yc + sl * gap));
		} else {
			float l1 = brk * mix(0.25, 0.6, h11(c + 8.8));
			float l2 = brk - l1;
			float droop = (h11(c + 2.2) - 0.5) * 1.1;
			d = min(sd_seg(p, vec2(xl - 0.05, yc), vec2(xl + l1, yc + droop * l1)),
					sd_seg(p, vec2(xr + 0.05, yc + sl), vec2(xr - l2 * 0.8, yc + sl - droop * l2)));
		}
		float w = max(0.025, pw * 0.6);
		best = max(best, exp(-d / w) * min(1.0, 0.025 / w * 1.5) * mix(0.45, 1.0, h11(c + 1.9)));
	}
	return best;
}

vec3 void_color(vec2 p, vec3 V, float din, float cy) {
	// quattro strati di nebulosa in parallasse (3, 7, 17, 41 m dietro il piano), ruotano a
	// vortice in versi alterni: cremisi davanti, viola in fondo
	float iz = 1.0 / max(abs(V.z), 0.15);
	vec3 acc = vec3(0.0);
	float a = 0.0;
	for (int i = 0; i < 4; i++) {
		float fi = float(i);
		float d = 3.0 * pow(2.4, fi);
		vec2 q = p + V.xy * d * iz - vec2(0.0, cy);
		float dir = (i % 2 == 0) ? 1.0 : -0.6;
		float ang = dir * t_time * (0.22 - 0.03 * fi) + 2.2 / (1.0 + length(q) * 0.15);
		q = rot2(ang) * q;
		float sc = 0.024 / (1.0 + 0.3 * fi);
		vec2 w = vec2(texture(noise_a, q * sc * 0.6 + vec2(t_time * 0.01, fi * 0.37)).r,
				texture(noise_a, q * sc * 0.6 + vec2(0.41, 0.67 - t_time * 0.008)).r) - 0.5;
		vec2 qq = q * sc + w * 1.4;
		float n = texture(noise_a, qq).r;
		float n2 = texture(noise_b, qq * 1.8 + vec2(fi * 0.21, 0.0)).r;
		float dens = smoothstep(0.33, 0.8, n);
		vec3 base = mix(rc(vec3(0.15, 0.004, 0.024)), rc(vec3(0.07, 0.008, 0.115)), clamp(fi * 0.3 + (n2 - 0.5) * 0.8, 0.0, 1.0));
		base *= (1.0 - 0.2 * fi) * (0.55 + 0.8 * n);
		float wisp = smoothstep(0.58, 0.92, n2) * dens;
		vec3 lc = base + rc(vec3(0.2, 0.012, 0.13)) * wisp * (1.0 - 0.25 * fi);
		float aa = dens * (0.78 - 0.1 * fi);
		acc += (1.0 - a) * aa * lc;
		a += (1.0 - a) * aa;
	}
	// in fondo: viola nerissimo con qualche stella lontana che pulsa
	vec2 qs = p + V.xy * 120.0 * iz;
	vec2 cs = floor(qs / 1.7);
	float st = h11(cs.x * 31.7 + cs.y * 7.3);
	vec2 sp = (fract(qs / 1.7) - 0.5) * 1.7;
	float star = step(0.92, st) * exp(-dot(sp, sp) * 40.0) * (0.6 + 0.4 * sin(t_time * 3.0 + st * 40.0));
	vec3 deep = rc(vec3(0.01, 0.001, 0.018)) + rc(vec3(0.8, 0.5, 1.2)) * star;
	vec3 col = acc + (1.0 - a) * deep;
	// piÃ¹ buio verso il centro, luce del bordo che entra nel vuoto
	col *= 0.5 + 0.5 * exp(-din / 3.0);
	col += rc(vec3(0.34, 0.012, 0.12)) * exp(-din / 0.4);
	col += rc(vec3(0.06, 0.003, 0.04)) * exp(-din / 2.0);
	// squarcio giallo (plasma di Mecha Knuckles): il vuoto non Ã¨ un buco scuro ma brucia d'oro
	col = mix(col, col * vec3(2.4, 2.1, 1.0) + vec3(0.19, 0.08, 0.0), yellow);
	return col;
}

void fragment() {
	vec2 p = lpos.xy;
	vec3 V = normalize(lpos - lcam);
	float oa = clamp(open_amt, 0.0, 1.2);
	float vis = smoothstep(0.0, 0.012, oa) * fade;
	if (vis <= 0.0 && shock_t < 0.0) {
		discard;
	}
	float cy = (extent.x + extent.y) * 0.5;
	float half_len = max((extent.y - extent.x) * 0.5, 0.5);
	float u = (p.y - cy) / half_len;
	// la crepa capillare continua un po' oltre le punte e lÃ¬ sfuma
	float pres = 1.0 - smoothstep(1.0, 1.0 + 1.6 / half_len, abs(u));
	float tipfade = 1.0 - smoothstep(0.85, 1.0 + 6.0 / half_len, abs(u));
	vec2 pd = vec2(length(dFdx(p)), length(dFdy(p)));
	float pw = max(pd.x, pd.y);   // metri per pixel

	// ---------------------------------------------------------------- forma dello squarcio
	float D = 1e3;     // distanza con segno dal bordo strappato (negativa dentro il vuoto)
	float Ds = 1e3;    // distanza dall'inviluppo liscio (per aloni e stiramento del cielo)
	float xl = 0.0;
	float xr = 0.0;
	float crack_x = 0.0;
	bool near_rip = abs(p.x) < 30.0 && abs(p.y) < span * 0.5;
	if (near_rip) {
		float v = (p.y + span * 0.5) / span;
		float tx = 1.0 / float(textureSize(profile, 0).x);
		vec4 pr = texture(profile, vec2(v, 0.5));
		crack_x = pr.b;
		float hw = pr.a;
		Ds = abs(p.x - crack_x) - hw * 1.15;
		if (abs(p.x - crack_x) < hw * 2.5 + 6.0) {
			// distanza esatta dai due bordi: polilinea dei campioni vicini (+-0.75 m)
			int n = textureSize(profile, 0).x;
			float fi = v * float(n) - 0.5;
			int i0 = int(floor(fi));
			float ft = fi - float(i0);
			float dy = span / float(n);
			float y0 = (float(i0) + 0.5) * dy - span * 0.5;
			vec2 here = mix(texelFetch(profile, ivec2(clamp(i0, 0, n - 1), 0), 0).rg,
					texelFetch(profile, ivec2(clamp(i0 + 1, 0, n - 1), 0), 0).rg, ft);
			float mk = min(hw * 2.5, 1.0) * 0.1;
			float ml = micro(p.y, 3.1) * mk;
			float mr = micro(p.y, 7.7) * mk;
			xl = here.r - ml;
			xr = here.g + mr;
			float dmin = 1e3;
			vec2 prev = vec2(0.0);
			float prev_y = 0.0;
			for (int j = -8; j <= 9; j++) {
				vec2 e = texelFetch(profile, ivec2(clamp(i0 + j, 0, n - 1), 0), 0).rg;
				float yj = y0 + float(j) * dy;
				if (j > -8) {
					dmin = min(dmin, sd_seg(p, vec2(prev.x - ml, prev_y), vec2(e.x - ml, yj)));
					dmin = min(dmin, sd_seg(p, vec2(prev.y + mr, prev_y), vec2(e.y + mr, yj)));
				}
				prev = e;
				prev_y = yj;
			}
			if (dmin > 0.7) {
				// fuori dalla finestra: stima con la pendenza (basta per aloni lontani)
				dmin = max(dmin, min(abs(p.x - xl), abs(p.x - xr)) * 0.5);
			}
			bool inside = xr - xl > 0.002 && p.x > xl && p.x < xr;
			D = inside ? -dmin : dmin;
			for (int i = 0; i < 14; i++) {
				if (i >= spike_n) {
					break;
				}
				D = min(D, sd_cone(p, spike_a[i].xy, spike_a[i].zw, spike_b[i].x, 0.0));
			}
			for (int i = 0; i < 6; i++) {
				if (i >= flap_n) {
					break;
				}
				float df = min(sd_cone(p, flap_a[i].xy, flap_a[i].zw, flap_b[i].z, flap_b[i].z * 0.55),
						sd_cone(p, flap_a[i].zw, flap_b[i].xy, flap_b[i].z * 0.55, 0.0));
				D = max(D, -df);
			}
		} else {
			D = max(Ds, 0.5);
		}
	}
	float void_m = near_rip ? (1.0 - smoothstep(-pw * 0.6, pw * 0.6 + 1e-5, D)) * step(0.002, xr - xl) : 0.0;
	float rim_pres = max(pres, void_m);

	// energia che corre lungo il bordo
	float crawl = texture(noise_a, vec2(p.y * 0.035 - t_time * 0.35, t_time * 0.05 + sign(p.x - crack_x) * 0.27)).r;
	float crawl2 = texture(noise_b, vec2(p.y * 0.11 + t_time * 0.9, 0.5 + t_time * 0.07)).r;
	float flick = 0.5 + 0.9 * crawl * crawl + 0.55 * smoothstep(0.6, 0.9, crawl2);
	float hotk = 0.0;
	for (int i = 0; i < 4; i++) {
		vec2 dh = p - hot[i].xy;
		hotk += hot[i].z * exp(-dot(dh, dh) / max(hot[i].w * hot[i].w, 0.01));
	}

	float ad = abs(D);
	float core_w = max(0.07, pw * 0.75);
	float core = exp(-ad / core_w) * min(1.0, 0.07 / core_w * 1.8);
	float glow = exp(-ad / 0.26) * min(1.0, 0.26 / max(pw, 0.26) * 1.5);
	float energy = intensity * (0.8 + 0.35 * flash + 1.2 * burst_flash + 1.4 * hotk);
	vec3 rim_col = C_CORE * core * (0.7 + 0.45 * flick)
			+ C_RIM * glow * (0.35 + 0.65 * flick) * (1.0 + flash * 0.5);
	rim_col *= rim_pres * energy;
	// alone tenue attorno all'inviluppo (solo fuori dal vuoto)
	float halo = exp(-max(Ds, 0.0) / (3.0 + 2.0 * oa)) * tipfade * (1.0 - smoothstep(20.0, 30.0, abs(p.x)));
	vec3 halo_col = C_HALO * halo * (0.25 + 0.35 * oa + 0.9 * flash + 0.6 * hotk) * intensity;

	// ---------------------------------------------------------------- cielo distorto
	vec2 q = p - vec2(0.0, cy);
	float rr = length(q * vec2(1.0, 0.8));
	float sw = pow(min(oa, 1.0), 0.75) * intensity * fade;
	float R = 24.0;
	float fall = exp(-(rr * rr) / (R * R));
	float ang = sw * (1.1 + 0.1 * sin(t_time * 0.7)) * fall;
	vec2 q2 = rot2(ang) * q;
	q2 *= 1.0 + 0.28 * sw * exp(-(rr * rr) / (13.0 * 13.0));
	// vicino al bordo il cielo viene stirato verso lo squarcio (inviluppo liscio: niente righe)
	float ep = exp(-max(Ds, 0.0) / 3.5) * tipfade;
	q2.x += sign(p.x - crack_x) * ep * 1.4 * sw;
	float shock_ring = 0.0;
	if (shock_t >= 0.0) {
		float rs = shock_t * 62.0 + 4.0;
		float rc = length(q * vec2(1.0, 0.85));
		float x = (rc - rs) / 6.5;
		float amp = 7.0 * exp(-shock_t * 1.6) * intensity;
		float prof = x * exp(-x * x);
		q2 += normalize(q + vec2(1e-4)) * prof * amp;
		shock_ring = exp(-x * x * 2.0) * exp(-shock_t * 1.9);
	}
	vec2 p2 = q2 + vec2(0.0, cy);
	vec4 c2 = PROJECTION_MATRIX * (VIEW_MATRIX * (MODEL_MATRIX * vec4(p2, 0.0, 1.0)));
	vec2 suv = c2.xy / c2.w * 0.5 + 0.5;
	vec2 base_uv = SCREEN_UV;
	// il mare Ã¨ trasparente e non sta nella screen texture: dove si vede il mare (dietro
	// questo pixel o nel punto pescato) il cielo non si distorce; idem per il primo piano.
	float dep0 = texture(depth_tex, base_uv).r;
	bool self_sea = world_y(INV_PROJECTION_MATRIX, INV_VIEW_MATRIX, base_uv, dep0) < sea_level + 0.2;
	bool ok = !self_sea && all(greaterThan(suv, vec2(0.001))) && all(lessThan(suv, vec2(0.999)));
	if (ok) {
		float dep = texture(depth_tex, suv).r;
		if (dep > FRAGCOORD.z || world_y(INV_PROJECTION_MATRIX, INV_VIEW_MATRIX, suv, dep) < sea_level + 0.2) {
			ok = false;
		}
	}
	// copro solo dove lo spostamento si vede (>~0.3 px) o dove tingo il cielo: niente doppie
	// immagini e niente pixel sovrascritti inutilmente
	float disp_px = ok ? length((suv - base_uv) * VIEWPORT_SIZE) : 0.0;
	float a_d = smoothstep(0.08, 0.45, disp_px);
	float t_amt = clamp(exp(-(rr * rr) / (18.0 * 18.0)) * sw * 0.4, 0.0, 1.0);
	float ap = atan(q.y * 0.8, q.x);
	// bracci a spirale logaritmica (scie di nuvole risucchiate)
	float lr = log(rr + 4.0);
	float spiral = ap / 6.2831853 * 3.0 - 1.3 * lr + t_time * 0.07;
	vec2 suv2 = vec2(spiral, lr * 0.6);
	float sn = texture(noise_a, suv2).r;
	float sn2 = texture(noise_b, vec2(spiral * 2.0, lr * 1.7 - t_time * 0.02)).r;
	float ring = smoothstep(6.0, 15.0, rr) * exp(-(rr * rr) / (27.0 * 27.0));
	float s_amt = clamp(smoothstep(0.55, 0.85, sn) * smoothstep(0.35, 0.85, sn2) * ring * sw * 0.32, 0.0, 1.0);
	float r_amt = clamp(shock_ring, 0.0, 1.0);
	float dist_a = max(max(a_d, t_amt), max(s_amt, r_amt * 0.6));
	dist_a *= self_sea ? 0.0 : 1.0;
	vec3 sky = vec3(0.0);
	if (dist_a > 0.001) {
		vec2 uv = ok ? suv : base_uv;
		if (shock_ring > 0.03 && ok) {
			vec2 dd = (suv - base_uv) * 0.4 * shock_ring;
			sky = vec3(texture(screen_tex, uv + dd).r, texture(screen_tex, uv).g, texture(screen_tex, uv - dd).b);
		} else {
			sky = texture(screen_tex, uv).rgb;
		}
		float ia = 1.0 / dist_a;
		// tinta viola, scie chiare del vortice, fronte luminoso dell'onda d'urto
		sky = mix(sky, sky * rc(vec3(0.8, 0.62, 1.06)) + rc(vec3(0.04, 0.0, 0.07)), min(t_amt * ia, 1.0));
		sky = mix(sky, rc(vec3(0.92, 0.92, 1.05)) * 1.15, min(s_amt * ia, 1.0));
		sky += rc(vec3(0.75, 0.6, 1.0)) * shock_ring * 0.8;
		sky *= dist_a;
	}
	// lampi: il cielo vicino si accende di viola
	vec3 add = rc(vec3(0.45, 0.12, 0.8)) * flash * exp(-(rr * rr) / (22.0 * 22.0)) * 0.3 * vis;
	add += rc(vec3(2.4, 1.6, 3.2)) * burst_flash * exp(-(rr * rr) / (40.0 * 40.0)) * 1.1;
	add += rc(vec3(0.8, 0.5, 1.2)) * shock_ring * 0.5 * (self_sea ? 1.0 : 0.0);

	// ---------------------------------------------------------------- vuoto
	vec3 col = sky + add + (rim_col + halo_col) * vis;
	float alpha = dist_a;
	if (void_m > 0.0) {
		float din = max(-D, 0.0);
		vec3 vc = void_color(p, V, din, cy);
		vc += rc(vec3(0.6, 0.1, 0.9)) * flash * 0.12 * exp(-din / 1.5);
		vc += rc(vec3(1.2, 0.2, 0.8)) * hotk * 0.3 * exp(-din / 1.2);
		vc = mix(vc, rc(vec3(4.0, 3.0, 5.5)), burst_flash * 0.8);
		float fb = fibres(p, xl, xr, pw);
		vc += (C_CORE * 0.22 + C_RIM * 0.45) * fb * (0.45 + 0.5 * flick) * intensity;
		vc += rim_col;
		float vm = void_m * vis;
		col = mix(col, vc, vm);
		alpha = mix(alpha, 1.0, vm);
	}
	ALBEDO = col;
	ALPHA = clamp(alpha, 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀shader_type spatial;
// Sbuffo di fumo: billboard morbido con rumore, colore e alfa dalla particella.

render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, fog_disabled, shadows_disabled;

uniform sampler2D noise_a : filter_linear_mipmap, repeat_enable;
uniform float t_time = 0.0;

varying vec4 v_custom;

void vertex() {
	vec3 sc = vec3(length(MODEL_MATRIX[0].xyz), length(MODEL_MATRIX[1].xyz), length(MODEL_MATRIX[2].xyz));
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0] * sc.x, INV_VIEW_MATRIX[1] * sc.y, INV_VIEW_MATRIX[2] * sc.z, MODEL_MATRIX[3]);
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
	v_custom = INSTANCE_CUSTOM;
}

void fragment() {
	float a = v_custom.x;
	vec2 c = mat2(vec2(cos(a), sin(a)), vec2(-sin(a), cos(a))) * (UV - 0.5);
	float r = length(c) * 2.0;
	float n = texture(noise_a, c * 0.55 + v_custom.zw + vec2(t_time * 0.01, 0.0)).r;
	float n2 = texture(noise_a, c * 1.3 - v_custom.wz * 1.7).r;
	float puff = 1.0 - smoothstep(0.15, 1.0, r + (n - 0.5) * 0.9);
	puff *= 0.45 + 0.75 * n2;
	ALBEDO = COLOR.rgb * (0.7 + 0.5 * n2);
	ALPHA = clamp(COLOR.a * puff, 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type particles;
// Fumo viola che esce dai bordi dello squarcio (e, in modalitÃ  burst, la vampata del burst).
// CasualitÃ  solo da NUMBER (deterministica). Spazio locale del portale (metri REF = 40 m).

uniform sampler2D profile : filter_linear, repeat_disable;
uniform float span = 46.0;
uniform vec2 extent = vec2(-5.0, 6.0);
uniform float open_amt = 0.0;
uniform float t_time = 0.0;
uniform bool burst_mode = false;
#include "res://shaders/vfx/time_portal/palette.gdshaderinc"

float h(uint n) {
	n = (n << 13u) ^ n;
	n = n * (n * n * 15731u + 789221u) + 1376312589u;
	return float(n & 0x7fffffffu) / 2147483647.0;
}

void start() {
	uint s = NUMBER * 9u + (burst_mode ? 7777u : 13u);
	float r1 = h(s + 1u);
	float r2 = h(s + 2u);
	float r3 = h(s + 3u);
	float r4 = h(s + 4u);
	float r5 = h(s + 5u);
	float r6 = h(s + 6u);
	vec3 pos;
	vec3 vel;
	if (burst_mode) {
		float a = r1 * 6.2831853;
		vec2 d = vec2(cos(a), sin(a) * 1.25);
		pos = vec3(d * r2 * 4.0, 1.0 + r3 * 2.0);
		pos.y += (extent.x + extent.y) * 0.5;
		float sp = mix(9.0, 26.0, r4 * r4);
		vel = vec3(d * sp, mix(2.0, 9.0, r5));
	} else {
		float y = mix(extent.x + 1.0, extent.y - 1.0, r1);
		vec4 pr = texture(profile, vec2((y + span * 0.5) / span, 0.5));
		float side = r2 < 0.5 ? -1.0 : 1.0;
		float x = side < 0.0 ? pr.r : pr.g;
		pos = vec3(x + side * mix(0.2, 0.9, r5), y, mix(0.0, 1.2, r3));
		vel = vec3(side * mix(0.6, 2.8, r4), mix(-0.3, 1.0, r6), mix(0.3, 1.4, r3));
		if (open_amt < 0.01) {
			ACTIVE = false;
		}
	}
	TRANSFORM = mat4(1.0);
	TRANSFORM[3].xyz = pos;
	VELOCITY = vel;
	CUSTOM = vec4(r6 * 6.2831853, 0.0, r1 * 3.7, r5 * 5.3);
	COLOR = vec4(0.0);
}

void process() {
	CUSTOM.y += DELTA / LIFETIME;
	float t = CUSTOM.y;
	uint s = NUMBER * 9u + (burst_mode ? 7777u : 13u);
	float r1 = h(s + 11u);
	float r2 = h(s + 12u);
	vec3 p = TRANSFORM[3].xyz;
	// turbolenza morbida e vortice lento attorno al centro
	float cy = (extent.x + extent.y) * 0.5;
	vec2 q = p.xy - vec2(0.0, cy);
	vec3 turb = vec3(sin(p.y * 0.21 + t_time * 0.8 + r1 * 6.0), cos(p.x * 0.19 - t_time * 0.6 + r2 * 6.0), 0.0) * 0.9;
	vec3 swirl = vec3(-q.y, q.x, 0.0) * 0.008;
	float drag = burst_mode ? 1.6 : 0.35;
	VELOCITY += (turb + swirl + vec3(0.0, 0.35, 0.0)) * DELTA;
	VELOCITY *= max(0.0, 1.0 - drag * DELTA);
	float sz = burst_mode ? mix(3.0, 9.0, sqrt(t)) * mix(0.8, 1.4, r1) : mix(1.0, 4.8, sqrt(t)) * mix(0.7, 1.3, r1);
	CUSTOM.x += DELTA * (r2 - 0.5) * 0.6;
	TRANSFORM[0].xyz = vec3(sz, 0.0, 0.0);
	TRANSFORM[1].xyz = vec3(0.0, sz, 0.0);
	TRANSFORM[2].xyz = vec3(0.0, 0.0, sz);
	vec3 hot = rc(burst_mode ? vec3(2.2, 0.7, 2.6) : vec3(0.8, 0.16, 0.85));
	vec3 cool = rc(vec3(0.11, 0.04, 0.17));
	vec3 c = mix(hot, cool, smoothstep(0.0, burst_mode ? 0.3 : 0.22, t));
	float a = smoothstep(0.0, 0.08, t) * (1.0 - smoothstep(0.45, 1.0, t));
	a *= burst_mode ? 0.7 : 0.34;
	if (!burst_mode) {
		a *= clamp(open_amt * 4.0, 0.0, 1.0);
		// mai sopra il vuoto: sfuma se il centro dello sbuffo Ã¨ vicino alla fessura
		vec4 pr = texture(profile, vec2((p.y + span * 0.5) / span, 0.5));
		float hw = max(pr.g - pr.b, pr.b - pr.r);
		a *= smoothstep(hw + sz * 0.15, hw + sz * 0.55 + 0.6, abs(p.x - pr.b));
		// spinto sempre verso l'esterno
		VELOCITY.x += sign(p.x - pr.b) * 0.5 * DELTA;
	}
	COLOR = vec4(c, a);
}
shader_type spatial;
// Scintilla: striscia additiva allineata alla velocitÃ  (asse Y della particella).

render_mode unshaded, blend_add, depth_draw_never, cull_disabled, fog_disabled, shadows_disabled, skip_vertex_transform;

uniform float width_m = 0.07;
uniform float hdr = 3.0;

void vertex() {
	vec3 c = (MODELVIEW_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
	vec3 ax = (MODELVIEW_MATRIX * vec4(0.0, 1.0, 0.0, 0.0)).xyz;
	float sc = length(MODELVIEW_MATRIX[0].xyz);
	vec3 s = cross(ax, c);
	float sl = length(s);
	s = sl > 1e-6 ? s / sl : vec3(1.0, 0.0, 0.0);
	float pix = 2.0 * max(-c.z, 0.01) / (PROJECTION_MATRIX[1][1] * VIEWPORT_SIZE.y);
	float w = max(width_m * sc, pix * 0.9);
	VERTEX = c + ax * (VERTEX.y + 0.5) * -1.0 + s * VERTEX.x * 2.0 * w;
}

void fragment() {
	float x = abs(UV.x - 0.5) * 2.0;
	float along = UV.y;
	float body = (1.0 - x * x) * smoothstep(0.0, 0.25, along) * (0.35 + 0.65 * along);
	ALBEDO = COLOR.rgb * body * COLOR.a * hdr;
}
shader_type particles;
// Scintille che schizzano dai bordi (di piÃ¹ dove lo squarcio si Ã¨ appena strappato).
// La particella Ã¨ stirata lungo la velocitÃ : asse Y = direzione * lunghezza della scia.

uniform sampler2D profile : filter_linear, repeat_disable;
uniform float span = 46.0;
uniform vec2 extent = vec2(-5.0, 6.0);
uniform float open_amt = 0.0;
uniform vec4 hot[4];
uniform bool burst_mode = false;
#include "res://shaders/vfx/time_portal/palette.gdshaderinc"

float h(uint n) {
	n = (n << 13u) ^ n;
	n = n * (n * n * 15731u + 789221u) + 1376312589u;
	return float(n & 0x7fffffffu) / 2147483647.0;
}

void start() {
	uint s = NUMBER * 11u + (burst_mode ? 5003u : 29u);
	float r1 = h(s + 1u);
	float r2 = h(s + 2u);
	float r3 = h(s + 3u);
	float r4 = h(s + 4u);
	float r5 = h(s + 5u);
	vec3 pos;
	vec3 vel;
	if (burst_mode) {
		float a = r1 * 6.2831853;
		vec2 d = vec2(cos(a), sin(a));
		pos = vec3(d * r2 * 3.0, 0.5);
		pos.y += (extent.x + extent.y) * 0.5;
		vel = vec3(d * mix(18.0, 60.0, r3 * r3), mix(-4.0, 14.0, r4));
	} else {
		// punto caldo (strappo appena avvenuto) o un punto qualsiasi della crepa
		int hi = int(r5 * 4.0) % 4;
		vec4 hs = hot[hi];
		float y;
		if (r4 < hs.z * 0.85) {
			y = hs.y + (r1 - 0.5) * 2.0 * max(hs.w, 0.5);
		} else {
			y = mix(extent.x, extent.y, r1);
		}
		vec4 pr = texture(profile, vec2((y + span * 0.5) / span, 0.5));
		float side = r2 < 0.5 ? -1.0 : 1.0;
		float x = side < 0.0 ? pr.r : pr.g;
		pos = vec3(x, y, 0.15);
		float a = (r3 - 0.5) * 2.4;
		vec2 d = vec2(side * cos(a), sin(a));
		float sp = mix(3.0, 16.0, r4 * r4) * (1.0 + hs.z * 0.8);
		vel = vec3(d * sp, mix(-1.0, 4.0, r5));
		if (open_amt < 0.005) {
			ACTIVE = false;
		}
	}
	TRANSFORM = mat4(1.0);
	TRANSFORM[3].xyz = pos;
	VELOCITY = vel;
	CUSTOM = vec4(r1, 0.0, mix(0.5, 1.0, r2), 0.0);
	COLOR = vec4(0.0);
}

void process() {
	CUSTOM.y += DELTA / LIFETIME;
	float t = CUSTOM.y;
	VELOCITY *= max(0.0, 1.0 - (burst_mode ? 1.4 : 2.2) * DELTA);
	VELOCITY.y -= 3.0 * DELTA;
	vec3 v = VELOCITY;
	float sp = length(v);
	vec3 dir = sp > 1e-3 ? v / sp : vec3(0.0, 1.0, 0.0);
	float len = clamp(sp * 0.045, 0.12, burst_mode ? 2.6 : 1.3);
	vec3 side = normalize(cross(dir, vec3(0.0, 0.0, 1.0)) + vec3(1e-4));
	TRANSFORM[0].xyz = side;
	TRANSFORM[1].xyz = dir * len;
	TRANSFORM[2].xyz = cross(side, dir);
	float a = (1.0 - t) * (1.0 - t) * CUSTOM.z;
	a *= 0.75 + 0.25 * step(0.5, fract(t * 23.0 + CUSTOM.x * 7.0));
	COLOR = vec4(rc(mix(vec3(2.4, 1.8, 3.0), vec3(2.0, 0.35, 1.6), t)), a);
}
␀␀␀// La luce del varco sul terreno (scripts/vfx/time_vortex.gd): una pozza di luce ciano sotto
// l'ovale con le onde di vento che corrono verso la base. Quad orizzontale, si somma.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform float clock = 0.0;
uniform float k = 1.0;
uniform vec3 col : source_color = vec3(0.4, 0.8, 1.0);

void fragment() {
	vec2 p = (UV - 0.5) * 2.0;
	float r = length(p * vec2(1.0, 1.35));
	float pool = exp(-r * r * 5.0) * 0.8 + exp(-r * 2.6) * 0.25;
	float waves = 0.5 + 0.5 * sin(r * 26.0 + clock * 9.0);
	waves = pow(waves, 5.0) * smoothstep(0.08, 0.3, r) * (1.0 - smoothstep(0.55, 1.0, r));
	float edge = 1.0 - smoothstep(0.85, 1.0, max(abs(p.x), abs(p.y)));
	ALBEDO = col * (pool + waves * 0.35) * k * edge;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀// Anello di luce che gira attorno al varco (scripts/vfx/time_vortex.gd): un quad con una fascia
// sottile tratteggiata a raggio 0.9 (UV), i tratti che corrono lungo l'anello col clock.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform float clock = 0.0;
uniform float speed = 1.0;
uniform float dashes = 9.0;
uniform float k = 1.0;
uniform vec3 col : source_color = vec3(0.55, 0.85, 1.0);

void fragment() {
	vec2 p = (UV - 0.5) * 2.0;
	float r = length(p);
	float a = atan(p.y, p.x) / 6.2831853;
	float band = exp(-pow((r - 0.9) / 0.018, 2.0)) + 0.35 * exp(-pow((r - 0.9) / 0.06, 2.0));
	float d = fract(a * dashes + clock * speed);
	float dash = smoothstep(0.0, 0.08, d) * (1.0 - smoothstep(0.45, 0.7, d));
	ALBEDO = mix(col, vec3(1.0), 0.2 * dash) * band * (0.25 + 0.75 * dash) * k;
}
␀␀␀␀␀␀␀␀␀␀␀␀// Scintille e scie risucchiate dal varco (scripts/vfx/time_vortex.gd): un MultiMesh di quad, ogni
// istanza calcola da sola la sua strada a spirale verso il nucleo da INSTANCE_ID e clock (nessuna
// particella GPU: uguale su ogni peer, gira col rallentatore della scena). Le prime n_air sono in aria
// attorno all'ovale; le altre sono polvere e foglie che strisciano a terra verso la base del varco
// (il vento) e poi salgono dentro. Allungate lungo la velocitÃ , rivolte alla camera.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, skip_vertex_transform, fog_disabled;

uniform float clock = 0.0;
uniform vec2 half_ext = vec2(1.0, 1.6);   // semiassi dell'ovale (m, locali)
uniform float pull = 1.0;                 // 0 spente .. 1 piene
uniform float ground_y = -2.0;            // il terreno, in y locale
uniform int n_air = 48;
uniform vec3 col_a : source_color = vec3(0.75, 0.95, 1.0);
uniform vec3 col_b : source_color = vec3(0.55, 0.45, 1.0);
uniform vec3 col_dust : source_color = vec3(0.85, 0.82, 0.62);

varying float v_a;
varying vec3 v_col;
varying vec2 v_uv;

float h1(float n) {
	return fract(sin(n * 12.9898 + 4.1414) * 43758.5453);
}

vec3 path(float s, float u, bool air) {
	if (air) {
		float a0 = h1(s + 3.0) * 6.2831853;
		float r0 = mix(1.35, 3.1, h1(s + 4.0));
		float k = pow(1.0 - u, 1.7);
		float r = r0 * k + 0.03;
		float a = a0 + (1.0 - k) * mix(2.2, 4.4, h1(s + 5.0));
		return vec3(cos(a) * r * half_ext.x, sin(a) * r * half_ext.y, (h1(s + 6.0) - 0.35) * 2.4 * k * half_ext.x);
	}
	// a terra: da lontano verso la base del varco, poi su verso il centro
	float a0 = (h1(s + 7.0) - 0.5) * 3.6 + (h1(s + 8.0) > 0.5 ? 3.14159 : 0.0);
	float r0 = mix(2.2, 6.0, h1(s + 9.0)) * half_ext.x;
	float k = pow(1.0 - u, 1.3);
	float rr = r0 * k + 0.05;
	float hop = abs(sin(u * mix(9.0, 16.0, h1(s + 10.0)))) * 0.12 * k;
	float rise = smoothstep(0.72, 1.0, u);
	vec3 g = vec3(sin(a0) * rr, ground_y + 0.04 + hop, cos(a0) * rr * 0.8 + 0.6 * k);
	return mix(g, vec3(0.0, ground_y * 0.4, 0.0), rise);
}

void vertex() {
	float f = float(INSTANCE_ID);
	bool air = INSTANCE_ID < n_air;
	float life = air ? mix(0.65, 1.45, h1(f + 1.0)) : mix(1.1, 2.2, h1(f + 1.0));
	float ph = clock / life + h1(f + 2.0);
	float u = fract(ph);
	float s = f * 3.17 + floor(ph) * 17.31;
	vec3 p0 = path(s, u, air);
	vec3 p1 = path(s, min(u + 0.03, 1.0), air);
	vec3 vp = (MODELVIEW_MATRIX * vec4(p0, 1.0)).xyz;
	vec3 vd = (MODELVIEW_MATRIX * vec4(p1 - p0, 0.0)).xyz;
	vec2 dir = length(vd.xy) > 1e-5 ? normalize(vd.xy) : vec2(1.0, 0.0);
	vec2 side = vec2(-dir.y, dir.x);
	float sp = length(p1 - p0) / 0.03;
	float len = air ? clamp(0.04 + sp * 0.035, 0.05, 0.55) : clamp(0.05 + sp * 0.02, 0.05, 0.22);
	float wid = air ? mix(0.018, 0.04, h1(f + 11.0)) : mix(0.025, 0.06, h1(f + 11.0));
	vp.xy += dir * VERTEX.x * len + side * VERTEX.y * wid;
	VERTEX = vp;
	v_uv = UV;
	float fade = smoothstep(0.0, 0.15, u) * (1.0 - smoothstep(0.9, 1.0, u));
	v_a = fade * pull * (air ? (0.6 + 1.2 * u * u) : 0.55);
	v_col = air ? mix(col_a, col_b, h1(f + 12.0) * 0.7) : mix(col_dust, col_a, smoothstep(0.6, 1.0, u));
}

void fragment() {
	vec2 q = (v_uv - 0.5) * 2.0;
	float m = (1.0 - q.x * q.x) * exp(-q.y * q.y * 3.0);
	ALBEDO = v_col * max(m, 0.0) * v_a * 1.6;
}
␀␀␀␀␀␀// Varco spazio-temporale "alla Sonic 06" (scripts/vfx/time_vortex.gd): un ovale verticale con il
// nucleo bianco-ciano, il vortice a spirale blu e viola che gira verso il centro, anelli di luce che
// scendono verso il nucleo, scie che arrivano da fuori, il bordo acceso e l'alone. Un solo quad nel
// piano XY locale (UV 0..1 = quadrato di lato 2*QUAD_HALF); radii = semiassi dell'ovale in unitÃ  del
// quad (0..1). Tutto dal parametro clock (l'orologio della scena: uguale su ogni peer), mai TIME.
// Alfa premoltiplicata: l'interno copre il cielo dietro, l'alone e le scie si sommano.
shader_type spatial;
render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform float clock = 0.0;
uniform vec2 radii = vec2(0.3, 0.45);
uniform float open_k : hint_range(0.0, 1.0) = 1.0;   // 0 = solo il punto di luce
uniform float flare = 0.0;                            // lampo (nasce, ci entra qualcuno, si chiude)
uniform float power = 1.0;
uniform int detail = 2;                               // 1 = grafica Bassa (meno rumore)
uniform vec3 col_core : source_color = vec3(0.93, 1.0, 1.0);
uniform vec3 col_cyan : source_color = vec3(0.22, 0.74, 1.0);
uniform vec3 col_blue : source_color = vec3(0.07, 0.27, 0.95);
uniform vec3 col_violet : source_color = vec3(0.42, 0.12, 0.88);

float hash(vec2 p) {
	p = fract(p * vec2(123.34, 456.21));
	p += dot(p, p + 45.32);
	return fract(p.x * p.y);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = hash(i);
	float b = hash(i + vec2(1.0, 0.0));
	float c = hash(i + vec2(0.0, 1.0));
	float d = hash(i + vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float fbm(vec2 p) {
	float v = vnoise(p) * 0.6;
	if (detail > 1) {
		v += vnoise(p * 2.13 + 7.1) * 0.28;
		v += vnoise(p * 4.37 - 3.3) * 0.12;
	} else {
		v += 0.2;
	}
	return v;
}

mat2 rot(float a) {
	float c = cos(a);
	float s = sin(a);
	return mat2(vec2(c, s), vec2(-s, c));
}

void fragment() {
	vec2 p = (UV - 0.5) * 2.0;
	p.y = -p.y;
	vec2 rr = max(radii, vec2(0.002));
	vec2 e = p / rr;
	float r = length(e);
	float ang = atan(e.y, e.x);
	float t = clock;
	vec3 col = vec3(0.0);
	float alpha = 0.0;

	// ---------------------------------------------------------------- dentro: il vortice
	if (r < 1.08) {
		// la spirale: lo spazio gira tanto piÃ¹ forte quanto piÃ¹ Ã¨ vicino al nucleo
		float tw = t * 1.7 + 2.6 / (r + 0.22);
		vec2 q = rot(tw) * e;
		float n = fbm(q * 2.3 + vec2(t * 0.15, 0.0));
		// bracci della spirale (3), nel verso della rotazione
		float arms = 0.5 + 0.5 * sin(ang * 3.0 - log(r + 0.03) * 5.5 - t * 4.2 + n * 2.4);
		arms = smoothstep(0.35, 0.95, arms);
		// anelli di luce che scendono verso il centro, spezzati dal rumore
		float rings = 0.5 + 0.5 * sin(r * 19.0 + t * 7.5 - n * 3.0);
		rings = pow(rings, 6.0) * smoothstep(0.32, 0.72, n) * smoothstep(0.12, 0.35, r);
		// il colore: nucleo bianco, ciano, blu profondo, viola verso il bordo
		vec3 deep = mix(col_blue, col_violet, smoothstep(0.55, 0.98, r) * (0.55 + 0.45 * n));
		vec3 body = mix(col_cyan, deep, smoothstep(0.18, 0.75, r));
		body *= 0.38 + 0.62 * arms + 0.25 * n;
		body += col_cyan * rings * 1.1;
		body += vec3(0.7, 0.95, 1.0) * arms * (1.0 - smoothstep(0.1, 0.5, r)) * 0.45;
		float core = exp(-r * r * 22.0);
		body = mix(body, col_core * 2.4, clamp(core * 1.3, 0.0, 1.0));
		body += col_core * exp(-r * 5.0) * 0.6;
		// il bordo: una linea bianco-ciano che vibra, poi viola
		float wob = 0.025 * sin(ang * 7.0 + t * 6.0) + 0.02 * (n - 0.5);
		float rim = exp(-pow((r - 0.97 - wob) / 0.035, 2.0));
		body += mix(col_cyan, vec3(1.0), 0.4) * rim * 1.8;
		float inside = 1.0 - smoothstep(0.97 + wob, 1.03 + wob, r);
		col += body * inside;
		alpha = max(alpha, inside * mix(0.5, 0.94, open_k));
		col += mix(col_cyan, vec3(1.0), 0.3) * rim * 1.2 * (1.0 - inside);
	}

	// ---------------------------------------------------------------- fuori: alone e scie
	float out_r = max(r - 1.0, 0.0);
	float halo = exp(-out_r * 2.8) * (r > 0.96 ? 1.0 : 0.0);
	vec3 hcol = mix(col_cyan, col_violet, smoothstep(0.0, 1.2, out_r));
	col += hcol * halo * 0.42;
	// scie radiali che arrivano da fuori verso il bordo (celle di angolo)
	float cells = 46.0;
	float ca = (ang / 6.2831853 + 0.5) * cells;
	float ci = floor(ca);
	float cf = fract(ca);
	float h1 = hash(vec2(ci, 3.1));
	float h2 = hash(vec2(ci, 9.7));
	float lane = exp(-pow((cf - 0.5) / 0.09, 2.0));
	float seg = fract(r * 0.55 + t * (0.7 + h1 * 0.8) + h2);
	float streak = smoothstep(0.0, 0.25, seg) * (1.0 - smoothstep(0.25, 0.45, seg));
	streak *= lane * step(0.55, h1) * smoothstep(0.95, 1.15, r) * (1.0 - smoothstep(1.6, 2.6, r));
	col += mix(vec3(0.7, 0.92, 1.0), col_cyan, h2) * streak * 0.75;

	// ---------------------------------------------------------------- il punto di luce (nasce / si chiude)
	float d = length(p);
	float star_k = (1.0 - smoothstep(0.0, 0.45, open_k)) + flare;
	float star = exp(-d * d * 220.0) * 3.0 + exp(-d * 14.0) * 0.8;
	float cross_h = exp(-abs(p.y) * 160.0) * exp(-abs(p.x) * 3.2);
	float cross_v = exp(-abs(p.x) * 160.0) * exp(-abs(p.y) * 3.2);
	col += (col_core * star + col_cyan * (cross_h * 1.4 + cross_v * 0.9)) * star_k;
	alpha = max(alpha, clamp(exp(-d * d * 220.0) * star_k, 0.0, 1.0));
	// lampo: tutto piÃ¹ chiaro
	col *= 1.0 + flare * 1.2;

	// ai bordi del quad tutto a zero
	float edge = 1.0 - smoothstep(0.82, 1.0, max(abs(p.x), abs(p.y)));
	col *= edge * power;
	alpha *= edge * clamp(power, 0.0, 1.0);
	ALBEDO = col;
	ALPHA = clamp(alpha, 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀␀␀␀// La distorsione attorno al varco (scripts/vfx/time_vortex.gd), a schermo: un rettangolo grande
// quanto l'ovale proiettato piÃ¹ il suo anello; dentro una fascia attorno al bordo lo sfondo gira e
// viene tirato verso il centro, con piccole onde. Dentro l'ovale niente (lÃ¬ c'Ã¨ il vortice). Legge lo
// schermo finito (anche il mare trasparente), sotto le scritte delle scene. Spento con la grafica Bassa.
shader_type canvas_item;
render_mode unshaded, blend_mix;

uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap, repeat_disable;
uniform vec2 center = vec2(0.5);      // UV dello schermo
uniform vec2 radii = vec2(0.1, 0.2);  // semiassi dell'ovale (UV dello schermo)
uniform float amount = 1.0;
uniform float clock = 0.0;

void fragment() {
	vec2 uv = SCREEN_UV;
	vec2 e = (uv - center) / max(radii, vec2(1e-4));
	float r = length(e);
	float k = amount * exp(-pow((r - 1.25) / 0.42, 2.0)) * smoothstep(0.92, 1.05, r);
	float a = k * 0.42 + k * 0.03 * sin(r * 22.0 - clock * 9.0);
	float c = cos(a);
	float s = sin(a);
	vec2 e2 = vec2(e.x * c - e.y * s, e.x * s + e.y * c) * (1.0 - 0.1 * k);
	vec2 suv = center + e2 * radii;
	vec3 col = textureLod(screen_tex, suv, 0.0).rgb;
	col += vec3(0.25, 0.55, 1.0) * k * 0.08;
	COLOR = vec4(col, step(0.002, k));
}
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Bagliore dello squarcio dietro Knuckles nella silhouette della intro: alone additivo rivolto
// sempre verso la camera, nucleo bianco-lilla, raggi viola che girano piano. Lo copre (test di
// profonditÃ ) chi gli sta davanti: drago e Knuckles restano neri e netti contro la luce.

render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform float energy = 0.0;
uniform vec3 core : source_color = vec3(1.0, 0.9, 1.0);
uniform vec3 halo : source_color = vec3(0.72, 0.28, 1.0);

void vertex() {
	// billboard che tiene la scala del nodo
	float sc = length(MODEL_MATRIX[0].xyz);
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0] * sc, INV_VIEW_MATRIX[1] * sc, INV_VIEW_MATRIX[2] * sc, MODEL_MATRIX[3]);
}

void fragment() {
	vec2 p = UV * 2.0 - 1.0;
	float r = length(p);
	float a = atan(p.y, p.x);
	float rays = 0.6 + 0.4 * sin(a * 9.0 + TIME * 0.6) * sin(a * 5.0 - TIME * 0.35 + 1.3);
	float c = exp(-r * r * 14.0);
	float h = exp(-r * r * 4.5) * rays;
	vec3 col = core * c * 1.3 + halo * h * 0.55;
	col *= 1.0 - smoothstep(0.8, 1.0, r);
	ALBEDO = col * energy;
}
␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Luce di taglio dei personaggi (come in Sonic Generations / Unleashed): passata additiva sopra
// il materiale del modello (next_pass, vedi scripts/rig/rim_light.gd). La accendono le luci
// della scena (il sole di giorno, la luce dello squarcio nella intro), quindi al buio non brilla;
// Ã¨ piÃ¹ forte in controluce, sul bordo rivolto alla luce, e resta un filo anche nell'ombra.

render_mode blend_add, depth_draw_never, cull_back, fog_disabled, skip_vertex_transform;

uniform vec3 rim_color : source_color = vec3(1.0, 0.97, 0.92);
uniform float strength = 0.16;       // LIGHT_COLOR comprende energia * PI
uniform float rim_power = 4.0;
uniform float front_side = 0.4;      // quanto resta con la luce alle spalle della camera
uniform float in_shadow = 0.45;      // quanto resta nell'ombra

void vertex() {
	// un soffio verso la camera: alla stessa profonditÃ  del modello il test di profonditÃ 
	// della passata sovrapposta fallirebbe a chiazze (come in silhouette_overlay.gdshader)
	VERTEX = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz * 0.9992;
	NORMAL = normalize((MODELVIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	// niente luce ambiente nÃ© riflessi: solo quello che aggiunge light()
	ALBEDO = vec3(0.0);
	SPECULAR = 0.0;
	ROUGHNESS = 1.0;
	METALLIC = 0.0;
}

void light() {
	// (abs: alcune mesh dei modelli hanno le normali rovesciate rispetto all'avvolgimento)
	float fres = pow(1.0 - clamp(abs(dot(NORMAL, VIEW)), 0.0, 1.0), rim_power);
	// piÃ¹ forte in controluce (luce dietro al personaggio), sul bordo rivolto alla luce
	float back = clamp(dot(LIGHT, -VIEW) * 0.5 + 0.5, 0.0, 1.0);
	float wrap = clamp(dot(NORMAL, LIGHT) + 0.6, 0.0, 1.0);
	float lit = mix(in_shadow, 1.0, ATTENUATION);
	SPECULAR_LIGHT += LIGHT_COLOR * rim_color * (fres * mix(front_side, 1.0, back) * wrap * lit * strength);
}
␀␀shader_type spatial;
// Crepe dello Smeraldo Madre colpito da Knuckles (act2_outro.gd): un guscio appena piÃ¹ grande della
// mesh dello smeraldo, additivo, con le linee di una rete di celle (bordi di Voronoi nello spazio
// della mesh) che si allargano dal punto colpito. amount 0..1 (quanto si sono allargate), flash
// (lampo del colpo, le crepe piÃ¹ accese), hit_point (coordinate della mesh).
render_mode unshaded, blend_add, depth_draw_never, shadows_disabled, fog_disabled, cull_back;

uniform float amount = 0.0;
uniform float flash = 0.0;
uniform vec3 hit_point = vec3(0.0, 0.0, 1.0);
uniform vec3 crack_col : source_color = vec3(0.8, 1.0, 0.85);
uniform float cell = 0.75;      // grandezza delle celle (unitÃ  della mesh, larga 3.1)
uniform float width = 0.05;

varying vec3 lp;

void vertex() {
	lp = VERTEX;
}

vec3 h3(vec3 p) {
	p = vec3(dot(p, vec3(127.1, 311.7, 74.7)), dot(p, vec3(269.5, 183.3, 246.1)), dot(p, vec3(113.5, 271.9, 124.6)));
	return fract(sin(p) * 43758.5453);
}

void fragment() {
	vec3 p = lp / cell;
	vec3 c = floor(p);
	vec3 f = fract(p);
	float d1 = 8.0;
	float d2 = 8.0;
	for (int x = -1; x <= 1; x++) {
		for (int y = -1; y <= 1; y++) {
			for (int z = -1; z <= 1; z++) {
				vec3 g = vec3(float(x), float(y), float(z));
				vec3 r = g + h3(c + g) - f;
				float d = dot(r, r);
				if (d < d1) {
					d2 = d1;
					d1 = d;
				} else if (d < d2) {
					d2 = d;
				}
			}
		}
	}
	float edge = sqrt(d2) - sqrt(d1);
	float line = 1.0 - smoothstep(0.0, width, edge);
	// si allargano dal punto colpito
	float reach = amount * 3.4;
	float dist = length(lp - hit_point);
	float mask = 1.0 - smoothstep(reach - 0.5, reach, dist);
	float a = line * mask * (0.55 + 1.6 * flash);
	ALBEDO = crack_col * a;
}
␀␀␀␀␀␀␀shader_type spatial;
// Boost infuocato di Knuckles: guscio a cono di fiamme attorno al personaggio (al posto dei coni
// blu del boost di Sonic). Il cono ha la punta in avanti (+Y della mesh) e si apre all'indietro;
// lungo il cono scorrono lingue di fuoco (rumore 3D senza cuciture attorno all'asse) che si
// spezzano verso la coda. Bordi in controluce piÃ¹ vivi (sembra un guscio, non un muro arancione).
// Alfa premoltiplicata, non additiva: sommato alla sabbia chiara (e poi al tonemap ACES) il fuoco
// diventava un bagliore bianco; cosÃ¬ copre un po' lo sfondo e resta arancione. Il nucleo appena
// oltre 1 per il bagliore (glow) dell'ambiente.

render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform float heat = 0.0;          // 0 spento .. 1 pieno (sfumato da fire_boost.gd)
uniform float half_len = 1.0;      // metÃ  della lunghezza del cono (m), come la CylinderMesh
uniform float hot = 0.0;           // 0 guscio esterno (arancio-rosso), 1 nucleo interno (giallo-bianco)
uniform float flow = 3.2;          // velocitÃ  con cui le fiamme scorrono verso la coda
uniform float seed = 0.0;
uniform float energy = 1.2;
uniform float opacity = 0.75;      // quanto copre lo sfondo (0 = solo additivo)
// tavolozza dal piÃ¹ freddo al piÃ¹ caldo (fire_boost.gd PALETTES: fuoco normale, cremisi di Super
// Knuckles)
uniform vec3 col0 = vec3(0.5, 0.03, 0.0);
uniform vec3 col1 = vec3(1.0, 0.2, 0.01);
uniform vec3 col2 = vec3(1.0, 0.45, 0.04);
uniform vec3 col3 = vec3(1.0, 0.75, 0.2);

varying float axial;   // 0 sulla punta davanti, 1 in coda
varying vec3 cyl;      // coordinate per il rumore: attorno all'asse (senza cucitura) e lungo

float hash(vec3 p) {
	p = fract(p * 0.3183099 + vec3(0.11, 0.17, 0.13));
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float vnoise(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(hash(i + vec3(0, 0, 0)), hash(i + vec3(1, 0, 0)), f.x),
				   mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),
			   mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x),
				   mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

float fbm(vec3 p) {
	float v = 0.0;
	float a = 0.5;
	for (int k = 0; k < 4; k++) {
		v += a * vnoise(p);
		p = p * 2.03 + vec3(1.7, 9.2, 3.1);
		a *= 0.5;
	}
	return v;
}

vec3 fire(float t) {
	vec3 c = mix(col0, col1, smoothstep(0.0, 0.35, t));
	c = mix(c, col2, smoothstep(0.35, 0.75, t));
	c = mix(c, col3, smoothstep(0.85, 1.0, t));
	return c;
}

void vertex() {
	axial = clamp((half_len - VERTEX.y) / (2.0 * half_len), 0.0, 1.0);
	float ang = atan(VERTEX.x, VERTEX.z);
	// il cono trema: piÃ¹ largo e mosso verso la coda, come una fiamma tirata dal vento
	float wob = sin(TIME * 23.0 + ang * 5.0 + axial * 9.0 + seed * 7.0) * 0.5
			+ sin(TIME * 37.0 - ang * 3.0 + axial * 13.0 + seed * 3.0) * 0.5;
	VERTEX.xz *= 1.0 + axial * (0.1 + 0.1 * wob);
	cyl = vec3(cos(ang) * 1.6, sin(ang) * 1.6, axial * 3.0);
}

void fragment() {
	float t = TIME * flow;
	vec3 q = cyl + vec3(seed * 13.0, seed * 5.0, -t);
	float n = fbm(q);
	float n2 = fbm(q * vec3(2.0, 2.0, 1.4) + vec3(4.0, 1.0, -t * 0.7));
	// lingue: piene sulla punta, sempre piÃ¹ rotte in coda
	float body = n * 0.75 + n2 * 0.45 + 0.55 - axial * 1.25;
	float lick = smoothstep(0.12, 0.6, body);
	// la punta si accende in fretta, la coda si spegne
	lick *= smoothstep(0.0, 0.07, axial) * (1.0 - smoothstep(0.8, 1.0, axial));
	// controluce: il bordo del guscio arde, il centro visto di fronte resta trasparente
	float rim = 1.0 - abs(dot(normalize(NORMAL), normalize(VIEW)));
	float shell = mix(0.06, 1.0, pow(rim, 1.8));
	float temp = clamp(lick * (0.7 + hot * 0.3) + (1.0 - axial) * 0.15 * (0.5 + hot), 0.0, 1.0);
	// vicino alla camera si dissolve (la coda non deve riempire lo schermo)
	float near = smoothstep(0.4, 1.8, length(VERTEX));
	float a = clamp(lick * shell * heat * near, 0.0, 1.0);
	ALBEDO = fire(temp) * energy * a;
	ALPHA = a * opacity;
}
␀␀␀␀␀␀shader_type spatial;
// Particelle del boost infuocato di Knuckles (fiammate, braci, vampata del rilascio): billboard
// additivi per CPUParticles3D. Il colore viene dalla rampa delle particelle (COLOR), la forma dalla
// texture: un riquadro a caso di un atlante (frames x frames, scelto con lo sfasamento casuale
// dell'animazione delle particelle) o un punto morbido. Alfa premoltiplicata (come il guscio,
// fire_boost.gdshader): sulla sabbia chiara resta fuoco arancione invece di un bagliore bianco.

render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform sampler2D tex : source_color, filter_linear_mipmap, repeat_disable;
uniform int frames = 1;          // atlante frames x frames
uniform float energy = 2.0;
uniform float fade_near = 1.6;   // si dissolve cosÃ¬ vicino alla camera (m)
uniform float opacity = 0.8;     // quanto copre lo sfondo (0 = solo additivo)
uniform vec4 tint : source_color = vec4(1.0);   // moltiplica il colore (anello cremisi di Super Knuckles)

void vertex() {
	// billboard verso la camera, con la rotazione della particella e la sua scala
	mat4 w = mat4(normalize(INV_VIEW_MATRIX[0]), normalize(INV_VIEW_MATRIX[1]), normalize(INV_VIEW_MATRIX[2]), MODEL_MATRIX[3]);
	float a = INSTANCE_CUSTOM.x;
	w = w * mat4(vec4(cos(a), -sin(a), 0.0, 0.0), vec4(sin(a), cos(a), 0.0, 0.0), vec4(0.0, 0.0, 1.0, 0.0), vec4(0.0, 0.0, 0.0, 1.0));
	MODELVIEW_MATRIX = VIEW_MATRIX * w;
	MODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
	if (frames > 1) {
		float n = float(frames * frames);
		float f = mod(floor(INSTANCE_CUSTOM.z * n), n);
		UV = (UV + vec2(mod(f, float(frames)), floor(f / float(frames)))) / float(frames);
	}
}

void fragment() {
	vec4 t = texture(tex, UV);
	float near = smoothstep(fade_near * 0.3, fade_near, length(VERTEX));
	// la texture Ã¨ giÃ  colorata (fuoco): la sua luminositÃ  modula il colore della rampa
	float lum = max(t.r, max(t.g, t.b));
	vec4 col = COLOR * tint;
	float a = t.a * col.a * near;
	ALBEDO = col.rgb * mix(vec3(lum), t.rgb * 1.6, 0.35) * a * energy;
	ALPHA = clamp(a * lum * opacity, 0.0, 1.0);
}
␀␀␀␀shader_type spatial;
// Scudi elementali di Sonic 3 & Knuckles attorno al personaggio (scripts/vfx/shield_fx.gd).
// kind: 0 = fuoco (fiamme arancio/rosse che salgono e tremolano), 1 = bolla (sfera azzurra
// trasparente col riflesso bianco), 2 = elettrico (sfera gialla con archi che guizzano).
render_mode unshaded, blend_mix, cull_back, depth_draw_never, shadows_disabled, fog_disabled;

uniform int kind = 0;
uniform float fade = 1.0;
// direzione del moto nello spazio dell'oggetto (le fiamme vanno indietro e in su)
uniform vec3 drift = vec3(0.0);
// lampo bianco (presa dello scudo, mosse)
uniform float flash = 0.0;

varying vec3 opos;
varying float tongue;

float hash3(vec3 p) {
	p = fract(p * 0.3183099 + 0.1);
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float vnoise(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(hash3(i + vec3(0, 0, 0)), hash3(i + vec3(1, 0, 0)), f.x),
			mix(hash3(i + vec3(0, 1, 0)), hash3(i + vec3(1, 1, 0)), f.x), f.y),
		mix(mix(hash3(i + vec3(0, 0, 1)), hash3(i + vec3(1, 0, 1)), f.x),
			mix(hash3(i + vec3(0, 1, 1)), hash3(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

float fbm(vec3 p) {
	return vnoise(p) * 0.55 + vnoise(p * 2.03 + 7.1) * 0.3 + vnoise(p * 4.1 + 3.7) * 0.15;
}

void vertex() {
	vec3 n = normalize(VERTEX);
	opos = n;
	tongue = 0.0;
	if (kind == 0) {
		// lingue di fiamma: la metÃ  alta si allunga verso l'alto e all'indietro rispetto al moto
		float up = clamp(n.y * 0.5 + 0.5, 0.0, 1.0);
		float f = fbm(vec3(n.x * 2.5, n.y * 2.0 - TIME * 3.2, n.z * 2.5));
		tongue = up * up * (0.25 + f * 0.75);
		VERTEX += n * tongue * 0.45;
		VERTEX += vec3(0.0, 1.0, 0.0) * tongue * 0.55;
		VERTEX -= drift * tongue * 0.6;
	} else if (kind == 1) {
		// bolla che ondeggia piano
		VERTEX += n * (sin(TIME * 5.0 + n.y * 6.0) * 0.025 + sin(TIME * 3.7 + n.x * 5.0) * 0.02);
	} else {
		VERTEX += n * (vnoise(n * 4.0 + TIME * 6.0) - 0.5) * 0.04;
	}
}

void fragment() {
	float nv = clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0);
	float rim = pow(1.0 - nv, 2.0);
	vec3 col;
	float a;
	if (kind == 0) {
		// fuoco: rumore che sale veloce, giallo dentro, arancio, rosso sulle punte
		float f = fbm(vec3(opos.x * 3.0, opos.y * 2.5 - TIME * 4.0, opos.z * 3.0));
		float g = fbm(vec3(opos.x * 6.0 + 3.0, opos.y * 5.0 - TIME * 6.5, opos.z * 6.0));
		// piÃ¹ caldo in basso (giallo), arancio in mezzo, rosso sulle punte che salgono
		float heat = clamp(f * 1.0 + g * 0.4 - tongue * 0.9 - 0.12 - opos.y * 0.32, 0.0, 1.0);
		col = mix(vec3(0.8, 0.06, 0.0), vec3(1.0, 0.42, 0.0), smoothstep(0.2, 0.55, heat));
		col = mix(col, vec3(1.0, 0.85, 0.3), smoothstep(0.7, 0.95, heat));
		// tremolio dei classici: l'alone si accende e si spegne a scatti
		float flick = 0.78 + 0.22 * step(0.5, fract(TIME * 15.0));
		// in mezzo (davanti al personaggio) solo lingue di fuoco sparse: un velo uniforme giallo o
		// arancio sopra il blu di Sonic lo farebbe sembrare viola
		float wisp = smoothstep(0.58, 0.8, g * 0.6 + f * 0.6);
		a = clamp((0.05 + rim * 1.0 + wisp * 0.4) * smoothstep(0.12, 0.42, heat + rim * 0.3) * flick, 0.0, 0.92);
		a *= 1.0 - smoothstep(0.55, 1.0, tongue) * (1.0 - f);
	} else if (kind == 1) {
		// bolla: corpo azzurro quasi trasparente, bordo piÃ¹ denso, riflesso bianco in alto a sinistra
		col = mix(vec3(0.35, 0.75, 1.0), vec3(0.1, 0.4, 1.0), rim);
		a = 0.12 + rim * 0.6;
		vec3 vn = normalize(NORMAL);
		float spec = smoothstep(0.86, 0.95, dot(vn, normalize(vec3(-0.45, 0.6, 0.65))));
		float spec2 = smoothstep(0.93, 0.97, dot(vn, normalize(vec3(0.5, -0.35, 0.8))));
		col = mix(col, vec3(1.0), clamp(spec + spec2 * 0.7, 0.0, 1.0));
		a = max(a, spec * 0.9 + spec2 * 0.5);
		// anelli d'acqua che scorrono sulla superficie
		float band = smoothstep(0.04, 0.0, abs(fract(opos.y * 2.0 - TIME * 0.6) - 0.5) - 0.42);
		a += band * 0.08 * (1.0 - rim);
	} else {
		// elettrico: guscio giallo, archi bianchi dove il rumore passa per lo zero
		float n1 = vnoise(opos * 3.5 + vec3(0.0, TIME * 7.0, TIME * 3.0)) - 0.5;
		float n2 = vnoise(opos * 5.0 - vec3(TIME * 5.0, 0.0, TIME * 6.0)) - 0.5;
		float arc = max(smoothstep(0.035, 0.0, abs(n1)), smoothstep(0.03, 0.0, abs(n2)) * 0.8);
		float jump = step(0.35, fract(TIME * 9.0 + opos.x * 0.3));
		col = mix(vec3(1.0, 0.82, 0.1), vec3(1.0, 1.0, 0.85), arc);
		a = 0.03 + rim * 0.6 + arc * 0.85 * jump;
		col = mix(col, vec3(0.6, 0.85, 1.0), rim * 0.25);
	}
	col = mix(col, vec3(1.0), flash);
	ALBEDO = col;
	ALPHA = clamp(a * fade + flash * 0.4 * fade, 0.0, 1.0);
}
␀shader_type spatial;
// Silhouette della intro (Knuckles e il drago dentro lo squarcio): sovrapposto ai modelli come
// material_overlay li rende neri, con un filo di luce sul bordo (controluce dello squarcio).
// amount 0 = invisibile, 1 = silhouette piena.

render_mode unshaded, blend_mix, depth_draw_never, cull_back, shadows_disabled, fog_disabled, skip_vertex_transform;

uniform float amount = 0.0;
uniform vec3 rim_color : source_color = vec3(0.85, 0.55, 1.0);
uniform float rim_strength = 1.4;
uniform float rim_power = 7.0;

void vertex() {
	// un soffio verso la camera: alla stessa profonditÃ  del modello il test di profonditÃ 
	// dello strato sovrapposto fallirebbe a chiazze
	VERTEX = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz * 0.9992;
	NORMAL = normalize((MODELVIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	// (abs: alcune mesh dei modelli hanno le normali rovesciate rispetto all'avvolgimento)
	float fres = pow(1.0 - clamp(abs(dot(NORMAL, VIEW)), 0.0, 1.0), rim_power);
	ALBEDO = rim_color * fres * rim_strength;
	ALPHA = amount;
}
␀␀␀␀shader_type spatial;
// Pelo di Super Knuckles (al posto del materiale del corpo, vedi scripts/vfx/super_fx.gd): stessa
// texture e stessa luce del materiale importato (ruvidezza 1, speculare 0.5), ma il rosso del pelo
// prende i colori della forma Super. Come nei giochi (Sonic 3 & Knuckles, Mania) il pelo Ã¨ rosa
// magenta e pulsa: ogni mezzo secondo o poco piÃ¹ si accende fin quasi al bianco rosato e torna
// (la tavolozza dei classici che gira, qui sfumata), con un bagliore proprio e un luccichio che gli
// scorre sopra in su. I colori li decide SuperFX (KNUX_LOOKS: rosa dei giochi o rosso fuoco).
// Il resto (muso, guanti, scarpe, occhi a parte) resta com'Ã¨: cambia solo dove la texture Ã¨ rosso
// pieno (rosso molto piÃ¹ alto di verde e blu).

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap, repeat_enable;
uniform float level = 0.0;                        // 0 Knuckles normale .. 1 Super
uniform vec3 fur_dark = vec3(0.3, 0.012, 0.1);    // pelo in ombra (lineare)
uniform vec3 fur_lit = vec3(1.0, 0.16, 0.48);     // pelo pieno (lineare)
uniform vec3 fur_hot = vec3(1.0, 0.6, 0.86);      // picco della pulsazione e luccichio (lineare)
uniform float glow = 0.4;                         // emissione di base del pelo
uniform float pulse = 0.6;                        // quanto si accende pulsando (0 = fermo)
uniform float pulse_hz = 1.8;                     // pulsazioni al secondo
uniform float flow = 1.1;                         // salita del luccichio (m/s)
uniform float flash = 0.0;                        // lampo della trasformazione

varying vec3 wpos;

float hash(vec3 p) {
	p = fract(p * 0.3183099 + vec3(0.11, 0.17, 0.13));
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float vnoise(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(hash(i + vec3(0, 0, 0)), hash(i + vec3(1, 0, 0)), f.x),
				   mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),
			   mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x),
				   mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz - MODEL_MATRIX[3].xyz;
}

void fragment() {
	vec4 t = texture(albedo_tex, UV);
	// maschera del pelo nello spazio sRGB della texture (rosso pieno: verde e blu quasi nulli)
	vec3 s = pow(max(t.rgb, vec3(0.0)), vec3(1.0 / 2.2));
	float ratio = max(s.g, s.b) / max(s.r, 1e-3);
	float fur = smoothstep(0.6, 0.3, ratio) * smoothstep(0.05, 0.2, s.r) * level;
	// chiaroscuro dipinto nella texture (rosso del pelo da ~0.48 a ~0.71)
	float shade = clamp((s.r - 0.4) / 0.35, 0.0, 1.0);
	// pulsazione: sale svelta e scende piÃ¹ piano, come un battito di luce
	float ph = fract(TIME * pulse_hz);
	float beat = pow(sin(3.14159 * pow(ph, 0.6)), 2.0) * pulse;
	vec3 lit = mix(fur_lit, fur_hot, beat * 0.55);
	vec3 sup = mix(fur_dark, lit, shade);
	// luccichio che sale: chiazze chiare che scorrono sul pelo
	vec3 q = wpos * vec3(9.0, 6.0, 9.0) + vec3(0.0, -TIME * flow * 6.0, 0.0);
	float n = vnoise(q) * 0.65 + vnoise(q * 2.3 + vec3(5.0, -TIME * 3.0, 1.0)) * 0.35;
	float spark = smoothstep(0.6, 0.88, n);
	float rim = pow(1.0 - clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0), 2.0);
	ALBEDO = mix(t.rgb, mix(sup, fur_hot, spark * 0.4), fur);
	ROUGHNESS = 1.0;
	SPECULAR = 0.5;
	EMISSION = (lit * glow * (0.45 + 0.55 * shade) * (1.0 + beat) + fur_hot * (spark * 0.7 + rim * (0.5 + beat * 0.6))) * fur
			+ fur_hot * flash * 2.0 * max(fur, 0.3 * level);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Strato dei personaggi Super, passata in piÃ¹ sui materiali del corpo (next_pass, vedi
// scripts/vfx/super_fx.gd): il corpo appena gonfiato lungo le normali, additivo con alfa
// premoltiplicata (cover > 0 copre un poco lo sfondo: il bordo rosso del fuoco sul cielo blu
// sommato e basta tirava al rosa).
// - alone (aura > 0): bordo luminoso in controluce che pulsa (outer -> inner verso il bordo), con
//   un luccichio che scorre in su lungo il corpo: l'oro di Super Sonic, il rosa di Super Knuckles;
// - fuoco (flame > 0): lingue di fuoco che salgono lungo il corpo (rumore nello spazio del mondo
//   attorno al personaggio), rosso fuori e giallo-arancio nei nuclei, piÃ¹ alte e vive sul bordo:
//   Super Knuckles ha l'alone rosa e sopra il fuoco.
// Gli occhi e la palla hanno materiali propri e non hanno questa passata.

render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_back, shadows_disabled, fog_disabled;

uniform float level = 0.0;               // 0 spento .. 1 Super (sfumato da super_fx.gd)
uniform float inflate = 0.012;           // di quanto si gonfia il guscio (m)
uniform vec3 outer = vec3(1.0, 0.62, 0.12);     // alone: colore fuori
uniform vec3 inner = vec3(1.0, 0.92, 0.55);     // alone: colore sul bordo
uniform float aura = 1.0;                // forza dell'alone
uniform float pulse = 0.25;              // quanto pulsa l'alone
uniform float pulse_hz = 1.8;
uniform vec3 fire_outer = vec3(0.9, 0.06, 0.0);
uniform vec3 fire_inner = vec3(1.0, 0.62, 0.12);
uniform float flame = 0.0;               // forza del fuoco (0 niente)
uniform float energy = 1.2;
uniform float flow = 1.4;                // salita delle fiamme (m/s)
uniform float freq = 7.0;                // grana del rumore (1/m)
uniform float flash = 0.0;               // lampo della trasformazione (si somma a tutto)
uniform float cover = 0.0;               // quanto copre lo sfondo (0 = solo additivo)

varying vec3 wpos;   // posizione nel mondo rispetto all'origine del modello

float hash(vec3 p) {
	p = fract(p * 0.3183099 + vec3(0.11, 0.17, 0.13));
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float vnoise(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(hash(i + vec3(0, 0, 0)), hash(i + vec3(1, 0, 0)), f.x),
				   mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),
			   mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x),
				   mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

float fbm(vec3 p) {
	float v = 0.0;
	float a = 0.5;
	for (int k = 0; k < 3; k++) {
		v += a * vnoise(p);
		p = p * 2.03 + vec3(1.7, 9.2, 3.1);
		a *= 0.5;
	}
	return v;
}

void vertex() {
	// le mesh dei personaggi sono in centimetri o simili: il gonfiaggio Ã¨ in metri
	float s = max(length(MODEL_MATRIX[0].xyz), 1e-6);
	VERTEX += NORMAL * (inflate * (0.4 + 0.6 * level) / s);
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz - MODEL_MATRIX[3].xyz;
}

void fragment() {
	float facing = clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0);
	float rim = 1.0 - facing;
	vec3 col = vec3(0.0);
	float a = 0.0;
	if (aura > 0.0) {
		float ph = fract(TIME * pulse_hz);
		float beat = 1.0 - pulse + pulse * (0.5 + 0.5 * cos(6.28318 * ph));
		float shimmer = 0.78 + 0.22 * sin(TIME * 9.0 + wpos.y * 18.0 - TIME * 4.0);
		float streak = smoothstep(0.62, 0.9, fbm(wpos * 9.0 + vec3(0.0, -TIME * 2.2, 0.0)));
		float ga = (pow(rim, 2.4) * 1.1 + streak * 0.2 * rim) * shimmer * beat * aura;
		col += mix(outer, inner, pow(rim, 3.0) * 0.6 + streak * 0.4) * ga;
		a += ga;
	}
	if (flame > 0.0) {
		vec3 q = wpos * freq + vec3(0.0, -TIME * flow * freq, 0.0);
		float n = fbm(q);
		float n2 = fbm(q * vec3(2.2, 1.3, 2.2) + vec3(3.1, -TIME * 2.5, 7.7));
		// piÃ¹ in alto le lingue sono piÃ¹ alte (il fuoco sale)
		float up = clamp(wpos.y * 0.6, 0.0, 0.5);
		float lick = smoothstep(0.47 - up * 0.2, 0.8, n * 0.75 + n2 * 0.45 + rim * 0.25);
		float fa = (pow(rim, 2.0) * 0.5 + lick * pow(rim, 1.1) * 0.95) * flame;
		col += mix(fire_outer, fire_inner, smoothstep(0.5, 0.95, n2 + facing * 0.35) * lick) * fa;
		a += fa;
	}
	ALBEDO = col * energy * level + inner * flash * (0.3 + rim);
	ALPHA = clamp(a * level * cover, 0.0, 1.0);
}
␀␀␀␀shader_type spatial;
// Scia di velocitÃ  delle forme Super (vedi scripts/vfx/super_fx.gd, SuperStreak): un nastro rivolto
// alla camera che segue il corpo alla massima velocitÃ , come la scia di luce di Super Sonic in
// Generations. UV.x: 0 in testa (sul corpo) .. 1 in coda; UV.y: 0..1 da un bordo all'altro.
// COLOR.a: dissolvenza della coda e della velocitÃ . Additivo con alfa premoltiplicata.

render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform vec3 core : source_color = vec3(1.0, 0.95, 0.75);   // centro del nastro
uniform vec3 edge : source_color = vec3(1.0, 0.6, 0.1);     // bordi e coda
uniform float energy = 1.6;
uniform float opacity = 0.35;    // quanto copre lo sfondo

void fragment() {
	float x = UV.x;
	float y = abs(UV.y * 2.0 - 1.0);
	// nastro morbido: pieno al centro, svanisce verso i bordi e la coda; un po' di grana che scorre
	float across = 1.0 - smoothstep(0.15, 1.0, y);
	float along = (1.0 - x) * smoothstep(0.0, 0.06, x);
	float grain = 0.75 + 0.25 * sin(x * 40.0 - TIME * 30.0 + y * 3.0);
	float a = across * along * COLOR.a * grain;
	vec3 col = mix(edge, core, (1.0 - y) * (1.0 - x * 0.7));
	ALBEDO = col * a * energy;
	ALPHA = clamp(a * opacity, 0.0, 1.0);
}
shader_type spatial;
// Schermo sott'acqua (telecamera sotto il pelo): tinta che assorbe il rosso, nebbia secondo la
// distanza vera della scena, leggera ondulazione, luce che danza (caustiche) sulle superfici
// vicino al pelo, raggi di luce dall'alto e bordo dello schermo piÃ¹ scuro.
// Quadrato a tutto schermo (POSITION nel vertex shader) disegnato prima degli altri oggetti
// trasparenti (render_priority -128): bolle, numeri e pelo dell'acqua restano nitidi sopra.

render_mode unshaded, blend_mix, depth_test_disabled, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

#include "res://shaders/env/water_common.gdshaderinc"

uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap;
uniform sampler2D depth_tex : hint_depth_texture, filter_nearest;
uniform vec3 fog_col : source_color = vec3(0.05, 0.36, 0.48);
uniform float fog_density = 0.09;
uniform float surface_y = 1.0;
uniform float strength = 1.0;   // 0..1: dissolvenza dell'effetto entrando e uscendo
// quota del fondo della zona (WaterZone.floor_map): distanza di ripiego dove la depth texture
// manca (con l'MSAA su certe schede vale 0 ovunque e tutto diventerebbe nebbia piatta)
uniform sampler2D floor_map : filter_linear, repeat_disable;
uniform vec4 floor_rect = vec4(0.0);

// Distanza lungo il raggio fino al pelo (guardando in su) o al fondo (marcia sulla mappa).
float fallback_dist(vec3 ro, vec3 rd) {
	float d = 40.0;
	if (rd.y > 0.001) {
		d = min(d, max(surface_y - ro.y, 0.0) / rd.y);
	}
	if (floor_rect.z > 0.0) {
		float t = 0.0;
		float st = 0.5;
		for (int i = 0; i < 40; i++) {
			t += st;
			if (t > d) {
				break;
			}
			vec3 p = ro + rd * t;
			float fl = texture(floor_map, (p.xz - floor_rect.xy) / floor_rect.zw).r;
			if (p.y <= fl) {
				// affina il punto d'impatto (bisezione) per non vedere gradini nella nebbia
				float a = t - st;
				float b = t;
				for (int k = 0; k < 5; k++) {
					float m = (a + b) * 0.5;
					vec3 pm = ro + rd * m;
					if (pm.y <= texture(floor_map, (pm.xz - floor_rect.xy) / floor_rect.zw).r) {
						b = m;
					} else {
						a = m;
					}
				}
				d = (a + b) * 0.5;
				break;
			}
			st *= 1.07;
		}
	}
	return d;
}

void vertex() {
	POSITION = vec4(VERTEX.xy, 1.0, 1.0);
}

void fragment() {
	float t = TIME;
	vec2 uv = SCREEN_UV;
	vec2 wob = vec2(sin(uv.y * 23.0 + t * 2.1) + sin(uv.y * 41.0 - t * 3.3) * 0.4,
		cos(uv.x * 19.0 + t * 1.7) + cos(uv.x * 37.0 + t * 2.9) * 0.4) * 0.0022 * strength;
	vec2 suv = clamp(uv + wob, vec2(0.001), vec2(0.999));
	float raw = textureLod(depth_tex, suv, 0.0).r;
	// direzione del raggio (da un punto qualsiasi: con raw = 0 il punto vero Ã¨ all'infinito)
	vec4 vr = INV_PROJECTION_MATRIX * vec4(suv * 2.0 - 1.0, 0.5, 1.0);
	vec3 rd = normalize((INV_VIEW_MATRIX * vec4(vr.xyz / vr.w, 0.0)).xyz);
	vec3 ro = CAMERA_POSITION_WORLD;
	float dist;
	if (raw > 0.00001) {
		vec4 vp = INV_PROJECTION_MATRIX * vec4(suv * 2.0 - 1.0, raw, 1.0);
		dist = length(vp.xyz / vp.w);
	} else {
		dist = fallback_dist(ro, rd);
	}
	vec3 wp = ro + rd * dist;
	vec3 base = textureLod(screen_tex, uv, 0.0).rgb;
	vec3 col = textureLod(screen_tex, suv, 0.0).rgb;

	// caustiche sulle superfici sott'acqua, piÃ¹ forti vicino al pelo e vicino alla telecamera
	if (wp.y < surface_y) {
		float below = surface_y - wp.y;
		float k = exp(-below * 0.2) * (1.0 - smoothstep(18.0, 45.0, dist));
		if (k > 0.002) {
			float ca = water_caustic(wp.xz * 0.5 + vec2(wp.y * 0.15), t * 1.2);
			col += col * vec3(0.8, 1.0, 0.95) * ca * 1.1 * k;
		}
	}
	// l'acqua assorbe il rosso (piÃ¹ si guarda lontano, piÃ¹ tutto diventa blu-verde)
	col *= mix(vec3(0.62, 0.9, 1.0), vec3(0.4, 0.78, 0.95), clamp(dist / 30.0, 0.0, 1.0));
	// nebbia: piÃ¹ chiara guardando verso il pelo, piÃ¹ scura verso il fondo
	float up = clamp(rd.y * 0.5 + 0.5, 0.0, 1.0);
	vec3 fc = fog_col * mix(0.55, 1.45, up * up);
	float f = 1.0 - exp(-dist * fog_density);
	col = mix(col, fc, f);
	// raggi di luce che scendono dall'alto (stilizzati, ondeggiano piano)
	vec2 q = rd.xz / max(rd.y + 1.25, 0.25);
	float rays = pow(0.5 + 0.5 * sin(q.x * 7.0 + sin(q.y * 3.0 + t * 0.35) * 2.0 + t * 0.4), 7.0)
		+ 0.6 * pow(0.5 + 0.5 * sin(q.x * 13.0 - q.y * 4.0 - t * 0.55), 9.0);
	rays *= smoothstep(-0.35, 0.75, rd.y) * f * 0.33;
	col += fog_col * vec3(1.6, 1.9, 1.8) * rays;
	// bordo dello schermo piÃ¹ scuro
	vec2 d = uv - 0.5;
	col *= 1.0 - dot(d, d) * 0.55;
	ALBEDO = mix(base, col, strength);
}
␀␀shader_type spatial;
// Bolle dell'acqua, sempre rivolte alla telecamera (anche come particelle: posizione e scala
// dalla MODEL_MATRIX):
//   mode 0: bolla d'aria (piccole dalla bocca e dalle bocchette, grandi da respirare);
//   mode 1: bolla col numero del countdown dell'annegamento (digit 0..5 dall'atlante "digits":
//           rosso = riempimento, verde = contorno, 6 cifre in fila);
//   mode 2: gocciolina degli schizzi.
// Sopra il pelo dell'acqua (surface_y) le bolle spariscono: scoppiano arrivando in superficie.

render_mode blend_mix, depth_draw_never, cull_disabled, unshaded, shadows_disabled, fog_disabled;

uniform int mode = 0;
uniform int digit = 0;
uniform sampler2D digits : source_color, filter_nearest;
uniform vec4 tint : source_color = vec4(0.72, 0.94, 1.0, 1.0);
uniform float surface_y = 100000.0;
uniform float wobble = 1.0;
uniform float pop = 0.0;          // 0..1: scoppio (la bolla si allarga e sfuma)

varying vec3 wcenter;
varying float rnd;

void vertex() {
	vec3 c = MODEL_MATRIX[3].xyz;
	float sx = length(MODEL_MATRIX[0].xyz);
	float sy = length(MODEL_MATRIX[1].xyz);
	rnd = fract(sin(float(INSTANCE_ID) * 12.9898 + c.x * 3.1 + c.z * 1.7) * 43758.5453);
	float t = TIME * (4.0 + rnd * 3.0) + rnd * 6.2831;
	vec2 v = VERTEX.xy;
	if (mode == 0) {
		// tremolio dell'aria e un filo di ondeggiamento mentre sale
		v *= 1.0 + wobble * 0.07 * vec2(sin(t), cos(t * 1.31));
		c.x += sin(TIME * 2.3 + rnd * 9.0) * 0.6 * sx * wobble;
		c.z += cos(TIME * 1.9 + rnd * 5.0) * 0.6 * sx * wobble;
	}
	wcenter = c;
	mat4 world = mat4(INV_VIEW_MATRIX[0] * sx, INV_VIEW_MATRIX[1] * sy, INV_VIEW_MATRIX[2], vec4(c, 1.0));
	MODELVIEW_MATRIX = VIEW_MATRIX * world;
	VERTEX = vec3(v, 0.0);
}

void fragment() {
	vec2 p = UV * 2.0 - 1.0;
	float r = length(p);
	float under = step(wcenter.y, surface_y);
	if (mode == 2) {
		// gocciolina: disco morbido bianco-azzurro con un punto di luce
		float d = 1.0 - smoothstep(0.45, 1.0, r);
		float hl = 1.0 - smoothstep(0.0, 0.4, length(p - vec2(-0.3, -0.3)));
		ALBEDO = mix(tint.rgb, vec3(1.0), 0.45 + hl * 0.55) * COLOR.rgb;
		ALPHA = d * COLOR.a * tint.a;
	} else {
		float rr = r * (1.0 + pop * 0.5);
		// bordo luminoso, interno quasi trasparente, riflesso grande in alto a sinistra e uno
		// piccolo in basso a destra (le bolle dei classici)
		float edge = 1.0 - smoothstep(0.96, 1.0, rr);
		float rim = smoothstep(0.6, 0.95, rr) * edge;
		float hl = 1.0 - smoothstep(0.08, 0.3, length((p - vec2(-0.36, -0.4)) * vec2(1.0, 1.35)));
		float hl2 = 1.0 - smoothstep(0.0, 0.13, length(p - vec2(0.42, 0.44)));
		float alpha = (0.1 + rim * 0.85) * edge + hl * 0.85 + hl2 * 0.55;
		vec3 c = mix(tint.rgb * 0.85, vec3(1.0), clamp(rim * 0.45 + hl + hl2, 0.0, 1.0));
		if (mode == 1) {
			// la cifra al centro (pixel netti, come i numeri di Sonic 1 e 3)
			vec2 du = p * 0.66 * 0.5 + 0.5;
			if (du.x >= 0.0 && du.x <= 1.0 && du.y >= 0.0 && du.y <= 1.0) {
				vec4 g = texture(digits, vec2((float(digit) + du.x) / 6.0, du.y));
				c = mix(c, vec3(0.06, 0.16, 0.55), g.g);
				alpha = max(alpha, g.g);
				c = mix(c, vec3(1.0), g.r);
				alpha = max(alpha, g.r);
			}
		}
		ALBEDO = c * COLOR.rgb;
		ALPHA = clamp(alpha, 0.0, 1.0) * under * COLOR.a * tint.a * (1.0 - pop);
	}
}
␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Cerchi sul pelo dell'acqua (increspature attorno a chi cammina o corre nell'acqua, onde
// dello schizzo): quadrato orizzontale come particella, il cerchio si allarga con la scala della
// particella e si assottiglia con l'etÃ  (INSTANCE_CUSTOM.y). Bordo un po' irregolare.

render_mode blend_mix, depth_draw_never, cull_disabled, unshaded, shadows_disabled, fog_disabled;

uniform vec4 tint : source_color = vec4(0.92, 0.98, 1.0, 0.8);
uniform float thickness = 0.14;

varying float age;
varying float rnd;

void vertex() {
	age = clamp(INSTANCE_CUSTOM.y, 0.0, 1.0);
	rnd = fract(float(INSTANCE_ID) * 0.6180339);
}

void fragment() {
	vec2 p = UV * 2.0 - 1.0;
	float r = length(p);
	float w = thickness * (1.0 - age * 0.55);
	float a = atan(p.y, p.x);
	float wob = 0.03 * sin(a * 6.0 + rnd * 20.0 + age * 5.0) + 0.02 * sin(a * 11.0 - rnd * 13.0);
	float rr = r + wob;
	float ring = smoothstep(1.0 - w * 2.2, 1.0 - w, rr) * (1.0 - smoothstep(1.0 - w * 0.35, 0.99, rr));
	// secondo cerchio interno piÃ¹ debole (l'onda che segue)
	float r2 = rr / 0.62;
	ring += 0.45 * smoothstep(1.0 - w * 2.6, 1.0 - w * 1.2, r2) * (1.0 - smoothstep(1.0 - w * 0.5, 1.0, r2));
	ALBEDO = tint.rgb * COLOR.rgb;
	ALPHA = clamp(ring, 0.0, 1.0) * tint.a * COLOR.a;
}
␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// White Knuckles (il boss di Carnival Night Zone Atto 2, scripts/bosses/wk_look.gd): il modello di Knuckles
// tutto bianco. Stessa texture del corpo (knuckles_diff.png) letta come luminanza: pelo, muso, guanti e
// scarpe diventano bianco perla e restano i dettagli dipinti (pieghe, cuciture, ombre degli aculei),
// con un velo azzurrino nelle ombre e un bordo di luce fredda in controluce. Stessa luce del materiale
// importato (ruvidezza alta, speculare medio).
//   glow   0 normale .. 1 la fase delle ombre: si illumina da dentro, la luce gli scorre addosso in su
//   flash  lampo bianco dei colpi (1 = tutto bianco acceso, torna a 0 da sÃ© nello script)
//   power  bagliore delle mani e del bordo (carica dei raggi, trasformazione)

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap, repeat_enable;
uniform vec3 white_lit = vec3(1.0, 0.99, 0.97);      // pelo in luce (lineare)
uniform vec3 white_dark = vec3(0.5, 0.55, 0.66);     // pelo in ombra dipinta (lineare)
uniform vec3 rim_col = vec3(0.65, 0.8, 1.0);         // bordo in controluce
uniform float rim = 0.35;
uniform float glow = 0.0;
uniform float flash = 0.0;
uniform float power = 0.0;
uniform float flow = 1.2;

varying vec3 wpos;

float hash(vec3 p) {
	p = fract(p * 0.3183099 + vec3(0.11, 0.17, 0.13));
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float vnoise(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(hash(i + vec3(0, 0, 0)), hash(i + vec3(1, 0, 0)), f.x),
				   mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),
			   mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x),
				   mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz - MODEL_MATRIX[3].xyz;
}

void fragment() {
	vec4 t = texture(albedo_tex, UV);
	vec3 s = pow(max(t.rgb, vec3(0.0)), vec3(1.0 / 2.2));
	// luminanza percepita, con il rosso del pelo (0.5..0.7 in sRGB) portato verso l'alto: il pelo chiaro
	// come i guanti, le ombre dipinte restano un poco piÃ¹ scure
	float l = max(dot(s, vec3(0.3, 0.55, 0.15)), max(s.r, max(s.g, s.b)) * 0.82);
	float k = smoothstep(0.08, 0.72, l);
	vec3 base = mix(white_dark, white_lit, k);
	float facing = clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0);
	float r = pow(1.0 - facing, 2.2);
	ALBEDO = base;
	ROUGHNESS = 0.82;
	SPECULAR = 0.45;
	// luce propria: il bordo freddo, la fase delle ombre (luce che sale a chiazze), il lampo
	vec3 q = wpos * vec3(8.0, 5.0, 8.0) + vec3(0.0, -TIME * flow * 5.0, 0.0);
	float n = vnoise(q) * 0.6 + vnoise(q * 2.1 + vec3(3.0, -TIME * 2.5, 1.0)) * 0.4;
	float streak = smoothstep(0.55, 0.9, n);
	vec3 em = rim_col * r * (rim + power * 1.6 + glow * 2.2);
	em += base * glow * (0.55 + 0.45 * sin(TIME * 9.0) * 0.3 + streak * 0.9);
	em += vec3(1.0) * flash * 2.5;
	EMISSION = em;
}
␀␀␀␀␀␀␀shader_type spatial;
// I portali della battaglia di White Knuckles (Carnival Night Zone Atto 2, scripts/bosses/wk_fx.gd): un
// disco verticale che si apre da una fessura (prima una riga di luce alta e stretta, poi l'ovale, poi il
// cerchio pieno), col bordo acceso del colore di chi arriva (verde Shrek, blu e oro Sora, arancio Woody,
// rosa Roy, bianco White Knuckles, oro Maximus), dentro un gorgo di bracci di luce che girano verso un
// fondo scuro dello stesso colore (l'altro universo). Non additivo (il fondo scuro si vede anche sul
// cielo di notte); i colori sopra 1 accendono il bagliore.
//   open   0 chiuso .. 1 aperto del tutto
//   flare  0..1 lampo dell'apertura (tutto piÃ¹ acceso, bordo piÃ¹ largo)

render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform vec4 col : source_color = vec4(0.4, 1.0, 0.3, 1.0);
uniform vec4 col2 : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform float open = 1.0;
uniform float flare = 0.0;
uniform float energy = 3.0;
uniform float spin = 1.4;
uniform float seed = 0.0;

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vn(vec2 x) {
	vec2 i = floor(x); vec2 f = fract(x); f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}

void fragment() {
	vec2 p = UV * 2.0 - 1.0;
	float o = clamp(open, 0.0, 1.0);
	// la forma: fessura verticale -> ovale -> cerchio
	float w = max(o, 0.002);
	float h = clamp(o * 5.0, 0.0, 1.0);
	vec2 q = vec2(p.x / w, p.y / max(h, 0.002));
	float r = length(q);
	if (r > 1.08 || o <= 0.0) {
		discard;
	}
	float a = atan(p.y, p.x);
	float lr = log(max(length(p), 0.02));
	float t = TIME * spin + seed * 13.0;
	// bracci a spirale e rumore che scorre verso il centro
	float arms = sin(a * 4.0 + lr * 7.0 - t * 4.0);
	float arms2 = sin(a * 7.0 - lr * 5.0 + t * 3.1 + 1.3);
	float n = vn(vec2(a * 3.0 + t, lr * 4.0 - t * 2.0));
	float sp = smoothstep(0.2, 1.0, arms) * 0.7 + smoothstep(0.5, 1.0, arms2) * 0.35 + n * 0.25;
	// il fondo: scuro al centro, del colore verso il bordo
	float depth = smoothstep(0.0, 0.95, r);
	vec3 deep = col.rgb * 0.08;
	vec3 inner = mix(deep, col.rgb * 0.9, depth * depth);
	inner += mix(col.rgb, col2.rgb, 0.5 + 0.5 * sin(a * 2.0 + t)) * sp * (0.25 + 0.9 * depth) * energy * 0.55;
	// il bordo acceso (piÃ¹ largo nel lampo dell'apertura), scintille che corrono lungo il bordo
	float rim_w = 0.09 + 0.12 * flare;
	float rim = smoothstep(rim_w, 0.0, abs(r - 0.97));
	float run = smoothstep(0.7, 1.0, sin(a * 9.0 - t * 6.0)) * smoothstep(0.18, 0.0, abs(r - 0.97));
	vec3 c = inner + (col.rgb * 0.7 + col2.rgb * 0.5) * (rim * 1.4 + run * 0.9) * energy;
	c *= 1.0 + flare * 1.5;
	// la fessura all'inizio Ã¨ tutta luce
	c = mix(c, col2.rgb * energy * 1.4, smoothstep(0.25, 0.0, o) * (1.0 - smoothstep(0.0, 1.0, abs(q.x))));
	ALBEDO = c;
	ALPHA = clamp(smoothstep(1.08, 0.94, r) * (0.82 + 0.18 * depth) + rim, 0.0, 1.0);
}
␀// Il blob dell'Atto 2 (scenes/characters/blob.tscn, guidato da scripts/characters/blob_puppet.gd).
// Gelatina lucida con la texture e la normal map del modello, piÃ¹ le deformazioni che il modello
// non ha (Ã¨ una mesh sola, senza scheletro), tutte nello spazio della mesh (metri della mesh alta
// 2.6, faccia verso +Z, la sua sinistra verso +X):
//  - braccia: ruotano attorno alla spalla (alza/abbassa, avanti/indietro) e si piegano lungo la
//    lunghezza come spaghetti (curl);
//  - ondeggio: la cima resta indietro rispetto ai piedi (gelatina), piedi fermi;
//  - ammaccatura del pugno: buca attorno al punto colpito piÃ¹ onde che si allargano;
//  - palpebre disegnate sopra gli occhi (0 aperti .. 1 chiusi): gli occhi sono due bulbi neri
//    della mesh (stessa isola UV per tutti e due), la palpebra scende dall'alto nello spazio della
//    mesh a riposo.
// Tutto viene da uniform che lo script calcola dall'orologio della scena (deterministico).
shader_type spatial;
render_mode cull_disabled;

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D normal_tex : hint_normal, filter_linear_mipmap, repeat_enable;
uniform float roughness = 0.3;
uniform float normal_strength = 0.8;
uniform vec3 rim_color : source_color = vec3(0.75, 0.6, 1.0);
uniform float rim = 0.25;            // bordo chiaro di gelatina
uniform float flash = 0.0;           // lampo bianco del colpo

// braccia: x = alza (rad, + verso l'alto), y = avanti (rad, + verso la faccia), z = curl (rad/m)
uniform vec3 arm_l = vec3(0.0);      // braccio sinistro del blob (+X)
uniform vec3 arm_r = vec3(0.0);      // braccio destro (-X)
uniform vec3 shoulder = vec3(0.62, 1.2, -0.07);   // perno della spalla sinistra (la destra a -x)
uniform vec2 shoulder_blend = vec2(0.5, 0.8);     // |x| dove il braccio inizia a seguire la spalla
uniform vec2 arm_band = vec2(0.25, 0.42);         // distanza in y dall'asse del braccio: oltre, Ã¨ il corpo
// ondeggio della cima (metri in cima, x e z), cresce col quadrato dell'altezza
uniform vec2 sway = vec2(0.0);
uniform float body_h = 2.6;
// ammaccatura: xyz punto colpito, w profonditÃ  (m); dent_dir verso dove spinge
uniform vec4 dent = vec4(0.0, 1.4, 0.7, 0.0);
uniform vec3 dent_dir = vec3(0.0, 0.0, -1.0);
uniform float dent_radius = 0.55;
uniform vec2 ripple = vec2(0.0);     // x fase (rad), y ampiezza (m)
// palpebre: occhi nella mesh a riposo (|x| e y del centro, semiassi x e y) e isola UV dei bulbi
uniform float lids = 0.0;
uniform vec4 eye = vec4(0.221, 2.226, 0.06, 0.15);
uniform vec4 eye_uv = vec4(0.10, 0.84, 0.215, 1.0);   // u0, v0, u1, v1
uniform vec3 lid_color : source_color = vec3(0.5, 0.36, 0.72);
uniform vec3 lash_color : source_color = vec3(0.12, 0.07, 0.18);

varying vec3 rest;

mat3 rot_z(float a) { float c = cos(a), s = sin(a); return mat3(vec3(c, s, 0.0), vec3(-s, c, 0.0), vec3(0.0, 0.0, 1.0)); }
mat3 rot_y(float a) { float c = cos(a), s = sin(a); return mat3(vec3(c, 0.0, -s), vec3(0.0, 1.0, 0.0), vec3(s, 0.0, c)); }

void vertex() {
	rest = VERTEX;
	vec3 v = VERTEX;
	vec3 n = NORMAL;
	vec3 tg = TANGENT;
	// braccia
	float sd = v.x >= 0.0 ? 1.0 : -1.0;
	float ax = abs(v.x);
	float t = smoothstep(shoulder_blend.x, shoulder_blend.y, ax)
			* (1.0 - smoothstep(arm_band.x, arm_band.y, abs(v.y - shoulder.y + 0.02 - 0.08 * max(ax - 0.7, 0.0))));
	if (t > 0.0) {
		vec3 arm = sd > 0.0 ? arm_l : arm_r;
		float d = max(ax - shoulder.x, 0.0);
		vec3 piv = vec3(sd * shoulder.x, shoulder.y, shoulder.z);
		mat3 r = rot_y(-sd * arm.y * t) * rot_z(sd * (arm.x + arm.z * d) * t);
		v = piv + r * (v - piv);
		n = r * n;
		tg = r * tg;
	}
	// ammaccatura e onde
	float dd = length(VERTEX - dent.xyz);
	float f = exp(-(dd * dd) / (dent_radius * dent_radius));
	v += dent_dir * dent.w * f;
	v += n * ripple.y * sin(dd * 9.0 - ripple.x) * exp(-dd * 1.1);
	// ondeggio (piedi fermi)
	float h = clamp(VERTEX.y / body_h, 0.0, 1.0);
	v.xz += sway * h * h;
	VERTEX = v;
	NORMAL = normalize(n);
	TANGENT = normalize(tg);
}

void fragment() {
	vec3 col = texture(albedo_tex, UV).rgb;
	if (lids > 0.001 && UV.x > eye_uv.x && UV.x < eye_uv.z && UV.y > eye_uv.y && UV.y < eye_uv.w
			&& abs(abs(rest.x) - eye.x) < eye.z * 1.6 && abs(rest.y - eye.y) < eye.w * 1.3) {
		// bordo della palpebra: scende dall'alto, un po' piÃ¹ basso al centro dell'occhio
		float qx = (abs(rest.x) - eye.x) / eye.z;
		float edge = mix(eye.w * 1.15, -eye.w * 1.15, lids) - 0.02 * (1.0 - qx * qx) * lids;
		float dy = rest.y - eye.y - edge;
		float aa = max(fwidth(rest.y), 0.002);
		float lid = smoothstep(-aa, aa, dy);
		float lash = 1.0 - smoothstep(0.0, 0.018, abs(dy));
		col = mix(col, lid_color, lid);
		col = mix(col, lash_color, lash * smoothstep(0.02, 0.15, lids));
	}
	ALBEDO = col;
	NORMAL_MAP = texture(normal_tex, UV).rgb;
	NORMAL_MAP_DEPTH = normal_strength;
	ROUGHNESS = roughness;
	METALLIC = 0.0;
	SPECULAR = 0.6;
	float fr = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 3.0);
	EMISSION = rim_color * rim * fr * col + vec3(flash);
}
␀␀␀␀␀␀// Occhi di Knuckles con l'armatura di Sir Gawain (scenes/characters/knuckles_gawain_model.tscn).
// La mesh degli occhi del modello di Gawain ha UV suoi (non quelli di Dream Team): questo shader
// ha gli stessi uniform di shaders/knuckles_eye.gdshader, cosÃ¬ knuckles_animator.gd lo guida senza
// modifiche (sguardo, battito, occhi socchiusi, occhi bianchi), e disegna l'iride di Knuckles
// (le maschere Eye_IDMask che l'animatore gli passa) dentro il contorno dell'occhio di Gawain.
// UV della mesh: u > 0 occhio sinistro del personaggio, u < 0 il destro; |u| cresce dal muso verso
// l'esterno, v cresce verso l'alto (vedi eye_box).
shader_type spatial;
render_mode cull_back;

uniform sampler2D iris_shade : source_color, filter_linear_mipmap, repeat_disable; // Eye_IDMask_r
uniform sampler2D iris_mask : filter_linear_mipmap, repeat_disable;                // Eye_IDMask_g
uniform sampler2D glint_mask : filter_linear_mipmap, repeat_disable;               // Eye_IDMask_b
uniform vec3 eye_color : source_color = vec3(0.56, 0.36, 0.98);
uniform vec3 sclera_color : source_color = vec3(1.0);
// contorno dell'occhio negli UV: |u| dal muso all'esterno, v dal basso all'alto
uniform vec4 eye_box = vec4(0.246, 1.235, 0.152, 1.336);
// centro dell'iride (frazione dell'occhio: 0 muso .. 1 esterno, 0 basso .. 1 alto) e scala
// (unitÃ  di texture per larghezza/altezza dell'occhio: piÃ¹ alto = iride piÃ¹ piccola)
uniform vec2 iris_center = vec2(0.34, 0.42);
uniform vec2 iris_k = vec2(1.3, 1.45);
uniform vec2 look_gain = vec2(1.6, 1.6);
uniform vec2 look_left = vec2(0.0);   // occhio destro del personaggio; x: + verso la propria sinistra
uniform vec2 look_right = vec2(0.0);  // occhio sinistro
uniform float pupil_dilate = 0.0;
uniform float glint_strength = 1.0;
uniform float smoothness = 0.9;
uniform float dark = 0.0;
uniform float glow = 0.0;
uniform vec3 glow_sclera : source_color = vec3(1.0, 0.92, 1.0);
uniform float blank = 0.0;
uniform float blank_glow = 0.6;
uniform float push = 0.0;                 // metri
// palpebre: chiusura 0..1, x = occhio destro del personaggio, y = sinistro (come knuckles_eye)
uniform vec2 lid_up = vec2(0.0);
uniform vec2 lid_low = vec2(0.0);
uniform vec3 lid_color = vec3(0.48, 0.013, 0.013);   // lineare
uniform vec3 lash_color = vec3(0.05, 0.002, 0.004);  // lineare
uniform float lid_rough = 0.8;
uniform float lid_spec = 0.2;
uniform float lid_meet = 0.75;            // dove si chiudono (0 = bordo alto, 1 = basso)
// sopracciglia (Gawain non le ha: le mette scripts/characters/gawain_face.gd dall'animatore):
// brow -1 arrabbiato (palpebra superiore inclinata, bassa verso il muso) .. +1 sorpreso (spalancato);
// brow_tilt alza il sopracciglio sinistro e abbassa il destro (come knuckles_animator.gd)
uniform float brow = 0.0;
uniform float brow_tilt = 0.0;

vec2 eye_local(vec2 uv) {
	return vec2((abs(uv.x) - eye_box.x) / (eye_box.y - eye_box.x), (uv.y - eye_box.z) / (eye_box.w - eye_box.z));
}

void vertex() {
	vec2 e = eye_local(UV);
	float k = 1.0 - smoothstep(0.3, 0.5, length(e - vec2(0.5)));
	VERTEX += NORMAL * push * (0.35 + 0.65 * k) / max(length(MODEL_MATRIX[0].xyz), 1e-6);
}

void fragment() {
	float side = step(0.0, UV.x);   // 1 = occhio sinistro del personaggio
	vec2 e = eye_local(UV);
	vec2 look = side > 0.5 ? look_right : look_left;
	// "verso la propria sinistra": per l'occhio sinistro Ã¨ verso l'esterno (+e.x), per il destro
	// verso il muso (-e.x)
	float lx = side > 0.5 ? look.x : -look.x;
	vec2 c = iris_center + vec2(lx, look.y) * look_gain;
	// sorpreso (sopracciglio su): iride piÃ¹ piccola, l'occhio "spalancato" che l'elmo non lascia aprire
	float bw0 = brow + brow_tilt * (side > 0.5 ? 1.0 : -1.0);
	float shrink = 1.0 + 0.45 * clamp(bw0, 0.0, 1.0);
	vec2 l = vec2((e.x - c.x) * iris_k.x * shrink, -(e.y - c.y) * iris_k.y * shrink) + 0.5;
	vec2 lp = (l - 0.5) / (1.0 + pupil_dilate) + 0.5;
	float shade = texture(iris_shade, lp).r;
	float mask = texture(iris_mask, l).r;
	float glint = texture(glint_mask, l + vec2(0.03, -0.02)).r;
	vec3 iris = eye_color * shade * 1.15;
	vec3 col = mix(sclera_color, iris, mask);
	col = mix(col, vec3(1.0), clamp(glint * glint_strength, 0.0, 1.0));
	if (blank > 0.0) {
		col = mix(col, vec3(1.0), blank);
		glint *= 1.0 - blank;
	}
	// palpebre (in coordinate dell'occhio: 1 in alto, 0 in basso)
	float meet = 1.0 - lid_meet;
	float cu = clamp(side > 0.5 ? lid_up.y : lid_up.x, 0.0, 1.0);
	float cl = clamp(side > 0.5 ? lid_low.y : lid_low.x, 0.0, 1.0);
	float bw = brow + brow_tilt * (side > 0.5 ? 1.0 : -1.0);
	float ang = clamp(-bw, 0.0, 1.0);
	cu *= 1.0 - 0.8 * clamp(bw, 0.0, 1.0);   // sorpreso: le palpebre si aprono
	cl *= 1.0 - 0.8 * clamp(bw, 0.0, 1.0);
	float eu = cu > 0.001 ? mix(1.05, meet - 0.012, cu) : 2.0;
	// arrabbiato: il bordo della palpebra superiore scende verso il muso (e.x = 0) e resta alto fuori
	// (il bordo dell'elmo copre giÃ  la parte alta interna dell'occhio: la palpebra deve scendere
	// sotto di lui per vedersi)
	float eu_ang = mix(1.06, mix(0.3, 0.8, e.x), ang);
	if (ang > 0.001) {
		eu = min(eu, eu_ang);
		cu = max(cu, ang * 0.6);
	}
	float el = cl > 0.001 ? mix(-0.05, meet + 0.012, cl) : -1.0;
	float aa = max(fwidth(e.y) * 0.75, 0.002);
	float lu = smoothstep(eu - aa, eu + aa, e.y);
	float ll = 1.0 - smoothstep(el - aa, el + aa, e.y);
	float lid = max(lu, ll);
	float shade_u = (1.0 - smoothstep(0.0, 0.08, eu - e.y)) * step(e.y, eu) * clamp(cu * 6.0, 0.0, 1.0);
	col *= 1.0 - 0.28 * shade_u;
	float edge = lu > ll ? e.y - eu : el - e.y;
	vec3 lidc = lid_color * mix(0.82, 1.0, smoothstep(0.0, 0.15, edge));
	float lash = (1.0 - smoothstep(0.004, 0.03, edge)) * smoothstep(0.12, 0.4, lu > ll ? cu : cl);
	lidc = mix(lidc, lash_color, lash);
	ALBEDO = mix(col, lidc, lid) * (1.0 - dark);
	ROUGHNESS = mix(1.0 - smoothness, lid_rough, lid);
	SPECULAR = mix(0.6, lid_spec, lid) * (1.0 - dark);
	vec3 em = vec3(glint * glint_strength * 0.6) * (1.0 - dark);
	em += glow * mix(glow_sclera * 1.7, eye_color * 3.2, mask);
	em += vec3(1.0, 0.98, 0.95) * blank * blank_glow;
	EMISSION = em * (1.0 - lid);
}
␀␀// Occhi furiosi che si accendono dietro la visiera abbassata di Knuckles con l'armatura di Sir
// Gawain (material_overlay della mesh gawain_visor, messo da scripts/characters/gawain_face.gd solo
// quando serve). La visiera Ã¨ chiusa dietro le sbarre (nessun buco): il bagliore si disegna negli
// incavi scuri fra le sbarre, a forma di due occhi a fessura inclinati (arrabbiati), piÃ¹ un filo
// sulle sbarre vicine. UV2 della mesh = posizione di riposo (x, z in metri; x > 0 sinistra del
// personaggio, z in su), scritta da tools/dev/gawain/gbuild.gd.
shader_type spatial;
render_mode blend_add, unshaded, cull_back, depth_draw_never, shadows_disabled, fog_disabled;

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap;
uniform float fury = 0.0;
uniform vec3 color : source_color = vec3(1.0, 0.36, 0.12);
// centro dell'occhio (|x|, z), semiassi (x, z) in metri
uniform vec4 eye = vec4(0.082, 0.9, 0.058, 0.019);
uniform float slant = 0.6;     // pendenza: l'angolo verso il naso piÃ¹ basso (arrabbiato)
uniform float flicker = 0.0;    // tremolio (lo anima lo script)

void fragment() {
	vec3 a = texture(albedo_tex, UV).rgb;
	float lum = dot(a, vec3(0.3, 0.59, 0.11));
	float dark = 1.0 - smoothstep(0.035, 0.11, lum);
	float ax = abs(UV2.x);
	float dz = UV2.y - (eye.y + slant * (ax - eye.x));
	float e = length(vec2((ax - eye.x) / eye.z, dz / eye.w));
	float m = 1.0 - smoothstep(0.55, 1.0, e);
	float core = 1.0 - smoothstep(0.0, 0.6, e);
	vec3 c = color * mix(0.3, 1.0, dark) * (m * 1.3 + core * 1.2) + vec3(1.0, 0.8, 0.5) * core * dark * 0.7;
	ALBEDO = c * fury * (1.0 - 0.15 * flicker);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀// Ricostruzione dello shader occhi "HL_Char_Eye" di Sonic Dream Team.
// L'iride si muove spostando gli UV (come nel gioco originale): look_left / look_right
// sono controllati dall'animatore per far guardare Knuckles dove vogliamo.
shader_type spatial;
render_mode cull_back;

uniform sampler2D iris_shade : source_color, filter_linear_mipmap, repeat_disable; // Eye_IDMask_r
uniform sampler2D iris_mask : filter_linear_mipmap, repeat_disable;                // Eye_IDMask_g
uniform sampler2D glint_mask : filter_linear_mipmap, repeat_disable;               // Eye_IDMask_b
uniform vec3 eye_color : source_color = vec3(0.56, 0.36, 0.98);
uniform vec3 sclera_color : source_color = vec3(1.0);
uniform vec2 uv_scale = vec2(2.3, 1.25);
uniform float inward = 0.4; // sposta le iridi verso il muso (come nel modello e nelle illustrazioni)
uniform float iris_scale = 1.0;
uniform vec2 look_left = vec2(0.0);   // x: + guarda verso la propria sinistra, y: + in alto
uniform vec2 look_right = vec2(0.0);
uniform float pupil_dilate = 0.0;     // -0.3 .. 0.3
uniform float glint_strength = 1.0;
uniform float smoothness = 0.9;
// (intro) silhouette nello squarcio: dark annerisce l'occhio, glow lo accende (bianco-lilla,
// iride viola), senza toccare la posizione dell'iride
uniform float dark = 0.0;
uniform float glow = 0.0;
uniform vec3 glow_sclera : source_color = vec3(1.0, 0.92, 1.0);
// (intro) riflesso verde dello Smeraldo Madre: un secondo punto di luce, tenue, accanto a quello
// bianco, e un velo verde sull'iride
uniform float emerald_glint = 0.0;
uniform vec3 emerald_color : source_color = vec3(0.35, 1.0, 0.5);
uniform vec2 emerald_offset = vec2(-0.07, 0.05);
// (scena di Mecha Knuckles) occhi totalmente bianchi: iride e riflesso spariscono nel bianco, che
// si accende un poco (blank_glow) per restare bianco anche in controluce. 0 = occhi normali.
uniform float blank = 0.0;
uniform float blank_glow = 0.6;
// l'occhio sta un filo sopra la pelle: il bordo posteriore della palpebra superiore (ruotata
// indietro per aprirla) passa appena sotto la superficie e altrimenti spunta come una riga rossa
// sul bianco, sotto l'iride. Si alza solo l'interno dell'occhio (una leggera bombatura): il bordo
// della mesh resta sotto la pelle, altrimenti agli angoli si vedrebbe il suo profilo seghettato.
uniform float push = 0.0;                 // metri
uniform vec2 push_r = vec2(0.5, 0.85);    // raggio (spazio iride) dove la spinta si annulla
// Palpebre disegnate sull'occhio. Le palpebre del modello (chiuse nella posa di riposo) ruotano
// attorno a un perno in basso: a metÃ  corsa passano dentro il bulbo e lasciano righe rosse sul
// bianco. Le ossa le tengono sempre aperte (fuori vista) e la chiusura si disegna qui, seguendo
// il contorno visibile dell'occhio: niente geometria che attraversa il bianco.
// Chiusura 0..1 per occhio: x = lato UV sinistro (occhio destro del personaggio), y = l'altro.
uniform vec2 lid_up = vec2(0.0);
uniform vec2 lid_low = vec2(0.0);
uniform vec3 lid_color = vec3(0.48, 0.013, 0.013);   // lineare
uniform vec3 lash_color = vec3(0.05, 0.002, 0.004);  // lineare
uniform float lid_rough = 0.8;
uniform float lid_spec = 0.2;
uniform float lid_meet = 0.8;             // dove si chiudono le palpebre (0 = bordo alto, 1 = basso)
// (Patrizio, White Knuckles: scripts/bosses/wk_look.gd) occhi a celle: tutto l'occhio rosso, senza
// bianco nÃ© iride, diviso in celle poligonali irregolari (come vetro incrinato) da righe nere sottili,
// piÃ¹ scuro in basso e agli angoli, un riflesso bianco morbido in alto e un bordo nero spesso sul
// contorno visibile. 0 = occhi normali (predefinito: lo shader resta quello di sempre).
uniform float cells = 0.0;
uniform vec3 cell_color = vec3(0.32, 0.016, 0.012);    // rosso delle celle (lineare: in luce ~#c8302a)
uniform vec3 cell_dark = vec3(0.15, 0.006, 0.005);       // in basso e agli angoli (in luce ~#8a1a16)
uniform vec3 cell_line_color = vec3(0.004, 0.001, 0.001); // righe e bordo (lineare)
uniform float cell_scale = 4.6;           // celle per unitÃ  dello spazio dell'occhio (~12 per occhio)
uniform float cell_line = 0.045;          // mezza larghezza delle righe (frazione di cella)
uniform float cell_warp = 0.45;           // celle piÃ¹ grandi al centro dell'occhio
uniform float cell_rim = 0.045;           // bordo nero sul contorno (UV v)
// il contorno visibile in alto verso l'angolo esterno sta sopra eye_top (sotto il sopracciglio): il bordo
// nero lo si alza di tanto lÃ¬, se no diventa una fascia nera
uniform float cell_lift = 0.09;
uniform float cell_shine = 0.85;          // riflesso bianco in alto
uniform float cell_shine_w = 0.055;       // sua mezza larghezza (UV u)
uniform float cell_emit = 0.6;            // luce propria del rosso: resta rosso anche nella notte dell'arena
uniform float cell_rough = 0.6;           // vetro: riflesso del sole morbido, non una riga
uniform float cell_spec = 0.25;

void vertex() {
	float sd = step(0.5, UV.x);
	float r = length((UV - vec2(sd, 0.5)) * uv_scale);
	float k = 1.0 - smoothstep(push_r.x, push_r.y, r);
	VERTEX += NORMAL * push * k / max(length(MODEL_MATRIX[0].xyz), 1e-6);
}

// Contorno visibile dell'occhio negli UV (v cresce verso il basso) in funzione della distanza d
// dall'angolo esterno verso il muso (0 .. ~0.4), misurato sulle riprese frontali.
float eye_top(float d) { return 0.305 + 0.3 * d + 2.4 * d * d; }
float eye_bot(float d) { return 0.922 - (d - 0.19) * (d - 0.19); }

vec2 cell_hash(vec2 p) {
	p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
	return fract(sin(p) * 43758.5453);
}

// Celle di Voronoi: x = distanza dal bordo della cella piÃ¹ vicina (unitÃ  di cella), yz = la cella
// (per il tono di ognuna). Due passate: prima il punto piÃ¹ vicino, poi la distanza vera dai confini.
vec3 cell_voronoi(vec2 x) {
	vec2 n = floor(x);
	vec2 f = fract(x);
	vec2 mg = vec2(0.0);
	vec2 mr = vec2(0.0);
	float md = 8.0;
	for (int j = -1; j <= 1; j++) {
		for (int i = -1; i <= 1; i++) {
			vec2 g = vec2(float(i), float(j));
			vec2 r = g + 0.5 + (cell_hash(n + g) - 0.5) * 0.8 - f;
			float d = dot(r, r);
			if (d < md) {
				md = d;
				mr = r;
				mg = g;
			}
		}
	}
	md = 8.0;
	for (int j = -2; j <= 2; j++) {
		for (int i = -2; i <= 2; i++) {
			vec2 g = mg + vec2(float(i), float(j));
			vec2 r = g + 0.5 + (cell_hash(n + g) - 0.5) * 0.8 - f;
			if (dot(mr - r, mr - r) > 0.00001) {
				md = min(md, dot(0.5 * (mr + r), normalize(r - mr)));
			}
		}
	}
	return vec3(md, n + mg);
}

vec2 eye_uv(vec2 uv, out float side) {
	side = step(0.5, uv.x);
	vec2 c = vec2(side, 0.5);
	vec2 l = (uv - c) * uv_scale / iris_scale;
	vec2 look = mix(look_left, look_right, side);
	// sinistra (side 0) e destra (side 1): l'interno Ã¨ verso il centro della texture
	float inner = side > 0.5 ? -inward : inward;
	float lx = look.x;
	l -= vec2(lx + inner, -look.y);
	return l + 0.5;
}

void fragment() {
	float side;
	vec2 l = eye_uv(UV, side);
	vec2 lp = (l - 0.5) / (1.0 + pupil_dilate) + 0.5;
	float shade = texture(iris_shade, lp).r;
	float mask = texture(iris_mask, l).r;
	float glint = texture(glint_mask, l + vec2(0.03, -0.02)).r;
	vec3 iris = eye_color * shade * 1.15;
	vec3 col = mix(sclera_color, iris, mask);
	col = mix(col, vec3(1.0), clamp(glint * glint_strength, 0.0, 1.0));
	float g2 = 0.0;
	if (emerald_glint > 0.0) {
		g2 = texture(glint_mask, l + emerald_offset).r * emerald_glint;
		col += emerald_color * mask * emerald_glint * 0.1;
		col = mix(col, emerald_color, clamp(g2 * 1.1, 0.0, 1.0));
	}
	// occhi a celle (Patrizio): al posto di bianco e iride, sotto il bianco degli occhi vuoti e le palpebre
	float c_shine = 0.0;
	float c_ink = 0.0;
	vec3 c_red = vec3(0.0);
	if (cells > 0.0) {
		float dc = side > 0.5 ? 1.0 - UV.x : UV.x;
		float tc = eye_top(dc) - cell_lift * (1.0 - smoothstep(0.0, 0.32, dc));
		float bc = eye_bot(dc);
		// 0 in cima .. 1 in fondo al contorno visibile
		float h = clamp((UV.y - tc) / max(bc - tc, 0.02), 0.0, 1.0);
		// spazio dell'occhio con le proporzioni vere (gli UV vanno un poco sotto 0 verso l'angolo esterno:
		// la parte visibile Ã¨ d = -0.11 .. 0.3), centrato; vicino al centro si comprime: celle piÃ¹ grandi
		vec2 q = vec2(dc - 0.09, UV.y - 0.62) * vec2(1.7, 1.25);
		vec2 p = q * (1.0 - cell_warp * exp(-dot(q, q) / 0.12)) * cell_scale + side * vec2(7.3, 3.1);
		vec3 vc = cell_voronoi(p);
		// righe antialiasate: sotto il pixel si assottigliano tenendo la stessa media (niente sfarfallio),
		// e da lontano (celle di pochi pixel) diventano un velo uniforme
		float aa = max(length(fwidth(p)) * 0.7, 1e-4);
		float wl = max(cell_line, aa * 0.6);
		float line = (1.0 - smoothstep(wl - aa, wl + aa, vc.x)) * cell_line / wl;
		line = mix(line, cell_line * 3.4, smoothstep(0.12, 0.35, aa));
		// tono di ogni cella, un filo piÃ¹ scura verso i bordi (sfaccettata), scura in basso e agli angoli
		float tone = cell_hash(vc.yz + 3.1).x;
		c_red = cell_color * (0.86 + 0.28 * tone) * mix(0.82, 1.0, smoothstep(0.0, 0.3, vc.x));
		float k = smoothstep(0.2, 1.0, h) * 1.15 + smoothstep(-0.02, -0.12, dc) * 0.6 + smoothstep(0.18, 0.3, dc) * 0.6;
		c_red = mix(c_red, cell_dark, clamp(k, 0.0, 1.0));
		vec3 cc = mix(c_red, cell_line_color, line);
		// riflesso bianco morbido in alto, verso l'angolo esterno: una macchia tonda (di fronte, stretto,
		// sembrava una riga verticale di lucido)
		vec2 hq = vec2(dc + 0.025, h - 0.25) / vec2(cell_shine_w, 0.17);
		c_shine = cell_shine * exp(-dot(hq, hq));
		cc = mix(cc, vec3(1.0, 0.92, 0.9), clamp(c_shine, 0.0, 1.0) * (1.0 - 0.5 * line));
		// bordo nero sul contorno visibile, piÃ¹ spesso in alto (sotto il sopracciglio); l'antialias segue
		// la distanza vera dal contorno (che dipende anche da UV.x: verso il muso Ã¨ ripido)
		float et = UV.y - tc;
		float eb = bc - UV.y;
		float avt = max(fwidth(et) * 0.75, 0.0015);
		float avb = max(fwidth(eb) * 0.75, 0.0015);
		float rim = max(1.0 - smoothstep(cell_rim * 1.3 - avt, cell_rim * 1.3 + avt, et),
				1.0 - smoothstep(cell_rim - avb, cell_rim + avb, eb));
		cc = mix(cc, cell_line_color * 0.5, rim);
		c_shine *= 1.0 - rim;
		c_ink = max(line, rim);
		c_red *= 1.0 - rim;
		col = mix(col, cc, cells);
		glint *= 1.0 - cells;
		g2 *= 1.0 - cells;
		mask *= 1.0 - cells;
	}
	if (blank > 0.0) {
		col = mix(col, vec3(1.0), blank);
		glint *= 1.0 - blank;
		g2 *= 1.0 - blank;
	}
	// palpebre
	float d = side > 0.5 ? 1.0 - UV.x : UV.x;
	float top = eye_top(d);
	float bot = eye_bot(d);
	float meet = mix(top, bot, lid_meet);
	float cu = clamp(side > 0.5 ? lid_up.y : lid_up.x, 0.0, 1.0);
	float cl = clamp(side > 0.5 ? lid_low.y : lid_low.x, 0.0, 1.0);
	float eu = cu > 0.001 ? mix(top - 0.05, meet + 0.012, cu) : -1.0;
	float el = cl > 0.001 ? mix(bot + 0.05, meet - 0.012, cl) : 2.0;
	float aa = max(fwidth(UV.y) * 0.75, 0.0015);
	float lu = 1.0 - smoothstep(eu - aa, eu + aa, UV.y);
	float ll = smoothstep(el - aa, el + aa, UV.y);
	float lid = max(lu, ll);
	// ombra morbida della palpebra superiore sul bianco, appena sotto il bordo
	float shade_u = (1.0 - smoothstep(0.0, 0.06, UV.y - eu)) * step(eu, UV.y) * clamp(cu * 6.0, 0.0, 1.0);
	col *= 1.0 - 0.28 * shade_u;
	// pelliccia della palpebra: un filo piÃ¹ scura verso il bordo, con la linea delle ciglia
	float du = eu - UV.y;
	float dl = UV.y - el;
	float edge = lu > ll ? du : dl;
	vec3 lidc = lid_color * mix(0.82, 1.0, smoothstep(0.0, 0.12, edge));
	// la linea delle ciglia compare solo quando la palpebra scende davvero (da appena abbassata
	// starebbe sul contorno dell'occhio come un bordo nero)
	float lash = (1.0 - smoothstep(0.004, 0.02, edge)) * smoothstep(0.12, 0.4, lu > ll ? cu : cl);
	lidc = mix(lidc, lash_color, lash);
	ALBEDO = mix(col, lidc, lid) * (1.0 - dark);
	ROUGHNESS = mix(1.0 - smoothness, lid_rough, lid);
	SPECULAR = mix(0.6, lid_spec, lid) * (1.0 - dark);
	if (cells > 0.0) {
		// le righe e il bordo neri non luccicano; con gli occhi vuoti torna la lucentezza di prima
		// (niente nido d'ape nel riflesso del sole sul bianco)
		float cw = cells * (1.0 - blank);
		float cs = mix(0.6, cell_spec * (1.0 - 0.85 * c_ink), cw);
		ROUGHNESS = mix(mix(1.0 - smoothness, cell_rough, cw), lid_rough, lid);
		SPECULAR = mix(cs, lid_spec, lid) * (1.0 - dark);
	}
	vec3 em = vec3(glint * glint_strength * 0.6) * (1.0 - dark) + emerald_color * g2 * 1.3;
	em += glow * mix(glow_sclera * 1.7, eye_color * 3.2, mask);
	em += vec3(1.0, 0.98, 0.95) * blank * blank_glow;
	if (cells > 0.0) {
		// il riflesso si accende un poco, il rosso un poco (si legge anche in ombra); righe e bordo restano
		// neri, il bianco degli occhi vuoti ha la sua luce
		em += (vec3(1.0, 0.9, 0.88) * c_shine * 0.35 + c_red * cell_emit * (1.0 - c_ink)) * cells * (1.0 - blank) * (1.0 - dark);
	}
	EMISSION = em * (1.0 - lid);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀// Occhio di Sonic (modello di Generations) col materiale originale del modello: la texture
// chr_sonic_eye_dif_HD sugli UV della mesh, quindi l'iride ha esattamente la forma e la grandezza
// dipinte nella texture. Lo sguardo, come nel gioco originale, sposta gli UV della texture
// (offset): l'animatore lo tiene entro limiti piccoli, uguale per i due occhi (sguardo parallelo).
//
// Mappe del modello: chr_sonic_eye_nrm_HD_RG (cornea, convenzione DirectX), chr_sonic_eye_spc_HD_R
// (maschera dell'iride), chr_sonic_eye_spc_HD_G (luciditÃ , scura sull'iride).
shader_type spatial;
render_mode cull_back;

uniform sampler2D eye_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D eye_nrm : hint_normal, filter_linear_mipmap, repeat_enable;
uniform sampler2D eye_spc : filter_linear_mipmap, repeat_enable;   // R: maschera dell'iride
uniform sampler2D eye_gls : filter_linear_mipmap, repeat_enable;   // G: luciditÃ 
// spostamento della texture (unitÃ  UV): x + verso la sinistra del personaggio, y + in basso.
// Gli UV dei due occhi sono specchiati, quindi lo stesso valore muove le due iridi nello stesso verso.
uniform vec2 offset = vec2(0.0);
uniform float push = 0.0;                   // l'occhio sta un filo sopra la pelle (metri)
uniform float bulge = 1.0;                  // forza della mappa normale della cornea
uniform float catch_strength = 1.0;         // riflesso di luce "da set" (fisso rispetto alla camera)
uniform vec3 catch_dir = vec3(-0.45, 0.6, 1.0);
uniform vec3 sclera_tint : source_color = vec3(0.97, 0.98, 1.0);
uniform float debug_grid = 0.0;             // (prove) griglia UV sopra l'occhio
// palpebra "arrabbiata" (solo cinematiche, 0 = spenta): copre la parte alta dell'occhio sopra una
// linea che scende verso il naso, col colore della pelle e un filo scuro sul bordo. Sta sugli UV
// della mesh (non sposta con lo sguardo). lid_side: +1/-1 per il verso dell'occhio negli UV.
uniform float lid_amount = 0.0;
uniform float lid_side = 1.0;
uniform float lid_v = 1.4;                  // altezza della linea a u = 0.5 (UV, + in basso; l'occhio va da 0.8 a 1.77)
uniform float lid_slope = 0.6;              // quanto scende verso il naso per unitÃ  di UV
uniform vec3 lid_color : source_color = vec3(0.04, 0.08, 0.5);

void vertex() {
	VERTEX += NORMAL * push / max(length(MODEL_MATRIX[0].xyz), 1e-6);
}

void fragment() {
	vec2 uv = UV - offset;
	vec3 col = texture(eye_tex, uv).rgb;
	float iris = texture(eye_spc, uv).r;
	float gloss = texture(eye_gls, uv).r;
	col = mix(col * sclera_tint, col, iris);

	// cornea: normale dalla mappa del modello (verde invertito: convenzione DirectX)
	vec2 n2 = (texture(eye_nrm, uv).rg * 2.0 - 1.0) * vec2(1.0, -1.0) * bulge;
	vec3 nv = normalize(NORMAL + TANGENT * n2.x + BINORMAL * n2.y);
	NORMAL = normalize(mix(NORMAL, nv, iris));

	// riflesso principale piccolo e netto in alto, secondo riflesso morbido in basso
	vec3 h = normalize(normalize(catch_dir) + vec3(0.0, 0.0, 1.0));
	float c1 = pow(max(dot(nv, h), 0.0), 260.0);
	vec3 h2 = normalize(normalize(vec3(0.5, -0.5, 1.0)) + vec3(0.0, 0.0, 1.0));
	float c2 = pow(max(dot(nv, h2), 0.0), 70.0) * 0.25;
	float glint = (smoothstep(0.25, 0.6, c1) + c2) * iris * catch_strength;

	if (debug_grid > 0.0) {
		vec2 g = abs(fract(UV * 10.0) - 0.5);
		float line = step(0.44, max(g.x, g.y));
		vec2 gc = abs(fract(UV) - 0.5);
		col = mix(col, vec3(fract(UV.x), 0.0, fract(UV.y)), line * 0.8);
		col = mix(col, vec3(1.0, 0.6, 0.0), step(max(gc.x, gc.y), 0.01));
	}
	ALBEDO = mix(col, vec3(1.0), clamp(glint, 0.0, 1.0));
	EMISSION = vec3(glint) * 0.8;
	ROUGHNESS = mix(0.35, 0.08, iris) + gloss * 0.3;
	SPECULAR = mix(0.5, 0.8, iris);
	CLEARCOAT = iris * 0.5;
	if (lid_amount > 0.001) {
		// la linea parte da sopra l'occhio (amount 0) e scende fino a lid_v (amount 1)
		float edge = mix(0.3, lid_v, lid_amount) + lid_slope * (UV.x - 0.5) * lid_side;
		float aa = fwidth(UV.y) * 1.5;
		float lid = 1.0 - smoothstep(edge - aa, edge + aa, UV.y);
		float ink = (1.0 - smoothstep(edge + 0.03 - aa, edge + 0.03 + aa, UV.y)) * (1.0 - lid);
		ALBEDO = mix(ALBEDO, vec3(0.01, 0.01, 0.04), 1.0 - smoothstep(edge + 0.03 - aa, edge + 0.03 + aa, UV.y));
		ALBEDO = mix(ALBEDO, lid_color, lid);
		EMISSION *= 1.0 - max(lid, ink);
		ROUGHNESS = mix(mix(ROUGHNESS, 0.6, lid), 1.0, ink);
		SPECULAR = mix(mix(SPECULAR, 0.25, lid), 0.0, ink);
		CLEARCOAT *= 1.0 - max(lid, ink);
	}
	CLEARCOAT_ROUGHNESS = 0.06;
}
␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Alone di Super Sonic "alla Heroes" (scripts/vfx/super_heroes_look.gd): un guscio del corpo
// gonfiato lungo le normali (lisciate) di cui si disegna solo il lato di dietro, additivo. Il corpo
// copre il guscio davanti (test di profonditÃ ): resta un anello attorno alla sagoma, bianco-giallo
// vicino al corpo che sfuma verso fuori, che pulsa piano. Additivo con alfa premoltiplicata: cover
// copre un poco lo sfondo, cosÃ¬ sul cielo chiaro l'alone resta giallo invece di sbiancare. Una sola mesh (le superfici unite), senza
// luci nÃ© ombre: costa una chiamata di disegno e un solo strato di pixel.
// Lo spessore cresce un poco con la distanza dalla camera (anello leggibile anche lontano, non
// enorme nei primi piani). Dove subito dietro al guscio c'Ã¨ il corpo stesso (pezzi di mesh interne
// come palpebre, denti e lingua, il cui guscio spunta dalla faccia) il guscio sparisce: l'alone resta
// solo dove dietro c'Ã¨ il fondo o un'altra parte del corpo piÃ¹ lontana.

render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_front, shadows_disabled, fog_disabled;

uniform sampler2D depth_tex : hint_depth_texture, filter_nearest;
uniform vec3 inner : source_color = vec3(1.0, 0.98, 0.7);  // vicino al corpo
uniform vec3 outer : source_color = vec3(1.0, 0.86, 0.2);  // verso fuori
uniform float energy = 1.3;
uniform float thick = 0.028;          // spessore minimo (m)
uniform float thick_per_m = 0.006;    // in piÃ¹ per ogni metro di distanza dalla camera
uniform float thick_max = 0.075;
uniform float falloff = 2.2;          // piÃ¹ alto: anello piÃ¹ stretto verso il corpo
uniform float pulse = 0.2;
uniform float pulse_hz = 1.2;
uniform float flash = 0.0;            // lampo in piÃ¹ (cinematiche)
uniform float cover = 0.35;           // quanto copre lo sfondo (0 = solo additivo)
uniform vec2 gap_fade = vec2(2.0, 4.0);   // (spessori) distanza dalla superficie dietro: spento .. pieno
// HYPER{
// "Quasi Hyper" (SuperHeroesLook.hyper_flash, scena 4): a 0 i blocchi non girano. L'alone cresce
// (hyper_grow) e prende il colore del lampo (hyper_col, lineare), appena piÃ¹ chiaro vicino al corpo.
uniform float hyper = 0.0;
uniform vec3 hyper_col = vec3(1.0);
uniform vec3 hyper_inner = vec3(1.0, 1.0, 1.0);
uniform float hyper_grow = 0.6;
uniform float hyper_boost = 0.15;
// }HYPER

varying float v_thick;

void vertex() {
	float sc = max(length(MODEL_MATRIX[0].xyz), 1e-4);
	vec3 vp = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float d = clamp(thick + thick_per_m * length(vp), thick, thick_max) * (1.0 + 0.6 * flash);
	// HYPER{
	if (hyper > 0.0) {
		d *= 1.0 + hyper_grow * hyper;
	}
	// }HYPER
	float beat = 1.0 + pulse * 0.4 * sin(TIME * TAU * pulse_hz);
	VERTEX += normalize(NORMAL) * d * beat / sc;
	v_thick = d;
}

void fragment() {
	// abs: del guscio si vede il lato di dietro (normali rivolte via dalla camera)
	float f = clamp(abs(dot(normalize(NORMAL), normalize(VIEW))), 0.0, 1.0);
	float g = pow(f, falloff);
	float beat = 1.0 + pulse * sin(TIME * TAU * pulse_hz);
	// quanto spazio c'Ã¨ tra il guscio e la superficie opaca dietro
	float zs = texture(depth_tex, SCREEN_UV).r;
	vec4 ndc = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, zs, 1.0);
	float gap = -ndc.z / ndc.w + VERTEX.z;
	float open = smoothstep(gap_fade.x * v_thick, gap_fade.y * v_thick, gap);
	float k = g * beat * open;
	ALBEDO = mix(outer, inner, g) * k * energy * (1.0 + 2.0 * flash);
	ALPHA = clamp(cover * k * min(energy, 1.0), 0.0, 1.0);
	// HYPER{
	if (hyper > 0.0) {
		float hk = hyper * (2.0 - hyper);
		vec3 hc = mix(hyper_col, hyper_inner, g * g * 0.2);
		ALBEDO = mix(ALBEDO, hc * k * energy * (1.0 + 2.0 * flash) * (1.0 + hyper_boost * hyper), hk);
		ALPHA = clamp(ALPHA * (1.0 + 0.5 * hyper), 0.0, 1.0);
	}
	// }HYPER
}
␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
// Super Sonic "alla Heroes" (boss di Eggmanland, scripts/vfx/super_heroes_look.gd): pelle giallo
// limone quasi accesa da sÃ©, lucida, con un bordo chiaro che pulsa piano; guanti e scarpe con i
// colori della loro texture (bianco, rosso), appena accesi perchÃ© si leggano anche nella notte
// cremisi dell'Eggmanland.
// skin = 1 (pelle): i pixel gialli della texture d'oro di Unleashed diventano limone (la loro
// luminositÃ  sceglie ombra / pieno / chiaro); naso, bocca e denti (non gialli) restano come sono.
// skin = 0 (guanti, scarpe): texture com'Ã¨.

render_mode cull_back, diffuse_burley, specular_schlick_ggx;

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform float skin = 1.0;
uniform vec3 lemon : source_color = vec3(1.0, 0.9, 0.0);        // giallo limone pieno
uniform vec3 lemon_shade : source_color = vec3(0.92, 0.52, 0.0);  // nelle pieghe dipinte
uniform vec3 lemon_hot : source_color = vec3(1.0, 0.96, 0.28);    // dove la pittura Ã¨ chiara
uniform float albedo_k = 0.32;         // quanto della pelle viene dalle luci della scena
uniform float self_lit = 0.42;         // emissione della pelle (quanto Ã¨ accesa da sÃ©)
uniform float cloth_lit = 0.1;         // emissione di guanti e scarpe
uniform vec3 rim_color : source_color = vec3(1.0, 0.95, 0.45);
uniform float rim = 0.45;              // bordo chiaro (fresnel) sulla pelle
uniform float rim_power = 3.2;
uniform float cloth_rim = 0.25;        // quanto bordo su guanti e scarpe
uniform float gloss = 0.34;            // ruvidezza della pelle (lucida)
uniform float coat = 0.2;              // vernice lucida sopra la pelle
uniform float pulse = 0.1;             // pulsazione dell'emissione
uniform float pulse_hz = 1.2;
// HYPER{
// "Quasi Hyper" (scena 4, la trappola: SuperHeroesLook.hyper_flash): spento a 0 (il blocco nel
// fragment non gira, la pelle resta identica). hyper_col: colore del lampo in spazio lineare, giÃ 
// col lucido quasi bianco tra un colore e l'altro e il colpo d'inizio di ogni colore (lo calcola
// lo script); la pelle va verso il colore (hyper_mix: un poco di limone resta sotto, Ã¨ sempre Super
// Sonic) e si accende di piÃ¹ (hyper_lit: il colore passa anche attraverso il campo additivo della
// trappola), il bordo prende il colore pieno, guanti e scarpe appena.
uniform float hyper = 0.0;
uniform vec3 hyper_col = vec3(1.0);
uniform float hyper_mix = 0.92;
uniform float hyper_lit = 1.0;            // emissione della pelle a hyper 1 (al posto di self_lit)
uniform float hyper_rim = 0.8;
uniform float hyper_cloth = 0.08;
// }HYPER

vec3 to_srgb(vec3 c) {
	return pow(max(c, vec3(0.0)), vec3(1.0 / 2.2));
}

void fragment() {
	vec4 t = texture(albedo_tex, UV);
	vec3 c = t.rgb;
	// tinta e saturazione nello spazio sRGB della pittura: la pelle d'oro sta tra 20Â° e 70Â°
	vec3 s = to_srgb(c);
	float mx = max(s.r, max(s.g, s.b));
	float mn = min(s.r, min(s.g, s.b));
	float sat = (mx - mn) / max(mx, 1e-3);
	float hue = 0.0;
	if (mx - mn > 1e-3 && mx == s.r) {
		hue = 60.0 * (s.g - s.b) / (mx - mn);
	} else if (mx - mn > 1e-3 && mx == s.g) {
		hue = 60.0 * (2.0 + (s.b - s.r) / (mx - mn));
	}
	float yel = smoothstep(0.18, 0.32, sat) * smoothstep(16.0, 26.0, hue) * (1.0 - smoothstep(70.0, 85.0, hue));
	float m = yel * skin;
	// luminositÃ  della pittura rispetto alla pelle media (~0.72 in sRGB)
	float l = mx / 0.72;
	vec3 lem = mix(lemon_shade, lemon, smoothstep(0.45, 1.0, l));
	lem = mix(lem, lemon_hot, smoothstep(1.08, 1.4, l));

	float ndv = clamp(abs(dot(NORMAL, VIEW)), 0.0, 1.0);
	float fres = pow(1.0 - ndv, rim_power);
	float beat = 1.0 + pulse * sin(TIME * TAU * pulse_hz);
	ALBEDO = mix(c, lem * albedo_k, m);
	// la luce propria un poco piÃ¹ forte dove la pelle guarda la camera: resta il volume
	EMISSION = (lem * self_lit * (0.7 + 0.3 * ndv) * m + c * cloth_lit * (1.0 - m)) * beat
		+ rim_color * fres * mix(cloth_rim, rim, m) * beat;
	// HYPER{
	if (hyper > 0.0) {
		float hk = hyper * (2.0 - hyper);   // sale presto: il colore si legge giÃ  a metÃ 
		float hm = hk * m;
		vec3 tint = mix(lem, hyper_col, hyper_mix);
		ALBEDO = mix(ALBEDO, tint * albedo_k, hm);
		vec3 skin_e = tint * mix(self_lit, hyper_lit, hk) * (0.7 + 0.3 * ndv) * beat;
		EMISSION = mix(EMISSION, skin_e, hm)
			+ hyper_col * hyper * (fres * mix(hyper_rim * 0.35, hyper_rim, m) + (1.0 - m) * hyper_cloth);
	}
	// }HYPER
	ROUGHNESS = mix(0.6, gloss, m);
	SPECULAR = mix(0.45, 0.35, m);
	CLEARCOAT = coat * m;
	CLEARCOAT_ROUGHNESS = 0.12;
}
␀␀shader_type spatial;
// Bagliore morbido dietro a Super Sonic "alla Heroes" (scripts/vfx/super_heroes_look.gd): un quadrato
// rivolto sempre alla camera, poco dietro al corpo (che lo copre davanti), nucleo bianco-giallo che
// sfuma in un alone giallo; pulsa con l'alone del corpo. Dove tocca il suolo o un muro sfuma
// (profonditÃ  della scena) invece di tagliarsi in una riga dritta.

render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform sampler2D depth_tex : hint_depth_texture, filter_nearest;
uniform float energy = 0.25;
uniform vec3 core : source_color = vec3(1.0, 0.97, 0.7);
uniform vec3 halo : source_color = vec3(1.0, 0.84, 0.22);
uniform float pulse = 0.2;
uniform float pulse_hz = 1.2;
uniform float cover = 0.3;            // quanto copre lo sfondo (sul cielo chiaro resta giallo)
uniform float soft = 0.35;            // sfumatura contro la scena (m)
uniform float fade_near = 0.6;        // si dissolve cosÃ¬ vicino alla camera (m)
// HYPER{
// "Quasi Hyper" (SuperHeroesLook.hyper_flash, scena 4): a 0 il blocco non gira. Nucleo quasi bianco,
// alone del colore del lampo (hyper_col, lineare); grandezza ed energia le cambia lo script.
uniform float hyper = 0.0;
uniform vec3 hyper_col = vec3(1.0);
uniform vec3 hyper_core = vec3(1.0, 0.99, 0.95);
// }HYPER

void vertex() {
	// billboard che tiene la scala del nodo
	float sc = length(MODEL_MATRIX[0].xyz);
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0] * sc, INV_VIEW_MATRIX[1] * sc, INV_VIEW_MATRIX[2] * sc, MODEL_MATRIX[3]);
}

void fragment() {
	vec2 p = UV * 2.0 - 1.0;
	float r2 = dot(p, p);
	float c = exp(-r2 * 12.0);
	float h = exp(-r2 * 3.6);
	float beat = 1.0 + pulse * sin(TIME * TAU * pulse_hz);
	vec3 col = core * c * 1.1 + halo * h * 0.6;
	col *= 1.0 - smoothstep(0.75, 1.0, sqrt(r2));
	// sfumatura contro la scena dietro (soft particle)
	float zs = texture(depth_tex, SCREEN_UV).r;
	vec4 ndc = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, zs, 1.0);
	float scene_z = -ndc.z / ndc.w;
	float own_z = -VERTEX.z;
	float k = clamp((scene_z - own_z) / soft, 0.0, 1.0);
	k *= smoothstep(fade_near * 0.4, fade_near, own_z);
	ALBEDO = col * energy * beat * k;
	ALPHA = clamp(cover * (c * 0.6 + h * 0.4) * k * beat * min(energy * 4.0, 1.0), 0.0, 1.0);
	// HYPER{
	if (hyper > 0.0) {
		float hk = hyper * (2.0 - hyper);
		vec3 hcol = mix(core, mix(hyper_col, hyper_core, 0.2), hk) * c * 1.1 + mix(halo, hyper_col, hk) * h * 0.75;
		hcol *= 1.0 - smoothstep(0.75, 1.0, sqrt(r2));
		ALBEDO = hcol * energy * beat * k;
	}
	// }HYPER
}
